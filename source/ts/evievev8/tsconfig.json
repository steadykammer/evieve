{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": ["./tsconfig.base.json", "./tsconfig.types-for-max.json"],
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        // "typeRoots": ["../types", "./node_modules/@types"],
        "typeRoots": ["./node_modules/@types"],
        // "types": ["maxmsp"],
        "module": "CommonJS",
        "noImplicitAny": true,
        "removeComments": false,
        "preserveConstEnums": true,
        "sourceMap": true,
        "lib": ["ES2022"],
        "target": "ES2022",
        "skipLibCheck": true,
        "declaration": true,
        "declarationMap": true,
        "composite": false,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "strictNullChecks": true,
        "paths": {
        }
    },
    "include": ["src"],
    // "exclude": ["**/**.test.ts"]

}
