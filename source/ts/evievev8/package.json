{
  "name": "evievev8",
  "version": "0.0.1",
  "packageManager": "pnpm@10.13.1",
  "description": "evieve v8 typescripts",
  "type": "commonjs",
  "main": "",
  "scripts": {
    "build": "tsc",
    "postbuild": "esbuild src/**/*.ts --outdir=../../../javascript/v8",
    "ci": "pnpm run linter && pnpm run build",
    "dev": "onchange --initial \"src/**/*.ts\" \"**/*.json\" -- pnpm run build",
    "linter": "tsc --noEmit",
    "format": "",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "evieve"
  ],
  "author": "evieve",
  "license": "ISC",
  "devDependencies": {
    "@types/maxmsp": "^1.0.15",
    "esbuild": "^0.25.8",
    "pnpm": "^10.13.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
