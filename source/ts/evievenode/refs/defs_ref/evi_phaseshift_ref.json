{
    "object": {
        "name": "evi.phaseshift~",
        "parent": "evi_phaseshift",
        "category": "evieve",
        "tilde": "~",
        "digest": "Reimplementation of MSP <o>phaseshift~</o> object as a TPT filter",
        "description": "A second order TPT allpass filter which distorts the phase of the signal. See the 'frequency-response' tab of the <o>phaseshift~</o> helpfile for an explanation which is still accurate for this TPT version.",
        "discussion": "For more information about other reimplementations of MSP filters in evieve, see the 'evieve: msp' tab of the helpfile."
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": [
            "evieve Filter",
            "evieve Filter Linear",
            "evieve Filter TPT",
            "evieve Modulation",
            "evieve MSP Substitution",
            "evieve Utility"
        ]
    },
