            "id": 1,
            "type": "signal",
            "digest": "Input",
            "description": "Audio input to be filtered."
        },
        {
            "id": 2,
            "type": "signal/float",
            "digest": "Frequency in Hz @min 1 @max samplerate*0.5",
            "description": "Center frequency of the phase transition band."
