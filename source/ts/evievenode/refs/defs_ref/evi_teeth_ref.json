{
    "object": {
        "name": "evi.teeth~",
        "parent": "evi_teeth",
        "category": "evieve",
        "tilde": "~",
        "digest": "Reimplementation of MSP <o>teeth~</o> filter delay",
        "description": "Comb filter delay unit with independent control of feedforward and feedback delay times and saturation in the feedback path. The same structure as MSP <o>teeth~</o>, but with cubic interpolation (softer in the high end) and no digital clipping at FB Gain == 1 (via internal saturation, which makes the whole filter softer but will not clip your precious audio).",
        "discussion": "For more information about other reimplementations of MSP filters in evieve, see the 'evieve: msp' tab of the helpfile."
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": []
    },
    "includes": [
        "evi_approx.genexpr"
    ],
    "inlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Input",
            "description": "Audio input to filter"
        },
        {
            "id": 2,
            "type": "signal/float",
            "digest": "Feedforward Delay in ms @min 0 @max 1000",
            "description": "Feedforward delay time in ms."
        },
        {
            "id": 3,
            "type": "signal/float",
            "digest": "Feedback Delay in ms @min 0 @max 1000",
            "description": "Feedback delay time in ms."
        },
        {
            "id": 4,
            "type": "signal/float",
            "digest": "Direct Gain Coefficient @min -1 @max 1",
            "description": "Not smoothed internally. Applies negative or positive gain to the input path."
        },
        {
            "id": 5,
            "type": "signal/float",
            "digest": "Feedforward Coefficient @min -1 @max 1",
            "description": "Not smoothed internally. Applies negative or positive gain to the feedforward path."
        },
        {
            "id": 6,
            "type": "signal/float",
            "digest": "Feedback Coefficient @min -1 @max 1",
            "description": "Not smoothed internally. Applies negative or positive gain to the feedback path."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Comb Filter Output",
            "description": "Filtered audio output."
        },
        {
            "id": 2,
            "type": "signal",
            "digest": "Alternative Notches Output",
            "description": "Interesting alternative notches audio output."
        }
    ],
