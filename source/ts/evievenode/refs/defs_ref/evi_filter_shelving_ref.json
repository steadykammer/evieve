{
    "object": {
        "name": "evi.filter.shelving~",
        "parent": "evi_filter_shelving",
        "category": "evieve",
        "tilde": "~",
        "digest": "A chain of two twopole TPT SVF High/Low shelving filters",
        "description": "A quick one stop shop for applying classic shelving filtering using linear TPT SVFs. Controls are via attributes.",
        "discussion": "For more information about TPT SVFs and other filter types in evieve see the 'evieve filter' tab of the helpfile."
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": [
            "evieve Filter",
            "evieve Filter Linear",
            "evieve Filter TPT"
        ]
    },
    "includes": [
        "evi_svfs_lto.genexpr"
    ],
    "inlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Input",
            "description": "Audio input to be filtered."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Shelfed Output",
            "description": "Filtered audio output."
        }
    ],
    "messages": [],
    "attributes": [
        {
            "name": "highcutoff",
            "get": 1,
            "type": "float",
            "digest": "In Hz",
            "description": "Highshelf cutoff frequency in Hz.",
            "default": {
                "min": "500",
                "max": "samplerate*0.5",
                "value": "2000."
            }
        },
        {
            "name": "highdb",
            "get": 1,
            "type": "float",
            "digest": "In dB",
            "description": "Highshelf gain in dB",
            "default": {
                "min": "-30",
                "max": "30",
                "value": "0."
            }
        },
        {
            "name": "highq",
            "get": 1,
            "type": "float",
            "digest": "Q",
            "description": "Highshelf Q.",
            "default": {
                "min": "0.05",
                "max": "20",
                "value": "1."
            }
        },
        {
            "name": "lowcutoff",
            "get": 1,
            "type": "float",
            "digest": "In Hz",
            "description": "Lowshelf cutoff frequency in Hz.",
            "default": {
                "min": "1",
                "max": "10000",
                "value": "250."
            }
        },
        {
            "name": "lowdb",
            "get": 1,
            "type": "float",
            "digest": "In dB",
            "description": "Lowshelf gain in dB",
            "default": {
                "min": "-30",
                "max": "30",
                "value": "0."
            }
        },
        {
            "name": "lowq",
            "get": 1,
            "type": "float",
            "digest": "Q",
            "description": "Lowshelf Q.",
            "default": {
                "min": "0.05",
                "max": "20",
                "value": "1."
            }
        },
        {
            "name": "smooth",
            "get": 1,
            "type": "float",
            "digest": "Time in ms",
            "description": "Smooth the mixing gains of the filter efficiently at the core of the DSP. With this TPT SVF filter this will usually be the only smoothing required. By default smoothing is on.",
            "default": {
                "min": "0",
                "max": "333",
                "value": "22.666"
            }
        }
    ],
    "example": {
        "caption": "",
        "image": ""
    },
    "seealso": [
        "evi.filter~",
        "evi.filter.eq~",
        "evi.filter.morph~",
        "evi.filter.allpass~",
        "evi.filter.bandpass~",
        "evi.filter.bell~",
        "evi.filter.highpass~",
        "evi.filter.highshelf~",
        "evi.filter.lowpass~",
        "evi.filter.lowshelf~",
        "evi.filter.notch~",
        "evi.filter.peak~",
        "evi.filter.resonant~",
        "evi.filter.tilt~"
    ]
}