{
    "object": {
        "name": "evi.filter.allpass~",
        "parent": "evi_filter_allpass",
        "category": "evieve",
        "tilde": "~",
        "digest": "TPT allpass filter",
        "description": "The allpass filter from the evieve TPT SVF collection. An allpass filter 'roughly determines a 90 degree transition in phase on either side of center frequency'. Note there is no gain control in this filter.",
        "discussion": "For more information about TPT SVFs and other filter types in evieve see the 'evieve filter' tab of the helpfile."
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": []
    },
    "includes": [
        "evi_svfs_tpt_filters.genexpr"
    ],
    "inlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Input",
            "description": "Audio input to be filtered."
        },
        {
            "id": 2,
            "type": "signal/float",
            "digest": "Cutoff in Hz @min 1 @max samplerate*0.5",
            "description": "Cutoff frequency in Hz."
        },
        {
            "id": 3,
            "type": "signal/float",
            "digest": "Q @min 0.05 @max 20 @default 0.707107",
            "description": "Q, clamped in the range 0.05..20."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Allpass Normalised Output",
            "description": "Filtered audio output."
        }
    ],
    "messages": [],
    "attributes": [
        {
            "name": "smooth",
            "get": 1,
            "type": "float",
            "digest": "Time in ms",
            "description": "Smooth the mixing gains of the filter efficiently at the core of the DSP. With these TPT SVF filters this will usually be the only smoothing required. By default smoothing is off.",
            "default": {
                "min": "0",
                "max": "333",
                "value": "0."
            }
        }
    ],
    "example": {
        "caption": "",
        "image": ""
    },
