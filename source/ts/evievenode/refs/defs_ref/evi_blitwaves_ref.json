{
    "object": {
        "name": "evi.blitwaves~",
        "parent": "evi_blitwaves",
        "category": "evieve",
        "tilde": "~",
        "digest": "No aliasing BLIT oscillators with a choice of simultaneous wave shapes outputs",
        "description": "No aliasing classic synth wave shapes, DSF-BLIT-like algorithm, sweep/modulation works with no noise, and cheap. Good for subtractive synthesis because we stay very bright right up to nyquist, but no hard sync.",
        "discussion": "Also known as 'the pathological blitwaves' © JKC."
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": [
            "evieve Oscillator",
            "evieve Source",
            "evieve Antialiased"
        ]
    },
    "includes": [
        "evi_smooth.genexpr",
        "evi_trig.genexpr",
        "evi_adaa.genexpr"
    ],
    "inlets": [
        {
            "id": 1,
            "type": "signal/float",
            "digest": "Frequency in Hz",
            "description": "Oscillator frequency in Hz."
        },
        {
            "id": 2,
            "type": "signal/float",
            "digest": "Pulse Width 0..1 @default 0.5",
            "description": "PWM 0..1 for wave shapes that use it (RECT, TRI and Train)"
        },
        {
            "id": 3,
            "type": "signal",
            "digest": "Naive Reset",
            "description": "Naive phase reset, not anti-aliased."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "SAW",
            "description": "Anti-aliased Saw wave oscillator."
        },
        {
            "id": 2,
            "type": "signal",
            "digest": "RECT",
            "description": "Anti-aliased Rect wave oscillator."
        },
        {
            "id": 3,
            "type": "signal",
            "digest": "TRI",
            "description": "Anti-aliased Tri wave oscillator."
        },
        {
            "id": 4,
            "type": "signal",
            "digest": "SINE (if param addsine set)",
            "description": "Analog Sine wave oscillator with harmonics, output if @addsine attribute set to on."
        },
        {
            "id": 5,
            "type": "signal",
            "digest": "Train 0/1 (if param addtrain set)",
            "description": "Naive Train (rectified naive square) wave oscillator, output if @addtrain attribute set to on."
        },
        {
            "id": 6,
            "type": "signal",
            "digest": "Sync 0..1 (if param addsync set)",
            "description": "Global phase sync output 0..1, output if @addsync attribute set to on."
        }
    ],
    "messages": [
        {
            "name": "history",
            "arg": [
                {
                    "name": "MaxFreq",
                    "type": "int",
                    "units": "default: 0",
                    "optional": 1
                },
                {
                    "name": "omWN",
                    "type": "int",
                    "units": "default: 0",
                    "optional": 1
                },
                {
                    "name": "sr01",
                    "type": "int",
                    "units": "default: 0",
                    "optional": 1
                },
                {
                    "name": "sr05",
                    "type": "int",
                    "units": "default: 0",
                    "optional": 1
                },
                {
                    "name": "srWN",
                    "type": "int",
                    "units": "default: 0",
                    "optional": 1
                }
            ],
            "digest": "Top level gen~ [history] / History() declarations can be reset by messages to the object",
            "description": false
        }
    ],
    "attributes": [
        {
            "name": "addsine",
            "get": 1,
            "type": "int",
            "digest": "Flag 0/1",
            "description": "0 = SINE off, 1 = SINE on out of outlet 4 (CPU management)",
            "default": {
                "min": "0",
                "max": "1",
                "value": "0"
            }
        },
        {
            "name": "addsync",
            "get": 1,
            "type": "int",
            "digest": "Select 0, 1, 2",
            "description": "0 = off, 1 = main phase output out of outlet 6, 2 = pwm phase output out of outlet 6",
            "default": {
                "min": "0",
                "max": "2",
                "value": "1"
            }
        },
        {
            "name": "addtrain",
            "get": 1,
            "type": "int",
            "digest": "Select 0, 1, 2",
            "description": "0 = off, 1 = train based on main phase out of outlet 5, 2 = train based on pwm phase out of outlet 5",
            "default": {
                "min": "0",
                "max": "2",
                "value": "0"
            }
        },
        {
            "name": "smooth",
            "get": 1,
            "type": "float",
            "digest": "Time in ms",
            "description": "Internal parameters smoothed by this time in ms. Turn off (0) for audio rate modulation of inlets 1 and 2",
            "default": {
                "min": "0",
                "max": "333",
                "value": "22."
            }
        }
    ],
    "example": {
        "caption": "",
        "image": ""
    },
    "seealso": [
        "evi.4wave~",
        "evi.classic.osc~",
        "evi.morph.trap~"
    ]
}