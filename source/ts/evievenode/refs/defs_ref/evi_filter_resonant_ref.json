        "evi.filter.bandpass~",
        "evi.filter.bell~",
        "evi.filter.highpass~",
        "evi.filter.highshelf~",
        "evi.filter.lowpass~",
        "evi.filter.lowshelf~",
        "evi.filter.notch~",
        "evi.filter.peak~",
        "evi.filter.tilt~"
    ]
}