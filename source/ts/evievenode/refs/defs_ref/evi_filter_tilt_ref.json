{
    "object": {
        "name": "evi.filter.tilt~",
        "parent": "evi_filter_tilt",
        "category": "evieve",
        "tilde": "~",
        "digest": "TPT tilt filter",
        "description": "The tilt filter from the evieve TPT SVF collection. A tilt filter is a special type of shelf: negative dB boosts low and attenuates high frequencies, positive dB boosts high and attenuates low frequencies.",
        "discussion": "For more information about TPT SVFs and other filter types in evieve see the 'evieve filter' tab of the helpfile."
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": [
            "evieve Filter",
            "evieve Filter Linear",
            "evieve Filter TPT"
        ]
    },
    "includes": [
        "evi_svfs_tpt_filters.genexpr"
    ],
    "inlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Input",
            "description": "Audio input to be filtered."
        },
        {
            "id": 2,
            "type": "signal/float",
            "digest": "Cutoff in Hz @min 1 @max samplerate*0.5",
            "description": "Cutoff frequency in Hz. Around this frequency the tilt filter will attenuate/boost."
        },
        {
            "id": 3,
            "type": "signal/float",
            "digest": "Gain in dB @min -30 @max 30 @default 0",
            "description": "± gain in dB. Negative dB boosts low and attenuates high frequencies, positive dB boosts high and attenuates low frequencies."
        },
        {
            "id": 4,
            "type": "signal/float",
            "digest": "Q @min 0.05 @max 20 @default 1",
            "description": "Q, clamped in the range 0.05..20."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Tilt Output",
            "description": "Filtered audio output."
        }
    ],
    "messages": [],
    "attributes": [
        {
            "name": "smooth",
            "get": 1,
            "type": "float",
            "digest": "Time in ms",
            "description": "Smooth the mixing gains of the filter efficiently at the core of the DSP. With these TPT SVF filters this will usually be the only smoothing required. By default smoothing is on.",
            "default": {
                "min": "0",
                "max": "333",
                "value": "15.111"
            }
        }
    ],
    "example": {
        "caption": "",
        "image": ""
    },
