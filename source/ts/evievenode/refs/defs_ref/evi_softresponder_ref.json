{
    "object": {
        "name": "evi.softresponder~",
        "parent": "evi_softresponder",
        "category": "evieve",
        "tilde": "~",
        "digest": "Static antialiased soft clipping harmonics generator",
        "description": "A choice of two similar but different antialiased soft-ish / hard-ish static clipping algorithms",
        "discussion": "See the helpfile for an example of how to cope with unknown input ranges."
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": [
            "evieve Nonlinear",
            "evieve Saturation",
            "evieve Antialiased"
        ]
    },
    "includes": [
        "evi_adaa.genexpr"
    ],
    "inlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Audio to be soft clipped",
            "description": "Audio input is expected not to exceed -1..1"
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Antialiased soft clipped output",
            "description": "Output is waveshaped and antialiased"
        }
    ],
    "messages": [],
    "attributes": [
        {
            "name": "algo",
            "get": 1,
            "type": "int",
            "digest": "Select 0/1",
            "description": "Select algorithm type 1 (0) or algorithm type 2 (1). Type 1 is 'harder' with clearer harmonics, type 2 is 'softer' and a bit more bassy.",
            "default": {
                "min": "0",
                "max": "1",
                "value": "0"
            }
        },
        {
            "name": "softBeta",
            "get": 1,
            "type": "float",
            "digest": "",
            "description": false,
            "default": {
                "min": "2",
                "max": "32",
                "value": "4."
            }
        },
        {
            "name": "softC",
            "get": 1,
            "type": "float",
            "digest": "",
            "description": false,
            "default": {
                "min": "0.64",
                "max": "1.4",
                "value": "sqrt1_2"
            }
        },
        {
            "name": "softH",
            "get": 1,
            "type": "float",
            "digest": "",
            "description": false,
            "default": {
                "min": "0.01",
                "max": "2",
                "value": "sqrt1_2"
            }
        },
        {
            "name": "softR",
            "get": 1,
            "type": "float",
            "digest": "",
            "description": false,
            "default": {
