                "max": "0.99",
                "value": "sqrt1_2"
            }
        },
        {
            "name": "softRatio",
            "get": 1,
            "type": "float",
            "digest": "",
            "description": false,
            "default": {
                "min": "0",
                "max": "1",
                "value": "sqrt1_2"
            }
