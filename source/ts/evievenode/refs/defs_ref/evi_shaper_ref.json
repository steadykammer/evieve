{
    "object": {
        "name": "evi.shaper~",
        "parent": "evi_shaper",
        "category": "evieve",
        "tilde": "~",
        "digest": "An interpolated choice of even or odd harmonics waveshaping",
        "description": "A simple object to cleanly add harmonics to an audio chain when required. A choice of up to 8-ish harmonics either even or odd can be smoothly interpolated onto the audio signal.",
        "discussion": ""
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": [
            "evieve Nonlinear",
            "evieve Effect",
            "evieve Saturation",
            "evieve Antialiased"
        ]
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Audio to be Shaped",
            "description": "Any audio input."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Shaped Audio Output",
            "description": "Hopefully more interesting audio output."
        }
    ],
    "messages": [],
    "attributes": [
        {
            "name": "compensate",
            "get": 1,
            "type": "int",
            "digest": "Flag 0/1",
            "description": "Gain compensate the drop in energy over the interpolation of adding harmonics.",
            "default": {
                "min": "0",
                "max": "1",
                "value": "1"
            }
        },
        {
            "name": "harmonics",
            "get": 1,
            "type": "float",
            "digest": "Normalised 0..1",
            "description": "Interpolated 0..1 add 0..8 harmonics (0 = 0, 0.25 = 1, 0.5 = 2, 0.75 = 4, 1 = 8).",
            "default": {
                "min": "0",
                "max": "1",
                "value": "0.5"
            }
        },
        {
            "name": "shape",
            "get": 1,
            "type": "float",
            "digest": "-1..1",
            "description": "Greater than 0 gradually adds odd harmonics, less than zero gradually adds even harmonics.",
            "default": {
                "min": "-1",
                "max": "1",
                "value": "0."
            }
        },
        {
            "name": "smooth",
            "get": 1,
            "type": "float",
            "digest": "Time in ms",
            "description": "Optionally smooth @harmonics and @shape attributes, default off.",
            "default": {
                "min": "0",
                "max": "666",
                "value": "0."
            }
        }
    ],
    "example": {
        "caption": "",
        "image": ""
    },
    "seealso": [
        "evi.softclip~",
        "evi.sinfold~",
        "evi.warmer~",
        "evi.clipasym~",
        "evi.rectify~",
        "evi.softresponder~",
        "evi.squasher~"
    ]
}