{
    "object": {
        "name": "evi.eq3~",
        "parent": "evi_eq3",
        "category": "evieve",
        "tilde": "~",
        "digest": "Mono TPT 3-band EQ with audio rate modulation of all parameters",
        "description": "A 3-band EQ made up of 3 TPT SVF EQ filters, each with selectable filter type. The feature of this EQ is that all filter parameters are available on inlets, so the whole EQ can optionally be audio rate modulated. Because this is based on TPT filters, modulation will remain clean and stable at audio rate, unlike biquads.",
        "discussion": "For more information about TPT SVFs and other filter types in evieve see the 'evieve filter' tab of the helpfile."
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": [
            "evieve Filter",
            "evieve Filter Linear",
            "evieve Filter TPT",
            "evieve Effect"
        ]
    },
    "includes": [
        "evi_svfs_lto.genexpr"
    ],
    "inlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Input",
            "description": "Audio input to be EQ-ed."
        },
        {
            "id": 2,
            "type": "signal/float",
            "digest": "freq 1 @min 10 @max 18000 @default 250",
            "description": "Band 1 frequency in Hz."
        },
        {
            "id": 3,
            "type": "signal/float",
            "digest": "dB 1 @min -24 @max 24 @default 0",
            "description": "Band 1 gain in dB."
        },
        {
            "id": 4,
            "type": "signal/float",
            "digest": "Q 1 @min 0.1 @max 18 @default 1",
            "description": "Band 1 Q."
        },
        {
            "id": 5,
            "type": "signal/float",
            "digest": "freq 2 @min 10 @max 18000 @default 1000",
            "description": "Band 2 frequency in Hz."
        },
        {
            "id": 6,
            "type": "signal/float",
            "digest": "dB 2 @min -24 @max 24 @default 0",
            "description": "Band 2 gain in dB."
        },
        {
            "id": 7,
            "type": "signal/float",
            "digest": "Q 2 @min 0.1 @max 18 @default 0.707107",
            "description": "Band 2 Q."
        },
        {
            "id": 8,
            "type": "signal/float",
            "digest": "freq 3 @min 10 @max 18000 @default 4000",
            "description": "Band 3 frequency in Hz."
        },
        {
            "id": 9,
            "type": "signal/float",
            "digest": "dB 3 @min -24 @max 24 @default 0",
            "description": "Band 3 gain in dB."
        },
        {
            "id": 10,
            "type": "signal/float",
            "digest": "Q 3 @min 0.1 @max 18 @default 1",
            "description": "Band 3 Q."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "3 bands EQ Output",
            "description": "EQ-ed audio output."
        }
    ],
    "messages": [],
    "attributes": [
        {
            "name": "band1filter",
            "get": 1,
            "type": "int",
            "digest": "Select 0..7",
            "description": "Band 1 filter type by integer index: 0=Bypass, 1=Highpass, 2=Lowshelf, 3=Bell, 4=BellAdaptiveQ, 5=Notch, 6=Highshelf, 7=Lowpass",
            "default": {
                "min": "0",
                "max": "7",
                "value": "2"
            }
        },
        {
            "name": "band2filter",
            "get": 1,
            "type": "int",
            "digest": "Select 0..7",
            "description": "Band 2 filter type by integer index: 0=Bypass, 1=Highpass, 2=Lowshelf, 3=Bell, 4=BellAdaptiveQ, 5=Notch, 6=Highshelf, 7=Lowpass",
            "default": {
                "min": "0",
                "max": "7",
                "value": "3"
            }
        },
        {
            "name": "band3filter",
            "get": 1,
            "type": "int",
            "digest": "Select 0..7",
            "description": "Band 3 filter type by integer index: 0=Bypass, 1=Highpass, 2=Lowshelf, 3=Bell, 4=BellAdaptiveQ, 5=Notch, 6=Highshelf, 7=Lowpass",
            "default": {
                "min": "0",
                "max": "7",
                "value": "6"
            }
        },
        {
            "name": "smooth",
            "get": 1,
            "type": "float",
            "digest": "Time in ms",
            "description": "Smooth the mixing gains of the filters efficiently at the core of the DSP. With these TPT SVF filters this will usually be the only smoothing required. Smoothing should be turned off if audio rate modulating all inputs.",
            "default": {
                "min": "0",
                "max": "333",
                "value": "15.333"
            }
        }
    ],
    "example": {
        "caption": "",
        "image": ""
    },
    "seealso": [
        "evi.eq3.stereo~",
        "evi.eq5~",
        "evi.eq8~",
        "evi.filter.eq~"
    ]
}