{
    "object": {
        "name": "evi.audiodust~",
        "parent": "evi_audiodust",
        "category": "evieve",
        "tilde": "~",
        "digest": "Spikey sparse noise implementation",
        "description": "Audio dust is a sparse random noise source driven at a given frequency. It produces 'spikes' at random amplitude and time offsets. It can be very useful as both a control signal and an audio signal.",
        "discussion": "@see: <o>evi_sources</o>.genexpr for more where this came from."
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": [
            "evieve Control",
            "evieve Modulation",
            "evieve Source",
            "evieve Noise",
            "evieve Utility"
        ]
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Frequency in Hz @default 10 @min -SAMPLERATE*0.5 @max SAMPLERATE*0.5",
            "description": "The frequency at which to internally sample the noise. Typically used at low frequencies."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "So Called \"Audio Dust\"",
            "description": "Beautiful spikes."
        },
        {
            "id": 2,
            "type": "signal",
            "digest": "\"White Noise\"",
            "description": "Synchronised to the audio dust process."
        },
        {
            "id": 3,
            "type": "signal",
            "digest": "Click (Sample Accurate Unipolar Sync Source)",
            "description": "Synchronised to the audio dust process for synchronising other processes downstream."
        }
    ],
