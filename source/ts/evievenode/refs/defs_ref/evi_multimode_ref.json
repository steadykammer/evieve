{
    "object": {
        "name": "evi.multimode~",
        "parent": "evi_multimode",
        "category": "evieve",
        "tilde": "~",
        "digest": "Simultaneous outputs for all filters available from a linear TPT SVF",
        "description": "A multimode SVF similar to <o>evi.svf~</o>. Seven simultaneous outputs for all filters available from a linear TPT SVF topology that use just Cutoff and Q, with optional cutoff and resonance smoothing baked in.",
        "discussion": "For more information about TPT SVFs and other filter types in evieve see the 'evieve filter' tab of the helpfile."
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": [
            "evieve Filter",
            "evieve Filter Linear",
            "evieve Filter TPT"
        ]
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Input",
            "description": "Audio input to be filtered."
        },
        {
            "id": 2,
            "type": "signal",
            "digest": "Cutoff in Hz @min 1 @max samplerate*0.5 @default 500.",
            "description": "Cutoff frequency in Hz."
        },
        {
            "id": 3,
            "type": "signal",
            "digest": "Q @min 0.05 @default 0.707107",
            "description": "Q, typically clamped in the range 0.05..20, but the 'Resonant' filter type can take a much higher Q."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Low",
            "description": "Lowpass output."
        },
        {
            "id": 2,
            "type": "signal",
            "digest": "Band",
            "description": "Bandpass output."
        },
        {
            "id": 3,
            "type": "signal",
            "digest": "High",
            "description": "Highpass output."
        },
        {
            "id": 4,
            "type": "signal",
            "digest": "Peak",
            "description": "Peaking filter output."
        },
        {
            "id": 5,
            "type": "signal",
            "digest": "Notch",
            "description": "Notch filter output."
        },
        {
            "id": 6,
            "type": "signal",
            "digest": "Reson",
            "description": "Resonant bandpass output."
        },
        {
            "id": 7,
            "type": "signal",
            "digest": "Allpass",
            "description": "Allpass output."
        }
    ],
    "messages": [
        {
            "name": "history",
            "arg": [
                {
                    "name": "state1",
                    "type": "int",
                    "units": "default: 0",
                    "optional": 1
                },
                {
                    "name": "state2",
                    "type": "int",
                    "units": "default: 0",
                    "optional": 1
                }
            ],
            "digest": "Top level gen~ [history] / History() declarations can be reset by messages to the object",
            "description": ""
        }
    ],
    "attributes": [
        {
            "name": "cutoffsmooth",
            "get": 1,
            "type": "float",
            "digest": "Time in ms",
            "description": "Optionally smooth the cutoff (inlet 2). Also affected by @cutoffsmoothbase.",
            "default": {
                "min": "0",
                "max": "100",
                "value": "20."
            }
        },
        {
            "name": "cutoffsmoothbase",
            "get": 1,
            "type": "float",
            "digest": "Smooth in Hz",
            "description": "Internally the cutoff smoother is an instantiation of 'evi.cfsmooth~' and therefore additionally takes a Hz inlet to smooth the cutoff. @see the 'evi.cfsmooth~' helpfile for details.",
            "default": {
                "min": "0",
                "max": "10",
                "value": "2."
            }
        },
        {
            "name": "ressmooth",
            "get": 1,
            "type": "float",
            "digest": "Time in ms",
            "description": "Optionally smooth the resonance (inlet 3).",
            "default": {
                "min": "0",
                "max": "100",
                "value": "10."
            }
        }
    ],
    "example": {
        "caption": "",
        "image": ""
    },
    "seealso": [
        "evi.svf~",
        "evi.filter~",
        "evi.svfinputmix~",
        "evi.onepole~"
    ]
}