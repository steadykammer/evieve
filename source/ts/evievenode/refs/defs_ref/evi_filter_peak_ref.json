        "evi.filter.eq~",
        "evi.filter.shelving~",
        "evi.filter.morph~",
        "evi.filter.allpass~",
        "evi.filter.bandpass~",
        "evi.filter.bell~",
        "evi.filter.highpass~",
        "evi.filter.highshelf~",
        "evi.filter.lowpass~",
        "evi.filter.lowshelf~",
        "evi.filter.notch~",
        "evi.filter.resonant~",
        "evi.filter.tilt~"
    ]
}