{
    "object": {
        "name": "evi.filter.peak~",
        "parent": "evi_filter_peak",
        "category": "evieve",
        "tilde": "~",
        "digest": "TPT peaking filter",
        "description": "The peak filter from the evieve TPT SVF collection. Peak only. For peak/notch @see <o>evi.filter.bell~</o>.",
        "discussion": "For more information about TPT SVFs and other filter types in evieve see the 'evieve filter' tab of the helpfile."
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": [
            "evieve Filter",
            "evieve Filter Linear",
            "evieve Filter TPT"
        ]
    },
    "includes": [
        "evi_svfs_tpt_filters.genexpr"
    ],
    "inlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Input",
            "description": "Audio input to be filtered."
        },
        {
            "id": 2,
            "type": "signal/float",
            "digest": "Cutoff in Hz @min 1 @max samplerate*0.5",
            "description": "Cutoff frequency in Hz."
        },
        {
            "id": 3,
            "type": "signal/float",
            "digest": "Gain in dB @min -30 @max 30 @default 0",
            "description": "± gain in dB."
        },
        {
            "id": 4,
            "type": "signal/float",
            "digest": "Q @min 0.05 @max 20 @default 0.707107",
            "description": "Q, clamped in the range 0.05..20."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Peak Output",
            "description": "Filtered audio output."
        }
    ],
    "messages": [],
    "attributes": [
        {
            "name": "smooth",
            "get": 1,
            "type": "float",
            "digest": "Time in ms",
            "description": "Smooth the mixing gains of the filter efficiently at the core of the DSP. With these TPT SVF filters this will usually be the only smoothing required. By default smoothing is off.",
            "default": {
                "min": "0",
                "max": "333",
                "value": "0."
            }
        }
    ],
    "example": {
        "caption": "",
        "image": ""
    },
