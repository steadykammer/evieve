    "object": {
        "name": "evi.eq5~",
        "parent": "evi_eq5",
        "category": "evieve",
        "tilde": "~",
        "digest": "5-band TPT EQ with message rate control of all parameters",
        "description": "A 5-band parametric EQ made up of 5 TPT SVF EQ filters, each with selectable filter type. Parameter changes can optionally be smoothed.",
        "discussion": "For more information about TPT SVFs and other filter types in evieve see the 'evieve filter' tab of the helpfile."
    },
