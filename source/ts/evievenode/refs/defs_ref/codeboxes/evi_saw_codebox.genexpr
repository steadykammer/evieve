
require("evi_polyblep_four.genexpr");
require("evi_polyblep_utility.genexpr");

reset       = in2;      // naive, do not use

freqInHz    = in1;
t	        = phasor(freqInHz, reset);
dt	        = freqInHz / SAMPLERATE;

out1        = decorelateOsc(polysaw4(t, dt));

