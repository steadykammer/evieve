
// analog-like phaser in the sort of pedal sense (good for mono input but still does stereo)

require("evi_smooth_bank.genexpr");
require("evi_rcfilters.genexpr");
require("evi_crossovers.genexpr");
require("evi_sources.genexpr");
require("evi_lfo.genexpr");
require("evi_adaa.genexpr");
/*
AllPoleWarp(cutoff)					// 6dB onepole Warp (not !)
{
	return clip(sin(cutoff * twopi / samplerate), 0.00001, 0.99999);
