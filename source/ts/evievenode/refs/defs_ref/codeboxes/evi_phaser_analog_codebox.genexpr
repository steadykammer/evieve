AllPoleSection(x, f, H)				// 6dB onepole Allpass
{
	lp = mix(H, x, f);				// lowpass
	y0 = lp;
	hp = x - lp;					// highpass
	return ((hp * -1) + lp), y0;
}

AllPoleSectionFinal(x, f)			// 6dB onepole
{
	History y0(0);
	lp = mix(y0, x, f);				// lowpass
	y0 = lp;
	hp = x - lp;					// highpass
	return (hp * -1) + lp;
}

PoleZeroWarp(cutoff)				// 6dB pole/zero Warp
{
	fc = (pi * cutoff) / samplerate;			// !! no check for min/max 'cutoff' here
	a0 = minimum(((2 * sin(fc)) / (cos(fc) + sin(fc))), 0.999999);
	a1 = 1 - (a0 * 2);
	return a0, a1;
}

PoleZeroSection(x, a0, a1, Q)		// 6dB pole/zero
{
	w = x * a0;
	lp = Q + w;						// lowpass
	R = w + (lp * a1);
	hp = x - lp;					// highpass
	return ((hp * -1) + lp), R;
}

PoleZeroSectionFinal(x, a0, a1)		// 6dB pole/zero
{
	History R(0);
	w = x * a0;
	lp = R + w;						// lowpass
	R = w + (lp * a1);
	hp = x - lp;					// highpass
	return (hp * -1) + lp;
}
*/
iirWarp(cutoff)						// 6dB iir BLT
{	// alex, non-approx tan for you, but i think this very dangerous (must not get near nyquist)
	return tan(cutoff * (pi / samplerate));	// !! no check for min/max 'cutoff' here
}

iirSection(x, w, H)					// 6dB iir Allpass
{
	z = (x - ((w - 1) * H)) * (1 / (w + 1));
	hp = z - H;						// highpass
	lp = (z + H) * w;				// lowpass
	y0 = z;
	return ((hp * -1) + lp), y0;
}

iirSectionFinal(x, w)				// 6dB iir
{
	History y0(0);
	z = (x - ((w - 1) * y0)) * (1 / (w + 1));
	hp = z - y0;					// highpass
	lp = (z + y0) * w;				// lowpass
	y0 = z;
	return (hp * -1) + lp;
}
