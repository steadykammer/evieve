inputMixCos(xL, xR, stereo)
{
	monoMix = (xL + xR) * 0.5;
    yL, yR = xfadeQuartApproxStereo(monoMix, monoMix, xL, xR, stereo);
	return yL, yR, monoMix;
}

outputMixCos(xL, xR, stereo)
{
	yL = xL;
	yR = xfadeQuartApproxMono(xL, xR, stereo);
	return yL, yR;
}

Param	rate(0.5, min=0, max=8);
Param	depth(0.75, min=0, max=1);
Param	center(0.52, min=0, max=1);
Param	spread(0.5, min=0, max=1);

Param	duty(0.4, min=0, max=1);
Param	shape(0.5, min=0, max=1);
Param	skew(1.2, min=0.5, max=2);

Param   xover(104., min=10, max=1000);
Param   pregain(0., min=-6, max=6);
Param   postgain(0., min=-6, max=6);
Param	feedback(-0.5, min=-1, max=1);
Param   smooth(22.666, min=0, max=226);

Param   leakymix(0., min=0, max=10);
Param   lossiness(0.7, min=0, max=1);
Param   flavour(0.3, min=-20, max=20);
Param   gaintime(2., min=0);
Param   gainmode(0, min=0, max=2);

History circuitM(0);

History prevNum(7);
Data	allpassCascade(32, 1);	// just change dim() for different available number of stages
Param	stages(7);
maxSections = dim(allpassCascade);
numSections = clamp(int(stages), 2, maxSections);
numSectsM1  = numSections - 1;  // because final section is solo
smoothsecs	= smooth*0.001;

centPitch = center * 134;
rangPitch = centPitch * 0.5;
rangDepth = depth * rangPitch;
minPitch = centPitch - rangDepth;
maxPitch = centPitch + rangDepth;

fbmul	= ((1 - ((maximum(spread, 0.5) - 0.5) * 2)) * 0.75) + 0.75;
fbsin	= fastsin(feedback * fbmul);
fbfuck = abs(feedback) * 3;
fuck = maximum(pregain - fbfuck, -6);

phase, currentHz, sync = evi_phasor0(rate, 0);
//phase = phasor(rate);

// lfo
lfo01	= lfoMix(phase, duty, shape, skew);
lfomid	= mix(minPitch, maxPitch, lfo01);
lfohz	= mtofApproxBaseless(lfomid);
lfog    = rcPreWarp1(lfohz);
lfow    = iirWarp(lfohz);

xL      = in1;
xR      = in2;
stereoIn	= spread * 0.61;
XinL, XinR, Mono  = inputMixCos(xL, xR, stereoIn);
Sub, Xin    = eviXover2pole2band(XinL, xover);
allpassM	= ((circuitM * fbsin) + Xin) * dbtoaApprox(fuck);

pa 	    = 0.23283;
sale	= (leakymix * leakymix) * pa;
ratio1, gainMod1 = lossinessN(lossiness, flavour, gaintime, gainmode);
preN	= clip(ratio1 * gainMod1, 0, 1);
modN	= 1 - (sale * preN);

// allpass cascade
for (j = 0; j < numSectsM1; j += 1) {
    apS0 = peek(allpassCascade, j, 0, index="samples", interp="none");
//    allpassM, apS1 = rcFilterAllpassCascade(allpassM, lfog, apS0);
    allpassM, apS1 = eviXoverAllpass1cascade(allpassM, lfohz, apS0);
//    allpassM, apS1 = iirSection(allpassM, lfow, apS0);
    apW1 = apS1 * modN;
    poke(allpassCascade, apW1, j, 0, 0, index="samples");
}
if (prevNum != numSections) { // should be before cascade ?
	// zero remainder
	for (k = numSectsM1; k < maxSections; k += 1) {
		poke(allpassCascade, 0, k, 0, 0, index="samples");
	}
	prevNum = numSections;
}

// tap feedback and saturate
circuitM	= dcblock(atanAdaa2(allpassM * fbsin));
//final	    = dcblock(rcFilterAllpass((allpassM * dbtoaApprox(postgain)), lfog) * -1);
final	    = dcblock(eviXoverAllpass1((allpassM * dbtoaApprox(postgain)), lfohz) * -1);
//final	    = dcblock(iirSectionFinal((allpassM * dbtoaApprox(postgain)), lfow) * -1);
subFinal    = eCubicAdaa1(Sub) + final;

omsq12		= 1 - sqrt1_2;
fbattenL	= 1 - (abs(minimum(fbsin, 0)) * omsq12);
fbattenR	= 1 - (maximum(fbsin, 0) * omsq12);
phaserL		= (Xin + (subFinal * sqrt1_2)) * fbattenL;     // & static atten
phaserR		= ((subFinal + (subFinal * fbsin)) + XinR) * fbattenR;

stereoOut	 = (spread * 0.82) + 0.18;
mainL, mainR = outputMixCos(phaserL, phaserR, stereoOut);

out1 = mainL;
out2 = mainR;

out3 = minPitch;//lfo01;
out4 = maxPitch;//lfohz;
