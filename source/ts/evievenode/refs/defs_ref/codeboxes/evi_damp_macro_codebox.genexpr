
// a 'one knob' ("damp" parameter) macroisation for quick onepole damping filters
// useful for light damping or inside a feedback loop
// @see: "evi_damp.gendsp" / [evi.damp~] for more control
// @see: "evi_onepole_shelving.gendsp" / [evi.onepole.shelving~] for cut/boost
// @see: "evi_tone_macro.gendsp" / [evi.tone.macro~] for the opposite

require("evi_rcfilters.genexpr");
require("evi_smooth_bank.genexpr");

// param rate

Param   damp(0., min=0, max=1);
Param   smooth(0., min=0, max=999);

// cheapo macroisation, surprisingly it works, is even accross 0..1 range

sqdamp = sqrt(damp);
dampHzLpHs = ((1 - sqdamp) * 17000) + 1000;
dampHzHpLs = ((damp * damp) * 390) + 10;
g1, d1 = rcDampCoeffs0(dampHzLpHs, sqdamp);
g2, d2 = rcDampCoeffs0(dampHzHpLs, sqrt(sqdamp));

glp = g1; ghp = g2; lk = d1; hk = d2;

// audio rate

if (smooth > 0) {
    glp, lk, ghp, hk = expsmoothBank4(glp, lk, ghp, hk, smooth*0.001);
}

out1 = rcFilterDampBandpass(in1, glp, ghp, lk, hk);

