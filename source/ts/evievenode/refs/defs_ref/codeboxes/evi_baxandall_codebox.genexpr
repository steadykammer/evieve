
// cheap Df2-based classic "Baxandall" (treble/bass 'tone') EQ with optional smoothing.
// mono or stereo.

// a bit like the airwindows Baxandall, MIT licensed.

require("evi_smooth.genexpr");

coeffs(freq, recres, divres)
{
	K		= tanA2(PI * freq) * recres;	// * 1 / resampling factor
	K2		= K * K;
	Kw1		= K / divres;				    // div resample
	norm	= 1 / (1 + Kw1 + K2);
	K2norm	= (K2 - 1) * norm;

	a1		= K2 * norm;
	a2		= a1 + a1;
	b1		= K2norm + K2norm;
	b2		= (1 - Kw1 + K2) * norm;

	return	a1, a2, b1, b2;
}

// Df2

filter(x0, a1, a2, b1, b2)
{
	History	y0(0), y1(0);

	x1				=  x0 * a1;
	outputSample	=  x1 + y0;
	y0				= (x0 * a2) - (outputSample * b1) + y1;
	y1				=  x1 - (outputSample * b2);

	return			outputSample;
}

// setup

Param	treble(0., min=-24, max=24);// dB
Param	bass(0., min=-24, max=24);  // dB
Param   smooth(0, min=0, max=1);    // 0/1
Param	stereo(0, min=0, max=1);    // 0/1

DBLIN	= 0.11512925464970228;
INVSR   = 1 / samplerate;
smsecs  = 0.015111;                 // seconds
tMul    = samplerate * 0.1;         // 4800
bMul    = tMul + tMul;

smoothOp        = int(smooth);
stereoOp		= int(stereo);

// controls

trebleGain	= expA(DBLIN * treble);		// smooth here
trebleFreq	= minimum((tMul * trebleGain) * INVSR, 0.45);

gainBass	= bass;						// smooth here
bassGain	= expA(DBLIN * gainBass);
bassFreq	= expA(DBLIN * -gainBass);
bassFreq	= minimum((bMul * bassFreq) * INVSR, 0.45);

// smooth

if (smoothOp) {
    bassGain, trebleGain, bassFreq, trebleFreq = logsmoothBank4(bassGain, trebleGain, bassFreq, trebleFreq, smsecs);
}

// coefficients

ta1, ta2, tb1, tb2	= coeffs(trebleFreq, 0.5, 0.4);
ba1, ba2, bb1, bb2	= coeffs(bassFreq, 0.5, 0.2);

// filters

inputSample		= in1;
inputSampleR	= in2;

trebleSample	= inputSample - filter(inputSample, ta1, ta2, tb1, tb2);
bassSample		= filter(inputSample, ba1, ba2, bb1, bb2);

// output

trebleSample   *= trebleGain;
bassSample	   *= bassGain;
outputSample	= bassSample + trebleSample;

out1			= outputSample;
out2			= 0;

if (stereoOp)
{
	// filters
	
	trebleSampleR	= inputSampleR - filter(inputSampleR, ta1, ta2, tb1, tb2);
	bassSampleR		= filter(inputSampleR, ba1, ba2, bb1, bb2);
	
	// output
	
	trebleSampleR  *= trebleGain;
	bassSampleR	   *= bassGain;
	outputSampleR	= bassSampleR + trebleSampleR;
	
	out2			= outputSampleR;
}
