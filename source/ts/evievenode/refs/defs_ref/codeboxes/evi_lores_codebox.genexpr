
// This is a perhaps pointless attempt to make a filter with the bizarre (but very cool) response of MSP [lores~].
// The problems with [lores~] are:  - it digitally clips your audio signal and aliases and is horrible
//                                  - it is totally unstable and blows up after time at high resonance values
//                                  - it is like a Direct Form Z-1 filter that has bad modulation properties

// [lores~] is basically like the lowpass output of [svf~] but with a unique mapping & coupling of cutoff and resonance:
// frequency affects strength of resonance and resonance affects slope of filter, etc. The irony of the mapping
// of [lores~] is that it has a lower resonance in the low frequency range, but in fairness this is
// a traditional analog SVF type of mapping.

// In this "evi_lores" filter here we just try to give a rough mapping of these properties but on to a superior TPT filter
// so that modulation etc is better. We also make sensible settings for resonance so that it does not clip.
// Notice that this is still just a simple linear filter (like [lores~]), but tuned 'better' - but not identical to [lores~]!
// (we have zeros at nyquist in our TPT so sadly we have the frequency cramping up high).
// For (more normal) nonlinear 12dB lowpass filters consider "evi_lorez.gendsp" & "evi_svfsmooth.gendsp".
//                                                                   ^Z^

require("evi_trig.genexpr");        // @see also: "evi_svfs.genexpr"
require("evi_interp.genexpr"); 

// param rate version in case you need it
svfSinLoresCoeff(cutoff, damp)
{
    // [lores~] behaves to about 5 Hz input but this works out about 10 Hz for our svf
    hz  = ((1 - damp) * 490) + 10;                  // a basic version of the bizarre coupling
	w	= pi * maximum(cutoff, hz) / samplerate;
	s1	= sin73param(w);
	s2	= sin73param(w + w);
    dimp = damp * damp;
    dump = clip(dimp * 0.5 + sqrt(s2), 0, 0.96);    // a basic version of the bizarre coupling
	k	= 1 - dump;
    // or should use the Huovilainen here: res = k * 4; k = res / (1 + g * (2 - res)); ??
	nrm	= 1 / (2 + (k * s1));
	g0	= s2 * nrm;
	g1	= ((-2 * s1 * s1) - (k * s2)) * nrm;
    // we need to modify g2 to match the high freq pole of [lores~], but i cannot work it out
	g2	= ((s1 + s1) * s1) * nrm;

    return  g0, g1, g2, dump;
}

// for use with 'svfSinLoresCoeff()'
svfSinLoresFilter(X, g0, g1, g2, damp)
{
	History ic1eq(0), ic2eq(0);

	t0	=   X - ic2eq;
	gt0	=  g0 * ic1eq;
	gt1	=  g1 * ic1eq;
	t1	= (g0 * t0) + gt1;
	t2	= (g2 * t0) + gt0;

    // we could mix in -band & +high/peak to sort of match lores~ high freq response ?
//	band	=  t1   +  ic1eq;
	low		=  t2   +  ic2eq;
//	high	= (X    - (damp * band)) - low;
//	peak	=  high -  low;
//	notch	=  high +  low;

	ic1eq  += (t1 + t1);
	ic2eq  += (t2 + t2);

	return low;
}

// all in one audio rate, 1x
svfSinLowresFull1(X, cutoff, damp)
{
	History ic1eq(0), ic2eq(0);

    // [lores~] behaves to about 5 Hz input but this works out about 10 Hz for our svf
    hz  = ((1 - damp) * 490) + 10;                  // a basic version of the bizarre coupling
	w	= pi * maximum(cutoff, hz) / samplerate;
	s1	= sin73(w);
	s2	= sin73(w + w);
    dimp = damp * damp;
    dump = clip(dimp * 0.5 + sqrt(s2), 0, 0.96);    // a basic version of the bizarre coupling
	k	= 1 - dump;
    // or should use the Huovilainen here: res = k * 4; k = res / (1 + g * (2 - res)); ??
	nrm	= 1 / (2 + (k * s1));
	g0	= s2 * nrm;
	g1	= ((-2 * s1 * s1) - (k * s2)) * nrm;
    // we need to modify g2 to match the high freq pole of [lores~], but i cannot work it out
	g2	= ((s1 + s1) * s1) * nrm;

	t0	=   X - ic2eq;
	gt0	=  g0 * ic1eq;
	gt1	=  g1 * ic1eq;
	t1	= (g0 * t0) + gt1;
	t2	= (g2 * t0) + gt0;

    // we could mix in -band & +high/peak to sort of match lores~ high freq response ?
//	band	=  t1   +  ic1eq;
	low		=  t2   +  ic2eq;
//	high	= (X    - (dump * band)) - low;
//	peak	=  high -  low;
//	notch	=  high +  low;

	ic1eq  += (t1 + t1);
	ic2eq  += (t2 + t2);

	return low;
}

// all in one audio rate, 2x
svfSinLowresFull2(X0, X1, cutoff, damp)
{
	History ic1eq(0), ic2eq(0);

    hz  = ((1 - damp) * 490) + 10;
	w	= pi * maximum(cutoff, hz) / samplerate * 0.5;
	s1	= sin73(w);
	s2	= sin73(w + w);
    dimp = damp * damp;
    dump = clip(dimp * 0.5 + sqrt(s2), 0, 0.96);
	k	= 1 - dump;
	nrm	= 1 / (2 + (k * s1));
	g0	= s2 * nrm;
	g1	= ((-2 * s1 * s1) - (k * s2)) * nrm;
	g2	= ((s1 + s1) * s1) * nrm;

    // pass 1

	t00	    =  X0 - ic2eq;
	gt00	=  g0 * ic1eq;
	gt10	=  g1 * ic1eq;
	t10	    = (g0 * t00) + gt10;
	t20	    = (g2 * t00) + gt00;

	low0    = t20 + ic2eq;

	ic1eq  += (t10 + t10);
	ic2eq  += (t20 + t20);

    // pass 2

	t01	    =  X1 - ic2eq;
	gt01	=  g0 * ic1eq;
	gt11	=  g1 * ic1eq;
	t11	    = (g0 * t01) + gt11;
	t21	    = (g2 * t01) + gt01;

	low1    = t21 + ic2eq;

	ic1eq  += (t11 + t11);
	ic2eq  += (t21 + t21);

	return low0, low1;
}

// fixed 2x quasi oversampling (hermite6)
svfSinLowresFull2_2x( XIN, cutoff, damp )
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 2x
    y1_0, y2_0 = svfSinLowresFull2(x1_0, x2_0, cutoff, damp);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return dcblock(y0_0);
}

// the oversampling slightly improves the HF response, but it probably isn't worth it
Param   oversample(0, min=0, max=1);
os      = int(oversample);

if (os) {
    out1    = svfSinLowresFull2_2x(in1, in2, in3);
}
else {
    out1    = svfSinLowresFull1(in1, in2, in3);
}

