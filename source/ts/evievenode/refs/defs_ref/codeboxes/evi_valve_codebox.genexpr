
// it started on this thread in 2012:
// https://cycling74.com/forums/valve-distortion
// thanks to rodrigo constanzo and peter mcculloch

require("evi_valves.genexpr");

History init(1), od(4147200000), prevSR(0);
History k1, k2, k3, k4, k5, k6, VT, A1;
Delay   align(samplerate*0.0625, 1, feedback=0);

// param rate from here

Param   bass(0, min=-10, max=10); // input bass in dB
Param   treble(0, min=-10, max=10); // input treble in dB
Param   compensate(0.5, min=0, max=1); // % 0..1, post-sat positive high shelf
Param   makeup(0., min=0, max=10); // makeup gain in dB
Param   highpass(40, min=10, max=400); // final highpass in Hz

Param   envtype(0, min=0, max=2); // fast, medium, slow
Param   envscale(0.24, min=0, max=1); // compress gain env (& the more compressed, the higher the gain)
// any less than 100 you will have problems with fast transient material
Param   envinterval(200, min=100, max=2000); // average samples
Param   envmode(1, min=0, max=2); // bipolar, absolute, rms (do not use bipolar)

// in samples
Param   attack(20, min=10, max=1000);
Param   decay(2000, min=100, max=10000);

// if one of these is on we have single gain env (normal), if both are on we have double
// enveloping (crazy), if both are off we have no dynamic gain and we are quasi 'static' distortion
Param   envasym(1, min=0, max=1);
Param   envvalve(0, min=0, max=1);

Param   asymmetry(0, min=-6, max=6); // fake dB (favours negative regardless, but does 'add gain')
Param   hysterisis(0.5, min=0, max=1); // amount of hysterisis envelopes 0..1, shifts in your audio

Param   diode(1, min=0, max=1); // select diode algo, 0='soft', 1='hard'
dio     = int(diode);

etype   = int(envtype);
eint    = int(envinterval);
emode   = int(envmode);
envcomp = envscale * 0.5; // 0..0.5, default 0.12

valveenv = int(envvalve);
asymenv  = int(envasym);
asymskew = dbtoaApprox(asymmetry); // 0.5..2 around 1

mug, muk = rcDampCoeffs1(6000, compensate); // highshelf compensation @6kHz, pre rcOnePole()
makeUpGain = dbtoaApprox(makeup); // manual but pre rcOnePole()
toneG = rcPreWarp2(15000); // Hz, todo
highG = rcPreWarp1(highpass); // Hz

up = int(attack);
down = int(decay);
uphalf = int(up * 0.5);
downhalf = int(down * 0.5);

// audio rate from here

if ( (init) || (prevSR != SAMPLERATE) ) {
    od   = mstosamps(86400000);
    k1, k2, k3, k4, k5, k6, VT, A1 = diodeCoeffsV(SAMPLERATE);
    prevSR = SAMPLERATE;
    init = 0;
}
heat = clip((elapsed / od), 0, 1);

resetavg = (delta(change(etype)) < 0) + (delta(change(eint)) < 0) + (delta(change(emode)) < 0);
resetdio = delta(change(dio)) < 0;
reset = resetavg + resetdio;

X = safe20dB(in1); // if user input > 20dB above FS will antialias hardclip, otherwise totally linear
align.write(X);
xAlign = align.read(eint, interp="none");

// pete says, "e works"
avgFast, avgMedium, avgSlow = averageData(X * e, reset, interval=eint, mode=emode);
envData = selector((etype + 1), avgFast, avgMedium, avgSlow);

zeroxSmooth = sampstoms(down + down);
// increasing 'countDiv' makes bias env smaller for noisey input audio
threshEnv, countEnv, xings = zeroxEnvs(xAlign, zeroxSmooth, resetavg, countDiv=10); // align with 'averageData()'

envMain = vactrol(envData, up, down, resetavg); // main for gainEnv: avgFast, avgMedium or avgSlow
envSub = vactrol(avgMedium, uphalf, downhalf, resetavg); // always 'avgMedium'
//invSub = 1 - (envSub * hysterisis); // not used

// 'immediate' based on 'X', not xAlign
envImm = immediateEnv(X, 0.000001, zeroxSmooth*0.001, resetavg); // secs
// dcblock is for shape, not for dc
envHyst1 = dcblock(clip((envSub - slide(envData, uphalf, downhalf)), -1, 1)) * hysterisis;
envHyst2 = 1 - ((envSub - envImm) * hysterisis * countEnv);

// goes above and below 1 so we get a compression expansion effect, depends on 'envscale'
gainEnv = (envMain + threshEnv) * (1 - envcomp) + envcomp + envcomp + envcomp; // 0..2++
biasEnv = clip((envMain - envSub) * countEnv, -0.333333333333, 0.333333333333);

// if one of these is on we have single gain env (normal), if both are on we have double
// enveloping (crazy), if both are off we have no dynamic gain and we are quasi 'static' distortion
gainEnvPre = asymenv ? gainEnv : 1;
gainEnvPost = valveenv ? gainEnv : 1;

// input EQ (gain) is post envelope makers
XIN = xAlign;
if (treble != 0 || bass != 0) { // only compute if engaged
    XIN = evi_baxandall(xAlign, treble=treble, bass=bass, smooth=1);
}

asymInput = XIN * gainEnvPre;
asymHist1 = abs(envHyst1) + 1;//envHyst1 + 1; // pos env, boost smaller
asymHist2 = (0 - (envHyst1 * envHyst1)) + 1; // neg env, attenuate bigger
asymOutput, asymPos, asymNeg = asymExecute(asymInput, asymskew, asymHist1, asymHist2, heat, softhard=dio, low=2.1, high=3.9);

valveInput = asymOutput * 0.25; // approx -4..4 .. -1..1

// ^^ until this point everything has been linear (high gain)

// nonlinear, "asymmetrical double sided"
valve = 0;
// do not additionally dcblock anything in this block
if (dio) {  // 'hard'
//  k1, k2, k3, k4, k5, k6, VT, A1 = diodeCoeffsV(SAMPLERATE);
    valve = diodeGB_8x_4POINT(valveInput, k1, k2, k3, k4, k5, k6, VT, A1, gainEnvPost, biasEnv, reset) * 1.995262;
}
else {      // 'soft'
    ingain, outgain = atanDriveV(gainEnvPost);
    ataninput = valveInput * ingain + biasEnv;
    valve = atanAdaa2_4x_6POINT(ataninput, reset) * outgain;
}

// marketing people call this "air"
valveOutput = rcFilterDamp(valve * envHyst2, mug, muk); // * hysterisis, through hf compensation

// similar arrangement to 'evi_tone_macro.gendsp':
eviValve = rcOnePole(valveOutput * makeUpGain, toneG); // NR nonlinear onepole
out1 = rcFilterHp(eviValve, highG); // main

out2 = gainEnv; // main env, linear, 0..2++
out3 = eint; // latency in samples

