// For more options, greater bandwidth and high-gain anti-aliasing, @see: evi_clip_hardsoft.gendsp (more expensive).
// For hard clipping only @see: "evi_hardclip.gendsp".


require("evi_adaa.genexpr");


out1 = altTanhAdaa2(in1);


