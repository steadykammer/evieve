
// 8-band parametric EQ using TPT SVF filters, a copy of Ableton 'EQ8',
// @see: "evi_eq5.gendsp" for a slightly more manageable parametric EQ.
// For audio rate control of all EQ parameters @see: "evi_eq3.gendsp".

require("evi_svfs_lto.genexpr");

eqBand(x, cutoff, db, Q, filter, reset, smooth=0)
{
    History eqbdummy(0);
    band = 0;
    if (filter == 1 || filter == 9) {
        highlow = (filter == 1) ? 1 : 7;
        band = eviFilterEq4Reset(x, cutoff, db, Q, highlow, reset, smooth=smooth);
    }
    else {
        band = eviFilterEqReset(x, cutoff, db, Q, (filter - 1), reset, smooth=smooth);
    }
    return band;
}

Param   smooth(15.333, min=0, max=333);

/*
    "bandXfilter"
	Index	Filter
	0 		Bypass
    1       Highpass 4-pole
	2 		Highpass
	3 		Lowshelf
	4 		Bell
    5       BellAdaptiveQ
	6 		Notch
	7 		Highshelf
	8 		Lowpass
    9       Lowpass 4-pole
*/

Param   band1filter(3, min=0, max=9);
Param   band1freq(63., min=10, max=18000);
Param   band1db(0., min=-24, max=24);
Param   band1q(1., min=0.1, max=18);

Param   band2filter(4, min=0, max=9);
Param   band2freq(125., min=10, max=18000);
Param   band2db(0., min=-24, max=24);
Param   band2q(sqrt1_2, min=0.1, max=18);

Param   band3filter(4, min=0, max=9);
Param   band3freq(250., min=10, max=18000);
Param   band3db(0., min=-24, max=24);
Param   band3q(sqrt1_2, min=0.1, max=18);

Param   band4filter(4, min=0, max=9);
Param   band4freq(500., min=10, max=18000);
Param   band4db(0., min=-24, max=24);
Param   band4q(sqrt1_2, min=0.1, max=18);

Param   band5filter(4, min=0, max=9);
Param   band5freq(1000., min=10, max=18000);
Param   band5db(0., min=-24, max=24);
Param   band5q(sqrt1_2, min=0.1, max=18);

Param   band6filter(4, min=0, max=9);
Param   band6freq(2000., min=10, max=18000);
Param   band6db(0., min=-24, max=24);
Param   band6q(sqrt1_2, min=0.1, max=18);

Param   band7filter(4, min=0, max=9);
Param   band7freq(4000., min=10, max=18000);
Param   band7db(0., min=-24, max=24);
Param   band7q(sqrt1_2, min=0.1, max=18);

Param   band8filter(6, min=0, max=9);
Param   band8freq(8000., min=10, max=18000);
Param   band8db(0., min=-24, max=24);
Param   band8q(1., min=0.1, max=18);

band1filt   = int(band1filter);
band2filt   = int(band2filter);
band3filt   = int(band3filter);
band4filt   = int(band4filter);
band5filt   = int(band5filter);
band6filt   = int(band6filter);
band7filt   = int(band7filter);
band8filt   = int(band8filter);

band1reset  = delta(change(band1filt)) < 0;
band2reset  = delta(change(band2filt)) < 0;
band3reset  = delta(change(band3filt)) < 0;
band4reset  = delta(change(band4filt)) < 0;
band5reset  = delta(change(band5filt)) < 0;
band6reset  = delta(change(band6filt)) < 0;
band7reset  = delta(change(band7filt)) < 0;
band8reset  = delta(change(band8filt)) < 0;

x0  = in1;

y1  = eqBand(x0, band1freq, band1db, band1q, band1filt, band1reset, smooth=smooth);
y2  = eqBand(y1, band2freq, band2db, band2q, band2filt, band2reset, smooth=smooth);
y3  = eqBand(y2, band3freq, band3db, band3q, band3filt, band3reset, smooth=smooth);
y4  = eqBand(y3, band4freq, band4db, band4q, band4filt, band4reset, smooth=smooth);
y5  = eqBand(y4, band5freq, band5db, band5q, band5filt, band5reset, smooth=smooth);
y6  = eqBand(y5, band6freq, band6db, band6q, band6filt, band6reset, smooth=smooth);
y7  = eqBand(y6, band7freq, band7db, band7q, band7filt, band7reset, smooth=smooth);
y8  = eqBand(y7, band8freq, band8db, band8q, band8filt, band8reset, smooth=smooth);

out1    = y8;

