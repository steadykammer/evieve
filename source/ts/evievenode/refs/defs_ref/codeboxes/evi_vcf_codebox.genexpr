
// Puckette's vcf~ from Pd by pete for evieve, original (c) Puckette, BSD

cosQ73v(x) {
	c1 =  0.999999953464;
	c2 = -0.499999053455;
	c3 =  0.0416635846769;
	c4 = -0.0013853704264;
	c5 =  0.00002315393167;  	

	x2 = x * x;
	return (c1 + x2 * (c2 + x2 * (c3 + x2 * (c4 + c5 * x2))));
}

// optimised version: x is already clamped to 0.. and at audio rate
// 6 muls at any one time, plus the branching
cos73nc(x) {
	// get quadrant # (0 to 2) we're in
	quad = int(x * 0.63661977236758);// 2 / pi
	cosreturn = 0;
	if 				(quad == 0) {
		cosreturn =  cosQ73v(x);
	} else if 		(quad == 1) {
		cosreturn = -cosQ73v(pi - x);
	} else if 		(quad == 2) {	// we only might reach the 3rd quadrant
		cosreturn = -cosQ73v(x - pi);
	} else {	//	(quad == 3)		// we never reach the 4th quadrant here
		cosreturn =  cosQ73v(twopi - x);
	}
	return cosreturn;
}

sin73nc(x) {
	return cos73nc(halfpi - x);
}

// [vcf~] from Pd is just a direct form 2 solved for sin()
// (this is basically just [bp~] but a bit better)
pd_vcf(x0, hz)
{
	History	b1(0), b2(0);
	Param	q(sqrt2, min=0.1);

	odq	= 1 / q;
	cf	= hz * twopi / samplerate;
	r	= maximum((1 - cf * odq), 0);

	a1	= cos73nc(cf) * r;	// cf needs up to pi rather than just halfpi
	a2	= sin73nc(cf) * r;

	bp	= ((x0 * (1 - r) * (2 - 2 / (q + 2))) + (b1 * a1)) - (b2 * a2);
	lp	=  (b1 * a2) + (a1 * b2);
	hp	=  (x0 - (q * bp) - lp) * odq;

	b1	= bp;
	b2	= lp;

	return bp, lp, hp;		// real, imaginary, pete
}

Param	q(sqrt2, min=0.1, max=10000);	// max ?

// in terms of Hz ("in 2"), anything above (samplerate/twopi)
// can be a bit funky if q is low, depending on filter type
// but still much larger and more stable range than [bp~]
hz		= clamp(in2, 0.01, 18000);

out1, out2, out3	= pd_vcf(in1, hz, q=q);
// others: peak = (hp - lp), broken notch = (hp + lp)

