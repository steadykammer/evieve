
// sometimes we just need to add some harmonics to our audio. that is what this does, even or odd.

hShapeCoeff(shape)
{
    sgz = shape > 0;

    ashape = abs(shape);
    sshape = ashape * ashape;
    pshape = (shape + 1) * 0.5;

    spc = clip(shape, 0, 1);
    snp = clip(shape, -1, 0) + 1;

    return ashape, sshape, pshape, spc, snp, sgz;
}

hEven(x)
{
    a0 = x * x;
    a1 = a0 * a0;
    a2 = a1 * a1;
    a3 = a2 * a2;
    return a0, a1, a2, a3;
}

hOdd(x, a0, a1, a2)
{
    b0 = x * a0;
    b1 = b0 * a0;
    b2 = b1 * a1;
    b3 = b2 * a2;
    return b0, b1, b2, b3;
}

hMix(mix, c0, c1, c2, c3)
{   // sorry
    return interp((clip(mix, 3, 4) - 3), 
            (interp((clip(mix, 2, 3) - 2), 
                (interp((clip(mix, 1, 2) - 1), 
                    (c0), (c1), mode="cosine") * clip(mix, 0, 1)), 
                        (c2), mode="cosine")), 
                            (c3), mode="cosine");
}

hShaper(x, shape, harmonics, compensate=1)
{
    hc = 1; // todo, compensate odd + harmonics == 0
    hmf = harmonics * 4;    // harmonics coeffs

    ashape, sshape, pshape, spc, snp, sgz = hShapeCoeff(shape); // shape coeffs

    sinterp = spc * hmf;
    hinterp = hmf - (snp * hmf);
    v = ((1 - sqrt(harmonics * (shape < 0))) * 0.055939) + 0.944061;    // compensate

    // even harmonics
    a0, a1, a2, a3 = hEven(x);
    // odd harmonics
    b0, b1, b2, b3 = hOdd(x, a0, a1, a2);

    odd = hMix(sinterp, (b0 * hc), b1, b2, b3);
    even = hMix(hinterp, a0, a1, (a2 * v), (a3 * v));
    shaper = sgz ? odd : dcblock(even); // 1..8 harmonics

    shaped = (((sshape * shaper) + x) * (1 - (spc * 0.5))) * (((pshape * pshape) * 0.076989) + 0.630957);
    return (shaped) * (compensate ? (((1 - ashape) * 0.412538) + 1) : 1);
}

Param   shape(0., min=-1, max=1);       // > 0 == odd harmonics, < 0 = even harmonics
Param   harmonics(0.5, min=0, max=1);   // 0..1 = 0..8 harmonics (0 = 0, 0.25 = 1, 0.5 = 2, 0.75 = 4, 1 = 8)
Param   compensate(1, min=0, max=1);    // gain compensation

Param   smooth(0., min=0, max=666);     // optional smoothing in ms (default off)
smoothsamps = mstosamps(smooth);

c   = int(compensate);
s   = shape;
h   = harmonics;
if (smooth > 0) {
    s   = evi_line(s, smoothsamps);     // must be exact smoothers 'cos of crossings
    h   = evi_line(h, smoothsamps);
}

out1    = hShaper(in1, s, h, compensate=c);

