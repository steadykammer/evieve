
// nonlinear analog onepole filter using trapezoidal integration and newton-raphson loop,
// "oversample" param in addition to newton loop. @see: "evi_rcfilters.genexpr" for details.
// choice of frequency input in Hz (default) or normalised 0..1, optional smoothing is default off.
// @see: "evi_onepole.gendsp" / [evi.onepole~] for multimode linear version.

require("evi_rcfilters.genexpr");

Param   smooth(0, min=0, max=333);      // ms
Param   oversample(0, min=0, max=1);    // 1 = bad 2x oversampling, 0 = 1x (default)
Param   prewarp(1, min=0, max=1);       // 1 = input in Hz, 0 = input in 0..1 quasi radians
pw      = int(prewarp);
os      = int(oversample);

g       = pw ? rcPreWarp2(clamp(in2, 1, samplerate*0.5)) : clamp(in2, 0, 1);

if (smooth > 0) {
    g   = evi_logsmooth(g, smooth);
}

rclp    = 0;

if (os) {
    rclp    = rcOnePole_x2(in1, g);
}
else {
    rclp    = rcOnePole(in1, g);
}

out1    = rclp;

