
// onepole damping filter using trapezoidal integration, simultaneous outputs, very smooth and very cheap,
// useful for damping in reverbs and other situations.
// frequency input in Hz, shelving input (damp) is linear 0..1, optional smoothing attributes are default off.

// @see: "evi_onepole.gendsp" / [evi.onepole~] for linear onepoles.
// @see: "evi_onepole_shelving.gendsp" / [evi.onepole.shelving~] for onepole shelving.
// @see: "evi_filter_shelving.gendsp" / [evi.filter.shelving~] etc for twopoles.

require("evi_rcfilters.genexpr");


Param   smoothfreq(0., min=0, max=333);     // ms
Param   smoothdamp(0., min=0, max=333);     // ms

// "Damp" (in3) input:
// 0 == bypassed, 1 == low or high pass, 0..1 == shelving attenuation

g, k    = rcDampCoeffs0(in2, in3);          // could just as easily be 'sqrt(in3)'

if (smoothfreq > 0) {
    g   = evi_logsmooth(g, smoothfreq);
}

if (smoothdamp > 0) {
    k   = evi_expsmooth(k, smoothdamp);
}

LpHs, HpLs  = rcFilterDampLpHp(in1, g, k);

out1    = LpHs;     // lowpass/highshelf    // with damp @ 0.71..0.99 similar to MSP [onepole~] depending on Hz
out2    = HpLs;     // highpass/lowshelf

