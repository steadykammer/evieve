
// these are the antiderivatives of the approximation, not of a real tanh - that is crucial !
// sadly we still end up with a bloody Li2 in the 2nd order :-(

// note: this tanh approx becomes not-tanh-like above about +22dB input gain (wave folds)
// note: the entire approx is -6dB down, but we boost it on input before adaa to match tanh()

require("evi_saturators.genexpr");
require("evi_smooth.genexpr");
require("evi_rcfilters.genexpr");

History	reset(1);

// input filter shaping
Param	lowcutoff(40., min=10, max=400);	// hz ...
Param	highcutoff(4000., min=1000, max=16000);
Param	lowdamp(0.5, min=0, max=1);			// default shelfs ...
Param	highdamp(0.5, min=0, max=1);

Param	smooth(22.666, min=0, max=333);		// smooth in2 & io in ms
Param	io(0., min=-1, max=1);		        // 0..-1 pre-boost/post-atten, 0..1 inverse, ± 12 dB, 0.138071 ± 3 dB
Param	hfcompensate(1, min=0, max=1);		// default on
Param	aa(3, min=0, max=5);				// default Adaa2
adaaxx	= int(aa);
hfcomp	= int(hfcompensate);
smoothsecs		= smooth * 0.001;			// secs

resetaa	= delta(change(adaaxx)) < 0;
resethf	= delta(change(hfcomp)) < 0;
reset	= resetaa + resethf;

drive	= in2 + 0;
iowrapper	= (abs(io) * 3) + 1;			// 1..4 = ± 12 dB
iogain, lowfilter, highfilter	= expsmoothBank3(iowrapper, lowdamp, highdamp, 0.022666);
io_in	= io >= 0 ? 1 / iogain : iogain;
io_out	= io < 0 ? 1 / iogain : iogain;

if (smooth > 0) {							// turn off if modulating in2 at audio rate
	drive	= logsmooth(drive, smoothsecs);
}

tanhinput		= in1 + 0;
lp				= tanhinput;
hp, lopath, hipath	= 0;
k1, k2			= 0;
if (lowdamp > 0 || highdamp > 0) {
	g1, k1		= rcDampCoeffs0(lowcutoff, lowfilter);
	g2, k2		= rcDampCoeffs0(highcutoff, highfilter);
	lopath, hp	= rcFilterDampLpHp(tanhinput, g1, k1);
	lp, hipath	= rcFilterDampLpHp(hp, g2, k2);
}

tanhinput	= lp * drive * io_in;
tanhoutput	= 0;
if (adaaxx == 1) {
	tanhoutput = altTanhAdaa1_2x_6POINT(tanhinput, reset);
} else if (adaaxx == 2) {
	tanhoutput = altTanhAdaa1_4x_6POINT(tanhinput, reset);
} else if (adaaxx == 3) {	// default
	tanhoutput = altTanhAdaa2(tanhinput, reset);
} else if (adaaxx == 4) {
	tanhoutput = altTanhAdaa2_2x_6POINT(tanhinput, reset);
} else if (adaaxx == 5) {
	tanhoutput = altTanhAdaa2_4x_6POINT(tanhinput, reset);
} else {					// (adaaxx == 0)
	tanhoutput = altTanhAdaa1(tanhinput, reset);
}

if (hfcomp) {
	tanhoutput = decorelate(tanhoutput);
}

out1	= (tanhoutput + (lopath * sqrt(k1) * 0.5) + (hipath * (k2*k2) * sqrt1_2)) * io_out;

