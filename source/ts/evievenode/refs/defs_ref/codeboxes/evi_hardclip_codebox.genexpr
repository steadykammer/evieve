
// hard clipping for your audio, the evieve way.
// anti derivative anti aliasing, 1st & 2nd orders.
// also fake oversampling options, 2x & 4x for both 1st & 2nd orders.
// this works well up to about +40dB input.


require("evi_interp.genexpr");


xSgnP(x) // no zero
{
	return (0 < x) - (x < 0);
}

xRangeP(x, range=1)
{
	return abs(x) <= range;
}


funcHc0(x, clip=1)
{
	return clamp(x, -clip, clip);
}

funcHc1(x, limit=1)
{
	ad1 = x;
	ir = xRangeP(x, range=limit);
	if (ir) {
		ad1 = x * x * 0.5;
	} else {
		ad1 = x * xSgnP(x) - 0.5;
	}
	return ad1;
}

funcHc2(x, limit=1)
{
	ad2 = x;
	ods = 0.166666666666667;
	ir = xRangeP(x, range=limit);
	if (ir) {
		ad2 = x * x * x * ods;
	} else {
		x05 = x * 0.5;
		ad2 = ((x * x05) + ods) * xSgnP(x) - x05;
	}
	return ad2;
}


// in the below, "limit" only really works with very small deviations from '1' :-(

adHc1(x, limit=1) // first antiderivative
{
	History x1(0), ad1_x1(0);
	TOL = 0.00001;
	xmx1 = x - x1;
	illCondition = abs(xmx1) < TOL;
	ad1_x = funcHc1(x, limit=limit);

	y = 0;
	if (illCondition) {
		y = funcHc0(0.5 * (x + x1), clip=limit);
	} else {
		y = (ad1_x - ad1_x1) / xmx1;
	}

	ad1_x1 = ad1_x;
	x1 = x;

	return y;
}

adHc2(x, limit=1) // second antiderivative
{
	History x1(0), x2(0), ad2_x1(0), d2(0);
	TOL = 0.00001;
	xmx2 = x - x2;
	illCondition = abs(xmx2) < TOL;

	d1 = x;
	xmx1 = x - x1;
	d1Condition = abs(xmx1) < TOL;
	ad2_x0 = funcHc2(x, limit=limit);
	if (d1Condition) {
		d1 = funcHc1(0.5 * (x + x1), limit=limit);
	} else {
		d1 = (ad2_x0 - ad2_x1) / xmx1;
	}

	fb = x;
	xBar = 0.5 * (x + x2);
	delta = xBar - x1;
	fallbackCondition = abs(delta) < TOL;
	if (fallbackCondition) {
		fb = funcHc0(0.5 * (xBar + x1), clip=limit);
	} else {
		fb = (2 / delta) * (funcHc1(xBar, limit=limit) + (ad2_x1 - funcHc2(xBar, limit=limit)) / delta);
	}

	y = x;
	if (illCondition) {
		y = fb;
	} else {
		y = (2 / xmx2) * (d1 - d2);
	}

	d2 = d1;
	x2 = x1;
	x1 = x;
	ad2_x1 = ad2_x0;

	return y;
}


// fixed 2x quasi oversampling (hermite6)
adHc1_2x_6POINT(XIN, thresh=1)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 2x
	y1_0	= adHc1(x1_0, limit=thresh);
	y2_0	= adHc1(x2_0, limit=thresh);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return dcblock(y0_0);
}

// fixed 4x quasi oversampling (hermite6)
adHc1_4x_6POINT(XIN, thresh=1)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 4x
	y1_0	= adHc1_2x_6POINT(x1_0, thresh=thresh);
	y2_0	= adHc1_2x_6POINT(x2_0, thresh=thresh);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return dcblock(y0_0);
}


// fixed 2x quasi oversampling (hermite6)
adHc2_2x_6POINT(XIN, thresh=1)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 2x
	y1_0	= adHc2(x1_0, limit=thresh);
	y2_0	= adHc2(x2_0, limit=thresh);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return dcblock(y0_0);
}

// fixed 4x quasi oversampling (hermite6)
adHc2_4x_6POINT(XIN, thresh=1)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 4x
	y1_0	= adHc2_2x_6POINT(x1_0, thresh=thresh);
	y2_0	= adHc2_2x_6POINT(x2_0, thresh=thresh);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return dcblock(y0_0);
}


// do not use "limit"
Param   limit(1, min=0.9, max=1.1);
Param   aa(3, min=0, max=5);    // default Adaa 2nd order
aaxx    = int(aa);

clipped = 0;
if (aaxx == 1) {
    clipped = adHc1_2x_6POINT(in1, thresh=limit);
}
else if (aaxx == 2) {
    clipped = adHc1_4x_6POINT(in1, thresh=limit);
}
else if (aaxx == 3) {
    clipped = adHc2(in1, limit=limit);
}
else if (aaxx == 4) {
    clipped = adHc2_2x_6POINT(in1, thresh=limit);
}
else if (aaxx == 5) {
    clipped = adHc2_4x_6POINT(in1, thresh=limit);
}
else {
    clipped = adHc1(in1, limit=limit);
}

out1    = clipped;

