{
    "object": {
        "name": "evi.eq8~",
        "parent": "evi_eq8",
        "category": "evieve",
        "tilde": "~",
        "digest": "8-band TPT EQ with message rate control of all parameters",
        "description": "An 8-band parametric EQ made up of 8 TPT SVF EQ filters, each with selectable filter type. Parameter changes can optionally be smoothed. <o>evi.eq8~</o> uses the same filter DSP and offers the same filter types as Ableton 'EQ8'.",
        "discussion": "For more information about TPT SVFs and other filter types in evieve see the 'evieve filter' tab of the helpfile."
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": []
    },
