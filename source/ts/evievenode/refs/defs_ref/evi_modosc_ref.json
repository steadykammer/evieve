{
    "object": {
        "name": "evi.modosc~",
        "parent": "evi_modosc",
        "category": "evieve",
        "tilde": "~",
        "digest": "A simple cosine LFO with range and offset shaping",
        "description": "A very basic cosine oscillator for modulation purposes with sample accurate and clickless automatic phase reset when Hz input == 0, along with range and offset mapping.",
        "discussion": ""
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": [
            "evieve Oscillator",
            "evieve Control",
            "evieve Modulation",
            "evieve Source",
            "evieve Map",
            "evieve Utility"
        ]
    },
    "includes": [
        "evi_smooth.genexpr"
    ],
    "inlets": [
        {
            "id": 1,
            "type": "signal/float",
            "digest": "Frequency in Hz +/-",
            "description": "Any frequency in Hz."
        },
        {
            "id": 2,
            "type": "signal",
            "digest": "Signal Rate Phase Reset (Naive)",
            "description": "Reset internal phase of oscillator."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "modulation -1..1 Sine Oscillator * scale + offset",
            "description": "Modulation signal offset and scaled."
        },
        {
            "id": 2,
            "type": "signal",
            "digest": "Raw Osc -1..1",
            "description": "Auxilliary output, raw and unscaled -1..1 oscillator for further downstream processing."
        }
    ],
    "messages": [
        {
            "name": "history",
            "arg": [
                {
                    "name": "autoreset",
                    "type": "int",
                    "units": "default: 1",
                    "optional": 1
                }
            ],
            "digest": "Top level gen~ [history] / History() declarations can be reset by messages to the object",
            "description": false
        }
    ],
    "attributes": [
        {
            "name": "freqsmooth",
            "get": 1,
            "type": "float",
            "digest": "Time in ms",
            "description": "Smooth the input frequency (inlet 1) by this amount in ms. Turn off (0) if audio rate modulating the inlet.",
            "default": {
                "min": "0",
                "max": "666",
                "value": "20."
            }
        },
        {
            "name": "offset",
            "get": 1,
            "type": "float",
            "digest": "Any value",
            "description": "Offset the output oscillator value by this amount.",
            "default": {
                "min": "0",
                "max": "0",
                "value": "0.\t\t\t\t\t\t\t\t"
            }
        },
        {
            "name": "resetauto",
            "get": 1,
            "type": "int",
            "digest": "Flag 0/1",
            "description": "Automatic zero phase reset off/on, default on.",
            "default": {
                "min": "0",
                "max": "1",
                "value": "1"
            }
        },
        {
            "name": "scale",
            "get": 1,
            "type": "float",
            "digest": "Any value",
            "description": "Scale the output oscillator range between 0 and this amount. Note the oscillator is bipolar.",
            "default": {
                "min": "0",
                "max": "0",
                "value": "1."
            }
        },
        {
            "name": "smooth",
            "get": 1,
            "type": "float",
            "digest": "Time in ms",
            "description": "Smooth the @offset and @scale attributes by this amount in ms.",
            "default": {
                "min": "0",
                "max": "333",
                "value": "22.666"
            }
        }
    ],
    "example": {
        "caption": "",
        "image": ""
    },
    "seealso": [
        "evi.phasor0~",
        "evi.ramp0~",
        "evi.randy~",
        "evi.zeroxcount~",
        "evi.audiodust~"
    ]
}