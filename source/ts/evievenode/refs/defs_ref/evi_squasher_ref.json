{
    "object": {
        "name": "evi.squasher~",
        "parent": "evi_squasher",
        "category": "evieve",
        "tilde": "~",
        "digest": "Antialiased quadratic signal shaper",
        "description": "<o>evi.squasher~</o> is a simple passive audio signal quadratic shaper. <o>evi.squasher~</o> is antialiased via anti derivative antialiasing, but is not designed for driving with high gain.",
        "discussion": "See the helpfile for an example of how to cope with unknown input ranges."
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": [
            "evieve Nonlinear",
            "evieve Saturation",
            "evieve Antialiased"
        ]
    },
    "includes": [
        "evi_adaa.genexpr"
    ],
    "inlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Audio to be shaped",
            "description": "Audio input is expected not to exceed -1..1"
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "Antialiased shaped output",
            "description": "Output is waveshaped and antialiased"
        }
    ],
    "messages": [],
    "attributes": [
        {
            "name": "harmonics",
            "get": 1,
            "type": "int",
            "digest": "Select 0..3",
            "description": "The shaper can be switched between soft..hard over 4 settings. 0 = the least harmonics, 3 = the most harmonics.",
            "default": {
                "min": "0",
                "max": "3",
                "value": "2"
            }
        }
    ],
