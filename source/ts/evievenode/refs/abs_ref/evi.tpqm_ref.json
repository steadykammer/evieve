{
    "object": {
        "name": "evi.tpqm",
        "category": "evieve",
        "digest": "Three point quadratic map",
        "description": "A utility abstraction that allows for value scaling from a linear input map to a linear output map. Map three input points to three output points and linearly scale between them.",
        "discussion": ""
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": [
            "evieve Control",
            "evieve Utility",
            "evieve Map"
        ]
    },
    "inlets": [
        {
            "id": 1,
            "type": "int/float",
            "digest": "input to map / (list) input & in/out mappings",
            "description": "int/float is an inout to map. list is input and list of up to 6 additional values for in/out mapping."
        },
        {
            "id": 2,
            "type": "int/float",
            "digest": "in low",
            "description": "Low input value."
        },
        {
            "id": 3,
            "type": "int/float",
            "digest": "in mid",
            "description": "Mid point input value."
        },
        {
            "id": 4,
            "type": "int/float",
            "digest": "in high",
            "description": "High input value."
        },
        {
            "id": 5,
            "type": "int/float",
            "digest": "out low",
            "description": "Low output value."
        },
        {
            "id": 6,
            "type": "int/float",
            "digest": "out mid",
            "description": "Mid point output value."
        },
        {
            "id": 7,
            "type": "int/float",
            "digest": "out high",
            "description": "High output value."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "float",
            "digest": "mapped output",
            "description": "The output value mapped via the three point quadratic map."
        },
        {
            "id": 2,
            "type": "list",
            "digest": "mapping list (if @dumpout == 1)",
            "description": "The dumpout sends the current list of mappings if @dumpout attribute is on."
        }
    ],
    "arguments": [
        {
            "name": "LowIn",
            "type": "float",
            "default": "0.",
            "optional": 1,
            "digest": "arg#1: Low input value",
            "description": "Low input value to map from"
        },
        {
            "name": "MidPointIn",
            "type": "float",
            "default": "0.5",
            "optional": 1,
            "digest": "arg#2: Mid point input value",
            "description": "Mid point input value to map from"
        },
        {
            "name": "HighIn",
            "type": "float",
            "default": "1.",
            "optional": 1,
            "digest": "arg#3: High input value",
            "description": "High input value to map from"
        },
        {
            "name": "LowOut",
            "type": "float",
            "default": "0.",
            "optional": 1,
            "digest": "arg#4: Low output value",
            "description": "Low output value to map to"
        },
        {
            "name": "MidPointOut",
            "type": "float",
            "default": "0.5",
            "optional": 1,
            "digest": "arg#5: Mid point output value",
            "description": "Mid point output value to map to"
        },
        {
            "name": "HighOut",
            "type": "float",
            "default": "1.",
            "optional": 1,
            "digest": "arg#6: High output value",
            "description": "High output value to map to"
        }
    ],
    "messages": [],
    "attributes": [
        {
            "name": "dumpout",
            "get": 0,
            "type": "int",
            "digest": "Flag 0/1",
            "description": "If on, outputs current map list from the far right dumpoutlet.",
            "default": {
                "get": 0,
                "value": "0"
            }
        },
        {
            "name": "hot",
            "get": 0,
            "type": "int",
            "digest": "Flag 0/1",
            "description": "If on, updates output with every map input change.",
            "default": {
                "get": 0,
                "value": "0"
            }
        },
        {
            "name": "initial",
            "get": 0,
            "type": "symbol",
            "digest": "Value",
            "description": "Sets an initial value on load.",
            "default": {
                "get": 0,
                "value": "none"
            }
        }
    ],
    "example": {
        "caption": "",
        "image": ""
    },
    "seealso": [
        "evi.list.interp",
        "evi.list.xfade",
        "mc.evi.listgen",
        "evi.transratio"
    ]
}