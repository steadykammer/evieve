{
    "object": {
        "name": "evi.adsr~",
        "category": "evieve",
        "digest": "ADSR envelope generator, similar features to <o>adsr~</o> but with logarithmic segments",
        "description": "ADSR by default, but actually DAHDSHR capabale generator via attributes. Logarithmic segment shapes but still capable of controlling <o>poly~</o> and <o>thispoly~</o>.",
        "discussion": ""
    },
    "metadata": {
        "author": "Pete Dowling",
        "tags": []
    },
    "inlets": [
        {
            "id": 1,
            "type": "signal/float",
            "digest": "trigger/gate",
            "description": "Non-zero triggers the envelope, which will sustain until a zero is received or another non-zero is received."
        },
        {
            "id": 2,
            "type": "signal/float",
            "digest": "attack",
            "description": "Attack time in ms"
        },
        {
            "id": 3,
            "type": "signal/float",
            "digest": "decay",
            "description": "Decay time in ms"
        },
        {
            "id": 4,
            "type": "signal/float",
            "digest": "sustain",
            "description": "Sustain (linear amplitude)"
        },
        {
            "id": 5,
            "type": "signal/float",
            "digest": "release",
            "description": "Release time in ms"
        }
    ],
    "outlets": [
        {
            "id": 1,
            "type": "signal",
            "digest": "adsr+ envelope",
            "description": "dAhDShR envelope with logarithmic segments"
        },
        {
            "id": 2,
            "type": "signal",
            "digest": "new envelope trigger",
            "description": "Trigger up on new envelope, trigger down on beginning of release stage"
        },
        {
            "id": 3,
            "type": "message",
            "digest": "mute outlet to [thispoly~]",
            "description": "Attach to 'thispoly~' to control 'poly~' voice mute state"
        },
        {
            "id": 4,
            "type": "signal",
            "digest": "set busy state to [thispoly~]",
            "description": "Attach to 'thispoly~' to control 'poly~' busy state"
        }
    ],
    "arguments": [
        {
            "name": "attack",
            "type": "float",
            "default": "10.",
            "optional": 1,
            "digest": "arg#1: attack time in ms",
            "description": "Attack time in ms"
        },
        {
            "name": "decay",
            "type": "float",
            "default": "100.",
            "optional": 1,
            "digest": "arg#2: decay time in ms",
            "description": "Decay time in ms"
        },
        {
            "name": "sustain",
            "type": "float",
            "default": "0.707946",
            "optional": 1,
            "digest": "arg#3: sustain (linear amplitude)",
            "description": "Sustain (linear amplitude)"
        },
        {
            "name": "release",
            "type": "float",
            "default": "200.",
            "optional": 1,
            "digest": "arg#4: release time in ms",
            "description": "Release time in ms"
        }
    ],
    "messages": [],
    "attributes": [
        {
            "name": "attack",
            "get": 0,
            "type": "float",
            "digest": "Attack time in ms",
            "description": "",
            "default": {
                "get": 0,
                "value": "10."
            }
        },
        {
            "name": "decay",
            "get": 0,
            "type": "float",
            "digest": "Decay time in ms",
            "description": "",
            "default": {
                "get": 0,
                "value": "100."
            }
        },
        {
            "name": "delay",
            "get": 0,
            "type": "float",
            "digest": "Delay time in ms",
            "description": "Initial delay time in ms before the attack segment of the envelope",
            "default": {
                "get": 0,
                "value": "0."
            }
        },
        {
            "name": "envmax",
            "get": 0,
            "type": "float",
            "digest": "Expected maximum of input to left trigger inlet",
            "description": "This can be any value, by default it assumes velocity. Only used if the <m>velocitysense</m> attribute is > 0.",
            "default": {
                "get": 0,
                "value": "127."
            }
        },
        {
            "name": "fallratio",
            "get": 0,
            "type": "float",
            "digest": "Ratio 0..10, minimum -120dB",
            "description": "Ratio 0..10, very exponential..almost linear",
            "default": {
                "get": 0,
                "value": "0.05"
            }
        },
        {
            "name": "hold1",
            "get": 0,
            "type": "float",
            "digest": "Time in ms",
            "description": "Time in ms for first hold segment, between attack and decay",
            "default": {
                "get": 0,
                "value": "0."
            }
        },
        {
            "name": "hold2",
            "get": 0,
            "type": "float",
            "digest": "Time in ms",
            "description": "Time in ms for second hold segment, between sustain and release",
            "default": {
                "get": 0,
                "value": "0."
            }
        },
        {
            "name": "legato",
            "get": 0,
            "type": "int",
            "digest": "Flag 0/1",
            "description": "Start from current value if reattacking active envelope (rather than ramping to zero)",
            "default": {
                "get": 0,
                "value": "0"
            }
        },
        {
            "name": "loop",
            "get": 0,
            "type": "int",
            "digest": "Flag 0/1",
            "description": "Loop the envelope off/on.",
            "default": {
                "get": 0,
                "value": "0"
            }
        },
        {
            "name": "loopsustain",
            "get": 0,
            "type": "float",
            "digest": "Time in ms",
            "description": "Add fake x ms sustain portion to looping envelope ?",
            "default": {
                "get": 0,
                "value": "100."
            }
        },
        {
            "name": "looptrigger",
            "get": 0,
            "type": "int",
            "digest": "Flag 0/1",
            "description": "Loop mode needs triggering (1) or triggers itself (0)",
            "default": {
                "get": 0,
                "value": "0"
            }
        },
        {
            "name": "maxsustain",
            "get": 0,
            "type": "float",
            "digest": "Time in ms",
            "description": "Like 'adsr~' (-1 = none, else x ms length even if gate still on).",
            "default": {
                "get": 0,
                "value": "-1."
            }
        },
        {
            "name": "muteupdate",
            "get": 0,
            "type": "int",
            "digest": "Time in ms",
            "description": "Update rate of mute message outlet.",
            "default": {
                "get": 0,
                "value": "10"
            }
        },
        {
            "name": "release",
            "get": 0,
            "type": "float",
            "digest": "Release time in ms",
            "description": "",
            "default": {
                "get": 0,
                "value": "200."
            }
        },
        {
            "name": "retrigger",
            "get": 0,
            "type": "float",
            "digest": "Time in ms",
            "description": "Fade to 0 in x ms if reattacking active envelope",
            "default": {
                "get": 0,
                "value": "5."
            }
        },
        {
            "name": "riseratio",
            "get": 0,
            "type": "float",
            "digest": "Ratio 0..10, minimum -120dB",
            "description": "Ratio 0..10, very logarithmic..almost linear",
            "default": {
                "get": 0,
                "value": "0.3"
            }
        },
        {
            "name": "sustain",
            "get": 0,
            "type": "float",
            "digest": "Sustain level",
            "description": "Linear Gain",
            "default": {
                "get": 0,
                "value": "0.707946"
            }
        },
        {
            "name": "velocitycurve",
            "get": 0,
            "type": "int",
            "digest": "Type -2, -1, 0, 1, 2",
            "description": "Velocity in curve, positive=log, 0=lin, negative=exp",
            "default": {
                "get": 0,
                "value": "1"
            }
        },
        {
            "name": "velocitysense",
            "get": 0,
            "type": "float",
            "digest": "Normalised 0..1",
            "description": "Velocity sensitivity 0..1 (<m>envmax</m> is only used if this > 0.)",
            "default": {
                "get": 0,
                "value": "0."
            }
        },
        {
            "name": "wait",
            "get": 0,
            "type": "int",
            "digest": "Flag 0/1",
            "description": "Wait until envelope 0 before allowing reattack of active envelope",
            "default": {
                "get": 0,
                "value": "0"
            }
        },
        {
            "name": "zerophase",
            "get": 0,
            "type": "int",
            "digest": "Flag 0/1",
            "description": "Sync env param changes to env start (1) or free (0)",
            "default": {
                "get": 0,
                "value": "0"
            }
        }
    ],
