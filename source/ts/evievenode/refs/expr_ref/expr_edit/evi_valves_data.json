{
    "description": "Functions required for the evieve valve distortion emulation evi.valve~, but full of useful nonlinear and enveloping building blocks.",
    "requires": [
        "evi_saturators.genexpr",
        "evi_env.genexpr",
        "evi_fastskew.genexpr",
        "evi_rcfilters.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "Safe audio output as input up to +20dB, after which it is antialiased hard clipped",
            "name": "safe20dB",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Any audio input"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Out",
                    "digest": "Safe audio output as input up to +20dB, after which it is antialiased hard clipped"
                }
            ]
        },
        {
            "document": true,
            "digest": "Safe audio output as input up to +40dB, after which it is antialiased hard clipped",
            "name": "safe40dB",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Any audio input"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Out",
                    "digest": "Safe audio output as input up to +40dB, after which it is antialiased hard clipped"
                }
            ]
        },
        {
            "document": true,
            "digest": "A very strange envelope maker based on asymmetrically clipping the input audio and using this data to create positive and negative gain envelopes",
            "name": "clipEnv",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "skew",
                    "digest": "Skew the asymmetric envelope with an approximated power 0.5..2 around 1"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "ac",
                    "digest": "Clipped raw absolute audio 0..0.5++"
                },
                {
                    "id": 2,
                    "name": "env1",
                    "digest": "Envelope 0..1"
                },
                {
                    "id": 3,
                    "name": "env2",
                    "digest": "Envelope 1..0"
                }
            ]
        },
        {
            "document": true,
            "digest": "Asymmetric audio processor favours negative waveform, output linear beyond -1..1",
            "name": "asymExecute",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "skew",
                    "digest": "Skew the asymmetric envelope with an approximated power 0.5..2 around 1"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "hyst1",
                    "digest": "Hysterisis envelope 1, leave at '1' to ignore"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "hyst2",
                    "digest": "Hysterisis envelope 2, leave at '1' to ignore"
                },
                {
                    "id": 5,
                    "kind": "input",
                    "name": "heat",
                    "digest": "This is a Pete secret and should be left at '1' for normal operation"
                },
                {
                    "id": 6,
                    "kind": "param",
                    "name": "softhard",
                    "default": 1,
                    "type": "integer",
                    "digest": "1 = raw output to outlet 1, 0 = dcblocked output to outlet 1"
                },
                {
                    "id": 7,
                    "kind": "param",
                    "name": "low",
                    "default": 2.1,
                    "type": "float",
                    "digest": "The low value (positive waveform) linear gain multiplier"
                },
                {
                    "id": 8,
                    "kind": "param",
                    "name": "high",
                    "default": 3.9,
                    "type": "float",
                    "digest": "The high value (negative waveform) linear gain multiplier"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Mix",
                    "digest": "The mixed asymmetric audio. If @softhard = 0 it is dcblocked."
                },
                {
                    "id": 2,
                    "name": "Positive Waveform",
                    "digest": "Positive only audio tap, dcblocked"
                },
                {
                    "id": 3,
                    "name": "Negative Waveform",
                    "digest": "Negative only audio tap, dcblocked"
                }
            ]
        },
        {
            "document": true,
            "digest": "Reciprocal audio wrapper for atan() saturation curve",
            "name": "atanDriveV",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "drive",
                    "digest": "Linear gain >= 1"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Pre Gain",
                    "digest": "The gain to apply to the input of an atan() saturator"
                },
                {
                    "id": 2,
                    "name": "Post Gain",
                    "digest": "The gain to apply to the output of an atan() saturator"
                }
            ]
        },
        {
            "document": false,
            "digest": "",
            "name": "w3v",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": ""
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "",
                    "digest": ""
                }
            ]
        },
        {
            "document": false,
            "digest": "",
            "name": "w4v",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": ""
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "",
                    "digest": ""
                }
            ]
        },
        {
            "document": true,
            "digest": "Circuit modelled coefficients calculator for the evieve Diode emulation, for use in 'diodeV()'",
            "name": "diodeCoeffsV",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "SR",
                    "digest": "SAMPLERATE"
                },
                {
                    "id": 2,
                    "kind": "Param",
                    "name": "CR",
                    "default": 0.000022,
                    "min": 0,
                    "max": 0,
                    "type": "float",
                    "digest": "Constant, do not change"
                },
                {
                    "id": 3,
                    "kind": "Param",
                    "name": "IR",
                    "default": 2.2e-13,
                    "min": 0,
                    "max": 0,
                    "type": "float",
                    "digest": "Constant, do not change"
                },
                {
                    "id": 4,
                    "kind": "Param",
                    "name": "VT",
                    "default": 0.026,
                    "min": 0,
                    "max": 0,
                    "type": "float",
                    "digest": "Constant, do not change"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "k1",
                    "digest": "k1"
                },
                {
                    "id": 2,
                    "name": "k2",
                    "digest": "k2"
                },
                {
                    "id": 3,
                    "name": "k3",
                    "digest": "k3"
                },
                {
                    "id": 4,
                    "name": "k4",
                    "digest": "k4"
                },
                {
                    "id": 5,
                    "name": "k5",
                    "digest": "k5"
                },
                {
                    "id": 6,
                    "name": "k6",
                    "digest": "k6"
                },
                {
                    "id": 7,
                    "name": "VT",
                    "digest": "VT"
                }
            ]
        },
        {
            "document": true,
            "digest": "The core evieve diode processing function",
            "name": "diodeV",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "Vin",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "k1",
                    "digest": "k1 coefficient"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "k2",
                    "digest": "k2 coefficient"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "k3",
                    "digest": "k3 coefficient"
                },
                {
                    "id": 5,
                    "kind": "input",
                    "name": "k4",
                    "digest": "k4 coefficient"
                },
                {
                    "id": 6,
                    "kind": "input",
                    "name": "k5",
                    "digest": "k5 coefficient"
                },
                {
                    "id": 7,
                    "kind": "input",
                    "name": "k6",
                    "digest": "k6 coefficient"
                },
                {
                    "id": 8,
                    "kind": "input",
                    "name": "VT",
                    "digest": "VT coefficient"
                },
                {
                    "id": 9,
                    "kind": "input",
                    "name": "reset",
                    "digest": "Sample accurate reset of the internal state of the diode filter"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Diode",
                    "digest": "Audio output"
                }
            ]
        },
