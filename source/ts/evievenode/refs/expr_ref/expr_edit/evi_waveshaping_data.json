            "name": "tanhPoly",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Tanh",
                    "digest": "Approximate tanh() of input"
                }
            ]
