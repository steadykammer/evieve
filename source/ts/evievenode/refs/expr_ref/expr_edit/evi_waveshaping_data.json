{
    "description": "A very long time ago this was called 'stkr.waveshaping.genexpr'. A collection of memoryless nonlinearities for waveshaping etc. Note: all of these functions are naive and need anti-aliasing / resampling to be of any use. @see: 'evi_adaa.genexpr' for anti-derivative anti-aliasing and 'evi_saturators.genexpr' for quasi oversampling.",
    "requires": [],
    "functions": [
        {
            "document": false,
            "digest": "",
            "name": "localExpA",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": ""
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "",
                    "digest": ""
                }
            ]
        },
        {
            "document": true,
            "digest": "High quality Lambert approx, 2x faster than library tanh(). Excellent mathematical and sonic closeness to library tanh(). In general we use this one most often.",
            "name": "tanhLApprox",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Tanh",
                    "digest": "Approximate tanh() of input"
                }
            ]
        },
        {
            "document": true,
            "digest": "Wrapper for tanhLApprox(). Returns 'tanh(x / a) * a'",
            "name": "tanhAxA",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "gain",
                    "digest": "± linear gain, input div, output mul"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Tanh",
                    "digest": "Approximate tanh() of input wrapped by gain coefficient"
                }
            ]
        },
        {
            "document": true,
            "digest": "A cheaper alternative to tanh, not exactly the same, I describe this as a 'buzzy tanh'",
            "name": "tanhSqrt",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Tanh",
                    "digest": "Approximate tanh() of input"
                }
            ]
        },
