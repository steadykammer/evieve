{
    "description": "A collection of non-oscillator sources and related code. Different types of noise as well as novel random LFOs.",
    "requires": [],
    "functions": [
        {
            "document": true,
            "digest": "A variable gain spikey dusty noise source with variable frequency",
            "name": "audioDust",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "freq",
                    "digest": "Frequency in Hz"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "dust",
                    "digest": "The audio dust output"
                },
                {
                    "id": 2,
                    "name": "white",
                    "digest": "Synchronised white noise output"
                },
                {
                    "id": 3,
                    "name": "sync",
                    "digest": "Full gain sync signal with every piece of dust"
                }
            ]
        },
        {
            "document": true,
            "digest": "A 'sparse noise' algorithm (similar to 'audioDust()') mixable with a full 'velvet noise' algorithm",
            "name": "sparseVelvetNoise",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "freq",
                    "digest": "Frequency in Hz"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "mixN",
                    "digest": ""
                },
                {
                    "id": 3,
                    "kind": "param",
                    "name": "amp",
                    "default": 1,
                    "type": "float",
                    "digest": "The amplitude of the noise, typically left at '1'"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "mixNoise",
                    "digest": "The mix of sparse and velvet noise"
                },
                {
                    "id": 2,
                    "name": "sparseNoise",
                    "digest": "Just the sparse noise algorithm"
                },
                {
                    "id": 3,
                    "name": "velvetNoise",
                    "digest": "Just the velvet noise algorithm"
                }
            ]
        },
        {
            "document": true,
            "digest": "Not-really box-muller gaussian noise distribution implementation",
            "name": "gaussianNoise",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "gain",
                    "digest": ""
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "gaussian",
                    "digest": "The gaussian noise output"
                },
                {
                    "id": 2,
                    "name": "Xoshiro256",
                    "digest": "Synchronised white noise output"
                },
                {
                    "id": 3,
                    "name": "cosXos",
                    "digest": "Synchronised cosine noise output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Zero crossing detector, like [zerox~] from RNBO or MSP",
            "name": "likeZerox",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input to be analysed"
                },
                {
                    "id": 2,
                    "kind": "param",
                    "name": "windowSize",
                    "default": 0,
                    "type": "integer",
                    "digest": "Window size in samples, default 64, typically vectorsize"
                },
                {
                    "id": 3,
                    "kind": "param",
                    "name": "threshold",
                    "default": 0.1,
                    "type": "float",
                    "digest": "Threshold above which the number of zero crossings reports a count"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "lastCount",
                    "digest": "Number of crossings in most recent window"
                },
                {
                    "id": 2,
                    "name": "voiced",
                    "digest": "Gate triggered by threshold"
                },
                {
                    "id": 3,
                    "name": "crossing",
                    "digest": "Current crossings"
                }
            ]
        },
        {
            "document": true,
            "digest": "Simple zero crossing detector with a fixed window sie of vectorsize, a bit like the gen~ example",
            "name": "simpleZerox",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input to be analysed"
                },
                {
                    "id": 2,
                    "kind": "param",
                    "name": "threshold",
                    "default": 0.1,
                    "type": "float",
                    "digest": "Threshold above which the number of zero crossings reports a count"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "periodCount",
                    "digest": "Number of crossings in most recent window"
                },
                {
                    "id": 2,
                    "name": "voiced",
                    "digest": "Gate triggered by threshold"
                },
                {
                    "id": 3,
                    "name": "crossing",
                    "digest": "Current crossings"
                }
            ]
        },
        {
            "document": true,
            "digest": "Like [rand~] from MSP (linear), very predictable and gives exact notches",
            "name": "eviRand",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "p",
                    "digest": "Phasor driver 0..1 (not frequency)"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "nv",
                    "digest": "Rand oscillator output"
                },
                {
                    "id": 2,
                    "name": "n",
                    "digest": "Internal white noise source sync"
                }
            ]
        },
        {
            "document": true,
            "digest": "Like 'eviRand()' but with external noise source",
            "name": "eviRandN",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "p",
                    "digest": "Phasor driver 0..1 (not frequency)"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "n",
                    "digest": "External noise source from which rand is derived"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "nv",
                    "digest": "Rand oscillator output"
                }
            ]
        },
        {
            "document": true,
            "digest": "like 'eviRand()' but with additional cosine interpolated output",
            "name": "eviRandC",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "p",
                    "digest": "Phasor driver 0..1 (not frequency)"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "nv",
                    "digest": "Linear rand oscillator output"
                },
                {
                    "id": 2,
                    "name": "nw",
                    "digest": "Cosine rand oscillator output"
                },
                {
                    "id": 3,
                    "name": "n",
                    "digest": "Internal white noise source sync"
                }
            ]
        },
        {
            "document": true,
            "digest": "Like 'eviRand()' but ready for cubic interpolation, called by 'eviRandy()'",
            "name": "eviRands",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "d0",
                    "digest": "Delta sync of phasor source"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "x2",
                    "digest": "External noise source from which rand is derived"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "vm1",
                    "digest": "Cubic interpolator output 1"
                },
                {
                    "id": 2,
                    "name": "v0",
                    "digest": "Cubic interpolator output 2"
                },
                {
                    "id": 3,
                    "name": "v1",
                    "digest": "Cubic interpolator output 3"
                },
                {
                    "id": 4,
                    "name": "v2",
                    "digest": "Cubic interpolator output 4"
                }
            ]
        },
        {
            "document": true,
            "digest": "Like 'eviRand()' but cubic interpolated, rolls off much faster",
            "name": "eviRandy",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "p",
                    "digest": "Phasor driver 0..1 (not frequency)"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "r",
                    "digest": "Randy oscillator output"
                },
                {
                    "id": 2,
                    "name": "n",
                    "digest": "Internal white noise source sync"
                }
            ]
        },
        {
            "document": true,
            "digest": "Like 'eviRandy()' but with external noise source",
            "name": "eviRandyN",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "p",
                    "digest": "Phasor driver 0..1 (not frequency)"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "n",
                    "digest": "External noise source from which rand is derived"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "r",
                    "digest": "Randy oscillator output"
                }
            ]
        },
        {
            "document": true,
            "digest": "4-point catmull rom cubic spline interpolator with bias and tension parameters, similar to the native gen~ example",
            "name": "catmullRomSplineDynamic",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "f",
                    "digest": "Interpolator 0..1"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "y0",
                    "digest": "Cubic interpolator input 1"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "y1",
                    "digest": "Cubic interpolator input 2"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "y2",
                    "digest": "Cubic interpolator input 3"
                },
                {
                    "id": 5,
                    "kind": "input",
                    "name": "y3",
                    "digest": "Cubic interpolator input 4"
                },
                {
                    "id": 6,
                    "kind": "input",
                    "name": "bias",
                    "digest": "Bias control, signed"
                },
                {
                    "id": 7,
                    "kind": "input",
                    "name": "tension",
                    "digest": "Tension control, signed"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "spline",
                    "digest": "Spline interpolated output"
                }
            ]
        },
        {
            "document": true,
            "digest": "A very (and needlessly) expensive spline interpolated random LFO",
            "name": "eviRandLfo",
            "inputs": [
                {
                    "id": 1,
