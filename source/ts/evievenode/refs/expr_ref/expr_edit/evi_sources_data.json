                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "reset",
                    "digest": "Hard reset of internal phase"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "r",
                    "digest": "Random LFO -1..1"
                },
                {
                    "id": 2,
                    "name": "x",
                    "digest": "Internal white noise source sync"
                }
            ]
        },
