{
    "description": "Using this require file you can access coefficients selectors for all TPT SVF filters in evieve with corresponding all-in-one filter sections. This file also includes a selection of interesting 'morphing' filters. For accessing all the filters as individual blocks use 'evi_svfs_tpt_filters.genexpr'",
    "requires": [
        "evi_smooth.genexpr",
        "evi_svfs_filters.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "Coefficients calculator for all of the basic filter types available, @see: MSP [evi.filter~] or gen~ [evi_filter] for an example wrapper",
            "name": "tptSvfCoeff",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "filter",
                    "digest": "(int) filter index (type), see abstractions or source code for listing"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "Cutoff frequency in Hz"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "gain",
                    "digest": "Gain (linear)"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "fullQ",
                    "digest": "Q"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "g",
                    "digest": "g coefficient"
                },
                {
                    "id": 2,
                    "name": "r",
                    "digest": "r coefficient"
                },
                {
                    "id": 3,
                    "name": "h",
                    "digest": "h coefficient"
                },
                {
                    "id": 4,
                    "name": "cL",
                    "digest": "low mixing gain"
                },
                {
                    "id": 5,
                    "name": "cB",
                    "digest": "band mixing gain"
                },
                {
                    "id": 6,
                    "name": "cH",
                    "digest": "high mixing gain"
                }
            ]
        },
        {
            "document": true,
            "digest": "No tilde version of coefficients calculator for all of the basic filter types available",
            "name": "tptSvfCoeffNoTilde",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "filter",
                    "digest": "(int) filter index (type), see abstractions or source code for listing"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "Cutoff frequency in Hz"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "gain",
                    "digest": "Gain (linear)"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "fullQ",
                    "digest": "Q"
                },
                {
                    "id": 5,
                    "kind": "param",
                    "name": "AUDIO_SR",
                    "default": 48000,
                    "type": "integer",
                    "digest": "Pass audio samplerate into calculator for no tilde computation"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "g",
                    "digest": "g coefficient"
                },
                {
                    "id": 2,
                    "name": "r",
                    "digest": "r coefficient"
                },
                {
                    "id": 3,
                    "name": "h",
                    "digest": "h coefficient"
                },
                {
                    "id": 4,
                    "name": "cL",
                    "digest": "low mixing gain"
                },
                {
                    "id": 5,
                    "name": "cB",
                    "digest": "band mixing gain"
                },
                {
                    "id": 6,
                    "name": "cH",
                    "digest": "high mixing gain"
                }
            ]
        },
