        {
            "document": true,
            "digest": "1x version of the filter. This version is unique in this file in that it offers 3 simultaneous outlets for mixing (LP, BP, HP) but not being oversampled it is not very useful.",
            "name": "buchlaLpg1",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio Input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "rf",
                    "digest": "Voltage (not Hz) controls cutoff"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "res",
                    "digest": "Resonance 0..2.."
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "resist",
                    "digest": "Additional resistors 0..1, also known as 'Boom'"
                },
                {
                    "id": 5,
                    "kind": "input",
                    "name": "vcamode",
                    "digest": "Vca mode 0..1, also known as 'Damp'"
                },
                {
                    "id": 6,
                    "kind": "input",
                    "name": "lpgmode",
                    "digest": "Filter/LPG mode flag 0/1"
                },
                {
                    "id": 7,
                    "kind": "input",
                    "name": "nl",
                    "digest": "Nonlin flag 0/1, switch linear/nonliner, typically on"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "LPG",
                    "digest": "Lowpass Gate output"
                },
                {
                    "id": 2,
                    "name": "BP",
                    "digest": "Bandpass filter output"
                },
                {
                    "id": 3,
                    "name": "HP",
                    "digest": "Highpass filter output"
                }
            ]
        },
