{
    "description": "This file contains some all-in-one multimode LTO SVF filters for using in GenExpr.",
    "requires": [
        "evi_approx.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "All-in-one simultaneous outputs multimode SVF filter",
            "name": "svfLtoMulti",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "v0",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "Cutoff frequency in Hz"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "Q",
                    "digest": "Q"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Low",
                    "digest": "Lowpass output"
                },
                {
                    "id": 2,
                    "name": "Band",
                    "digest": "Bandpass output"
                },
                {
                    "id": 3,
                    "name": "High",
                    "digest": "Highpass output"
                },
                {
                    "id": 4,
                    "name": "Notch",
                    "digest": "Notch output"
                }
            ]
        },
        {
            "document": true,
            "digest": "The same as 'svfLtoMulti()' but with a single filter choice output",
            "name": "svfLtoSingle",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "v0",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "Cutoff frequency in Hz"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "Q",
                    "digest": "Q"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "filt",
                    "digest": "(int) filter: 0=lowpass, 1=bandpass, 2=highpass, 3=notch"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Selected Filter",
                    "digest": "Filtered audio output"
                }
            ]
        },
        {
            "document": true,
            "digest": "A standalone Bell filter",
            "name": "svfLtoBell",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "v00",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "Cutoff frequency in Hz"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "gain",
                    "digest": "Gain in dB"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "Q",
                    "digest": "Q"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Bell Filter",
                    "digest": "Filtered audio output"
                }
            ]
        },
        {
            "document": true,
            "digest": "All-in-one simultaneous outputs multimode SVF filter solved for sin() (theoretically more stable low-end response when modulating but in always-64-bit-doubles environment of Gen should not make much difference)",
            "name": "svfSinMulti",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "X",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "Cutoff frequency in Hz"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "damp",
                    "digest": "Q normalised 0..1"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Low",
                    "digest": "Lowpass output"
                },
                {
                    "id": 2,
                    "name": "Band",
                    "digest": "Bandpass output"
                },
                {
                    "id": 3,
                    "name": "High",
                    "digest": "Highpass output"
                },
                {
                    "id": 4,
                    "name": "Peak",
                    "digest": "Peak output"
                },
                {
                    "id": 5,
                    "name": "Notch",
                    "digest": "Notch output"
                }
            ]
        },
        {
            "document": true,
            "digest": "The same as 'svfSinMulti()' but with a single filter choice output",
            "name": "svfSinSingle",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "X",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "Cutoff frequency in Hz"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "damp",
                    "digest": "Q normalised 0..1"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "filt",
                    "digest": "(int) filter: 0=lowpass, 1=bandpass, 2=highpass, 3-peak, 4=notch"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Selected Filter",
                    "digest": "Filtered audio output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Param rate coefficients calculator for the 'inputMixing' SVF",
            "name": "inputMixingSvfCoefficients",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "Cutoff frequency in Hz"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "res",
                    "digest": "Resonance normalised 0..1"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "g0",
                    "digest": "g0 coefficient"
                },
                {
                    "id": 2,
                    "name": "g1",
                    "digest": "g1 coefficient"
                },
                {
                    "id": 3,
                    "name": "g2",
                    "digest": "g2 coefficient"
                },
                {
                    "id": 4,
                    "name": "g3",
                    "digest": "g3 coefficient"
                }
            ]
        },
        {
            "document": true,
            "digest": "Audio loop to match with 'inputMixingSvfCoefficients()' for the 'inputMixing' SVF",
            "name": "inputMixingSvfLoop",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "vlow",
                    "digest": "Lowpass audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "vband",
                    "digest": "Bandpass audio input"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "vhigh",
                    "digest": "Highpass audio input"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "g0",
                    "digest": "g0 coefficient"
                },
                {
                    "id": 5,
                    "kind": "input",
                    "name": "g1",
                    "digest": "g1 coefficient"
                },
                {
                    "id": 6,
                    "kind": "input",
                    "name": "g2",
                    "digest": "g2 coefficient"
                },
                {
                    "id": 7,
                    "kind": "input",
                    "name": "g3",
                    "digest": "g3 coefficient"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Mixed Output",
                    "digest": "Filtered audio output"
                }
            ]
        },
        {
            "document": true,
            "digest": "All audio rate version of the 'inputMixing' SVF",
            "name": "inputMixingSvf",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "vlow",
                    "digest": "Lowpass audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "vband",
                    "digest": "Bandpass audio input"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "vhigh",
                    "digest": "Highpass audio input"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "Cutoff frequency in Hz"
                },
                {
                    "id": 5,
                    "kind": "input",
                    "name": "res",
                    "digest": "Resonance normalised 0..1"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Mixed Output",
                    "digest": "Filtered audio output"
                }
            ]
        }
