{
    "description": "These utilities get used all over evieve. They are a hodge podge of converters, sample accurate processors, mappers and mixing functions. Requiring this .genexpr file also inherits 'evi_approx.genexpr'.",
    "requires": [
        "evi_approx.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "Similar to [click~] in MSP, outputs sample accurate clicks for all directions",
            "name": "logicalClicks",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Trigger"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Updown",
                    "digest": "Output trigger for either direction"
                },
                {
                    "id": 2,
                    "name": "Up",
                    "digest": "Output trigger if up direction"
                },
                {
                    "id": 3,
                    "name": "Down",
                    "digest": "Output trigger if down direction"
                }
            ]
        },
        {
            "document": true,
            "digest": "",
            "name": "triggerHoldGate",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "X",
                    "digest": "Trigger (anything > 0)"
                },
                {
                    "id": 2,
                    "kind": "param",
                    "name": "hold",
                    "default": 10,
                    "type": "float",
                    "digest": "Hold time in ms (0-ms = 1-sample click)"
                },
                {
                    "id": 3,
                    "kind": "param",
                    "name": "trigger",
                    "default": 1,
                    "type": "integer",
                    "digest": "Trigger response, 0 = up/down, 1 = up only, 2 = down only"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Gate",
                    "digest": "Sample accurate gate with hold duration"
                }
            ]
        },
        {
            "document": true,
            "digest": "Variable dcblock() so that effect can be bypassed (a0 = 1) or active (a0 = 0.9997) or heavy (a0 = ...)",
            "name": "varDcblock",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x0",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "a0",
                    "digest": "Dc coefficient, typically 0.9997 for basic dcblock()"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Audio output",
                    "digest": "Dc blocked audio output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Filter cutoff coefficient warp",
            "name": "preWarp0",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "in Hz"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "w",
                    "digest": "approximation of tan(PI * cutoff / SAMPLERATE)"
                }
            ]
        },
        {
            "document": true,
            "digest": "Warp Hz..g for trapezoidal linear rc filters",
            "name": "preWarpG",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "in Hz"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "G",
                    "digest": "g coefficient for trapezoidal linear rc filters"
                }
            ]
        },
        {
            "document": false,
            "digest": "Nobody should ever use this abomination",
            "name": "eviCopysign",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "y",
                    "digest": ""
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "x",
                    "digest": ""
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "",
                    "digest": ""
                }
            ]
        },
        {
            "document": true,
            "digest": "Return absolute maximum of left and right audio inputs",
            "name": "getMax",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "xL",
                    "digest": "Left audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "xR",
                    "digest": "Right audio input"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Absolute max",
                    "digest": "Per sample maximum of left and right inputs"
                }
            ]
        },
        {
            "document": false,
            "digest": "Broadband clip and dcblock any audio input, specifically for saturators etc, not very useful",
            "name": "xMega",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "X",
                    "digest": ""
                },
                {
                    "id": 2,
                    "kind": "param",
                    "name": "xCONST",
                    "digest": "usually sqrt1_2 or ln2 or log10e, multiplied by 1000 internally"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Output",
                    "digest": "Dc blocked and clipped output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Return sign of input but only reports -1 or 1 (no zero)",
            "name": "xSgn",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Input"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Sign",
                    "digest": "-1 or 1"
                }
            ]
        },
        {
            "document": true,
            "digest": "Clip the abs(x) to maximum 1",
            "name": "xRange",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Input"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Clip",
                    "digest": "0..1 (abs(x) to maximum 1)"
                }
            ]
        },
