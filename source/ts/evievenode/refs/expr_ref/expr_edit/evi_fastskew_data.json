{
    "description": "Very specific routines for approximations of pow(x, 0.5..2) or pow(x, 0.25..4), although also just an interesting curvature in its own right. Not accurate at all for very large 'x' in terms of pow(). Available in either param rate ('cr') or audio rate ('ar') versions (optimising for gen~ while loop). Also available with exponent set in real values (0.5..2 or 0.25..4) or as normalised input (-1..1 through 0==1).",
    "requires": [],
    "functions": [
        {
            "document": true,
            "digest": "Legacy original version for pedagogy, not quite as optimised as other functions",
            "name": "fastskew",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Raise x to the power"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "skew",
                    "digest": "Must be clamped 0.5..2"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Power",
                    "digest": "'x' to the power of 0.5..2"
                }
            ]
        },
        {
            "document": true,
