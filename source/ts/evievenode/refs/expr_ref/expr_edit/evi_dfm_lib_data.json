{
    "description": "This file is a specific genexpr lib for use by the [evi.dfm~] MSP abstraction. It is likely not useful as a require() but you may find something interesting here. The enclosed [evi_dfm] gen~ abstraction only works in MSP as it requires an external LUT. [evi.dfm~] is a deluxe but dirty MS20-inspired old-school-style filter emulation, 12dB lowpass or 6dB highpass. Based on a classic by Tony Hardie-Bick ('DFM-1 Digital Filter Module'), 2010.",
    "requires": [
        "evi_smooth.genexpr",
        "evi_sources.genexpr",
        "evi_interp.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "Wrap box-muller gaussian noise with local gain stage",
            "name": "gaussnoise",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "ngain",
                    "digest": "Gain (linear)"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Noise",
                    "digest": "Post gain gaussian noise"
                }
            ]
        },
        {
            "document": true,
            "digest": "Cubic nonlinearity suggested by Tony Hardie-Bick",
            "name": "dnl",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x0",
                    "digest": "Audio input"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Cubic",
                    "digest": "Saturated output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Quasi 3x oversampling of 'dnl()'",
            "name": "dnl3x",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "XIN",
                    "digest": "Audio input"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Cubic",
                    "digest": "Saturated output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Make oversampling choice on nonlinearity",
            "name": "dnlNonlin",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "xin",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "oversampling",
                    "digest": "(int) 0=1x, 1=3x"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "",
                    "digest": ""
                }
            ]
        },
