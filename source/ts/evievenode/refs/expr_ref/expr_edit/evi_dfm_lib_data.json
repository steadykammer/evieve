                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "l",
                    "digest": "Lowpass gain"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "h",
                    "digest": "Highpass gain"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "a",
                    "digest": "Stage 1 coefficient (factor of cutoff & lut)"
                },
                {
                    "id": 5,
                    "kind": "input",
                    "name": "b",
                    "digest": "Stage 2 coefficient (factor of cutoff & lut)"
                },
                {
                    "id": 6,
                    "kind": "input",
                    "name": "r",
                    "digest": "Resonance corrected (factor of cutoff, resonance & lut)"
                },
                {
                    "id": 7,
                    "kind": "input",
                    "name": "noisegain",
                    "digest": "Noise injection level"
                },
                {
                    "id": 8,
                    "kind": "input",
                    "name": "POSTGAIN",
                    "digest": "Postgain constant"
                },
                {
                    "id": 9,
                    "kind": "input",
                    "name": "HEADROOM",
                    "digest": "Headroom gain (factor of noise in filter)"
                },
                {
                    "id": 10,
                    "kind": "input",
                    "name": "nl",
                    "digest": "IGNORE: unused (should always be '0')"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "DFM",
                    "digest": "Filtered audio output"
                }
            ]
        },
