                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "X"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Y",
                    "digest": "sqrt(x * sign(x))"
                }
            ]
        },
