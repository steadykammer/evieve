{
    "description": "This file contains the actual DSP filter sections used throughout evieve. The two different types of filter sections (in the source code labled 'TPT' and 'LTO' but actually the same principle), are alternative ways of achieving a similar result. The 'TPT' sections are mathematical and well suited to nonlinearising, the 'LTO' sections are circuit analysed and well suited to EQ building, but the choice of which to use is largely circumstance specific.",
    "requires": [
        "evi_interp.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "The linear TPT filter, after Zavalishin, we use this filter section to create our filter types by summing the outputs",
            "name": "tptSvf",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "g",
                    "digest": "g coefficient"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "r",
                    "digest": "r coefficient"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "a",
                    "digest": "a coefficient"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "yL",
                    "digest": "Lowpass output"
                },
                {
                    "id": 2,
                    "name": "yB",
                    "digest": "Bandpass output"
                },
                {
                    "id": 3,
                    "name": "yH",
                    "digest": "Highpass output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Same as 'tptSvf()' but with state reset input",
            "name": "tptSvfReset",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "g",
                    "digest": "g coefficient"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "r",
                    "digest": "r coefficient"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "a",
                    "digest": "a coefficient"
                },
                {
                    "id": 5,
                    "kind": "input",
                    "name": "reset",
                    "digest": "Sample accurate reset of internal filter state ('clear')"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "yL",
                    "digest": "Lowpass output"
                },
                {
                    "id": 2,
                    "name": "yB",
                    "digest": "Bandpass output"
                },
                {
                    "id": 3,
                    "name": "yH",
                    "digest": "Highpass output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Onepole version of the TPT filter, for building odd ordered cascades etc, use 'cL' 'cH' to mix",
            "name": "tptSvfOnePole",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": ""
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "g",
                    "digest": "g coefficient"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "lp",
                    "digest": "Lowpass output"
                },
                {
                    "id": 2,
                    "name": "hp",
                    "digest": "Highpass output"
                }
            ]
        },
