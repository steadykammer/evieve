{
    "description": "A collection of Linear TPT Lowpass Butterworth filters orders 1..8, including all-in-one selector. These are surgical filters but can still be updated alias-free at audio rate if required. Very useful for clean top and tail of audio chains. For the constants calculations @see: 'evi_butterworth8_coeffs.js'",
    "requires": [],
    "functions": [
        {
            "document": true,
            "digest": "Frequency warping for the Butterworth filters",
            "name": "fWarp",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "cf",
                    "digest": "Cutoff frequency in Hz"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "g",
                    "digest": "Warped frequency 0..HALFPI"
                }
            ]
        },
        {
            "document": true,
            "digest": "TPT onepole filter section for creating Butterworth cascades",
            "name": "lp1p",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "g",
                    "digest": "Warped cutoff"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Filter",
                    "digest": "Audio output"
                }
            ]
        },
        {
            "document": true,
            "digest": "TPT twopole filter section for creating Butterworth cascades",
            "name": "lp2p",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "g",
                    "digest": "Warped cutoff"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "r",
                    "digest": "Butterworth coefficient"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Filter",
                    "digest": "Audio output"
                }
            ]
        },
