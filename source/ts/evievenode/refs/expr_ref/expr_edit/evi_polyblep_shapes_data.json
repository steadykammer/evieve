{
    "description": "This file offers interesting bandlimited oscillator shapes beyond the usual boring 'classic' waveforms. These shapes are by Theo Niessink, thank you! See the source code for more information. This file also inherits 'evi_polyblep_two.genexpr' so can be used to call any of the two-point PolyBLEP Oscillators in evieve.",
    "requires": [
        "evi_polyblep_utility.genexpr",
        "evi_polyblep_two.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "Half wave rectified Sine, antialiased PolyBLAMP",
            "name": "poly_half",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "t",
                    "digest": "Phase 0..1"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "dt",
                    "digest": "Phase increment"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Sine",
                    "digest": "Bandlimited Sine Rectified"
                }
            ]
        },
        {
