                {
                    "id": 3,
                    "kind": "input",
                    "name": "pw",
                    "digest": "PWM 0..1 morphs between +pulse..full_wave_rectified_sine"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Sine",
                    "digest": "Bandlimited Sine Rectified"
                }
            ]
        },
