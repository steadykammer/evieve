{
    "description": "A collection of tanh() approximations because we use them so much. Approximations are faster than library functions but less accurate. You should be careful using approximations - they can break your code. In evieve all approximations are tested to work on the code in which they are used.",
    "requires": [
        "evi_approx.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "High quality Lambert approx, 2x faster than library tanh(). Excellent mathematical and sonic closeness to library tanh(). In general we use this one most often.",
            "name": "tanhL",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Input"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Tanh",
                    "digest": "Approximate tanh() of input"
                }
            ]
        },
        {
            "document": true,
            "digest": "Wrapper for tanhL(). Returns 'tanh(x / a) * a'",
            "name": "tanhLxA",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "a",
                    "digest": "± linear gain, input div, output mul"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Tanh",
                    "digest": "Approximate tanh() of input wrapped by gain coefficient"
                }
            ]
        },
        {
            "document": true,
            "digest": "By fire-sledge (LdS), we use this for some of the Adaa methods in evieve, similar efficiency to 'tanhL()'",
            "name": "tanhO",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Input"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Tanh",
                    "digest": "Approximate tanh() of input"
                }
            ]
        },
        {
