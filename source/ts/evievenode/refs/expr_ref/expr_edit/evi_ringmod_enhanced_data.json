{
    "description": "Specific functions for the evieve ring modulators.",
    "requires": [
        "evi_ssb.genexpr",
        "evi_butterworth.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "Naive version of the evieve ring modulator, based on 'enhanced ring mod' by Beat Frei, ICST",
            "name": "simpleRingmod",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "xin1",
                    "digest": "Ring Mod input 1"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "xin2",
                    "digest": "Ring Mod input 2"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "RingMod",
                    "digest": "Ring Modulated output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Piece-wise diode approximation used by 'pRingmod()'",
            "name": "pDiode",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "vin",
                    "digest": "Carier or Modulator input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "Vb",
                    "digest": "Voltage input"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "VL",
                    "digest": "Knee input"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "H",
                    "digest": "Slope input"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Diode",
                    "digest": "Diode approximation output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Naive version of the four-diode ring modulator based on Julian Parker code",
            "name": "pRingmod",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "car",
                    "digest": "Ring Mod input 1 (Carrier)"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "mod",
                    "digest": "Ring Mod input 2 (Modulator)"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "voltage",
                    "digest": "Voltage parameter 0..1"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "knee",
                    "digest": "Knee parameter 0..1"
                },
                {
                    "id": 5,
                    "kind": "input",
                    "name": "slope",
                    "digest": "Slope parameter 0..1"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "RingMod",
                    "digest": "Ring Modulated output"
                }
            ]
        },
