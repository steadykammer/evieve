{
    "object": {
        "name": "evi_filter_allpass",
        "child": "evi.filter.allpass~",
        "category": "evieve",
        "digest": "TPT allpass filter",
        "description": "The allpass filter from the evieve TPT SVF collection. An allpass filter 'roughly determines a 90 degree transition in phase on either side of center frequency'. Note there is no gain control in this filter."
    },
    "constructor": {
        "inlets": "input, cutoff, q"
    },
    "includes": [
        "evi_svfs",
        "evi_svfs_tpt_filters"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be filtered."
        },
        {
            "id": 2,
            "name": "cutoff",
            "type": "float",
            "optional": 1,
            "digestauto": "in Hz @min 1 @max samplerate*0.5",
            "digest": "Cutoff frequency in Hz."
        },
        {
            "id": 3,
            "name": "q",
            "type": "float",
            "optional": 1,
            "digestauto": "@min 0.05 @max 20 @default 0.707107",
            "digest": "Q, clamped in the range 0.05..20."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "allpass",
            "type": "float",
            "optional": 1,
            "digest": "Filtered audio output."
        }
    ],
    "attributes": [
        {
            "name": "smooth",
            "type": "float",
            "digest": "@min 0, @max 333",
            "description": "Smooth the mixing gains of the filter efficiently at the core of the DSP. With these TPT SVF filters this will usually be the only smoothing required. By default smoothing is off.",
            "default": {
                "type": "float",
                "value": "0."
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_filter",
            "display": "evi_filter"
        },
        {
            "name": "evi_filter_eq",
            "display": "evi_filter_eq"
        },
        {
            "name": "evi_filter_shelving",
            "display": "evi_filter_shelving"
        },
        {
            "name": "evi_filter_morph",
            "display": "evi_filter_morph"
        },
        {
            "name": "evi_filter_bandpass",
            "display": "evi_filter_bandpass"
        },
        {
            "name": "evi_filter_bell",
            "display": "evi_filter_bell"
        },
        {
            "name": "evi_filter_highpass",
            "display": "evi_filter_highpass"
        },
        {
