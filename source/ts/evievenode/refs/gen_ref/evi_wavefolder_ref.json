{
    "object": {
        "name": "evi_wavefolder",
        "child": "evi.wavefolder~",
        "category": "evieve",
        "digest": "Antialiased wavefolder device for shaping oscillators, simultaneous outputs up to four stages",
        "description": "An analog model of the 'Lockhart Wavefolder' employing antiderivative antialiasing via Lambert-W functions. The waveshaper takes a simple audio signal and aggressively folds and clips it to produce new shapes and harmonics in the style of west coast synthesis. This 'simple' version has a fixed cascade for four simultaneous outputs of 4 stages, 3 stages, 2 stages or 1 stage. See <o>evi.wavefolder.cascade~</o> for a version with more options."
    },
    "constructor": {
        "inlets": "osc"
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "name": "osc",
            "type": "float",
            "optional": 1,
            "digestauto": "Input",
            "digest": "Audio input to be wavefolded, typically a simple oscillator."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "4-section",
            "type": "float",
            "optional": 1,
