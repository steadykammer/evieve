            "digestauto": "",
            "digest": "Output 2 cascaded sections."
        },
        {
            "id": 4,
            "name": "1-section",
            "type": "float",
            "optional": 1,
            "digestauto": "",
            "digest": "Output 1 section."
        }
    ],
