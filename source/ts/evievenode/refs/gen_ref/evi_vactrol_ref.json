{
    "object": {
        "name": "evi_vactrol",
        "child": "",
        "category": "evieve",
        "digest": "Vactrol response time domain filter envelope",
        "description": "Analog modelled vactrol opto isolator envelope emulation. <o>evi_vactrol</o> is available in MSP as <o>evi.vactrol~</o>."
    },
    "constructor": {
        "inlets": "trigger, rise, fall"
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "name": "trigger",
            "type": "float",
            "optional": 1,
            "digestauto": "@default 0.",
            "digest": "Audio to trigger the envelope, typically an impulse."
        },
        {
            "id": 2,
            "name": "rise",
            "type": "float",
            "optional": 1,
            "digestauto": "@min 1 @default 20.",
            "digest": "Envelope Rise Time in Samples. evi_vactrol does not reach it's value in this time exactly."
        },
        {
            "id": 3,
            "name": "fall",
            "type": "float",
            "optional": 1,
            "digestauto": "@min 1 @default 3000.",
            "digest": "Envelope Fall Time in Samples. evi_vactrol does not reach it's value in this time exactly. Retriggering the envelope keeps the output above zero."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "scaled",
            "type": "float",
            "optional": 1,
            "digestauto": "Vactrol envelope",
            "digest": "Vactrol envelope."
        }
    ],
    "attributes": [
        {
            "name": "scalar",
            "type": "float",
            "digest": "@min 0.1, @max 10000",
            "description": "Envelope Output Multiplier. This can be useful depending on use case, otherwise should be '1'.",
            "default": {
                "type": "float",
                "value": "1."
            }
        },
        {
            "name": "shape",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "Transform the envelope shape between flat ('0') and sharp ('1'). Almost matches the native [slide] at about 0.86",
            "default": {
                "type": "float",
                "value": "0.5"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_vactrol_fix",
            "display": "evi_vactrol_fix"
        },
