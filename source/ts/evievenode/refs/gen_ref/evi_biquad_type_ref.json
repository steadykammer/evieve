{
    "object": {
        "name": "evi_biquad_type",
        "child": "",
        "category": "evieve",
        "digest": "A Biquad Filter",
        "description": "A biquad filter section with selection of biquad direct form types. This is perhaps really stupid and should only be used for testing or pedagogy."
    },
    "constructor": {
        "inlets": "input, ff0, ff1, ff2, fb1, fb2"
    },
    "includes": [
        "evi_biquads_filters"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be filtered"
        },
        {
            "id": 2,
            "name": "ff0",
            "type": "float",
            "optional": 1,
            "digest": "Feedforward Coefficient 0 (a0)"
        },
        {
            "id": 3,
            "name": "ff1",
            "type": "float",
            "optional": 1,
            "digest": "Feedforward Coefficient 1 (a1)"
        },
        {
            "id": 4,
            "name": "ff2",
            "type": "float",
            "optional": 1,
            "digest": "Feedforward Coefficient 2 (a2)"
        },
        {
            "id": 5,
            "name": "fb1",
            "type": "float",
            "optional": 1,
            "digest": "Feedback Coefficient 1 (b1)"
        },
        {
            "id": 6,
            "name": "fb2",
            "type": "float",
            "optional": 1,
            "digest": "Feedback Coefficient 2 (b2)"
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "output",
            "type": "float",
            "optional": 1,
            "digest": "Filtered audio output."
        }
    ],
    "attributes": [
        {
            "name": "type",
            "type": "int",
            "digest": "@min 0, @max 2",
            "description": "0 = Direct form 1 (like MSP [biquad~]), 1 = Direct form 2 (default), 2 = Transposed direct form 2.",
            "default": {
                "type": "int",
                "value": "1"
            }
        }
    ],
    "seealso": [
