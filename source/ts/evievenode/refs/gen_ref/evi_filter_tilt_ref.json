{
    "object": {
        "name": "evi_filter_tilt",
        "child": "evi.filter.tilt~",
        "category": "evieve",
        "digest": "TPT tilt filter",
        "description": "The tilt filter from the evieve TPT SVF collection. A tilt filter is a special type of shelf: negative dB boosts low and attenuates high frequencies, positive dB boosts high and attenuates low frequencies."
    },
    "constructor": {
        "inlets": "input, cutoff, gain, q"
    },
    "includes": [
        "evi_svfs_tpt_filters"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be filtered."
        },
        {
            "id": 2,
            "name": "cutoff",
            "type": "float",
            "optional": 1,
            "digestauto": "in Hz @min 1 @max samplerate*0.5",
            "digest": "Cutoff frequency in Hz. Around this frequency the tilt filter will attenuate/boost."
        },
        {
            "id": 3,
            "name": "gain",
            "type": "float",
            "optional": 1,
            "digestauto": "in dB @min -30 @max 30 @default 0",
            "digest": "± gain in dB. Negative dB boosts low and attenuates high frequencies, positive dB boosts high and attenuates low frequencies."
        },
        {
            "id": 4,
            "name": "q",
            "type": "float",
            "optional": 1,
            "digestauto": "@min 0.05 @max 20 @default 1",
            "digest": "Q, clamped in the range 0.05..20."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "tilt",
            "type": "float",
            "optional": 1,
            "digestauto": "Output",
            "digest": "Filtered audio output."
        }
    ],
    "attributes": [
        {
            "name": "smooth",
            "type": "float",
            "digest": "@min 0, @max 333",
            "description": "Smooth the mixing gains of the filter efficiently at the core of the DSP. With these TPT SVF filters this will usually be the only smoothing required. By default smoothing is on.",
            "default": {
                "type": "float",
                "value": "15.111"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_filter",
            "display": "evi_filter"
        },
        {
            "name": "evi_filter_eq",
            "display": "evi_filter_eq"
        },
        {
            "name": "evi_filter_shelving",
            "display": "evi_filter_shelving"
        },
        {
            "name": "evi_filter_morph",
            "display": "evi_filter_morph"
        },
        {
            "name": "evi_filter_allpass",
            "display": "evi_filter_allpass"
        },
        {
