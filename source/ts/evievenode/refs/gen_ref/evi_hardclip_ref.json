{
    "object": {
        "name": "evi_hardclip",
        "child": "evi.hardclip~",
        "category": "evieve",
        "digest": "Anti-aliased hard clipping function",
        "description": "To be used whenever clamping of audio is required, <o>evi.hardclip~</o> should do a good job of protecting your precious audio. This is because this is antialiased hard clipping capable of high input gain whilst maintaining audio quality. <o>evi.hardclip~</o> is the hard clipping section from the <o>evi.clipper~</o> object but with more antiderivative and oversampling options for when managing audio quality against CPU usage, selected via the @aa attribute. Increasing @aa does not necessarily translate to 'better'. Experiment with this setting depending on your audio input material."
    },
    "constructor": {
        "inlets": "audio"
    },
    "includes": [
        "evi_interp"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "Input to be treated nicely",
            "digest": "Any audio input."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "anti",
            "type": "float",
            "optional": 1,
            "digestauto": "Aliased Clipped Output",
            "digest": "Hopefully cleanly clipped output."
        }
    ],
    "attributes": [
        {
            "name": "aa",
            "type": "int",
            "digest": "@min 0, @max 5",
            "description": "'aa' stands for 'Anti-Aliasing'. Select type (or 'strength') here. 0=1st order antiderivative, 1=1st order 2x oversampled, 2=1st order 4x oversampled, 3=2nd order antiderivative (default), 4=2nd order 2x oversampled, 5=2nd order 4x oversampled.",
            "default": {
                "type": "int",
                "value": "3"
            }
        },
        {
            "name": "limit",
            "type": "float",
            "digest": "@min 0.9, @max 1.1",
            "description": false,
            "default": {
                "type": "float",
                "value": "1."
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_softclip",
            "display": "evi_softclip"
        },
        {
            "name": "evi_clipasym",
            "display": "evi_clipasym"
        },
        {
