{
    "object": {
        "name": "evi_lores",
        "child": "evi.lores~",
        "category": "evieve",
        "digest": "Reimplementation of MSP <o>lores~</o> filter",
        "description": "This filter roughly matches the shape and behaviour of MSP <o>lores~</o> but is implemented as a TPT filter. <o>lores~</o> is basically like the lowpass output of <o>svf~</o> but with a unique mapping and coupling of cutoff and resonance: frequency affects strength of resonance and resonance affects slope of filter. The mapping of <o>lores~</o> has a lower resonance in the low frequency range. This is actually a traditional analog SVF type of mapping. <o>evi.lores~</o> matches all these features but does not quite manage to match the high frequency response. This is a trade off for having a filter with better modulation properties and which does not digitally distort. The abstraction includes code which can be extracted for parameter rate control of the coefficients calculation if required."
    },
    "constructor": {
        "inlets": "input, cutoff, resonance"
    },
    "includes": [
        "evi_trig",
        "evi_interp"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be filtered."
        },
        {
            "id": 2,
            "name": "cutoff",
            "type": "float",
            "optional": 1,
            "digestauto": "Frequency in Hz @max samplerate*0.5",
            "digest": "Cutoff frequency in Hz."
        },
        {
            "id": 3,
            "name": "resonance",
            "type": "float",
            "optional": 1,
            "digestauto": "0..1 @min 0 @max 1",
            "digest": "Filter resonance 0..1."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "lores~like",
            "type": "float",
            "optional": 1,
            "digestauto": "Output but not bad",
            "digest": "Filtered audio output."
        }
    ],
    "attributes": [
        {
            "name": "oversample",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "The 2x oversampling improves the high frequency response, more closely matching the MSP original. Also useful if audio rate modulating the filter.",
            "default": {
                "type": "int",
                "value": "0"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_lorez",
            "display": "evi_lorez"
        },
