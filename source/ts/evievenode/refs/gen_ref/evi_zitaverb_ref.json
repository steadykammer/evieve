{
    "object": {
        "name": "evi_zitaverb",
        "child": "",
        "category": "evieve",
        "digest": "True stereo FDN/algorithmic reverb based on 'zitaverb' by Fons Adriaensen",
        "description": "A famous open source reverb algorithm with excellent room realness. GPL v2. The evieve version increases the available RT60 times for special effects, and smooths all parameters, as well as improving the internal filtering. In gen~ alone (as opposed to the MSP <o>evi.zitaverb~</o> abstraction) this is tricky to use as it requires external coefficients, but it is possible to calculate them locally."
    },
    "constructor": {
        "inlets": "audio, audio"
    },
    "includes": [
        "evi_reverb_library"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "In L",
            "digest": "Audio In Left"
        },
        {
            "id": 2,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "In R",
            "digest": "Audio In Right"
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digest": "Reverb Out Left"
        },
        {
            "id": 2,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digest": "Reverb Out Right"
        }
    ],
