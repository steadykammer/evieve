{
    "object": {
        "name": "evi_filter_morph",
        "category": "evieve",
        "digest": "TEXT_HERE",
        "description": "[evi_filter_morph.gendsp] requires: [evi_svf.genexpr]"
    },
    "constructor": {
        "inlets": "input, frequency, gain, resonance, morph"
    },
    "includes": [
        "evi_svf.genexpr"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": ""
        },
        {
            "id": 2,
            "name": "frequency",
            "type": "float",
            "optional": 1,
            "digest": "in Hz @min 1 @max samplerate*0.5 @default 1000"
        },
        {
            "id": 3,
            "name": "gain",
            "type": "float",
            "optional": 1,
            "digest": "in dB @min -30 @max 30 @default 0"
        },
        {
            "id": 4,
            "name": "resonance",
            "type": "float",
            "optional": 1,
            "digest": "0..1 @min 0 @max 1 @default 0.5"
        },
        {
            "id": 5,
            "name": "morph",
            "type": "float",
            "optional": 1,
            "digest": "0..1 @min 0 @max 1"
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "morphing",
            "type": "float",
            "optional": 1,
            "digest": "Filter Output"
        }
    ],
    "attributes": [
        {
            "name": "smooth",
            "type": "float",
            "digest": "@min 0, @max 1000",
            "description": "",
            "default": {
                "type": "float",
                "value": "22.666"
            }
        }
    ],
    "seealso": [
        {
            "name": "",
