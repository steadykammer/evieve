{
    "object": {
        "name": "evi_logdecay",
        "child": "",
        "category": "evieve",
        "digest": "Decay envelope follower",
        "description": "Logarithmic decay envelope follower / smoother. <o>evi_logdecay</o> is available in MSP as <o>evi.logdecay~</o>."
    },
    "constructor": {
        "inlets": "value, decay"
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "name": "value",
            "type": "float",
            "optional": 1,
            "digestauto": "to Follow",
            "digest": "evi_logdecay will follow this input value with the given decay time."
        },
        {
            "id": 2,
            "name": "decay",
            "type": "float",
            "optional": 1,
            "digestauto": "Time in milliseconds @min 0",
            "digest": "Amount of time the value takes to decay. evi_logdecay is logarithmic and does not decay in this time exactly."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "output",
            "type": "float",
            "optional": 1,
