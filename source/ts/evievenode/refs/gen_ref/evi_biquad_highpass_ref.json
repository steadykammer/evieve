            "display": "evi_biquad_bandpass"
        },
        {
            "name": "evi_biquad_highshelf",
            "display": "evi_biquad_highshelf"
        },
        {
            "name": "evi_biquad_lowpass",
            "display": "evi_biquad_lowpass"
        },
