{
    "object": {
        "name": "evi_biquad_highpass",
        "child": "evi.biquad.highpass~",
        "category": "evieve",
        "digest": "Biquad Highpass",
        "description": "All-in-one biquad highpass filter block. Consider using <o>evi_filter_highpass</o> instead for a better quality filter."
    },
    "constructor": {
        "inlets": "input, cutoff, gain, q"
    },
    "includes": [
        "evi_biquads_coeffs",
        "evi_biquads_filters"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be filtered."
        },
        {
            "id": 2,
            "name": "cutoff",
            "type": "float",
            "optional": 1,
            "digestauto": "in Hz @min samplerate*0.00022 @max samplerate*0.458334",
            "digest": "Filter cutoff frequency in Hz."
        },
        {
            "id": 3,
            "name": "gain",
            "type": "float",
            "optional": 1,
            "digestauto": "in dB @min -24 @max 24 @default 0",
            "digest": "Filter gain in dB."
        },
        {
            "id": 4,
            "name": "q",
            "type": "float",
            "optional": 1,
            "digestauto": "@min 0.1 @max 18 @default 0.707107",
            "digest": "Filter Q."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "highpass",
            "type": "float",
            "optional": 1,
            "digestauto": "Output",
            "digest": "Filtered audio output."
        }
    ],
    "attributes": [
        {
            "name": "filter",
            "type": "int",
            "digest": "@min 0, @max 4",
            "description": "0 = highpass, 1 = gain highpass, 2 = analog highpass, 3 = butterworth highpass, 4 = butterworth gain highpass.",
            "default": {
                "type": "int",
                "value": "1"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_biquad",
            "display": "evi_biquad"
        },
        {
            "name": "evi_biquad_coeff",
            "display": "evi_biquad_coeff"
        },
        {
            "name": "evi_biquad_filter",
            "display": "evi_biquad_filter"
        },
        {
            "name": "evi_biquad_eqfilter",
            "display": "evi_biquad_eqfilter"
        },
        {
            "name": "evi_biquad_butterworth",
            "display": "evi_biquad_butterworth"
        },
        {
            "name": "evi_biquad_analog",
            "display": "evi_biquad_analog"
        },
        {
