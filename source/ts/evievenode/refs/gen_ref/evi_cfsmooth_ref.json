{
    "object": {
        "name": "evi_cfsmooth",
        "child": "",
        "category": "evieve",
        "digest": "Signal smoother particularly well suited to smoothing filter cutoff frequencies",
        "description": "Based on Andy Simper's smoother, evi_cfsmooth tracks the input value via the bandpass output of an SVF filter and logarithmically updates. Smoothing is specified in both ramp time (ms) and filter cutoff (Hz)."
    },
    "constructor": {
        "inlets": "destination, ramp"
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "name": "destination",
            "type": "float",
            "optional": 1,
            "digestauto": "Value",
            "digest": ""
        },
        {
            "id": 2,
            "name": "ramp",
            "type": "float",
            "optional": 1,
            "digestauto": "Time in milliseconds @min 0",
            "digest": ""
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "output",
            "type": "float",
            "optional": 1,
            "digest": ""
        }
    ],
    "attributes": [
        {
            "name": "hz",
            "type": "float",
            "digest": "@min 0, @max 10",
            "description": "evi_cfsmooth is a two-pole filter. The Hz value sets the filter cutoff. This is typically between 1..10 Hz. The lower this value, the more agressively the curve shape is flattened out.",
            "default": {
                "type": "float",
                "value": "2."
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_logsmooth",
            "display": "evi_logsmooth"
        },
