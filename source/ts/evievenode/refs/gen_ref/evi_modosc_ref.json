{
    "object": {
        "name": "evi_modosc",
        "child": "evi.modosc~",
        "category": "evieve",
        "digest": "A deluxe cosine LFO with range and offset shaping",
        "description": "A simple sine oscillator for modulation purposes with sample accurate and clickless automatic phase reset when Hz input == 0, along with range and offset mapping."
    },
    "constructor": {
        "inlets": "frequency, signal"
    },
    "includes": [
        "evi_smooth"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "frequency",
            "type": "float",
            "optional": 1,
            "digestauto": "in Hz +/-",
            "digest": "Any frequency in Hz."
        },
        {
            "id": 2,
            "name": "signal",
            "type": "float",
            "optional": 1,
            "digestauto": "Rate Phase Reset (Naive)",
            "digest": "Reset internal phase of oscillator."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "modulation",
            "type": "float",
            "optional": 1,
            "digestauto": "-1..1 Sine Oscillator * scale + offset",
            "digest": "Modulation signal offset and scaled."
        },
        {
            "id": 2,
            "name": "raw",
            "type": "float",
            "optional": 1,
            "digestauto": "Osc -1..1",
            "digest": "Auxilliary output, raw and unscaled -1..1 oscillator for further downstream processing."
        }
    ],
    "attributes": [
        {
            "name": "freqsmooth",
            "type": "float",
            "digest": "@min 0, @max 666",
            "description": "Smooth the input frequency (inlet 1) by this amount in ms. Turn off (0) if audio rate modulating ine inlet.",
            "default": {
                "type": "float",
                "value": "20."
            }
        },
        {
            "name": "offset",
            "type": "float",
            "digest": "",
            "description": "Offset the output oscillator value by this amount.",
            "default": {
                "type": "float",
                "value": "0.\t\t\t\t\t\t\t\t"
            }
        },
        {
            "name": "resetauto",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "Automatic zero phase reset off/on, default on.",
            "default": {
                "type": "int",
                "value": "1"
            }
        },
        {
            "name": "scale",
            "type": "float",
            "digest": "@min 0",
            "description": "Scale the output oscillator range between 0 and this amount. Note the oscillator is bipolar.",
            "default": {
                "type": "float",
                "value": "1."
            }
        },
        {
            "name": "smooth",
            "type": "float",
            "digest": "@min 0, @max 333",
            "description": "Smooth the @offset and @scale attributes by this amount in ms.",
            "default": {
                "type": "float",
                "value": "22.666"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_phasor0",
            "display": "evi_phasor0"
        },
        {
            "name": "evi_ramp0",
            "display": "evi_ramp0"
        },
        {
            "name": "evi_randy",
            "display": "evi_randy"
        },
        {
            "name": "evi_zeroxcount",
            "display": "evi_zeroxcount"
        },
        {
            "name": "evi_audiodust",
            "display": "evi_audiodust"
        }
    ]
}