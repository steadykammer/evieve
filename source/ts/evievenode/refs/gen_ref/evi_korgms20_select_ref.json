{
    "object": {
        "name": "evi_korgms20_select",
        "child": "evi.korgms20.select~",
        "category": "evieve",
        "digest": "Korg OTA dual-amplifier buffered modified Sallen-Key topology nonlinear filter emulation",
        "description": "The 'KLM' OTA chip was found in the later MS-20s and other Korg synthesisers - it is different to the earlier 'Korg 35' single-amplifier unbuffered Korg chip found in the earlier MS-20s and MS-10 and also in the 'monotron' series. This is a fabricated evieve version able to smoothly switch (with a nice 'plop') between 12dB LP and 6dB HP filter types, realised in transposed TPT form. With 2x option."
    },
    "constructor": {
        "inlets": "audio, cutoff, resonance"
    },
    "includes": [
        "evi_tanh",
        "evi_smooth",
        "evi_interp"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "Input",
            "digest": ""
        },
        {
            "id": 2,
            "name": "cutoff",
            "type": "float",
            "optional": 1,
            "digestauto": "Frequency in Hz @min 1",
            "digest": ""
        },
        {
            "id": 3,
            "name": "resonance",
            "type": "float",
            "optional": 1,
            "digestauto": "0..1 @min 0.01 @max 1 @default 0.88",
            "digest": ""
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "korg",
            "type": "float",
            "optional": 1,
            "digestauto": "OTA S&K LP or HP Filter",
            "digest": ""
        }
    ],
    "attributes": [
        {
            "name": "filter",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "",
            "default": {
                "type": "int",
                "value": "0"
            }
        },
        {
            "name": "filtersmooth",
            "type": "float",
            "digest": "@min 0, @max 296",
            "description": "",
            "default": {
                "type": "float",
                "value": "92."
            }
        },
        {
            "name": "load",
            "type": "float",
            "digest": "@min 0.25, @max 4",
            "description": "",
            "default": {
                "type": "float",
                "value": "1.333333333333"
            }
        },
        {
            "name": "oversample",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "",
            "default": {
                "type": "int",
                "value": "1"
            }
        }
    ],
    "seealso": [
        {
            "name": "",
            "display": ""
        }
    ]
}