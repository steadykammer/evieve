{
    "object": {
        "name": "evi_crossover_3band",
        "child": "evi.crossover.3band~",
        "category": "evieve",
        "digest": "Linkwitz-Riley 3-way (low/mid/high) crossover filter",
        "description": "Linkwitz-Riley crossovers sum perfectly flat on recombination of the outputs (providing allpass alignment is used). Use <o>evi.crossover.3band~</o> to achieve multiband processing. @see the 'seealso' section for other evieve objects that can help with this."
    },
    "constructor": {
        "inlets": "input, low, high"
    },
    "includes": [
        "evi_crossovers"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digestauto": "to Split",
            "digest": "Audio input to split."
        },
        {
            "id": 2,
            "name": "low",
            "type": "float",
            "optional": 1,
            "digestauto": "Crossover Frequency in Hz @min 10 @max 20000",
            "digest": "The low frequency at which to split the incoming audio into it's low band and mid band outputs."
        },
        {
            "id": 3,
            "name": "high",
            "type": "float",
            "optional": 1,
            "digestauto": "Crossover Frequency in Hz @min 10 @max 20000",
            "digest": "The high frequency at which to split the incoming audio into it's mid band and high band outputs."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "low",
            "type": "float",
            "optional": 1,
            "digestauto": "Band Output",
            "digest": "Lowpass filtered output."
        },
        {
            "id": 2,
            "name": "mid",
            "type": "float",
            "optional": 1,
            "digestauto": "Band Output",
            "digest": "Bandpass filtered output."
        },
        {
            "id": 3,
            "name": "high",
            "type": "float",
            "optional": 1,
            "digestauto": "Band Output",
            "digest": "Highpass filtered output."
        }
    ],
    "attributes": [
        {
            "name": "align",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "Allpass alignment in this splitting stage off or on. @see 'Discussion' in the reference file for more information.",
            "default": {
                "type": "int",
                "value": "1"
            }
        },
        {
            "name": "order",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "0=2-pole (shallower) crossover filters, 1=4-pole (steeper) crossover filters. 2-pole can be subtle, 4-pole gives more rejection.",
            "default": {
                "type": "int",
                "value": "1"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_cross",
            "display": "evi_cross"
        },
        {
            "name": "evi_crossover",
            "display": "evi_crossover"
        },
        {
            "name": "evi_crossover_sum",
            "display": "evi_crossover_sum"
        },
        {
            "name": "evi_crossover_allpass",
            "display": "evi_crossover_allpass"
        }
    ]
}