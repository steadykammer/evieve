{
    "object": {
        "name": "evi_biquad_butterworth",
        "child": "evi.biquad.butterworth~",
        "category": "evieve",
        "digest": "Butterworth Biquad Filters",
        "description": "All-in-one biquad filter block with selection of butterworth filter types."
    },
    "constructor": {
        "inlets": "input, cutoff, gain, q"
    },
    "includes": [
        "evi_biquads_union",
        "evi_biquads_filters"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be filtered."
        },
        {
            "id": 2,
            "name": "cutoff",
            "type": "float",
            "optional": 1,
            "digestauto": "in Hz @min samplerate*0.00022 @max samplerate*0.458334",
            "digest": "Filter cutoff frequency in Hz."
        },
        {
            "id": 3,
            "name": "gain",
            "type": "float",
            "optional": 1,
            "digestauto": "in dB @min -30 @max 30 @default 0",
            "digest": "Filter gain in dB."
        },
        {
            "id": 4,
            "name": "q",
            "type": "float",
            "optional": 1,
            "digestauto": "@default 0.707107",
            "digest": "Filter Q."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "butterworth",
            "type": "float",
            "optional": 1,
            "digestauto": "Filter Output",
            "digest": "Filtered audio output."
        }
    ],
    "attributes": [
        {
            "name": "filter",
            "type": "int",
            "digest": "@min 0, @max 10",
            "description": "0 = bypass, 1 = ButterworthLowpass, 2 = ButterworthHighpass, 3 = ButterworthBandpass, 4 = ButterworthBandreject, 5 = ButterworthLowpassGain, 6 = ButterworthHighpassGain, 7 = ButterworthBandpassGain, 8 = ButterworthBandrejectGain, 9 = LowShelfAnalog2, 10 = HighShelfAnalog2.",
            "default": {
                "type": "int",
                "value": "1"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_biquad",
            "display": "evi_biquad"
        },
        {
            "name": "evi_biquad_coeff",
            "display": "evi_biquad_coeff"
        },
