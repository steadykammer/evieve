{
    "object": {
        "name": "evi_tpqm",
        "child": "",
        "category": "evieve",
        "digest": "Three point quadratic map",
        "description": "A utility abstraction that allows for value scaling from a linear input map to a linear output map. Map three input points to three output points and linearly scale between them. Designed really for <o>gen</o> (no tilde) as this is expensive in <o>gen~</o>. See also the equally stupid Max abstraction <o>evi.tpqm</o>."
    },
    "constructor": {
        "inlets": "in, inlow, inmid, inhigh, outlow, outmid, outhigh"
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "name": "in",
            "type": "float",
            "optional": 1,
            "digestauto": "Map",
            "digest": "Input to map."
        },
        {
            "id": 2,
            "name": "inlow",
            "type": "float",
            "optional": 1,
            "digestauto": "@default 0.",
            "digest": "If @useparams is off: Low input value."
        },
        {
            "id": 3,
            "name": "inmid",
            "type": "float",
            "optional": 1,
            "digestauto": "@default 0.5",
            "digest": "If @useparams is off: Mid point input value."
        },
        {
            "id": 4,
            "name": "inhigh",
            "type": "float",
            "optional": 1,
            "digestauto": "@default 1.",
            "digest": "If @useparams is off: High input value."
        },
        {
            "id": 5,
            "name": "outlow",
            "type": "float",
            "optional": 1,
            "digestauto": "@default 0.",
            "digest": "If @useparams is off: Low output value."
        },
        {
            "id": 6,
            "name": "outmid",
            "type": "float",
            "optional": 1,
            "digestauto": "@default 0.5",
            "digest": "If @useparams is off: Mid point output value."
        },
        {
            "id": 7,
            "name": "outhigh",
            "type": "float",
            "optional": 1,
            "digestauto": "@default 1.",
            "digest": "If @useparams is off: High output value."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "out",
            "type": "float",
            "optional": 1,
            "digestauto": "Map",
            "digest": "The output value mapped via the three point quadratic map."
        }
    ],
    "attributes": [
        {
            "name": "inhigh",
            "type": "float",
            "digest": "If @useparams is on",
            "description": "High input value.",
            "default": {
                "type": "float",
                "value": "1."
            }
        },
        {
            "name": "inlow",
            "type": "float",
            "digest": "If @useparams is on",
            "description": "Low input value.",
            "default": {
                "type": "float",
                "value": "0."
            }
        },
        {
            "name": "inmid",
            "type": "float",
            "digest": "If @useparams is on",
            "description": "Mid point input value.",
            "default": {
                "type": "float",
                "value": "0.5"
            }
        },
        {
            "name": "outhigh",
            "type": "float",
            "digest": "If @useparams is on",
            "description": "High output value.",
            "default": {
                "type": "float",
                "value": "1."
            }
        },
        {
            "name": "outlow",
            "type": "float",
            "digest": "If @useparams is on",
            "description": "Low output value.",
            "default": {
                "type": "float",
                "value": "0."
            }
        },
        {
            "name": "outmid",
            "type": "float",
            "digest": "If @useparams is on",
            "description": "Mid point output value.",
            "default": {
                "type": "float",
                "value": "0.5"
            }
        },
        {
            "name": "useparams",
            "type": "int",
            "digest": "Flag 0/1",
            "description": "In GenExpr we will want to use this with inlets, but in gen or gen~ patching that would be a nightmare, so we have the slightly less nightmare option of using params. If @useparams is on (1), all ranges are set with their respective parameter values. If @useparams is off (0, the default), all ranges are set via their respective inlets.",
            "default": {
                "type": "float",
                "value": "0",
                "min": 0,
                "max": 1
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_map",
            "display": "evi_map"
        },
        {
            "name": "evi_utilities",
            "display": "evi_utilities.genexpr"
        }
    ]
}