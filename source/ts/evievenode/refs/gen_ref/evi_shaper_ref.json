{
    "object": {
        "name": "evi_shaper",
        "child": "evi.shaper~",
        "category": "evieve",
        "digest": "An interpolated choice of even or odd harmonics waveshaping",
        "description": "A simple object to cleanly add harmonics to an audio chain when required. A choice of up to 8-ish harmonics either even or odd can be smoothly interpolated onto the audio signal."
    },
    "constructor": {
        "inlets": "audio"
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "to be Shaped",
            "digest": "Any audio input."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "shaped",
            "type": "float",
            "optional": 1,
            "digestauto": "Audio Output",
            "digest": "Hopefully more interesting audio output."
        }
    ],
    "attributes": [
        {
            "name": "compensate",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "Gain compensate the drop in energy over the interpolation of adding harmonics.",
            "default": {
                "type": "int",
                "value": "1"
            }
        },
        {
            "name": "harmonics",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "Interpolated 0..1 add 0..8 harmonics (0 = 0, 0.25 = 1, 0.5 = 2, 0.75 = 4, 1 = 8).",
            "default": {
                "type": "float",
                "value": "0.5"
            }
        },
        {
            "name": "shape",
            "type": "float",
            "digest": "@min -1, @max 1",
            "description": "Greater than 0 gradually adds odd harmonics, less than zero gradually adds even harmonics.",
            "default": {
                "type": "float",
                "value": "0."
            }
        },
        {
            "name": "smooth",
            "type": "float",
            "digest": "@min 0, @max 666",
            "description": "Optionally smooth (in ms) @harmonics and @shape attributes, default off.",
            "default": {
                "type": "float",
                "value": "0."
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_softclip",
            "display": "evi_softclip"
        },
        {
            "name": "evi_sinfold",
            "display": "evi_sinfold"
        },
        {
            "name": "evi_warmer",
            "display": "evi_warmer"
        },
        {
            "name": "evi_clipasym",
            "display": "evi_clipasym"
        },
        {
            "name": "evi_rectify",
            "display": "evi_rectify"
        },
        {
            "name": "evi_softstatic",
            "display": "evi_softstatic"
        },
        {
            "name": "evi_squeeze",
            "display": "evi_squeeze"
        },
        {
            "name": "evi_valve",
            "display": "evi_valve"
        }
    ]
}