{
    "object": {
        "name": "evi_tri",
        "child": "evi.tri~",
        "category": "evieve",
        "digest": "Antialiased triangle wave oscillator",
        "description": "Simple antialiased tri wave oscillator based on 4-point polyblep algorithm. The highest quality of the evieve polyblep oscillators. Including high frequency compensation."
    },
    "constructor": {
        "inlets": "frequency, reset"
    },
    "includes": [
        "evi_polyblep_four",
        "evi_polyblep_utility"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "frequency",
            "type": "float",
            "optional": 1,
            "digestauto": "in Hz",
            "digest": "Oscillator frequency in Hz."
        },
        {
            "id": 2,
            "name": "reset",
            "type": "float",
            "optional": 1,
            "digestauto": "(Naive)",
            "digest": "Oscillator phase reset, naive and not antialiased."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "anti",
            "type": "float",
            "optional": 1,
            "digestauto": "Aliased Tri Oscillator",
            "digest": "Anti Aliased Tri Oscillator"
        }
    ],
    "attributes": [],
