{
    "object": {
        "name": "evi_korgms20",
        "child": "evi.korgms20~",
        "category": "evieve",
        "digest": "Korg OTA dual-amplifier modified Sallen-Key topology nonlinear filter emulation with simultaneous outputs",
        "description": "The 'KLM' OTA chip was found in the later MS-20s and other Korg synthesisers - it is different to the earlier 'Korg 35' single-amplifier unbuffered Korg chip found in the earlier MS-20s and MS-10 and also in the 'monotron' series. This Korg filter sits inbetween the more broken <o>evi.korgms10~</o> and the more stable <o>evi.korgms20.select~</o>. It is aggressive but predictable."
    },
    "constructor": {
        "inlets": "audio, cutoff, resonance"
    },
    "includes": [
        "evi_tanh",
        "evi_interp"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "Input",
            "digest": "Audio input to be filtered."
        },
        {
            "id": 2,
            "name": "cutoff",
            "type": "float",
            "optional": 1,
            "digestauto": "Frequency in Hz @min 1",
            "digest": "Filter cutoff frequency in Hz."
        },
        {
            "id": 3,
            "name": "resonance",
            "type": "float",
            "optional": 1,
            "digestauto": "0..1 @min 0.01 @max 1.476 @default 0.94",
            "digest": "Filter resonance 0..1 (0.01..1.476)."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "korg",
            "type": "float",
            "optional": 1,
            "digestauto": "OTA S&K Lowpass",
            "digest": "12dB lowpass output."
        },
        {
            "id": 2,
            "name": "korg",
            "type": "float",
            "optional": 1,
            "digestauto": "OTA S&K Highpass",
            "digest": "6dB highpass output."
        }
    ],
    "attributes": [
        {
            "name": "load",
            "type": "float",
            "digest": "@min 0.5, @max 2",
            "description": false,
            "default": {
                "type": "float",
                "value": "1.333333333333"
            }
        },
        {
            "name": "oversample",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "If on (1) the filter is 2x oversampled. If off (0, the default), the filter runs at samplerate. Oversampling is recommended to deal with the nonlinear behaviour of the filter, but is expensive because of the multimode outputs.",
            "default": {
                "type": "int",
                "value": "0"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_korgms10",
            "display": "evi_korgms10"
        },
        {
            "name": "evi_korgms20_select",
            "display": "evi_korgms20_select"
        },
        {
            "name": "evi_ladder_diode",
            "display": "evi_ladder_diode"
        },
        {
            "name": "evi_ladder_transistor",
            "display": "evi_ladder_transistor"
        }
    ]
}