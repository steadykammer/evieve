{
    "object": {
        "name": "evi_vactrol_shape",
        "child": "",
        "category": "evieve",
        "digest": "A digital model of a vactrol filter",
        "description": "A digital model of a vactrol filter, quasi 'analog' in behaviour, with quirky rise/fall settings in fixed ranges."
    },
    "constructor": {
        "inlets": "voltage, rise, fall"
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "name": "voltage",
            "type": "float",
            "optional": 1,
            "digest": "Audio to trigger the envelope, typically an impulse. Expects large 'voltage' ranges, but this can be managed with the 'scalein' and 'scaleout' attributes."
        },
        {
            "id": 2,
            "name": "rise",
            "type": "float",
            "optional": 1,
            "digestauto": "% 0..1 @min 0 @max 1 @default 0.070711",
            "digest": "If @mode == 0: envelope rise time normalised 0..1"
        },
        {
            "id": 3,
            "name": "fall",
            "type": "float",
            "optional": 1,
            "digestauto": "% 0..1 @min 0 @max 1 @default 0.707107",
            "digest": "If @mode == 0: envelope fall time normalised 0..1"
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "vactrol",
            "type": "float",
            "optional": 1,
            "digestauto": "Envelope",
            "digest": "Vactrol-like envelope output."
        }
    ],
    "attributes": [
        {
            "name": "invert",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "Not as stupid as it seems: inverts the rise/fall frequency response of the filter, giving boomy envelopes.",
            "default": {
                "type": "int",
                "value": "0"
            }
        },
        {
            "name": "mode",
            "type": "int",
            "digest": "@min 0, @max 3",
            "description": "If @mode == 0 (the default), 'rise' and 'fall' inlets are used to determine the envelope shape. If @mode == 1, 2 or 3: fixed 'tuned' times are used, 1..3 short..long.",
            "default": {
                "type": "int",
                "value": "0"
            }
        },
        {
            "name": "scalein",
            "type": "float",
            "digest": "@min 0.1, @max 10000",
            "description": "Envelope input multiplier. This is often needed massage the results to a usable output.",
            "default": {
                "type": "float",
                "value": "1."
            }
        },
        {
            "name": "scaleout",
            "type": "float",
            "digest": "@min 0.1, @max 10000",
            "description": "Envelope output multiplier. This is often needed massage the results to a usable output.",
            "default": {
                "type": "float",
                "value": "1."
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_vactrol",
            "display": "evi_vactrol"
        },
        {
            "name": "evi_vactrol_fix",
            "display": "evi_vactrol_fix"
        },
        {
            "name": "evi_logdecay",
            "display": "evi_logdecay"
        },
        {
            "name": "evi_logattackdecay",
            "display": "evi_logattackdecay"
        },
        {
            "name": "evi_logahr",
            "display": "evi_logahr"
        },
        {
            "name": "evi_zeroxoscnoise",
            "display": "evi_zeroxoscnoise"
        },
        {
            "name": "evi_env",
            "display": "evi_env.genexpr"
        },
        {
            "name": "evi_smooth",
            "display": "evi_smooth.genexpr"
        }
    ]
}