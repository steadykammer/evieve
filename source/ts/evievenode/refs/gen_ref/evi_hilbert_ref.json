{
    "object": {
        "name": "evi_hilbert",
        "child": "",
        "category": "evieve",
        "digest": "Hilbert quadrature (phase shift) filter",
        "description": "Hilbert quadrature (phase shift) filter using an 8th order polyphase IIR halfband allpass cascade. If using in gen~ alone the samplerate must be 48kHz, or if running at a different samplerate the hilbert filter coefficients must be fed in externally. See the <o>evi.hilbert~</o> abstraction for an example."
    },
    "constructor": {
        "inlets": "input"
    },
    "includes": [
        "evi_biquads_extras"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be phase shifted."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "cosine/real",
            "type": "float",
            "optional": 1,
            "digestauto": "Output",
            "digest": "0 degrees filter phase output."
        },
        {
            "id": 2,
            "name": "sine/imag",
            "type": "float",
            "optional": 1,
            "digestauto": "Output",
            "digest": "+90 degrees filter phase output."
        }
    ],
    "attributes": [
        {
            "name": "coef1",
            "type": "float",
            "digest": "@min -10, @max 10",
            "description": "Polyphase IIR Halfband Allpass Cascade Coefficient 1",
            "default": {
                "type": "float",
                "value": "0.486604368613682"
            }
        },
        {
            "name": "coef2",
            "type": "float",
            "digest": "@min -10, @max 10",
            "description": "Polyphase IIR Halfband Allpass Cascade Coefficient 2",
            "default": {
