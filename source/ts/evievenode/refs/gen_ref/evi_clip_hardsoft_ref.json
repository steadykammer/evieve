{
    "object": {
        "name": "evi_clip_hardsoft",
        "child": "evi.clip~",
        "category": "evieve",
        "digest": "Anti-aliased clipping algorithms for your audio",
        "description": "A collection of four anti-aliased clipping algorithms: hard clip, soft clip, diode clip, asymmetric clip. Hard and soft are better anti-aliased and can take higher input gain before aliasing than the diode and asymmetric clippers. To be used whenever clamping of audio is required, <o>evi.clip~</o> should do a good job of protecting your precious audio."
    },
    "constructor": {
        "inlets": "audio"
    },
    "includes": [
        "evi_clip"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "In that must be treated nicely",
            "digest": "Any audio input."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "anti",
            "type": "float",
            "optional": 1,
            "digestauto": "Aliased Clipped Audio Out",
            "digest": "Hopefully cleanly clipped output."
        }
    ],
    "attributes": [
        {
            "name": "clip",
            "type": "int",
            "digest": "@min 0, @max 3",
            "description": "Select the clipping function used. 0=hard (default), 1=soft, 2=diode, 3=asymmetric. 'Hard' is the equivalent of [clip~ -1. 1], 'soft' is the equivalent of [tanh~], 'diode' is a static model of a 12AX7, 'aymmetric' is a static version of Laurent de Soras' 'Gloubi Boulga'.",
            "default": {
                "type": "int",
                "value": "0"
            }
        },
        {
            "name": "oversampling",
            "type": "int",
            "digest": "@min 0, @max 2",
            "description": "Regardless of this setting, hard and soft clippers are 2nd order antiderivatives and thus already have excellent behaviour with @oversampling=0. Oversampling=1 is 2x oversampling, oversampling=2 is 4x oversampling.",
            "default": {
                "type": "int",
                "value": "2"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_limiterfast",
            "display": "evi_limiterfast"
        },
        {
            "name": "evi_hardclip",
            "display": "evi_hardclip"
        },
