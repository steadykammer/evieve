{
    "object": {
        "name": "evi_freezeverbtrigger",
        "child": "",
        "category": "evieve",
        "digest": "Classic freeverb reverb algorithm with buttery smooth freezing effect controllable at audio rate",
        "description": "This is a basic Schroeder reverb effect but with additional filtering and controls. The main feature here is the ability to smoothly capture the input audio in the recirculating feedback path in a way which gives a forever freezing effect. This can be triggered and released with wet+dry or with wet alone. In the <o>evi.freezeverb~</o>) abstraction, which wraps the <o>evi_freezeverb</o> gen~ abstraction, this freezing effect is achieved at message rate. The point of this <o>evi_freezeverbtrigger</o> abstraction is to offer the freeze and retrigger functions as audio-rate inlets so that triggering the effect can be done in audio only control rate processing scenarios."
    },
    "constructor": {
        "inlets": "left, right, freeze, retrigger"
    },
    "includes": [
        "evi_reverb_library"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "left",
            "type": "float",
            "optional": 1,
            "digestauto": "Signal Input",
            "digest": "Audio input left."
        },
        {
            "id": 2,
            "name": "right",
            "type": "float",
            "optional": 1,
            "digestauto": "Signal Input",
            "digest": "Audio input right."
        },
        {
            "id": 3,
            "name": "freeze",
            "type": "float",
            "optional": 1,
            "digestauto": "0/1/2 @default 0",
            "digest": "Audio rate or message rate control of freezing effect; 0=off, 1=on+dry, 2=on-wet-only."
        },
        {
            "id": 4,
            "name": "retrigger",
            "type": "float",
            "optional": 1,
            "digestauto": "Freeze",
            "digest": "Audio rate sync signal to 'retrigger' the current freeze effect."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "left",
            "type": "float",
            "optional": 1,
            "digestauto": "Reverb Output",
            "digest": "Full dry/wet reverb output left."
        },
        {
            "id": 2,
            "name": "right",
            "type": "float",
            "optional": 1,
            "digestauto": "Reverb Output",
            "digest": "Full dry/wet reverb output right."
        },
        {
            "id": 3,
