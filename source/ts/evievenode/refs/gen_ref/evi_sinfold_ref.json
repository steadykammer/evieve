{
    "object": {
        "name": "evi_sinfold",
        "child": "",
        "category": "evieve",
        "digest": "An antialiased sine folding waveshaper",
        "description": "Unlike other evieve waveshapers, <o>evi.sinfold~</o> focusses on mid/high harmonics. By increasing the @drive attribute the input gradually folds over. Can be driven hard with clean antialiased saturation."
    },
    "constructor": {
        "inlets": "audio"
    },
    "includes": [
        "evi_sinfold_lib"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "Input",
            "digest": "Any audio input."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "sine",
            "type": "float",
            "optional": 1,
            "digestauto": "Saturated Output",
            "digest": "Hopefully more interesting audio output."
        }
    ],
    "attributes": [
        {
            "name": "aa",
            "type": "int",
            "digest": "@min 0, @max 2",
            "description": "'aa' stands for 'Anti Aliasing'. Select the type of antialiasing with this attribute. 0=1st order antiderivative, 1=1st order antiderivative 2x oversampled, 2=1st order antiderivative 4x oversampled (the default).",
            "default": {
                "type": "int",
                "value": "2"
            }
        },
        {
            "name": "drive",
            "type": "float",
            "digest": "@min 0, @max 4",
            "description": "Drive the waveshaping input gain via a sine shaping function. A bit like a % 0..1.. up to 2 is pretty safe, up to 4 be careful (in terms of aliasing).",
            "default": {
                "type": "float",
                "value": "0.5"
            }
        },
        {
            "name": "smooth",
            "type": "float",
            "digest": "@min 1, @max 111",
            "description": "Optionally smooth the internal coefficients over this time in ms. Smoothing should be kept as low as possible to avoid low @drive bumps.",
            "default": {
                "type": "float",
                "value": "11.222"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_softclip",
            "display": "evi_softclip"
        },
        {
            "name": "evi_hardclip",
            "display": "evi_hardclip"
        },
        {
            "name": "evi_clipasym",
            "display": "evi_clipasym"
        },
        {
            "name": "evi_shaper",
            "display": "evi_shaper"
        },
        {
            "name": "evi_warmer",
            "display": "evi_warmer"
        },
        {
            "name": "evi_overdrive_env",
            "display": "evi_overdrive_env"
        },
        {
            "name": "evi_overdrive_wrap",
            "display": "evi_overdrive_wrap"
        },
        {
            "name": "evi_overdrive_fold",
            "display": "evi_overdrive_fold"
        },
        {
            "name": "evi_tone_macro",
            "display": "evi_tone_macro"
        },
        {
            "name": "evi_rcfilter",
            "display": "evi_rcfilter"
        },
        {
            "name": "evi_baxandall",
            "display": "evi_baxandall"
        },
        {
            "name": "evi_rectify",
            "display": "evi_rectify"
        },
