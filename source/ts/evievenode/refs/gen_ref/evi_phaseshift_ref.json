{
    "object": {
        "name": "evi_phaseshift",
        "child": "evi.phaseshift~",
        "category": "evieve",
        "digest": "Reimplementation of MSP <o>phaseshift~</o> object as a TPT filter",
        "description": "A second order TPT allpass filter which distorts the phase of the signal. See the 'frequency-response' tab of the <o>phaseshift~</o> helpfile for an explanation which is still accurate for this TPT version."
    },
    "constructor": {
        "inlets": "input, frequency, q"
    },
    "includes": [
        "evi_svfs",
        "evi_svfs_tpt_filters"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be filtered."
        },
        {
            "id": 2,
            "name": "frequency",
            "type": "float",
            "optional": 1,
            "digestauto": "in Hz @min 1 @max samplerate*0.5",
            "digest": "Center frequency of the phase transition band."
        },
        {
            "id": 3,
            "name": "q",
            "type": "float",
            "optional": 1,
            "digestauto": "@min 0.1 @max 20 @default 1",
            "digest": "Q (bandwidth) of the phase transition band."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "output",
            "type": "float",
            "optional": 1,
            "digest": ""
        }
    ],
    "attributes": [
        {
            "name": "smooth",
            "type": "float",
            "digest": "@min 0, @max 333",
            "description": "",
            "default": {
                "type": "float",
                "value": "0."
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_filter_allpass",
            "display": "evi_filter_allpass"
        },
        {
            "name": "evi_lores",
            "display": "evi_lores"
        },
        {
            "name": "evi_onepole",
            "display": "evi_onepole"
        },
        {
            "name": "evi_reson",
            "display": "evi_reson"
        },
        {
            "name": "evi_svf",
            "display": "evi_svf"
        },
        {
            "name": "evi_cross",
            "display": "evi_cross"
        },
        {
            "name": "evi_hilbert",
            "display": "evi_hilbert"
        },
        {
            "name": "evi_allpass",
            "display": "evi_allpass"
        },
        {
            "name": "evi_comb",
            "display": "evi_comb"
        },
        {
            "name": "evi_teeth",
            "display": "evi_teeth"
        },
        {
            "name": "evi_bp",
            "display": "evi_bp"
        },
