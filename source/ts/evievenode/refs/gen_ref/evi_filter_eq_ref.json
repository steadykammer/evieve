{
    "object": {
        "name": "evi_filter_eq",
        "child": "evi.filter.eq~",
        "category": "evieve",
        "digest": "EQ type TPT filters with a choice of 7 filters",
        "description": "This filter block can be switched between 7 different EQ filter types. The filter is a clean twopole TPT SVF section which can be used in place of a biquad as it has superior properties to a biquad. It is designed to be an every day patching workhorse for most EQ filtering needs. Each individual filter type can also be instantiated in it's own all-in-one block, see the 'seealso' for details. The TPT SVF is used all over evieve whenever basic EQ filtering is required."
    },
    "constructor": {
        "inlets": "input, cutoff, gain, q"
    },
    "includes": [
        "evi_svfs",
        "evi_svfs_tpt"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be filtered."
        },
        {
            "id": 2,
            "name": "cutoff",
            "type": "float",
            "optional": 1,
            "digestauto": "in Hz @min 1 @max samplerate*0.5",
            "digest": "Cutoff frequency in Hz of the selected filter type."
        },
        {
            "id": 3,
            "name": "gain",
            "type": "float",
            "optional": 1,
            "digestauto": "in dB @min -30 @max 30 @default 0",
            "digest": "± gain in dB of the selected filter type."
        },
        {
            "id": 4,
            "name": "q",
            "type": "float",
            "optional": 1,
            "digestauto": "@min 0.05 @max 20 @default 0.707107",
            "digest": "Q, clamped in the range 0.05..20."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "eq",
            "type": "float",
            "optional": 1,
            "digestauto": "Filter Output",
            "digest": "Filtered audio output."
        }
    ],
    "attributes": [
        {
            "name": "filter",
            "type": "int",
            "digest": "@min 0, @max 7",
            "description": "Set the filter type by integer index: 0=Bypass, 1=Highpass, 2=Lowshelf, 3=Bell (default), 4=BellAdaptiveQ, 5=Notch, 6=Highshelf, 7=Lowpass",
            "default": {
                "type": "int",
                "value": "3"
            }
        },
        {
            "name": "smooth",
            "type": "float",
            "digest": "@min 0, @max 333",
            "description": "Smooth the mixing gains of the filter efficiently at the core of the DSP. With these TPT SVF filters this will usually be the only smoothing required. By default smoothing is off.",
            "default": {
                "type": "float",
                "value": "0."
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_filter",
            "display": "evi_filter"
        },
        {
            "name": "evi_filter_shelving",
            "display": "evi_filter_shelving"
        },
        {
            "name": "evi_filter_morph",
            "display": "evi_filter_morph"
        },
        {
            "name": "evi_filter_allpass",
            "display": "evi_filter_allpass"
        },
        {
            "name": "evi_filter_bandpass",
            "display": "evi_filter_bandpass"
        },
        {
            "name": "evi_filter_bell",
            "display": "evi_filter_bell"
        },
        {
            "name": "evi_filter_highpass",
            "display": "evi_filter_highpass"
        },
        {
            "name": "evi_filter_highshelf",
            "display": "evi_filter_highshelf"
        },
        {
            "name": "evi_filter_lowpass",
            "display": "evi_filter_lowpass"
        },
        {
            "name": "evi_filter_lowshelf",
            "display": "evi_filter_lowshelf"
        },
        {
            "name": "evi_filter_notch",
            "display": "evi_filter_notch"
        },
        {
            "name": "evi_filter_peak",
            "display": "evi_filter_peak"
        },
        {
            "name": "evi_filter_resonant",
            "display": "evi_filter_resonant"
        },
        {
            "name": "evi_filter_tilt",
            "display": "evi_filter_tilt"
        }
    ]
}