{
    "object": {
        "name": "evi_comb",
        "child": "evi.comb~",
        "category": "evieve",
        "digest": "Reimplementation of MSP <o>comb~</o> filter delay",
        "description": "Comb filter delay unit with saturation in the feedback path. The same structure as MSP <o>comb~</o>, but with cubic interpolation (softer in the high end) and no digital clipping at FB Gain == 1 (via internal saturation, which makes the whole filter softer but will not clip your precious audio)."
    },
    "constructor": {
        "inlets": "input, delay, direct, feedforward, feedback"
    },
    "includes": [
        "evi_approx"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to filter"
        },
        {
            "id": 2,
            "name": "delay",
            "type": "float",
            "optional": 1,
            "digestauto": "in ms @min 0 @max 1000",
            "digest": "Delay time in ms."
        },
        {
            "id": 3,
            "name": "direct",
            "type": "float",
            "optional": 1,
            "digestauto": "Gain Coefficient @min -1 @max 1",
            "digest": "Not smoothed internally. Applies negative or positive gain to the input path."
        },
        {
            "id": 4,
            "name": "feedforward",
            "type": "float",
            "optional": 1,
            "digestauto": "Coefficient @min -1 @max 1",
            "digest": "Not smoothed internally. Applies negative or positive gain to the feedforward path."
        },
        {
            "id": 5,
            "name": "feedback",
            "type": "float",
            "optional": 1,
            "digestauto": "Coefficient @min -1 @max 1",
            "digest": "Not smoothed internally. Applies negative or positive gain to the feedback path."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "comb",
            "type": "float",
            "optional": 1,
            "digest": "Filtered audio output."
        }
    ],
    "attributes": [],
    "seealso": [
        {
            "name": "evi_allpass",
            "display": "evi_allpass"
        },
        {
            "name": "evi_teeth",
            "display": "evi_teeth"
        }
    ]
}