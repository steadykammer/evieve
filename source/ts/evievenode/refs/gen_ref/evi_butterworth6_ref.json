{
    "object": {
        "name": "evi_butterworth6",
        "child": "evi.butterworthlp6~",
        "category": "evieve",
        "digest": "Unique 6th order Butterworth Lowpass filter created from <o>evi.bp~</o> sections after Miller Puckette",
        "description": "A smooth 6th order butterworth lowpass with very interesting properties being made up of three resonant filter sections."
    },
    "constructor": {
        "inlets": "input, cutoff"
    },
    "includes": [
        "evi_biquads",
        "evi_biquads_extras"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be filtered."
        },
        {
            "id": 2,
            "name": "cutoff",
            "type": "float",
            "optional": 1,
            "digestauto": "in Hz @min samplerate*0.000041 @max samplerate*0.470588",
            "digest": "Cutoff frequency in Hz."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "bp",
            "type": "float",
            "optional": 1,
            "digestauto": "6-pole Butterworth Lowpass Output",
            "digest": "Filtered audio output."
        }
    ],
