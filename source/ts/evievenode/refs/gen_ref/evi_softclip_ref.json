{
    "object": {
        "name": "evi_softclip",
        "child": "evi.softclip~",
        "category": "evieve",
        "digest": "Anti-aliased soft clipping function",
        "description": "A quick all purpose and efficient soft clipper. <o>evi.softclip~</o> does not have all the options of <o>evi.hardclip~</o> or <o>evi.clip~</o>. It aims to be an easy <o>tanh~</o> replacement to drop in to audio chains. The algorithm is a 2nd order antiderivative antialiasing tanh-like function. At high input gains the behaviour is less tanh-like as it folds."
    },
    "constructor": {
        "inlets": "audio"
    },
    "includes": [
        "evi_adaa"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "In",
            "digest": "Any audio input."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "soft-clipped",
            "type": "float",
            "optional": 1,
            "digest": "Hopefully cleanly soft clipped output."
        }
    ],
