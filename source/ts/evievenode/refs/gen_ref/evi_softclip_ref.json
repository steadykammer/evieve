{
    "object": {
        "name": "evi_softclip",
        "child": "evi.softclip~",
        "category": "evieve",
        "digest": "Antialiased soft clipping function",
        "description": "A quick all purpose and efficient soft clipper. <o>evi.softclip~</o> does not have all the options of <o>evi.hardclip~</o> or <o>evi.clipper~</o>. It aims to be an easy <o>tanh~</o> replacement to drop in to audio chains. The algorithm is a 2nd order antiderivative antialiasing tanh-like function."
    },
    "constructor": {
        "inlets": "audio"
    },
    "includes": [
        "evi_adaa",
        "evi_clipping"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "In",
            "digest": "Any audio input."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "soft-clipped",
            "type": "float",
            "optional": 1,
            "digestauto": "Audio Out",
            "digest": "Hopefully cleanly soft clipped output."
        }
    ],
