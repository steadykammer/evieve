
// formant filter but with morphable filters (LP..BP..HP..NOTCH..LP via 4th 'Morph' inlet).
// requires external LUT (@see: evieve/media/lut/evi_formants_LUT.wav).
// expensive.
// for a more normal resonant filter version @see: "evi_filter_formant.gendsp"
// @see also: "evi_formant_osc.gendsp"

require("evi_svf");
require("evi_smooth");

// parse data as formatted in external LUT
formantIndex(voicephase, vowelphase, numvoices, numvowels, datatype)    // 'datatype' is already int
{
	// constants
	typejump	= 75;	voxjump		= 15;	vowjump		= 3;

	// parse
	vox			= int(numvoices) - 1;		// .. B .. T .. CT .. A .. S ..
	vow			= int(numvowels) - 1;		// .. A .. E .. I .. O .. U ..
	type		= datatype ? typejump : 0;
	voxdrive	= voicephase * vox;
	vowdrive	= vowelphase * vow;

	// get fract / trunc
	voxfract	= fract(voxdrive);
	voxtrunc	= trunc(voxdrive);
	vowfract	= fract(vowdrive);
	vowtrunc	= trunc(vowdrive);

	// get voice indeces
	voxoffset1	= (voxtrunc * voxjump) + type;
	voxoffset2	= (wrap((voxtrunc + 1), 0, vox) * voxjump) + type;

	// get vowel indeces
	vowmul1		= vowtrunc * vowjump;
	vowmul2		= wrap((vowtrunc + 1), 0, vow) * vowjump;

	return	voxfract, vowfract, voxoffset1, voxoffset2, vowmul1, vowmul2;
}

Data    filterCoefficients(7, 5);           // because summing in for-loop is not working
Data    formantFrequency(1, 5);             // extrapolate frequency from loop

Buffer	formantData("#0_formantData");		// alias to MSP ('#0_' for building / testing only) LUT[]
// i'm just using the Csound data like everyone else...
// 
// channels   (5):	 0	=	f1,		1 = f2,		2 = f3,		3 = f4,		4 = f5
// 
// indeces  (150):	 0	=	bass A: cf_hz, bw_hz, amp; 	 3 = E: ...  6 = I: ...  9 = O: ... 12 = U: ...
// 					15	=	tenor			A: ... 		18 = E: ... 21 = I: ... 24 = O: ... 27 = U: ...
// 					30	=	countertenor	A: ... 		33 = E: ... 36 = I: ... 39 = O: ... 42 = U: ...
// 					45	=	alto			A: ... 		48 = E: ... 51 = I: ... 54 = O: ... 57 = U: ...
// 					60	=	soprano			A: ... 		63 = E: ... 66 = I: ... 69 = O: ... 72 = U: ...
//						...	(& +75 for repeats with pitch / db data) ...

Param	voices(5, min=1, max=5);            // # of voices, do not change
Param	vowels(5, min=1, max=5);            // # of vowels, do not change

// these next two are not used in this filter version at the moment, but they stay here in case i can do something with them
Param	formants(5, min=1, max=5);			// # formants to use (default full = 5)
Param	formantsoffset(0, min=0);			// formant index to offset from (default none = 0, channelmode wrap)
Param   formantfrequency(0, min=0, max=4);  // out2 sends frequency of which formant?

Param   datainterp(1, min=0, max=1);        // 0=clip, 1=wrap, affects in2 & in3 == 1
Param	datatype(0, min=0, max=1);			// 0 = read hz/amp data, 1 = read pitch/db data
// ^^ 'datatype' affects the way the vox/vow interpolation sounds (interpolates lin or log data)

Param	gain(0, min=-80, max=20);			// global gain in dB

// manually warp the formant data
Param	warpsmooth(1, min=0, max=1);		// warp parameters (cf & bw & gain) smoothing off / on ?
Param	cfwarp(1, min=0.025, max=4);		// multiply (warp) formant frequency size ?
Param	bwwarp(1, min=0.00625, max=32);		// multiply (warp) formant bandwidth size ?
Param	gainwarp(1, min=0.025, max=4);		// multiply (warp) formant gain size ?
Param	gainnorm(0, min=0, max=1);			// normalise higher formants' gain in for-loop ?

Param	paramsmooth(15.111, min=0, max=333);// global param smoothing in ms

//fsize	= dim(formantData);
fchns	= channels(formantData);

parmsmsecs  = paramsmooth * 0.001;          // to secs
parsmsamps	= parmsmsecs * samplerate;      // to samps
parmsmss05  = parmsmsecs * 0.5;

formantfreq = int(formantfrequency);
dinterp     = int(datainterp);              // in2 & in3: 0 = clip, 1 = wrap
wsmooth		= int(warpsmooth);
dtype       = int(datatype);

gnw         = gainwarp;
gnnorm	    = int(gainnorm);
filtlevel	= dbtoaApprox(gain);

// select # of / which formants
// these two are no used in this filter version at the moment, but they stay here in case i can do something with them
numform		= int(minimum(formants, fchns));
foffset		= int(formantsoffset);          // offset formant # (wrap 'channelmode')

// audio rate

X       = in1;

// morphing vox / vowel lookup controls
voicephase      = 0;                        // 0..1 bass..tenor..countertenor..alto..soprano
vowelphase      = 0;                        // 0..1 A..E..I..O..U
if (dinterp) {
    voicephase	= wrap(in2, 0, 1);
    vowelphase	= wrap(in3, 0, 1);
} else {
    voicephase	= clip(in2, 0, 1);
    vowelphase	= clip(in3, 0, 1);
}

morph           = clip(in4, 0, 1);          // default = 0.25 == bandpass

cfw          = cfwarp;
bww          = bwwarp;
if (wsmooth > 0) {
	cfw, bww =  expsmoothBank2(cfwarp, bwwarp, parmsmsecs);
}

globalgain	 = logsmooth((filtlevel * (1 / fchns)), parmsmsecs);  // always smoothed

voxfract, vowfract, voxoffset1, voxoffset2, vowmul1, vowmul2
			 = formantIndex(voicephase, vowelphase, voices, vowels, dtype);

// channels   (5):	 0	=	f1,		1 = f2,		2 = f3,		3 = f4,		4 = f5
// 
// indeces  (150):	 0	=	bass A: cf_hz, bw_hz, amp; 	 3 = E: ...  6 = I: ...  9 = O: ... 12 = U: ...
// 					15	=	tenor			A: ... 		18 = E: ... 21 = I: ... 24 = O: ... 27 = U: ...
// 					30	=	countertenor	A: ... 		33 = E: ... 36 = I: ... 39 = O: ... 42 = U: ...
// 					45	=	alto			A: ... 		48 = E: ... 51 = I: ... 54 = O: ... 57 = U: ...
// 					60	=	soprano			A: ... 		63 = E: ... 66 = I: ... 69 = O: ... 72 = U: ...
//						...	(& +75 for repeat with pitch / db data) ...

for (k = 0; k < numform; k += 1) {
	// setup
	formantchan	=  k + foffset;

	// parse data from LUT      // we need @boundmode & @channelmode "wrap" for the @formants & @formantsoffset features,
                                // but this is an issue for wraparound of 'voicephase' & 'vowelphase', any ideas?
	CF1			= peek(formantData, (vowmul1 + (voxoffset1 + 0)), formantchan, index="samples", boundmode="wrap", channelmode="wrap", interp="none");
	BW1			= peek(formantData, (vowmul1 + (voxoffset1 + 1)), formantchan, index="samples", boundmode="wrap", channelmode="wrap", interp="none");
	GN1			= peek(formantData, (vowmul1 + (voxoffset1 + 2)), formantchan, index="samples", boundmode="wrap", channelmode="wrap", interp="none");
	CF2			= peek(formantData, (vowmul2 + (voxoffset1 + 0)), formantchan, index="samples", boundmode="wrap", channelmode="wrap", interp="none");
	BW2			= peek(formantData, (vowmul2 + (voxoffset1 + 1)), formantchan, index="samples", boundmode="wrap", channelmode="wrap", interp="none");
	GN2			= peek(formantData, (vowmul2 + (voxoffset1 + 2)), formantchan, index="samples", boundmode="wrap", channelmode="wrap", interp="none");
	CF3			= peek(formantData, (vowmul1 + (voxoffset2 + 0)), formantchan, index="samples", boundmode="wrap", channelmode="wrap", interp="none");
	BW3			= peek(formantData, (vowmul1 + (voxoffset2 + 1)), formantchan, index="samples", boundmode="wrap", channelmode="wrap", interp="none");
	GN3			= peek(formantData, (vowmul1 + (voxoffset2 + 2)), formantchan, index="samples", boundmode="wrap", channelmode="wrap", interp="none");
	CF4			= peek(formantData, (vowmul2 + (voxoffset2 + 0)), formantchan, index="samples", boundmode="wrap", channelmode="wrap", interp="none");
	BW4			= peek(formantData, (vowmul2 + (voxoffset2 + 1)), formantchan, index="samples", boundmode="wrap", channelmode="wrap", interp="none");
	GN4			= peek(formantData, (vowmul2 + (voxoffset2 + 2)), formantchan, index="samples", boundmode="wrap", channelmode="wrap", interp="none");

	// interpolate data
	CFinterp1	= interp(vowfract, CF1, CF2, mode="linear");
	BWinterp1	= interp(vowfract, BW1, BW2, mode="linear");
	GNinterp1	= interp(vowfract, GN1, GN2, mode="cosine");
	CFinterp2	= interp(vowfract, CF3, CF4, mode="linear");
	BWinterp2	= interp(vowfract, BW3, BW4, mode="linear");
	GNinterp2	= interp(vowfract, GN3, GN4, mode="cosine");

	// return formant data
	cfloop		= interp(voxfract, CFinterp1, CFinterp2, mode="linear");
	bwloop		= interp(voxfract, BWinterp1, BWinterp2, mode="linear");
	gnloop		= interp(voxfract, GNinterp1, GNinterp2, mode="cosine");

    // convert if datatype
    if (dtype) {
        cfloop  = mtofApproxAccurate0(cfloop);
        bwloop  = mtofApproxAccurate0(bwloop);
        gnloop  = dbtoaApprox(gnloop);
    }

	// frequency & bandwidth
	cfd			= cfloop * cfw;
	bwd			= bwloop * bww;
    Q           = cfd / bwd;
    gnd         = (gnnorm ? ((1 - gnloop) + gnloop) : gnloop) * gnw;

    // this is expensive...
	g, r, h, cL, cB, cH, cN = tptSvfCoeffMorphFull(cfd, gnd, Q, morph, 1);  // morph default 0.25 == bandpass
    // for a more normal resonant filter version @see: "evi_filter_formant.gendsp"

    poke(filterCoefficients, g, 0, formantchan, 0, index="samples");
    poke(filterCoefficients, r, 1, formantchan, 0, index="samples");
    poke(filterCoefficients, h, 2, formantchan, 0, index="samples");
    poke(filterCoefficients, cL, 3, formantchan, 0, index="samples");
    poke(filterCoefficients, cB, 4, formantchan, 0, index="samples");
    poke(filterCoefficients, cH, 5, formantchan, 0, index="samples");
    poke(filterCoefficients, cN, 6, formantchan, 0, index="samples");

    poke(formantFrequency, cfd, 0, formantchan, 0, index="samples");
}

g1 = peek(filterCoefficients, 0, 0);
r1 = peek(filterCoefficients, 1, 0);
h1 = peek(filterCoefficients, 2, 0);
lc1 = peek(filterCoefficients, 3, 0);
bc1 = peek(filterCoefficients, 4, 0);
hc1 = peek(filterCoefficients, 5, 0);
nc1 = peek(filterCoefficients, 6, 0);

g2 = peek(filterCoefficients, 0, 1);
r2 = peek(filterCoefficients, 1, 1);
h2 = peek(filterCoefficients, 2, 1);
lc2 = peek(filterCoefficients, 3, 1);
bc2 = peek(filterCoefficients, 4, 1);
hc2 = peek(filterCoefficients, 5, 1);
nc2 = peek(filterCoefficients, 6, 1);

g3 = peek(filterCoefficients, 0, 2);
r3 = peek(filterCoefficients, 1, 2);
h3 = peek(filterCoefficients, 2, 2);
lc3 = peek(filterCoefficients, 3, 2);
bc3 = peek(filterCoefficients, 4, 2);
hc3 = peek(filterCoefficients, 5, 2);
nc3 = peek(filterCoefficients, 6, 2);

g4 = peek(filterCoefficients, 0, 3);
r4 = peek(filterCoefficients, 1, 3);
h4 = peek(filterCoefficients, 2, 3);
lc4 = peek(filterCoefficients, 3, 3);
bc4 = peek(filterCoefficients, 4, 3);
hc4 = peek(filterCoefficients, 5, 3);
nc4 = peek(filterCoefficients, 6, 3);

g5 = peek(filterCoefficients, 0, 4);
r5 = peek(filterCoefficients, 1, 4);
h5 = peek(filterCoefficients, 2, 4);
lc5 = peek(filterCoefficients, 3, 4);
bc5 = peek(filterCoefficients, 4, 4);
hc5 = peek(filterCoefficients, 5, 4);
nc5 = peek(filterCoefficients, 6, 4);

if (paramsmooth > 0) {
    lc1, bc1, hc1, nc1 = expsmoothBank4(lc1, bc1, hc1, nc1, parmsmss05);
    lc2, bc2, hc2, nc2 = expsmoothBank4(lc2, bc2, hc2, nc2, parmsmss05);
    lc3, bc3, hc3, nc3 = expsmoothBank4(lc3, bc3, hc3, nc3, parmsmss05);
    lc4, bc4, hc4, nc4 = expsmoothBank4(lc4, bc4, hc4, nc4, parmsmss05);
    lc5, bc5, hc5, nc1 = expsmoothBank4(lc5, bc5, hc5, nc5, parmsmss05);
}

yL1, yB1, yH1 	= tptSvf(X, g1, r1, h1);
yL2, yB2, yH2 	= tptSvf(X, g2, r2, h2);
yL3, yB3, yH3 	= tptSvf(X, g3, r3, h3);
yL4, yB4, yH4 	= tptSvf(X, g4, r4, h4);
yL5, yB5, yH5 	= tptSvf(X, g5, r5, h5);

FF1 = nc1 * (yL1 * lc1) + (yB1 * bc1) + (yH1 * hc1);
FF2 = nc2 * (yL2 * lc2) + (yB2 * bc2) + (yH2 * hc2);
FF3 = nc3 * (yL3 * lc3) + (yB3 * bc3) + (yH3 * hc3);
FF4 = nc4 * (yL4 * lc4) + (yB4 * bc4) + (yH4 * hc4);
FF5 = nc5 * (yL5 * lc5) + (yB5 * bc5) + (yH5 * hc5);

FFvox       = (FF1 + FF2 + FF3 + FF4 + FF5) * globalgain;
f1          = peek(formantFrequency, 0, formantfreq);

out1		= FFvox;
out2        = f1;

