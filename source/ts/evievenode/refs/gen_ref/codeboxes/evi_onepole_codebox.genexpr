
// onepole filter using trapezoidal integration, simultaneous outputs,
// very smooth and very cheap.

// this is not like MSP [onepole~], which is a strange sort of highshelf. evi.onepole~
// is strictly lowpass/highpass with zeros at Nyquist/DC.

// here we have a choice of frequency input in Hz (default) or normalised 0..1,
// optional smoothing is default off

// @see: "evi_rcfilter.gendsp" / [evi.rcfilter~] for nonlinear analog version.
// @see: "evi_damp.gendsp" / [evi.damp~] for a filter closer to MSP [onepole~].

require("evi_rcfilters.genexpr");


Param   smooth(0., min=0, max=333); // ms
Param   prewarp(1, min=0, max=1);   // 1 = input in Hz, 0 = input in 0..1 quasi radians
pw      = int(prewarp);

g       = pw ? rcPreWarp2(clamp(in2, 1, samplerate*0.5)) : clamp(in2, 0, 1);

if (smooth > 0) {
    g   = evi_logsmooth(g, smooth);
}

rclp, rcap, rchp    = rcFilterLpApHp(in1, g);

out1    = rclp;     // lowpass
out2    = rcap;     // allpass
out3    = rchp;     // highpass

