
// analogue-style envelope generator (RC rise & fall, etc)
// but with sample accurate controllers (capable of controlling [thispoly~])
// DAHDSHR:		   [ (Delay),	Attack,	(Hold),	Decay,	Sustain,	(Hold),	Release,	(Retrigger),	Off	]
// segment #:	   [ (1),		2,		(3),	4,		5,			(6),	7,			(8),			0	]
// default ADSR (delay = 0, holds = 0) and behaves like MSP [adsr~]
// default envelope = 0..1..-3dB..0, but accepts arbitrary input scale (like [adsr~], & 'sustain' is default % 0..1)
// by pete for evieve, 2017
// based on code by Nigel Redmond,		@see: http://www.earlevel.com/main/2013/06/03/envelope-generators-adsr-code/
// based on code by Peter McCulloch,	@see: Max > BEAP > AD2	&&	Max > BEAP > AHD

// Note:    This code is a bit silly and overengineered and expensive. I found it in the depths
//          of my hard drive. But it seems to work. So it's going in evieve.

// TODO:
// fix: maxsustain, zerophase, loop
// implement: inverse env curves, constant rate or constant time option

require("evi_approx.genexpr");

linearScale(x, inlo, inhigh, outlo, outhi)		// implementation: f(x) = ax+b
{
	a		= (outlo - outhi) / (inlo - inhigh);
	b		= outlo - (inlo * a);
	return	(x * a) + b;
}

simpleScale(x, outlo, curve)					// implementation: f(x) = log||lin||exp(ax+b)
{
	lin		= linearScale(x, 0, 1, outlo, 1);	// lin	(x & outlo must be normalised 0..1)
	if (curve == 1)
		lin	= sqrt(lin);						// log 2
	else if (curve == 2)
		lin	= sqrt(sqrt(lin));					// log 4
	else if (curve == -1)
		lin	= lin * lin;						// exp 2
	else if (curve == -2)
		lin	= lin * lin * lin * lin;			// exp 4
	return	lin;
}

calcCoeff(rate, targetRatio)
{
	return	(rate <= 0) ? 0 : exp(-log((1 + targetRatio) / targetRatio) / rate);		// !! do NOT use 'expA()' !!
}

retrigRatio(rise, fall)
{
	rRmin	=  minimum(rise, fall);
	rRmax	=  maximum(rise, fall);
	tRratio	= (rRmax / rRmin) * 0.5;
	return	   fall * tRratio;
}

History	delayCount(0), hold1Count(0), sustainCount(0), hold2Count(0);
History	env(0), state(0), targetRatioRise(0.3), targetRatioFall(0.05);

Param	riseratio(0.3,	min=0.000001, max=10);	// very logarithmic .. almost linear	// minimum -120 dB
Param	fallratio(0.05,	min=0.000001, max=10);	// very exponential .. almost linear	// minimum -120 dB

History	valAtTrigger(1), prev_val(0);
History	attackCoeff(0), attackBase(0), decayCoeff(0), decayBase(0), releaseCoeff(0), releaseBase(0);
History	computeFalls(0), prev_rR(0), prev_fR(0), prev_susL(-1), prev_attRate(-1), prev_decRate(-1), prev_relRate(-1);

Param	zerophase(0, min=0, max=1);				// sync env param changes to env start (1) or free (0)
Param	constantrate(1, min=0, max=1);			// flag 0/1, env segments by time or by rate

Param	envmax(127, min=1);						// default maximum is 'velocity', but could be anything
Param	velocitysense(0, min=0, max=1);			// velocity sensitivity 0..1 % ('envmax' only used if this > 0)
Param	velocitycurve(1, min=-2, max=2);		// velocity in curve, pos=log, 0=lin, neg=exp

Param	retrigger(5, min=0, max=1000);			// fade to 0 in x ms if reattacking active envelope
Param	legato(0, min=0, max=1);				// start from current value if reattacking active envelope
Param	wait(0, min=0, max=1);					// wait until envelope 0 before allowing reattack of active envelope

Param	maxsustain(-1, min=-1, max=60000);		// like [adsr~] (-1 = none, else x ms length even if gate still on)
Param	loopsustain(100, min=0, max=60000);		// > 0 add fake x ms sustain portion to looping envelope ?
Param	looptrigger(0, min=0, max=1);			// loop mode needs triggering (1) or triggers itself (0) ? 
Param	loop(0, min=0, max=1);					// loop envelope off / on

Param	timebase(1, min=0, max=1);				// 1 = inlets in ms, 0 = inlets in samples
Param	sustainbase(0, min=0, max=1);			// 1 = inlet in dB, 0 = inlet in % 0..1 (amplitude)

sB		= int(sustainbase);		tB		= int(timebase);
lP		= int(loop);			lpTrig	= int(looptrigger);
wT		= int(wait);			lG		= int(legato);
velCvre	= int(velocitycurve);	constR	= int(constantrate);	zrphse	= int(zerophase);

// parse input triggers

value				=	maximum(in1, 0);		// anything > 0 (amplitude, velocity, pitch, whatever)
gate				=	value > 0;				// make 'gate' (1/0 gate on/off)
trg0				=	delta(gate) > 0;		// rising edge from 0 (gate-on 'click'-impulse)
klick				= -(value) + prev_val;		// make trigger impulses
trgU				=	klick < 0;				// from zero or any upwards change
trgD				=	klick > 0;				// to zero or any downwards change
trgUD				=	trgU  + trgD;			// either from zero or to zero or any upwards or downwards changes
prev_val			=	value;					// update

// parse parameters

lP					= lpTrig ? (latch(lP, trg0)) : lP;					// loop needs trigger or triggers itself ?
lG					= lG * (1 - wT);									// if wait on, legato & retrigger off
retrigRate			= mstosamps(retrigger);								// in ms (to samps) ...
doRetrig			= ((retrigRate >= 0) && (env > 0) && (trgUD)) * (1 - lG);// if wait or legato on, retrigger off

// parse inlets

sustainLevel		=			in6;
if (sB) {
	sustainLevel	= dbtoaApprox(sustainLevel);// in dB (to A)		// (actually to percentage of attack 0..1)
	sustainLevel	= (sustainLevel < 0.000223) ? 0 : sustainLevel;	// <= -80 dB @ 'dbtoaApprox()'	// fucking stupid
}
sustainLevel		= clip(sustainLevel, 0, 1);	// in percentage of attack 'velocity' 0..1 (effectively amplitude)

delayTime			= 			in2;			// in samps ? ...
hold1Time			= 			in4;
attackRate			= 			in3;
decayRate			= 			in5;
hold2Time			=			in7;
releaseRate			= 			in8;
if (tB) {
	delayTime		= mstosamps(delayTime);		// in ms (to samps) (default) ...
	hold1Time		= mstosamps(hold1Time);
	attackRate		= mstosamps(attackRate);
	decayRate		= mstosamps(decayRate);
	hold2Time		= mstosamps(hold2Time);
	releaseRate		= mstosamps(releaseRate);
}
delayTime			= maximum(	delayTime,	0);
hold1Time			= maximum(	hold1Time,	0);
hold2Time			= maximum(	hold2Time,	0);

delActive			= delayTime > 0;
h1Active			= hold1Time > 0;
h2Active			= hold2Time > 0;

isDelayed			= delayCount < delayTime;	// counting...
isHeld1				= hold1Count < hold1Time;	// ...
isHeld2				= hold2Count < hold2Time;	// ...

// update inlets on changes as needed

if ((riseratio != prev_rR) || (attackRate != prev_attRate)) {
	targetRatioRise	=  riseratio;				// (clipped to -120 dB by Param declaration)
	attackCoeff		=  calcCoeff(attackRate, targetRatioRise);
	attackBase		= (1 + targetRatioRise) * (1 - attackCoeff);
}

attackCoeff			=  zrphse ? latch(attackCoeff, trgUD) : attackCoeff;
attackBase			=  zrphse ? latch(attackBase, trgUD) : attackBase;

if ((fallratio != prev_fR) || (sustainLevel != prev_susL)) {
	targetRatioFall	=  fallratio;				// (clipped to -120 dB by Param declaration)
	computeFalls	=  1;
}

if ((computeFalls) || (decayRate != prev_decRate)) {
	decayCoeff		=  calcCoeff(decayRate, targetRatioFall);
	decayBase		= (sustainLevel - targetRatioFall) * (1 - decayCoeff);
}

decayCoeff			=  zrphse ? latch(decayCoeff, trgUD) : decayCoeff;
decayBase			=  zrphse ? latch(decayBase, trgUD) : decayBase;

if ((computeFalls) || (releaseRate != prev_relRate)) {
	releaseCoeff	=  calcCoeff(releaseRate, targetRatioFall);
	releaseBase		= -targetRatioFall * (1 - releaseCoeff);
}

releaseCoeff		=  zrphse ? latch(releaseCoeff, trgUD) : releaseCoeff;
releaseBase			=  zrphse ? latch(releaseBase, trgUD) : releaseBase;

// trigger envelope

if (((trgUD) && (gate)) || ((lP) && (env == 0))) {
	// if not 'wait'-ing, or already back at 0, allow attack
	if ((env == 0) || (!wT)) {	
		if ((env == 0) || (lG)) {									//	new env or loop or legato cases
			valAtTrigger	=  value;	//	store input
			computeFalls	=  0;		//	reset when triggered
			delayCount		=  0;		//  reset delay
			hold1Count		=  0;		//  reset hold1
			hold2Count		=  0;		//  reset hold2
			state			=  1 + (1 - delActive);	//  goto env_delay or env_attack (start of env)
		} else if (doRetrig) {										//	retrigger case
			valAtTrigger	=  value;	//	clear gate
			delayCount		=  0;		//  reset delay
			hold1Count		=  0;		//  reset hold1
			hold2Count		=  0;		//  reset hold2
			computeFalls	=  0;		//	reset when triggered
			state			=  8;		//  goto env_retrigger		//	force end of env
		}
	}
}

// !! 'env' is always processed as normalised 0..1, scaled to value (and optionally 'velocity') after processing

active		= env > 0;

// process (switch state)

if		    (state == 1) {						// env_delay
	delayCount += 1;
	if ((gate == 0) && (!lP)) {
		state = active ? 7 : 0;	//	jumpto env_idle or env_release (aborting inside delay stage cancels envelope)
		delayCount = 0;
	} else if (isDelayed) {
		env		= env;
	} else {
		state	= 2;			//	goto env_attack
		delayCount = 0;
	}

} else if	(state == 2) {						// env_attack
	env	= attackBase + env * attackCoeff;
	if ((gate == 0) && (!lP)) {
		state	= 7 - h2Active;	//	jumpto env_hold_2 or env_release
	} else if (env >= 1) {
 		env		= 1;
		state	= 4 - h1Active;	//	goto env_hold_1 or env_decay
	}

} else if	(state == 3) {						// env_hold_1
	hold1Count  += 1;
	if ((gate == 0) && (!lP)) {
		state	= 7 - h2Active;	//	jumpto env_hold_2 or env_release
		hold1Count = 0;
	} else if (isHeld1) {
		env		= env;
	} else {
		state	= 4;			//	goto env_decay
		hold1Count = 0;
	}

} else if	(state == 4) {						// env_decay
 	env	= decayBase + env * decayCoeff;
	if ((gate == 0) && (!lP)) {
		state	= 7 - h2Active;	//	jumpto env_hold_2 or env_release
	} else if (env <= sustainLevel) {
 		env		= sustainLevel;
		state	= 5;			//	goto env_sustain
	}

} else if	(state == 5) {						// env_sustain
	env	= sustainLevel;
	sustainTime = 0;
	if ((maxsustain  >= 0) || lP) {								// 'mSus' or lP
		sustainTime   = lP ? mstosamps(loopsustain) : mstosamps(maxsustain);
		sustainCount += 1;
		if (sustainCount < maximum(sustainTime, 0)) {			// 'isSustained'
			env	= sustainLevel;
		} else if (gate == 0) {
			state = 7;			//	jumpto env_release (ignore env_hold_2)
			sustainCount = 0;
		}
	} else {
		env	= sustainLevel;
		if (gate == 0) {
			state = 7 - h2Active;//	jumpto env_hold_2 or env_release
			sustainCount = 0;
		}
	}

} else if	(state == 6) {						// env_hold_2 (gate is already 0)
	env	= env;									// will hold value from whichever segment it comes from
	hold2Count  += 1;
	if (lP) {									// ignore in loop mode ('loopsustain' instead)
		state	= 7;			//	jumpto env_release
		hold2Count = 0;
	} else if (isHeld2) {
		env		= env;
	} else {
		state	= 7;			//	goto env_release
		hold2Count = 0;
	}

} else if	(state == 7) {						// env_release
	env = releaseBase + env * releaseCoeff;
	if (env <= 0) {
		env		= 0;
		state	= 0;			//	goto env_idle
	}

} else if	(state == 8) {						// env_retrigger (treat as segment for sync possibilities)
	rTrigBase	= 0;
	rTrigCoeff	= 0;
	if (retrigger > 10) {		// if retrigger time is greater than 10 ms, make RC-style curve, else linear
		// targetRatioFall same as decay & release, tRFmul difference
		tRFmul		=  retrigRatio(targetRatioRise, targetRatioFall);
		rTrigCoeff	=  calcCoeff(retrigRate, tRFmul);
		rTrigBase	= -tRFmul * (1 - rTrigCoeff);
	} else {
		rTrigCoeff	=  1 / retrigRate;
		rTrigBase	=  0;
	}
	env			= rTrigBase + env * rTrigCoeff;
	if (env <= 0) {
		env		= 0;
		state	= 1 + (1 - delActive);//  goto env_delay or env_attack (start of env)
	}

} else {	//	(state == 0)					// env_idle
	env				= 0;
	valAtTrigger	= (lP || lG) ? valAtTrigger : 1;

}

// scale envelope

scalar			= valAtTrigger;
if (velocitysense > 0) {						//  optional velocity sensitivity (default 1 == full & like [adsr~])
	envnorm		= 1;							// 'envnorm = 1' assumes normalised 0..1 input behaviour
	if (valAtTrigger > 1)						//  if value > 1, assume non-normalised behaviour & refer to 'envmax'
		envnorm	= envmax;						// 'envmax' default = 127 (assumes 'velocity' but can be anything)
	scalar		= simpleScale((valAtTrigger / envnorm), (1 - velocitysense),	velCvre);	//	log	|| lin	||	exp
}												//								velCvre:		pos	||	0	||	neg
env				= env * scalar;					//  env 0..1 by default scaled by it's input value (like [adsr~])

// outlets

out1			= env;							//	DAHDSHR envelope 0..value..0
out2			= gate;							//	new env trigger 1/0
out3			= active == 0;					//  mute 1/0
out4			= state;						//	segment # 0, 1, 2, 3, 4, 5, 6, 7, 8, 0

// updates

prev_rR			= riseratio;
prev_fR			= fallratio;
prev_attRate	= attackRate;
prev_decRate	= decayRate;
prev_relRate	= releaseRate;
prev_susL		= sustainLevel;

