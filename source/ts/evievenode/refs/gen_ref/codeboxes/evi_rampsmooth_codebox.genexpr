
// like MSP [rampsmooth~] if fed by signals at ramp inlets, exact destination
// original port by Maurizio Giri, Graham Wakefield
eviRampsmooth(input, frampup, frampdown)		// input, up in samples, down in samples
{
	History init(1);
	History value(0), prev(-999999), stepcounter(0), increment(1);
	rampup = trunc(frampup);	// pete: fixes bug in gen~ examples folder version
	rampdown = trunc(frampdown);
	notify = 1;

	// reset ramp if input has changed, NOT if ramp parameters change (& !init)
	if ((input != prev) && (!init)) {
		direction = (input - value);
		if (direction > 0) {
			stepcounter = rampup;
			increment = direction / rampup;
		} else {
			stepcounter = rampdown;
			increment = direction / rampdown;
		}
		prev = input;	
	}

	// keep incrementing until stepcounter counts down to zero
	if (stepcounter) {
		value += increment;
		stepcounter -= 1;		// pete: i feel like this is actually the correct ordering
		notify = init;
	} else {
		value = input;
		notify = 1 - init;	    // pete: this is lazy, should separate (or merge) up/down
	}

    init = 0;
	return value, notify;
}

out1, out2 = eviRampsmooth(in1, in2, in3);

// @see also: eviRampsmoothUpdate()