
require("evi_biquad.genexpr");

/*
    0   eviBiquadCoeffLowshelfMSP           cutoff, gain, Q     (default)
    1   eviBiquadCoeffLowshelfCookbook      cutoff, gain, Q
    2   eviBiquadCoeffLowshelfAnalog1       cutoff, gain, Q
    3   eviBiquadCoeffLowshelfAnalog2       cutoff, gain
*/
Param   filter(0, min=0, max=3);
filt    = int(filter);
reset   = delta(change(filt)) < 0;

a0, a1, a2, b1, b2  = 0;
if (filt == 1) {
    a0, a1, a2, b1, b2  = eviBiquadCoeffLowshelfCookbook(in2, dbtoa(in3), in4);
}
else if (filt == 2) {
    a0, a1, a2, b1, b2  = eviBiquadCoeffLowshelfAnalog1(in2, dbtoa(in3), in4);
}
else if (filt == 3) {
    a0, a1, a2, b1, b2  = eviBiquadCoeffLowshelfAnalog2(in2, dbtoa(in3));
}
else {
    a0, a1, a2, b1, b2  = eviBiquadCoeffLowshelfMSP(in2, dbtoa(in3), in4);
}

out1    = biquadDf2reset(in1, a0, a1, a2, b1, b2, reset);

