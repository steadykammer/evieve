
//	//	//	evi_sustainverb_lite.gendsp
//	//	//	4 line feeback delay network after Miller Puckette (@see: rev2.pd), BSD
//	//	//	by pete for evieve, with extras
//	//	//	for a much better reverb, see the big sister evi_sustainverb.gendsp (16x16 network)


//	//	//	library

require("evi_reverb_library.genexpr");


//	//	//	declare

// constants in samples from external javascript, defaults are for 48kHz samplerate
Param	earlyTime1 	(	3612,	min=1, max=14449	);
Param	earlyTime2 	(	2090,	min=1, max=8359		);
Param	earlyTime3 	(	1238,	min=1, max=4953		);
Param	earlyTime4 	(	931,	min=1, max=3723		);
Param	earlyTime5 	(	785,	min=1, max=3142		);
Param	earlyTime6 	(	655,	min=1, max=2620		);

Delay	early1		(	earlyTime1,		feedback=0	);
Delay	early2		(	earlyTime2,		feedback=0	);
Delay	early3		(	earlyTime3,		feedback=0	);
Delay	early4		(	earlyTime4,		feedback=0	);
Delay	early5		(	earlyTime5,		feedback=0	);
Delay	early6		(	earlyTime6,		feedback=0	);

// Miller Puckette's tuning:
Param	delayTime1 	(	2815,	min=1, max=16536	);
Param	delayTime2 	(	3333,	min=1, max=16536	);
Param	delayTime3 	(	3577,	min=1, max=16536	);
Param	delayTime4 	(	4134,	min=1, max=16536	);

Delay	fdnDelay1	(	delayTime1+1,	feedback=1	);
Delay	fdnDelay2	(	delayTime2+1,	feedback=1	);
Delay	fdnDelay3	(	delayTime3+1,	feedback=1	);
Delay	fdnDelay4	(	delayTime4+1,	feedback=1	);

// global controls
Param	smoothtime(22.666, min=0, max=300);	// ms
// reverb controls
Param	early(sqrt1_2, min=0, max=1);		// % 0..1 ( OR 0/1 )
Param	late(0.803554, min=0, max=1);		// % 0..1
// damping controls
Param	crossover(3000, min=500, max=15000);// Hz
Param	damp(0.1, min=0, max=1);			// % 0..1
// mixing controls
Param	fdnsum(0, min=0, max=1);			// % 0..1 ( OR 0/1 )
Param	drywet(0.8666, min=0, max=1);		// % 0..1


//	//	//	parse param rate

smoothsecs	= smoothtime * 0.001;
smoothsamps	= smoothsecs * samplerate;

inv_early	= 1 - early;
fb_0		= sqrt(late) * 0.5;				// this is correct

// pete: is this really ...2 and not ...0 ?
G, K		= rcDampCoeffs2(crossover, ((1 - damp) - 1));


//	//	//	parse audio rate

//earlymix, fdnmix	= multiLine2(inv_early, fdnsum, smoothsamps);
earlymix			= eviLine(inv_early, smoothsamps);
fdnmix				= eviLine(fdnsum, smoothsamps);
fb0					= logsmooth(fb_0, smoothsecs);
xover, damp00		= expsmoothBank2(G, K, smoothsecs);
damp01				= damp00 * 0.804199;	// a bit funky
mix					= eviLine(drywet, samplerate*0.333333);


//	//	//	processing		(static & integer delay times so no interpolation)

xL		= in1+0;
xR		= in2+0;

// (earlymix) additional early reflections...

early1.write	(	xR			);
e1r	= early1.read(earlyTime1, interp="none");
ep1	= xL  + e1r;
early2.write	(	xL  - e1r	);

// cpu management not that important as whole sustainverb is very cheap?
//if (mix > 0) {	//	//	//	begin :: CPU mute if mix @ 0 %

e2r	= early2.read(earlyTime2, interp="none");
ep2	= ep1 + e2r;
early3.write	(	ep1 - e2r	);
e3r	= early3.read(earlyTime3, interp="none");
ep3	= ep2 + e3r;
early4.write	(	ep2 - e3r	);
e4r	= early4.read(earlyTime4, interp="none");
ep4	= ep3 + e4r;
early5.write	(	ep3 - e4r	);
e5r	= early5.read(earlyTime5, interp="none");
ep5	= ep4 + e5r;
early6.write	(	ep4 - e5r	);
e6r	= early6.read(earlyTime6, interp="none");
	
tapIn1	= interp(	earlymix,	ep5 * 0.251189,		xL,		mode="linear");
tapIn2	= interp(	earlymix,	e6r * 0.251189,		xR,		mode="linear");

// input conditioning and damping to fdn...

// high or low pass if damp0 == 1, bypass if damp0 == 0, else low or high shelf attenuation
damp1	= rcFilterDamp(	fdnDelay1.read(delayTime1,	interp="none"),		xover,	damp00);
damp2	= rcFilterDamp(	fdnDelay2.read(delayTime2,	interp="none"),		xover,	damp00);
damp3	= rcFilterDamp(	fdnDelay3.read(delayTime3,	interp="none"),		xover,	damp01);
damp4	= rcFilterDamp(	fdnDelay4.read(delayTime4,	interp="none"),		xover,	damp01);

// fdn read...

fb1		= tapIn1	+	(damp1	* fb0);
fb2		= tapIn2	+	(damp2	* fb0);
fb3		=				 damp3	* fb0 ;
fb4		=				 damp4	* fb0 ;

// fdn matrix...

dx1, dx2, dx3, dx4	= butterflyMatrix(fb1, fb2, fb3, fb4);

// taps...

tapOut1	= dcblock(fb1 * 0.177828);
tapOut2	= dcblock(fb2 * 0.177828);
tapOut3	= dcblock(fb3 * 0.251189);
tapOut4	= dcblock(fb4 * 0.251189);

// main taps...

// should be butterfly tap ??
fdnL	= interp(	fdnmix,		tapOut1,	((tapOut1 + tapOut2) * 0.501187),	mode="linear");
fdnR	= interp(	fdnmix,		tapOut3,	((tapOut3 + tapOut4) * 0.501187),	mode="linear");

// add dry/wet...

rvrbL, rvrbR	= xfadeQuartApproxStereo(xL, xR, fdnL, fdnR, mix);


//}	//	//	//	end :: CPU mute if mix @ 0 %


// fdn write (update delay lines)...

fdnDelay1.write		(	fixdenorm(dx1)		);
fdnDelay2.write		(	fixdenorm(dx2)		);
fdnDelay3.write		(	fixdenorm(dx3)		);
fdnDelay4.write		(	fixdenorm(dx4)		);

// outputs...

out1	= rvrbL;
out2	= rvrbR;

out3	= fdnL;
out4	= fdnR;

out5	= tapOut1;
out6	= tapOut2;
out7	= tapOut3;
out8	= tapOut4;

