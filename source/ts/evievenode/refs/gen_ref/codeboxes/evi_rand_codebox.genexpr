
// like [rand~] (linear)
// very predictable and gives exact notches
eviRand(p) {								// phasor input, not frequency
	History prev(0);
	rr = (delta(p)) < 0;                    // assumes positive freq only
	a  = latch(prev, rr);
	n  = noise();
	b  = latch(n, rr);
	nv = mix(a, b, p);
    nw = interp(p, a, b, mode="cosine");    // additional cosine output
	prev = b;
	return nv, nw, n;
}

out1, out2, out3 = eviRand(phasor(in1));

