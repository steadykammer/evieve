	w		= ln1;

	// Haley's method (section 4.2 of the paper)
	for (i = 0; i < loop; i += 1) {
//		expw	= expApprox(w);
		expw	= exp(w);       // :-(
        w1      = w + 1;

		p		= (w * expw) - x;
		r		= w1 * expw;
		s		= (w + 2) / (w1 + w1);
