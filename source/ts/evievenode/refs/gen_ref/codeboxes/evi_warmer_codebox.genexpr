/*
	I made this for Andreas Wetterberg in 2013
	I updated it in 2021
	It is based on a Tom Szilagyi idea
*/

require("evi_warmer_lib.genexpr");

History med(0), prevmed(0), prevout(0);

// param rate

Param highpass(100., min=10, max=400);
Param order(3, min=0, max=8);
Param cutoff(samplerate*0.125, min=samplerate*0.00125, max=samplerate*0.25);
// turn off (0) if doing audio rate modulation of drive & blend:
Param smooth(30.111, min=0, max=301.11);// in ms

Param ingain(1., min=-48, max=48);
Param outgain(-1., min=-24, max=24);

Param drive(2., min=0, max=10);
Param blend(-2., min=-10, max=10);

Param bassslope(0.23228, min=0, max=1);
Param bassmix(0.333333, min=0, max=1);
Param bassgain(-1., min=-12, max=12);	// fold
Param bassboost(0, min=0, max=1);		// 0=soft, 1=hard
bb = int(bassboost);
ss = smooth > 0;
smoothsecs = smooth * 0.001;
ord = int(order);

bs = bassslope * 254 + 3;
bg = dbtoaApprox(bassgain);
ingn = dbtoaApprox(ingain);
outgn = dbtoaApprox(outgain);
hp = rcPreWarp1(highpass);

// audio rate

g = logsmooth(hp, smoothsecs);

drve = (drive * 0.99) + 0.1;
blnd = blend;
if (ss) {
	drve = logsmooth(drve, smoothsecs);
	blnd = eviLine(blnd, vectorsize*4);
}

// sadly this has to be audio rate because of zero crossings etc
srct, ap, kpa, kpb, an, kna, knb, pwrq = szilagyi(drve, blnd, samplerate);

bbev = eviSline(bb, mstosamps(smooth+100));
xinput = in1 * (1 - bbev);
if (bbev > 0) {
	s, g = expsmoothBank2(bs, bg, 0.015222);
	m = eviLine(bassmix, vectorsize*6);
	xinput = boost((in1 * bbev), s, m, g);
}

ing, outg = expsmoothBank2(ingn, outgn, 0.022666);

xin = dcblock(xinput * ing);
med = 0;
if (xin > 0) {
	med = (sD(ap + xin * (kpa - xin)) + kpb) * pwrq;    // sD() like D() but Adaa
} else {
	med = -((sD(an - xin * (kna + xin)) + knb) * pwrq);
}
med = dcblock(med);

yy = maximum((srct * (med - prevmed + prevout)), -1);
X = saturateAdaa2_4x_6POINT(yy * outg, -0.9886, 1) * sqrt1_2;

X = rcFilterHp(X, g);

G = 0;
Y = 0;
// linear Butterworth
if (ord > 0) {
	CF	= logsmooth(cutoff, smooth);
	G	= fWarp(CF);						// get G coefficient if not bypassed
	if			(ord == 1) {
		Y	= lp1p(X,	G);
	} else if	(ord == 2) {
		Y	= lp2p(X,	G, 1.4142135623730951);
	} else if	(ord == 4) {
		y0	= lp2p(X,	G, 0.7653668647301797);
		Y	= lp2p(y0,	G, 1.8477590650225735);
	} else if	(ord == 5) {
		y0	= lp2p(X,	G, 0.6180339887498949);
		y1	= lp2p(y0,	G, 1.618033988749895);
		Y	= lp1p(y1,	G);
	} else if	(ord == 6) {
		y0	= lp2p(X,	G, 0.5176380902050419);
		y1	= lp2p(y0,	G, 1.4142135623730951);
		Y	= lp2p(y1,	G, 1.9318516525781366);
	} else if	(ord == 7) {
		y0	= lp2p(X,	G, 0.4450418679126289);
		y1	= lp2p(y0,	G, 1.2469796037174672);
		y2	= lp2p(y1,	G, 1.8019377358048383);
		Y	= lp1p(y2,	G);
	} else if	(ord == 8) {
		y0	= lp2p(X,	G, 0.39018064403225666);
		y1	= lp2p(y0,	G, 1.1111404660392046);
		y2	= lp2p(y1,	G, 1.6629392246050905);
		Y	= lp2p(y2,	G, 1.9615705608064609);
	} else {//	(ord == 3)					// default
		y0	= lp2p(X,	G, 1.0000000000000002);
		Y	= lp1p(y0,	G);
	}

} else {	//	(ord == 0)					// bypassed
	G	= 0.414226;
	Y	= X;
}

out1 = Y;

prevmed = fixdenorm(med);
prevout = fixdenorm(yy);

