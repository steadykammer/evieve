
// zero aliasing classic synth wave shapes, dsf-blit-like algo, sweep/modulation works with no noise, & very cheap :-)
// good for subtractive because we stay very bright right up to nyquist, but no hard sync :-(
// by pete for evieve, 2019

//require("evi_biquads_filters.genexpr");   // these two only needed if editing for options...
//require("evi_rcfilters.genexpr");
require("evi_smooth.genexpr");
require("evi_trig.genexpr");
require("evi_adaa.genexpr");                // for 'sine' only

// simple integrator

leaky(x, f)
{
	History	leak(0);
	y		= ((x - leak) * (f * 0.25)) + leak;
	leak	= y;
	return	y;
}

//	//	//	BLITs

eviSect(T, P, M)
{	// we get a tiny bit of noise below -100dB with sin73, switch to sin() if you care about this
	return	(sin73((T + 0.5) * P) * M) - 1;
}

// deluxe, a lot more expensive, but crossfades out the top harmonic - much nicer
eviBlit(Ph, Mt, Mf)
{
	Mp		= 1 / sin(0.5 * Ph);						// must be sin() for accuracy
	x0		= eviSect((maximum((Mt - 1), 0)), Ph, Mp);
	x1		= eviSect(Mt, Ph, Mp);
	return	interp(Mf*Mf, x0, x1, mode="cosine") * 0.5; // cosine but Mf is squared, ridiculous? i like it
}

//	//	//

History	thisReset(1), prevSR(0);//, Ff(0);
History sr05(0), sr01(0), srWN(0), omWN(0), MaxFreq(0);//, filterRolloff(0);

Param	smooth(22., min=0, max=333);			// ms
Param	addsync(1, min=0, max=2);				// out6: 0 = off, 1 = main phase output, 2 = pwm phase output
Param	addtrain(0, min=0, max=2);				// out5: 0 = off, 1 = train based on main phase, 2 = train based on pwm phase
Param	addsine(0, min=0, max=1);				// out4: 0 = SINE off, 1 = SINE on (considerable CPU management)
smoothsamps = mstosamps(smooth);
LAURA	= 1.059463094359;
JASON	= 2.221441469079183;
CPS_LIMIT	= 0.0001;

Hz			= in1;
Width		= in2;
naiveReset	= in3;								// <<-- do not use (does not work properly if freq really high anyway)
// we only need to update these values if SR changes (& on init)
if (prevSR != SAMPLERATE) {
	sr05 = SAMPLERATE * 0.5;
	sr01 = SAMPLERATE * 0.01;
	MaxFreq	= sr05 - sr01;                      // we want it to kick in a bit below nyquist
	srWN = sr01 / SAMPLERATE;
	omWN = 1 - (srWN + srWN);
//	filterRolloff = rcPreWarp2(MaxFreq);
	prevSR = SAMPLERATE;
}

// unlike pure DSF BLIT, we do not have to latch changes as rolloff/etc takes care of this for us
// but if no latching option, we should exact-smooth "F" (because trunc/fract) and exact-smooth "P" (because center)
F		= maximum(Hz, 0);						// Hz
if (smooth > 0) {
	F	= eviLine(F, smoothsamps);
}
Ff		= maximum(F / SAMPLERATE, CPS_LIMIT);	// Increment
Fn		= Ff * TWOPI;
P		= (Width * omWN) + srWN;				// 0..1, edges SR dependent	// NOTE: Width not clipped so wraps around if desired
Pp		= P;									// Pp = no smoothing
if (smooth > 0) {
	P	= eviLine(P, smoothsamps);
}

//filterZero = rcPreWarp1(76.1268 * Fn);

M		= abs((P + P) - 1);						// maintain energy in TRI, sort of...
Wt		= ((M * M * M * M) * 16) + 4;
Fa		= 2 - maximum(Fn, 1);

MFdF	= MaxFreq / F;
Mt		= trunc(MFdF);
Mf		= fract(MFdF);

Phase	= phasor(F, naiveReset);//naiveReset ? 0 : Phase + Ff;
PhW		= wrap((Phase + P), 0, 1);
Ph		= (Phase * TWOPI);
Pwm		= (PhW * TWOPI);
outPhase = 0;
outPh	 = latch(int(addsync), thisReset);
if (outPh > 0) {
	outPhase = (outPh - 1) ? PhW : Phase;
}
peteTrain	= 0;
trnPh		= latch(int(addtrain), thisReset);
if (trnPh > 0) {
	petePhase	= (trnPh - 1) ? PhW : Phase;
	peteTrain	= petePhase < latch(Pp, thisReset);
}

blit_1	= eviBlit(Ph, Mt, Mf);
blit_2	= eviBlit(Pwm, Mt, Mf);

blit_saw	= dcblock(blit_1);
blit_rect	= blit_1 - blit_2;

bottom		= minimum(F, 10) * 0.1;	// extend down to zero Hz, no DC
thisReset	= (delta(Phase) < 0) + (Ff <= CPS_LIMIT) + naiveReset;

// integrate...

// these are much nicer "straight lines" buzzy oscillators, but sadly we get
// the nightmare blit-dc-dropout problem using the direct forms with mul Fn externally

//SAW		= biquadTdf2(blit_saw, -0.331, 0, 0, -0.999, 0) * Fn;
//RECT		= biquadTdf2(blit_rect, 0.31, 0, 0, -0.9997, 0) * Fn;
//TRI		= biquadTdf2(RECT * 2, 0.397, 0, 0, -0.9997, 0) * Fn;

// so we just use the cheap leaky instead with Fn in the filter - these oscs are usable at least

SAW			= leaky(-blit_saw, Fn) * LAURA * bottom;
RECT		= leaky(blit_rect, Fn) * bottom;
TRI			= leaky((RECT * Wt) * Fa, Fn) * LAURA * bottom;

SINE		= 0;
adsn		= latch(int(addsine), thisReset);
if (adsn) {	// ...73 fine for accuracy here	// you think "leaky()" is wrong here, but it is not :-)
//	SINE	= adSc1(leaky(cos73(Ph), Fn) * JASON) * SQRT2 * bottom;
	SINE	= atanAdaa2(leaky(cos73(Ph), Fn) * JASON) * SQRT2 * bottom;
	// ^^ all sine variations work fine: cos73(Ph), cos73(Pwm), sin73(Ph), sin73(Pwm), just depends what you want (phase)
	// ^^ sadly, the SINE phase does not line up at exact zero crossings, regardless of which function or phase driver you use
//	SINE	= rcFilterHp(SINE, filterZero);	// leaves residual DC at bottom of bottom
}

// interesting weird SAW that also works...
//interestingPwmSAW	= leaky(SAW - blit_2, Fn) * LAURA * LAURA * bottom;
//interestingPwmSAW	= rcFilterHp(interestingPwmSAW, filterZero);	// leaves residual DC at bottom of bottom

//SAW	= rcFilter(SAW, filterRolloff);	    // some people might like it (but not needed with this algo)
//SAW	= rcFilterHp(SAW, filterZero);		// leaves residual DC at bottom of bottom

//RECT	= rcFilter(RECT, filterRolloff);	// some people might like it (but not needed with this algo)
//RECT	= rcFilterHp(RECT, filterZero);		// leaves residual DC at bottom of bottom

//TRI	= rcFilterHp(TRI, filterZero);		// leaves residual DC at bottom of bottom

out1	= SAW;
out2	= RECT;
out3	= TRI;
out4	= SINE;

out5	= peteTrain;						// Train is a rectified naive square 0/1 running at period, like [train] or [train~]
out6	= outPhase;							// ^^ needed for certain weird things, don't worry

