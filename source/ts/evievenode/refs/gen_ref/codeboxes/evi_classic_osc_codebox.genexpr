
require("evi_polyblep_utility.genexpr");
require("evi_polyblep_two.genexpr");

// this is here to avoid require hell
poly_half20(t, dt, pw)
{
	h	= 0;
	fdp	= 1.2732395447351628;		// 4 / PI
	t6	= (pw * 0.5 + t + 0.75) - pw;
	t7	= t6;
	t6	= wrap(t6, 0, 1);
	t77	= t7 - wrap(t7, 0, 1);
	if (t6 < pw) {
		h	= (sin73b(t6 / pw * PI) * 2) - pw * fdp;
	} else {
		h	= 0 - pw * fdp;
	}
	h2	= (poly_blamp(t7 - t77, dt) + poly_blamp(t6, dt)) / pw * PI * dt + h;
	return	h2;
}

classicOscSelect(phase, nrm, width, gain, type, wav)
{
    osc = 0;
    if (wav == 1) {            // tri
        if (type == 1) {
            pw = (width >= 0.5) ? width : width * 0.8 + 0.1;
            osc = poly_trip(phase, nrm, pw);
        }
        else {  // (type == 0)
            osc = poly_tri(phase, nrm);
        }
    }
    else if (wav == 2) {       // saw
        if (type == 1) {
            osc = morph_saw_tri_saw(phase, nrm, width);
        }
        else {  // (type == 0)  // default
            osc = poly_saw(phase, nrm);
        }
    }
    else if (wav == 3) {       // rect
        if (type == 1) {
            pwm = width * 0.9 + 0.05;
            osc = poly_rect(phase, nrm, pwm);
        }
        else {  // (type == 0)
            osc = poly_sqr(phase, nrm);
        }
    }
    else {  // (wav == 0)      // sine
        if (type == 1) {
            pwm = (width >= 0.5) ? width : width * 0.92 + 0.04;
            osc = poly_half20(phase, nrm, pwm);
        }
        else {  // (type == 0)
            osc = sin73b(phase * TWOPI);
        }
    }

    return osc * gain;
}

// only 4-point works for oscillators

// fixed 2x quasi downsampling 
classicOscSelect_2x_4POINT(phase, nrm, width, gain, type, wav)
{	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// process 2x
	y1_0	= classicOscSelect(phase, nrm, width, gain, type, wav);
	y2_0	= classicOscSelect(phase, nrm, width, gain, type, wav);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}

// fixed 4x quasi downsampling 
classicOscSelect_4x_4POINT(phase, nrm, width, gain, type, wav)
{	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// process 4x
	y1_0	= classicOscSelect_2x_4POINT(phase, nrm, width, gain, type, wav);
	y2_0	= classicOscSelect_2x_4POINT(phase, nrm, width, gain, type, wav);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}

// fixed 8x quasi downsampling 
classicOscSelect_8x_4POINT(phase, nrm, width, gain, type, wav)
{	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// process 8x
	y1_0	= classicOscSelect_4x_4POINT(phase, nrm, width, gain, type, wav);
	y2_0	= classicOscSelect_4x_4POINT(phase, nrm, width, gain, type, wav);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}

classicOscSelectOversample(phase, nrm, width, gain, type, wav, over)
{
    History ovdummy(0);
    osc = 0;
    if (over == 1) {
        osc = classicOscSelect_2x_4POINT(phase, nrm, width, gain, type, wav);
    }
    else if (over == 2) {
        osc = classicOscSelect_4x_4POINT(phase, nrm, width, gain, type, wav);
    }
    else if (over == 3) {
        osc = classicOscSelect_8x_4POINT(phase, nrm, width, gain, type, wav);
    }
    else {  // (over == 0)
        osc = classicOscSelect(phase, nrm, width, gain, type, wav);
    }
    return osc;
}


Param   oscillator(2, min=0, max=3);    // 0=sine, 1=tri, 2=saw, 3=rect
Param   type(0, min=0, max=1);          // 0=pure oscillators, 1=pulsewidth versions
// 2=(if using < 20Hz but < 4k), 3=(if using < 20Hz && > 4k)
Param   dc(1, min=0, max=3);			// 0=off, 1=on,	2=auto for lfos, 3=auto for oscillators
Param   compensate(1, min=0, max=2);    // decorrelation high frequency compensation filters, off/1/2
Param   oversample(1, min=0, max=3);	// fake oversampling, 0=1x, 1=2x, 2=4x, 3=8x

wav     = int(oscillator);
typ     = int(type);

dci		= int(dc);
filt	= int(compensate);
over	= int(oversample);

freqInHz	= in1;
pulseWidth	= in2;                      // if "type" == 1
syncPhase	= in3;                      // hard sync, NOT IMPLEMENTED YET

t			= 0;
if (change(syncPhase) != 0) {           // if a sync phasor is attached
	t		= syncPhase;
	if (t >= 0)
		t  -= trunc(t);
	else
		t  += 1 - trunc(t);
} else {
	t		= phasor(freqInHz);         // no naive reset here
}

dt			= freqInHz / SAMPLERATE;
dtn			= clip((dt + dt), 0, 1);
oscsync		= delta(t) < 0;
gain		= minimum(scale(clip(freqInHz, 0, 20), 1, 20, 0.9564, 0.5, 3), 0.9564) * (((1 - (filt * (freqInHz < 20))) * 0.157588) + 0.842412);
smoothsamps = mstosamps(33);
a, an		= evi_line(gain, smoothsamps);	// 0.5 for Oscillators, 1.0 for LFOs ... oder ?? (dynamic like dc)

ov			= latch(over,	oscsync);
wv			= latch(wav,	oscsync);
tp          = latch(typ,    oscsync);
dcn			= latch(dci,	oscsync);
ft			= latch(filt,	oscsync);

osc = 0;

if (freqInHz > (SAMPLERATE * 0.25)) {       // sine if above (samplerate / 4)
    osc	= sin73b(TWOPI * t);                 // or should be cos() here ?
}
else {
    osc = classicOscSelectOversample(t, dt, pulseWidth, a, tp, wv, ov);
}

// dcblock
osc = dynamicDc(osc, dtn, dcn);

// restore high frequencies options...
if (ft > 0) {
	osc = decorelateOsc(osc);      // for Bleps ?
	if (ft > 1) {
		osc = decorelateOsc(osc);  // for Blamps / Bluhs ?
	}
}

out1	= osc;
out2	= t;
out3	= oscsync;

