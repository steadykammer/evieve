
require("evi_biquads_coeffs");
require("evi_biquads_filters.genexpr");

/*
    0   eviBiquadCoeffLowpass                   cutoff, Q
    1   eviBiquadCoeffLowpassGain               cutoff, gain, Q    (default)
    2   eviBiquadCoeffLowpassAnalog1            cutoff, Q
    3   eviBiquadCoeffLowpassAnalog2            cutoff, Q
    4   eviBiquadCoeffButterworthLowpass        cutoff
    5   eviBiquadCoeffButterworthLowpassGain    cutoff, gain
*/
Param   filter(1, min=0, max=5);
filt    = int(filter);
reset   = delta(change(filt)) < 0;

a0, a1, a2, b1, b2  = 0;
if (filt == 1) {
    a0, a1, a2, b1, b2  = eviBiquadCoeffLowpassGain(in2, dbtoa(in3), in4);
}
else if (filt == 2) {
    a0, a1, a2, b1, b2  = eviBiquadCoeffLowpassAnalog1(in2, in4);
}
else if (filt == 3) {
    a0, a1, a2, b1, b2  = eviBiquadCoeffLowpassAnalog2(in2, in4);
}
else if (filt == 4) {
    a0, a1, a2, b1, b2  = eviBiquadCoeffButterworthLowpass(in2);
}
else if (filt == 5) {
    a0, a1, a2, b1, b2  = eviBiquadCoeffButterworthLowpassGain(in2, dbtoa(in3));
}
else {
    a0, a1, a2, b1, b2  = eviBiquadCoeffLowpass(in2, in4);
}

out1    = biquadDf2reset(in1, a0, a1, a2, b1, b2, reset);

