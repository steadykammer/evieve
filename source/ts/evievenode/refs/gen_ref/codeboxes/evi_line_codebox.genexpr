
// exact ramp smoothing, like MSP [line~]
// @see also: evi_sline, evi_curve, evi_rampsmooth, etc

// basic linear scaling like linear part of [scale]
lineMap(valueIn, inLow, inHigh, outLow, outHigh)
{
	multiplier = (outLow - outHigh) / (inLow - inHigh);
	return (valueIn - inLow) * multiplier + outLow;
}

eviLineAbs(target, duration)				// target, duration in samples
{
	History	value(0), init(1);
	trigger	= change(target);
	ramp	= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);
	line	= lineMap(ramp, 0, 1, latch((value + (target * init)), trigger), latch(target, trigger));
	value	= line;
    init    = 0;
	return	line, (ramp == 1);
}

out1, out2 = eviLineAbs(in1, in2);

