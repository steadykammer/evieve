
// Deluxe but dirty MS20-inspired old-school-style filter emulation,
// 12dB lowpass or 6dB highpass.
// Based on a classic by Tony Hardie-Bick ("DFM-1 Digital Filter Module"), 2010.
// Thanks to Jonny Stutters for his SuperCollider port, 2011.
// Dirty MSP/gen~ reworking by fat Pete, 2013 (thanks to Matt Jackson for the LUT assistance).
// LICENSE: GPLv2.

// @see: "evi_korgms10.gendsp", "evi_korgms20.gendsp" & "evi_korgms20_select.gendsp"
// for better (?) 'emulations' of the Korg MS-10 / MS-20 filter chips.


// // // lib

require("evi_dfm_lib.genexpr");


// // // declare

Buffer	dfm(); 								// alias to LUT[] (32-bit truncated values)

Param	filter(1, min=0, max=2);			// 0 == bypass, 1 == 12dB lowpass (default), 2 == 6dB highpass
Param	io(0, min=0, max=1);				// mono/dual-mono, true-stereo
Param	tune(0, min=-100, max=100);			// cutoff (mtofApprox()) tuning in cents around A == 440 Hz
Param	smooth(22.666, min=0, max=1000);	// coefs smooth in ms, 0 == (cpu)off, turn off for modulation
Param	gain(3, min=-6, max=14);			// input gain in dB, thb range, ! not resonance !
Param	noiselevel(0.333333, min=0, max=1);	// amplitude level of noise in filter, 0..1 remapped in code 0..0.1
Param	oversampling(1, min=0, max=2);		// 0 == 1x, 1 == 2x good (extends freq range), 2 == 4x bad do not use
Param	extend(0, min=0, max=1);			// a secret way for pete to do extra stuff


// // // setup

os		= int(oversampling);
inout	= int(io);
filt	= int(filter);
noisey	= (noiselevel * noiselevel * noiselevel) * 0.100001;	// default 0.333333 = amplitude 0.003704

input	= dbtoaApprox(gain);
tuning	= 440 * expA(0.057762265 * (((tune + 3450) / 50) - 69)) + 0.056317;

//MAX_OSC_FREQ	= 0.1640625;			// (maximum filter self-oscillation frequency == MAX_OSC_FREQ * samplerate)
OCTAVES			= 16;
STEPS			= 32;
MIN_LUT_FREQ	= 0.00000762939453;		// 1 / 131072
MAX_LUT_FREQ	= 0.5 - 1 / (STEPS * 4) - 0.001;
PG				= 0.70175438596491;		// 1 / (1 - 0.05) * 3 / 2

// find octave
oct				= 0;
octBaseFreq		= MIN_LUT_FREQ;
nextOctBaseFreq	= MIN_LUT_FREQ + MIN_LUT_FREQ;

roffset = eviScurve(extend) * 8.485284; // one_octave * sqrt1_2
retune  = (extend > 0) ? scale(roffset, 0, 12, 0, 12, 0.25) : 0;    // this is horrible, but...


// // // audio rate from here

xL			=	in1;
xR			=	in2;
cutoff		=	in3;			// in Pitch
resonance	=	sqrt(in4) * 1.1204 + roffset;

frequency	= mtofApprox(cutoff + retune, base=tuning);
freq		= clip((frequency / samplerate * (os == 1 ? 0.5 : 1)), MIN_LUT_FREQ, MAX_LUT_FREQ);

yL	= xL;
yR	= xR;
if (filt > 0) {					// cpu bypass if filter == 0


while (oct < OCTAVES) {
	if (freq < nextOctBaseFreq)
		break;
	octBaseFreq = nextOctBaseFreq;
	nextOctBaseFreq += nextOctBaseFreq;
	oct += 1;
}

pfs = 0;
pfss = 0;
res = resonance;
if (smooth > 0) {
	pfs			= smooth * 0.001;
	pfss		= pfs * samplerate;
	freq		= logsmooth(freq, pfs);
	res			= expsmooth(resonance, pfs);
}

// // // get coefficients via LUT

// find step, contains int and fract
octFreqSpan = octBaseFreq;		// (thb deliberately pedantic)
stp		= STEPS * (freq - octBaseFreq) / octFreqSpan;

// base index & interpolation
index	= trunc(stp);
fraction = stp - index;

// index to LUT
address	= trunc(3 * (index + oct * STEPS));
maddress = address + 3;

// look up
xa = peek(dfm,  address, 		boundmode="clamp", interp="none");
xb = peek(dfm, (address + 1), 	boundmode="clamp", interp="none");
xr = peek(dfm, (address + 2), 	boundmode="clamp", interp="none");
// lookup interp
mxa = peek(dfm,  maddress, 			boundmode="clamp", interp="none");
mxb = peek(dfm, (maddress + 1), 	boundmode="clamp", interp="none");
mxr = peek(dfm, (maddress + 2), 	boundmode="clamp", interp="none");

// multiply by 2 to bring lut entries back up to range (custom buffer~ table is divided by 2 for storage)
// and interp
a0	= interp(fraction, xa+xa, mxa+mxa, mode="linear");	// coef0
b0	= interp(fraction, xb+xb, mxb+mxb, mode="linear");	// coef1
r0	= interp(fraction, xr+xr, mxr+mxr, mode="linear");	// coef2


// // // make parameters

ifilt	= eviLine((maximum(filt, 1) - 1), 0.1175*samplerate);	// switch lowpass/highpass
pgain	= eviLine(((input * PG) * 0.501187), pfss);	// (input * (1 / (1 - 0.05) * 3 / 2)) * -6dB
lgain	= (pgain * (1 - ifilt)) * (1 - a0);			// LP gain conflated with 1st stage integrator gain
hgain	=  pgain * ifilt;

ros = 0;
if (os == 1) {
    // fade between os 1..2 = 6point (lowpass) or 4point (highpass) interpolation in the 2x oversampling
    ros = ifilt + 1;
} else if (os == 2) {
    // high level os == 2 actually passes on os == 3 to filter selector
    ros = 3;
} else {
    ros = 0;
}

l = lgain;
h = hgain;
a = a0;
b = b0;
r = r0 * res;
n = noisey;


// // // do filtering (depending on 'io', really stupid but it gets used)

	if			(inout == 1) {	// true stereo input & output
		yL	= dfts(xL, l, h, a, b, r, n, ros);
		yR	= dfts(xR, l, h, a, b, r, n, ros);
	} else {//	(inout == 0)	// mono in, (dual) mono out, DEFAULT
		yL	= dfts(xL, l, h, a, b, r, n, ros);
		yR	= yL;
	}


}	// END: cpu bypass if filter == 0


// // // outputs

out1	= yL;
out2	= yR;


// // // license

