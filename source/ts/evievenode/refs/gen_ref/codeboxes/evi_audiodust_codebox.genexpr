
// @see: "evi_velvetnoise.gendsp" for an alternative algorithm ("sparseNoise")

audioDust(freq)
{
	clockThresh	= 1 - (freq * (1 / (SAMPLERATE * 0.5)));
	Xoxhiro	    = noise();
	sync		= Xoxhiro > clockThresh;
	white	    = noise();

	dust		= sync * white;
	return		dust, white, sync;
}

out1, out2, out3	= audioDust(in1);

