
// -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- \\

// evi_plateverb.gendsp

// "yafr2" from MSP
// "Plate reverb, in the style of Griesinger", by Randy Jones

// This version by Pete for evieve, with dry/wet and eq added, as well 
// as modifications for better filtering, interpolation, smoothing, etc

// This version is quite expensive and therefore not so useful
// Use the "Lite" version (evi_plateverb_lite.gendsp) with no zero hold delay changes 
// if you are not going to be making realtime changes to the "size" and "diffuse" parameters

// -- -- -- -- -- -- -- -- -- --	functions (library)	-- -- -- -- -- -- -- -- -- -- -- -- -- \\

require("evi_reverb_library.genexpr");


// -------	declare

// reverb
Param	size(0.3, min=0, max=1);
Param	decay(0.6, min=0, max=1);
Param	diffuse(0.3, min=0, max=1);
// damp (compute coefficients externally in gen no tilde)
Param	damp(0.67682, min=0, max=1);		// pre-warped frequency (a 0..1) (default 6593Hz @48kHz)
// eq (compute coefficients externally in gen no tilde)
Param	highshelfG(0.123758, min=0, max=1);	// pre-warped frequency (g / (1 + g)) (default 2000Hz @48kHz)
Param	highshelfK(0., min=-3, max=1);		// -3=shelfboost..0=bypass..shelf..1=pass
Param	lowshelfG(0.032214, min=0, max=1);	// pre-warped frequency (g / (1 + g)) (default 500Hz @48kHz)
Param	lowshelfK(0., min=-3, max=1);		// -3=shelfboost..0=bypass..shelf..1=pass
// mix
Param	wet(-3., min=-90, max=0);							// wet '0' dB & dry '-90' dB...
Param	dry(-15., min=-90, max=0);							// ...= 'yafr2' default (no dry)
Param	pan(0.5, min=0, max=1);								// pan for DRY signal in MONO mode
Param	stereo(0, min=0, max=2);							// input is mono / stereo / 2-chans ?
Param	bypass(0, min=0, max=1);							// also cpu-off, but no reset in gen~ !!

History	dryL(0), dryR(0);									// compensate dry

Delay	tapsL(samplerate*0.26636, 1, feedback=1);			// loops, ± modulation time
Delay	tapsR(samplerate*0.25995, 1, feedback=1);
/*
// old hack
Param	delayTime1(12786, min=1, max=51142);				// defaults for 48kHz
Param	delayTime2(12479, min=1, max=49911);
Delay	tapsL(delayTime1, 1, feedback=1);
Delay	tapsR(delayTime2, 1, feedback=1);
*/

// constants, not user

Param	SUMMUL		(  0.14285714285714285, min=0, max=1);	// 1/7
Param	SUMMULINV	(  0.8571428571428572,  min=0, max=1);	// 1 - SUMMUL;
Param	SUMMUL05	(  0.07142857142857142, min=0, max=1);	// 0.5 * SUMMUL
Param	SUMMULSQ	(  0.3779644730092272,  min=0, max=1);	// 1/sqrt(7)

Param	APGAIN1		(  0.75,	min= 0, max= 1);
Param	APGAIN2		(  0.625,	min= 0, max= 1);
Param	APGAIN3		( -sqrt1_2,	min=-1, max= 1);
Param	APGAIN4		(  0.5,		min= 0, max= 1);

// smooth

Param	smoothtime(49., min=1, max=500);// ms
smoothsecs	= smoothtime * 0.001;		// secs
smoothsamps	= smoothsecs * samplerate;	// samps


// -------	fixed constants

SRATE		=  samplerate + 0;

apTime1		=  0.00476 * SRATE;
apTime2		=  0.00358 * SRATE;
apTime3		=  0.01273 * SRATE;
apTime4		=  0.00930 * SRATE;


// -------	parse (param rate)

modDepth	= 0.033;					// in seconds; yafr2 has this at 20 miliiseconds

sizescale	= (size * 1.59) + 0.01;
sizediff	=  sizescale * diffuse;
decayscale	= (decay * SUMMULINV) + SUMMUL05;

wetAmp		= (wet > -90) ? dbtoaApprox(wet) : 0;
dryAmp		= (dry > -90) ? dbtoaApprox(dry) : 0;
panscale	= (pan * 0.75) + 0.125;

// iStereo ('stereo' param): 0 = mono (L) input / 1 = stereo (L/R) source / 2 = uncorrelated 2-channels
iStereo		=  int(stereo);
stereoMul	= (iStereo == 2) ? sqrt1_2 : 0.5;		// !! not smoothed !!


// -------	times dynamic (param rate)

LtimeMul2	= sizescale * (0.14960 * SRATE);		// will add modL in samples...
RtimeMul2	= sizescale * (0.14170 * SRATE);		// will add modR in samples...

CtimeMul1L	= sizediff 	* (0.110   * SRATE);
CtimeMul2L	= sizediff 	* (0.160   * SRATE);
CtimeMul3L	= sizediff  * (0.050   * SRATE);
CtimeMul4L	= sizediff  * (0.025   * SRATE);
CtimeMul5L	= sizediff  * (0.069   * SRATE);
CtimeMul6L	= sizediff  * (0.080   * SRATE);
CtimeMul7L	= sizediff  * (0.075   * SRATE);

CtimeMul1R	= sizediff 	* (0.110   * SRATE);
CtimeMul2R	= sizediff 	* (0.135   * SRATE);
CtimeMul3R	= sizediff  * (0.055   * SRATE);
CtimeMul4R	= sizediff  * (0.003   * SRATE);
CtimeMul5R	= sizediff  * (0.035   * SRATE);
CtimeMul6R	= sizediff  * (0.027   * SRATE);
CtimeMul7R	= sizediff  * (0.052   * SRATE);


// -------	inputs / outputs (audio rate from here)

x0  = 0;
//xN	= 0;
if (iStereo >  0) {
	x0		= (in1 + in2) * stereoMul;				// !! stereoMul not smoothed !!
	dryL	=  in1;									// compensate
	dryR	=  in2;
} else {
	dryPan		=  eviLine(panscale, smoothsamps);
	cosL, sinR	=  quartParOneApprox(dryPan);
	x0		=  in1;
//	xN		=  in2;
	dryL	=  in1 * cosL;							// & compensate
	dryR	=  in1 * sinR;
}

rvrbL		=  dryL;
rvrbR		=  dryR;
dryLmix		=  dryL;
dryRmix		=  dryR;


// -------	bypass (smooth and cpu)

iBypass		= int(bypass);
passSmooth	= iBypass ? 0.333 : 0.666;
PASS		= eviLine(iBypass, passSmooth*samplerate);
iPass		= 1 - PASS;

if (PASS < 1) {


// -------	smoothing (audio rate)

// technically can get away without the cost of smoothing 'decayscale' & 'damp', but not ideal
damping, decMulL	= logsmoothBank2(damp, decayscale, smoothsecs);
decMulR	= decMulL;

wetMix, dryMix	= logsmoothBank2(wetAmp, dryAmp, smoothsecs);
wetMix			= wetMix * SUMMUL * iPass;
dryAtten		= dryMix * SUMMULSQ * iPass;

eqHighK				= eviLine(highshelfK, smoothsamps);
eqLowK				= eviLine(lowshelfK, smoothsamps);
eqHighG, eqLowG		= logsmoothBank2(highshelfG, lowshelfG, smoothsecs);

// the problem with this reverb algo / the decision to make:
// firstly, sounds shit for this reverb doing big smooths here <<-- i did this for taps
// secondly, should smooth 'size' and 'diffuse' and pass on, or do 22 smoothers at end of calcs ??
// thirdly, expensively zero hold delay changes with double bufffers <<-- i did this for diffusion

sizemul		=  eviSline(sizescale, smoothsamps);


// -------	times dynamic (smoothed)

LtimeMul1	=  sizemul * (0.02258 * SRATE);
LtimeMul3	=  sizemul * (0.06048 * SRATE);
LtimeMul4	=  sizemul * (0.12500 * SRATE);

RtimeMul1	=  sizemul * (0.03051 * SRATE);
RtimeMul3	=  sizemul * (0.08924 * SRATE);
RtimeMul4	=  sizemul * (0.10628 * SRATE);


// -------	dry mixes	(do pan shit here too ?) (cosL, sinR)

dryLmix		=  dryL * dryMix;
dryRmix		=  dryR * dryMix;
dryLatten	=  dryL * dryAtten;
dryRatten	=  dryR * dryAtten;


// -------	early

// input bandwidth (damp)
x1	= poleZeroDamp((x0 * iPass),	damping);

// early reflect (static)
x1	= fffbAllpassShort(x1,	APGAIN1,	apTime1);
x1	= fffbAllpassShort(x1,	APGAIN1,	apTime2);
x1	= fffbAllpassShort(x1,	APGAIN2,	apTime3);
x1	= fffbAllpassShort(x1,	APGAIN2,	apTime4);


// -------	taps

// taps left
tap4L	= tapsL.read(LtimeMul4,	interp="spline");
tap1L	= fffbAllpassLong((x1 + tap4L),			APGAIN3,		LtimeMul1);
tap2L	= delayReadZero1mod(tap1L, LtimeMul2,	smoothsamps,	(modDepth - 0.00602));// + modulation (L)
dampL	= poleZeroDamp((tap2L + dryRatten),		damping);					// + inject partial dry (R)
tap3L	= fffbAllpassLong((dampL * decMulL),	APGAIN4,		LtimeMul3);
tapsL.write(tap3L);

// taps right
tap4R	= tapsR.read(RtimeMul4,	interp="spline");
tap1R	= fffbAllpassLong((x1 + tap4R),			APGAIN3,		RtimeMul1);
tap2R	= delayReadZero1mod(tap1R, RtimeMul2,	smoothsamps,	(modDepth + 0.00021));// + modulation (R)
dampR	= poleZeroDamp((tap2R + dryLatten),		damping);					// + inject partial dry (L)
tap3R	= fffbAllpassLong((dampR * decMulR),	APGAIN4,		RtimeMul3);
tapsR.write(tap3R);


// -------	write / read / sum

sum1L, sum2L	= delayReadZero2(tap1L, CtimeMul1L, CtimeMul2L,	smoothsamps);
sum1R, sum2R	= delayReadZero2(tap1R, CtimeMul1R, CtimeMul2R,	smoothsamps);

// sum left
sumLeft			= 
(sum1L			+ 
sum2L			- 
delayReadZero1(tap3L, CtimeMul3L, smoothsamps) + 
delayReadZero1(tap4L, CtimeMul4L, smoothsamps) - 
delayReadZero1(tap2R, CtimeMul5L, smoothsamps) - 
delayReadZero1(tap3R, CtimeMul6L, smoothsamps) - 
delayReadZero1(tap4R, CtimeMul7L, smoothsamps));

// sum right
sumRight		= 
(sum1R			+ 
sum2R			- 
delayReadZero1(tap3R, CtimeMul3R, smoothsamps) + 
delayReadZero1(tap4R, CtimeMul4R, smoothsamps) - 
delayReadZero1(tap2L, CtimeMul5R, smoothsamps) - 
delayReadZero1(tap3L, CtimeMul6R, smoothsamps) - 
delayReadZero1(tap4L, CtimeMul7R, smoothsamps));

rvrbL			=  sumLeft * wetMix;
rvrbR			= sumRight * wetMix;


// -------	eq

// 1-pole eq cut/boost shelf filters
// if high/lowshelfK params == 1, filters become high/lowpasses
// if high/lowshelfK params == 0, do not compute

if (eqHighK != 0) {
	rvrbL	= rcFilterDamp(rvrbL, eqHighG, eqHighK);		// highshelf
	rvrbR	= rcFilterDamp(rvrbR, eqHighG, eqHighK);
}

//if (eqLowK != 0) { 										// cpu manage not click-free for low :-(
	rvrbL   = rcFilterDampHp(rvrbL, eqLowG, eqLowK);		// lowshelf
	rvrbR   = rcFilterDampHp(rvrbR, eqLowG, eqLowK);
//}


// --- bypass (smooth and cpu)

}	// end


// -------	sum & output

out1	= interp(PASS, (rvrbL + dryLmix), dryL, mode="cosine");
out2	= interp(PASS, (rvrbR + dryRmix), dryR, mode="cosine");


// -------

