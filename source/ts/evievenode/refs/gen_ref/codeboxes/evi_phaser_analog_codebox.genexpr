
// analog-like phaser in the sort of pedal sense (good for mono input but still does quasi stereo well)

require("evi_smooth_bank.genexpr");
require("evi_rcfilters.genexpr");
require("evi_crossovers.genexpr");
//require("evi_sources.genexpr");
require("evi_lfo.genexpr");
require("evi_adaa.genexpr");

inputMixCos(xL, xR, stereo)
{
	monoMix = (xL + xR) * 0.5;
    yL, yR = xfadeQuartApproxStereo(monoMix, monoMix, xL, xR, stereo);
	return yL, yR, monoMix;
}

outputMixCos(xL, xR, stereo)
{
	yL = xL;
	yR = xfadeQuartApproxMono(xL, xR, stereo);
	return yL, yR;
}

Param	rate(0.49, min=0, max=8);
Param	depth(0.74, min=0, max=1);
Param	center(0.52, min=0, max=1);
Param	spread(0.632, min=0, max=1);

Param	duty(0.4, min=0, max=1);
Param	shape(0.5, min=0, max=1);
Param	skew(1.2, min=0.5, max=2);

Param   crossover(104., min=10, max=1000);
Param   pregain(2., min=-6, max=6);
Param   postgain(0., min=-6, max=6);
Param	feedback(-0.5, min=-1, max=1);
Param   smooth(22.666, min=1, max=226);

// advanced, do not use
//Param   leakymix(0., min=0, max=1); // can be higher than 1 but gets unpredictable
//Param   lossiness(0.7, min=0, max=1);
//Param   flavour(0.3, min=-20, max=20);
//Param   gaintime(2., min=0);
//Param   gainmode(0, min=0, max=2); // int

History circuitM(0), XinAlign(0);

History prevNum(7);
Data	allpassCascade(32, 1); // just change dim() for different available number of stages
Param	stages(7, min=2, max=32); // change "max" if you change "dim"
maxSections = dim(allpassCascade);
numSections = clamp(int(stages), 2, maxSections);
numSectsM1  = numSections - 1; // because final section is solo
smoothsecs	= smooth*0.001;

centPitch = center * 129;
rangPitch = centPitch * 0.5;
rangDepth = depth * rangPitch;
minPitch = centPitch - rangDepth;
maxPitch = minimum((centPitch + rangDepth), 134);

fbsin	= fastsin(feedback * (((1 - ((maximum(spread, 0.5) - 0.5) * 2)) * 0.75) + 0.75));
fbpre   = dbtoaApprox(maximum(pregain - (abs(feedback) * 3), -6));
post    = dbtoaApprox(postgain);
/*
pat     = 0.23283;
sale	= (leakymix * leakymix) * pat;
*/
omsq12		= 0.2928932188134524; // 1 - sqrt1_2;
fbattenL	= 1 - (abs(minimum(fbsin, 0)) * omsq12);
fbattenR	= 1 - (maximum(fbsin, 0) * omsq12);

stereoIn	= spread * 0.61;
stereoOut   = (spread * 0.82) + 0.18;

// audio rate from here

// smooth
minPitchS, maxPitchS = cfSmoothLinear2(minPitch, maxPitch, 3, smoothsecs);
fbsinS, fbpreS, postS = logsmoothBank3(fbsin, fbpre, post, smoothsecs);
fbattenLs, fbattenRs, stereoInS, stereoOutS = expsmoothBank4(fbattenL, fbattenR, stereoIn, stereoOut, smoothsecs);
xover = logsmooth(crossover, smoothsecs*1.09);

// lfo
phase, currentHz, sync = evi_phasor0(rate, 0);
lfo01	= lfoMix(phase, duty, shape, skew);
lfomid	= mix(minPitchS, maxPitchS, lfo01);
lfohz	= mtofApproxBaseless(lfomid);
lfog    = rcPreWarp2(lfohz);

// audio
xL      = in1;
xR      = in2;
XinL, XinR, Mono  = inputMixCos(xL, xR, stereoInS);
Sub, Xin    = eviXover2pole2band(XinL, xover);
XinAlign    = Xin; // because Adaa2
allpassM	= ((circuitM * fbsinS) + XinAlign) * fbpreS;
/*
// noise
ratio1, gainMod1 = lossinessN(lossiness, flavour, gaintime, gainmode);
preN	= clip(ratio1 * gainMod1, 0, 1);
modN	= 1 - (sale * preN);
*/
// allpass cascade
for (j = 0; j < numSectsM1; j += 1) {
    apS0 = peek(allpassCascade, j, 0, index="samples", interp="none");
    allpassM, apS1 = rcFilterAllpassCascade(allpassM, lfog, apS0);
    apW1 = apS1;// * modN;
    poke(allpassCascade, apW1, j, 0, 0, index="samples");
}
if (prevNum != numSections) { // should be before cascade ?
	// zero remainder
	for (k = numSectsM1; k < maxSections; k += 1) {
		poke(allpassCascade, 0, k, 0, 0, index="samples");
	}
	prevNum = numSections;
}

// tap feedback and saturate
circuitM	= dcblock(altTanhSqrtAdaa2(allpassM * fbsinS));
final	    = dcblock(-rcFilterAllpass((allpassM * postS), lfog));
subFinal    = eCubicAdaa1(Sub * 1.122018) + final;

// mix
phaserL		= (XinAlign + (subFinal * sqrt1_2)) * fbattenLs; // & static atten
phaserR		= ((subFinal + (subFinal * fbsinS)) + XinR) * fbattenRs;

// out
mainL, mainR = outputMixCos(phaserL, phaserR, stereoOutS);

out1 = mainL;
out2 = mainR;

out3 = lfohz;
out4 = lfo01;

