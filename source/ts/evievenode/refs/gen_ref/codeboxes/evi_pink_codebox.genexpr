
// pink noise in gen~, we should all celebrate
// this is a classic hack and not perfect
pink()
{
	History b0(0), b1(0), b2(0);
	white = noise();

	b0 = 0.99765 * b0 + 0.0990460 * white;
	b1 = 0.96300 * b1 + 0.2965164 * white;
	b2 = 0.57000 * b2 + 1.0526913 * white;

	pink = (b0 + b1 + b2 + 0.1848 * white) * 0.1; // * 0.1 = like MSP, YMMV
	return clamp(pink, -1, 1);
}

out1 = pink();


