
// this is a quadrature FM/PM xfading mod/carrier setup, based on LIONEL's patch from:
// https://cycling74.com/forums/fm-vs-pm-in-gen-unwanted-artifacts-clicks
// with additions by Graham Wakefield
// Thanks so much!

// Note: this is a strange param rate only version for specific situations,
// see the more normal 'evi_quadfmpm.gendsp' for a fully audio rate inlets version.

require("evi_smooth.genexpr");

// this is not so good, should replace
lpfir3(x0)
{
	History	x1(0), x2(0);
	y0	= (x0*0.5 + x1*0.333333333333 + x2*0.166666666667) * sqrt1_2;
	x2	= x1;
	x1	= x0;
	return	y0;
}

// this is one of those really clever Graham Wakefield things, thanks
// output will reach target by a linear ramp whose slope can be no greater than the param maxslope
ramplimit(target, maxslope)				// maxslope = maximum change per ms
{
	History y0(0);
	maxsamps	= sampstoms(maxslope);	// this is strange?
	y1	= clamp(target - y0, -maxsamps, maxsamps) + y0;
	y0	= y1;
	return	y1;
}

History modOscPrev(0), carrierCosFb(0), carrierSinFb(0);

Param	pitch(48., min=0, max=120);
Param	modulationmult(1., min=0, max=100);

Param	xfadedepth(1., min=0, max=100);
Param	xfadeblend(1., min=0, max=1);	// % 0..1, default PM

Param	modulationfeedback(0., min=0, max=100);
Param	carrierfeedback(0., min=0, max=100);

Param	smooth(10., min=0, max=333);	// ms
smoothsecs	= smooth*0.001;
smooth_p	= (smooth > 0);

pitch_a	= pitch;
mmult_a = modulationmult;
modfb_a	= modulationfeedback;
carfb_a	= carrierfeedback;
if (smooth_p) {
	pitch_a	= logsmooth(pitch, smoothsecs);
	mmult_a	= expsmooth(modulationmult, smoothsecs);
	modfb_a, carfb_a	= expsmoothBank2(modulationfeedback, carrierfeedback, smoothsecs);
}

freq_a	= mtofApproxBaseless(pitch_a);
fmm		= freq_a*mmult_a;
fmamount, pmamount	= p2cApproxQuart(xfadedepth, xfadeblend);

index	= maximum(in1, 1);

// Op

modOsc		= sin73a(phasor(fmm)*twopi + lpfir3(modfb_a*modOscPrev));
modZerox	= (modOscPrev*modOsc) <= 0;
modOscPrev	= modOsc;
modBias		= latch(index, modZerox);
modulator	= modOsc*modBias;
fmamount	= ramplimit(fmamount, 0.01);
fmamount	= latch(fmamount, modZerox);
pmamount	= ramplimit(pmamount, 0.01);

carrierPhase	= (phasor(freq_a + (fmm*modulator*fmamount))*twopi) + (modulator*pmamount);
carrierCos		= cos(carrierPhase + carrierCosFb);
carrierSin		= sin(carrierPhase + carrierSinFb);

if (carfb_a > 0) {
	carrierCosFb	= fixdenorm(lpfir3(carfb_a*carrierCos));
	carrierSinFb	= fixdenorm(lpfir3(carfb_a*carrierSin));
}

out1	= dcblock(carrierCos);
out2	= dcblock(carrierSin);

