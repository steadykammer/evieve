// Vactrol time-domain behaviour filter.
// @see also: evi_vactrol_fix.gendsp & evi_vactrol_shape.gendsp

// A basic not-really-a-model of the Perkin Elmer VTL5C3, the resistive
// part of a photoresistive opto-isolator.
// As it turns out, the shape (not the behaviour) can be similar to [slide~]
// in MSP/RNBO or [slide] in gen~, achievable via the @shape parameter here.

vactrolSection(x, a)                        // trigger history, coefficient
{
	return x * a / (1 + a);
}
// if 'i' is a single sample 'click', scaling must happen externally
vactrolBuchla(i, r, f, b)       // impulse, rise (samps), fall (samps), base (Hz)
{
	History s1(0);
    // it would be good to cache all this, but difficult because of 's1'
	a_base	= b*PI/SAMPLERATE;              // b = frequency (default 1016.898263)
	t_down	= 10 + f*(1 - 0.9*s1);
	a_down	= a_base/t_down;                // fall coefficient
	t_up	= 1 + r*(1 - 0.999*s1);
	a_up	= a_base/t_up;                  // rise coefficient

    // is it dangerous not to clip 'i' -1..1 ?? (yes)
	x		= clamp(i, -1, 1) - s1;
	z 		= (x < 0) ? vactrolSection(x, a_down) : vactrolSection(x, a_up);
	y		= z + s1;
	s1		= y + z;
	return	  y;						    // & scale externally
}

Param   shape(0.5, min=0, max=1);           // base frequency, default 1000 Hz
Param	scalar(1., min=0.1, max=10000);

base    = evi_mtofapprox(shape * 81 + 43);  // 100..10000 Hz

rise	= in2;							    // difficult to change
fall	= in3;							    // fully changeable

//mult	= slide(scalar, rise, rise);
vB      = vactrolBuchla(in1, rise, fall, base);
out1 	= vB * scalar;//mult;
