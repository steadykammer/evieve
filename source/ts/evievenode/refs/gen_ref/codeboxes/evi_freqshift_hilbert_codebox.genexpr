
// Time domain frequency shifter by Pete for evieve. A bit like MSP [freqshift~].

// Defaults for 48kHz samplerate. If using other samplerates you will need to provide 
// coefficients externally (e.g. from [evi.polyphaseiirhilbertcoeffs], or 
// 'evi_hilbert_coefficients.js' directly). @see the [evi.freqshift.hilbert~]
// abstraction for an example.

// @see also:
// 'evi_freqshift_weaver.gendsp'	<<-- does not rely on externally computed coefficients :-)
// 'evi_hilbert.gendsp'
// 'evi_ringmod.gendsp'


// lib

require("evi_ssb.genexpr");

// declare

History	autoreset(1);

// 64-bit Polyphase IIR Halfband Allpass Cascade Coefficients updated
// from Javascript, defaults are for 48kHz Samplerate & 40Hz bandwidth

// Phase reference path c coefficients
Param	coef1(0.486604368613682, min=-10, max=10);
Param	coef2(0.880779435272467, min=-10, max=10);
Param	coef3(0.977931255616324, min=-10, max=10);
Param	coef4(0.997673861850732, min=-10, max=10);
// +90 degrees path c coefficients
Param	coef5(0.165149093559079, min=-10, max=10);
Param	coef6(0.739829012544530, min=-10, max=10);
Param	coef7(0.947940906329181, min=-10, max=10);
Param	coef8(0.991209712705258, min=-10, max=10);

Param	saturation(0, min=0, max=1);		// 0/1 off/on, default off
Param	drive(0.5, min=0, max=2);			// % 0..1.. , if sat on
Param	resetauto(1, min=0, max=1);			// 0/1 off/on, default on
Param	bandsmix(0.5, min=0, max=1);		// % 0..1, default equal mix
Param	smooth(22.666, min=0, max=333);		// ms
Param	freqsmooth(20., min=0, max=666);	// ms

modclamp	= samplerate*0.0625;
smoothsecs	= smooth*0.001;
smoothsamps	= smoothsecs*samplerate;
smoothfreq	= mstosamps(freqsmooth);
sat			= int(saturation);
rauto		= int(resetauto);
resettime	= maximum(smoothsamps * 2, vectorsize * 8);				// need to test this
spread		= 0.75;							// might do funky AM stuff with this la'er
mix			= bandsmix;

drivepi, drivesin	= sinParam(drive);		// cheaper to keep out of audio branches and out of the while loop

// audio rate ...

x		= in1;
hz		= in2;
fm		= in3;
reset	= delta(in4) < 0;					// manual reset, will click, but useful if Hz @ zero

if (smoothsecs > 0)							// only smooth if requested
{
	mix	= logsmooth(mix, smoothsecs * 1.005);
	drivepi, drivesin	= expsmoothBank2(drivepi, drivesin, smoothsecs * 0.995);
}

if (smoothfreq > 0)							// turn off smoothing if feeding with audio rate modulation
{
	hz, hn	= eviLine(hz, smoothfreq);
}

hz			= clamp(hz + fm, -modclamp, modclamp);					// + audio rate modulation input

// auto reset
sync		= phasor(hz, (reset + autoreset));
static		= delta(sync) != 0;				// phasor is / is not moving
resetramp, rrn	= eviLine(static, resettime);
autoreset	= rauto ? ((change(rrn == 1) > 0) * (static == 0)) : 0;	// end of down ramp only, not up

// freqshift
rm, im		= quadratureOsc(sync, spread);
real, imag	= eviHilbertCascade(x, coef1, coef2, coef3, coef4, coef5, coef6, coef7, coef8);
usb, lsb, cosam, sinam	= complexRing(real, imag, rm, im);

// for hz zero reset
usb			= xfadeQuartApproxMono(real, usb, resetramp);
lsb			= xfadeQuartApproxMono(imag, lsb, resetramp);

bands		= xfadeQuartApproxMono(usb, lsb, mix);					// mix bands

// saturation
if (sat) {
	out1	= sinFoldAdaa2_4x(bands*0.984292036732, drivepi, drivesin);	// sidebands mixed & saturated
} else {
	out1	= bands;
}

// extra stuff
out2	= usb;		// positive sideband
out3	= lsb;		// negative sideband

out4 	= rm;		// quad osc cos
out5 	= im;		// quad osc sin

out6	= sync;

