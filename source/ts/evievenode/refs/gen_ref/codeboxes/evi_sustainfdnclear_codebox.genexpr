
//	//	//	evi_sustainfdn.gendsp
//	//	//	16 line feeback delay network
//	//	//	by pete for evieve
//  //  //  NOTE: this is a heavily edited version of real reverb "evi_sustainverb.gendsp"...
//  //  //  ...for the purposes of the rod polyphonic sustainer. not much use to anyone else

//	//	//	library

require("evi_reverb_library.genexpr");

//	//	//	declare

// constants in samples from external javascript, defaults are for 48kHz samplerate

Param	delayTime1 	(	480,	min=1, max=25056	);
Param	delayTime2 	(	559,	min=1, max=25056	);
Param	delayTime3 	(	646,	min=1, max=25056	);
Param	delayTime4 	(	803,	min=1, max=25056	);
Param	delayTime5 	(	969,	min=1, max=25056	);
Param	delayTime6 	(	1236,	min=1, max=25056	);
Param	delayTime7 	(	1511,	min=1, max=25056	);
Param	delayTime8 	(	1838,	min=1, max=25056	);
Param	delayTime9 	(	2241,	min=1, max=25056	);
Param	delayTime10 (	2662,	min=1, max=25056	);
Param	delayTime11 (	3128,	min=1, max=25056	);
Param	delayTime12 (	3688,	min=1, max=25056	);
Param	delayTime13 (	4251,	min=1, max=25056	);
Param	delayTime14 (	4861,	min=1, max=25056	);
Param	delayTime15 (	5539,	min=1, max=25056	);
Param	delayTime16 (	6264,	min=1, max=25056	);

Delay	fdnDelay1	(	delayTime1+1,	1,	feedback=1	);
Delay	fdnDelay2	(	delayTime2+1,	1,	feedback=1	);
Delay	fdnDelay3	(	delayTime3+1,	1,	feedback=1	);
Delay	fdnDelay4	(	delayTime4+1,	1,	feedback=1	);
Delay	fdnDelay5	(	delayTime5+1,	1,	feedback=1	);
Delay	fdnDelay6	(	delayTime6+1,	1,	feedback=1	);
Delay	fdnDelay7	(	delayTime7+1,	1,	feedback=1	);
Delay	fdnDelay8	(	delayTime8+1,	1,	feedback=1	);
Delay	fdnDelay9	(	delayTime9+1,	1,	feedback=1	);
Delay	fdnDelay10	(	delayTime10+1,	1,	feedback=1	);
Delay	fdnDelay11	(	delayTime11+1,	1,	feedback=1	);
Delay	fdnDelay12	(	delayTime12+1,	1,	feedback=1	);
Delay	fdnDelay13	(	delayTime13+1,	1,	feedback=1	);
Delay	fdnDelay14	(	delayTime14+1,	1,	feedback=1	);
Delay	fdnDelay15	(	delayTime15+1,	1,	feedback=1	);
Delay	fdnDelay16	(	delayTime16+1,	1,	feedback=1	);

History init(1);

Param	smoothtime(10, min=1, max=500);		// ms
Param	feedback(0, min=0, max=1);	        // % 0..1
Param	gain(0, min=-80, max=20);		    // dB
Param   release(500, min=10, max=1000);     // external [poly~] / [adsr~] release stage timing
Param   fbinlet(0, min=0, max=1);           // inlet for all-audio-rate MC version
fbin    = int(fbinlet);

//	//	//	parse param rate

smoothsecs	= smoothtime * 0.001;
smoothsamps	= smoothsecs * samplerate;

outgain		= dbtoaApprox(gain);

//	//	//	parse audio rate

fb_0        = 0;
if (fbin) {
    fb_0    = in3;
} else {
    fb_0    = feedback;
}

fb_0		= sqrt(fb_0) * 0.25;		    // you think this is a stupid multiplier, but it is correct
reset       = delta(in4) < 0;
relapsed    = accum(1, reset);
//out3        = relapsed;
// we clear in the release portion, not at beginning of voice
cleartime   = minimum(delayTime16, mstosamps(release)) + delayTime5;
//condition   = 1;
//if (init) {
//    condition = 1;
//} else {
    condition = (cleartime < relapsed);
//}
rramp, rrn  = eviLine(condition, delayTime1);
//if (rrn && init) {
//    init = 0;
//}
out3        = condition;//fb_0;//condition;//init;//rramp;

fb0			= eviLine(fb_0, smoothsamps);
outAmp      = logsmooth(outgain, smoothsecs);

//	//	//	processing		(static & integer delay times so no interpolation)

xL		= in1+0;
xR		= in2+0;

// fdn read...
/*
fb01	= fdnDelay1.read(delayTime1,	interp="none") * eviLine((delayTime1 < relapsed), delayTime1*0.5);
fb02	= fdnDelay2.read(delayTime2,	interp="none") * eviLine((delayTime2 < relapsed), delayTime2*0.5);

fb1		= (fb01	 +	xL)							        * fb0;
fb2		= (fb02	 +	xR)							        * fb0;
fb3		=  fdnDelay3.read(delayTime3,	interp="none")  * fb0 * eviLine((delayTime3 < relapsed), delayTime3*0.5);
fb4		=  fdnDelay4.read(delayTime4,	interp="none")  * fb0 * eviLine((delayTime4 < relapsed), delayTime4*0.5);

fb5		=  fdnDelay5.read(delayTime5,	interp="none")	* fb0 * eviLine((delayTime5 < relapsed), delayTime5*0.5);
fb6		=  fdnDelay6.read(delayTime6,	interp="none")	* fb0 * eviLine((delayTime6 < relapsed), delayTime6*0.5);
fb7		=  fdnDelay7.read(delayTime7,	interp="none")	* fb0 * eviLine((delayTime7 < relapsed), delayTime7*0.5);
fb8		=  fdnDelay8.read(delayTime8,	interp="none")	* fb0 * eviLine((delayTime8 < relapsed), delayTime8*0.5);
fb9		=  fdnDelay9.read(delayTime9,	interp="none")	* fb0 * eviLine((delayTime9 < relapsed), delayTime9*0.5);
fb10	=  fdnDelay10.read(delayTime10,	interp="none")	* fb0 * eviLine((delayTime10 < relapsed), delayTime10*0.5);
fb11	=  fdnDelay11.read(delayTime11,	interp="none")	* fb0 * eviLine((delayTime11 < relapsed), delayTime11*0.5);
fb12	=  fdnDelay12.read(delayTime12,	interp="none")	* fb0 * eviLine((delayTime12 < relapsed), delayTime12*0.5);
fb13	=  fdnDelay13.read(delayTime13,	interp="none")	* fb0 * eviLine((delayTime13 < relapsed), delayTime13*0.5);
fb14	=  fdnDelay14.read(delayTime14,	interp="none")	* fb0 * eviLine((delayTime14 < relapsed), delayTime14*0.5);
fb15	=  fdnDelay15.read(delayTime15,	interp="none")	* fb0 * eviLine((delayTime15 < relapsed), delayTime15*0.5);
fb16	=  fdnDelay16.read(delayTime16,	interp="none")	* fb0 * eviLine((delayTime16 < relapsed), delayTime16*0.5);
*/
fb01	= fdnDelay1.read(delayTime1,	interp="none");// * rramp;
fb02	= fdnDelay2.read(delayTime2,	interp="none");// * rramp;

fb1		= (fb01	 +	xL)							        * fb0;
fb2		= (fb02	 +	xR)							        * fb0;
fb3		=  fdnDelay3.read(delayTime3,	interp="none")  * fb0;// * rramp;
fb4		=  fdnDelay4.read(delayTime4,	interp="none")  * fb0;// * rramp;

fb5		=  fdnDelay5.read(delayTime5,	interp="none")	* fb0;// * rramp;
fb6		=  fdnDelay6.read(delayTime6,	interp="none")	* fb0;// * rramp;
fb7		=  fdnDelay7.read(delayTime7,	interp="none")	* fb0;// * rramp;
fb8		=  fdnDelay8.read(delayTime8,	interp="none")	* fb0;// * rramp;
fb9		=  fdnDelay9.read(delayTime9,	interp="none")	* fb0;// * rramp;
fb10	=  fdnDelay10.read(delayTime10,	interp="none")	* fb0;// * rramp;
fb11	=  fdnDelay11.read(delayTime11,	interp="none")	* fb0;// * rramp;
fb12	=  fdnDelay12.read(delayTime12,	interp="none")	* fb0;// * rramp;
fb13	=  fdnDelay13.read(delayTime13,	interp="none")	* fb0;// * rramp;
fb14	=  fdnDelay14.read(delayTime14,	interp="none")	* fb0;// * rramp;
fb15	=  fdnDelay15.read(delayTime15,	interp="none")	* fb0;// * rramp;
fb16	=  fdnDelay16.read(delayTime16,	interp="none")	* fb0;// * rramp;

// fdn matrix...

dx1, dx2, dx3, dx4, dx5, dx6, dx7, dx8, dx9, dx10, dx11, dx12, dx13, dx14, dx15, dx16	
		= butterfly16(fb1, fb2, fb3, fb4, fb5, fb6, fb7, fb8, fb9, fb10, fb11, fb12, fb13, fb14, fb15, fb16);

// aux taps...

tapOut1	= dcblock(dx13);
tapOut2	= dcblock(dx14);
tapOut3	= dcblock(dx15);
tapOut4	= dcblock(dx16);

// main taps...

// should be butterfly ??
fdnL	= (tapOut1 + tapOut2) * sqrt1_2 * outAmp;
fdnR	= (tapOut3 + tapOut4) * sqrt1_2 * outAmp;

// fdn write (update delay lines)...
/*
fdnDelay1.write		(	fixdenorm(dx1)		);
fdnDelay2.write		(	fixdenorm(dx2)		);
fdnDelay3.write		(	fixdenorm(dx3)		);
fdnDelay4.write		(	fixdenorm(dx4)		);
fdnDelay5.write		(	fixdenorm(dx5)		);
fdnDelay6.write		(	fixdenorm(dx6)		);
fdnDelay7.write		(	fixdenorm(dx7)		);
fdnDelay8.write		(	fixdenorm(dx8)		);
fdnDelay9.write		(	fixdenorm(dx9)		);
fdnDelay10.write	(	fixdenorm(dx10)		);
fdnDelay11.write	(	fixdenorm(dx11)		);
fdnDelay12.write	(	fixdenorm(dx12)		);
fdnDelay13.write	(	fixdenorm(dx13)		);
fdnDelay14.write	(	fixdenorm(dx14)		);
fdnDelay15.write	(	fixdenorm(dx15)		);
fdnDelay16.write	(	fixdenorm(dx16)		);
*/
fdnDelay1.write		(	fixdenorm(dx1 * rramp)		);
fdnDelay2.write		(	fixdenorm(dx2 * rramp)		);
fdnDelay3.write		(	fixdenorm(dx3 * rramp)		);
fdnDelay4.write		(	fixdenorm(dx4 * rramp)		);
fdnDelay5.write		(	fixdenorm(dx5 * rramp)		);
fdnDelay6.write		(	fixdenorm(dx6 * rramp)		);
fdnDelay7.write		(	fixdenorm(dx7 * rramp)		);
fdnDelay8.write		(	fixdenorm(dx8 * rramp)		);
fdnDelay9.write		(	fixdenorm(dx9 * rramp)		);
fdnDelay10.write	(	fixdenorm(dx10 * rramp)		);
fdnDelay11.write	(	fixdenorm(dx11 * rramp)		);
fdnDelay12.write	(	fixdenorm(dx12 * rramp)		);
fdnDelay13.write	(	fixdenorm(dx13 * rramp)		);
fdnDelay14.write	(	fixdenorm(dx14 * rramp)		);
fdnDelay15.write	(	fixdenorm(dx15 * rramp)		);
fdnDelay16.write	(	fixdenorm(dx16 * rramp)		);

// outputs...

out1	= fdnL;
out2	= fdnR;

