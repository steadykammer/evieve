
require("evi_svfs.genexpr");

Param   smooth(0, min=0, max=333);
Param   filter(3, min=0, max=7);
filt    = int(filter);
reset   = delta(change(filt)) < 0;

/*
	Index	Filter

	0 		Bypass
	1 		Highpass
	2 		Lowshelf
	3 		Bell            // (default)
	4 		BellAdaptiveQ
	5 		Notch
	6 		Highshelf
	7 		Lowpass
*/

                            //  hz,  db,  Q
out1    = eviFilterEqReset(in1, in2, in3, in4, filt, reset, smooth=smooth);

