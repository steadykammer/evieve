
require("evi_biquad.genexpr");

/*
    0   eviBiquadCoeffPeakNotch                 cutoff, gain, Q     (default)
    1   eviBiquadCoeffPeakNotchAnalog1          cutoff, gain, Q
    2   eviBiquadCoeffPeakNotchAnalog2          cutoff, gain, Q
*/
Param   filter(0, min=0, max=2);
filt    = int(filter);
reset   = delta(change(filt)) < 0;

a0, a1, a2, b1, b2  = 0;
if (filt == 1) {
    a0, a1, a2, b1, b2  = eviBiquadCoeffPeakNotchAnalog1(in2, dbtoa(in3), in4);
}
else if (filt == 2) {
    a0, a1, a2, b1, b2  = eviBiquadCoeffPeakNotchAnalog2(in2, dbtoa(in3), in4);
}
else {
    a0, a1, a2, b1, b2  = eviBiquadCoeffPeakNotch(in2, dbtoa(in3), in4);
}

out1    = biquadDf2reset(in1, a0, a1, a2, b1, b2, reset);

