
require("evi_biquads_coeffs");
require("evi_biquads_filters.genexpr");

/*
    0   eviBiquadCoeffHighpass                  cutoff, Q
    1   eviBiquadCoeffHighpassGain              cutoff, gain, Q   (default)
    2   eviBiquadCoeffHighpassAnalog            cutoff, Q
    3   eviBiquadCoeffButterworthHighpass       cutoff
    4   eviBiquadCoeffButterworthHighpassGain   cutoff, gain
*/
Param   filter(1, min=0, max=4);
filt    = int(filter);
reset   = delta(change(filt)) < 0;

a0, a1, a2, b1, b2  = 0;
if (filt == 1) {
    a0, a1, a2, b1, b2  = eviBiquadCoeffHighpassGain(in2, dbtoa(in3), in4);
}
else if (filt == 2) {
    a0, a1, a2, b1, b2  = eviBiquadCoeffHighpassAnalog(in2);
}
else if (filt == 3) {
    a0, a1, a2, b1, b2  = eviBiquadCoeffButterworthHighpass(in2);
}
else if (filt == 4) {
    a0, a1, a2, b1, b2  = eviBiquadCoeffButterworthHighpassGain(in2, dbtoa(in3));
}
else {
    a0, a1, a2, b1, b2  = eviBiquadCoeffHighpass(in2, in4);
}

out1    = biquadDf2reset(in1, a0, a1, a2, b1, b2, reset);

