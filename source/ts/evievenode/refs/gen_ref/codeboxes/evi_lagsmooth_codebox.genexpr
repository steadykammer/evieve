
expA(x0)
{
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;
	x *= x; x *= x; x *= x; x *= x; x *= x;
	return x;
}

lagpole(x, c, l)							// value / coefficient / previous
{
//  return ((1 - abs(c)) * x) + (c * l);
	return ((1 - c) * x) + (c * l);			// no need for abs here
}

// a bit like Supercollider [lag3], GPLv2
// original by James MacCartney, mod by me, fixed threshold
lagsmooth(v, lp0)							// destination value / time (in seconds)
{
	History coef(0);						// ensure lp3 == v on 1st sample pass
	History lp1(0), lp2(0), lp3(0);
	LOGTH	= -6.907755278982137;			// ln(0.001), fixed threshold of 0.001 (-60 dB)
	lp1		= lagpole(v,	coef,	lp1);
	lp2		= lagpole(lp1,	coef,	lp2);
	lp3		= lagpole(lp2,	coef,	lp3);
	lp0		= maximum(lp0, 0.008);			// <<-- careful! (this is an empirical number)
	if (change(lp0))
		coef	= maximum(expA(LOGTH / (lp0 * samplerate)), 0);
	return	lp3;
}

out1    = lagsmooth(in1, in2*0.001);

