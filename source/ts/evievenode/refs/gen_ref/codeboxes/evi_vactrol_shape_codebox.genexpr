
// A digital model of a vactrol filter, quasi 'analog' in behaviour.
// The behaviour is similar to [slide~] in MSP/RNBO or [slide] in gen~
// @see also: evi_vactrol.gendsp

tanA2(x)								// approx tan(0..halfpi)
{
	a	= ((((x * -0.0896638) + 0.0388452) * x) + 1.00005) * x;
	b	= (((x * -0.430871) + 0.0404318) * x) + 1;
	return	a / b;
}

likeAvactrol(V, up, down)
{
	History	s0(0);

	F  = clip(((s0 > V) * up) + down, 0.01, HALFPI);
	w2 = tanA2(F * PI / SAMPLERATE);
	g0 = w2 / (w2 + 1);

	G  = (V - s0) * g0;
	Y  =  G + s0;

	s0 =  G + Y;
	return	Y;
}

Param	scalein(3., min=1, max=10000);	// static
Param	scaleout(1., min=1, max=1000);	// ...
//Param	rise(0.0707107, min=0, max=1);	// % 0..1
//Param	fall(sqrt1_2, min=0, max=1);	// ...
Param	mode(0, min=0, max=3);
md		= int(mode);					// 0 = rise/fall params, 1..3 = fixed
rise	= in2;
fall	= in3;
up = (md > 0) ? ((md > 1) ? ((md > 2) ? 6000 : 1000) : 600) : rise*rise*rise*7800 + 200;
down = (md > 0) ? ((md > 1) ? ((md > 2) ? 0.08 : 0.04) : 0.02) : (fall*0.9999 + 0.0001) * 0.1;

voltage	 = in1 * scalein;

out1	 = likeAvactrol(voltage, up, down) * scaleout;

