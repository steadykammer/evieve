// A digital model of a vactrol filter, quasi 'analog' in behaviour.
// The behaviour is similar to [slide~] in MSP/RNBO or [slide] in gen~
// @see also: evi_vactrol.gendsp

tanA2v(x)								// approx tan(0..halfpi)
{
	a	= ((((x * -0.0896638) + 0.0388452) * x) + 1.00005) * x;
	b	= (((x * -0.430871) + 0.0404318) * x) + 1;
	return	a / b;
}

// it is just a onepole rcfilter
likeAvactrol(V, up, down)
{
	History	s0(0);
    aV = abs(V);                        // in case bipolar plugged in

	F  = clip(((s0 > aV) * down) + up, 0.01, HALFPI); // evieve fix
	w2 = tanA2v(F * PI / SAMPLERATE);
	g0 = w2 / (w2 + 1);

	G  = (aV - s0) * g0;
	Y  =  G + s0;

	s0 = fixdenorm(G + Y);
	return Y;
}

Param   invert(0, min=0, max=1);            // not as stupid as it seems
Param	scalein(1., min=0.1, max=10000);    // static
Param	scaleout(1., min=0.1, max=10000);   // ...
Param	mode(0, min=0, max=3);              // 0 = rise/fall inputs, 1..3 = fixed 'models'
md		= int(mode);
iv      = int(invert);
// specified in % 0..1, if used
rise	= in2;
fall	= in3;
// specified in frequencies
up = (md > 0) ? ((md > 1) ? ((md > 2) ? 6000 : 1000) : 600) : rise*rise*rise*7800 + 200;
down = (md > 0) ? ((md > 1) ? ((md > 2) ? 0.08 : 0.04) : 0.02) : (fall*0.9999 + 0.0001) * 0.1;
ud0 = iv ? down : up;
ud1 = iv ? up : down;
voltage	 = in1 * scalein;
out1	 = likeAvactrol(voltage, ud0, ud1) * scaleout;
