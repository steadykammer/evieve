{
    "object": {
        "name": "evi_zerox",
        "child": "",
        "category": "evieve",
        "digest": "Detect zero crossings",
        "description": "Detect zero crossings in an incoming audio signal. With multiple analysis outputs."
    },
    "constructor": {
        "inlets": "input"
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "The audio input to be analysed for zero crossings."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "number",
            "type": "samples",
            "optional": 1,
            "digestauto": "of Samples between Zerocrossings",
            "digest": "Number of zero crossings per analysis window."
        },
        {
            "id": 2,
            "name": ">",
            "type": "gate",
            "optional": 1,
            "digestauto": "threshold",
            "digest": "Gate out, if crossings in window period > @thresh amount."
        },
        {
            "id": 3,
            "name": "the",
            "type": "float",
            "optional": 1,
            "digestauto": "Zerocrossings",
            "digest": "Constant zero crossings update."
        }
    ],
    "attributes": [
        {
            "name": "thresh",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "If count/window size is > than this threshold, report a gate event (middle outlet).",
            "default": {
                "type": "float",
                "value": "0.1"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_zeroxcount",
            "display": "evi_zeroxcount"
        }
    ]
}