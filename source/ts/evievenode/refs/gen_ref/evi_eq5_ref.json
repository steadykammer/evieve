{
    "object": {
        "name": "evi_eq5",
        "child": "evi.eq5~",
        "category": "evieve",
        "digest": "5-band TPT EQ with message rate control of all parameters",
        "description": "A 5-band parametric EQ made up of 5 TPT SVF EQ filters, each with selectable filter type. Parameter changes can optionally be smoothed."
    },
    "constructor": {
        "inlets": "input"
    },
    "includes": [
        "evi_svfs_lto"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be EQ-ed."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "5",
            "type": "float",
            "optional": 1,
            "digestauto": "bands EQ Output",
            "digest": "EQ-ed audio output."
        }
    ],
    "attributes": [
        {
            "name": "band1db",
            "type": "float",
            "digest": "@min -24, @max 24",
            "description": "Band 1 gain in ± dB.",
            "default": {
                "type": "float",
                "value": "0."
            }
        },
        {
            "name": "band1filter",
            "type": "int",
            "digest": "@min 0, @max 9",
            "description": "Band 1 filter type by integer index: 0=Bypass, 1=Highpass-4-pole, 2=Highpass, 3=Lowshelf, 4=Bell, 5=BellAdaptiveQ, 6=Notch, 7=Highshelf, 8=Lowpass, 9=Lowpass-4-pole",
            "default": {
                "type": "int",
                "value": "3"
            }
        },
        {
            "name": "band1freq",
            "type": "float",
            "digest": "@min 10, @max 18000",
            "description": "Band 1 frequency in Hz.",
            "default": {
                "type": "float",
                "value": "125."
            }
        },
        {
            "name": "band1q",
            "type": "float",
