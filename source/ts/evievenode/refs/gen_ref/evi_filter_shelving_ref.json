{
    "object": {
        "name": "evi_filter_shelving",
        "child": "evi.filter.shelving~",
        "category": "evieve",
        "digest": "A chain of two twopole TPT SVF High/Low shelving filters",
        "description": "A quick one stop shop for applying classic shelving filtering using linear TPT SVFs. Controls are via attributes."
    },
    "constructor": {
        "inlets": "input"
    },
    "includes": [
        "evi_svfs_lto"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be filtered."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "shelfed",
            "type": "float",
            "optional": 1,
            "digestauto": "Output",
            "digest": "Filtered audio output."
        }
    ],
    "attributes": [
        {
            "name": "highcutoff",
            "type": "float",
            "digest": "@min 500, @max samplerate*0.5",
            "description": "Highshelf cutoff frequency in Hz.",
            "default": {
                "type": "float",
                "value": "2000."
            }
        },
        {
            "name": "highdb",
            "type": "float",
            "digest": "@min -30, @max 30",
            "description": "Highshelf gain in dB",
            "default": {
                "type": "float",
                "value": "0."
            }
        },
        {
            "name": "highq",
            "type": "float",
            "digest": "@min 0.05, @max 20",
            "description": "Highshelf Q.",
            "default": {
                "type": "float",
                "value": "1."
            }
        },
        {
            "name": "lowcutoff",
            "type": "float",
            "digest": "@min 1, @max 10000",
            "description": "Lowshelf cutoff frequency in Hz.",
            "default": {
                "type": "float",
                "value": "250."
            }
        },
        {
            "name": "lowdb",
            "type": "float",
            "digest": "@min -30, @max 30",
            "description": "Lowshelf gain in dB",
            "default": {
                "type": "float",
                "value": "0."
            }
        },
        {
            "name": "lowq",
            "type": "float",
            "digest": "@min 0.05, @max 20",
            "description": "Lowshelf Q.",
            "default": {
                "type": "float",
                "value": "1."
            }
        },
        {
            "name": "smooth",
            "type": "float",
            "digest": "@min 0, @max 333",
            "description": "Smooth the mixing gains of the filter efficiently at the core of the DSP. With this TPT SVF filter this will usually be the only smoothing required. By default smoothing is on.",
            "default": {
                "type": "float",
                "value": "22.666"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_filter",
            "display": "evi_filter"
        },
        {
            "name": "evi_filter_eq",
            "display": "evi_filter_eq"
        },
        {
            "name": "evi_filter_morph",
            "display": "evi_filter_morph"
        },
        {
            "name": "evi_filter_allpass",
            "display": "evi_filter_allpass"
        },
        {
            "name": "evi_filter_bandpass",
            "display": "evi_filter_bandpass"
        },
        {
            "name": "evi_filter_bell",
            "display": "evi_filter_bell"
        },
        {
            "name": "evi_filter_highpass",
            "display": "evi_filter_highpass"
        },
        {
            "name": "evi_filter_highshelf",
            "display": "evi_filter_highshelf"
        },
        {
            "name": "evi_filter_lowpass",
            "display": "evi_filter_lowpass"
        },
        {
            "name": "evi_filter_lowshelf",
            "display": "evi_filter_lowshelf"
        },
        {
            "name": "evi_filter_notch",
            "display": "evi_filter_notch"
        },
        {
            "name": "evi_filter_peak",
            "display": "evi_filter_peak"
        },
        {
            "name": "evi_filter_resonant",
            "display": "evi_filter_resonant"
        },
        {
            "name": "evi_filter_tilt",
            "display": "evi_filter_tilt"
        }
    ]
}