{
    "object": {
        "name": "evi_rect",
        "child": "evi.rect~",
        "category": "evieve",
        "digest": "High quality anti-aliased square wave oscillator with PWM",
        "description": "Simple anti-aliased square wave oscillator with PWM, based on 4-point polyblep algorithm. The highest quality of the evieve polyblep oscillators. Including high frequency compensation."
    },
    "constructor": {
        "inlets": "frequency, pwm, reset"
    },
    "includes": [
        "evi_polyblep_four",
        "evi_polyblep_utility"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "frequency",
            "type": "float",
            "optional": 1,
            "digestauto": "in Hz @min 0",
            "digest": "Oscillator frequency in Hz."
        },
        {
            "id": 2,
            "name": "pwm",
            "type": "float",
            "optional": 1,
            "digestauto": "0..1 @min 0 @max 1 @default 0.5",
            "digest": "Pulse Width normalised 0..1, 0.5 = square."
        },
        {
            "id": 3,
            "name": "reset",
            "type": "float",
            "optional": 1,
            "digestauto": "(Naive)",
            "digest": "Oscillator phase reset, naive and not anti-aliased."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "anti",
            "type": "float",
            "optional": 1,
            "digestauto": "Aliased Rect Oscillator",
            "digest": "Anti Aliased Rect Oscillator"
        }
    ],
    "attributes": [],
    "seealso": [
        {
            "name": "evi_saw",
            "display": "evi_saw"
        },
        {
            "name": "evi_tri",
            "display": "evi_tri"
        },
        {
            "name": "evi_4wave",
            "display": "evi_4wave"
        },
        {
            "name": "evi_blitwaves",
            "display": "evi_blitwaves"
        }
    ]
}