{
    "object": {
        "name": "evi_backverb",
        "child": "",
        "category": "evieve",
        "digest": "Ursa Major reverb unit with saturating feedback",
        "description": "A strange reverb-like effect, based on Christopher Moore's legendary 1978 Ursa Major Space Station algorithm. This is not an attempt to model the 1970's digital hardware, but more of a trope on it, although it does sound very close to the original with the right settings. Nonlinearities and trap filters have been added, much as you might find in an analog delay, as well as different modulation, interpolation, smoothing and filtering modifications. In gen~ alone (as opposed to the MSP abstraction <o>evi.backverb~</o>) this is tricky to use as the delay and summing times are calculated externally in javascript. If using at 48kHz samplerate everything will work, if using other samplerates the calculations will have to be done in gen~ or passed in externally."
    },
    "constructor": {
        "inlets": "left, right"
    },
    "includes": [
        "evi_reverb_library",
        "evi_saturators"
    ],
