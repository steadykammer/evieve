        {
            "name": "feedbackdamphigh",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "Normalised 0..1, the high damping amount of the post feedback trap filters at the Hz point of 'feedbackhzhigh'. The higher the values the more damping takes place, the lower the values the more feedback will recirculate.",
            "default": {
                "type": "float",
                "value": "0.8666"
            }
        },
