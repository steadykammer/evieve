{
    "object": {
        "name": "evi_lagsmooth",
        "child": "",
        "category": "evieve",
        "digest": "Smooth signal ramp generator with logarithmic curve",
        "description": "Complex ramp generator with smooth logarithmic curve that reaches it's destination within a threshold of -80dB. <o>evi_lagsmooth</o> is available in MSP as <o>evi.lagsmooth~</o>."
    },
    "constructor": {
        "inlets": "destination, ramp"
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "name": "destination",
            "type": "float",
            "optional": 1,
            "digestauto": "Value",
            "digest": "Input value to be smoothed."
        },
        {
            "id": 2,
            "name": "ramp",
            "type": "float",
            "optional": 1,
            "digestauto": "Time in milliseconds @min 0 @default 20",
            "digest": "Amount of time the value takes to reach it's destination. evi_lagsmooth is logarithmic and does not reach it's destination exactly."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "output",
            "type": "float",
            "optional": 1,
            "digestauto": "Ramp",
            "digest": "Smoothed output ramp, or target value if ramp is complete."
        }
    ],
    "attributes": [],
    "seealso": [
        {
            "name": "evi_logsmooth",
            "display": "evi_logsmooth"
        },
