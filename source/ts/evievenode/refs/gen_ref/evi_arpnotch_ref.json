        },
        {
            "id": 3,
            "name": "resonance",
            "type": "float",
            "optional": 1,
            "digest": "0..1 @default 0.707107"
        },
        {
            "id": 4,
            "name": "morph",
            "type": "float",
            "optional": 1,
            "digest": "0..1 @default 0.5"
