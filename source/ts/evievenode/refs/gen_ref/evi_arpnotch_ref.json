{
    "object": {
        "name": "evi_arpnotch",
        "category": "",
        "digest": "TEXT_HERE",
        "description": "[evi_arpnotch.gendsp] requires: [evi_tanh.genexpr, evi_smooth.genexpr]"
    },
    "constructor": {
        "inlets": "input, freq, resonance, morph"
    },
    "includes": [
        "evi_tanh.genexpr",
        "evi_smooth.genexpr"
    ],
