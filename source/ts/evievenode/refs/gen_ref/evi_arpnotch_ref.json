            "description": "",
            "default": {
                "type": "int",
                "value": "1"
            }
        },
        {
            "name": "morphsmooth",
            "type": "int",
            "digest": "@min 0, @max 333",
            "description": "",
            "default": {
                "type": "int",
                "value": "0"
            }
        }
    ],
    "seealso": [
