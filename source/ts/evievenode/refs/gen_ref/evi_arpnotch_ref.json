{
    "object": {
        "name": "evi_arpnotch",
        "child": "evi.arpnotch~",
        "category": "evieve",
        "digest": "A nonlinear SVF Notch filter which can morph between LP..Notch..HP",
        "description": "A nonlinear 12dB SVF filter which can smoothly morph between LP..Notch..HP, thus making it a partial emulation of the ARP 1047 filter/resonator. The morphing through notch is resonance-compensated so that the analog notch is always strong."
    },
    "constructor": {
        "inlets": "input, freq, resonance, morph"
    },
    "includes": [
        "evi_tanh",
        "evi_smooth_bank"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be filtered."
        },
        {
            "id": 2,
            "name": "freq",
            "type": "float",
            "optional": 1,
            "digestauto": "in Hz (default) or Pitch depending on 'cutoffmode' attribute @default 1000",
            "digest": "Cutoff frequency in Hz (default) or Pitch depending on the @cutoffmode attribute."
        },
        {
            "id": 3,
            "name": "resonance",
            "type": "float",
            "optional": 1,
            "digestauto": "0..1 @default 0.707107",
            "digest": "Resonance 0..1, can self oscillate at '1' depending on current morph factor (inlet 4)."
        },
        {
            "id": 4,
            "name": "morph",
            "type": "float",
            "optional": 1,
            "digestauto": "0..1 @default 0.5",
            "digest": "Smoothly interpolate 0..1 between lowpass..notch..highpass output."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "arp",
            "type": "float",
            "optional": 1,
            "digestauto": "Mix (LP..BR..HP via 'morph' inlet)",
            "digest": "Nonlinear lowpass..notch..highpass output."
        }
    ],
    "attributes": [
        {
            "name": "cutoffmode",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "Switch cutoff frequency (inlet 2) between Pitch (on) or Hz (default off).",
            "default": {
                "type": "int",
                "value": "0"
            }
        },
        {
            "name": "morphsmooth",
            "type": "float",
            "digest": "@min 0, @max 333",
            "description": "If morphsmooth > 0, the 'Morph' control (inlet 4) will be internally smoothed by this time. Default off.",
            "default": {
                "type": "float",
                "value": "0."
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_svfsmooth",
            "display": "evi_svfsmooth"
        },
        {
            "name": "evi_svfsynth",
            "display": "evi_svfsynth"
        },
        {
            "name": "evi_filter_morph",
            "display": "evi_filter_morph"
        },
        {
            "name": "evi_svf",
            "display": "evi_svf"
        },
        {
            "name": "evi_korgms20",
            "display": "evi_korgms20"
        },
        {
            "name": "evi_ladder_transistor",
            "display": "evi_ladder_transistor"
        }
    ]
}