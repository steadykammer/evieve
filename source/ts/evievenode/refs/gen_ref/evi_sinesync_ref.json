{
    "object": {
        "name": "evi_sinesync",
        "child": "",
        "category": "evieve",
        "digest": "A dubious simplified sine sync",
        "description": "A dubious simplified sine sync, not very good, but sometimes it sounds nice. I think this is based on a Puckette thing."
    },
