            "id": 1,
            "name": "main",
            "type": "float",
            "optional": 1,
            "digestauto": "Frequency in Hz",
            "digest": "Main oscillator frequency in Hz."
        },
        {
            "id": 2,
            "name": "sub",
            "type": "float",
            "optional": 1,
            "digestauto": "Frequency in Hz",
            "digest": "Sub oscillator frequency in Hz."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "sine",
            "type": "float",
            "optional": 1,
            "digestauto": "Sync Osc",
            "digest": "The sine sync oscillator output."
        },
        {
            "id": 2,
            "name": "main",
            "type": "float",
            "optional": 1,
            "digestauto": "Phase 0..1",
            "digest": "Main oscillator phase 0..1"
        },
        {
            "id": 3,
            "name": "sine",
            "type": "float",
            "optional": 1,
            "digestauto": "Phase 0..1",
            "digest": "Phase post shaping used to drive the internal Sine, 0..1"
        }
    ],
    "attributes": [
