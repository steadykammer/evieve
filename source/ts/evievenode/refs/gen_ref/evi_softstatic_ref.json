{
    "object": {
        "name": "evi_softstatic",
        "child": "evi.softstatic~",
        "category": "evieve",
        "digest": "Static antialiased soft clipping harmonics generator",
        "description": "A choice of two similar but different antialiased soft-ish / hard-ish static clipping algorithms"
    },
    "constructor": {
        "inlets": "audio"
    },
    "includes": [
        "evi_adaa"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "to be soft clipped",
            "digest": "Audio input is expected not to exceed -1..1"
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "antialiased",
            "type": "float",
            "optional": 1,
            "digestauto": "soft clipped output",
            "digest": "Output is waveshaped and antialiased"
        }
    ],
    "attributes": [
        {
            "name": "algo",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "Select algorithm type 1 (0) or algorithm type 2 (1). Type 1 is 'harder' with clearer harmonics, type 2 is 'softer' and a bit more bassy.",
            "default": {
                "type": "int",
                "value": "0"
            }
        },
        {
            "name": "softBeta",
            "type": "float",
            "digest": "@min 2, @max 32",
            "description": false,
            "default": {
                "type": "float",
                "value": "4."
            }
        },
        {
            "name": "softC",
            "type": "float",
            "digest": "@min 0.64, @max 1.4",
            "description": false,
            "default": {
                "type": "float",
                "value": "sqrt1_2"
            }
        },
        {
            "name": "softH",
            "type": "float",
            "digest": "@min 0.01, @max 2",
            "description": false,
            "default": {
                "type": "float",
                "value": "sqrt1_2"
            }
        },
        {
            "name": "softR",
            "type": "float",
            "digest": "@min 0.01, @max 0.99",
            "description": false,
            "default": {
                "type": "float",
                "value": "sqrt1_2"
            }
        },
        {
            "name": "softRatio",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": false,
            "default": {
                "type": "float",
                "value": "sqrt1_2"
            }
        },
        {
            "name": "softS",
            "type": "float",
            "digest": "@min 0, @max 0.05",
            "description": false,
            "default": {
                "type": "float",
                "value": "0.01"
            }
        }
    ],
    "seealso": [
        {
            "name": "",
            "display": ""
        },
        {
            "name": "evi_squeeze",
            "display": "evi_squeeze"
        },
        {
            "name": "evi_rectify",
            "display": "evi_rectify"
        },
        {
            "name": "evi_hardclip",
            "display": "evi_hardclip"
        },
        {
            "name": "evi_softclip",
            "display": "evi_softclip"
        },
        {
            "name": "evi_shaper",
            "display": "evi_shaper"
        },
        {
            "name": "evi_sinfold",
            "display": "evi_sinfold"
        },
        {
            "name": "evi_clipasym",
            "display": "evi_clipasym"
        },
        {
            "name": "evi_overdrive_sqrt",
            "display": "evi_overdrive_sqrt"
        },
        {
            "name": "evi_overdrive_atan",
            "display": "evi_overdrive_atan"
        },
        {
            "name": "evi_overdrive_tanh",
            "display": "evi_overdrive_tanh"
        },
        {
            "name": "evi_rcfilter",
            "display": "evi_rcfilter"
        }
    ]
}