{
    "object": {
        "name": "evi_expsmooth",
        "child": "",
        "category": "evieve",
        "digest": "Exponential signal smoother",
        "description": "A simple and efficient ramp generator with exponential curve and ramp time specified in milliseconds."
    },
    "constructor": {
        "inlets": "destination, ramp"
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "name": "destination",
            "type": "float",
            "optional": 1,
            "digestauto": "Value",
            "digest": "Input value to be smoothed."
        },
        {
            "id": 2,
            "name": "ramp",
            "type": "float",
            "optional": 1,
            "digestauto": "Time in milliseconds @min 1",
            "digest": "Amount of time the value takes to reach it's destination. evi_expsmooth is exponential and does not reach it's destination exactly."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "output",
            "type": "float",
            "optional": 1,
            "digestauto": "Ramp",
            "digest": "Smoothed output ramp, or target value if ramp is complete."
        }
    ],
