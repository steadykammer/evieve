{
    "object": {
        "name": "evi_multimode",
        "child": "evi.multimode~",
        "category": "evieve",
        "digest": "Simultaneous outputs for all filters available from a linear TPT SVF",
        "description": "A multimode SVF similar to <o>evi.svf~</o>. Seven simultaneous outputs for all filters available from a linear TPT SVF topology that use just Cutoff and Q, with optional cutoff and resonance smoothing baked in."
    },
    "constructor": {
        "inlets": "input, cutoff, q"
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be filtered."
        },
        {
            "id": 2,
            "name": "cutoff",
            "type": "float",
            "optional": 1,
            "digestauto": "in Hz @min 1 @max samplerate*0.5 @default 500.",
            "digest": "Cutoff frequency in Hz."
        },
        {
            "id": 3,
            "name": "q",
            "type": "float",
            "optional": 1,
            "digestauto": "@min 0.05 @default 0.707107",
            "digest": "Q, typically clamped in the range 0.05..20, but the 'Resonant' filter type can take a much higher Q."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "low",
            "type": "float",
            "optional": 1,
            "digest": "Lowpass output."
        },
        {
            "id": 2,
            "name": "band",
            "type": "float",
            "optional": 1,
            "digest": "Bandpass output."
        },
        {
            "id": 3,
            "name": "high",
            "type": "float",
            "optional": 1,
            "digest": "Highpass output."
        },
        {
            "id": 4,
            "name": "peak",
            "type": "float",
            "optional": 1,
            "digest": "Peaking filter output."
        },
        {
            "id": 5,
            "name": "notch",
            "type": "float",
            "optional": 1,
            "digest": "Notch filter output."
        },
        {
            "id": 6,
            "name": "reson",
            "type": "float",
            "optional": 1,
            "digest": "Resonant bandpass output."
        },
        {
            "id": 7,
            "name": "allpass",
            "type": "float",
            "optional": 1,
            "digest": "Allpass output."
        }
    ],
    "attributes": [
        {
            "name": "cutoffsmooth",
            "type": "float",
            "digest": "@min 0, @max 100",
            "description": "Optionally smooth the cutoff (inlet 2). Also affected by @cutoffsmoothbase.",
            "default": {
                "type": "float",
                "value": "20."
            }
        },
        {
            "name": "cutoffsmoothbase",
            "type": "float",
            "digest": "@min 0, @max 10",
            "description": "Internally the cutoff smoother is an instantiation of 'evi.cfsmooth~' and therefore additionally takes a Hz inlet to smooth the cutoff. @see the 'evi.cfsmooth~' helpfile for details.",
            "default": {
                "type": "float",
                "value": "2."
            }
        },
        {
            "name": "ressmooth",
            "type": "float",
            "digest": "@min 0, @max 100",
            "description": "Optionally smooth the resonance (inlet 3).",
            "default": {
                "type": "float",
                "value": "10."
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_svf",
            "display": "evi_svf"
        },
        {
            "name": "evi_filter",
            "display": "evi_filter"
        },
        {
            "name": "evi_svfinputmix",
            "display": "evi_svfinputmix"
        },
        {
            "name": "evi_onepole",
            "display": "evi_onepole"
        }
    ]
}