{
    "object": {
        "name": "evi_eq3",
        "child": "evi.eq3~",
        "category": "evieve",
        "digest": "Mono TPT 3-band EQ with audio rate modulation of all parameters",
        "description": "A 3-band EQ made up of 3 TPT SVF EQ filters, each with selectable filter type. The feature of this EQ is that all filter parameters are available on inlets, so the whole EQ can optionally be audio rate modulated. Because this is based on TPT filters, modulation will remain clean and stable at audio rate, unlike biquads."
    },
    "constructor": {
        "inlets": "input, freq, db, q, freq, db, q, freq, db, q"
    },
    "includes": [
        "evi_svfs",
        "evi_svfs_lto"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be EQ-ed."
        },
        {
            "id": 2,
            "name": "freq",
            "type": "float",
            "optional": 1,
            "digestauto": "1 @min 10 @max 18000 @default 250",
            "digest": "Band 1 frequency in Hz."
        },
        {
            "id": 3,
            "name": "db",
            "type": "float",
            "optional": 1,
            "digestauto": "1 @min -24 @max 24 @default 0",
            "digest": "Band 1 gain in dB."
        },
        {
            "id": 4,
            "name": "q",
            "type": "float",
            "optional": 1,
            "digestauto": "1 @min 0.1 @max 18 @default 1",
            "digest": "Band 1 Q."
        },
        {
            "id": 5,
            "name": "freq",
            "type": "float",
            "optional": 1,
            "digestauto": "2 @min 10 @max 18000 @default 1000",
            "digest": "Band 2 frequency in Hz."
        },
        {
            "id": 6,
            "name": "db",
            "type": "float",
            "optional": 1,
            "digestauto": "2 @min -24 @max 24 @default 0",
            "digest": "Band 2 gain in dB."
        },
        {
            "id": 7,
            "name": "q",
            "type": "float",
            "optional": 1,
            "digestauto": "2 @min 0.1 @max 18 @default 0.707107",
            "digest": "Band 2 Q."
        },
        {
            "id": 8,
            "name": "freq",
            "type": "float",
            "optional": 1,
            "digestauto": "3 @min 10 @max 18000 @default 4000",
            "digest": "Band 3 frequency in Hz."
        },
        {
            "id": 9,
            "name": "db",
            "type": "float",
            "optional": 1,
            "digestauto": "3 @min -24 @max 24 @default 0",
            "digest": "Band 3 gain in dB."
        },
        {
            "id": 10,
            "name": "q",
            "type": "float",
            "optional": 1,
            "digestauto": "3 @min 0.1 @max 18 @default 1",
            "digest": "Band 3 Q."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "3",
            "type": "float",
            "optional": 1,
            "digest": "EQ-ed audio output."
        }
    ],
    "attributes": [
        {
            "name": "band1filter",
            "type": "int",
            "digest": "@min 0, @max 7",
            "description": "Band 1 filter type by integer index: 0=Bypass, 1=Highpass, 2=Lowshelf, 3=Bell, 4=BellAdaptiveQ, 5=Notch, 6=Highshelf, 7=Lowpass",
            "default": {
                "type": "int",
                "value": "2"
            }
        },
        {
            "name": "band2filter",
            "type": "int",
            "digest": "@min 0, @max 7",
            "description": "Band 2 filter type by integer index: 0=Bypass, 1=Highpass, 2=Lowshelf, 3=Bell, 4=BellAdaptiveQ, 5=Notch, 6=Highshelf, 7=Lowpass",
            "default": {
                "type": "int",
                "value": "3"
            }
        },
        {
            "name": "band3filter",
            "type": "int",
            "digest": "@min 0, @max 7",
            "description": "Band 3 filter type by integer index: 0=Bypass, 1=Highpass, 2=Lowshelf, 3=Bell, 4=BellAdaptiveQ, 5=Notch, 6=Highshelf, 7=Lowpass",
            "default": {
                "type": "int",
                "value": "6"
            }
        },
        {
            "name": "smooth",
            "type": "float",
            "digest": "@min 0, @max 333",
            "description": "Smooth the mixing gains of the filters efficiently at the core of the DSP. With these TPT SVF filters this will usually be the only smoothing required. Smoothing can be turned off if audio rate modulating all inputs.",
            "default": {
                "type": "float",
                "value": "15.333"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_eq5",
            "display": "evi_eq5"
        },
        {
            "name": "evi_eq8",
            "display": "evi_eq8"
        },
        {
            "name": "evi_filter_eq",
            "display": "evi_filter_eq"
        }
    ]
}