{
    "object": {
        "name": "evi_clipasym",
        "child": "",
        "category": "evieve",
        "digest": "Variable asymmetric clipping",
        "description": "Vaguely inspired by the nonlinear part of the K35 chip in the Korg MS10 filter. This has similar asymmetric nonlinear behaviour. The anti-aliasing here is not as successful as in other evieve objects, so be careful not to drive it too hard."
    },
    "constructor": {
        "inlets": "audio, asymmetry"
    },
    "includes": [
        "evi_smooth",
        "evi_waveshaping"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "In",
            "digest": ""
        },
        {
            "id": 2,
            "name": "asymmetry",
            "type": "float",
            "optional": 1,
            "digestauto": "@min 0 @max 1 @default 0.5",
            "digest": "The amount of asymmetry in the distortion signal."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "saturated",
            "type": "float",
            "optional": 1,
            "digestauto": "Audio Out",
            "digest": "Audio output distortion."
        }
    ],
    "attributes": [
        {
            "name": "bounds",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "If on (the default), output is attenuated so that full range input does not go out of bounds. If off, there is no protection, but often this is not needed anyway.",
            "default": {
                "type": "int",
                "value": "1"
            }
        },
        {
            "name": "nonlin",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "Select the internal nonlinearity used. 0=cubic (more Korg-like), 1=tanh (harder).",
            "default": {
                "type": "int",
                "value": "0"
            }
        },
        {
            "name": "smooth",
            "type": "float",
            "digest": "@min 0, @max 226.66",
            "description": "Optionally smooth the the internal coefficients calculations. Turn this off (0) if audio rate modulating inlet 2 ('Asymmetry')",
            "default": {
                "type": "float",
                "value": "22.666"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_korgms10",
            "display": "evi_korgms10"
        },
        {
            "name": "evi_warmer",
            "display": "evi_warmer"
        },
        {
            "name": "evi_sinfold",
            "display": "evi_sinfold"
        },
        {
            "name": "evi_shaper",
            "display": "evi_shaper"
        },
        {
            "name": "evi_softclip",
            "display": "evi_softclip"
        },
        {
            "name": "evi_hardclip",
            "display": "evi_hardclip"
        }
    ]
}