{
    "object": {
        "name": "evi_reson",
        "child": "evi.reson~",
        "category": "evieve",
        "digest": "Reimplementation of MSP <o>reson~</o> as a TPT filter",
        "description": "A linear TPT resonant bandpass filter. <o>evi.reson~</o> has exactly the same response as MSP <o>reson~</o> and can therefore be used as a drop in replacement, but has better modulation characteristics with FM-able center frequency as well as optional auto gain compensation."
    },
    "constructor": {
        "inlets": "input, input, center, resonance"
    },
    "includes": [
        "evi_svfs_tpt_filters"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be filtered."
        },
        {
            "id": 2,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digestauto": "Gain Linear @default 1",
            "digest": "Linear gain of the filter."
        },
        {
            "id": 3,
            "name": "center",
            "type": "float",
            "optional": 1,
            "digestauto": "Frequency in Hz @min 1 @max samplerate*0.5",
            "digest": "Center frequency of the resonant peak."
        },
        {
            "id": 4,
            "name": "resonance",
            "type": "float",
            "optional": 1,
            "digestauto": "@min 0.05 @default 1",
            "digest": "Filter resonance. Can be increasingly high values (e.g. 10000). See @compensate attribute for compensation."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "filtered",
            "type": "float",
            "optional": 1,
            "digestauto": "Output",
            "digest": "Resonant audio output."
        }
    ],
    "attributes": [
        {
            "name": "compensate",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "Automatically compensate for the perceived reduction in gain (energy) when Q values are very high. Typically this should be on but is off by default to match MSP.",
            "default": {
                "type": "int",
                "value": "0"
            }
        },
        {
            "name": "smooth",
            "type": "float",
            "digest": "@min 0, @max 333",
            "description": "Smooth the mixing gains of the filter efficiently at the core of the DSP. With these TPT SVF filters this will usually be the only smoothing required. By default smoothing is off.",
            "default": {
                "type": "float",
                "value": "0."
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_lores",
            "display": "evi_lores"
        },
        {
            "name": "evi_onepole",
            "display": "evi_onepole"
        },
        {
            "name": "evi_svf",
            "display": "evi_svf"
        },
        {
            "name": "evi_cross",
            "display": "evi_cross"
        },
        {
            "name": "evi_phaseshift",
            "display": "evi_phaseshift"
        },
        {
            "name": "evi_hilbert",
            "display": "evi_hilbert"
        },
        {
            "name": "evi_allpass",
            "display": "evi_allpass"
        },
        {
            "name": "evi_comb",
            "display": "evi_comb"
        },
        {
            "name": "evi_teeth",
            "display": "evi_teeth"
        },
        {
            "name": "evi_bp",
            "display": "evi_bp"
        },
        {
            "name": "evi_vcf",
            "display": "evi_vcf"
        }
    ]
}