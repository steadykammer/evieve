        {
            "name": "feedback",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "Normalised 0..1, this is the key parameter of 'evi.sustainverb~'. It controls the amount of reverberation in the system, but the higher the value the more towards foreverersustain the sound becomes.",
            "default": {
                "type": "float",
                "value": "sqrt1_2"
            }
        },
        {
            "name": "highpass",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "Normalised 0..1, this can be a switch or interpolated, both are smoothed. Add in a highjpass filter to the FDN. This makes the sound of the FDN more reverb-like and tames low frequency recirculation, but also curtails the ability to forever sustain.",
            "default": {
                "type": "float",
                "value": "0."
            }
        },
        {
            "name": "outgain",
            "type": "float",
            "digest": "@min -80, @max 20",
            "description": "In dB -80..20, the gain in dB of the FDN recirculation.",
            "default": {
                "type": "float",
                "value": "-3."
            }
        },
        {
            "name": "smoothtime",
            "type": "float",
            "digest": "@min 1, @max 500",
            "description": "Set the smoothing time in ms of all the internal parameter smoothing functions.",
            "default": {
                "type": "float",
                "value": "43."
            }
