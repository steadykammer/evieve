            "name": "early",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "Normalised 0..1, this can be a switch or interpolated, both are smoothed. Add in early reflections. This makes the sound of the FDN more reverb-like.",
            "default": {
                "type": "float",
                "value": "0."
            }
        },
