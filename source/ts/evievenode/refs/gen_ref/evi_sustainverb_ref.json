{
    "object": {
        "name": "evi_sustainverb",
        "child": "",
        "category": "evieve",
        "digest": "16x16 FDN reverb with smooth sustaining effect",
        "description": "This is just Miller Puckette's 'rev3~' but with additional reverb features such as early reflections, filtering improvements and smoothing of parameters whilst maintaining the ability to forever sustain like the original. <o>evi_sustainverb</o> also includes multichannel taps of the FDN which can be very useful for surround-ish effects processing. In gen~ alone this is a bit tricky to use as it requires compuation of delay time externally. Defaults are for running at 48kHz samplerate."
    },
    "constructor": {
        "inlets": "audio, audio"
    },
    "includes": [
        "evi_reverb_library"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "In Left",
            "digest": "Audio input left."
        },
        {
            "id": 2,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "In Right",
            "digest": "Audio input right."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "reverb",
            "type": "float",
            "optional": 1,
            "digestauto": "Left",
            "digest": "Full reverb output left, post dry/wet."
        },
        {
            "id": 2,
            "name": "reverb",
            "type": "float",
            "optional": 1,
            "digestauto": "Right",
            "digest": "Full reverb output right, post dry/wet."
        },
        {
            "id": 3,
            "name": "fdn",
            "type": "float",
            "optional": 1,
            "digestauto": "Left",
            "digest": "FDN only output left (only wet)."
        },
        {
            "id": 4,
            "name": "fdn",
            "type": "float",
            "optional": 1,
            "digestauto": "Right",
            "digest": "FDN only output right (only wet)."
        },
        {
            "id": 5,
            "name": "aux",
            "type": "float",
            "optional": 1,
            "digestauto": "Tap 1",
            "digest": "Decorrellated auxilliary FDN output 1"
        },
        {
            "id": 6,
            "name": "aux",
            "type": "float",
            "optional": 1,
            "digestauto": "Tap 2",
            "digest": "Decorrellated auxilliary FDN output 2"
        },
        {
            "id": 7,
            "name": "aux",
            "type": "float",
            "optional": 1,
            "digestauto": "Tap 3",
            "digest": "Decorrellated auxilliary FDN output 3"
        },
        {
            "id": 8,
            "name": "aux",
            "type": "float",
            "optional": 1,
            "digestauto": "Tap 4",
            "digest": "Decorrellated auxilliary FDN output 4"
        }
    ],
    "attributes": [
        {
            "name": "crossover",
            "type": "float",
            "digest": "@min 10, @max 10000",
            "description": "Frequency in Hz at which 'damp' filters take effect.",
            "default": {
                "type": "float",
                "value": "3000."
            }
        },
        {
            "name": "damp",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "Normalised 0..1, amount of damping in the FDN. 0=no damping, 1=maximum damping.",
            "default": {
                "type": "float",
                "value": "0.2"
            }
        },
        {
            "name": "delayTime1 \t",
            "type": "int",
            "digest": "@min 1, @max 25056\t",
