{
    "object": {
        "name": "evi_logattackdecay",
        "child": "",
        "category": "evieve",
        "digest": "Attack/decay envelope follower",
        "description": "Logarithmic attack/decay envelope follower / smoother. <o>evi_logattackdecay</o> is available in MSP as <o>evi.logattackdecay~</o>."
    },
    "constructor": {
        "inlets": "value, attack, decay"
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "name": "value",
            "type": "float",
            "optional": 1,
            "digestauto": "to Follow",
            "digest": "evi_logattackdecay will follow this input value with the given attack and decay times."
        },
        {
            "id": 2,
            "name": "attack",
            "type": "float",
            "optional": 1,
            "digestauto": "Time in milliseconds @min 0",
            "digest": "Amount of time the envelope takes to attack. evi_logattackdecay is logarithmic and does not attack in this time exactly."
        },
        {
            "id": 3,
            "name": "decay",
            "type": "float",
            "optional": 1,
            "digestauto": "Time in milliseconds @min 0",
            "digest": "Amount of time the envelope takes to decay. evi_logattackdecay is logarithmic and does not decay in this time exactly."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "output",
            "type": "float",
            "optional": 1,
            "digestauto": "Envelope",
            "digest": "Output envelope."
        }
    ],
