{
    "object": {
        "name": "evi_plateverb",
        "child": "",
        "category": "evieve",
        "digest": "Plate reverb based on <o>yafr2~</o> with additional filtering and smoothing",
        "description": "Based on <o>yafr2~</o> from MSP ('Plate reverb in the style of Griesinger' by Randy Jones). This version for evieve with dry/wet and eq added, as well as modifications for better filtering, interpolation and smoothing, and zero hold delay changes. Parameters normalised 0..1. Clickless and smooth changes possible for all parameters. In gen~ alone (as opposed to the MSP abstraction <o>evi.plateverb~</o>) this is tricky to use as the damping coefficients are produced externally via the 'evi_damp_coeffs.gendsp' abstraction. See 'evi_rcfilters.genexpr' for coefficients calculations alternatives."
    },
    "constructor": {
        "inlets": "in, nothing"
    },
    "includes": [
        "evi_reverb_library"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "in",
            "type": "float",
            "optional": 1,
            "digestauto": "Mono / In Left / In 1",
            "digest": "Audio input mono / left / 1, depending on @stereo attribute."
        },
        {
            "id": 2,
            "name": "nothing",
            "type": "float",
            "optional": 1,
            "digestauto": "/ In Right / In 2",
            "digest": "Audio input nothing / right / 2, depending on @stereo attribute."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "reverb",
            "type": "float",
            "optional": 1,
            "digestauto": "Left",
            "digest": "Reverb output left."
        },
        {
            "id": 2,
            "name": "reverb",
            "type": "float",
            "optional": 1,
            "digestauto": "Right",
            "digest": "Reverb output right."
        }
    ],
    "attributes": [
        {
            "name": "APGAIN1\t\t",
            "type": "float",
            "digest": "@min  0, @max  1",
            "description": false,
            "default": {
                "type": "float",
                "value": "  0.75"
            }
        },
        {
            "name": "APGAIN2\t\t",
            "type": "float",
            "digest": "@min  0, @max  1",
            "description": false,
            "default": {
                "type": "float",
                "value": "  0.625"
            }
        },
        {
            "name": "APGAIN3\t\t",
            "type": "symbol",
            "digest": "@min -1, @max  1",
            "description": false,
            "default": {
                "type": "symbol",
                "value": " -sqrt1_2"
            }
        },
        {
            "name": "APGAIN4\t\t",
            "type": "float",
            "digest": "@min  0, @max  1",
            "description": false,
            "default": {
                "type": "float",
                "value": "  0.5"
            }
        },
        {
            "name": "bypass",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "Flag 0/1, smooth bypass the reverb (1). Bypassing also CPU-mutes the internal DSP.",
            "default": {
                "type": "int",
                "value": "0"
            }
        },
        {
            "name": "damp",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "pre-warped frequency (a 0..1) (default 6593Hz @48kHz)",
            "default": {
                "type": "float",
                "value": "0.67682"
            }
        },
        {
            "name": "decay",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "Normalised 0..1, one of the original parameters. Length of reverb late reflections decay. Higher values give a longer decay.",
            "default": {
                "type": "float",
                "value": "0.6"
            }
        },
        {
            "name": "delayTime1",
            "type": "int",
            "digest": "@min 1, @max 51142",
            "description": "In samples: floor(samplerate * 0.26636 + 0.5) + 1",
            "default": {
                "type": "int",
                "value": "12786"
            }
        },
        {
            "name": "delayTime2",
            "type": "int",
            "digest": "@min 1, @max 49911",
            "description": "In samples: floor(samplerate * 0.25995 + 0.5) + 1",
            "default": {
                "type": "int",
                "value": "12479"
            }
        },
        {
            "name": "diffuse",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "Normalised 0..1, one of the original parameters. Amount of diffuseness in the reflections. Effects times of multiple embedded delay lines.",
            "default": {
                "type": "float",
                "value": "0.3"
            }
        },
        {
            "name": "dry",
            "type": "float",
            "digest": "@min -90, @max 0",
            "description": "In dB -90..0, there is no 'dry/wet' in this reverb. Instead we have separate dry and wet gains. This dry gain controls the amount of gain applied to the unprocessed audio in the final mix.",
            "default": {
                "type": "float",
                "value": "-15."
            }
        },
        {
            "name": "highshelfG",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "Pre warped damping highshelf frequency coefficient normalised 0..1, see 'evi_rcfilters.genexpr' for coefficients calculators.",
            "default": {
                "type": "float",
                "value": "0.123758"
            }
        },
        {
            "name": "highshelfK",
            "type": "float",
            "digest": "@min -3, @max 1",
            "description": "Pre warped damping highshelf gain coefficient -3..1, see 'evi_rcfilters.genexpr' for coefficients calculators.",
            "default": {
                "type": "float",
                "value": "0."
            }
        },
        {
            "name": "lowshelfG",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "Pre warped damping lowshelf frequency coefficient normalised 0..1, see 'evi_rcfilters.genexpr' for coefficients calculators.",
            "default": {
                "type": "float",
                "value": "0.032214"
            }
        },
        {
            "name": "lowshelfK",
            "type": "float",
            "digest": "@min -3, @max 1",
            "description": "Pre warped damping lowshelf gain coefficient -3..1, see 'evi_rcfilters.genexpr' for coefficients calculators.",
            "default": {
                "type": "float",
                "value": "0."
            }
        },
        {
            "name": "pan",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "Normalised 0..1, input panning if 'stereo' attribute == 0 (mono). 0.5=center.",
            "default": {
                "type": "float",
                "value": "0.5"
            }
        },
        {
            "name": "size",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": "Normalised 0..1, one of the original parameters. The perceived size of the reverb. ",
            "default": {
                "type": "float",
                "value": "0.3"
            }
        },
        {
            "name": "smoothtime",
            "type": "float",
            "digest": "@min 1, @max 500",
            "description": "Set the smoothing time in ms of all the internal parameter smoothing functions.",
            "default": {
                "type": "float",
                "value": "49."
            }
        },
        {
            "name": "stereo",
            "type": "int",
            "digest": "@min 0, @max 2",
            "description": "Select 0, 1, 2. No smoothing. This affects the audio inputs of the reverb (output is always stereo), notably the internal summing of the two inputs. 0=mono in (with pan control), 1=stereo in, 2=two separate channels in.",
            "default": {
                "type": "int",
                "value": "0"
            }
        },
        {
            "name": "SUMMUL\t\t",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": false,
            "default": {
                "type": "float",
                "value": "  0.14285714285714285"
            }
        },
        {
            "name": "SUMMUL05\t",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": false,
            "default": {
                "type": "float",
                "value": "  0.07142857142857142"
            }
        },
        {
            "name": "SUMMULSQ\t",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": false,
            "default": {
                "type": "float",
                "value": "  0.3779644730092272"
            }
        },
        {
            "name": "SUMMULINV\t",
            "type": "float",
            "digest": "@min 0, @max 1",
            "description": false,
            "default": {
                "type": "float",
                "value": "  0.8571428571428572"
            }
        },
        {
            "name": "wet",
            "type": "float",
            "digest": "@min -90, @max 0",
            "description": "In dB -90..0, there is no 'dry/wet' in this reverb. Instead we have separate dry and wet gains. This wet gain controls the amount of gain applied to the processed reverberation (late reflections) in the final mix.",
            "default": {
                "type": "float",
                "value": "-3."
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_algoverb",
            "display": "evi_algoverb"
        },
        {
            "name": "evi_backverb",
            "display": "evi_backverb"
        },
        {
            "name": "evi_freezeverb",
            "display": "evi_freezeverb"
        },
        {
            "name": "evi_gigaverb",
            "display": "evi_gigaverb"
        },
        {
            "name": "evi_mattaverb",
            "display": "evi_mattaverb"
        },
        {
            "name": "evi_sustainverb",
            "display": "evi_sustainverb"
        },
        {
            "name": "evi_zitaverb",
            "display": "evi_zitaverb"
        }
    ]
}