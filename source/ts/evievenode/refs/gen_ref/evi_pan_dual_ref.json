            "id": 1,
            "name": "left",
            "type": "float",
            "optional": 1,
            "digestauto": "Input",
            "digest": "Left audio input to be panned"
        },
        {
            "id": 2,
            "name": "right",
            "type": "float",
            "optional": 1,
            "digestauto": "Input",
            "digest": "Right audio input to be panned"
        },
        {
            "id": 3,
            "name": "panning1",
            "type": "float",
            "optional": 1,
            "digestauto": "0..1 @min 0 @max 1 @default 0.",
            "digest": "Pan 1 Amount 0..1, Pan input to outputs using an efficient cosine algorithm very close to a 'sqrt'."
        },
        {
            "id": 4,
            "name": "panning2",
            "type": "float",
            "optional": 1,
            "digestauto": "0..1 @min 0 @max 1 @default 1.",
            "digest": "Pan 2 Amount 0..1, Pan input to outputs using an efficient cosine algorithm very close to a 'sqrt'."
        }
