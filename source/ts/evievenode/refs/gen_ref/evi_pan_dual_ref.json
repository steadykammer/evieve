    "object": {
        "name": "evi_pan_dual",
        "child": "",
        "category": "evieve",
        "digest": "Pan audio signals, dual",
        "description": "Pan inputs to outputs using an efficient cosine algorithm very close to a 'sqrt'. <o>evi_pan_dual</o> is available in MSP as <o>evi.pan~</o> @mode 1"
    },
