{
    "object": {
        "name": "evi_logahr",
        "child": "",
        "category": "evieve",
        "digest": "Attack/hold/release envelope follower",
        "description": "Logarithmic attack/hold/release envelope follower / smoother. <o>evi_logahr</o> is available in MSP as <o>evi.logahr~</o>."
    },
    "constructor": {
        "inlets": "value, attack, hold, release"
    },
    "includes": [],
    "inlets": [
        {
            "id": 1,
            "name": "value",
            "type": "float",
            "optional": 1,
            "digestauto": "to Follow",
            "digest": "evi_logahr will follow this input value with the given attack, hold and release times."
        },
        {
            "id": 2,
            "name": "attack",
            "type": "float",
            "optional": 1,
            "digestauto": "Time in milliseconds @min 0",
            "digest": "Amount of time the envelope takes to attack. evi_logahr is logarithmic and does not attack in this time exactly."
        },
        {
            "id": 3,
            "name": "hold",
            "type": "float",
            "optional": 1,
            "digestauto": "Time in milliseconds @min 0",
            "digest": "Amount of time to hold the envelope after the attack stage and before the release stage (in milliseconds)."
        },
        {
            "id": 4,
            "name": "release",
            "type": "float",
            "optional": 1,
            "digestauto": "Time in milliseconds @min 0",
            "digest": "Amount of time the envelope takes to release. evi_logahr is logarithmic and does not release in this time exactly."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "output",
            "type": "float",
            "optional": 1,
            "digestauto": "Envelope",
            "digest": "Output envelope."
        }
    ],
    "attributes": [],
    "seealso": [
