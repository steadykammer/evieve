{
    "object": {
        "name": "evi_freezeverb",
        "child": "",
        "category": "evieve",
        "digest": "Classic freeverb reverb algorithm with buttery smooth freezing effect",
        "description": "This is a basic Schroeder reverb effect but with additional filtering and controls, very servicable for certain situations. But the main feature here is the ability to smoothly capture the input audio in the recirculating feedback path in a way which gives a forever freezing effect. This can be triggered and released with wet+dry or with wet alone. In gen~ alone (as opposed to the MSP abstraction <o>evi.freezeverb~</o>) this is tricky to use as the damping coefficients are produced externally via the <o>evi_damp_coeffs</o>.gendsp abstraction, and all static delay times are produced in an external javascript. If used at 48kHz samplerate the static delay times will work without further intervention. Overall it can still be used in gen~ alone providing some plumbing work is done. For an audio rate triggering version of this abstraction see <o>evi_freezeverbtrigger</o>.gendsp."
    },
    "constructor": {
        "inlets": "left, right"
    },
    "includes": [
        "evi_reverb_library"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "left",
            "type": "float",
            "optional": 1,
            "digestauto": "Signal Input",
            "digest": "Audio input left."
        },
        {
            "id": 2,
            "name": "right",
