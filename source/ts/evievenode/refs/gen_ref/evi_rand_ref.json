    "object": {
        "name": "evi_rand",
        "child": "",
        "category": "evieve",
        "digest": "Like MSP <o>rand~</o> as a gen abstraction",
        "description": "Generate a signal consisting of random values between -1..1 at a frequency specified at its input. Linearly interpolates between values. Additionally has cosine interpolated output (middle) and white noise sync source output (right)."
    },
