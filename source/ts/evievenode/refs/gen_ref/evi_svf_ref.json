{
    "object": {
        "name": "evi_svf",
        "child": "evi.svf~",
        "category": "evieve",
        "digest": "Reimplementation of MSP <o>svf~</o> as a TPT filter",
        "description": "Linear TPT state variable filter with simultaneous outputs. The SVF is a really useful swiss-army-knife filter block and is very efficient. The evieve SVF can have it's parameters dynamically modulated up to audio rate whilst remaining clean and alias free. The internal filter structure of <o>evi.svf~</o> is used in many of the other linear and nonlinear filters in the evieve package. Here it is presented in it's purest form to be as close to MSP <o>svf~</o> as possible. Note, here we use MSP-like ordering of outputs, but in all other evieve SVFs we use a different ordering."
    },
    "constructor": {
        "inlets": "input, cutoff, resonance"
    },
    "includes": [
        "evi_svfs",
        "evi_svfs_filters"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "input",
            "type": "float",
            "optional": 1,
            "digest": "Audio input to be filtered."
        },
        {
            "id": 2,
            "name": "cutoff",
            "type": "float",
            "optional": 1,
            "digestauto": "Frequency in Hz @min 1 @max samplerate*0.5",
            "digest": "Cutoff frequency in Hz."
        },
        {
            "id": 3,
            "name": "resonance",
            "type": "float",
            "optional": 1,
            "digestauto": "0..1 @min 0 @max 1",
            "digest": "Filter resonance 0..1."
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "lowpass",
            "type": "float",
            "optional": 1,
            "digestauto": "Output",
            "digest": "Lowpass filtered audio output."
        },
        {
            "id": 2,
            "name": "highpass",
            "type": "float",
            "optional": 1,
            "digestauto": "Output",
            "digest": "Highpass filtered audio output."
        },
        {
            "id": 3,
            "name": "bandpass",
            "type": "float",
            "optional": 1,
            "digestauto": "Output",
            "digest": "Bandpass filtered audio output."
        },
        {
            "id": 4,
            "name": "notch",
            "type": "float",
            "optional": 1,
            "digestauto": "Output",
            "digest": "Notch filtered audio output."
        }
    ],
    "attributes": [
        {
            "name": "oversample",
            "type": "int",
            "digest": "@min 0, @max 1",
            "description": "The 2x oversampling is most useful for lowpass and bandpass outputs usage. Engaging it more closely matches the frequency response of the MSP Chamberlain SVF for those filter types.",
            "default": {
                "type": "int",
                "value": "0"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_filter",
            "display": "evi_filter"
        },
