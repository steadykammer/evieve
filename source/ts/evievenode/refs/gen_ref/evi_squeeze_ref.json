{
    "object": {
        "name": "evi_squeeze",
        "child": "evi.squeeze~",
        "category": "evieve",
        "digest": "Antialiased quadratic signal shaper",
        "description": "<o>evi.squeeze~</o> is a simple passive audio signal quadratic shaper. <o>evi.squeeze~</o> is antialiased via anti derivative antialiasing, but is not designed for driving with high gain. Sadly this static waveshaper is expensive to compute."
    },
    "constructor": {
        "inlets": "audio"
    },
    "includes": [
        "evi_adaa"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "to be shaped",
            "digest": "Audio input is expected not to exceed -1..1"
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "antialiased",
            "type": "float",
            "optional": 1,
            "digestauto": "shaped output",
            "digest": "Output is waveshaped and antialiased"
        }
    ],
    "attributes": [
        {
            "name": "harmonics",
            "type": "int",
            "digest": "@min 0, @max 3",
            "description": "The shaper can be switched between soft..hard over 4 settings. 0 = the least harmonics (least squeezed), 3 = the most harmonics (most squeezed).",
            "default": {
                "type": "int",
                "value": "1"
            }
        }
    ],
    "seealso": [
        {
            "name": "evi_rectify",
            "display": "evi_rectify"
        },
