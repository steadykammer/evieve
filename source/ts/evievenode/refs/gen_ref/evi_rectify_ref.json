{
    "object": {
        "name": "evi_rectify",
        "child": "evi.rectify~",
        "category": "evieve",
        "digest": "Antialiased half wave signal rectifier",
        "description": "<o>evi.rectify~</o> is a simple passive audio signal rectifer. Rectification waveshapes an audio signal so that only positive vallues remain in the output giving a digital distorted effect. <o>evi.rectify~</o> is antialiased via anti derivative antialiasing and dcblocked, so that the resulting signal is cleaner and softer than a mathematical rectification."
    },
    "constructor": {
        "inlets": "audio"
    },
    "includes": [
        "evi_adaa"
    ],
    "inlets": [
        {
            "id": 1,
            "name": "audio",
            "type": "float",
            "optional": 1,
            "digestauto": "to be rectified",
            "digest": "Audio input is expected not to exceed -1..1"
        }
    ],
    "outlets": [
        {
            "id": 1,
            "name": "antialiased",
            "type": "float",
            "optional": 1,
            "digestauto": "rectified output",
            "digest": "Output is rectified, antialiased and dcblocked"
        }
    ],
