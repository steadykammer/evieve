<?xml version="1.0" encoding="utf-8" standalone="yes"?>

<?xml-stylesheet href="./_c74_ref.xsl" type="text/xsl"?>

<!--Data marked TEXT_HERE, INLET_TYPE, OUTLET_TYPE, ARG_NAME and ARG_TYPE need to be filled in-->
<c74object name="evi.expsmooth~" module="" category="">
	<digest>
		Exponential signal smoother
	</digest>
	<description>
		A simple and efficient ramp generator with exponential curve and ramp time specified in milliseconds.
	</description>
	<!--METADATA-->
	<metadatalist>
		<metadata name="author">
			Cycling '74
		</metadata>
		<metadata name="tag">
			evieve Objects
		</metadata>
	</metadatalist>
	<!--INLETS-->
	<inletlist>
		<inlet id="0" type="signal/float">
			<digest>
				Destination Value
			</digest>
			<description>
				Can take signal or float or int values to pass through the smoother.
			</description>
		</inlet>
		<inlet id="1" type="signal/float">
			<digest>
				Ramp Time in milliseconds
			</digest>
			<description>
				Amount of time the value takes to reach it's destination. evi.expsmooth~ is exponential and does not reach it's destination exactly.
			</description>
		</inlet>
	</inletlist>
	<!--OUTLETS-->
	<outletlist>
		<outlet id="0" type="signal">
			<digest>
				Output Ramp
			</digest>
			<description>
				Smoothed output ramp, or target value if ramp is complete.
			</description>
		</outlet>
	</outletlist>
	<!--ARGUMENTS-->
	<objarglist>
		<objarg id="0" name="initial" type="float/int" optional="1">
			<digest>
				Initial value
			</digest>
			<description>
				Set the initial value of the output
			</description>
		</objarg>
		<objarg id="1" name="ms" type="float/int" optional="1">
			<digest>
				Ramp time
			</digest>
			<description>
				Initial ramp time in ms
			</description>
		</objarg>
	</objarglist>
	<!--MESSAGES-->
	<methodlist>
		<method name="int">
			<arglist>
				<arg name="int" type="int" optional="1" />
			</arglist>
			<digest>
				Behaviour depends on inlet
			</digest>
			<description>
				In the left inlet, the destination value.
				In the right inlet, smoothing time in ms.
			</description>
		</method>
		<method name="float">
			<arglist>
				<arg name="float" type="float" optional="1" />
			</arglist>
			<digest>
				Behaviour depends on inlet
			</digest>
			<description>
				In the left inlet, the destination value.
				In the right inlet, smoothing time in ms.
			</description>
		</method>
		<method name="clear">
			<arglist />
			<digest>
				Clears the internal filter state
			</digest>
			<description>
				This should never be needed :-)
			</description>
		</method>
		<method name="signal">
			<arglist />
			<digest>
				Behaviour depends on inlet
			</digest>
			<description>
				In the left inlet, the destination value.
				In the right inlet, smoothing time in ms.
			</description>
		</method>
	</methodlist>
	<!--ATTRIBUTES-->
	<attributelist>
		<attribute name="time" get="1" set="1" type="float" size="1" alias="ms, smooth">
			<digest>
				Smoothing Time in ms
			</digest>
			<description>
				The ramp time in ms. Because evi.expsmooth~ is an inexact smoother, the destination cannot be guaranteed to reach it's value exactly in the alloted time.
			</description>
			<attributelist>
				<attribute name="basic" get="1" set="1" type="int" size="1" value="1" />
				<attribute name="label" get="1" set="1" type="symbol" size="1" value="Smoothing Time in ms" />
			</attributelist>
		</attribute>
	</attributelist>
	<!--EXAMPLE-->
	<examplelist>
		<example caption="" img="" />
	</examplelist>
	<!--SEEALSO-->
	<seealsolist>
		<seealso name="evi.cfsmooth~"></seealso>
		<seealso name="evi.lagsmooth~"></seealso>
		<seealso name="evi.logsmooth~"></seealso>
		<seealso name="evi_smooth" display="evi_smooth.genexpr" type="refpage"/>
	</seealsolist>
  <misc name="Discussion">
    <entry name="Keywords">
      <description>smooth, ramp</description>
    </entry>
  </misc>
</c74object>
