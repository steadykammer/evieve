<?xml version="1.0" encoding="utf-8" standalone="yes"?>

<?xml-stylesheet href="./_c74_ref.xsl" type="text/xsl"?>

<!--Data marked TEXT_HERE, INLET_TYPE, OUTLET_TYPE, ARG_NAME and ARG_TYPE need to be filled in-->
<c74object name="evi.logdecay~" module="evieve-ref" category="evieve">
	<digest>
		Decay envelope follower
	</digest>
	<description>
		Logarithmic decay envelope follower / smoother.
	</description>
	<!--METADATA-->
	<metadatalist>
		<metadata name="author">
			Cycling '74
		</metadata>
		<metadata name="tag">
			evieve Externals
		</metadata>
		<metadata name="tag">
			evieve Smooth
		</metadata>
		<metadata name="tag">
			evieve Dynamics
		</metadata>
	</metadatalist>
	<!--INLETS-->
	<inletlist>
		<inlet id="0" type="signal/float">
			<digest>
				Value to Follow
			</digest>
			<description>
				evi.logdecay~ will follow this input value with the given decay time.
			</description>
		</inlet>
		<inlet id="1" type="signal/float">
			<digest>
				Decay Time in milliseconds
			</digest>
			<description>
				Amount of time the value takes to decay. evi.logdecay~ is logarithmic and does not decay in this time exactly.
			</description>
		</inlet>
	</inletlist>
	<!--OUTLETS-->
	<outletlist>
		<outlet id="0" type="signal">
			<digest>
				Output Envelope
			</digest>
			<description>
				Output Envelope
			</description>
		</outlet>
	</outletlist>
	<!--ARGUMENTS-->
	<objarglist>
		<objarg id="0" name="decay" type="float" optional="1">
			<digest>
				Initial Decay Time in milliseconds
			</digest>
			<description>
				Amount of time the value takes to decay. evi.logdecay~ is logarithmic and does not decay in this time exactly.
			</description>
		</objarg>
	</objarglist>
	<!--MESSAGES-->
	<methodlist>
		<method name="int">
			<arglist>
				<arg name="int" type="int" optional="1" />
			</arglist>
			<digest>
				Behaviour depends on inlet
			</digest>
			<description>
				In the left inlet, the destination value.
				In the right inlet, decay time in ms.
			</description>
		</method>
		<method name="float">
			<arglist>
				<arg name="float" type="float" optional="1" />
			</arglist>
			<digest>
				Behaviour depends on inlet
			</digest>
			<description>
				In the left inlet, the destination value.
				In the right inlet, decay time in ms.
			</description>
		</method>
		<method name="clear">
			<arglist />
			<digest>
				Clears the internal filter state
			</digest>
			<description>
				This clears the state of the filter. This should never be needed :-)
			</description>
		</method>
		<method name="signal">
			<arglist />
			<digest>
				Behaviour depends on inlet
			</digest>
			<description>
				In the left inlet, the destination value.
				In the right inlet, decay time in ms.
			</description>
		</method>
	</methodlist>
	<!--ATTRIBUTES-->
	<attributelist>
		<attribute name="decay" get="1" set="1" type="float" size="1" alias="ms">
			<digest>
				Decay Time in ms
			</digest>
			<description>
				Amount of time the value takes to decay. evi.logdecay~ is logarithmic and does not decay in this time exactly.
			</description>
			<attributelist>
				<attribute name="basic" get="1" set="1" type="int" size="1" value="1" />
				<attribute name="label" get="1" set="1" type="symbol" size="1" value="Decay Time in ms" />
			</attributelist>
		</attribute>
	</attributelist>
	<!--EXAMPLE-->
	<examplelist>
		<example caption="" img="" />
	</examplelist>
	<!--SEEALSO-->
	<seealsolist>
		<seealso name="evi.logattackdecay~"></seealso>
		<seealso name="evi.logahr~"></seealso>
		<seealso name="evi.logsmooth~"></seealso>
		<seealso name="evi_smooth" display="evi_smooth.genexpr" type="refpage"></seealso>
		<seealso name="evi_env" display="evi_env.genexpr" type="refpage"></seealso>
	</seealsolist>
</c74object>
