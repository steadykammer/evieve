<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<?xml-stylesheet href="./_c74_ref.xsl" type="text/xsl"?>
<!--This is an automatically generated file. DO NOT EDIT THIS FILE DIRECTLY.-->
<c74object name="{{object.name}}" module="evieve-ref" category="{{object.category}}">
	<digest>
		{{object.digest}} <br />
	</digest>
	<description>
		{{object.description}} <br />
	</description>
	<!--METADATA-->
	<metadatalist>
		<metadata name="author"> {{metadata.author}} </metadata>
        {{#each metadata.tags}}
		<metadata name="tag"> {{this}} </metadata>
        {{/each}}
	</metadatalist>
	<!--INLETS-->
	<inletlist>
        {{#each inlets}}
		<inlet id="{{id}}" type="{{type}}">
			<digest>
				{{digest}}
			</digest>
			<description>
				{{description}}
			</description>
		</inlet>
        {{/each}}
	</inletlist>
	<!--OUTLETS-->
	<outletlist>
        {{#each outlets}}
		<outlet id="{{id}}" type="{{type}}">
			<digest>
				{{digest}}
			</digest>
			<description>
				{{description}}
			</description>
		</outlet>
        {{/each}}
	</outletlist>
	<!--ARGUMENTS-->
	<objarglist>
        {{#each arguments}}
		<objarg name="{{name}}" type="{{type}}" default="{{default}}" optional="{{optional}}">
			<digest>
				{{digest}}
			</digest>
			<description>
				{{description}}
			</description>
		</objarg>
        {{/each}}
	</objarglist>
	<!--MESSAGES-->
	<methodlist>
        {{#each messages}}
		<method name="{{name}}">
			<arglist>
                {{#each arg}}
				<arg name="{{name}}" type="{{type}}" units="{{units}}" optional="{{optional}}" />
                {{/each}}
			</arglist>
			<digest>
				{{digest}}
			</digest>
			<description>
				{{description}}
			</description>
		</method>
        {{/each}}
	</methodlist>
	<!--ATTRIBUTES-->
	<attributelist>
        {{#each attributes}}
		<attribute name="{{name}}" get="{{get}}" set="1" type="{{type}}" size="1">
			<digest>
				{{digest}}
			</digest>
			<description>
				{{description}}
			</description>
			<attributelist>
				<attribute name="default" get="{{default.get}}" set="1" type="{{type}}" size="1" value="{{default.value}}" />
			</attributelist>
		</attribute>
        {{/each}}
	</attributelist>
	<!--EXAMPLE-->
	<examplelist>
		<example caption="{{example.caption}}" img="{{example.image}}" />
	</examplelist>
	<!--SEEALSO-->
	<seealsolist>
        {{#each seealso}}
		<seealso name="{{this}}"> </seealso>
        {{/each}}
	</seealsolist>
    <!--DISCUSSION-->
	<discussion>
        {{object.discussion}} <br />
	</discussion>
</c74object>
