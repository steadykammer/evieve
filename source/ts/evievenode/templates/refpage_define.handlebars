<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<?xml-stylesheet href="./_c74_ref.xsl" type="text/xsl"?>
<!--This is an automatically generated file. DO NOT EDIT THIS FILE DIRECTLY.-->
<c74object name="{{object.name}}" module="evieve-ref" category="{{object.category}}"> <!-- no kind? -->
	<digest>
		{{{object.digest}}}
	</digest>
	<description>
		<b>{{object.name}}</b> is a 'max define' for the <o>{{object.parent}}</o>.gendsp gen{{object.tilde}} abstraction.
		Because {{object.name}} is a 'max define' it also accepts all messages and attributes that a <o>gen{{object.tilde}}</o> object does. <br />
		<br />
		{{{object.description}}} <br />
	</description>
	<!--METADATA-->
	<metadatalist>
		<metadata name="author">{{metadata.author}}</metadata>
		<metadata name="tag">evieve</metadata>
		<metadata name="tag">evieve GenAbstractions</metadata>
        {{#each metadata.tags}}
		<metadata name="tag">{{this}}</metadata>
        {{/each}}
	</metadatalist>
	<!--INLETS-->
	<inletlist>
        {{#each inlets}}
		<inlet id="{{id}}" type="{{type}}">
			<digest>
				Inlet #{{id}}: {{digest}}
			</digest>
			<description>
				{{description}}
			</description>
		</inlet>
        {{/each}}
	</inletlist>
	<!--OUTLETS-->
	<outletlist>
        {{#each outlets}}
		<outlet id="{{id}}" type="{{type}}">
			<digest>
				Outlet #{{id}}: {{digest}}
			</digest>
			<description>
				{{description}}
			</description>
		</outlet>
        {{/each}}
	</outletlist>
	<!--MESSAGES-->
	<methodlist>
        {{#each messages}}
		{{#if description}}
		<method name="{{name}}">
			<arglist>
                {{#each arg}}
				<arg name="{{name}}" type="{{type}}" units="{{units}}" optional="{{optional}}" />
                {{/each}}
			</arglist>
			<digest>
				{{digest}}
			</digest>
			<description>
				{{description}}
			</description>
		</method>
		{{/if}}
        {{/each}}
	</methodlist>
	<!--ATTRIBUTES-->
	<attributelist>
        {{#each attributes}}
		{{#if description}}
		<attribute name="{{name}}" get="{{get}}" set="1" type="{{type}}" min="{{default.min}}" max="{{default.max}}">
			<digest>
				{{digest}}
			</digest>
			<description>
				{{description}}
			</description>
			<attributelist>
				<attribute name="default" get="0" set="0" size="1" value="{{default.value}}" />
			</attributelist>
		</attribute>
		{{/if}}
        {{/each}}
	</attributelist>
	<!--EXAMPLE-->
	<examplelist>
		<example caption="{{example.caption}}" img="{{example.image}}" />
	</examplelist>
	<!--SEEALSO-->
	<seealsolist>
        {{#each seealso}}
		<seealso name="{{this}}"> </seealso>
        {{/each}}
	</seealsolist>
    <!--DISCUSSION-->
	<discussion>
        {{{object.discussion}}} <br />
	</discussion>
</c74object>
