<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<?xml-stylesheet href="./_c74_ref.xsl" type="text/xsl"?>
<!--This is an automatically generated file. DO NOT EDIT THIS FILE DIRECTLY.-->
<c74object name="{{name}}" module="gen-eviexpr" category="evieve" kind="rnboobject"> <!-- "rnboobject" == trick Max renderer for attributes ! -->
  <digest>
    A GenExpr file, part of 'evieve', for using via 'require()'
  </digest>
  <description>
    <b>{{name}}.genexpr</b> is a <m>.genexpr</m> file and is part of the <b>'evieve' Package</b>. <br />
    It is for using in a <o>gen.codebox~</o> or in another <m>.genexpr</m> file via the <m>require()</m> command. <br />
    By declaring <m>require("{{name}}.genexpr");</m> at the top of a codebox you can then access all of the functions included in this file. <br />
    {{#if requires}} <br />
    The <b>{{name}}.genexpr</b> file also requires: <br />
    {{#each requires}}
    {{this}} <br />
    {{/each}}
    {{/if}}
    <br />
    <b>About this File</b>: <br />
    {{{description}}} <br />
  </description>
  {{#if functions}}
  <misc name="GenExpr Functions">
    {{#each functions}}
    {{#if document}}
    <entry name="{{name}} ( )">
      <description>
        {{#if digest}}
        {{{digest}}} <br />
        <br />
        {{/if}}
        {{#each inputs}}
        <b>In {{id}}</b>: type=<i>{{kind}}</i>{{#if default includeZero=true}} (optional){{/if}}: {{name}}, {{#if default includeZero=true}}default: <b>{{default}}</b>, {{/if}}{{#if min includeZero=true}}min: {{min}}, {{/if}}{{#if max includeZero=true}}max: {{max}}, {{/if}}<i>{{digest}}</i> <br />
        {{/each}}

        {{#each returns}}
        <b>Return {{id}}</b>: {{name}}, {{digest}} <br />
        {{/each}}

      </description>
    </entry>
    {{/if}}
    {{/each}}
  </misc>
  {{else}}
  <misc name="No Functions (require-only file)">
  </misc>
  {{/if}}
  <metadatalist>
    <metadata name="author">Pete Dowling</metadata>
    <!-- only put one tag here for C74 harvesting algorithm issues -->
    <metadata name="tag">GenExpr</metadata>
  </metadatalist>
  <seealsolist>
    <!-- we use 'refpage' here not 'genrefpage' to trick Max -->
    {{#each seealso}}
    <seealso name="{{this}}" type="refpage"/>
    {{/each}}
  </seealsolist>
  <misc name="Discussion">
    <entry name="Keywords">
      <description>evieve, Gen Expr, evieve {{category}}</description>
    </entry>
  </misc>
</c74object>
