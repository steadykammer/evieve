{
	"maxdb" : 	{

		"filters" :
		[
    {{#each evi_maxdb.autocompletion}}
			{
				"filter" : "ignore",
				"path" : "package@{{../evieve}}:{{this}}",
				"kind" : "*"
			}{{#unless @last}},{{/unless}}
    {{/each}}
		],

		"exclusions" : [ {{#each evi_maxdb.browser}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}} ]
	}

}
