{
	"maxdb" : 	{

		"filters" :
		[
    {{#each auto}}
			{
				"filter" : "ignore",
				"path" : "package@evieve:{{this}}",
				"kind" : "*"
			}{{#unless @last}},{{/unless}}
    {{/each}}
		],

		"exclusions" : [ {{#each browser}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}} ]
	}

}
