                                                            "expression": "themecolor.theme_textcolor"
                                                        }
                                                    },
                                                    "text": "from the <link href=\"; max html_ref evi_svfs_filters\">evi_svfs_filters.genexpr</link> file",
                                                    "textcolor": [ 0.85, 0.85, 0.85, 1.0 ]
                                                }
                                            }
                                        ],
