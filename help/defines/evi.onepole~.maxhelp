                                            },
                                            {
                                                "box": {
                                                    "code": "\r\n// all onepole filters in evieve live in this .genexpr file:\r\nrequire(\"evi_rcfilters.genexpr\");\r\n\r\nParam   damp(0, min=-1, max=1);\r\n\r\n\r\n// the file includes frequency prewarping functions:\r\ng = rcPreWarp2(in2); // 'in2' is in Hz\r\n\r\n\r\n// the [evi.onepole~] object uses this filter:\r\nout1, out2, out3 = rcFilterLpApHp(in1, g);\r\n\r\n\r\n// or use just a lowpass:\r\nout4 = rcFilter(in1, g);\r\n\r\n\r\n// or just a highpass:\r\nout5 = rcFilterHp(in1, g);\r\n\r\n\r\n// there are many other useful filters in this require file, such as damping filters:\r\ngg, kk = rcDampCoeffs2(in2, damp);\r\nout6 = rcFilterDamp(in1, gg, kk);\r\n\r\n\r\n// etc\r\n\r\n",
                                                    "fontface": 0,
