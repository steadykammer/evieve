                                            },
                                            {
                                                "box": {
                                                    "code": "\r\n//require(\"evi_biquads.genexpr\");       // this file includes all biquad code in evieve\r\n//require(\"evi_biquads_coeffs.genexpr\");// this file includes all coefficients calcultors required to replicate [evi.biquadcoeff~]\r\nrequire(\"evi_biquads_union.genexpr\");   // contains all coefficients and selector blocks to more easily replicate [evi.biquadcoeff~]\r\n\r\n// for example\r\nParam   cutoff(1000);\r\nParam   gain(0);\r\nParam   q(sqrt1_2);\r\nParam   filter(13, min=0, max=40);\r\nfiltertype  = int(filter);\r\n                                        // linear gain input to core function!\r\na0, a1, a2, b1, b2 = eviBiquadCoeff(filtertype, cutoff, dbtoa(gain), q);    // this is the function that replicates [evi.biquadcoeff~]\r\n\r\n// Note that often you do not need access to all 40 filter types, and\r\n// in GenExpr code it would be more useful to pick and choose the types you need from \"evi_biquads_coeffs.genexpr\"\r\n\r\n// 5 biquad coefficients output\r\nout1 = a0;\r\nout2 = a1;\r\nout3 = a2;\r\nout4 = b1;\r\nout5 = b2;\r\n\r\n// Or for all-in-one you would require this file at the top of this codebox:\r\n//require(\"evi_biquads_filters.genexpr\");\r\n// ...and then call an actual biquad filter with the resultant coefficients:\r\n//out1 = biquadDf2(in1, a0, a1, a2, b1, b2);\r\n",
