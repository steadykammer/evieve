                            },
                            {
                                "box": {
                                    "background": 1,
                                    "fontname": "Lato",
                                    "fontsize": 13.0,
                                    "id": "obj-4",
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 10.0, 70.0, 660.0, 22.0 ],
                                    "text": "The evi.morph.tri~ algorithm can also be used inside GenExpr code",
                                    "varname": "digest_comment"
                                }
                            },
                            {
                                "box": {
                                    "id": "obj-5",
                                    "maxclass": "newobj",
                                    "numinlets": 2,
                                    "numoutlets": 1,
                                    "outlettype": [ "signal" ],
                                    "patcher": {
                                        "fileversion": 1,
                                        "appversion": {
                                            "major": 9,
                                            "minor": 2,
                                            "revision": 0,
                                            "architecture": "x64",
                                            "modernui": 1
                                        },
                                        "classnamespace": "dsp.gen",
                                        "rect": [ 59.0, 119.0, 951.0, 810.0 ],
                                        "integercoordinates": 1,
                                        "boxes": [
                                            {
                                                "box": {
                                                    "id": "obj-1",
                                                    "maxclass": "newobj",
                                                    "numinlets": 0,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 55.0, 26.0, 119.0, 22.0 ],
                                                    "text": "in 1 Frequency in Hz"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "id": "obj-2",
                                                    "maxclass": "newobj",
                                                    "numinlets": 0,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 666.0, 26.0, 230.0, 22.0 ],
                                                    "text": "in 2 Morph @min 0 @max 1 @default 0.5"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "code": "\r\n// all the 2-point polyblep evieve morph oscillators live in this .genexpr file:\r\nrequire(\"evi_polyblep_two.genexpr\");\r\n// we need this extra file for decorelation filters\r\nrequire(\"evi_polyblep_utility.genexpr\");\r\n\r\n\r\n// this 'morphTriSelect()' function is equivalent to the osc selector in 'evi_morph_tri'\r\nmorphTriSelect(phase, norm, morph, gain, wave)\r\n{\r\n    osc = 0;\r\n    if (wave == 1) {            // sawrect  // default\r\n        osc\t= morph_saw_tri_square(phase, norm, morph);\r\n    }\r\n    else if (wave == 2) {       // pulse\r\n        osc\t= morph_pulse_tri_pulse(phase, norm, morph);\r\n    }\r\n    else {  // (wave == 0)      // sawsaw\r\n        osc\t= morph_saw_tri_saw(phase, norm, morph);\r\n    }\r\n\r\n    return osc * gain;\r\n}\r\n\r\n\r\n// morph osc types:\r\n// 0=saw..tri..saw, 1=saw..tri..rect, 2=pulse..tri..pulse\r\nParam   oscillator(1, min=0, max=2);\r\nParam   compensate(1, min=0, max=2);    // decorrelation high frequency compensation filters, off/1/2\r\nwave    = int(oscillator);\r\nfilt\t= int(compensate);\r\n\r\nfreqInHz\t= in1;\r\nMorph\t    = in2;\r\n\r\nt\t\t    = phasor(freqInHz); \r\n\r\ndt\t\t\t= freqInHz / SAMPLERATE;\r\noscsync\t\t= delta(t) < 0;\r\ngain\t\t= 0.5;\r\n\r\nwv\t\t\t= latch(wave,\toscsync);\r\nft\t\t\t= latch(filt,\toscsync);\r\n\r\n\r\nosc = morphTriSelect(t, dt, Morph, gain, wv);\r\n\r\n\r\n// dcblock\r\nosc = dcblock(osc);\r\n\r\n// restore high frequencies options...\r\nif (ft > 0) {\r\n\tosc = decorelateOsc(osc);      // for Bleps ?\r\n\tif (ft > 1) {\r\n\t\tosc = decorelateOsc(osc);  // for Blamps / Bluhs ?\r\n\t}\r\n}\r\n\r\nout1\t= osc;\r\n\r\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-3",
                                                    "maxclass": "codebox",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 55.0, 75.0, 841.0, 665.0 ]
                                                }
                                            },
