                                            {
                                                "box": {
                                                    "code": "\r\n// svf EQs live here:\r\nrequire(\"evi_svfs_lto.genexpr\");\r\n// other svf single filter blocks live here:\r\n//require(\"evi_svfs_tpt_filters.genexpr\");\r\n\r\n\r\nParam       smooth(15.333, min=0, max=333);\r\n\r\nParam       band1filter(2, min=0, max=7);\r\nParam       band2filter(3, min=0, max=7);\r\nParam       band3filter(6, min=0, max=7);\r\nband1filt   = int(band1filter);\r\nband2filt   = int(band2filter);\r\nband3filt   = int(band3filter);\r\n\r\n\r\n// this is the stereo parametric 3 band function:\r\n//                                                  cutoff1, db1, Q1           cutoff2, db2, Q2           cutoff3, db3, Q3\r\nout1, out2 = eviParametricStereo3(in1, in2, band1filt, in3, in4, in5, band2filt, in6, in7, in8, band3filt, in9, in10, in11, smooth=smooth);\r\n\r\n\r\n// there is also a 2 band version:\r\n//                                                  cutoff1, db1, Q1          cutoff2, db2, Q2\r\nout3, out4 = eviParametricStereo2(in1, in2, band1filt, in3, in4, in5, band2filt, in6, in7, in8, smooth=smooth);\r\n\r\n\r\n// there is also a mono version (as in MSP):\r\n//                                  cutoff1, db1, Q1          cutoff2, db2, Q2          cutoff3, db3, Q3\r\nout5 = eviParametric3(in1, band1filt, in3, in4, in5, band2filt, in6, in7, in8, band3filt, in9, in10, in11, smooth=smooth);\r\n\r\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
