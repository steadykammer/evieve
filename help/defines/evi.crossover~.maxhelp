                                    "patching_rect": [ 10.0, 70.0, 660.0, 22.0 ],
                                    "text": "The evi.crossover~ algorithm can also be used inside GenExpr code",
                                    "varname": "digest_comment"
                                }
                            },
                            {
                                "box": {
                                    "id": "obj-5",
                                    "maxclass": "newobj",
                                    "numinlets": 2,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patcher": {
                                        "fileversion": 1,
                                        "appversion": {
                                            "major": 9,
                                            "minor": 2,
                                            "revision": 0,
                                            "architecture": "x64",
                                            "modernui": 1
                                        },
                                        "classnamespace": "dsp.gen",
                                        "rect": [ 59.0, 119.0, 859.0, 751.0 ],
                                        "integercoordinates": 1,
                                        "boxes": [
                                            {
                                                "box": {
                                                    "id": "obj-5",
                                                    "maxclass": "newobj",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 189.0, 707.0, 35.0, 22.0 ],
                                                    "text": "out 2"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "id": "obj-1",
                                                    "maxclass": "newobj",
                                                    "numinlets": 0,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 50.0, 14.0, 28.0, 22.0 ],
                                                    "text": "in 1"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "id": "obj-2",
                                                    "maxclass": "newobj",
                                                    "numinlets": 0,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 746.0, 14.0, 46.0, 22.0 ],
                                                    "text": "in 2 Hz"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "code": "\r\n// all linkwitz-riley crossovers code lives in this .genexpr file:\r\nrequire(\"evi_crossovers.genexpr\");\r\n\r\n\r\nParam   order(1, min=0, max=1);\r\nord     = int(order);\r\n\r\nyL, yH  = 0;\r\nxover   = evi_line(in2, mstosamps(33)); // smooth crossover frequency\r\n\r\n\r\nif (ord == 1) { // 4-pole\r\n\r\n    // 'eviXover4pole2band()' is the same as [evi.crossover~ @order 1]\r\n    yL, yH = eviXover4pole2band(in1, xover);\r\n    // Low, High\r\n\r\n}\r\n\r\nelse { // ord == 0, 2-pole\r\n\r\n    // 'eviXover2pole2band()' is the same as [evi.crossover~ @order 0]\r\n    yL, yH = eviXover2pole2band(in1, xover);\r\n    // Low, High\r\n\r\n}\r\n\r\nout1 = yL;\r\nout2 = yH;\r\n\r\n\r\n// the .genexpr file also includes stereo versions, for example:\r\nout3, out4, out5, out6 = eviXover4pole2bandStereo(in1, in1, xover);\r\n// Low L R, High L R\r\n\r\n\r\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-3",
                                                    "maxclass": "codebox",
                                                    "numinlets": 2,
                                                    "numoutlets": 6,
                                                    "outlettype": [ "", "", "", "", "", "" ],
                                                    "patching_rect": [ 50.0, 64.0, 715.0, 622.0 ]
                                                }
