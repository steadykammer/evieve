                                            {
                                                "box": {
                                                    "code": "\r\n// all linkwitz-riley crossovers code lives in this .genexpr file:\r\nrequire(\"evi_crossovers.genexpr\");\r\n\r\n\r\nParam   hzLow(250, min=10, max=20000);\r\nParam   hzHigh(2000, min=10, max=20000);\r\n\r\n\r\n// 'eviXover2pole3band()' is the same as [evi.crossover.3band~ @order 0]\r\nout1, out2, out3 = eviXover2pole3band(in1, hzLow, hzHigh);\r\n// Low, Mid, High\r\n\r\n// 'eviXover4pole3band()' is the same as [evi.crossover.3band~ @order 1]\r\nout4, out5, out6 = eviXover4pole3band(in1, hzLow, hzHigh); // aligned off by default\r\n// Low, Mid, High\r\n\r\n\r\n// the .genexpr file also includes stereo versions:\r\nout7, out8, out9, out10, out11, out12 = eviXover2pole3bandStereo(in1, in2, hzLow, hzHigh);\r\n// L R, L R, L R\r\n\r\n",
