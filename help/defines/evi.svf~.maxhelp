                                                    "text": "in 2 Q"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "code": "\r\n// [evi.svf~] / [evi_svf] is part of the core evieve svf filters require file:\r\nrequire(\"evi_svfs_filters.genexpr\");\r\n\r\nParam   filter(1, min=0, max=4);\r\nfilt    = int(filter);\r\n\r\nX       = noise();\r\n\r\n\r\n// first a (cheap) remap of Q so that 0..1 input maintains\r\n// compatibility with MSP Chamberlain version\nQ = ((in2 * in2) * 19) + 1;\n\r\n\r\n// then we need the coefficients calculations:\r\n               // cutoff, Q\r\ng, r, h = tptSvfUnit(in1, Q);\r\n\r\n\r\n// then we use the core TPT SVF filter of the evieve package:\r\nyL, yB, yH  = tptSvf(X, g, r, h);\r\n// and make the notch\r\nyN  = yH + yL;\r\n\r\n\r\n// now we select, for the purpose of this example code:\r\nif (filt == 1) {\r\n     out1 = yL;\r\n}\r\nelse if (filt == 2) {\r\n     out1 = yH;\r\n}\r\nelse if (filt == 3) {\r\n     out1 = yB;\r\n}\r\nelse if (filt == 4) {\r\n     out1 = yN;\r\n}\r\nelse {\r\n    out1 = 0;\r\n}\r\n\r\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-3",
                                                    "maxclass": "codebox",
