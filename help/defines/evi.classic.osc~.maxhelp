                                                    "code": "\r\n// all the 2-point polyblep classic oscillator shapes live in this .genexpr file:\r\nrequire(\"evi_polyblep_two.genexpr\");\n// required for decorelate, etc:\r\nrequire(\"evi_polyblep_utility.genexpr\");\n\r\n\r\n// this is here to avoid require hell\npoly_half20(t, dt, pw)\n{\n\th\t= 0;\n\tfdp\t= 1.2732395447351628;\t\t// 4 / PI\n\tt6\t= (pw * 0.5 + t + 0.75) - pw;\n\tt7\t= t6;\n\tt6\t= wrap(t6, 0, 1);\n\tt77\t= t7 - wrap(t7, 0, 1);\n\tif (t6 < pw) {\n\t\th\t= (sin73b(t6 / pw * PI) * 2) - pw * fdp;\n\t} else {\n\t\th\t= 0 - pw * fdp;\n\t}\n\th2\t= (poly_blamp(t7 - t77, dt) + poly_blamp(t6, dt)) / pw * PI * dt + h;\n\treturn\th2;\n}\r\n\r\n\r\n// this 'classicOscSelect()' function is equivalent to the shape selector in 'evi_classic_osc'\r\nclassicOscSelect(phase, nrm, width, gain, type, wav)\n{\n    osc = 0;\n    if (wav == 1) {            // tri\n        if (type == 1) {\n            pw = (width >= 0.5) ? width : width * 0.8 + 0.1;\n            osc = poly_trip(phase, nrm, pw);\n        }\n        else {  // (type == 0)\n            osc = poly_tri(phase, nrm);\n        }\n    }\n    else if (wav == 2) {       // saw\n        if (type == 1) {\n            osc = morph_saw_tri_saw(phase, nrm, width);\n        }\n        else {  // (type == 0)  // default\n            osc = poly_saw(phase, nrm);\n        }\n    }\n    else if (wav == 3) {       // rect\n        if (type == 1) {\n            pwm = width * 0.9 + 0.05;\n            osc = poly_rect(phase, nrm, pwm);\n        }\n        else {  // (type == 0)\n            osc = poly_sqr(phase, nrm);\n        }\n    }\n    else {  // (wav == 0)      // sine\n        if (type == 1) {\n            pwm = (width >= 0.5) ? width : width * 0.92 + 0.04;\n            osc = poly_half20(phase, nrm, pwm);\n        }\n        else {  // (type == 0)\n            osc = sin73b(phase * TWOPI);\n        }\n    }\n\n    return osc * gain;\n}\n\r\n\r\nParam   oscillator(2, min=0, max=3);    // 0=sine, 1=tri, 2=saw, 3=rect\nParam   type(0, min=0, max=1);          // 0=pure oscillators, 1=pulsewidth versions\nParam   compensate(1, min=0, max=2);    // decorrelation high frequency compensation filters, off/1/2\r\nwave    = int(oscillator);\r\ntyp     = int(type);\nfilt\t= int(compensate);\r\n\r\nfreqInHz\t= in1;\r\npulseWidth\t= in2;\r\n\r\nt\t\t    = phasor(freqInHz); \r\n\r\ndt\t\t\t= freqInHz / SAMPLERATE;\r\noscsync\t\t= delta(t) < 0;\r\ngain\t\t= 0.5;\r\n\r\nwv\t\t\t= latch(wave,\toscsync);\r\ntp          = latch(typ,    oscsync);\nft\t\t\t= latch(filt,\toscsync);\r\n\r\n\r\nosc = classicOscSelect(t, dt, pulseWidth, gain, tp, wv);\r\n\r\n\r\n// dcblock\r\nosc = dcblock(osc);\r\n\r\n// restore high frequencies options...\r\nif (ft > 0) {\r\n\tosc = decorelateOsc(osc);      // for Bleps ?\r\n\tif (ft > 1) {\r\n\t\tosc = decorelateOsc(osc);  // for Blamps / Bluhs ?\r\n\t}\r\n}\r\n\r\nout1\t= osc;\r\n\r\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-3",
                                                    "maxclass": "codebox",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 52.0, 79.0, 841.0, 665.0 ]
                                                }
