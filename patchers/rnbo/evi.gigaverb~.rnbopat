                        "title": "EQ_coefficients",
                        "boxes": [
                            {
                                "box": {
                                    "code": "\n// // // local functions // // //\n\n// fixed mode=1 version, no branching\nfunction rcDampCoeffs1(cutoff, damp)\t    // damp -1..1\n{\n\t// prewarp\n//\tlet g0\t=  tanA(PI * cutoff / samplerate());// prewarp\n\tlet g0\t=  tan(PI * cutoff / samplerate()); // prewarp\n\t// account for pass/shelf\n\tlet ka\t=  abs(damp);\t\t\t\t\t// 0..1 = (lin..)..sqrt..lin\n\tlet ks\t= (ka * 0.5) + 0.5;\n\tlet k05\t= (ks - 0.5);\n\tlet g01\t=  1.0 + g0;\n\tlet g1 \t=  g0 / mix(sqrt(g01), g01, (k05 + k05));\n\t// shelf/pass (damp) control\n\tlet d1\t= (pow(4.0, damp) - 1.0);\t\t// this is just horrible, need a curve fit\n\treturn [ g1, -d1 ];\t\t\t\t\t\t// rc filter warped cf (g)\t// rc filter warped gain (k)\n}\n\n// fixed mode=2 version, no branching\nfunction rcDampCoeffs2(cutoff, damp)\t\t// damp -1..1\n{\n\tlet g1d0 \t= rcDampCoeffs1(cutoff, damp);\n\t// extend attenuation range to make pass choice\n\tlet d1\t    = (g1d0[1] > 0) ? (g1d0[1] * 1.333333333333) : g1d0[1];\n\treturn      [ g1d0[0], d1 ];\t\t\t// rc filter warped cf (g)\t// rc filter warped gain (k)\n}\n\r\n// // // EQ // // //\r\n/*\r\n// RNBO will not let me have only param inputs, because...\r\n@param({ min: 500, max: 15000}) cutoffhigh = 2000;\t\t// Hz\r\n@param({ min: -1, max: 1}) damphigh = 0;\t\t\t\t// % ± 1\r\n\r\n@param({ min: 62.5, max: 4000}) cutofflow = 500;\t\t// Hz\r\n@param({ min: -1, max: 1}) damplow = 0;\t\t\t\t\t// % ± 1\r\n*/\r\n// RNBO will not let me have only param inputs, because...\r\nlet cutoffhigh = in1;\r\nlet damphigh = in2;\r\nlet cutofflow = in3;\r\nlet damplow = in4;\r\n\r\nlet gkHigh = rcDampCoeffs2(cutoffhigh, damphigh);\r\nlet gkLow = rcDampCoeffs2(cutofflow, damplow);\r\n\r\nout1 = gkLow[0];\r\nout2 = gkLow[1];\r\nout3 = gkHigh[0];\r\nout4 = gkHigh[1];\r\n\r\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-6",
                                    "maxclass": "codebox",
                                    "numinlets": 4,
                                    "numoutlets": 4,
                                    "outlettype": [ "", "", "", "" ],
                                    "patching_rect": [ 49.0, 74.0, 912.0, 594.0 ],
                                    "rnbo_classname": "codebox",
                                    "rnbo_extra_attributes": {
                                        "code": "\n// // // local functions // // //\n\n// fixed mode=1 version, no branching\nfunction rcDampCoeffs1(cutoff, damp)\t    // damp -1..1\n{\n\t// prewarp\n//\tlet g0\t=  tanA(PI * cutoff / samplerate());// prewarp\n\tlet g0\t=  tan(PI * cutoff / samplerate()); // prewarp\n\t// account for pass/shelf\n\tlet ka\t=  abs(damp);\t\t\t\t\t// 0..1 = (lin..)..sqrt..lin\n\tlet ks\t= (ka * 0.5) + 0.5;\n\tlet k05\t= (ks - 0.5);\n\tlet g01\t=  1.0 + g0;\n\tlet g1 \t=  g0 / mix(sqrt(g01), g01, (k05 + k05));\n\t// shelf/pass (damp) control\n\tlet d1\t= (pow(4.0, damp) - 1.0);\t\t// this is just horrible, need a curve fit\n\treturn [ g1, -d1 ];\t\t\t\t\t\t// rc filter warped cf (g)\t// rc filter warped gain (k)\n}\n\n// fixed mode=2 version, no branching\nfunction rcDampCoeffs2(cutoff, damp)\t\t// damp -1..1\n{\n\tlet g1d0 \t= rcDampCoeffs1(cutoff, damp);\n\t// extend attenuation range to make pass choice\n\tlet d1\t    = (g1d0[1] > 0) ? (g1d0[1] * 1.333333333333) : g1d0[1];\n\treturn      [ g1d0[0], d1 ];\t\t\t// rc filter warped cf (g)\t// rc filter warped gain (k)\n}\n\r\n// // // EQ // // //\r\n/*\r\n// RNBO will not let me have only param inputs, because...\r\n@param({ min: 500, max: 15000}) cutoffhigh = 2000;\t\t// Hz\r\n@param({ min: -1, max: 1}) damphigh = 0;\t\t\t\t// % ± 1\r\n\r\n@param({ min: 62.5, max: 4000}) cutofflow = 500;\t\t// Hz\r\n@param({ min: -1, max: 1}) damplow = 0;\t\t\t\t\t// % ± 1\r\n*/\r\n// RNBO will not let me have only param inputs, because...\r\nlet cutoffhigh = in1;\r\nlet damphigh = in2;\r\nlet cutofflow = in3;\r\nlet damplow = in4;\r\n\r\nlet gkHigh = rcDampCoeffs2(cutoffhigh, damphigh);\r\nlet gkLow = rcDampCoeffs2(cutofflow, damplow);\r\n\r\nout1 = gkLow[0];\r\nout2 = gkLow[1];\r\nout3 = gkHigh[0];\r\nout4 = gkHigh[1];\r\n\r\n",
                                        "hot": 1,
                                        "safemath": 1,
                                        "nocache": 0
                                    },
