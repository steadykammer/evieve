                            "toptoolbarpinned": 2,
                            "righttoolbarpinned": 2,
                            "bottomtoolbarpinned": 1,
                            "toolbars_unpinned_last_save": 7,
                            "subpatcher_template": "sub",
                            "integercoordinates": 1,
                            "boxes": [
                                {
                                    "box": {
                                        "maxclass": "newobj",
