                    },
                    "id": "obj-5",
                    "maxclass": "newobj",
                    "numinlets": 4,
                    "numoutlets": 3,
                    "outlettype": [ "signal", "signal", "signal" ],
                    "patching_rect": [ 393.0, 424.0, 153.0, 23.0 ],
                    "rnbo_classname": "gen~",
                    "rnbo_extra_attributes": {
                        "vowels": 5.0,
                        "init2_83": 0.0,
                        "init_208": 0.0,
                        "highpass": 31.25,
                        "gainnorm": 0.0,
                        "datainterp": 1.0,
                        "mtrig0": 0.0,
                        "init_51": 0.0,
                        "fundfreqmode": 0.0,
                        "ad_117": 0.0,
                        "exposeparams": 0,
                        "z_396": 0.0,
                        "cfwarp": 1.0,
                        "gain": 0.0,
                        "prevff": 0.0,
                        "w_100": 0.0,
                        "zerophasor": 1.0,
                        "voices": 5.0,
                        "w_207": 0.0,
                        "gainwarp": 1.0,
                        "paramsmooth": 15.111,
                        "mtrig180": 0.0,
                        "datatype": 0.0,
                        "val_50": 0.0,
                        "formantsoffset": 0.0,
                        "z_116": 0.0,
                        "s_403": 0.0,
                        "warpsmooth": 1.0,
                        "formants": 5.0,
                        "w_106": 0.0,
