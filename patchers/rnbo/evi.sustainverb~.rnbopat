                                    "rnbo_extra_attributes": {
                                        "hot": 0,
                                        "code": "\r\n// // // setup // // //\r\n\r\n// :-(\r\nconst earlysize: Int = 4;\r\nconst fdnsize: Int = 16;\r\n\r\n// :-(\r\nconst maxearlysamps: Int = 1504;\r\nconst maxfdnsamps: Int = 25056;\r\n\r\n@state earlysecs = new FixedFloat64Array([0.00142763, 0.00323873, 0.00523450, 0.00782312]);\r\n\r\n@state fdnsecs = new FixedFloat32Array([0.0100001, 0.0116356, 0.0134567, 0.0167345, \r\n                                        0.0201862, 0.0257417, 0.0314693, 0.0382944, \r\n                                        0.0466838, 0.0554567, 0.0651755, 0.0768243, \r\n                                        0.0885623, 0.1012780, 0.1153970, 0.1305020]);\r\n\r\n@state earlysamps = new FixedUint32Array(earlysize);\r\n@state fdnsamps = new FixedUint32Array(fdnsize);\r\n\r\nfunction earlymake(sr)\n{\n\tfor (let i = 0; i < earlysize; i++)\n\t{\n\t\tearlysamps[i] = floor(sr * earlysecs[i] + 0.5);\n\t}\r\n    return 0;\n}\r\n\r\nfunction fdnmake(sr)\n{\n\tfor (var i = 0; i < fdnsize; i++)\n\t{\n\t\tfdnsamps[i] = floor(sr * fdnsecs[i] + 0.5);\n\t}\n    return 0;\n}\r\n\r\nfunction init()\r\n{\r\n    sr = samplerate();\r\n    earlymake(sr);\r\n    fdnmake(sr);\r\n}\r\n\r\nfunction startup()\r\n{    \r\n    out1 = earlysamps[0];   out2 = earlysamps[1];   out3 = earlysamps[2];   out4 = earlysamps[3];\r\n\r\n    out5 = fdnsamps[0];     out6 = fdnsamps[1];     out7 = fdnsamps[2];     out8 = fdnsamps[3];\r\n    out9 = fdnsamps[4];     out10 = fdnsamps[5];    out11 = fdnsamps[6];    out12 = fdnsamps[7];\r\n    out13 = fdnsamps[8];    out14 = fdnsamps[9];    out15 = fdnsamps[10];   out16 = fdnsamps[11];\r\n    out17 = fdnsamps[12];   out18 = fdnsamps[13];   out19 = fdnsamps[14];   out20 = fdnsamps[15];\r\n}\r\n\r\n",
                                        "safemath": 1,
                                        "nocache": 0
                                    },
