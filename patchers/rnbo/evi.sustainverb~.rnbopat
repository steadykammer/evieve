                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "in 2 Audio In Right",
                                        "patching_rect": [ 926.0, 17.0, 106.0, 22.0 ],
                                        "numoutlets": 1,
                                        "id": "obj-2",
                                        "fontsize": 12.0,
