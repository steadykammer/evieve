                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 30.0, 54.0, 915.0, 702.0 ],
                                        "numoutlets": 8,
                                        "id": "obj-3",
                                        "fontsize": 12.0,
                                        "outlettype": [ "", "", "", "", "", "", "", "" ],
                                        "fontname": "<Monospaced>",
                                        "numinlets": 2,
                                        "fontface": 0,
                                        "code": "\r\n//\t//\t//\tevi_sustainverb.gendsp\r\n//\t//\t//\t16 line feeback delay network after Miller Puckette (@see: rev3.pd), BSD\r\n//\t//\t//\tby pete for evieve, with extras\r\n\r\n\r\n//\t//\t//\tlibrary\r\n\r\nrequire(\"evi_reverb_library.genexpr\");\r\n\r\n\r\n//\t//\t//\tdeclare\r\n\r\n// constants in samples from external javascript, defaults are for 48kHz samplerate\r\nParam\tearlyTime1 \t(\t69,\t\tmin=1, max=1502\t\t);\nParam\tearlyTime2 \t(\t155,\tmin=1, max=1502\t\t);\nParam\tearlyTime3 \t(\t251,\tmin=1, max=1502\t\t);\nParam\tearlyTime4 \t(\t376,\tmin=1, max=1502\t\t);\n// sort of Miller Puckette's tuning:\r\nParam\tdelayTime1 \t(\t480,\tmin=1, max=25056\t);\nParam\tdelayTime2 \t(\t559,\tmin=1, max=25056\t);\nParam\tdelayTime3 \t(\t646,\tmin=1, max=25056\t);\nParam\tdelayTime4 \t(\t803,\tmin=1, max=25056\t);\nParam\tdelayTime5 \t(\t969,\tmin=1, max=25056\t);\nParam\tdelayTime6 \t(\t1236,\tmin=1, max=25056\t);\nParam\tdelayTime7 \t(\t1511,\tmin=1, max=25056\t);\nParam\tdelayTime8 \t(\t1838,\tmin=1, max=25056\t);\nParam\tdelayTime9 \t(\t2241,\tmin=1, max=25056\t);\nParam\tdelayTime10 (\t2662,\tmin=1, max=25056\t);\nParam\tdelayTime11 (\t3128,\tmin=1, max=25056\t);\nParam\tdelayTime12 (\t3688,\tmin=1, max=25056\t);\nParam\tdelayTime13 (\t4251,\tmin=1, max=25056\t);\nParam\tdelayTime14 (\t4861,\tmin=1, max=25056\t);\nParam\tdelayTime15 (\t5539,\tmin=1, max=25056\t);\nParam\tdelayTime16 (\t6264,\tmin=1, max=25056\t);\n\r\nDelay\tearly1\t\t(\tearlyTime1,\t\t1,\tfeedback=0\t);\r\nDelay\tearly2\t\t(\tearlyTime2,\t\t1,\tfeedback=0\t);\r\nDelay\tearly3\t\t(\tearlyTime3,\t\t1,\tfeedback=0\t);\r\nDelay\tearly4\t\t(\tearlyTime4,\t\t1,\tfeedback=0\t);\r\n\r\nDelay\tfdnDelay1\t(\tdelayTime1+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay2\t(\tdelayTime2+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay3\t(\tdelayTime3+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay4\t(\tdelayTime4+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay5\t(\tdelayTime5+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay6\t(\tdelayTime6+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay7\t(\tdelayTime7+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay8\t(\tdelayTime8+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay9\t(\tdelayTime9+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay10\t(\tdelayTime10+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay11\t(\tdelayTime11+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay12\t(\tdelayTime12+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay13\t(\tdelayTime13+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay14\t(\tdelayTime14+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay15\t(\tdelayTime15+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay16\t(\tdelayTime16+1,\t1,\tfeedback=1\t);\r\n\r\n// global controls\r\nParam\tsmoothtime(43., min=1, max=500);\t// ms\r\n// reverb controls\r\nParam\tearly(0., min=0, max=1);\t\t\t// % 0..1 ( OR 0/1 )\r\nParam\tfeedback(sqrt1_2, min=0, max=1);\t// % 0..1\r\n// damping controls\r\nParam\tcrossover(3000., min=10, max=10000);// Hz\r\nParam\tdamp(0.2, min=0, max=1);\t\t\t// % 0..1\r\nParam\thighpass(0., min=0, max=1);\t\t\t// % 0..1 ( OR 0/1 )\r\n// mixing controls\r\nParam\toutgain(-3., min=-80, max=20);\t\t// dB\r\nParam\tdrywet(1., min=0, max=1);\t\t\t// % 0..1\r\n\r\n\r\n//\t//\t//\tparse param rate\r\n\r\nsmoothsecs\t= smoothtime * 0.001;\r\nsmoothsamps\t= smoothsecs * samplerate;\r\n\r\ninv_early\t= 1 - early;\r\nfb_0\t\t= sqrt(feedback) * 0.25;\t\t// you think this is a stupid multiplier, but it is correct\r\nfb_hp\t\t= (0.012733 * feedback) + 0.000712;\r\nout_amp\t\t= dbtoaApprox(outgain);\r\n\r\nG, K\t\t= rcDampCoeffs0(crossover, damp);\r\n\r\n\r\n//\t//\t//\tparse audio rate\r\n\r\nearlymix\t\t\t\t\t= eviLine(inv_early, smoothsamps);\r\nhighpassactive\t\t\t\t= eviSline(highpass, smoothsamps);\r\nfb0, outAmp\t\t\t\t\t= logsmoothBank2(fb_0, out_amp, smoothsecs);\r\nxover\t\t\t\t\t\t= eviLine(G, smoothsamps);\r\ndamp0\t\t\t\t\t\t= eviLine(K, smoothsamps);\r\nfbhp0\t\t\t\t\t\t= logsmooth(fb_hp, smoothsecs);\t// [ g / (1 + g) ] 10..190 Hz\r\nfbhp1\t\t\t\t\t\t= fbhp0 * sqrt1_2;\t// 7..134 Hz\r\nmix\t\t\t\t\t\t\t= eviLine(drywet, samplerate*0.333333);\r\n\r\n\r\n//\t//\t//\tprocessing\t\t(static & integer delay times so no interpolation)\r\n\r\nxL\t\t= in1+0;\r\nxR\t\t= in2+0;\r\n\r\n// cpu management not that important as whole sustainverb is very cheap?\r\n//if (mix > 0) {\t//\t//\t//\tbegin :: CPU mute if mix @ 0 %\r\n\r\n\r\n// input conditioning and damping to fdn...\r\n\r\n// high or low pass if damp0 == 1, bypass if damp0 == 0, else low or high shelf attenuation\r\ndamp1\t= rcFilterDamp(\tfdnDelay1.read(delayTime1,\tinterp=\"none\"),\t\txover, damp0);\r\ndamp2\t= rcFilterDamp(\tfdnDelay2.read(delayTime2,\tinterp=\"none\"),\t\txover, damp0);\r\ndamp3\t= rcFilterDamp(\tfdnDelay3.read(delayTime3,\tinterp=\"none\"),\t\txover, damp0);\r\ndamp4\t= rcFilterDamp(\tfdnDelay4.read(delayTime4,\tinterp=\"none\"),\t\txover, damp0);\r\n\r\n// optional (earlymix) additional early reflections...\r\n\r\nearly1.write\t(\txR\t\t\t);\r\ne1r\t= early1.read(earlyTime1, interp=\"none\");\r\nep1\t= xL  + e1r;\r\nearly2.write\t(\txL  - e1r\t);\r\ne2r\t= early2.read(earlyTime2, interp=\"none\");\r\nep2\t= ep1 + e2r;\r\nearly3.write\t(\tep1 - e2r\t);\r\ne3r\t= early3.read(earlyTime3, interp=\"none\");\r\nep3\t= ep2 + e3r;\r\nearly4.write\t(\tep2 - e3r\t);\r\ne4r\t= early4.read(earlyTime4, interp=\"none\");\r\n\t\r\ntapIn1\t= interp(\tearlymix,\tep3 * 0.354813,\txL,\t\tmode=\"cosine\");\r\ntapIn2\t= interp(\tearlymix,\te4r * 0.354813, xR,\t\tmode=\"cosine\");\r\n\r\n// fdn read...\r\n\r\nfb1\t\t= (damp1\t+\ttapIn1)\t\t\t\t\t\t\t* fb0;\r\nfb2\t\t= (damp2\t+\ttapIn2)\t\t\t\t\t\t\t* fb0;\r\nfb3\t\t=  damp3\t\t\t\t\t\t\t\t\t\t* fb0;\r\nfb4\t\t=  damp4\t\t\t\t\t\t\t\t\t\t* fb0;\r\n\r\nfb5\t\t=  fdnDelay5.read(delayTime5,\tinterp=\"none\")\t* fb0;\r\nfb6\t\t=  fdnDelay6.read(delayTime6,\tinterp=\"none\")\t* fb0;\r\nfb7\t\t=  fdnDelay7.read(delayTime7,\tinterp=\"none\")\t* fb0;\r\nfb8\t\t=  fdnDelay8.read(delayTime8,\tinterp=\"none\")\t* fb0;\r\nfb9\t\t=  fdnDelay9.read(delayTime9,\tinterp=\"none\")\t* fb0;\r\nfb10\t=  fdnDelay10.read(delayTime10,\tinterp=\"none\")\t* fb0;\r\nfb11\t=  fdnDelay11.read(delayTime11,\tinterp=\"none\")\t* fb0;\r\nfb12\t=  fdnDelay12.read(delayTime12,\tinterp=\"none\")\t* fb0;\r\nfb13\t=  fdnDelay13.read(delayTime13,\tinterp=\"none\")\t* fb0;\r\nfb14\t=  fdnDelay14.read(delayTime14,\tinterp=\"none\")\t* fb0;\r\nfb15\t=  fdnDelay15.read(delayTime15,\tinterp=\"none\")\t* fb0;\r\nfb16\t=  fdnDelay16.read(delayTime16,\tinterp=\"none\")\t* fb0;\r\n\r\n// optional (highpassactive) additional high passes...\r\n\r\nif (highpassactive > 0) {\t// this if is worth the saving, i measured it\r\n// this affects the ability to 'forever sustain' but is useful for low frequency recirculation issues\r\n\tfb1HP\t= rcFilterHp(fb1,\tfbhp1);\r\n\tfb2HP\t= rcFilterHp(fb2,\tfbhp1);\r\n\tfb1\t\t= interp(\thighpassactive,\t\tfb1, fb1HP,\t\tmode=\"linear\");\r\n\tfb2\t\t= interp(\thighpassactive,\t\tfb2, fb2HP,\t\tmode=\"linear\");\r\n}\r\n\r\n// fdn matrix...\r\n\r\ndx1, dx2, dx3, dx4, dx5, dx6, dx7, dx8, dx9, dx10, dx11, dx12, dx13, dx14, dx15, dx16\t\r\n\t\t= butterfly16(fb1, fb2, fb3, fb4, fb5, fb6, fb7, fb8, fb9, fb10, fb11, fb12, fb13, fb14, fb15, fb16);\r\n\r\n// aux taps...\r\n\r\n//tapOut1\t= dcblock(dx13 * outAmp);\r\n//tapOut2\t= dcblock(dx14 * outAmp);\r\ntapOut1\t= dcblock((interp(highpassactive, dx13, dx9, mode=\"linear\")) * outAmp);\r\ntapOut2\t= dcblock((interp(highpassactive, dx14, dx12, mode=\"linear\")) * outAmp);\r\ntapOut3\t= dcblock(dx15 * outAmp);\r\ntapOut4\t= dcblock(dx16 * outAmp);\r\n\r\n// main taps...\r\n\r\n// should be butterfly ??\r\nfdnL\t= (tapOut1 + tapOut2) * sqrt1_2;\r\nfdnR\t= (tapOut3 + tapOut4) * sqrt1_2;\r\n/*\r\n// comment out if bullshit\r\nif (highpassactive > 0) {\r\n\tfdnLHP\t= rcFilterHp(fdnL, fbhp0);\r\n\tfdnRHP\t= rcFilterHp(fdnR, fbhp0);\r\n\tfdnL\t= interp(\thighpassactive,\t\tfdnL, fdnLHP,\tmode=\"linear\");\r\n\tfdnR\t= interp(\thighpassactive,\t\tfdnR, fdnRHP,\tmode=\"linear\");\r\n}\r\n*/\r\n// add dry/wet...\r\n\r\nrvrbL, rvrbR\t= xfadeQuartApproxStereo(xL, xR, fdnL, fdnR, mix);\r\n\r\n\r\n//}\t//\t//\t//\tend :: CPU mute if mix @ 0 %\r\n\r\n\r\n// fdn write (update delay lines)...\r\n\r\nfdnDelay1.write\t\t(\tfixdenorm(dx1)\t\t);\r\nfdnDelay2.write\t\t(\tfixdenorm(dx2)\t\t);\r\nfdnDelay3.write\t\t(\tfixdenorm(dx3)\t\t);\r\nfdnDelay4.write\t\t(\tfixdenorm(dx4)\t\t);\r\nfdnDelay5.write\t\t(\tfixdenorm(dx5)\t\t);\r\nfdnDelay6.write\t\t(\tfixdenorm(dx6)\t\t);\r\nfdnDelay7.write\t\t(\tfixdenorm(dx7)\t\t);\r\nfdnDelay8.write\t\t(\tfixdenorm(dx8)\t\t);\r\nfdnDelay9.write\t\t(\tfixdenorm(dx9)\t\t);\r\nfdnDelay10.write\t(\tfixdenorm(dx10)\t\t);\r\nfdnDelay11.write\t(\tfixdenorm(dx11)\t\t);\r\nfdnDelay12.write\t(\tfixdenorm(dx12)\t\t);\r\nfdnDelay13.write\t(\tfixdenorm(dx13)\t\t);\r\nfdnDelay14.write\t(\tfixdenorm(dx14)\t\t);\r\nfdnDelay15.write\t(\tfixdenorm(dx15)\t\t);\r\nfdnDelay16.write\t(\tfixdenorm(dx16)\t\t);\r\n\r\n// outputs...\r\n\r\nout1\t= rvrbL;\r\nout2\t= rvrbR;\r\n\r\nout3\t= fdnL;\r\nout4\t= fdnR;\r\n\r\nout5\t= tapOut1;\r\nout6\t= tapOut2;\r\nout7\t= tapOut3;\r\nout8\t= tapOut4;\r\n\r\n"
                                    }
                                },
                                {
