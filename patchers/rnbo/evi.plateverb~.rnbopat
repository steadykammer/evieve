                    },
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patching_rect": [ 291.0, 569.0, 137.0, 23.0 ],
                    "rnbo_classname": "gen~",
                    "rnbo_extra_attributes": {
