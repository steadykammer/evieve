            {
                "box": {
                    "genpatcher": {
                        "patcher": {
                            "fileversion": 1,
                            "appversion": {
                                "major": 9,
                                "minor": 2,
                                "revision": 0,
                                "architecture": "x64",
                                "modernui": 1
                            },
                            "classnamespace": "dsp.gen",
                            "rect": [ 54.0, 161.0, 931.0, 787.0 ],
                            "gridonopen": 2,
                            "subpatcher_template": "<none>",
                            "integercoordinates": 1,
                            "boxes": [
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "in 2 Nothing / In Right / In 2",
                                        "patching_rect": [ 740.0, 17.0, 154.0, 22.0 ],
                                        "numoutlets": 1,
                                        "id": "obj-6",
