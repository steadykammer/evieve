                                "box": {
                                    "code": "\r\n// // // setup // // //\n\n//const modsize: Int = 8;\nconst dlysize: Int = 16;\nconst sumsize: Int = 8;\n\nconst maxdlysamps: Int = 47559;\nconst maxsumsamps: Int = 40877;\n\n//@state modhz = new FixedFloat32Array([0.666, 0.625, 0.555, 0.476, 0.435, 0.303, 0.181, 0.122]);\n\n@state delaysecs = new FixedFloat32Array([  0.0479, 0.1201, 0.1361, 0.1459, \r\n                                            0.1589, 0.1693, 0.1801, 0.1901,\n\t\t\t\t\t\t\t                0.2003, 0.2099, 0.2179, 0.2251,\n\t\t\t\t\t\t\t                0.2339, 0.2399, 0.2441, 0.2477\n\t\t\t\t\t\t                ]);\n\n@state sumssecs = new FixedFloat32Array([   0.0607, 0.0773, 0.1373, 0.1123, \n\t\t\t\t\t\t\t                0.1753, 0.1601, 0.1901, 0.2129 \n\t\t\t\t\t\t                ]);\n\n\n@state dlysamps = new FixedFloat32Array(dlysize);\n@state sumsamps = new FixedUint32Array(sumsize);\n\nfunction delaymake(sr)\n{\n\tfor (var i = 0; i < dlysize; i++)\n\t{\n\t\tdlysamps[i]\t= sr * delaysecs[i];\n\t}\n    return 0;\n}\n\nfunction summake(sr)\n{\n\tfor (let i = 0; i < sumsize; i++)\n\t{\n\t\tsumsamps[i] = floor(sr * sumssecs[i] + 0.5);\n\t}\n    return 0;\n}\n\nfunction init()\n{\n    sr = samplerate();\n    delaymake(sr);\n    summake(sr);\n}\n\r\nfunction startup()\r\n{\r\n    out1 = dlysamps[0];     out2 = dlysamps[1];     out3 = dlysamps[2];     out4 = dlysamps[3];\r\n    out5 = dlysamps[4];     out6 = dlysamps[5];     out7 = dlysamps[6];     out8 = dlysamps[7];\r\n    out9 = dlysamps[8];     out10 = dlysamps[9];    out11 = dlysamps[10];   out12 = dlysamps[11];\r\n    out13 = dlysamps[12];   out14 = dlysamps[13];   out15 = dlysamps[14];   out16 = dlysamps[15];\r\n\r\n    out17 = sumsamps[0];    out18 = sumsamps[1];    out19 = sumsamps[2];    out20 = sumsamps[3];\r\n    out21 = sumsamps[4];    out22 = sumsamps[5];    out23 = sumsamps[6];    out24 = sumsamps[7];\r\n}\r\n",
                                    "fontface": 0,
