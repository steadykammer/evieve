                    },
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patching_rect": [ 49.0, 289.0, 122.0, 23.0 ],
                    "rnbo_classname": "gen~",
                    "rnbo_extra_attributes": {
                        "exposeparams": 0,
                        "gencode": "biquadDf2(x, a0, a1, a2, b1, b2) {\n\tHistory x2(0);\n\tHistory x1(0);\n\tb1w = x1 * b1;\n\tb2w = x2 * b2;\n\tw = ((x - b1w)) - b2w;\n\ta0w = w * a0;\n\ta1w = x1 * a1;\n\ta2w = x2 * a2;\n\ty = ((a0w + a1w)) + a2w;\n\tx2 = x1;\n\tx1 = w;\n\treturn y;\n}\n\neviBiquadCoeffBp(cutoff, Q) {\n\tw0 = ((TWOPI * cutoff)) / SAMPLERATE;\n\tqw = minimum(w0 / Q, 1);\n\tr2 = 1 - qw;\n\tb0 = ((qw + qw)) * ((qw + (r2 * w0)));\n\tb1 = 0;\n\tb2 = 0;\n\ta1 = (((-2) * (cos(w0)))) * r2;\n\ta2 = r2 * r2;\n\treturn b0, b1, b2, a1, a2;\n}\n\neviButterworthLp6(x0, cutoff) {\n\tHistory eblp6dummy(0);\n\ta01, a11, a21, b11, b21 = eviBiquadCoeffBp(cutoff * 0.25881900000000002, 0.26794800000000002);\n\ta02, a12, a22, b12, b22 = eviBiquadCoeffBp(cutoff * sqrt1_2, 1);\n\ta03, a13, a23, b13, b23 = eviBiquadCoeffBp(cutoff * 0.96592599999999995, 3.73203);\n\ty0 = biquadDf2(x0, a01, a11, a21, b11, b21);\n\ty1 = biquadDf2(y0, a02, a12, a22, b12, b22);\n\ty2 = biquadDf2(y1, a03, a13, a23, b13, b23);\n\treturn y2 * 0.35481299999999999;\n}\n\nhilbertTdf2(x0, a0) {\n\tHistory x1(0);\n\tHistory x2(0);\n\ty1 = (x0 * a0) + x2;\n\tx2 = x1;\n\tx1 = (-x0) - (y1 * (-a0));\n\treturn y1;\n}\n\neviHilbertCascade(y0, hc1, hc2, hc3, hc4, hc5, hc6, hc7, hc8) {\n\tHistory x0(0);\n\tx1 = hilbertTdf2(x0, hc1);\n\tx2 = hilbertTdf2(x1, hc2);\n\tx3 = hilbertTdf2(x2, hc3);\n\tx4 = hilbertTdf2(x3, hc4);\n\ty1 = hilbertTdf2(y0, hc5);\n\ty2 = hilbertTdf2(y1, hc6);\n\ty3 = hilbertTdf2(y2, hc7);\n\ty4 = hilbertTdf2(y3, hc8);\n\tx0 = y0;\n\treturn x4, y4;\n}\n\neviCascadeCoeffAllpass(cutoff, Q, R=0) {\n\tomega = ((TWOPI * cutoff)) / SAMPLERATE;\n\talpha = sin(omega);\n\talpha = R ? alpha * ((1 - Q)) : alpha / ((Q + Q));\n\tb0 = 1 - alpha;\n\tb1 = (-2) * (cos(omega));\n\tb2 = 1 + alpha;\n\ta0m = 1 / b2;\n\treturn b0 * a0m, b1 * a0m, b2 * a0m;\n}\n\nbiquadDf2cascadeAllpass(x0, a0, a1, a2, x1, x2) {\n\tb1w = x1 * a1;\n\tb2w = x2 * a0;\n\tw0 = ((x0 - b1w)) - b2w;\n\ta0w = w0 * a0;\n\ta1w = x1 * a1;\n\ta2w = x2 * a2;\n\ty0 = ((a0w + a1w)) + a2w;\n\treturn y0, w0, x1;\n}\n\nresringzCoeffs(cutoff, QorT60, filt=0) {\n\tF = ((cutoff * TWOPI)) / samplerate;\n\tR = filt ? maximum(t60(QorT60), 0.001) : 1 - ((F / (maximum(QorT60, 0.001))) * 0.5);\n\ttwoR = R + R;\n\tR2 = R * R;\n\tcosF = ((twoR * (cos(F)))) / ((1 + R2));\n\tb1 = twoR * cosF;\n\tb2 = -R2;\n\ta0 = filt ? 0.5 : ((1 - R2)) * 0.5;\n\treturn a0, b1, b2;\n}\n\nfirOrder12(x0, a0=1, a1=2, a2=1) {\n\tHistory x2(0);\n\tHistory x1(0);\n\ta10 = a1 * a0;\n\ta20 = a2 * a0;\n\ty0 = (x0 * a0) + (x1 * a10);\n\ty1 = y0 + (x2 * a20);\n\tx2 = x1;\n\tx1 = x0;\n\treturn y0, y1;\n}\n\n\n\nParam coef1(0.486604368613682, min=-10, max=10);\nParam coef2(0.88077943527246705, min=-10, max=10);\nParam coef3(0.97793125561632399, min=-10, max=10);\nParam coef4(0.99767386185073204, min=-10, max=10);\nParam coef5(0.165149093559079, min=-10, max=10);\nParam coef6(0.73982901254453004, min=-10, max=10);\nParam coef7(0.94794090632918104, min=-10, max=10);\nParam coef8(0.99120971270525804, min=-10, max=10);\nx = in1;\nreal, imag = eviHilbertCascade(x, coef1, coef2, coef3, coef4, coef5, coef6, coef7, coef8);\ntmp_expr_1 = real;\ntmp_expr_2 = imag;\nout2 = tmp_expr_2;\nout1 = tmp_expr_1;",
                        "geninlets": 1,
                        "genoutlets": 2
                    },
