            {
                "box": {
                    "genpatcher": {
                        "patcher": {
                            "fileversion": 1,
                            "appversion": {
                                "major": 9,
                                "minor": 2,
                                "revision": 1,
                                "architecture": "x64",
                                "modernui": 1
                            },
                            "classnamespace": "dsp.gen",
                            "rect": [ 34.0, 100.0, 856.0, 704.0 ],
                            "gridonopen": 2,
                            "subpatcher_template": "sub",
                            "integercoordinates": 1,
                            "boxes": [
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "out 2 (signal) Sine/Imag Output",
                                        "patching_rect": [ 631.0, 660.0, 175.0, 22.0 ],
                                        "id": "obj-5",
                                        "numinlets": 1,
                                        "numoutlets": 0
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "in 1 (signal) Input",
                                        "patching_rect": [ 49.0, 19.0, 101.0, 22.0 ],
                                        "outlettype": [ "" ],
                                        "id": "obj-1",
                                        "numinlets": 0,
                                        "numoutlets": 1
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 49.0, 58.0, 757.0, 585.0 ],
                                        "outlettype": [ "", "" ],
                                        "fontface": 0,
                                        "id": "obj-3",
                                        "fontsize": 12.0,
                                        "numinlets": 1,
                                        "numoutlets": 2,
                                        "fontname": "<Monospaced>",
                                        "code": "\r\n// Hilbert transform 90º phase shifting filter using high quality 8-pole Polyphase \r\n// IIR Halfband Allpass Cascade coefficients (De Soras / Niemitalo). Theoretically \r\n// 'better' than the MSP (6-pole fudged) [hilbert~] :-)\r\n\r\n// Defaults for 48kHz samplerate. If using other samplerates you will need to provide \r\n// coefficients externally (e.g. from [evi.polyphaseiirhilbertcoeffs], or \r\n// 'evi_hilbert_coefficients.js' directly).\r\n\r\n// @see also: 'evi_freqshift_hilbert.gendsp' and 'evi_freqshift_weaver.gendsp'\n\r\n\r\nrequire(\"evi_biquads_extras.genexpr\");\r\n\r\n// 64-bit Polyphase IIR Halfband Allpass Cascade Coefficients updated\r\n// from Javascript, defaults are for 48kHz Samplerate & 40Hz bandwidth\r\n\r\n// Phase reference path c coefficients\r\nParam\tcoef1(0.486604368613682, min=-10, max=10);\r\nParam\tcoef2(0.880779435272467, min=-10, max=10);\r\nParam\tcoef3(0.977931255616324, min=-10, max=10);\r\nParam\tcoef4(0.997673861850732, min=-10, max=10);\r\n// +90 degrees path c coefficients\r\nParam\tcoef5(0.165149093559079, min=-10, max=10);\r\nParam\tcoef6(0.739829012544530, min=-10, max=10);\r\nParam\tcoef7(0.947940906329181, min=-10, max=10);\r\nParam\tcoef8(0.991209712705258, min=-10, max=10);\r\n\r\nx\t\t\t= in1;\r\n\r\nreal, imag\t= eviHilbertCascade(x, coef1, coef2, coef3, coef4, coef5, coef6, coef7, coef8);\r\n\r\nout1\t\t= real;\r\nout2\t\t= imag;\r\n\r\n"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "out 1 (signal) Cosine/Real Output",
                                        "patching_rect": [ 49.0, 660.0, 186.0, 22.0 ],
                                        "id": "obj-4",
                                        "numinlets": 1,
                                        "numoutlets": 0
                                    }
                                }
                            ],
                            "lines": [
                                {
                                    "patchline": {
                                        "source": [ "obj-3", 1 ],
                                        "destination": [ "obj-5", 0 ],
                                        "midpoints": [ 796.5, 651.5, 640.5, 651.5 ]
                                    }
