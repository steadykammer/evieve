                                    "code": "\r\n/*\n    PolyphaseIIR2Designer\n    Copyright (c) 2005 Laurent de Soras\n\r\n    --- Legal stuff ---\n\n    This program is free software. It comes without any warranty, to\n    the extent permitted by applicable law. You can redistribute it\n    and/or modify it under the terms of the Do What The Fuck You Want\n    To Public License, Version 2, as published by Sam Hocevar. See\n    http://sam.zoy.org/wtfpl/COPYING for more details.\n\n    -------\n\n    ported to rnboscript (sorry) by pete for evieve\r\n    @see: 'evi_polyphaseiir2coefficients.js'\n*/\r\n/*\r\nfunction ipowp (xx, nn)\n{\n//\t(nn >= 0)\n\tlet z = 1.0;\n\tlet x : Int = xx;\n\tlet n : Int = nn;\n\n\twhile (n != 0)\n\t{\n\t\tif ((n & 1) != 0)\n\t\t{\n\t\t\tz *= x;\n\t\t}\n\t\tn >>= 1;\n\t\tx *= x;\n\t}\n\n\treturn z;\n}\r\n*/\r\n// :-(\r\nfunction ipowp_RNBO (xx, nn)\n{\n//\t(nn >= 0)\n\tlet z = 1.0;\n\tlet x = xx; // double !\n\tlet n : Int = nn;\n\n\twhile (n != 0)\n\t{\n\t\tif ((n % 2) != 0)\n\t\t{\n\t\t\tz *= x;\n\t\t}\n\t\tn = floor(n / 2);\n\t\tx *= x;\n\t}\n\n\treturn z;\n}\r\n\r\nfunction compute_acc_den (q, order, c)\n{\n//\t(c >= 1);\n//\t(c < order * 2);\n\n\tlet\ti : Int =  0;\n\tlet\tj : Int = -1;\n\tlet\tacc     = 0.0;\n\tlet\tq_i2    = 0.0;\n\n\tdo\n\t{\n\t\tq_i2  = ipowp_RNBO(q, i * i);\r\n\t\tq_i2 *= cos((i + i) * c * PI / order) * j;\n\t\tacc  += q_i2;\n\n\t\tj = -j;\n\t\t++i;\n\t}\n\twhile (abs(q_i2) > 1e-100);\n\n\treturn acc;\n}\r\n\r\nfunction compute_acc_num (q, order, c)\n{\n//\t(c >= 1);\n//\t(c < order * 2);\n\n\tlet i : Int = 0;\n\tlet j : Int = 1;\n\tlet acc     = 0.0;\n\tlet q_ii1   = 0.0;\n\n\tdo\n\t{\n\t\tq_ii1\t= ipowp_RNBO(q, i * (i + 1));\r\n\t\tq_ii1  *= sin((i + i + 1) * c * PI / order) * j;\n\t\tacc    += q_ii1;\n\n\t\tj = -j;\n\t\t++i;\n\t}\n\twhile (abs(q_ii1) > 1e-100);\n\r\n\treturn\tacc;\n}\r\n\r\n// RNBO needs explicit types\r\nfunction compute_coef (index : Int, k : number, q : number, order : Int) : number\n{\n//\t(index >= 0);\n//\t(index * 2 < order);\n\n\tlet\tc : Int  = int(index + 1);\r\n\tlet\t\tnum  = compute_acc_num(q, order, c) * pow(q, 0.25);//sqrt(sqrt(q));\n\tlet\t\tden  = compute_acc_den(q, order, c) + 0.5;\n\tlet\t\tww   = num / den;\n\tlet\t\twwsq = ww * ww;\n\n\tlet\t\tx    = sqrt((1.0 - wwsq * k) * (1.0 - wwsq / k)) / (1.0 + wwsq);\n\tlet\t\tcoef = (1.0 - x) / (1.0 + x);\n\r\n\treturn\tcoef;\n}\r\n\r\nfunction compute_transition_param (transition)\n{\n//\t(transition > 0);\n//\t(transition < 0.5);\n\n\tlet k  = tan((1.0 - (transition + transition)) * PI * 0.25);\n\t    k *= k;\n//\t(k < 1);\n//\t(k > 0);\n\n//  let     kk      = 1.0 - k * k;\n//\tlet\t\tkksqrt\t= sqrt(sqrt(kk));\n    let     kksqrt  = pow(1.0 - k*k, 0.25);\n\tlet\t\tee \t\t= 0.5 * (1.0 - kksqrt) / (1.0 + kksqrt);\n\tlet\t\tee2 \t= ee * ee;\n\tlet\t\tee4 \t= ee2 * ee2;\n\tlet q           = ee * (1.0 + ee4 * (2.0 + ee4 * (15.0 + 150.0 * ee4)));\n//\t(q > 0);\n\n    return [k, q];\n}\r\n\r\n//  -------\r\n\r\n// in this cheap rnboscript version of this code, we fix for our hilbert filter, so we can use fixed arrays here\r\n\r\nconst numCoefs : Int = 8;\r\nconst numCoefsHalf : Int = numCoefs / 2;\r\nconst bandwidth : number = 40.0; // Hz\r\n@state transition : number = 0.000833333333333; // computed, bandwidth / samplerate\r\n@state kq : list = [0.0, 0.0]; // computed\r\n@state order : Int = 0; // computed\r\n\r\n@state coefsPhase = new FixedFloat64Array(numCoefs);\n@state coefs90deg = new FixedFloat64Array(numCoefs);\n@state coefsHilbert = new FixedFloat64Array(numCoefs);\r\n//@state coefsSqrt = new FixedFloat64Array(numCoefs);\n\r\n@state coefs = new FixedFloat64Array(numCoefs);\n\r\n// thanks to Olli Niemitalo, @see: http://yehar.com/blog/?p=368\r\nfunction polyphaseIir2HilbertDesigner_RNBO ()\n{\n\t// Phase reference path c coefficients:\n\tfor (let i = 1; i < numCoefs; i += 2) {\n\t\tcoefsPhase[(i - 1) / 2] = coefs[i];\n\t}\n\t// +90 deg path c coefficients:\n\tfor (let j = 0; j < numCoefs; j += 2) {\n\t\tcoefs90deg[j / 2] = coefs[j];\n\t}\n\t// interleave for hilbert output\n\tfor (let m = 0; m < numCoefsHalf; ++m) {\n\t\tcoefsHilbert[m] = coefsPhase[m];\n\t\tcoefsHilbert[m + 4] = coefs90deg[m];\n\t}\n\t// sqrt gives pole locations, interleaved\n//\tfor (let s = 0; s < numCoefs; ++s) {\n//\t\tcoefsSqrt[s] = sqrt(coefs[s]);\n//\t}\n}\r\n\r\nfunction init()\r\n{\r\n    let thisSR = samplerate(); // must declare first !\r\n\ttransition = bandwidth / thisSR;\r\n\tkq = compute_transition_param(transition); // compute k & q\r\n\torder = int(numCoefs + numCoefs + 1);\r\n}\r\n\r\nfunction startup()\r\n{\n\t// Coefficient calculation\r\n    let index : Int;\n\tfor (index = 0; index < numCoefs; ++index)\n\t{\n\t\tcoefs[index] = compute_coef(index, kq[0], kq[1], order);\n\t}\n    // fill arrays\r\n    polyphaseIir2HilbertDesigner_RNBO();\r\n    // output coefficients\r\n    out1 = coefsHilbert[0];     out2 = coefsHilbert[1];     out3 = coefsHilbert[2];     out4 = coefsHilbert[3];\r\n    out5 = coefsHilbert[4];     out6 = coefsHilbert[5];     out7 = coefsHilbert[6];     out8 = coefsHilbert[7];\r\n}\r\n\r\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-1",
                                    "maxclass": "codebox",
                                    "numinlets": 1,
                                    "numoutlets": 8,
                                    "outlettype": [ "", "", "", "", "", "", "", "" ],
                                    "patching_rect": [ 33.0, 59.0, 933.0, 829.0 ],
                                    "rnbo_classname": "codebox",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "hot": 0,
                                        "safemath": 1,
                                        "code": "\r\n/*\n    PolyphaseIIR2Designer\n    Copyright (c) 2005 Laurent de Soras\n\r\n    --- Legal stuff ---\n\n    This program is free software. It comes without any warranty, to\n    the extent permitted by applicable law. You can redistribute it\n    and/or modify it under the terms of the Do What The Fuck You Want\n    To Public License, Version 2, as published by Sam Hocevar. See\n    http://sam.zoy.org/wtfpl/COPYING for more details.\n\n    -------\n\n    ported to rnboscript (sorry) by pete for evieve\r\n    @see: 'evi_polyphaseiir2coefficients.js'\n*/\r\n/*\r\nfunction ipowp (xx, nn)\n{\n//\t(nn >= 0)\n\tlet z = 1.0;\n\tlet x : Int = xx;\n\tlet n : Int = nn;\n\n\twhile (n != 0)\n\t{\n\t\tif ((n & 1) != 0)\n\t\t{\n\t\t\tz *= x;\n\t\t}\n\t\tn >>= 1;\n\t\tx *= x;\n\t}\n\n\treturn z;\n}\r\n*/\r\n// :-(\r\nfunction ipowp_RNBO (xx, nn)\n{\n//\t(nn >= 0)\n\tlet z = 1.0;\n\tlet x = xx; // double !\n\tlet n : Int = nn;\n\n\twhile (n != 0)\n\t{\n\t\tif ((n % 2) != 0)\n\t\t{\n\t\t\tz *= x;\n\t\t}\n\t\tn = floor(n / 2);\n\t\tx *= x;\n\t}\n\n\treturn z;\n}\r\n\r\nfunction compute_acc_den (q, order, c)\n{\n//\t(c >= 1);\n//\t(c < order * 2);\n\n\tlet\ti : Int =  0;\n\tlet\tj : Int = -1;\n\tlet\tacc     = 0.0;\n\tlet\tq_i2    = 0.0;\n\n\tdo\n\t{\n\t\tq_i2  = ipowp_RNBO(q, i * i);\r\n\t\tq_i2 *= cos((i + i) * c * PI / order) * j;\n\t\tacc  += q_i2;\n\n\t\tj = -j;\n\t\t++i;\n\t}\n\twhile (abs(q_i2) > 1e-100);\n\n\treturn acc;\n}\r\n\r\nfunction compute_acc_num (q, order, c)\n{\n//\t(c >= 1);\n//\t(c < order * 2);\n\n\tlet i : Int = 0;\n\tlet j : Int = 1;\n\tlet acc     = 0.0;\n\tlet q_ii1   = 0.0;\n\n\tdo\n\t{\n\t\tq_ii1\t= ipowp_RNBO(q, i * (i + 1));\r\n\t\tq_ii1  *= sin((i + i + 1) * c * PI / order) * j;\n\t\tacc    += q_ii1;\n\n\t\tj = -j;\n\t\t++i;\n\t}\n\twhile (abs(q_ii1) > 1e-100);\n\r\n\treturn\tacc;\n}\r\n\r\n// RNBO needs explicit types\r\nfunction compute_coef (index : Int, k : number, q : number, order : Int) : number\n{\n//\t(index >= 0);\n//\t(index * 2 < order);\n\n\tlet\tc : Int  = int(index + 1);\r\n\tlet\t\tnum  = compute_acc_num(q, order, c) * pow(q, 0.25);//sqrt(sqrt(q));\n\tlet\t\tden  = compute_acc_den(q, order, c) + 0.5;\n\tlet\t\tww   = num / den;\n\tlet\t\twwsq = ww * ww;\n\n\tlet\t\tx    = sqrt((1.0 - wwsq * k) * (1.0 - wwsq / k)) / (1.0 + wwsq);\n\tlet\t\tcoef = (1.0 - x) / (1.0 + x);\n\r\n\treturn\tcoef;\n}\r\n\r\nfunction compute_transition_param (transition)\n{\n//\t(transition > 0);\n//\t(transition < 0.5);\n\n\tlet k  = tan((1.0 - (transition + transition)) * PI * 0.25);\n\t    k *= k;\n//\t(k < 1);\n//\t(k > 0);\n\n//  let     kk      = 1.0 - k * k;\n//\tlet\t\tkksqrt\t= sqrt(sqrt(kk));\n    let     kksqrt  = pow(1.0 - k*k, 0.25);\n\tlet\t\tee \t\t= 0.5 * (1.0 - kksqrt) / (1.0 + kksqrt);\n\tlet\t\tee2 \t= ee * ee;\n\tlet\t\tee4 \t= ee2 * ee2;\n\tlet q           = ee * (1.0 + ee4 * (2.0 + ee4 * (15.0 + 150.0 * ee4)));\n//\t(q > 0);\n\n    return [k, q];\n}\r\n\r\n//  -------\r\n\r\n// in this cheap rnboscript version of this code, we fix for our hilbert filter, so we can use fixed arrays here\r\n\r\nconst numCoefs : Int = 8;\r\nconst numCoefsHalf : Int = numCoefs / 2;\r\nconst bandwidth : number = 40.0; // Hz\r\n@state transition : number = 0.000833333333333; // computed, bandwidth / samplerate\r\n@state kq : list = [0.0, 0.0]; // computed\r\n@state order : Int = 0; // computed\r\n\r\n@state coefsPhase = new FixedFloat64Array(numCoefs);\n@state coefs90deg = new FixedFloat64Array(numCoefs);\n@state coefsHilbert = new FixedFloat64Array(numCoefs);\r\n//@state coefsSqrt = new FixedFloat64Array(numCoefs);\n\r\n@state coefs = new FixedFloat64Array(numCoefs);\n\r\n// thanks to Olli Niemitalo, @see: http://yehar.com/blog/?p=368\r\nfunction polyphaseIir2HilbertDesigner_RNBO ()\n{\n\t// Phase reference path c coefficients:\n\tfor (let i = 1; i < numCoefs; i += 2) {\n\t\tcoefsPhase[(i - 1) / 2] = coefs[i];\n\t}\n\t// +90 deg path c coefficients:\n\tfor (let j = 0; j < numCoefs; j += 2) {\n\t\tcoefs90deg[j / 2] = coefs[j];\n\t}\n\t// interleave for hilbert output\n\tfor (let m = 0; m < numCoefsHalf; ++m) {\n\t\tcoefsHilbert[m] = coefsPhase[m];\n\t\tcoefsHilbert[m + 4] = coefs90deg[m];\n\t}\n\t// sqrt gives pole locations, interleaved\n//\tfor (let s = 0; s < numCoefs; ++s) {\n//\t\tcoefsSqrt[s] = sqrt(coefs[s]);\n//\t}\n}\r\n\r\nfunction init()\r\n{\r\n    let thisSR = samplerate(); // must declare first !\r\n\ttransition = bandwidth / thisSR;\r\n\tkq = compute_transition_param(transition); // compute k & q\r\n\torder = int(numCoefs + numCoefs + 1);\r\n}\r\n\r\nfunction startup()\r\n{\n\t// Coefficient calculation\r\n    let index : Int;\n\tfor (index = 0; index < numCoefs; ++index)\n\t{\n\t\tcoefs[index] = compute_coef(index, kq[0], kq[1], order);\n\t}\n    // fill arrays\r\n    polyphaseIir2HilbertDesigner_RNBO();\r\n    // output coefficients\r\n    out1 = coefsHilbert[0];     out2 = coefsHilbert[1];     out3 = coefsHilbert[2];     out4 = coefsHilbert[3];\r\n    out5 = coefsHilbert[4];     out6 = coefsHilbert[5];     out7 = coefsHilbert[6];     out8 = coefsHilbert[7];\r\n}\r\n\r\n"
                                    },
