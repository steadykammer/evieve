                    "id": "obj-5",
                    "maxclass": "newobj",
                    "numinlets": 4,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patching_rect": [ 393.0, 359.0, 200.0, 23.0 ],
                    "rnbo_classname": "gen~",
                    "rnbo_extra_attributes": {
                        "s2_445": 0.0,
                        "datatype": 0.0,
                        "w_228": 0.0,
                        "w_269": 0.0,
                        "w_310": 0.0,
                        "bwwarp": 1.0,
                        "w_351": 0.0,
