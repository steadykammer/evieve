                        "w_345": 0.0,
                        "gainwarp": 1.0,
                        "w_386": 0.0,
                        "formantfrequency": 0.0,
                        "w_40": 0.0,
                        "s1_416": 0.0,
                        "w_210": 0.0,
                        "s2_459": 0.0,
                        "voices": 5.0,
                        "w_251": 0.0,
                        "w_292": 0.0,
                        "w_333": 0.0,
                        "w_374": 0.0,
                        "cfwarp": 1.0,
                        "s1_402": 0.0,
                        "warpsmooth": 1.0,
