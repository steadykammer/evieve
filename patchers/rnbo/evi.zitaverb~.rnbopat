                                "box": {
                                    "code": "\r\n// // // setup // // //\n\nconst nestedsize: Int = 8;\nconst fbsize: Int = 8;\nconst compsize: Int = 8;\n\nconst maxnestsamps: Int = 6068;\nconst maxfbsamps: Int = 49324;\n\n@state nestedsecs = new FixedFloat32Array([\t0.020346, \n\t\t\t\t\t\t\t                0.024421, \n\t\t\t\t\t\t\t                0.031604, \n\t\t\t\t\t\t\t                0.027333, \n\t\t\t\t\t\t\t                0.022904, \n\t\t\t\t\t\t\t                0.029291, \n\t\t\t\t\t\t\t                0.013458, \n\t\t\t\t\t\t\t                0.019123 \n                                            ]);\n\n@state fbsecs = new FixedFloat32Array([\t0.153129, \n\t\t\t\t\t\t\t            0.210389, \n\t\t\t\t\t\t\t            0.127837, \n\t\t\t\t\t\t\t            0.256891, \n\t\t\t\t\t\t\t            0.174713, \n\t\t\t\t\t\t\t            0.192303, \n\t\t\t\t\t\t\t            0.125000, \n\t\t\t\t\t\t\t            0.219991 \n                                        ]);\n\n\n@state nestsamps = new FixedUint32Array(nestedsize);\n@state fbsamps = new FixedUint32Array(fbsize);\n@state compsamps = new FixedUint32Array(fbsize);\n\nfunction nestedmake(sr)\n{\n\tfor (var i = 0; i < nestedsize; i++)\n\t{\n\t\tnestsamps[i] = floor(sr * nestedsecs[i] + 0.5);\n\t}\n}\n\nfunction feedbackmake(sr)\n{\n\tfor (var i = 0; i < fbsize; i++)\n\t{\n\t\tfbsamps[i] = floor(sr * fbsecs[i] + 0.5);\n\t}\n}\n\nfunction init()\n{\n    sr = samplerate();\n    nestedmake(sr);\n    feedbackmake(sr);\r\n    for (i = 0; i < compsize; i++)\r\n    {\r\n        compsamps[i] = fbsamps[i] - nestsamps[i];\r\n    }\n}\n\r\nfunction startup()\r\n{\r\n    out1 = nestsamps[0];     out2 = nestsamps[1];     out3 = nestsamps[2];     out4 = nestsamps[3];\r\n    out5 = nestsamps[4];     out6 = nestsamps[5];     out7 = nestsamps[6];     out8 = nestsamps[7];\r\n\r\n    out9 = fbsamps[0];     out10 = fbsamps[1];    out11 = fbsamps[2];   out12 = fbsamps[3];\r\n    out13 = fbsamps[4];    out14 = fbsamps[5];    out15 = fbsamps[6];   out16 = fbsamps[7];\r\n\r\n    out17 = compsamps[0];    out18 = compsamps[1];    out19 = compsamps[2];    out20 = compsamps[3];\r\n    out21 = compsamps[4];    out22 = compsamps[5];    out23 = compsamps[6];    out24 = compsamps[7];\r\n}\r\n\r\n",
