                            },
                            {
                                "box": {
                                    "code": "\n// // // local functions // // //\n\r\nfunction mapFilt(filt : Int)\r\n{\r\n    let filts : list = [0, 3, 2, 6];            // 0, 3, 2, 6 : bypass, bell, lowshelf, highshelf\r\n    return filts[filt];\r\n}\r\n\nfunction svfSectionCoeffEq(filter, cutoff, gain, Q, SR) // gain is Linear !\n{\n\tlet a1, a2, a3\t\t= 0;\t\t\t\t\t// coefficients\n\tlet m0, m1, m2\t\t= 0;\t\t\t\t\t// mixing gains\n\n//\tlet g\t= tanA2(PI * cutoff / SR);\n\tlet g\t= tan(PI * cutoff / SR);\n\n\tif\t\t\t\t(filter == 1) {\t\t\t\t// HIGHPASS\n\t\tlet A \t= maximum(gain, 0.001);\n\t\tlet k\t= 1 / Q;\n\t\ta1\t= 1 / (1 + g * (g + k));\n\t\ta2\t= g * a1;\n\t\ta3\t= g * a2;\n\t\t\n\t\tm0\t=  A;\n\t\tm1\t= -k * A;\n\t\tm2\t= -A;\n\t} else if\t\t(filter == 2) {\t\t\t\t// LOWSHELF\n\t\tlet A \t= sqrt(maximum(gain, 0.001));\n\t\tlet AA\t= A * A;\n\t\tlet sA\t= sqrt(A);\n\t\tlet k\t= 1 / Q;\n\t\tg\t= g / sA;\n\n\t\ta1\t= 1 / (1 + g * (g + k));\n\t\ta2\t= g * a1;\n\t\ta3\t= g * a2;\n\n\t\tm0\t= 1;\n\t\tm1\t= k * (A - 1);\n\t\tm2\t= AA - 1;\n\t} else if\t\t(filter == 3) {\t\t\t\t// BELL\n\t\tlet A \t= sqrt(maximum(gain, 0.001));\n\t\tlet AA\t= A * A;\n\t\tlet k\t= 1 / (Q * A);\n\n\t\ta1\t= 1 / (1 + g * (g + k));\n\t\ta2\t= g * a1;\n\t\ta3\t= g * a2;\n\n\t\tm0\t= 1;\n\t\tm1\t= k * (AA - 1);\n\t\tm2\t= 0;\n\t} else if\t\t(filter == 4) {\t\t\t\t// BELL_ADAPTIVE_Q\n\t\tlet G \t= maximum(gain, 0.001);\n\t\tlet A \t= sqrt(G);\n\t\tlet AA\t= A * A;\n\t\tlet vA\t= (G >= 1) ? (G) : (1 / G);\n\t\tlet vQ\t= Q * sqrt(vA);\n\t\tlet k\t= 1 / (vQ * A);\n\n\t\ta1\t= 1 / (1 + g * (g + k));\n\t\ta2\t= g * a1;\n\t\ta3\t= g * a2;\n\n\t\tm0\t= 1;\n\t\tm1\t= k * (AA - 1);\n\t\tm2\t= 0;\n\t} else if\t\t(filter == 5) {\t\t\t\t// NOTCH\n\t\tlet A \t= maximum(gain, 0.001);\n\t\tlet k\t= 1 / Q;\n\t\ta1\t= 1 / (1 + g * (g + k));\n\t\ta2\t= g * a1;\n\t\ta3\t= g * a2;\n\n\t\tm0\t=  A;\n\t\tm1\t= -k * A;\n\t\tm2\t=  0;\n\t} else if \t\t(filter == 6) {\t\t\t\t// HIGHSELF\n\t\tlet A \t= sqrt(maximum(gain, 0.001));\n\t\tlet AA\t= A * A;\n\t\tlet sA\t= sqrt(A);\n\t\tlet k\t= 1 / Q;\n\t\tg\t= g * sA;\n\n\t\ta1\t= 1 / (1 + g * (g + k));\n\t\ta2\t= g * a1;\n\t\ta3\t= g * a2;\n\n\t\tm0\t= AA;\n\t\tm1\t= k * (1 - A) * A;\n\t\tm2\t= 1 - AA;\n\t} else if\t\t(filter == 7) {\t\t\t\t// LOWPASS\n\t\tlet A \t= maximum(gain, 0.001);\n\t\tlet k\t= 1 / Q;\n\t\ta1\t= 1 / (1 + g * (g + k));\n\t\ta2\t= g * a1;\n\t\ta3\t= g * a2;\n\n\t\tm0\t=  0;\n\t\tm1\t=  0;\n\t\tm2\t=  A;\n\t} else {\t//\t(filter <= 0 || >= 8)\t\t// BYPASS\n\t\ta1, a2, a3\t= 0;\n\t\tm1, m2\t\t= 0;\n\t\tm0\t\t\t= 1;\n\t}\n\n\treturn\t[ a1, a2, a3, m0, m1, m2 ];\n}\n\r\nlet sr = samplerate();\r\n\r\n// // // EQ // // //\r\n/*\r\n// RNBO will not let me have only param inputs, because...\r\n@param({ min: 10, max: 18000}) cutoff1 = 315;\t\t// Hz\r\n@param({ min: -15, max: 15}) gain1 = 0;\t\t\t    // dB\r\n//@param({ min: 0.05, max: 20}) resonance1 = 1;\t    // Q\r\n@param({ min: 30, max: 20000}) cutoff2 = 1260;\t    // Hz\r\n@param({ min: -15, max: 15}) gain2 = 0;\t\t\t    // dB\r\n//@param({ min: 0.05, max: 20}) resonance2 = 0.5;\t// Q\r\n\r\n@param({ min: 0, max: 1}) filter1 = 0;              // choose filter type (default lowshelf)\r\n@param({ min: 0, max: 1}) filter2 = 0;              // choose filter type (default highshelf)\r\n*/\r\n// RNBO will not let me have only param inputs, because...\r\nlet cutoff1 = in2;\r\nlet gain1 = in3;\r\nlet cutoff2 = in5;\r\nlet gain2 = in6;\r\nlet filter1 = in1;\r\nlet filter2 = in4;\r\n\r\nlet filtlookup1 : Int = int(((1 - filter1) * 1) + 1);\r\nlet filtlookup2 : Int = int(((1 - filter2) * 2) + 1);\r\n\r\nlet selfilter1 = mapFilt(filtlookup1);\r\nlet selfilter2 = mapFilt(filtlookup2);\r\n\r\nlet resonance1 = filtlookup1 > 1 ? 1 : sqrt1_2;\r\nlet resonance2 = filtlookup2 > 1 ? 0.5 : sqrt1_2;\r\n\r\nlet filterCoeffs1 = svfSectionCoeffEq(selfilter1, cutoff1, gain1, resonance1, sr);\r\nlet filterCoeffs2 = svfSectionCoeffEq(selfilter2, cutoff2, gain2, resonance2, sr);\r\n\r\n// // // Outputs // // //\r\n\r\nout1 = filterCoeffs1[0];    out2 = filterCoeffs1[1];    out3 = filterCoeffs1[2];\r\nout4 = filterCoeffs1[3];    out5 = filterCoeffs1[4];    out6 = filterCoeffs1[5];\r\n\r\nout7 = filterCoeffs2[0];    out8 = filterCoeffs2[1];    out9 = filterCoeffs2[2];\r\nout10 = filterCoeffs2[3];   out11 = filterCoeffs2[4];   out12 = filterCoeffs2[5];\r\n\r\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-33",
                                    "maxclass": "codebox",
                                    "numinlets": 6,
                                    "numoutlets": 12,
                                    "outlettype": [ "", "", "", "", "", "", "", "", "", "", "", "" ],
                                    "patching_rect": [ 49.0, 59.0, 803.0, 694.0 ],
                                    "rnbo_classname": "codebox",
                                    "rnbo_extra_attributes": {
                                        "code": "\n// // // local functions // // //\n\r\nfunction mapFilt(filt : Int)\r\n{\r\n    let filts : list = [0, 3, 2, 6];            // 0, 3, 2, 6 : bypass, bell, lowshelf, highshelf\r\n    return filts[filt];\r\n}\r\n\nfunction svfSectionCoeffEq(filter, cutoff, gain, Q, SR) // gain is Linear !\n{\n\tlet a1, a2, a3\t\t= 0;\t\t\t\t\t// coefficients\n\tlet m0, m1, m2\t\t= 0;\t\t\t\t\t// mixing gains\n\n//\tlet g\t= tanA2(PI * cutoff / SR);\n\tlet g\t= tan(PI * cutoff / SR);\n\n\tif\t\t\t\t(filter == 1) {\t\t\t\t// HIGHPASS\n\t\tlet A \t= maximum(gain, 0.001);\n\t\tlet k\t= 1 / Q;\n\t\ta1\t= 1 / (1 + g * (g + k));\n\t\ta2\t= g * a1;\n\t\ta3\t= g * a2;\n\t\t\n\t\tm0\t=  A;\n\t\tm1\t= -k * A;\n\t\tm2\t= -A;\n\t} else if\t\t(filter == 2) {\t\t\t\t// LOWSHELF\n\t\tlet A \t= sqrt(maximum(gain, 0.001));\n\t\tlet AA\t= A * A;\n\t\tlet sA\t= sqrt(A);\n\t\tlet k\t= 1 / Q;\n\t\tg\t= g / sA;\n\n\t\ta1\t= 1 / (1 + g * (g + k));\n\t\ta2\t= g * a1;\n\t\ta3\t= g * a2;\n\n\t\tm0\t= 1;\n\t\tm1\t= k * (A - 1);\n\t\tm2\t= AA - 1;\n\t} else if\t\t(filter == 3) {\t\t\t\t// BELL\n\t\tlet A \t= sqrt(maximum(gain, 0.001));\n\t\tlet AA\t= A * A;\n\t\tlet k\t= 1 / (Q * A);\n\n\t\ta1\t= 1 / (1 + g * (g + k));\n\t\ta2\t= g * a1;\n\t\ta3\t= g * a2;\n\n\t\tm0\t= 1;\n\t\tm1\t= k * (AA - 1);\n\t\tm2\t= 0;\n\t} else if\t\t(filter == 4) {\t\t\t\t// BELL_ADAPTIVE_Q\n\t\tlet G \t= maximum(gain, 0.001);\n\t\tlet A \t= sqrt(G);\n\t\tlet AA\t= A * A;\n\t\tlet vA\t= (G >= 1) ? (G) : (1 / G);\n\t\tlet vQ\t= Q * sqrt(vA);\n\t\tlet k\t= 1 / (vQ * A);\n\n\t\ta1\t= 1 / (1 + g * (g + k));\n\t\ta2\t= g * a1;\n\t\ta3\t= g * a2;\n\n\t\tm0\t= 1;\n\t\tm1\t= k * (AA - 1);\n\t\tm2\t= 0;\n\t} else if\t\t(filter == 5) {\t\t\t\t// NOTCH\n\t\tlet A \t= maximum(gain, 0.001);\n\t\tlet k\t= 1 / Q;\n\t\ta1\t= 1 / (1 + g * (g + k));\n\t\ta2\t= g * a1;\n\t\ta3\t= g * a2;\n\n\t\tm0\t=  A;\n\t\tm1\t= -k * A;\n\t\tm2\t=  0;\n\t} else if \t\t(filter == 6) {\t\t\t\t// HIGHSELF\n\t\tlet A \t= sqrt(maximum(gain, 0.001));\n\t\tlet AA\t= A * A;\n\t\tlet sA\t= sqrt(A);\n\t\tlet k\t= 1 / Q;\n\t\tg\t= g * sA;\n\n\t\ta1\t= 1 / (1 + g * (g + k));\n\t\ta2\t= g * a1;\n\t\ta3\t= g * a2;\n\n\t\tm0\t= AA;\n\t\tm1\t= k * (1 - A) * A;\n\t\tm2\t= 1 - AA;\n\t} else if\t\t(filter == 7) {\t\t\t\t// LOWPASS\n\t\tlet A \t= maximum(gain, 0.001);\n\t\tlet k\t= 1 / Q;\n\t\ta1\t= 1 / (1 + g * (g + k));\n\t\ta2\t= g * a1;\n\t\ta3\t= g * a2;\n\n\t\tm0\t=  0;\n\t\tm1\t=  0;\n\t\tm2\t=  A;\n\t} else {\t//\t(filter <= 0 || >= 8)\t\t// BYPASS\n\t\ta1, a2, a3\t= 0;\n\t\tm1, m2\t\t= 0;\n\t\tm0\t\t\t= 1;\n\t}\n\n\treturn\t[ a1, a2, a3, m0, m1, m2 ];\n}\n\r\nlet sr = samplerate();\r\n\r\n// // // EQ // // //\r\n/*\r\n// RNBO will not let me have only param inputs, because...\r\n@param({ min: 10, max: 18000}) cutoff1 = 315;\t\t// Hz\r\n@param({ min: -15, max: 15}) gain1 = 0;\t\t\t    // dB\r\n//@param({ min: 0.05, max: 20}) resonance1 = 1;\t    // Q\r\n@param({ min: 30, max: 20000}) cutoff2 = 1260;\t    // Hz\r\n@param({ min: -15, max: 15}) gain2 = 0;\t\t\t    // dB\r\n//@param({ min: 0.05, max: 20}) resonance2 = 0.5;\t// Q\r\n\r\n@param({ min: 0, max: 1}) filter1 = 0;              // choose filter type (default lowshelf)\r\n@param({ min: 0, max: 1}) filter2 = 0;              // choose filter type (default highshelf)\r\n*/\r\n// RNBO will not let me have only param inputs, because...\r\nlet cutoff1 = in2;\r\nlet gain1 = in3;\r\nlet cutoff2 = in5;\r\nlet gain2 = in6;\r\nlet filter1 = in1;\r\nlet filter2 = in4;\r\n\r\nlet filtlookup1 : Int = int(((1 - filter1) * 1) + 1);\r\nlet filtlookup2 : Int = int(((1 - filter2) * 2) + 1);\r\n\r\nlet selfilter1 = mapFilt(filtlookup1);\r\nlet selfilter2 = mapFilt(filtlookup2);\r\n\r\nlet resonance1 = filtlookup1 > 1 ? 1 : sqrt1_2;\r\nlet resonance2 = filtlookup2 > 1 ? 0.5 : sqrt1_2;\r\n\r\nlet filterCoeffs1 = svfSectionCoeffEq(selfilter1, cutoff1, gain1, resonance1, sr);\r\nlet filterCoeffs2 = svfSectionCoeffEq(selfilter2, cutoff2, gain2, resonance2, sr);\r\n\r\n// // // Outputs // // //\r\n\r\nout1 = filterCoeffs1[0];    out2 = filterCoeffs1[1];    out3 = filterCoeffs1[2];\r\nout4 = filterCoeffs1[3];    out5 = filterCoeffs1[4];    out6 = filterCoeffs1[5];\r\n\r\nout7 = filterCoeffs2[0];    out8 = filterCoeffs2[1];    out9 = filterCoeffs2[2];\r\nout10 = filterCoeffs2[3];   out11 = filterCoeffs2[4];   out12 = filterCoeffs2[5];\r\n\r\n",
