, 											{
												"box" : 												{
													"comment" : "",
													"id" : "obj-44",
													"index" : 1,
													"maxclass" : "outlet",
													"numinlets" : 1,
													"numoutlets" : 0,
													"patching_rect" : [ 49.0, 180.0, 30.0, 30.0 ]
												}

											}
, 											{
												"box" : 												{
													"id" : "obj-8",
													"linecount" : 39,
													"maxclass" : "comment",
													"numinlets" : 1,
													"numoutlets" : 0,
													"patching_rect" : [ 794.0, 180.0, 562.0, 543.0 ],
													"text" : "\n// in Juhana Sadeharju & Graham Wakefield verion, not available (fixed)\n// in Olaf Matthes version, object creation argument only:\n//\n// offsets L/R levels, could be in degrees but 0..1 here\n// L/R width % 0..1\nParam\t spread(0.22, min=0, max=1);\n// \"Second argument is stereo spreading (0 - 100) which defaults to 15.\"\n//\n\n// early refelections level in dB\nParam\t early(-9, min=-90, max=0);\n// \"The quantity of early reflections (scatter reflections directly from the source).\n// Think of Lexicon's ambiance patches.\"\n//\n\n// 'tail' level in dB\nParam \tlate(-11, min=-90, max=0);\n// \"The level of the classic reverb tail reflections.\"\n//\n\n// dry level in dB\nParam\t dry(-3, min=-90, max=0);\n// \"The level of the unreverberated signal.\"\n//\n\n// toggle, 1=bypassed, quasi cpu saving\nParam \tbypass(0, min=0, max=1);\n// \"Bypass, signal uneffected when set to 1. Can be used to compare reverb signal with\n// original signal and to save CPU power when gigaverb~ is not used.\"\n//\n\n// this is essentially a mono-in stereo-out reverb, but you can toggle 'stereo' 'on' ('1')\n// to explicitly control L/R signals into late diffusion section (and dry L/R),\n// default '0' 'off' (mono-in, stereo-out)\n// !! no smoothing !!\nParam\t stereo(0, min=0, max=2);\n\nParam\tsmoothtime\t( \t50,\tmin=1,\tmax=500\t\t);\t\t\t// parameter smoothing in ms\n"
												}

											}
, 											{
												"box" : 												{
													"id" : "obj-16",
													"linecount" : 35,
													"maxclass" : "comment",
													"numinlets" : 1,
													"numoutlets" : 0,
													"patching_rect" : [ 177.0, 180.0, 562.000000000000114, 489.0 ],
													"text" : "// -- -- -- -- -- -- -- -- -- --\tparams (reverb)\t\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\n\n// original Olaf Matthes comments in \"quotes\" underneath each Param declaration\n// defaults are roughly Olaf Matthes 'church' preset\n\n// un-warped frequency - scaling & filter are different in this version to original\n// 'bandwidth' 1 - (g / (1 + g)) 0..1\n// & new system over originals, amount of bandwidth attenuation:\n// high or how pass if k == 1, bypass if k == 0, else low or high shelf attenuation\n// [ k ] % 0..1 (1 - attenuation)\nParam\t bandwidth(0.69, min=0, max=1);\n// \"This is like a damping control for the input, it has a similar effect to the damping\n// control, but is subtly different.\"\n//\n\n// pre-warped frequency - scaling & filters are different in this version to original\n// 'damping' 1 - (g / (1 + g)) 0..1\n// & new system over originals, amount of damping attenuation:\n// high or how pass if k == 1, bypass if k == 0, else low or high shelf attenuation\n// [ k ] % 0..1 (attenuation ++)\nParam\t damping(0.41, min=0, max=1);\n// \"This controls the high frequency damping (a lowpass filter), values near 0 will\n// make it sound very bright, values near 1 will make it sound very dark.\"\n//\n\n// 'roomsize' in meters\nParam\t size(80, min=0.1, max=300);\t// min=1 ??\n// \"The size of the room, in meters. Excessivly large, and excessivly small values will\n// make it sound a bit unrealistic. Values of around 30 sound good.\"\n//\n\n// 'revtime' (feeds rt60) in seconds\nParam\t decay(4.85, min=0.1, max=360);\n// \"Reverb decay time, in seconds. 7 is a good place to start. 0.1 - 360 seconds!\"\n//\n"
												}

											}
 ],
