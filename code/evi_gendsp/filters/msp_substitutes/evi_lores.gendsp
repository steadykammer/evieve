                    "outlettype": [ "" ],
                    "patching_rect": [ 36.0, 14.0, 101.0, 22.0 ],
                    "text": "in 1 (signal) Input"
                }
            },
            {
                "box": {
                    "id": "obj-2",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 369.0, 14.0, 345.0, 22.0 ],
                    "text": "in 2 (signal/float) Cutoff Frequency in Hz @max samplerate*0.5"
                }
            },
            {
                "box": {
                    "code": "\r\n// This is a perhaps pointless attempt to make a filter with the bizarre (but very cool) response of MSP [lores~].\r\n// The problems with [lores~] are:  - it digitally clips your audio signal and aliases and is horrible\r\n//                                  - it is totally unstable and blows up after time at high resonance values\r\n//                                  - it is like a Direct Form Z-1 filter that has bad modulation properties\r\n\r\n// [lores~] is basically like the lowpass output of [svf~] but with a unique mapping & coupling of cutoff and resonance:\r\n// frequency affects strength of resonance and resonance affects slope of filter, etc. The irony of the mapping\r\n// of [lores~] is that it has a lower resonance in the low frequency range, but in fairness this is\r\n// a traditional analog SVF type of mapping.\r\n\r\n// In this \"evi_lores\" filter here we just try to give a rough mapping of these properties but on to a superior TPT filter\r\n// so that modulation etc is better. We also make sensible settings for resonance so that it does not clip.\r\n// Notice that this is still just a simple linear filter (like [lores~]), but tuned 'better' - but not identical to [lores~]!\r\n// (we have zeros at nyquist in our TPT so sadly we have the frequency cramping up high).\r\n// For (more normal) nonlinear 12dB lowpass filters consider \"evi_lorez.gendsp\" & \"evi_svfsmooth.gendsp\".\r\n//                                                                   ^Z^\r\n\r\nrequire(\"evi_trig.genexpr\");        // @see also: \"evi_svf.genexpr\"\r\nrequire(\"evi_interp.genexpr\"); \r\n\r\n// param rate version in case you need it\r\nsvfSinLoresCoeff(cutoff, damp)\r\n{\r\n    // [lores~] behaves to about 5 Hz input but this works out about 10 Hz for our svf\r\n    hz  = ((1 - damp) * 490) + 10;                  // a basic version of the bizarre coupling\r\n\tw\t= pi * maximum(cutoff, hz) / samplerate;\n\ts1\t= sin73param(w);\n\ts2\t= sin73param(w + w);\r\n    dimp = damp * damp;\n    dump = clip(dimp * 0.5 + sqrt(s2), 0, 0.96);    // a basic version of the bizarre coupling\n\tk\t= 1 - dump;\n    // or should use the Huovilainen here: res = k * 4; k = res / (1 + g * (2 - res)); ??\n\tnrm\t= 1 / (2 + (k * s1));\n\tg0\t= s2 * nrm;\n\tg1\t= ((-2 * s1 * s1) - (k * s2)) * nrm;\r\n    // we need to modify g2 to match the high freq pole of [lores~], but i cannot work it out\n\tg2\t= ((s1 + s1) * s1) * nrm;\n\r\n    return  g0, g1, g2, dump;\r\n}\r\n\r\n// for use with 'svfSinLoresCoeff()'\r\nsvfSinLoresFilter(X, g0, g1, g2, damp)\r\n{\r\n\tHistory ic1eq(0), ic2eq(0);\n\r\n\tt0\t=   X - ic2eq;\n\tgt0\t=  g0 * ic1eq;\n\tgt1\t=  g1 * ic1eq;\n\tt1\t= (g0 * t0) + gt1;\n\tt2\t= (g2 * t0) + gt0;\n\r\n    // we could mix in -band & +high/peak to sort of match lores~ high freq response ?\n//\tband\t=  t1   +  ic1eq;\n\tlow\t\t=  t2   +  ic2eq;\n//\thigh\t= (X    - (damp * band)) - low;\n//\tpeak\t=  high -  low;\n//\tnotch\t=  high +  low;\n\n\tic1eq  += (t1 + t1);\n\tic2eq  += (t2 + t2);\n\n\treturn low;\r\n}\r\n\r\n// all in one audio rate, 1x\r\nsvfSinLowresFull1(X, cutoff, damp)\n{\n\tHistory ic1eq(0), ic2eq(0);\n\r\n    // [lores~] behaves to about 5 Hz input but this works out about 10 Hz for our svf\r\n    hz  = ((1 - damp) * 490) + 10;                  // a basic version of the bizarre coupling\r\n\tw\t= pi * maximum(cutoff, hz) / samplerate;\n\ts1\t= sin73(w);\n\ts2\t= sin73(w + w);\r\n    dimp = damp * damp;\n    dump = clip(dimp * 0.5 + sqrt(s2), 0, 0.96);    // a basic version of the bizarre coupling\r\n\tk\t= 1 - dump;\n    // or should use the Huovilainen here: res = k * 4; k = res / (1 + g * (2 - res)); ??\n\tnrm\t= 1 / (2 + (k * s1));\n\tg0\t= s2 * nrm;\n\tg1\t= ((-2 * s1 * s1) - (k * s2)) * nrm;\r\n    // we need to modify g2 to match the high freq pole of [lores~], but i cannot work it out\n\tg2\t= ((s1 + s1) * s1) * nrm;\n\n\tt0\t=   X - ic2eq;\n\tgt0\t=  g0 * ic1eq;\n\tgt1\t=  g1 * ic1eq;\n\tt1\t= (g0 * t0) + gt1;\n\tt2\t= (g2 * t0) + gt0;\n\r\n    // we could mix in -band & +high/peak to sort of match lores~ high freq response ?\n//\tband\t=  t1   +  ic1eq;\n\tlow\t\t=  t2   +  ic2eq;\n//\thigh\t= (X    - (dump * band)) - low;\n//\tpeak\t=  high -  low;\n//\tnotch\t=  high +  low;\n\n\tic1eq  += (t1 + t1);\n\tic2eq  += (t2 + t2);\n\n\treturn low;\n}\r\n\r\n// all in one audio rate, 2x\r\nsvfSinLowresFull2(X0, X1, cutoff, damp)\n{\n\tHistory ic1eq(0), ic2eq(0);\n\r\n    hz  = ((1 - damp) * 490) + 10;\r\n\tw\t= pi * maximum(cutoff, hz) / samplerate * 0.5;\n\ts1\t= sin73(w);\n\ts2\t= sin73(w + w);\r\n    dimp = damp * damp;\n    dump = clip(dimp * 0.5 + sqrt(s2), 0, 0.96);\r\n\tk\t= 1 - dump;\n\tnrm\t= 1 / (2 + (k * s1));\n\tg0\t= s2 * nrm;\n\tg1\t= ((-2 * s1 * s1) - (k * s2)) * nrm;\r\n\tg2\t= ((s1 + s1) * s1) * nrm;\n\r\n    // pass 1\r\n\n\tt00\t    =  X0 - ic2eq;\n\tgt00\t=  g0 * ic1eq;\n\tgt10\t=  g1 * ic1eq;\n\tt10\t    = (g0 * t00) + gt10;\n\tt20\t    = (g2 * t00) + gt00;\n\r\n\tlow0    = t20 + ic2eq;\n\n\tic1eq  += (t10 + t10);\n\tic2eq  += (t20 + t20);\n\r\n    // pass 2\n\r\n\tt01\t    =  X1 - ic2eq;\n\tgt01\t=  g0 * ic1eq;\n\tgt11\t=  g1 * ic1eq;\n\tt11\t    = (g0 * t01) + gt11;\n\tt21\t    = (g2 * t01) + gt01;\n\r\n\tlow1    = t21 + ic2eq;\n\n\tic1eq  += (t11 + t11);\n\tic2eq  += (t21 + t21);\n\r\n\treturn low0, low1;\n}\r\n\r\n// fixed 2x quasi oversampling (hermite6)\nsvfSinLowresFull2_2x( XIN, cutoff, damp )\n{\t// up 2\n\tHistory\tumTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory\tdmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= hermite_sixpoint_interp(0.5,\tumTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0\t= umT2_0 + 0;\n\n\t// process 2x\r\n    y1_0, y2_0 = svfSinLowresFull2(x1_0, x2_0, cutoff, damp);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= hermite_sixpoint_interp(0.5,\ty2_0_a,\tdmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0\t= umTm1_0;\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0 \t= umT2_0;\n\tumT2_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT3_1\t= dmT2_1;\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= dmTm1_1;\n\tdmTm1_1\t= y2_0;\n\n\treturn dcblock(y0_0);\n}\n\r\n// the oversampling slightly improves the HF response, but it probably isn't worth it\r\nParam   oversample(0, min=0, max=1);\r\nos      = int(oversample);\r\n\r\nif (os) {\r\n    out1    = svfSinLowresFull2_2x(in1, in2, in3);\r\n}\r\nelse {\r\n    out1    = svfSinLowresFull1(in1, in2, in3);\r\n}\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 36.0, 53.0, 972.0, 718.0 ]
                }
            },
