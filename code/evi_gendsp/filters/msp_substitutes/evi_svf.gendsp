                    "text": "in 1 (signal) Input"
                }
            },
            {
                "box": {
                    "code": "\r\n// evieve version of [svf~] as a TPT filter, almost the same response but\r\n// with better modulation properties.\r\n// @see also: [evi.multimode~] (more filters), [evi.svfsmooth~] (nonlinear), etc\r\n\r\nrequire(\"evi_svf.genexpr\");\r\n\r\nParam   oversample(0, min=0, max=1);    // useful for lowpass & bandpass\r\nos      = int(oversample);\r\n\r\n// + (cheap) remap res so that 0..1 input maintains\r\n// compatibility with MSP Chamberlain version\nres = ((in3 * in3) * 19) + 1;\n                    //   Hz,  res\r\ng, r, a     = tptSvfUnit(in2, res, os=os);\r\nyL, yB, yH  = 0;\r\nif (os) {\r\n    yL, yB, yH  = tptSvf2_2x(in1, g, r, a);\r\n}\r\nelse {\r\n    yL, yB, yH  = tptSvf(in1, g, r, a);\r\n}\r\nyN  = yH + yL;\r\n\r\n// MSP ordering\r\nout1    = yL;       // lowpass\r\nout2    = yH;       // highpass\r\nout3    = yB;       // bandpass\r\nout4    = yN;       // notch\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 4,
                    "outlettype": [ "", "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 672.0, 491.0 ]
                }
            },
            {
                "box": {
                    "id": "obj-4",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 49.0, 566.0, 168.0, 22.0 ],
                    "text": "out 1 (signal) Lowpass Output"
                }
            }
        ],
