            {
                "box": {
                    "code": "// 3-band parametric EQ using TPT SVF filters, controllable at audio rate. Unlike Biquads, these filters\r\n// will remain stable and clean under modulation. Turn off @smooth if modulating at audio rate.\r\n// @see: \"evi_eq5.gendsp\" & \"evi_eq8.gendsp\" for parameter control of parametric EQ-ing\r\n\r\nrequire(\"evi_svf.genexpr\");\r\n\r\nParam   smooth(15.333, min=0, max=333);\r\n\r\n/*\r\n    \"bandXfilter\"\n\tIndex\tFilter\n\t0 \t\tBypass\r\n\t1 \t\tHighpass\n\t2 \t\tLowshelf\n\t3 \t\tBell\n\t4 \t\tNotch\n\t5 \t\tHighshelf\n\t6 \t\tLowpass\r\n*/\nParam       band1filter(2, min=0, max=6);\r\nParam       band2filter(3, min=0, max=6);\r\nParam       band3filter(5, min=0, max=6);\r\nband1filt   = int(band1filter);\r\nband2filt   = int(band2filter);\r\nband3filt   = int(band3filter);\r\n\r\nxL      = in1;      xR      = in2;\r\n\r\ncutoff1 = in3;\r\ndb1     = in4;\r\nQ1      = in5;\r\n\r\ncutoff2 = in6;\r\ndb2     = in7;\r\nQ2      = in8;\r\n\r\ncutoff3 = in9;\r\ndb3     = in10;\r\nQ3      = in11;\r\n\r\nyL, yR  = eviParametricStereo3(xL, xR, band1filt, cutoff1, db1, Q1, band2filt, cutoff2, db2, Q2, band3filt, cutoff3, db3, Q3, smooth=smooth);\r\n\r\nout1    = yL;       out2    = yR;\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 11,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 34.0, 136.0, 1094.0, 654.0 ]
                }
