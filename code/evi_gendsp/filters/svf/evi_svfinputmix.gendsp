                    "patching_rect": [ 358.0, 19.0, 157.0, 22.0 ],
                    "text": "in 2 (signal) Bandpass Input"
                }
            },
            {
                "box": {
                    "code": "\r\n// a version of Simper's sVf input mixer\r\n// for an all-audio-rate version @see: \"evi_svf.genexpr\"\r\n// for a similar filter with better HF resonance @see: \"evi_skfinputmix.gendsp\"\r\n//                                                          ^K^\r\n\r\nrequire(\"evi_tanh.genexpr\");\r\nrequire(\"evi_trig.genexpr\");\r\nrequire(\"evi_smooth.genexpr\");\r\n\r\ninputMixingSvfCoefficients(cutoff, res)\n{\n    w\t= PI * cutoff / SAMPLERATE;\n    s1\t= sin73param(w);\n    s2\t= sin73param(w + w);\r\n\r\n    rc  = clip(res, (s1 * 0.5), minimum((1 - w), 0.97));\r\n    rc2 = rc + rc;\r\n    k   = 2 - rc2;\r\n\r\n    nrm\t= 1 / (2 + rc2 * s2);\n    s1n\t= (s1 + s1) * s1 * nrm;\n    s2n\t= s2 * nrm;\n\n    return  (k * s1n) + s2n, s1n, s2n, -s1n - (k * s2n);    // g0, g1, g2, g3\n}\n\ninputMixingSvfLoop(vlow, vband, vhigh, g0, g1, g2, g3)\n{\n    History\tic1eq(0), ic2eq(0);\n\n    t1  = vlow * g0 + vband * -g1 + vhigh * -g2 + ic1eq * -g1 + ic2eq * -g2;\r\n    // extra gain is not extra gain but a factor of the Adaa\n    t2  = altTanhAdaa1(vlow * 1.995262) * g1 + vband * g2 + vhigh * g3 + ic1eq * g2 + ic2eq * g3;\n    vc2\t= (t2 + ic2eq);\n\n    ic1eq  += (t1 + t1);\n    ic2eq  += (t2 + t2);\n\n    return vhigh + vc2;\n}\n\r\n// param rate\r\n\r\nParam   cutoff(1000, min=10, max=10000);            // Hz, not much use above about 8kHz\r\nParam   res(sqrt1_2, min=0, max=1);                 // 0..1, not much use above about 4kHz\r\n\r\nParam   coeffsmooth(15.111, min=0, max=333);        // ms\r\nParam   mixsmooth(22.666, min=0, max=333);          // ms\r\nParam   mix(0, min=0, max=1);                       // internal 3-way sine mixer\r\nParam   mixenable(1, min=0, max=1);                 // enable the internal mixer 0/1 ?\r\nme      = int(mixenable);\r\n\r\n// the input mixer is optional, default on\r\nm0      = mixSin(mix, 0.5);\r\nm1      = mixSin(mix, 0);\r\nm2      = mixSin(mix, -0.5);\r\n\ng0, g1, g2, g3  = inputMixingSvfCoefficients(cutoff, res);\r\n\r\n// audio rate from here\r\n\r\nif (coeffsmooth > 0) {\r\n    g0, g1, g2, g3  = logsmoothBank4(g0, g1, g2, g3, coeffsmooth*0.001);\r\n}\r\n\r\nvlow, vband, vhigh  = 0;\r\nif (me) {\r\n    if (mixsmooth > 0) {\r\n        m0, m1, m2  = expsmoothBank3(m0, m1, m2, mixsmooth*0.001);\r\n    }\r\n\r\n    vlow    = in1 * m0;\r\n    vband   = in2 * m1;\r\n    vhigh   = in3 * m2;\r\n}\r\nelse {\r\n    // for sequencing or fun experiments\r\n    vlow    = in1;\r\n    vband   = in2;\r\n    vhigh   = in3;\r\n}\r\n\r\niSvf    = inputMixingSvfLoop(vlow, vband, vhigh, g0, g1, g2, g3);\r\n\r\nout1    = iSvf;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 775.0, 732.0 ]
                }
            },
