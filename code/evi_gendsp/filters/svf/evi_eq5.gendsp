                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 34.0, 807.0, 184.0, 22.0 ],
                    "text": "out 1 (signal) 5 bands EQ Output"
                }
            }
        ],
        "lines": [
