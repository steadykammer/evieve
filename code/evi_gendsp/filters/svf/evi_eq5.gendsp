                    "patching_rect": [ 34.0, 19.0, 101.0, 22.0 ],
                    "text": "in 1 (signal) Input"
                }
            },
            {
                "box": {
                    "code": "\r\n// 5-band parametric EQ using TPT SVF filters, @see also: \"evi_eq8.gendsp\".\r\n// For audio rate control of all EQ parameters @see: \"evi_eq3.gendsp\".\r\n\r\nrequire(\"evi_svfs_lto.genexpr\");\r\n\r\neqBand(x, cutoff, db, Q, filter, reset, smooth=0)\r\n{\r\n    History eqbdummy(0);\r\n    band = 0;\r\n    if (filter == 1 || filter == 9) {\r\n        highlow = (filter == 1) ? 1 : 7;\r\n        band = eviFilterEq4Reset(x, cutoff, db, Q, highlow, reset, smooth=smooth);\r\n    }\r\n    else {\r\n        band = eviFilterEqReset(x, cutoff, db, Q, (filter - 1), reset, smooth=smooth);\r\n    }\r\n    return band;\r\n}\r\n\r\nParam   smooth(15.333, min=0, max=333);\r\n\r\n/*\r\n    \"bandXfilter\"\n\tIndex\tFilter\n\t0 \t\tBypass\r\n    1       Highpass 4-pole\n\t2 \t\tHighpass\n\t3 \t\tLowshelf\n\t4 \t\tBell\r\n    5       BellAdaptiveQ\n\t6 \t\tNotch\n\t7 \t\tHighshelf\n\t8 \t\tLowpass\r\n    9       Lowpass 4-pole\n*/\n\r\nParam   band1filter(3, min=0, max=9);\r\nParam   band1freq(125., min=10, max=18000);\r\nParam   band1db(0., min=-24, max=24);\r\nParam   band1q(1., min=0.1, max=18);\r\n\r\nParam   band2filter(4, min=0, max=9);\r\nParam   band2freq(500., min=10, max=18000);\r\nParam   band2db(0., min=-24, max=24);\r\nParam   band2q(sqrt1_2, min=0.1, max=18);\r\n\r\nParam   band3filter(4, min=0, max=9);\r\nParam   band3freq(1000., min=10, max=18000);\r\nParam   band3db(0., min=-24, max=24);\r\nParam   band3q(sqrt1_2, min=0.1, max=18);\r\n\r\nParam   band4filter(4, min=0, max=9);\r\nParam   band4freq(2000., min=10, max=18000);\r\nParam   band4db(0., min=-24, max=24);\r\nParam   band4q(sqrt1_2, min=0.1, max=18);\r\n\r\nParam   band5filter(6, min=0, max=9);\r\nParam   band5freq(4000., min=10, max=18000);\r\nParam   band5db(0., min=-24, max=24);\r\nParam   band5q(1., min=0.1, max=18);\r\n\r\nband1filt   = int(band1filter);\r\nband2filt   = int(band2filter);\r\nband3filt   = int(band3filter);\r\nband4filt   = int(band4filter);\r\nband5filt   = int(band5filter);\r\n\r\nband1reset  = delta(change(band1filt)) < 0;\r\nband2reset  = delta(change(band2filt)) < 0;\r\nband3reset  = delta(change(band3filt)) < 0;\r\nband4reset  = delta(change(band4filt)) < 0;\r\nband5reset  = delta(change(band5filt)) < 0;\r\n\r\nx0  = in1;\r\n\r\ny1  = eqBand(x0, band1freq, band1db, band1q, band1filt, band1reset, smooth=smooth);\r\ny2  = eqBand(y1, band2freq, band2db, band2q, band2filt, band2reset, smooth=smooth);\r\ny3  = eqBand(y2, band3freq, band3db, band3q, band3filt, band3reset, smooth=smooth);\r\ny4  = eqBand(y3, band4freq, band4db, band4q, band4filt, band4reset, smooth=smooth);\r\ny5  = eqBand(y4, band5freq, band5db, band5q, band5filt, band5reset, smooth=smooth);\r\n\r\nout1    = y5;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 34.0, 58.0, 744.0, 732.0 ]
                }
            },
            {
                "box": {
                    "id": "obj-4",
