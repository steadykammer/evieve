            },
            {
                "box": {
                    "fontname": "Arial",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 390.0, 17.0, 275.0, 22.0 ],
                    "text": "in 2 (signal/float) Cutoff in Hz or Pitch @default 81"
                }
            },
            {
                "box": {
                    "code": "\r\n// Ladder for Robert\r\n// moog Ladder emulation, by Pete for evieve & Huddersfield friends, 2014,\r\n// based on Vadim Zavalishin\r\n// thanks to Martijn Zwartjes\r\n// this is the smoothest and most in tune of all the evieve ladders, & handles > 1 res really well\r\n// @see: evi_ladder_transistor.gendsp & evi_ladder_poles.gendsp for alternative ladder emulations\r\n// @see: evi_ladder_diode.gendsp for a diode ladder emulation\r\n// @see: evi_lorez.gendsp for an allpass aligned two-pole oversampled ladder\n\r\nrequire(\"evi_smooth.genexpr\");\r\nrequire(\"evi_tanh.genexpr\");\r\nrequire(\"evi_interp.genexpr\");\r\n\npolySat(x)\n{\n\tx2 = x*x;\n\tx3 = x*x2;\n\tp531 = (x + (x3 * -0.18963)) + (x3 * x2 * 0.016182);\n\tpn = -1.8153 > x ? -1 : p531;\n\treturn x > 1.8153 ? 1 : pn;\n}\n\r\nsat(x, nl)\r\n{\r\n\ty = 0;\r\n\tif (nl == 1) {\t\t\t\t\t// polynom saturator\t\t- 'hard'\r\n\t\ty = polySat(x);\r\n\t} else { // nl == 0\t\t\t\t// tanh approx (default)\t- 'clean'\r\n\t\ty = tanhO(x);\r\n\t}\r\n\treturn y;\r\n}\r\n\ninit(x, g, s, k)\t\t\t\t\t// initialise feedback loop settings\r\n{\r\n\tspg = s + g;\r\n\tsmg = s - g;\r\n\tspr = (x <= (smg * k)) ? smg : (x / k);\r\n\tspo = (x >= (spg * k)) ? spg : spr;\r\n\treturn spo;\r\n}\n\r\n// separating onepole into two parts to resolve ZDF loop\r\n\noplpII(g, s, w, n, z)\t\t\t\t// onepole part II - only signal after the delayed signal\r\n{\n\tzz = z + z;\n\tg = g * w * n;\n\ts = ((s * w) + zz) * n;\n\treturn g, s, zz;\n}\n\noplpI(y, w, n, z, zz)\t\t\t\t// onepole part I - direct signal mixed with the delayed signal\r\n{\n\tt = ((y - (((y * w) + zz) * n)) * w) + z;\n\treturn t + z, t;\n}\n\nnext(y, x, g, s, k)\t\t\t\t\t// resolve tanh approx (should be with exit loop as function of k)\r\n{\n\tt = tanhL((x - (k * y)));\n\treturn y - (((t * g) + s - y) / ((((t * t) - 1) * k * g) - 1));\n}\n\r\n// ladder 1x\n// ZDF (Newton-Raphson) model 24dB Transistor Ladder filter\nZDFNRL1(x, w, k, nl)\r\n{\n\tHistory z1(0), z2(0), z3(0), z4(0);\n\tn = 1 / (w + 1);\n\n\tg, s, zz1 = oplpII(1, 0, w, n, z1);\t\t// filter cascade part II with init\n\tg, s, zz2 = oplpII(g, s, w, n, z2);\n\tg, s, zz3 = oplpII(g, s, w, n, z3);\n\tg, s, zz4 = oplpII(g, s, w, n, z4);\n\n\ty = init(x, g, s, k);                   // init cascade\n\r\n    // TODO: get rid of this rubbish and do a proper Newton loop\r\n\ty = next(y, x, g, s, k);\t\t        // resonance cascade\n\ty = next(y, x, g, s, k);\n\ty = next(y, x, g, s, k);\n\ty = next(y, x, g, s, k);\n\ty = next(y, x, g, s, k);\n\n\ty = sat((x - (y * k)), nl);\t\t\t\t// loop nonlinearity (select)\n\n\ty, z1 = oplpI(y, w, n, z1, zz1);\t\t// filter cascade part I\n\ty, z2 = oplpI(y, w, n, z2, zz2);\n\ty, z3 = oplpI(y, w, n, z3, zz3);\n\ty, z4 = oplpI(y, w, n, z4, zz4);\n\n\treturn y;\n}\n\r\n// ladder 2x\r\nZDFNRL2(x0, x1, w, k, nl)\r\n{\n\tHistory z1(0), z2(0), z3(0), z4(0);\n\tn = 1 / (w + 1);\n\r\n    // pass 1\r\n\n\tg0, s0, zz10 = oplpII(1, 0, w, n, z1);\n\tg0, s0, zz20 = oplpII(g0, s0, w, n, z2);\n\tg0, s0, zz30 = oplpII(g0, s0, w, n, z3);\n\tg0, s0, zz40 = oplpII(g0, s0, w, n, z4);\n\n\ty0 = init(x0, g0, s0, k);\n\r\n\ty0 = next(y0, x0, g0, s0, k);\n\ty0 = next(y0, x0, g0, s0, k);\n\ty0 = next(y0, x0, g0, s0, k);\n\n\ty0 = sat((x0 - (y0 * k)), nl);\n\n\ty0, z1 = oplpI(y0, w, n, z1, zz10);\n\ty0, z2 = oplpI(y0, w, n, z2, zz20);\n\ty0, z3 = oplpI(y0, w, n, z3, zz30);\n\ty0, z4 = oplpI(y0, w, n, z4, zz40);\n\r\n    // pass 2\r\n\r\n\tg1, s1, zz11 = oplpII(1, 0, w, n, z1);\n\tg1, s1, zz21 = oplpII(g1, s1, w, n, z2);\n\tg1, s1, zz31 = oplpII(g1, s1, w, n, z3);\n\tg1, s1, zz41 = oplpII(g1, s1, w, n, z4);\n\n\ty1 = init(x1, g1, s1, k);\n\r\n\ty1 = next(y1, x1, g1, s1, k);\n\ty1 = next(y1, x1, g1, s1, k);\n\ty1 = next(y1, x1, g1, s1, k);\n\n\ty1 = sat((x1 - (y1 * k)), nl);\n\n\ty1, z1 = oplpI(y1, w, n, z1, zz11);\n\ty1, z2 = oplpI(y1, w, n, z2, zz21);\n\ty1, z3 = oplpI(y1, w, n, z3, zz31);\n\ty1, z4 = oplpI(y1, w, n, z4, zz41);\r\n\n\treturn y0, y1;\n}\r\n\r\n// fixed 2x quasi oversampling (hermite6)\nZDFNRL2_2x6( XIN, w, k, nl )\n{\t// up 2\n\tHistory\tumTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory\tdmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= hermite_sixpoint_interp(0.5,\tumTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0\t= umT2_0 + 0;\n\n\t// process 2x\r\n    y1_0, y2_0 = ZDFNRL2(x1_0, x2_0, w, k, nl);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= hermite_sixpoint_interp(0.5,\ty2_0_a,\tdmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0\t= umTm1_0;\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0 \t= umT2_0;\n\tumT2_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT3_1\t= dmT2_1;\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= dmTm1_1;\n\tdmTm1_1\t= y2_0;\n\n\treturn dcblock(y0_0);\n}\r\n\r\n// fixed 2x quasi oversampling (cubic4)\nZDFNRL2_2x4( XIN, w, k, nl )\n{\t// up 2\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 2\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= cubic_hermite_interp(0.5,\tumTm1_0, umT0_0, umT1_0, x0_0_a);\n\tx2_0\t= umT1_0 + 0;\n\n\t// process 2x\n\ty1_0, y2_0\t= ZDFNRL2(x1_0, x2_0, w, k, nl);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= cubic_hermite_interp(0.5,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\treturn y0_0;\n}\r\n\r\n//\t//\t//\tdeclare\r\n\r\nParam\tnonlin(0, min=0, max=1);\t\t\t\t// choose saturator in loop (default tanh approx)\r\nParam   cutoffmode(1, min=0, max=1);            // choose cutoff in Pitch (1) or Hz (0)\r\nParam\tcutoffsmooth(0, min=0, max=333);\t\t// optional freq smooth time in ms\r\nParam\tressmooth(0, min=0, max=333);\t        // optional res smooth time in ms\r\nParam   oversample(1, min=0, max=1);            // 1 = 2x, 0 = 1x\r\nos      = int(oversample);\r\nnl\t\t= int(nonlin);\r\ncfm     = int(cutoffmode);\r\n\r\n//\t//\t//\tinputs\r\n\r\nres\t\t= clip(in3, 0, 2);\t\t\t\t\t\t// 0..1..2\r\nfreq    = in2;\r\nif (cfm) {\r\n    freq\t= mtofApprox(freq);                 // if cutoffmode\r\n}\r\nx\t\t= dcblock(in1);\t\t\t\t\t\t\t// clean input, why pete?\r\n\r\n//\t//\t//\tparse\r\n\r\nf\t\t= clip(freq, 1, (samplerate * 0.444444444444444));\t// clip at Hz level\r\nw\t\t= tanA3(f * (PI / samplerate)) * (os ? 0.5 : 1);    // warp\r\nif (cutoffsmooth > 0) {\t\t\t\t\t\t\t// only compute if engaged\r\n\tw\t= logsmooth(w, cutoffsmooth*0.001);\r\n}\r\n\r\nk\t\t= res * 4;\t\t\t\t\t\t\t\t// res to k, self oscillates @ res = 1, > 1 = extreme effect\r\nif (ressmooth > 0) {\t\t\t\t\t\t    // only compute if engaged\r\n\tk\t= expsmooth(k, ressmooth*0.001);\r\n}\r\n\r\n//\t//\t//\tfilter\r\n\r\nif (os) {\r\n    out1\t= ZDFNRL2_2x4(x, w, k, nl) * sqrt2;\r\n}\r\nelse {\r\n    out1\t= ZDFNRL1(x, w, k, nl) * sqrt2;\r\n}\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 892.0, 733.0 ]
                }
            },
