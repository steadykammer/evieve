                    "patching_rect": [ 539.0, 19.0, 277.0, 22.0 ],
                    "text": "in 3 (signal/float) Resonance 0..1 @min 0 @max 2"
                }
            },
            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 34.0, 19.0, 101.0, 22.0 ],
                    "text": "in 1 (signal) Input"
                }
            },
            {
                "box": {
                    "id": "obj-2",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 159.0, 19.0, 363.0, 22.0 ],
                    "text": "in 2 (signal/float) Cutoff in Hz @min 1 @max samplerate*0.333333"
                }
            },
            {
                "box": {
                    "code": "\r\n// Nonlinear 12dB TPT Lowpass with excellent modulation properties.\r\n// @see also: \"evi_lores.gendsp\" (which is a closer match to MSP [lores~]).\r\n\r\nrequire(\"evi_approx.genexpr\");\r\nrequire(\"evi_interp.genexpr\");\r\n\r\n// 2x\r\n// two poles of a nonlinear ladder with allpass alignment, 2x oversampled.\r\n// based on a Will Pirkle 'App Note', thank you. 2x etc by pete for evieve.\r\ntwopoleLadder2(xin0, xin1, hz, res)\r\n{\r\n    History s1(0), s2(0), s3(0);\r\n\r\n    // painful coefficients\r\n    invsr = 1 / samplerate; // !! do not account for 2x here...\r\n    invsr05 = invsr * 0.5;\r\n    k = res + res + res;\r\n    k2 = sqrt2 + 0.353553 * res;\r\n    w = twopi * hz;         // !! do not account for 2x here...\r\n    g0 = ((1 / invsr) * tanA3(w * invsr05)) * invsr05;  // !! (1/invsr) not (2/invsr) for 2x...\r\n    g1 = 1 + g0;                                        // ...because of HF tuning\r\n    g = g0 / g1;\r\n    ga = (g + g) - 1;\r\n    lp1fb = g * ga / g1;\r\n    lp2fb = ga / g1;\r\n    ap3fb = 2 / g1;\r\n    alpha = 1 / (1 + k * ga * g * g);\r\n\r\n    // nonlinear\r\n    // we purposefully do not gain-wrap our atan() inside the loop,\r\n    // but careful in the 2x version if pushing res > 1\r\n    mK = ((s1 * lp1fb) + (s2 * lp2fb) + (s3 * ap3fb)) * -k;\r\n\r\n    // pass 1\r\n    X0 = mK + xin0;\r\n    u0 = atanA(X0 * alpha);\r\n    // lowpass 1\r\n    xg0 = (u0 - s1) * g;\r\n    lp10 = xg0 + s1;\r\n    s1 = xg0 + lp10;\r\n    // lowpass 2\r\n    yg0 = (lp10 - s2) * g;\r\n    lp20 = yg0 + s2;\r\n    s2 = yg0 + lp20;\r\n    // allpass\r\n    zg0 = (lp20 - s3) * g;\r\n    lp30 = zg0 + s3;\r\n    hp30 = lp20 - lp30;\r\n    ap30 = (lp30 - hp30) * k2;\r\n    s3 = zg0 + lp30;\r\n\r\n    // pass 2\r\n    X1 = mK + xin1;\r\n    u1 = atanA(X1 * alpha);\r\n    // lowpass 1\r\n    xg1 = (u1 - s1) * g;\r\n    lp11 = xg1 + s1;\r\n    s1 = xg1 + lp11;\r\n    // lowpass 2\r\n    yg1 = (lp11 - s2) * g;\r\n    lp21 = yg1 + s2;\r\n    s2 = yg1 + lp21;\r\n    // allpass\r\n    zg1 = (lp21 - s3) * g;\r\n    lp31 = zg1 + s3;\r\n    hp31 = lp21 - lp31;\r\n    ap31 = (lp31 - hp31) * k2;\r\n    s3 = zg1 + lp31;\r\n\r\n    // taps\r\n    return ap30, ap31;\r\n}\r\n\r\n// fixed 2x quasi oversampling (hermite6)\ntwopoleLadder2_2x( XIN, hz, res )\n{\t// up 2\n\tHistory\tumTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory\tdmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= hermite_sixpoint_interp(0.5,\tumTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0\t= umT2_0 + 0;\n\n\t// process 2x\r\n    y1_0, y2_0 = twopoleLadder2(x1_0, x2_0, hz, res);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= hermite_sixpoint_interp(0.5,\ty2_0_a,\tdmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0\t= umTm1_0;\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0 \t= umT2_0;\n\tumT2_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT3_1\t= dmT2_1;\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= dmTm1_1;\n\tdmTm1_1\t= y2_0;\n\n\treturn dcblock(y0_0);\n}\r\n\r\n// 1x\r\n// two poles of a nonlinear ladder with allpass alignment and naive nonlinearity\r\n// (but works ok here). based on a Will Pirkle 'App Note', thank you.\r\ntwopoleLadder(xin, hz, res) // self-oscillates at res==1 but gets a bit funky up high,\r\n{                           // low freq res is very cool, rodrigo should like it.\r\n    History s1(0), s2(0), s3(0);\r\n    // painful coefficients\r\n    invsr = 1 / samplerate;\r\n    invsr05 = invsr * 0.5;\r\n    k = res + res + res;\r\n    k2 = sqrt2 + 0.353553 * res;\r\n    w = twopi * hz;\r\n    g0 = ((2 / invsr) * tanA2(w * invsr05)) * invsr05;\r\n    g1 = 1 + g0;\r\n    g = g0 / g1;\r\n    ga = (g + g) - 1;\r\n    lp1fb = g * ga / g1;\r\n    lp2fb = ga / g1;\r\n    ap3fb = 2 / g1;\r\n    alpha = 1 / (1 + k * ga * g * g);\r\n    // nonlinear\r\n    mK = ((s1 * lp1fb) + (s2 * lp2fb) + (s3 * ap3fb)) * -k;\r\n    X = mK + xin;\r\n    // we purposefully do not gain-wrap our atan() inside the loop\r\n    u = atanA(X * alpha);\r\n    // lowpass 1\r\n    xg = (u - s1) * g;\r\n    lp1 = xg + s1;\r\n    s1 = xg + lp1;\r\n    // lowpass 2\r\n    yg = (lp1 - s2) * g;\r\n    lp2 = yg + s2;\r\n    s2 = yg + lp2;\r\n    // allpass\r\n    zg = (lp2 - s3) * g;\r\n    lp3 = zg + s3;\r\n    hp3 = lp2 - lp3;\r\n    ap3 = (lp3 - hp3) * k2;\r\n    s3 = zg + lp3;\r\n    // tap\r\n    return ap3;\r\n}\r\n\r\n// linear\r\n\r\ntwopoleLadderLinearCoeff(hz, res)\r\n{\r\n    // painful coefficients\r\n    invsr = 1 / samplerate;\r\n    invsr05 = invsr * 0.5;\r\n    k = res + res;  // one less for linear\r\n    k2 = sqrt2 + 0.353553 * res;\r\n    w = twopi * hz;\r\n    g0 = ((2 / invsr) * tanA2(w * invsr05)) * invsr05;\r\n    g1 = 1 + g0;\r\n    g = g0 / g1;\r\n    ga = (g + g) - 1;\r\n    lp1fb = g * ga / g1;\r\n    lp2fb = ga / g1;\r\n    ap3fb = 2 / g1;\r\n    alpha = 1 / (1 + k * ga * g * g);\r\n    return g, lp1fb, lp2fb, ap3fb, alpha, k, k2;\r\n}\r\n\r\ntwopoleLadderLinearFilter(xin, g, lp1fb, lp2fb, ap3fb, alpha, k, k2)\r\n{\r\n    History s1(0), s2(0), s3(0);\r\n    mK = ((s1 * lp1fb) + (s2 * lp2fb) + (s3 * ap3fb)) * -k;\r\n    X = mK + xin;\r\n    u = X * alpha;\r\n    // lowpass 1\r\n    xg = (u - s1) * g;\r\n    lp1 = xg + s1;\r\n    s1 = xg + lp1;\r\n    // lowpass 2\r\n    yg = (lp1 - s2) * g;\r\n    lp2 = yg + s2;\r\n    s2 = yg + lp2;\r\n    // allpass\r\n    zg = (lp2 - s3) * g;\r\n    lp3 = zg + s3;\r\n    hp3 = lp2 - lp3;\r\n    ap3 = (lp3 - hp3) * k2;\r\n    s3 = zg + lp3;\r\n    // tap\r\n    return ap3;\r\n}\n\r\nParam   oversample(1, min=0, max=1); // 0=1x, 1=2x\r\nos      = int(oversample);\r\n\r\nlorez = 0;\r\nif (os == 1) {  // 2x, default\r\n    lorez = twopoleLadder2_2x(in1, in2, in3);\r\n}\r\nelse {          // 1x\r\n    lorez = twopoleLadder(in1, in2, in3);\r\n}\r\n\r\nout1 = lorez;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 34.0, 59.0, 752.0, 730.0 ]
                }
            },
