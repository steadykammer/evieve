                                                    "text": "in 2"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "code": "\r\neviSlide(x, u, d, r)\t\t\t\t\t// input, samples up, samples down, reset\n{\n\tHistory current(0), init(1);\r\n    if (r) {\r\n        current = 0;\r\n//        init = 1;\r\n    }\n\ts  = x - current;\n\tus = s * (1 / (maximum(abs(u), 1)));\n\tds = s * (1 / (maximum(abs(d), 1)));\n\ty  = current + ((x > current) ? us : ds) + (x * init);\n\tcurrent = y;\n    init = 0;\n\treturn y;\n}\r\n\r\nout1 = eviSlide(in1, in2, in3, in4);\r\n\r\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-3",
                                                    "maxclass": "codebox",
                                                    "numinlets": 4,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 49.0, 58.0, 693.0, 335.0 ]
                                                }
