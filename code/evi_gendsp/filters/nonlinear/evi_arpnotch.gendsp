                    "linecount": 2,
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 298.0, 13.0, 228.0, 35.0 ],
                    "text": "in 2 (signal/float) Freq in Pitch (default) or Hz depending on 'cutoffmode' attribute"
                }
            },
            {
                "box": {
                    "code": "\r\n// a nonlinear SVF Notch filter which can morph between LP..Notch..HP,\r\n// as a partial emulation of the ARP 1047 filter/resonator.\r\n// @see also: \"evi_filter_morph.gendsp\" / [evi.filter.morph~] for linear morphing.\r\n// @see also: \"evi_svfsmooth.gendsp\" / [evi.svfsmooth~] for alternative nonlinear morphing.\r\n// @see also: \"evi_svfsynth.gendsp\" for a beefy nonlinear 12 & 24 dB svf (with morphing).\r\n\r\nrequire(\"evi_tanh.genexpr\");\r\nrequire(\"evi_smooth.genexpr\");\r\n\r\n// core\r\n\r\neviArpSmoothCore(X, w2, r2, lc)                 // input, warped freq, full res\r\n{\r\n    History\tstate1(0), state2(0);\t\t\t\t// SVF state initialise\r\n\r\n    // integrators, post state, feedback\r\n    s1\t= state1;\r\n    g2\t= w2 * w2;\r\n    s2\t= state2 + (s1 * w2);\r\n\r\n    // resonance\r\n    gG\t=   w2 * r2;\r\n    sG\t=   s1 * r2;\r\n    gS\t= -(g2 + gG);                           // invert feedback\r\n    sS\t= -(s2 + sG);\r\n\r\n    // solve\r\n    alpha\t= 1 / (1 - gS);\r\n    x0\t    = ((X * gS) + sS) * alpha;\t        // audio input\r\n    y0\t\t= X + x0;\t\t\t\t\t\t    // y0 = HP\r\n\r\n    // integrator 1, post state, nonlinear\r\n    x1\t= y0 * w2;\r\n    y1\t= tanhLxA((x1 + state1), lc);           // y1 = BP\r\n\r\n    // integrator 2, post state, nonlinear\r\n    x2\t= y1 * w2;\r\n    y2\t= tanhLxA((x2 + state2), lc);           // y2 = LP\r\n\r\n    // integrator 1, update state\r\n    state1\t\t= x1 + y1;\r\n\r\n    // integrator 2, update state\r\n    state2\t\t= x2 + y2;\r\n\r\n    return  y2, y0;                             // LP, HP\r\n}\r\n\r\n// filter\r\n\r\npreWarp(cutoff, type)\r\n{\r\n    hz  = 0;\r\n\tif (type) {\r\n\t\thz\t= mtofApprox(minimum(cutoff, 133.2522));\r\n\t} else {\r\n\t    hz\t= minimum(cutoff, (samplerate * 0.408164));\r\n    }\r\n\treturn\ttanA2(hz * PI / samplerate);        // w/2\r\n}\r\n\r\n// declare\r\n\r\nParam\tcutoffmode(1, min=0, max=1);\t\t\t// 0 = Hz, 1 = pitch (default)\r\nParam\tmorphsmooth(0, min=0, max=333);\t        // in ms, default off\r\n\r\n// inputs (smooth || mod res & cutoff externally)\r\nmorph   = clip(     in4, 0, 1);                 // 0=LP .. 0.5=Notch .. 1=HP\r\nres\t\t= clip(\t\tin3, 0, 1) * 1.1;\t\t    // cheeky\r\ncutoff\t= maximum(\tin2, 0);\t\t            // cutoff freq (default in pitch)\r\nX\t\t=\tdcblock(in1);\t                    // clean audio input, who knows why\r\n\r\n// freq warp\r\ntype\t= int(cutoffmode);\t\t                // 0 = in Hz, 1 = (default) in pitch\r\nW\t\t= preWarp(cutoff, type);                // warp\r\n\r\n// mix  // ARP 'notch mix'\r\nM       = morph + morph - 1;\r\nmakeM   = 2 - abs(M);\r\nhighM   = morph;\r\nif (morphsmooth > 0) {\r\n    makeM, highM    = expsmoothBank2(makeM, highM, morphsmooth*0.001);\r\n}\r\nlowM    = 1 - highM;\r\n\r\n// resonance\r\nk\t\t= 1.1 - (res * (1 / makeM));            // pete is clever (clear notch)\r\nR\t\t= k + k;\r\n\r\n// SVF                  // ARP 'limit mode'\r\nLP, HP\t= eviArpSmoothCore(X * (k + sqrt2), W, R, 10);\r\nsvfMix  = makeM * (lowM * LP + highM * HP);     // low + high = notch\r\n\r\n// outputs\r\nout1\t= dcblock(svfMix);                      // LP..Notch..HP via 'morph'\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 4,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 765.0, 723.0 ]
                }
            },
