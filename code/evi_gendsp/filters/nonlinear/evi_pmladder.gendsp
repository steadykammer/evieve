, 			{
				"box" : 				{
					"code" : "/*\r\npete for evieve, 2012 ... traditional z-1 transistor ... a port of \"PM.Ladder~\" by\r\nPeter McCulloch: \"...a few added goodies such as additional filter modes (notch doesn’t work\r\nso great) and peak-shaping. It has built-in saturation and can self-oscillate.\r\nFilter cutoff is specified in MIDI pitch rather than hz\"\r\n- http://cycling74.com/author/petermccullochgmailcom/\r\n\r\nwhich in turn is based on the ICST implementation by Beat Frei:\r\n- http://www.icst.net/research/projects/dsp-library/\r\n- http://www.icst.net/research/projects/digital-sound-generation/\r\n\r\nICST code licence:\r\n---\r\nCopyright © 2008, 2009, 2010, Zurich University of the Arts, Beat Frei. All rights reserved.\n \nRedistribution and use in source and binary forms, with or without modification, are\r\npermitted provided that the following conditions are met:\n \n\t1.\tRedistributions of source code must retain the above copyright notice, this list\r\n\t\tof conditions and the following disclaimer.\n\t2.\tRedistributions in binary form must reproduce the above copyright notice, this\r\n\t\tlist of conditions and the following disclaimer in the documentation and/or other\r\n\t\tmaterials provided with the distribution.\n \nTHIS SOFTWARE IS PROVIDED BY THE ZURICH UNIVERSITY OF THE ARTS \"AS IS\" AND ANY EXPRESS\r\nOR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF\r\nMERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL\r\nTHE ZURICH UNIVERSITY OF THE ARTS OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT,\r\nINCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,\r\nPROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS\r\nINTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT\r\nLIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\r\nOF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\r\n-------\r\nPeter McCulloch licence:\r\n---\r\nPeter McCulloch, 2012 Creative Commons Attribution-NonCommercial-ShareAlike CC BY-NC-SA\r\n-------\r\nevieve licence:\r\n---\r\ndefer to Peter McCulloch licence above\r\n-------\r\n*/\r\n\r\n// quick and dirty medium range exp:\r\nqdexp(x) {\r\n\tx = 0.99999636 + (0.031261316 + (0.00048274797 + 0.0000059490530 * x) * x) * x;\r\n\tx *= x; x *= x; x *= x; x *= x;\r\n\treturn x * x;\r\n}\r\n\r\nqddbtoa(db)\n{\n\tdbtoaA = qdexp(0.11512925464970 * db);\n\treturn dbtoaA + 0.000128; // + offset = 0 dB == 1 amplitude\n}\n\r\n// cubic non-linearity for internal filter saturation:\r\ncnl(x) {\r\n\tx = clip(x, -1, 1);\r\n\ty = x * (1 - 0.333333333333 * x * x);\r\n\t// (mismatch with MIDI pitch 0 / ICST 5Hz), but for now...\r\n\treturn dcblock(y);\r\n}\r\n\r\n// parameter smoothing function:\r\ncpsmoothc(x, a) { // default should be (a = 0.99)\r\n\tHistory z(0);\r\n\ta = pow(clip(a, 0, 1), (1 / (samplerate / 44100))); // compensate\r\n\tb = 1 - a;\r\n\tz = (x * b) + (z * a);\r\n\treturn z;\r\n}\r\n\r\n// parameter gliding function:\r\npline(x, r) { // input (target), ramp time (in samples)\r\n\tHistory target(1), current(0), remain(1), increment(1);\r\n\tif (delta(x) != 0) {\r\n\t\ttarget = x;\r\n\t\tremain = maximum(r, 0);\r\n\t\tincrement = (target - current) / remain;\t\r\n\t}\r\n\tif (remain > 0) {\r\n\t\tcurrent = target - increment * remain;\r\n\t\tremain = remain - 1;\r\n\t} else {\r\n\t\tcurrent = target;\r\n\t}\r\n\treturn current;\r\n}\r\n\r\n// filter pole:\r\npole(w, x, y, z) {\r\n\treturn (w * x) + (y * z);\r\n}\r\n\r\n// the filter (McCulloch, based on ICST code):\r\npmLadder(asig, pitch, res, mode, icnl, glide) {\r\n\r\n\t// inputs & coefficients histories:\r\n\tHistory previn(0), fc(1), rc(0);\n\t// filter histories (incl 2x):\r\n\tHistory s0(0), s1(0), s2(0), s3(0), s4(0), s5(0), s6(0), s7(0);\n\r\n\t// for samplerate fixes (evieve hack):\r\n\tsrfix = 48000 / samplerate;\r\n\t// audio input, + scaled white noise injection for self-oscillation etc:\r\n\txin = asig + (0.00000000001 * noise());\r\n\t// initialise frequency conversion (ICST '2.5 * fmin / samplerate'):\r\n\tfscl1 = sqrt(minimum(1, maximum(0.0001, 12.5 / (srfix * samplerate)))); // evieve sr fix 1\r\n\tfscl2 = -(log(fscl1));\r\n\t// midi pitch cutoff input, + rescaling and normalising (0..1):\r\n\tpmfc = clip((((clip(pitch, 0, 132) * 0.90193) + 7.29) / 127), 0, 0.997); // McCulloch tuning\r\n//\tdfc = fc + (fscl1 * qdexp(fscl2 * max(0, min(1, pmfc))) - fc); // ICST\r\n\tdfc = fc + ((fscl1 * qdexp(fscl2 * max(0, min(1, pmfc))) - fc) * 0.5); // McCulloch\r\n\t// resonance (0..1), rescaled:\r\n//\tdrc = rc + (1.05 * min(1, max(0.00001, (clip(res, 0, 1)))) - rc); // ICST\r\n\t// resonance (0..1), including Peter McCulloch fix for low-resonance + high-cutoff-freq:\r\n\tdrc = rc + ((1.05 * minimum(1, maximum(0.00001, (clip(res, 0, 1)))) - rc) / 4); // McCulloch\r\n\r\n\t// calculate filter coefficients (hybrid version):\r\n\tyf = fc * fc;\r\n\txf = yf * (1 - rc);\r\n//\tff = yf + 0.8011 * xf * xf; // evieve\r\n//\tff = yf + 0.5 * xf * xf; // ICST\r\n\tff = yf + xf * xf; // McCulloch\r\n\tff = ff * srfix; // evieve sr fix 2\r\n\tfcf = 0; // evieve addition (but clicks when switching off):\r\n\tif (glide > 0) { // evieve, set cutoff frequency glide time in ms\r\n\t\tfcf = pline(((1.25 + (-0.74375 + 0.3 * ff) * ff) * ff), mstosamps(glide));\r\n\t} else { // (glide == 0), default, use non-exact smoothing\r\n\t\tfcf = cpsmoothc(((1.25 + (-0.74375 + 0.3 * ff) * ff) * ff), 0.99);\r\n\t}\r\n\tfcpl = 1 - fcf;\r\n\tr = cpsmoothc((rc * (1.4 + (0.108 + (-0.164 - 0.069 * fcf) * fcf) * fcf)), 0.997); // really?\r\n//\tinscl = 0.18 + 0.25 * r; // ICST\r\n\tinscl = 0.18 + 0.25 * (r * r); // McCulloch\r\n\r\n\t// update input histories:\r\n\tprevin = xin;\r\n\tfc = dfc;\r\n\trc = drc;\r\n\r\n\t// filter cascades (McCulloch / evieve version):\r\n\r\n\t// first pass (cascade two):\r\n\ts3c2, cnlc2, s4c2 = 0;\r\n\tx2 = (previn * inscl) - (r * s5);\r\n\tslimc2 = minimum(1, (maximum(-1, (0.062 * x2 * x2) + (0.993 * s0))));\r\n\tx3 = x2 * ((1 - slimc2) + (0.5 * slimc2 * slimc2)); // ^ external non-linearity\r\n\ts1c2 = pole(x3, fcf, fcpl, s1); // 6dB\r\n\ts2c2 = pole((s1c2 + (s1 * 0.3)), fcf, fcpl, s2); // 12dB\r\n\tif (icnl == 1) { // put cubic non-linearity between poles 3 & 4\r\n\t\ts3c2 = pole((s2c2 + (s2 * 0.3)), fcf, fcpl, s3); // 18dB\r\n\t\tcnlc2 = cnl(s3c2 + (s3 * 0.3)); // internal cubic non-linearity\r\n\t\ts4c2 = pole(cnlc2, fcf, fcpl, s4); // 24dB\r\n\t} else { // (icnl == 0) - default - put cubic non-linearity between poles 2 & 3\r\n\t\tcnlc2 = cnl(s2c2 + (s2 * 0.3)); // internal cubic non-linearity\r\n\t\ts3c2 = pole(cnlc2, fcf, fcpl, s3); // 18dB\r\n\t\ts4c2 = pole((s3c2 + (s3 * 0.3)), fcf, fcpl, s4); // 24dB\r\n\t}\r\n\ts5c2 = s4c2 + (s4 * 0.3);\r\n\r\n\t// second pass (cascade one):\r\n\ts3c1, s3y3, cnlc1, s4c1 = 0;\r\n\tx0 = (xin * inscl) - (r * s5c2);\r\n\tslimc1 = minimum(1, (maximum(-1, (0.062 * x0 * x0) + (0.993 * slimc2))));\r\n\tx1 = x0 * ((1 - slimc1) + (0.5 * slimc1 * slimc1)); // ^ external non-linearity\r\n\ts1c1 = pole(x1, fcf, fcpl, s1c2); // 6dB\r\n\ts1y1 = s1c1 + (s1c2 * 0.3); // y's seperated in cascade one, for additional filter outputs\r\n\ts2c1 = pole(s1y1, fcf, fcpl, s2c2); // 12dB\r\n\ts2y2 = s2c1 + (s2c2 * 0.3);\r\n\tif (icnl == 1) { // put cubic non-linearity between poles 3 & 4\r\n\t\ts3c1 = pole(s2y2, fcf, fcpl, s3c2); // 18dB\r\n\t\ts3y3 = s3c1 + (s3c2 * 0.3);\r\n\t\tcnlc1 = cnl(s3y3); // internal cubic non-linearity\r\n\t\ts4c1 = pole(cnlc1, fcf, fcpl, s4c2); // 24dB\r\n\t} else { // (icnl == 0), default, put cubic non-linearity between poles 2 & 3\r\n\t\tcnlc1 = cnl(s2y2); // internal cubic non-linearity\r\n\t\ts3c1 = pole(cnlc1, fcf, fcpl, s3c2); // 18dB\r\n\t\ts3y3 = s3c1 + (s3c2 * 0.3);\r\n\t\ts4c1 = pole(s3y3, fcf, fcpl, s4c2); // 24dB\r\n\t}\r\n\ts4y4 = s4c1 + (s4c2 * 0.3);\r\n\r\n\t// 2x decimation:\r\n\tLP4 = 0.19 * (s4y4 + s7) + 0.57 * (s5c2 + s5) - (0.52 * s6); // filter output\r\n\r\n\t// update filter histories:\r\n\ts0 = slimc1; // McCulloch 'slim'\r\n\ts1 = s1c1;\r\n\ts2 = s2c1;\r\n\ts3 = s3c1;\r\n\ts4 = s4c1;\r\n\ts5 = s4y4; // shared (McCulloch also 's7')\r\n\ts6 = LP4;\r\n\ts7 = s5c2; // McCulloch 's8'\r\n\r\n\tyout = 0;\r\n\t// the extra filter modes are an addition by Peter McCulloch, based on a paper by Antti Huovilainen.\r\n\t// here in an if/else block, so only calculate (cpu) if filter type actually chosen (evieve):\r\n\tif (mode == 1)\r\n\t\tyout = x3 + (-4 * (s1y1 + s3y3)) + (6 * s2y2) + LP4; // 2-pole highpass (sometimes works)\r\n\telse if (mode == 2)\r\n\t\tyout = (4 * (s2y2 + LP4) + (-8 * s3y3)); // 2-pole bandpass (basically works)\r\n\telse if (mode == 3)\r\n\t\tyout = s2y2; // 2-pole lowpass (works)\r\n\telse if (mode == 4)\r\n\t\tyout = x3 + (-2 * s1y1) + s2y2; // 2-pole notch (does not work)\r\n\telse if (mode == 5)\r\n\t\tyout = 2 * (s1y1 - s2y2); // 2-pole peak (basically works)\r\n\telse // (mode == 0)\r\n\t\tyout = LP4; // master 4-pole lowpass ladder filter output (default, works perfect)\r\n\r\n\treturn yout;\r\n}\r\n\r\n// Peter McCulloch's shape ideas (resonance modifies pre/post gain stages depending on 'shape'):\nLadderShape(x, p, r, s, m, i, g) {\n\r\n\tr = clip(r, 0, 1); // resonance\r\n\tshape = clip(s, -100, 100); // shape = -100 - 100, 0 = no effect\r\n\tshape = cpsmoothc(shape, 0.99); // smooth\n\t// evieve if/else, (otherwise unbounded when shape @-100 & resonance sweeps through 0.5):\r\n\tattenuate = 1; // amplitude\n\tif (shape < -64) { // could be optimised!:\r\n\t\tshapatten = (((clip(shape, -90, -62)) + 90) / 28);\r\n\t\tpreatten = (r < 0.5) ? ((clip(r, 0, 0.5)) * 2) : (1 - ((clip(r, 0.5, 1) - 0.5) * 1.588656));\r\n\t\tatten = (pow((1 - preatten), 3.02471) * 0.498813) + 0.501187; // > 0..-6dB / ..-2dB ^\r\n\t\tattenuate = interp(shapatten, atten, (0.891251 * shapatten), mode=\"cosine\"); // gradually scaled across\r\n\t} else {\r\n\t\tattenuate = 1;\r\n\t}\r\n\tshape01 = shape * 0.01;\r\n\tshaper = ((shape01 * shape01 * shape01) * 100) * -1; // shape rescale\n\ttableup = scale(abs(shaper), 0, 100, 1, 0.2, 1);\n\ttabledown = scale(shaper, 0, 100, 1, 0.306667, 1);\n\tshapetable = (shaper > 0) ? tabledown : tableup; // < ^ clever PM linear function\n\r\n\tsc0 = shaper * 0.01;\n\tsc1 = pow(2, (sc0 + sc0 + sc0 + sc0));\n\tsc2 = 1 / clip((sc1 / 1), 0.0625, 16);\n\tsc3 = sc0 * sc0 * sc0;\n\tsc4 = sc0 > 0;\n\tsc5 = sc4 * (abs(sc3) * 15) + 1;\n\n\tshape1 = sc1 * 0.707946; // negative\n\tshape2 = ((sc2 * sc5) * shapetable) * 0.707946; // positive\n\n\tinvr = 1 - r;\r\n\t// smoothed x 2 because 'pmLadder' needs 'r' unsmoothed ('style' Param)\r\n\tpreg = cpsmoothc(((r * shape1) + invr), 0.99); // pregain smoothed\r\n\tpostg = cpsmoothc(((r * shape2) + invr), 0.996); // postgain smoothed\n\r\n\tx = x * preg; // pre\r\n\tpml = pmLadder(x, p, r, m, i, g); // the filter\n\treturn (pml * postg) * attenuate; // post\r\n}\r\n\r\n// evieve, very basic in/out gain stages (drive the filter non-linearities):\r\nLadderGain(x, p, r, s, m, i, g) {\r\n\r\n\tsh0 = clip(s, -100, 100);\r\n\tsh1 = scale(sh0, 100, -100, -3, 9, 1); // 'shape' = flipped linear -3..9 dB, 0 = +3dB\r\n\tsh2 = scale(clip(sh0, -100, 0), -100, 0, 0.707946, 1, 0.5); // attenuate1\r\n\tsh3 = scale(clip(sh0, 0, 100), 0, 100, 1, 1.412538, 0.5); // attenuate2\r\n\tr1 = scale(clip(r, 0, 1), 0, 1, 1, 0.707946, 3.1473); // attenuate3\r\n\r\n\tingain = cpsmoothc((qddbtoa(sh1)), 0.996); // pregain smoothed\r\n\tx = x * ingain; // pre\r\n\toutgain = 1 / (minimum(ingain, 1)); // reciprical postgain smoothed\r\n\r\n\tpml = pmLadder(x, p, r, m, i, g); // the filter\r\n\treturn (((pml * outgain) * sh2) * sh3) * r1; // post\r\n}\r\n\r\n// McCulloch shaping:\r\nParam style(1, min=0, max=1); // 0 = basic gain, 1 = McCulloch\r\n// gain shaping control:\r\nParam shape(75, min=-100, max=100); // completely different depending on 'style' Param\r\n// glide control for midi pitch cutoff, in milliseconds\r\n//Param glide(0, min=0, max=10000); // if glide == 0, no glide is used\r\n// filter type:\r\nParam mode(0, min=0, max=5); // LP4, HP2, BP2, LP2, N2, P2\r\n// placement of internal cubic non-linearity:\r\nParam cubic(0, min=0, max=1); // 0 = between poles 2 & 3, 1 = between poles 3 & 4\r\n// truncate Params:\r\nstylef = int(style);\r\nmodef = int(mode);\r\ncubicf = int(cubic);\r\nglide = 0;\r\n\r\nladder = 0;\r\npostgain = 1;\r\nif (stylef == 1) { // default, use Peter McCulloch shaping ('LadderShape')\r\n\tladder = LadderShape(in1, in2, in3, shape, modef, cubicf, glide);\r\n\tpostgain = 2.818383; // McCulloch = '3'\r\n} else { // (style == 0) (no McCulloch shaping, 'shape' Param does simple gain stages, a bit rubbish)\r\n\tladder = LadderGain(in1, in2, in3, shape, modef, cubicf, glide);\r\n\tpostgain = 1.678804;\r\n}\r\nout1 = dcblock(ladder * postgain); // keep McCulloch output gain boost regardless of 'style' Param\r\n",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 12.0,
					"id" : "obj-3",
					"maxclass" : "codebox",
					"numinlets" : 3,
					"numoutlets" : 1,
					"outlettype" : [ "" ],
					"patching_rect" : [ 30.0, 54.0, 888.0, 731.0 ]
				}

