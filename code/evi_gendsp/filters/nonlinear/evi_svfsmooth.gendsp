                    "outlettype": [ "" ],
                    "patching_rect": [ 298.0, 13.0, 228.0, 35.0 ],
                    "text": "in 2 (signal/float) Freq in Pitch (default) or Hz depending on 'cutoffmode' attribute"
                }
            },
            {
                "box": {
                    "code": "\r\n// a cheap nonlinear multimode SVF for when you need a quick cheap synth filter,\r\n// not perfect but quite good, morphing via the 'morph' attribute is cool.\r\n// @see also: \"evi_filter_morph.gendsp\" / [evi.filter.morph~] for linear LP..BP..HP morphing.\r\n// @see also: \"evi_arpnotch.gendsp\" / [evi.arpnotch~] for alternative nonlinear morphing.\r\n// @see also: \"evi_svfsynth.gendsp\" for a beefy nonlinear 12 & 24 dB svf (with morphing).\r\n\r\nrequire(\"evi_tanh.genexpr\");                    // includes \"evi_approx.genexpr\"\r\nrequire(\"evi_smooth.genexpr\");\r\n\r\n// core\r\n\r\neviSvfSmoothCore(X, w2, r2, tl)                 // input, warped freq, full res, nonlin gain\r\n{\r\n    History\tstate1(0), state2(0);\t\t\t\t// SVF state initialise\r\n\r\n    // integrators, post state, feedback\r\n    s1\t= state1;\r\n    g2\t= w2 * w2;\r\n    s2\t= state2 + (s1 * w2);\r\n\r\n    // resonance\r\n    gG\t=   w2 * r2;\r\n    sG\t=   s1 * r2;\r\n    gS\t= -(g2 + gG);                           // invert feedback\r\n    sS\t= -(s2 + sG);\r\n\r\n    // solve\r\n    alpha\t= 1 / (1 - gS);\r\n    x0\t    = ((X * gS) + sS) * alpha;\t        // audio input\r\n    y0\t\t= X + x0;\t\t\t\t\t\t    // y0 = HP\r\n\r\n    // integrator 1, post state, nonlinear\r\n    x1\t= y0 * w2;\r\n    y1\t= tanhLxA((x1 + state1), tl);\t\t\t// y1 = BP\r\n\r\n    // integrator 2, post state, nonlinear\r\n    x2\t= y1 * w2;\r\n    y2\t= tanhLxA((x2 + state2), tl);\t\t\t// y2 = LP\r\n    y3\t= y0 + y2;\t\t\t\t\t\t\t\t// y3 = BN\t// (y1 * r2)\r\n\r\n    // integrator 1, update state\r\n    state1\t\t= x1 + y1;\r\n\r\n    // integrator 2, update state\r\n    state2\t\t= x2 + y2;\r\n\r\n    return  y2, y1, y0, y3;                     // LP, BP, HP, BN\r\n}\r\n\r\n// filter\r\n\r\npreWarp(cutoff, type)\r\n{\r\n    hz  = 0;\r\n\tif (type) {\r\n\t\thz\t= mtofApprox(minimum(cutoff, 133.2522));\r\n\t} else {\r\n\t    hz\t= minimum(cutoff, (samplerate * 0.408164));\r\n    }\r\n\treturn\ttanA2(hz * PI / samplerate);        // w/2\r\n}\r\n\r\n// mixing\r\n\r\nmix3linear(i1, i2, i3, interp)\r\n{\t\t\t\t\t\t\t\t\t //\t\tshould be\tmode=\"cosine\" ??\r\n\tm1\t=\tinterp( clip(interp, 0, 1),\t\t\ti1, i2,\tmode=\"linear\");\r\n\treturn\tinterp((clip(interp, 1, 2) - 1),\tm1, i3,\tmode=\"linear\");\r\n}\r\n\r\n// declare\r\n\r\nParam\tcutoffmode(1, min=0, max=1);\t\t\t// 0 = Hz, 1 = pitch (default)\r\nParam\tsaturation(20, min=-20, max=40);\t\t// internal integrator saturation in dB\r\nParam\tsaturationsmooth(0, min=0, max=111);\t// in ms\r\nParam\tmorphsmooth(30, min=0, max=333);\t    // in ms\r\n\r\n// inputs (smooth || mod res & cutoff externally)\r\nmorph   = clip(     in4, 0, 1);                 // 0=LP .. 0.5=BP .. 1=HP\r\nres\t\t= clip(\t\tin3, 0, 1) * 1.01;\t\t    // cheeky for self oscillation\r\ncutoff\t= maximum(\tin2, 0);\t\t            // cutoff freq (default in pitch)\r\nX\t\t=\tdcblock(in1 * sqrt1_2);\t            // clean audio input, who knows why\r\n\r\n// freq warp\r\ntype\t\t= int(cutoffmode);\t\t            // 0 = in Hz, 1 = (default) in pitch\r\nW\t\t\t= preWarp(cutoff, type);            // warp\r\n\r\n// resonance\r\nresAtten\t= mix(1, sqrt1_2, res);             // attenuate filters for high res (0..1=1..0.707)\r\nR\t\t\t= 1 - res;\r\nR\t\t\t= R + R;\r\n\r\n// integrator saturation\r\nS\t\t\t= dbtoaApprox(saturation);\r\nif (saturationsmooth > 0) {                     // default do not use\r\n\tS\t\t= expsmooth(S, (saturationsmooth * 0.001));\r\n}\r\n\r\n// filter output mixing, exact smoother\r\nM\t\t\t= morph + morph;\r\nif (morphsmooth > 0) {\r\n\tM, fn\t= eviLine(M, mstosamps(morphsmooth));\r\n}\r\n\r\n// SVF\r\n//LP, BP, HP, BN\t= evi_svfsmoothcore(X, W, R, S);\r\nLP, BP, HP, BN\t= eviSvfSmoothCore(X, W, R, S);\r\nLP\t\t\t\t= LP * resAtten;\r\nBP\t\t\t\t= BP * resAtten;\r\nHP\t\t\t\t= HP * resAtten;\r\nBN\t\t\t\t= BN * resAtten;\r\nsvfMix\t\t\t= mix3linear(LP, BP, HP, M);\r\n\r\n// outputs\r\nout1\t\t\t= dcblock(svfMix);\r\nout2\t\t\t= LP;\r\nout3\t\t\t= BP;\r\nout4\t\t\t= HP;\r\nout5\t\t\t= BN;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 4,
                    "numoutlets": 5,
                    "outlettype": [ "", "", "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 765.0, 723.0 ]
                }
