                    "id": "obj-2",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 218.0, 19.0, 325.0, 22.0 ],
                    "text": "in 2 (signal/float) Cutoff in Hz or Pitch @default 698.456463"
                }
            },
            {
                "box": {
                    "code": "\r\n//  TPT nonlinear SVF with selectable or crossfading outputs\r\n//\tby Pete for Maurizio Giri / evieve, 2016\r\n//  @see also: \"evi_svfsmooth.gendsp\" & \"evi_arpnotch.gendsp\"\r\n\r\n//  nonlinear behaviour based on \"Computational optimization of nonlinear\r\n//\tzero-delay feedback by second-order piecewise approximation\"\r\n//\tby Vadim Zavalishin, 2008\r\n\r\nrequire(\"evi_smooth.genexpr\");\r\nrequire(\"evi_interp.genexpr\");\r\n\r\nmix3sqrt(i1, i2, i3, ii)\r\n{\r\n\tm1\t\t=\txfadeSqrt(i1, i2,\t clip(ii, 0, 1));\r\n\treturn\t\txfadeSqrt(m1, i3,   (clip(ii, 1, 2) - 1));\r\n}\r\n\r\npreWarp(c, t, o=1)\r\n{\r\n\tf\t\t= minimum(c, (samplerate * 0.408164));\r\n\tif (t) {\t\t\t\t\t\t    // only compute if required\r\n\t\tf\t= mtofApprox(minimum(c, 133.2522));\r\n\t}\r\n\treturn\ttanA2(f * PI / samplerate) * (o ? 0.5 : 1); // w/2\r\n}\r\n\r\n// svf 1x, post warped version\r\n\r\nsexySVF1(X, w2, res, mod)\r\n{\r\n\t// integrators state\r\n\tHistory\tbli1(0), bli2(0);\r\n\r\n\t// two pole filter part 2 (pass state)\r\n\ts1\t\t= bli1 + bli1;\r\n\ts2\t\t= bli2 + bli2;\r\n\r\n\t// filter output 1 (nonlin & solve fb, piecewise zavalishin)\r\n\txms\t=    X - s2;\r\n\tg2p\t=    1 / ((w2 * w2) + 1);\r\n\tmu  =  -(w2 + w2) * g2p;\r\n\tnu\t=  ((xms * w2) + s1) * g2p;\r\n\tSN\t=    sign(nu);\r\n\tmd1\t=    1 / mod;\r\n\tP\t=  ((md1 + md1) * (2 - md1)) - (res + res);\r\n\tS\t=   (1 - res) * SN;\r\n\tQ\t=   (P * mu) - 1;\r\n\tC\t= (((P * nu) - S) - S) * nu;\r\n\tB\t=  ((S * mu) - SN) - (Q * nu);\r\n\tA\t=   (Q - 1) * mu;\r\n\tfnc\t=    sqrt((B * B) - (A * C)) * SN;\r\n\tt\t=  ((B * SN) > 0) ? ((fnc + B) / A) : (C / (B - fnc));\r\n\tyH\t=  ((xms - (w2 * s1)) - (t + t)) * g2p;\r\n\r\n\t// two pole filter part 1 (integrators)\r\n\txmw1\t= (yH  * w2) + bli1;\r\n\tlp1\t\t=  xmw1 + bli1;\r\n\txmw2\t= (lp1 * w2) + bli2;\r\n\tlp2\t\t=  xmw2 + bli2;\r\n\r\n\t// filter output 2\r\n\tyB\t\t= (lp1 * res) + t;\r\n\tyL\t\t=  lp2;\r\n\r\n\t// two pole filter part 3 (update state)\r\n\tbli1\t=  xmw1;\r\n\tbli2\t=  xmw2;\r\n\r\n\t// simultaneous outputs\r\n\treturn\tyL, yB, yH;\r\n}\r\n\r\nsexySVF2(X0, X1, w2, res, mod)\r\n{\r\n\t// integrators state\r\n\tHistory\tbli1(0), bli2(0);\r\n\r\n\tg2p\t    =   1 / ((w2 * w2) + 1);\r\n\tmu\t    =  -(w2 + w2) * g2p;\r\n\tmd1\t    =   1 / mod;\r\n\tP\t    =  ((md1 + md1) * (2 - md1)) - (res + res);\r\n\tQ\t    =   (P * mu) - 1;\r\n\tA\t    =   (Q - 1) * mu;\r\n\r\n    // pass 1\r\n\r\n\t// two pole filter part 2 (pass state)\r\n\ts10\t    = bli1 + bli1;\r\n\ts20\t    = bli2 + bli2;\r\n\r\n\t// filter output 1 (nonlin & solve fb, piecewise zavalishin)\r\n\txms0\t=    X0 - s20;\r\n\tnu0\t    =  ((xms0 * w2) + s10) * g2p;\r\n\tSN0\t    =   sign(nu0);\r\n\tS0\t    =   (1 - res) * SN0;\r\n\tC0\t    = (((P * nu0) - S0) - S0) * nu0;\r\n\tB0\t    =  ((S0 * mu) - SN0) - (Q * nu0);\r\n\tfnc0\t=   sqrt((B0 * B0) - (A * C0)) * SN0;\r\n\tt0\t    =  ((B0 * SN0) > 0) ? ((fnc0 + B0) / A) : (C0 / (B0 - fnc0));\r\n\tyH0\t    =  ((xms0 - (w2 * s10)) - (t0 + t0)) * g2p;\r\n\r\n\t// two pole filter part 1 (integrators)\r\n\txmw10\t= (yH0  * w2) + bli1;\r\n\tlp10\t=  xmw10 + bli1;\r\n\txmw20\t= (lp10 * w2) + bli2;\r\n\tlp20\t=  xmw20 + bli2;\r\n\r\n\t// filter output 2\r\n\tyB0\t\t= (lp10 * res) + t0;\r\n\tyL0\t\t=  lp20;\r\n\r\n\t// two pole filter part 3 (update state)\r\n\tbli1\t=  xmw10;\r\n\tbli2\t=  xmw20;\r\n\r\n    // pass 2\r\n\r\n\t// two pole filter part 2 (pass state)\r\n\ts11\t\t= bli1 + bli1;\r\n\ts21\t\t= bli2 + bli2;\r\n\r\n\t// filter output 1 (nonlin & solve fb, piecewise zavalishin)\r\n\txms1\t=    X1 - s21;\r\n\tnu1\t    =  ((xms1 * w2) + s11) * g2p;\r\n\tSN1\t    =   sign(nu1);\r\n\tS1\t    =   (1 - res) * SN1;\r\n\tC1\t    = (((P * nu1) - S1) - S1) * nu1;\r\n\tB1\t    =  ((S1 * mu) - SN1) - (Q * nu1);\r\n\tfnc1\t=   sqrt((B1 * B1) - (A * C1)) * SN1;\r\n\tt1\t    =  ((B1 * SN1) > 0) ? ((fnc1 + B1) / A) : (C1 / (B1 - fnc1));\r\n\tyH1\t    =  ((xms1 - (w2 * s11)) - (t1 + t1)) * g2p;\r\n\r\n\t// two pole filter part 1 (integrators)\r\n\txmw11\t= (yH1  * w2) + bli1;\r\n\tlp11\t=  xmw11 + bli1;\r\n\txmw21\t= (lp11 * w2) + bli2;\r\n\tlp21\t=  xmw21 + bli2;\r\n\r\n\t// filter output 2\r\n\tyB1\t\t= (lp11 * res) + t1;\r\n\tyL1\t\t=  lp21;\r\n\r\n\t// two pole filter part 3 (update state)\r\n\tbli1\t=  xmw11;\r\n\tbli2\t=  xmw21;\r\n\r\n\t// simultaneous outputs\r\n\treturn\tyL0, yL1, yB0, yB1, yH0, yH1;\r\n}\r\n\r\n// fixed 2x quasi oversampling (hermite6)\nsexySVF2_2x6( XIN, w2, res, mod )\n{\t// up 2\n\tHistory\tumTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory\tdmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\tHistory\tdmT3_2(0), dmT2_2(0), dmT1_2(0), dmT0_2(0), dmTm1_2(0);\n\tHistory\tdmT3_3(0), dmT2_3(0), dmT1_3(0), dmT0_3(0), dmTm1_3(0);\n\t// align\n\tHistory\tdoX0(0), doX1(0), doX2(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= hermite_sixpoint_interp(0.5,\tumTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0\t= umT2_0 + 0;\n\n\t// process 2x\n    y1_0, y2_0, y3_0, y4_0, y5_0, y6_0 = sexySVF2(x1_0, x2_0, w2, res, mod);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= hermite_sixpoint_interp(0.5,\ty2_0_a,\tdmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty4_0_a\t= y4_0 + 0;\n\ty4_1\t= hermite_sixpoint_interp(0.5,\ty4_0_a,\tdmTm1_2, dmT0_2, dmT1_2, dmT2_2, dmT3_2);\n\n\ty6_0_a\t= y6_0 + 0;\n\ty6_1\t= hermite_sixpoint_interp(0.5,\ty6_0_a,\tdmTm1_3, dmT0_3, dmT1_3, dmT2_3, dmT3_3);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\ty0_1\t= (doX1 + y4_1) * 0.5;\n\ty0_2\t= (doX2 + y6_1) * 0.5;\n\n\t// update input\n\tumTm2_0\t= umTm1_0;\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0 \t= umT2_0;\n\tumT2_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\tdoX1\t= y3_0;\n\tdoX2\t= y5_0;\n\n    // update outputs\n\tdmT3_1\t= dmT2_1;\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= dmTm1_1;\n\tdmTm1_1\t= y2_0;\n\n\tdmT3_2\t= dmT2_2;\n\tdmT2_2\t= dmT1_2;\n\tdmT1_2\t= dmT0_2;\n\tdmT0_2\t= dmTm1_2;\n\tdmTm1_2\t= y4_0;\n\n\tdmT3_3\t= dmT2_3;\n\tdmT2_3\t= dmT1_3;\n\tdmT1_3\t= dmT0_3;\n\tdmT0_3\t= dmTm1_3;\n\tdmTm1_3\t= y6_0;\n\n\treturn dcblock(y0_0), dcblock(y0_1), dcblock(y0_2);\n}\r\n\r\n// fixed 2x quasi oversampling (cubic4)\r\nsexySVF2_2x4( XIN, w2, res, mod )\n{\t// up 2\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 2\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\tHistory\tdmT2_2(0), dmT1_2(0), dmT0_2(0);\n\tHistory\tdmT2_3(0), dmT1_3(0), dmT0_3(0);\n\t// align\n\tHistory\tdoX0(0), doX1(0), doX2(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= cubic_hermite_interp(0.5,\tumTm1_0, umT0_0, umT1_0, x0_0_a);\n\tx2_0\t= umT1_0 + 0;\n\n\t// process 2x\n\ty1_0, y2_0, y3_0, y4_0, y5_0, y6_0 = sexySVF2(x1_0, x2_0, w2, res, mod);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= cubic_hermite_interp(0.5,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1);\n\r\n\ty4_0_a\t= y4_0 + 0;\n\ty4_1\t= cubic_hermite_interp(0.5,\ty4_0_a,\tdmT0_2, dmT1_2, dmT2_2);\n\r\n\ty6_0_a\t= y6_0 + 0;\n\ty6_1\t= cubic_hermite_interp(0.5,\ty6_0_a,\tdmT0_3, dmT1_3, dmT2_3);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\ty0_1\t= (doX1 + y4_1) * 0.5;\n\ty0_2\t= (doX2 + y6_1) * 0.5;\n\n\t// update input\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\tdoX1\t= y3_0;\n\tdoX2\t= y5_0;\n\r\n    // update outputs\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\tdmT2_2\t= dmT1_2;\n\tdmT1_2\t= dmT0_2;\n\tdmT0_2\t= y4_0;\n\r\n\tdmT2_3\t= dmT1_3;\n\tdmT1_3\t= dmT0_3;\n\tdmT0_3\t= y6_0;\n\r\n\treturn dcblock(y0_0), dcblock(y0_1), dcblock(y0_2);\n}\r\n\r\nsexySVFselect(X, w2, res, mod, os)\r\n{\r\n    History seldummy(0);\r\n    yL, yB, yH      = 0;\r\n    if (os == 2) {\r\n        yL, yB, yH  = sexySVF2_2x6(X, w2, res, mod);\r\n    }\r\n    else if (os == 1) {\r\n        yL, yB, yH  = sexySVF2_2x4(X, w2, res, mod);\r\n    }\r\n    else {\r\n        yL, yB, yH  = sexySVF1(X, w2, res, mod);\r\n    }\r\n    return  yL, yB, yH;\r\n}\r\n\r\n// declare\r\n\r\nParam   slope(0, min=0, max=1);         // 0 = 12dB filters only, 1 = and 24dB filters\r\nParam\tcutoffmode(0, min=0, max=1);    // cutoff (in2), 0 = in Hz, 1 = in pitch\r\nParam\tshape(sqrt1_2, min=0, max=1);   // y(1) (0.603553), do not touch\r\nParam\tshapesmooth(0., min=0, max=100);// in ms (22.666)\r\nParam\tfiltinterp(0., min=0, max=1);   // 0=LP, 0.5=BP, 1=HP\r\nParam\tfiltinterpsmooth(30.222, min=0, max=100);// in ms\r\nParam\ttunesmooth(15.111, min=0, max=100);// in ms\r\nParam   oversample(1, min=0, max=2);    // 1x, 2x 4point, 2x 6point (6point not so useful here)\r\nos      = int(oversample);\r\ntfdb    = int(slope);\r\noso     = os > 0;\r\n\r\n// inputs (smooth || mod res & cutoff externally)\r\n\r\nres\t\t= clip(\t\tin3, 0, 2) * 1.09;  // if shape <= 0.603553, max res \r\ncutoff\t= maximum(\tin2, 0);\t\t    // cutoff freq (default in Hz)\r\n\r\nx\t\t= \t\t\tin1 * sqrt1_2;\t    // audio input\r\nX\t\t=\t\t\tx;//dcblock(x);     // clean, why?\r\n\r\n// freq warp\r\n\r\ntype\t= int(cutoffmode);\t\t        // 0 = in Hz, 1 = (default) in pitch\r\nw1\t\t= preWarp(cutoff, type, o=oso); // warp for both\r\n\r\n// tune (TODO: make nice polynomials for this crap)\r\n// this almost works, small bump between approx 1.7..2\r\n\r\nrtune   = 1;\r\nwres    = res;\r\nwshape  = shape;\r\nif (res > 1) {\r\n    wmodH\t= 1 - (sqrt(maximum(((w1 - 0.217027) / 1.661039), 0)) * 0.5);\r\n    wmodL\t= sqrt((minimum(w1, 0.007836) * 63) + 0.506332);\r\n    wshape\t= shape * wmodH * wmodH * wmodL;\r\n    wres\t= res * wmodH * wmodL * wmodL;\r\n    cres    = clip(wres, 1, 2) - 1;\r\n    resqrt\t= sqrt(cres) * (1 + cres*cres*cres*cres*cres*cres * 0.15); // almost works\r\n    rtune\t= (((((wshape * wshape) * resqrt) * resqrt) * resqrt) * 0.828428) + 1;\r\n}\r\n\r\n// parse\r\n\r\nwtune\t\t= rtune;\r\nif (tunesmooth > 0) {\t\t\t\t    // only compute if required\r\n\twtune\t= expsmooth(wtune, tunesmooth*0.001);   // better smoother here ?\r\n}\r\nw2\t\t\t= w1 * wtune;\r\n\r\nwmod\t\t= (wshape * 0.792893) + 0.207107;\r\nif (shapesmooth > 0) {\t\t\t\t    // only compute if required\r\n\twmod\t= expsmooth(wmod, shapesmooth*0.001);\r\n}\r\n\r\nfiltint\t\t= filtinterp * 2;\r\nif (filtinterpsmooth > 0) {\t\t\t    // only compute if required\r\n\tfiltint\t= logsmooth(filtint, filtinterpsmooth*0.001);\r\n}\r\n\r\n// (sexy) filter(s)\r\n\r\nyL,       yB,   yH\t\t= sexySVFselect(X, w2, wres, wmod, os);     // singles\r\nyX\t\t\t\t\t\t= mix3sqrt(  yL, yB, yH, filtint);          // 2 poles\r\ny12\t\t\t\t\t\t= dcblock(   yX);\r\ny24 = 0;\r\nif (tfdb) {\r\n    wres4\t\t        = wres * 0.25;  // attenuate for four poles (0.5)\r\n    wmod4\t\t        = wmod * 0.5;   // attenuate for four poles (sqrt1_2)\r\n    yL24, yB24, yH24\t= sexySVFselect(y12, w2, wres4, wmod4, os); // mixed\r\n    yY\t\t\t\t\t= mix3sqrt(  yL24, yB24, yH24, filtint);    // 4 poles\r\n    y24\t\t\t\t\t= dcblock(     yY * sqrt2);\r\n}\r\n\r\nout1\t= y12 * sqrt1_2;                // 12 dB filter outputs (mixed)\r\nout2\t= y24 * sqrt1_2;                // 24 dB filter outputs (mixed)\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 49.0, 58.0, 753.0, 732.0 ]
                }
            },
