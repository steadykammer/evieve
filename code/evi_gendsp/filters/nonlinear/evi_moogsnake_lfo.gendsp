{
    "patcher": {
        "fileversion": 1,
        "appversion": {
            "major": 9,
            "minor": 2,
            "revision": 0,
            "architecture": "x64",
            "modernui": 1
        },
        "classnamespace": "dsp.gen",
        "rect": [ 34.0, 100.0, 918.0, 848.0 ],
        "gridonopen": 2,
        "integercoordinates": 1,
        "boxes": [
            {
                "box": {
                    "code": "/*\r\nMoog Ladder implementation by Antti Huovilainen, 2004\r\n\nThis GenExpr is a port of the CSound Moogladder opcode, originally by Victor Lazzarini.\nBy Pete, originally January 2012 for the Max/gen~ examples folder (thanks to Graham Wakefield).\nThis evieve version a minor update for better CPU etc some time later (thanks to Peter McCulloch).\r\n\r\nThere are much better proper 'zdf' Ladder filters in the evieve package, but this filter is very\r\nfamous in terms of DSP history, as it is a brilliant z-1 implementation often cited by the later\r\nDSP zdf proponents. It is part of evieve for the sake of pedagogy. (It is much more concise\r\nand easier to understand than the ICST BEAP z-1 ladder).\r\n\n-------\r\nOriginal Victor Lazzarini opcode description:\r\n\nThis is a new digital implementation of the Moog ladder filter based on the work of\nAntti Huovilainen, described in the paper \"Non-Linear Digital Implementation of the\nMoog Ladder Filter\" (Proceedings of DaFX04, Univ of Napoli). This implementation is\nprobably a more accurate digital representation of the original analogue filter.\nThis is version 2 (revised 14/DEC/2004), with improved amplitude/resonance scaling\nand frequency correction using a couple of polynomials, as suggested by Antti.\r\n-------\n*/\n\r\nrequire(\"evi_tanh.genexpr\");\r\n\n// like rand~ but with cosine interpolation\r\nrandc(p)\r\n{\r\n\tHistory n1(0);\r\n\tramp = phasor(p);\r\n\tn0 = noise();\r\n\tq0 = delta(ramp) < 0;\r\n\tq1 = latch(n1, q0);\r\n\tq2 = latch(n0, q0);\r\n\tq3 = interp(ramp, q1, q2, mode=\"cosine\");\r\n\tn1 = q2;\r\n\treturn q3;\r\n}\r\n\r\n// nonlinear onepole\r\nstage(z, tvg, y, rv)\r\n{\t// whichever tanh approx you use here, it must be identical on either side of this subtraction\r\n\treturn z + (tvg * (tanhA(y * rv) - tanhA(z * rv)));\r\n}\r\n\r\n// the filter, 1x\r\n// input signal, cutoff frequency (Hz), resonance (0..1), 'unstable' lfo (0.575037..1.418963)\nanttiLadder1(asig, cf, res, shuf)\t\t// default shuf = 0.997\r\n{\n\tHistory z1(0), z2(0), z3(0), z4(0);\t// 4 states\n\tHistory\tml(0);\t\t// ml() is the problem with this filter\r\n\r\n\tres = res * 0.9901;\r\n\t// maximum with lfo * default sh = 4.\r\n\tsh = (shuf * 0.191958) + 0.727617;\t// rescale lfo for frma / res\r\n\tfres = (4.35364 * sh);\r\n\r\n\t// \"twice the 'thermal voltage of a transistor'\" with 'unstable' offset lfo\n\ti2v = 40120.371094 * shuf;\t\t\t// maximum lfo * default shuf = 40000\r\n\tri2v = 1 / i2v;\r\n\takf =  cf / samplerate;\t\t\t\t// div by the upsampled sampling rate\n \takfc = akf * 0.5;\t// sr is half the actual (upsampled) filter sampling rate\n\n\t// frequency and amplitude correction  \n\tfcr = (1.8730 * akfc * akfc * akfc) + (0.4955 * akfc * akfc) - (0.6490 * akfc) + 0.9988;\n\tacr = (-3.9364 * akfc * akfc) + (1.8409 * akfc) + 0.9968;\n\ttwovg = i2v * (1 - expA(-TWOPI * fcr * akf));\t// filter tuning, slightly flat\r\n\tfrma = fres * res * ml * acr; \t\t// resonance with 'unstable' small flattening offset lfo\r\n\n\t// cascade of nonlinear sections\n\ty1 = stage(z1, twovg, (asig - frma), ri2v);\r\n\ty2 = stage(z2, twovg, y1, ri2v);\n\ty3 = stage(z3, twovg, y2, ri2v);\n\ty4 = stage(z4, twovg, y3, ri2v);\n\t// half sample delay for nonlinear phase compensation\n\tml = tanhL((y4 + z4) * 0.5);\r\n\t// update\n\tz1 = y1;\n\tz2 = y2;\n\tz3 = y3;\n\tz4 = y4;\n\n\treturn ml;\r\n}\n\r\n// the filter, 2x\r\nanttiLadder2(asig0, asig1, cf, res, shuf)\r\n{\n\tHistory z1(0), z2(0), z3(0), z4(0);\t// 4 poles\n\tHistory\tml0(0), ml1(0);\r\n\r\n\tres = res * 0.9901;\r\n\t// maximum with lfo * default sh = 4.\r\n\tsh = (shuf * 0.191958) + 0.727617;\t// rescale lfo for frma / res\r\n\tfres = (4.35364 * sh);\r\n\n\t// \"twice the 'thermal voltage of a transistor'\" with 'unstable' offset lfo\n\ti2v = 40120.371094 * shuf;\t\t\t// maximum lfo * default shuf = 40000\r\n\tri2v = 1 / i2v;\r\n\takf =  cf / samplerate*0.5;// div by half the upsampled sampling rate\n \takfc = akf * 0.5;\t// sr is half the actual (upsampled) filter sampling rate\n\n\t// frequency and amplitude correction  \n\tfcr = (1.8730 * akfc * akfc * akfc) + (0.4955 * akfc * akfc) - (0.6490 * akfc) + 0.999999;\n\tacr = (-3.9364 * akfc * akfc) + (1.8409 * akfc) + 0.9968;\n\ttwovg = i2v * (1 - expA(-TWOPI * fcr * akf) + 0.000128);\r\n\r\n    // pass 1\r\n\r\n    // resonance factored in to z-1, with 'unstable' small flattening offset lfo\n    frma0 = fres * res * ml0 * acr;\r\n\t// cascade of nonlinear sections\n\ty10 = stage(z1, twovg, (asig0 - frma0), ri2v);\r\n\ty20 = stage(z2, twovg, y10, ri2v);\n\ty30 = stage(z3, twovg, y20, ri2v);\n\ty40 = stage(z4, twovg, y30, ri2v);\n\t// half sample delay for nonlinear phase compensation\n\tml0 = tanhL((y40 + z4) * 0.5);\r\n\t// update\n\tz1 = y10;\n\tz2 = y20;\n\tz3 = y30;\n\tz4 = y40;\n\r\n    // pass 2\r\n\r\n    // resonance factored in to z-1, with 'unstable' small flattening offset lfo\n    frma1 = fres * res * ml1 * acr;\r\n\t// cascade of nonlinear sections\n\ty11 = stage(z1, twovg, (asig1 - frma1), ri2v);\r\n\ty21 = stage(z2, twovg, y11, ri2v);\n\ty31 = stage(z3, twovg, y21, ri2v);\n\ty41 = stage(z4, twovg, y31, ri2v);\n\t// half sample delay for nonlinear phase compensation\n\tml1 = tanhL((y41 + z4) * 0.5);\r\n\t// update\n\tz1 = y11;\n\tz2 = y21;\n\tz3 = y31;\n\tz4 = y41;\n\n\treturn ml0, ml1;\n}\r\n\r\n// fixed 2x (not really) quasi oversampling, ignore this voodoo\nanttiLadder2_2x(XIN, cf, res)\n{\t// up 2\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 2\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= interp(0.5,\tumTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\tx2_0\t= umT1_0 + 0;\n\n\t// process 2x\n    y1_0, y2_0 = anttiLadder2(x1_0, x2_0, cf, res);\n\r\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(0.5,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\treturn\tdcblock(y0_0);\n}\r\n\r\n// pete: the 'lfo' is really stupid, i did it for a specific weird thing once (default off)\r\nParam lforate(0, min=0, max=39.98647);\t\t// randc freq (Hz) (0.8493 ?)\r\nParam lforange(0.421963, min=0.1, max=0.9);\t// randc range (multiplier)\r\nParam lfomode(1);\t\t\t\t\t\t\t// legacy\r\n// lfo is interpolated brownish noise, scaled 0.575037..1.418963 around 0.997 for multiplication\r\nshuffle\t= 0.997;\r\nif (lforate > 0) {\r\n\tshuffle\t= (randc(lforate) * lforange) + 0.997;\r\n}\r\n\r\nfreq\t= clip(in2, 10, samplerate*0.333333);   // high tuning bad because of shit 'oversampling' used here\r\nres\t\t= clip(in3, 0, 1);\r\n\r\n//out1\t= anttiLadder1(in1, freq, res, shuffle);\r\nout1\t= anttiLadder2_2x(in1, freq, res, shuffle) * sqrt1_2;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
