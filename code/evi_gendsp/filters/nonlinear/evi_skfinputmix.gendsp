                    "patching_rect": [ 472.0, 19.0, 157.0, 22.0 ],
                    "text": "in 2 (signal) Bandpass Input"
                }
            },
            {
                "box": {
                    "code": "\r\n// a version of Simper's sKf input mixer\r\n// @see: http://cytomic.com/files/dsp/SkfInputMixing.pdf\r\n// mixing for low, band, high, decoupling mixing from coeffs, possibly different inputs\r\n// for a similar filter with different properties @see: \"evi_svfinputmix.gendsp\"\r\n//                                                           ^V^\r\n\r\nrequire(\"evi_tanh.genexpr\");\r\nrequire(\"evi_trig.genexpr\");\r\nrequire(\"evi_smooth_bank.genexpr\");\r\n\r\ninputMixingSkfCoefficients(cutoff, res)\r\n{\r\n    r   = (res * 0.8) + 0.2;\r\n    k\t= 1.88062 * r;\r\n    k1m\t= 1 - k;\r\n    k2m\t= 2 - k;\r\r\n    w\t= PI * cutoff / SAMPLERATE;\r    s1\t= sin52param(w);\r    s2\t= sin52param(w + w);\r\r\n    nrm\t= 1 / (2 + k2m * s2);\r    s1n\t= (s1 + s1) * s1 * nrm;\r    s2n\t= s2 * nrm;\r\r\n    g1m0\t= -k1m * s1n + s2n;\r    g1m1\t= -s1n - s2n;\r    g1m2\t=  s1n + k1m * s2n;\r    g2\t\t= -k * s2n;\r    g3m0\t=  s1n;\r    g3m1\t=  s2n;\r    g3m2\t= -s1n - k2m * s2n;\r    g4\t\t= -s1n - k1m * s2n;\r\r\n    return g1m0, g1m1, g1m2, g2, g3m0, g3m1, g3m2, g4;\r\n}\r\n\r\nHistory\tic1eq(0), ic2eq(0);\r\n\r\n// param rate\r\n\r\nParam   cutoff(1000., min=10, max=10000);           // Hz\r\nParam   res(sqrt1_2, min=0, max=1);                 // 0..1\r\n\r\nParam   coeffsmooth(15.111, min=0, max=333);        // ms\r\nParam   mixsmooth(22.666, min=0, max=333);          // ms\r\nParam   mix(0., min=0, max=1);                      // internal 3-way sine mixer\r\nParam   mixenable(1, min=0, max=1);                 // enable the internal mixer 0/1 ?\r\nme      = int(mixenable);\r\n\r\n// the input mixer is optional, default on\r\nm0      = mixSin(mix, 0.5);\r\nm1      = mixSin(mix, 0);\r\nm2      = mixSin(mix, -0.5);\r\n\r\ng1m0, g1m1, g1m2, g2, g3m0, g3m1, g3m2, g4  = inputMixingSkfCoefficients(cutoff, res);\r\n\r\n// audio rate from here\r\n\r\nif (coeffsmooth > 0) {\r\n    g1m0, g1m1, g1m2, g2, g3m0, g3m1, g3m2, g4  = logsmoothBank8(g1m0, g1m1, g1m2, g2, g3m0, g3m1, g3m2, g4, coeffsmooth*0.001);\r\n}\r\n\r\nvlow, vband, vhigh  = 0;\r\nif (me) {\r\n    if (mixsmooth > 0) {\r\n        m0, m1, m2  = expsmoothBank3(m0, m1, m2, mixsmooth*0.001);\r\n    }\r\n\r\n    vlow    = in1 * m0;\r\n    vband   = in2 * m1;\r\n    vhigh   = in3 * m2;\r\n}\r\nelse {\r\n    // for sequencing or fun experiments\r\n    vlow    = in1;\r\n    vband   = in2;\r\n    vhigh   = in3;\r\n}\r\n\r\n// SKF loop\r\nt1\t= vlow * g1m0 + vband * g1m1 + (vhigh * g1m2) + g1m1 * ic1eq + g2 * ic2eq;\r\nt2\t= tanhAdaa1(vlow * g3m0) + (vband * g3m1) + vhigh * g3m2 + g3m1 * ic1eq + g4 * ic2eq;\rvc2\t= t2 + ic2eq;\r\r\nic1eq  += 1.9796 * t1;\ric2eq  += 1.9796 * t2;\r\r\nout1\t= vhigh + vc2;\r\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 1002.0, 732.0 ]
                }
            },
