        "classnamespace": "dsp.gen",
        "rect": [ 308.0, 100.0, 779.0, 705.0 ],
        "gridonopen": 2,
        "subpatcher_template": "sub",
        "integercoordinates": 1,
        "boxes": [
            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 19.0, 134.0, 22.0 ],
                    "text": "in 1 (signal) Audio Input"
                }
            },
            {
                "box": {
                    "code": "\r\n// a 'one knob' (\"tone\" parameter) macroisation for nonlinear cut tone control\r\n// useful for quick colourisation in your audio chain.\r\n// @see: \"evi_damp_macro.gendsp\" / [evi.damp.macro~] for the opposite\r\n// @see: \"evi_onepole_shelving.gendsp\" / [evi.onepole.shelving~] for cut/boost\r\n\r\nrequire(\"evi_rcfilters.genexpr\");\r\nrequire(\"evi_smooth_bank.genexpr\");\r\n\r\n// param rate\r\n\r\nParam   tone(1., min=0, max=1);\r\nParam   smooth(0., min=0, max=999);\r\n\r\n// cheapo macroisation, surprisingly it works, is even accross 0..1 range\r\n\r\ndamp = 1 - tone;\r\nsqdamp = sqrt(damp);\r\ndampHzLpHs = ((1 - sqdamp) * 17500) + 500;\r\ndampHzHpLs = ((damp * damp) * 490) + 10;\r\ng1, _d1 = rcDampCoeffs0(dampHzLpHs, sqdamp);\r\ng2, d2 = rcDampCoeffs0(dampHzHpLs, sqrt(sqdamp));\r\n\r\nglp = g1; ghp = g2; hk = d2; gain = damp;\r\n\r\n// audio rate\r\n\r\nif (smooth > 0) {\r\n    glp, ghp, hk, gain = expsmoothBank4(glp, ghp, hk, gain, smooth*0.001);\r\n}\r\n\r\nVin = in1 * dbtoaApproxFast(gain * 9);\r\nLP  = rcOnePole(Vin, glp);                  // nonlinear lowpass\r\n_lp, HP = rcFilterDampLpHp(LP, ghp, hk);    // linear highpass/lowshelf\r\n\nout1 = HP * (1 + gain * gain);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 680.0, 589.0 ]
                }
            },
            {
                "box": {
                    "id": "obj-4",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 49.0, 664.0, 219.0, 22.0 ],
                    "text": "out 1 (signal) Tone-controlled Audio Out"
                }
            }
        ],
        "lines": [
            {
                "patchline": {
                    "destination": [ "obj-3", 0 ],
                    "source": [ "obj-1", 0 ]
                }
            },
            {
                "patchline": {
                    "destination": [ "obj-4", 0 ],
                    "source": [ "obj-3", 0 ]
