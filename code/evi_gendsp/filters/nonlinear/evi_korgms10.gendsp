            {
                "box": {
                    "code": "\n// actually: an erratic, out-of-control & out-of-tune aggressive filter\n// for experiments and fun times.\n\n// officially: 'Korg 35' single-amplifier unbuffered modified Sallen-Key topology filter.\n// The 'Korg 35' chip was found in the MS-10 & early MS-20 synthesisers - different to the\n// later dual-amplifier Korg OTA chip found in the later MS-20s & other Korg synthesisers.\n// For 'Korg OTA' (MS-20) style chip 'emulation' @see: \"evi_korgms20.gendsp\" and\n// \"evi_korgms20_select.gendsp\". Thanks to Will Pirkle.\n\nrequire(\"evi_tanh.genexpr\");\nrequire(\"evi_sources.genexpr\");\nrequire(\"evi_interp.genexpr\");\n\n// skew nonlin\n\naTnhLxAS(x, a)\n{\n\ttnhXa = 0;\n\tif (x > 0) {\n\t\ttnhXa = tanhLxA(x, a * 0.94);\n\t} else {\n\t\ttnhXa = tanhLxA(x, a * 1.23);\n\t}\n\treturn tnhXa;\n}\n\n// filter 1x\n\nSandKone(x0, hz, k0, load, noiz)\n{\n\t// S&K state initialise\n\tHistory\tstate0(0), state1(0), state2(0);\n\n\t// constants\n\ttr\t\t= 0.55032120814910446;\n\t// roots for R1C1 == R2C2\n\tr1\t\t= 2.618033988749895;\t\t    // -0.5 * (-3 - pow(5, 0.5));\n\tr2\t\t= 0.3819660112501051;\t\t    // -0.5 * (pow(5, 0.5) - 3);\n\t// lossy RC/CR bpf\n\tl0\t\t= 0.3819660112501052;           // ('l0' is 'r2')\n\n\t// prewarp (like BZT but not)\n\tt1 \t\t=  1 / SAMPLERATE;\n\tt2\t\t=  t1 * 0.5;\n\tw2\t\t= (2 / t1) * tanA2((TWOPI * hz) * t2);\n\tg0\t\t=  w2 * t2;\n\tff\t\t=  g0 / (1 + g0);\t\t\t    // feedforward coefficient\n\n\t// single amplifier model\n\tk1\t\t= (k0 * 3.008912) + (ff * 0.03);// self-oscillation @ 3\n\tik1     =  1  /  k1;\n\tg1\t\t=  r2 *  g0;                    // low edge\n\tg2\t\t=  r1 *  g0;                    // high edge\n\tgl\t\t=  1  +  g1;\n\tgh\t\t=  1  +  g2;\n\n\t// coefficients\n\ta1\t\t=  g1 / gl;\t\t\t\t\t\t// g low\n\ta2\t\t=  g2 / gh;\t\t\t\t\t\t// g high\n\tb1\t\t= -l0 / gl;\n\tl1\t\t=  l0 * k1;\n\tl2\t\t=  l1 * a2;\n\tb2\t\t= (l1 - (l1 * a1)) / gh;\n\ta0\t\t=  1  / (1 - l2 + (l2 * a1));\n\n\tng1\t= 0;\n\tif (noiz > 0) {                   \t\t// only compute if required\n\t\tng0\t\t= gaussianNoise(noiz);\n\t\tng1     = ng0 * (k1 + g0);\n\t//  N.B. - noise injection not required for self-oscillation, just for noise :-)\n\t}\n\n\t// 1st lowpass integrator\n\tlp1vn\t= (x0 - state1) * a1;           // input\n\tlp1\t\t= lp1vn + state1;\n\tstate1\t= lp1vn + lp1;\n\thp1\t\t=  x0 - lp1;\n\n\t// sum feedback\n\thp2fb\t= state2 * b1;\n\tbp2fb\t= state0 * b2;\n\tk35\t\t= hp2fb + bp2fb;\n\n\thp0     = (k35 - lp1) * a0;\n\tbp2     = ((k35 - (state1 * b1)) * a0) * sqrt2;\t    \n\n\t// process nonlinear\n\tu\t\t= a0 * (hp1 + k35) * k1;        // !! * 'k1'\n\tu       = aTnhLxAS(u, load);\n\n\t// 2nd lowpass integrator (loaded lpf)\n\tlp2vn\t= (u - state2) * a1;\t        // !! not 'a2'\n\tlp2\t\t= lp2vn + state2;\n\tstate2\t= lp2vn + lp2;\t\t\t\t\t//\n\thp2\t\t=  u - lp2;\n\n\tYL\t\t= k1 * lp2;\t\t\t\t\t\t\t\t\t// Korg 12 dB LP (!! level res dependent)\n\tYH\t\t= u * ik1;\t\t\t\t\t\t\t\t    // Korg 6 dB HP\n\tYF\t\t= hp2 * ik1;\t\t\t\t\t\t\t    // sort of made up 12 dB HP\n\tYB      = bp2 * ik1;                                // sort of made up 12 dB BP ?\n\n\t// feedback loop (loaded bpf)\n\tbp2vn\t= (hp2 - state0) * a2;\t        // !! 'a2'\n\tbp2\t\t= bp2vn + state0;\n\tstate0\t= bp2vn + bp2 + ng1;\t        // inject noise at feedback integrator\n\n\treturn\tdcblock(YL * 0.25),\t\t\t\t\t\t\t// 12dB LP\n\t\t\t\tdcblock(YH * sqrt1_2),\t\t\t\t\t// 6dB HP\n\t\t\t\t\tdcblock(YF * 0.68),\t\t\t\t\t// 12dB HP\n\t\t\t\t\t\tdcblock(YB * 0.5);\t\t\t\t// 12dB BP\n}\n\n// filter 2x\n\nSandKtwo(x0, x1, hz, k0, load, noiz)\n{\n\t// S&K state initialise\n\tHistory\tstate0(0), state1(0), state2(0);\n\n\t// constants\n\ttr\t\t= 0.55032120814910446;\n\t// roots for R1C1 == R2C2\n\tr1\t\t= 2.618033988749895;\t\t    // -0.5 * (-3 - pow(5, 0.5));\n\tr2\t\t= 0.3819660112501051;\t\t    // -0.5 * (pow(5, 0.5) - 3);\n\t// lossy RC/CR bpf\n\tl0\t\t= 0.3819660112501052;           // ('l0' is 'r2')\n\n\t// prewarp (like BZT but not)\n\tt1 \t\t=  1 / SAMPLERATE;\n\tt2\t\t=  t1 * 0.5;\n\tw2\t\t= (2 / t1) * tanA2((TWOPI * hz) * t2);\n\tg0\t\t=  w2 * t2 * 0.5;               // os here\n\tff\t\t=  g0 / (1 + g0);\t\t\t    // feedforward coefficient\r\n\n\t// single amplifier model\n\tk1\t\t= (k0 * 3.008912) + (ff * 0.03);// self-oscillation @ 3\n\tik1     =  1  /  k1;\n\tg1\t\t=  r2 *  g0;                    // low edge\n\tg2\t\t=  r1 *  g0;                    // high edge\n\tgl\t\t=  1  +  g1;\n\tgh\t\t=  1  +  g2;\n\n\t// coefficients\n\ta1\t\t=  g1 / gl;\t\t\t\t\t\t// g low\n\ta2\t\t=  g2 / gh;\t\t\t\t\t\t// g high\n\tb1\t\t= -l0 / gl;\n\tl1\t\t=  l0 * k1;\n\tl2\t\t=  l1 * a2;\n\tb2\t\t= (l1 - (l1 * a1)) / gh;\n\ta0\t\t=  1  / (1 - l2 + (l2 * a1));\n\n\tng1\t= 0;\n\tif (noiz > 0) {                   \t\t// only compute if required\n\t\tng0\t\t= gaussianNoise(noiz);\n\t\tng1     = ng0 * (k1 + g0) * 0.5;    // os here\n\t//  N.B. - noise injection not required for self-oscillation, just for noise :-)\n\t}\n\n\t// pass 1\n\n\t// 1st lowpass integrator\n\tlp1vn0\t= (x0 - state1) * a1;           // input\n\tlp10\t= lp1vn0 + state1;\n\tstate1\t= lp1vn0 + lp10;\n\thp10\t=  x0 - lp10;\n\n\t// sum feedback\n\thp2fb0\t= state2 * b1;\n\tbp2fb0\t= state0 * b2;\n\tk350\t= hp2fb0 + bp2fb0;\n\n\thp00    = (k350 - lp10) * a0;\n\tbp20    = ((k350 - (state1 * b1)) * a0) * sqrt2;\t    \n\n\t// process nonlinear\n\tu0\t\t= a0 * (hp10 + k350) * k1;      // !! * 'k1'\n\tu0      = aTnhLxAS(u0, load);\n\n\t// 2nd lowpass integrator (loaded lpf)\n\tlp2vn0\t= (u0 - state2) * a1;\t        // !! not 'a2'\n\tlp20\t= lp2vn0 + state2;\n\tstate2\t= lp2vn0 + lp20;\t\t\t\t//\n\thp20\t=  u0 - lp20;\n\n\tYL0\t\t= k1 * lp20;\t\t\t\t\t\t\t\t// Korg 12 dB LP (!! level res dependent)\n\tYH0\t\t= u0 * ik1;\t\t\t\t\t\t\t\t    // Korg 6 dB HP\n\tYF0\t\t= hp20 * ik1;\t\t\t\t\t\t\t    // sort of made up 12 dB HP\n\tYB0     = bp20 * ik1;                               // sort of made up 12 dB BP ?\n\n\t// feedback loop (loaded bpf)\n\tbp2vn0\t= (hp20 - state0) * a2;\t        // !! 'a2'\n\tbp20\t= bp2vn0 + state0;\n\tstate0\t= bp2vn0 + bp20 + ng1;\t        // inject noise at feedback integrator\n\n\t// pass 2\n\n\t// 1st lowpass integrator\n\tlp1vn1\t= (x1 - state1) * a1;           // input\n\tlp11\t= lp1vn1 + state1;\n\tstate1\t= lp1vn1 + lp11;\n\thp11\t=  x1 - lp11;\n\n\t// sum feedback\n\thp2fb1\t= state2 * b1;\n\tbp2fb1\t= state0 * b2;\n\tk351\t= hp2fb1 + bp2fb1;\n\n\thp01    = (k351 - lp11) * a0;\n\tbp21    = ((k351 - (state1 * b1)) * a0) * sqrt2;\t    \n\n\t// process nonlinear\n\tu1\t\t= a0 * (hp11 + k351) * k1;      // !! * 'k1'\n\tu1      = aTnhLxAS(u1, load);\n\n\t// 2nd lowpass integrator (loaded lpf)\n\tlp2vn1\t= (u1 - state2) * a1;\t        // !! not 'a2'\n\tlp21\t= lp2vn1 + state2;\n\tstate2\t= lp2vn1 + lp21;\t\t\t\t//\n\thp21\t=  u1 - lp21;\n\n\tYL1\t\t= k1 * lp21;\t\t\t\t\t\t\t\t// Korg 12 dB LP (!! level res dependent)\n\tYH1\t\t= u1 * ik1;\t\t\t\t\t\t\t\t    // Korg 6 dB HP\n\tYF1\t\t= hp21 * ik1;\t\t\t\t\t\t\t    // sort of made up 12 dB HP\n\tYB1     = bp21 * ik1;                               // sort of made up 12 dB BP ?\n\n\t// feedback loop (loaded bpf)\n\tbp2vn1\t= (hp21 - state0) * a2;\t        // !! 'a2'\n\tbp21\t= bp2vn1 + state0;\n\tstate0\t= bp2vn1 + bp21 + ng1;\t        // inject noise at feedback integrator\n\n\treturn\tdcblock(YL0 * 0.25), dcblock(YL1 * 0.25),\t\t\t\t// 12dB LP x2\n\t\t\t\tdcblock(YH0 * sqrt1_2), dcblock(YH1 * sqrt1_2),\t\t// 6dB HP x2\n\t\t\t\t\tdcblock(YF0 * 0.68), dcblock(YF1 * 0.68),\t\t// 12dB HP x2\n\t\t\t\t\t\tdcblock(YB0 * 0.5), dcblock(YB1 * 0.5);\t    // 12dB BP x2\n}\n\n// fixed 2x quasi oversampling 4-point, 2 processing loops, 4 outputs\n\nSandKtwo_2x4point( XIN, hz, res, load, noiz )\n{\t// up 2\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 2 out1\n\tHistory\tdmT2_10(0), dmT1_10(0), dmT0_10(0);\n\t// down 2 out2\n\tHistory\tdmT2_11(0), dmT1_11(0), dmT0_11(0);\n\t// down 2 out3\n\tHistory\tdmT2_12(0), dmT1_12(0), dmT0_12(0);\n\t// down 2 out4\n\tHistory\tdmT2_13(0), dmT1_13(0), dmT0_13(0);\n\t// align\n\tHistory\tdoX00(0), doX01(0), doX02(0), doX03(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= cubic_hermite_interp(0.5,\tumTm1_0, umT0_0, umT1_0, x0_0_a);\n\tx2_0\t= umT1_0 + 0;\n\n\t// process 2x\n\ty1_00, y2_00, y1_01, y2_01, y1_02, y2_02, y1_03, y2_03\t\r\n        = SandKtwo(x1_0, x2_0, hz, res, load, noiz);\n\n\t// down 2x out1\n\ty2_00_a\t= y2_00 + 0;\n\ty2_10\t= cubic_hermite_interp(0.5,\ty2_00_a,\tdmT0_10, dmT1_10, dmT2_10);\n\n\t// down 2x out2\n\ty2_01_a\t= y2_01 + 0;\n\ty2_11\t= cubic_hermite_interp(0.5,\ty2_01_a,\tdmT0_11, dmT1_11, dmT2_11);\n\n\t// down 2x out3\n\ty2_02_a\t= y2_02 + 0;\n\ty2_12\t= cubic_hermite_interp(0.5,\ty2_02_a,\tdmT0_12, dmT1_12, dmT2_12);\n\n\t// down 2x out4\n\ty2_03_a\t= y2_03 + 0;\n\ty2_13\t= cubic_hermite_interp(0.5,\ty2_03_a,\tdmT0_13, dmT1_13, dmT2_13);\n\n\ty0_00\t= (doX00 + y2_10) * 0.5;\n\ty0_01\t= (doX01 + y2_11) * 0.5;\n\ty0_02\t= (doX02 + y2_12) * 0.5;\n\ty0_03\t= (doX03 + y2_13) * 0.5;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX00\t= y1_00;\n\tdoX01\t= y1_01;\n\tdoX02\t= y1_02;\n\tdoX03\t= y1_03;\n\n\tdmT2_10\t= dmT1_10;\n\tdmT1_10\t= dmT0_10;\n\tdmT0_10\t= y2_00;\n\n\tdmT2_11\t= dmT1_11;\n\tdmT1_11\t= dmT0_11;\n\tdmT0_11\t= y2_01;\n\n\tdmT2_12\t= dmT1_12;\n\tdmT1_12\t= dmT0_12;\n\tdmT0_12\t= y2_02;\n\n\tdmT2_13\t= dmT1_13;\n\tdmT1_13\t= dmT0_13;\n\tdmT0_13\t= y2_03;\n\n\treturn y0_00, y0_01, y0_02, y0_03;\n}\n\nParam   load(1.333333333333, min=0.25, max=4);\t\t\t// do not change\nParam   oversample(0, min=0, max=1);                    // default 1x\n\n// amplitude level of noise in filter, 0..1 remapped 0.. 10% of gaussian level\nParam\tnoiselevel(0.05, min=0, max=1); // default 0.05 = gaussian level of 0.000008\nnoiz\t= (noiselevel * noiselevel * noiselevel) * 0.064038820320221;\n\nos      = int(oversample);\n\n// parse\n\nX\t= in1;\nhz\t= clamp(in2, 1.07, 14988);          // hz\nres\t= clamp(in3, 0.000003, 1.12000001);\n\n// 'Korg 35' single-amplifier Sallen-Key filter\nif (os) {\n    // 2x slightly limits resonance for high frequencies, not as useful for highpasses\n    out1, out2, out3, out4  = SandKtwo_2x4point(X, hz, res, load, noiz);\n}\nelse {\n    // default 1x\n    out1, out2, out3, out4  = SandKone(X, hz, res, load, noiz);\n}\n\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
