                    "text": "in 2 (signal/float) Cutoff in Hz or Pitch"
                }
            },
            {
                "box": {
                    "code": "//\r\n// Transistor Ladder by Teemu Voipio\r\n// mods by Pete for evieve\r\n// Pete: this is tuned to be quite 'hot' and aggressive compared to \"evi_ladder_moog.gendsp\".\r\n// @see: evi_ladder_moog.gendsp & evi_ladder_poles.gendsp for alternative ladder emulations\r\n// and @see: evi_ladder_diode.gendsp for a diode ladder emulation\n\r\n// @see: https://www.kvraudio.com/forum/viewtopic.php?t=349859\r\n// (^^ that is the legendary kvr thread where there is lots of useful stuff,\r\n// as well as lots of annoying men with feelings)\r\n\r\n//// LICENSE TERMS: Copyright 2012 Teemu Voipio\n// \n// You can use this however you like for pretty much any purpose,\n// as long as you don't claim you wrote it. There is no warranty.\n//\n// Distribution of substantial portions of this code in source form\n// must include this copyright notice and list of conditions.\n//\n\r\nrequire(\"evi_tanh.genexpr\");\r\nrequire(\"evi_interp.genexpr\");\r\n\r\n// wrap atanA with boost/cut & x div x\r\natanAdA(x, d)\t// d must be clipped maximum(d, 1)\r\n{\n\treturn atanA(x * d) * (maximum((1 / atanA(d)), 0.1)) / x;\n}\n\r\ndenominator(f, t)\r\n{\r\n\treturn 1 / (1 + f*t);\r\n}\r\n\n// cutoff as frequency in Hz (0..nyquist)\n// resonance 0..1.., self-oscillates over 0.9 ('4')\ntransistorLadder1(inX, cutoff, resonance)\n{\n\t// input delay and state\n\tHistory zi(0);\n\tHistory s0(0), s1(0), s2(0), s3(0);\r\n\n\t// tuning and feedback (this mess is by pete)\r\n\tfo = 0.977377;\r\n\tro = 0.063846;\r\n\trt = maximum(resonance, 1) - 1;\r\n\tr2 = rt*rt;\r\n\tt  = 1 + (sqrt(sqrt(r2)) * ro);\n\tfg = tanA2(PI * cutoff * fo / samplerate * t);\r\n\tf  = fg + fg*fg*ro * r2*ro;\r\n\tff = f+f*1.189988;\n\tr  = 4.444444444444 * resonance;\t\t// mystran's overshoot, pete: i like it\r\n\tp  = 1.141;\r\n\tsk = 0.906329;\r\n\n\t// input with half delay for nonlinearities <<-- this is mystran's clever bit\n\tih = 0.5 * (inX + zi);\n\tzi = inX;\n\n\t// evaluate the nonlinear gains\r\n\tir = ih - r*s3;\n//\tt0 = atanAdA(ir, p);\n\tt0 = atanA(ir*sk) / ir;\t\t\t\t\t// pete: atan\n\tt1 = tanhXdX(s0);\n\tt2 = tanhXdX(s1);\n\tt3 = tanhXdX(s2);\n\tt4 = tanhL(s3) / (tanhL(s3) * p);\t\t// pete: this is emulation-wrong, but i like it\r\n\n\t// g# the denominators for solutions of individual stages\n\tg0 = denominator(f, t1);\n\tg1 = denominator(f, t2);\n\tg2 = denominator(f, t3);\n\tg3 = denominator(f, t4);\r\n\n\t// f# are factored out of the feedback solution below\n\tf3 = f*t3*g3;\n\tf2 = f*t2*g2*f3;\n\tf1 = f*t1*g1*f2;\n\tf0 = f*t0*g0*f1;\n\n\t// feedback solver\n\ty3 = (g3*s3 + f3*g2*s2 + f2*g1*s1 + f1*g0*s0 + f0*inX) / (1 + r*f0);\n\n\t// solve the remaining g & s here (with the nonlinear gains)\n\txx = t0*(inX - r*p*y3);\n\ty0 = t1*g0*(s0 + f*xx);\n\ty1 = t2*g1*(s1 + f*y0);\n\ty2 = t3*g2*(s2 + f*y1);\n\n\t// update state\n\ts0 += ff * (sk*xx - y0);\n\ts1 += ff * (y0 - y1);\n\ts2 += ff * (y1 - y2);\n\ts3 += ff * (p*y2 - t4*y3);\n\n\treturn dcblock(y3*p);\n}\r\n\r\ntransistorLadder2(inX0, inX1, cutoff, resonance)\n{\n\t// input delay and state\n\tHistory zi(0), zj(0);\n\tHistory s0(0), s1(0), s2(0), s3(0);\r\n\n\t// tuning and feedback (this mess is by pete)\r\n\tfo = 0.977377;\r\n\tro = 0.063846;\r\n\trt = maximum(resonance, 1) - 1;\r\n\tr2 = rt*rt;\r\n\tt  = 1 + (sqrt(sqrt(r2)) * ro);\n\tfg = tanA2(PI * cutoff * fo / samplerate * t) * 0.5; // for 2x\r\n\tf  = fg + fg*fg*ro * r2*ro;\r\n\tff = f+f*1.189988;\n\tr  = 4.444444444444 * resonance;\r\n\tp  = 1.141;\r\n\tsk = 0.906329;\r\n\r\n    // pass 1\r\n\n\t// input with half delay for nonlinearities\n\tih0 = 0.5 * (inX0 + zi);\n\tzi = inX0;\n\n\t// evaluate the nonlinear gains\r\n\tir0 = ih0 - r*s3;\n\tt00 = atanA(ir0*sk) / ir0;\n\tt10 = tanhXdX(s0);\n\tt20 = tanhXdX(s1);\n\tt30 = tanhXdX(s2);\n\tt40 = tanhL(s3) / (tanhL(s3) * p);\r\n\n\t// g# the denominators for solutions of individual stages\n\tg00 = denominator(f, t10);\n\tg10 = denominator(f, t20);\n\tg20 = denominator(f, t30);\n\tg30 = denominator(f, t40);\r\n\n\t// f# are factored out of the feedback solution below\n\tf30 = f*t30*g30;\n\tf20 = f*t20*g20*f30;\n\tf10 = f*t10*g10*f20;\n\tf00 = f*t00*g00*f10;\n\n\t// feedback solver\n\ty30 = (g30*s3 + f30*g20*s2 + f20*g10*s1 + f10*g00*s0 + f00*inX0) / (1 + r*f00);\n\n\t// solve the remaining g & s here (with the nonlinear gains)\n\txx0 = t00*(inX0 - r*p*y30);\n\ty00 = t10*g00*(s0 + f*xx0);\n\ty10 = t20*g10*(s1 + f*y00);\n\ty20 = t30*g20*(s2 + f*y10);\n\n\t// update state\n\ts0 += ff * (sk*xx0 - y00);\n\ts1 += ff * (y00 - y10);\n\ts2 += ff * (y10 - y20);\n\ts3 += ff * (p*y20 - t40*y30);\n\r\n    // pass 2\r\n\r\n\t// input with half delay for nonlinearities\n\tih1 = 0.5 * (inX1 + zj);\n\tzj = inX1;\n\n\t// evaluate the nonlinear gains\r\n\tir1 = ih1 - r*s3;\n\tt01 = atanA(ir1*sk) / ir1;\n\tt11 = tanhXdX(s0);\n\tt21 = tanhXdX(s1);\n\tt31 = tanhXdX(s2);\n\tt41 = tanhL(s3) / (tanhL(s3) * p);\r\n\n\t// g# the denominators for solutions of individual stages\n\tg01 = denominator(f, t11);\n\tg11 = denominator(f, t21);\n\tg21 = denominator(f, t31);\n\tg31 = denominator(f, t41);\r\n\n\t// f# are factored out of the feedback solution below\n\tf31 = f*t31*g31;\n\tf21 = f*t21*g21*f31;\n\tf11 = f*t11*g11*f21;\n\tf01 = f*t01*g01*f11;\n\n\t// feedback solver\n\ty31 = (g31*s3 + f31*g21*s2 + f21*g11*s1 + f11*g01*s0 + f01*inX1) / (1 + r*f01);\n\n\t// solve the remaining g & s here (with the nonlinear gains)\n\txx1 = t01*(inX1 - r*p*y31);\n\ty01 = t11*g01*(s0 + f*xx1);\n\ty11 = t21*g11*(s1 + f*y01);\n\ty21 = t31*g21*(s2 + f*y11);\n\n\t// update state\n\ts0 += ff * (sk*xx1 - y01);\n\ts1 += ff * (y01 - y11);\n\ts2 += ff * (y11 - y21);\n\ts3 += ff * (p*y21 - t41*y31);\r\n\n\treturn dcblock(y30*p), dcblock(y31*p);\n}\r\n\r\n// fixed 2x quasi oversampling (hermite6)\ntransistorLadder2_2x6( XIN, hz, res )\n{\t// up 2\n\tHistory\tumTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory\tdmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= hermite_sixpoint_interp(0.5,\tumTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0\t= umT2_0 + 0;\n\n\t// process 2x\r\n    y1_0, y2_0 = transistorLadder2(x1_0, x2_0, hz, res);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= hermite_sixpoint_interp(0.5,\ty2_0_a,\tdmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0\t= umTm1_0;\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0 \t= umT2_0;\n\tumT2_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT3_1\t= dmT2_1;\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= dmTm1_1;\n\tdmTm1_1\t= y2_0;\n\n\treturn dcblock(y0_0);\n}\r\n\r\n// fixed 2x quasi oversampling (cubic4)\ntransistorLadder2_2x4( XIN, hz, res )\n{\t// up 2\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 2\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= cubic_hermite_interp(0.5,\tumTm1_0, umT0_0, umT1_0, x0_0_a);\n\tx2_0\t= umT1_0 + 0;\n\n\t// process 2x\n\ty1_0, y2_0\t= transistorLadder2(x1_0, x2_0, hz, res);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= cubic_hermite_interp(0.5,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\treturn y0_0;\n}\r\n\r\nParam\tcutoffmode(1, min=0, max=1);\t\t// in2 cutoff in: 1 = pitch, 0 = Hz\r\nParam\tcutoffsmooth(10., min=0, max=666);\t// smooth in2 in ms, 0 == off (turn off for FM etc)\r\nParam\tressmooth(20., min=0, max=333);\t\t// smooth in5 in ms, 0 == off\r\nParam\toversample(1, min=0, max=1);\t\t// quasi oversample whole filter\r\nos\t\t= int(oversample);\r\nboost\t= 1.412538;\t\t\t\t\t\t\t// +3dB\r\n\r\nfreq, limit\t= evi_hzpitchmods(in2, in3, in4, mode=cfmode, smooth=cfsmooth, high=0.41);\r\n\t\t\t\t// + oops\r\nres\t\t= clip(in5 + 0.02, 0, 2);\t\t\t// 0..1 is as expected, ..2 still works but...\r\nif (ressmooth > 0) {\t\t\t\t\t\t// ...lose a little tuning accuracy above 2kHz\r\n\tres\t= evi_expsmooth(res, ressmooth);\r\n}\r\n\r\nif (os) {\r\n\tout1 = transistorLadder2_2x4(in1, freq, res) * boost;\r\n} else {\r\n\tout1 = transistorLadder1(in1, freq, res) * boost;\n}\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 5,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 795.0, 796.0 ]
                }
