                    "patching_rect": [ 34.0, 807.0, 63.0, 22.0 ],
                    "text": "out 1 LPG"
                }
            },
            {
                "box": {
                    "fontname": "Arial",
                    "fontsize": 12.0,
                    "id": "obj-11",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 818.0, 19.0, 177.0, 22.0 ],
                    "text": "in 3 Resonance 0..2 @default 1"
                }
            },
            {
                "box": {
                    "code": "\r\n// Circuit modelled emulation of the Buchla Lowpass-Gate, unique version of a two-pole Sallen & Key filter,\r\n// based on \"A Digital Model of the Buchla Lowpass-Gate\" by Julian Parker and Stefano D’Angelo, 2013\r\n// @see: http://research.spa.aalto.fi/publications/papers/dafx13-lpg/DAFx2013-LPG.pdf\r\n\r\n/*\r\n\tIdeally this should all be oversampled properly, and the only native way we have of doing\r\n\tthat in Max is [poly~]. The best way to achieve the pure whistling resonance sound is\r\n\toversampling by 8 times when using the specific resampling filters of [poly~]. However,\r\n    one can use this \"evi_lpg_buchla.gendsp\" without [poly~] oversampling in gen~ or GenExpr\r\n    alone and with reasonable quality antialiased sound using the \"localResampling()\" function\r\n    in this .gendsp code - it gets us very close to that VA Buchla resonance sound.\r\n*/\r\n\r\nrequire(\"evi_buchla.genexpr\");  // filters etc in here\r\n\r\n// quasi resampling options are for when NOT using an external poly~ (not as good but pretty good)\r\nlocalResampling(xin, freq, res, resistors, vca, lpg, nl, resample)\r\n{\r\n\tbuchla = 0;\r\n    bbp, bhp = 0; // (1x only)\r\n\tif (resample == 1) {\t\t// 2x\r\n\t\tbuchla = buchlaLpg2_2x(xin, freq, res, resistors, vca, lpg, nl);\r\n\t} else if (resample == 2) {\t// 3x\r\n\t\tbuchla = buchlaLpg3_3x(xin, freq, res, resistors, vca, lpg, nl);\r\n\t} else if (resample == 3) {\t// 4x, or greater advised for use in gen~ only, default\r\n\t\tbuchla = buchlaLpg4_4x(xin, freq, res, resistors, vca, lpg, nl);\r\n\t} else if (resample == 4) {\t// 6x\r\n\t\tbuchla = buchlaLpg6_6x(xin, freq, res, resistors, vca, lpg, nl);\r\n\t} else if (resample == 5) {\t// 8x\r\n\t\tbuchla = buchlaLpg8_8x(xin, freq, res, resistors, vca, lpg, nl);\r\n\t} else {// resample == 0, 1x, should use this if using the [poly~] wrapper\r\n\t\tbuchla, bbp, bhp = buchlaLpg1(xin, freq, res, resistors, vca, lpg, nl);\r\n\t}\r\n\treturn buchla, bbp, bhp;\r\n}\r\n\r\n// if \"control*\" == 0 use audio inlets, if == 1 use parameter rate messages\r\nParam\tcontrolrf(0, min=0, max=1);\r\nParam\tcontrolres(0, min=0, max=1);\r\n// only if \"controlrf\" == 1 :\r\nParam\trf(0., min=0, max=1000000);\r\n// only if \"controlres\" == 1 :\r\nParam\tresonance(1., min=0, max=2);\r\n\r\n// use if NOT resampling in poly~\r\nParam\tlocalresample(3, min=0, max=5);\t// 0 = 1x, 1 = 2x, 2 = 3x, 3 = 4x, 4 = 6x, 5 = 8x\r\nParam\tnonlin(1, min=0, max=2);\t\t// 0 = linear (1x & 2x only), 0/1 = tanh (default), 2 = cubic\r\n// you will almost never want \"rfsmooth\" to be on, especially if driving from \"evi_controlcircuit_buchla.gendsp\"\r\nParam\trfsmooth(0., min=0, max=666);\t// ms, if 0, rf smoothing off (switch off for audio rate modulation etc)\r\nParam\trfhz(4., min=0.001, max=19.2);\t// hz\r\nParam\tsmooth(15.111, min=0, max=333);\t// ms, if 0, vca/res smoothing off (switch off for audio rate modulation etc)\r\n\r\nParam\tvca(0., min=0, max=1);          // switch or variable, smoothed below\r\nParam\tboom(0., min=0, max=1);\t\t\t// xfade extra feedback resistors, smoothed below\r\nParam\tlpg(1., min=0, max=1);\t\t\t// flag, switch filter/lpg - can be switched clicklessly in real time\r\n\t\t\t\t\t\t\t\t\t\t// (conceived as a switch, but works continuously variable like the \"vca\", too)\r\nover\t= int(localresample);\r\nctrlrf\t= int(controlrf);\r\nctrlres\t= int(controlres);\r\nnl\t\t= int(nonlin);\r\n\r\nsmoothsecs\t= smooth*0.001;\r\nsmoothsamps\t= 0.0333*samplerate;\r\n\r\nfreq = ctrlrf ? rf : in2;\t\t\t\t// use param messages if \"controlrate\" == 1 ...\r\nres = ctrlres ? resonance : in3;\r\n\r\nfreq = maximum(freq, 0);\t\t\t\t// voltage not \"freq\" (can be very high numbers)\r\nres = maximum(res, 0);\t\t\t\t\t// resonance 0..2..\r\n//damp = evi_log2sqrt01(vca);\r\ndamp = vca*vca;                         // vca 0..1 (affectionately referred to as a \"Damp\" control)\r\n\r\nif (smooth > 0) {\r\n\tdamp    = logsmooth(damp, smoothsecs);\r\n}\r\n\r\nif (smooth > 0 && ctrlres) {\r\n\tres     = logsmooth(res, smoothsecs);\r\n}\r\n\r\nif (rfsmooth > 0) {\r\n\tfreq\t= cfSmoothLinear(freq, rfhz, rfsmooth);\r\n}\r\n\r\n// make gate/lpg switching real time capable\r\nslpg, nlpg\t= eviSline(lpg, smoothsamps);\r\nresistors\t= eviLine(boom * lpg, smoothsamps);  // boom is off if not \"lpg\" mode\r\n\r\nylp, ybp, yhp   = localResampling(in1, freq, res, resistors, damp, slpg, nl, over);\r\n\r\nout1\t = ylp;\r\nout2\t = ybp; // zero if \"localresample\" > 0 ...\r\nout3\t = yhp;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-10",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 3,
                    "outlettype": [ "", "", "" ],
                    "patching_rect": [ 34.0, 58.0, 961.0, 732.0 ]
                }
            },
