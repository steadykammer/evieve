                }
            },
            {
                "box": {
                    "code": "\r\n// This Korg filter sits inbetween the more broken \"evi_korgms10\" and\r\n// the more stable \"evi_korgms20_select\". It is aggressive but predictable.\r\n\r\n// Korg OTA dual-amplifier modified Sallen-Key topology filter.\r\n// The 'KLM' OTA chip was found in the later MS-20s & other Korg synthesisers - it is\r\n// different to the earlier 'Korg 35' single-amplifier unbuffered Korg chip found in the\r\n// earlier MS-20s & MS-10 and also in the 'monotron' series.\r\n// For 'Korg 35' chip 'emulation' @see: \"evi_korgms10.gendsp\". For a smoother\r\n// 'Korg OTA' filter @see: \"evi_korgms20_select\". Thanks to Will Pirkle.\r\n\r\nrequire(\"evi_tanh.genexpr\");\r\n\r\nHistory\tstate0(0), state1(0), state2(0);\t\t\t\t\t// S&K state initialise\r\n\r\n// do not change\r\nParam   load(1.333333333333, min=0.5, max=2);\r\n\r\nX\t    = in1;\r\nhz\t    = in2;\t        // hz\r\nk1\t    = in3 + in3;\t// 0..1 .. 0..2\r\n\r\n// prewarp to alpha/beta\r\ng\t\t=  tanA2(hz * PI / SAMPLERATE);\t\t\t\t\t\t// hz to norm\r\noneg\t=  1 + g;\t\t\t\t\t\t\t\t\t\t\t// divisor\r\nalphas\t=  g / oneg;\t\t\t\t\t\t\t\t\t\t// G (feedforward)\r\nbetalp\t= (k1 - (k1 * alphas)) / oneg;\t\t\t\t\t\t// feedback...\r\nbetahp\t= -1 / oneg;\t\t\t\t\t\t\t\t\t\t// ...\r\nalpha0\t=  1 / (1 - (k1 * alphas) + (k1 * alphas * alphas));// u scalar value\r\nk2\t\t= (1 / k1);\r\n\r\n// 1st lowpass integrator\r\nlp1vn\t= (X - state1) * alphas;\r\nlp1\t\t= lp1vn + state1;\r\nstate1\t= lp1vn + lp1;\r\n\r\n// make s35 from feedbacks\r\nhp1fb\t= state0 * betahp;\r\nlp2fb\t= state2 * betalp;\r\ns35\t\t= hp1fb + lp2fb;\r\n\r\n// create nonlinear s35\r\nu\t\t= alpha0 * (lp1 + s35);\r\nu\t\t= tanhLxA((u * load), load);\r\n\r\n// 2nd lowpass integrator\r\nlp2vn\t= (u - state2) * alphas;\r\nlp2\t\t= lp2vn + state2;\r\nstate2\t= lp2vn + lp2;\r\n\r\nY\t\t= k1 * lp2;\r\n\r\n// highpass feedback loop\r\nhp1vn\t= (Y - state0) * alphas;\r\nbp1\t\t= hp1vn + state0;\r\nstate0\t= hp1vn + bp1;\r\nhp1\t\t= Y - bp1;\t\t// 6 dB HP\r\n\r\nLP\t\t= Y * k2;\t\t// 12 dB LP\r\n\r\nout1\t= dcblock(LP) * 0.944061;\r\nout2\t= dcblock(hp1) * 0.901571;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 49.0, 58.0, 775.0, 732.0 ]
                }
            },
