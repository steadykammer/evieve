                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 323.0, 20.0, 267.0, 22.0 ],
                    "text": "in 2 (signal/float) Cutoff Frequency in Hz @min 1"
                }
            },
            {
                "box": {
                    "code": "\n// This Korg filter sits inbetween the more broken \"evi_korgms10\" and\n// the more stable \"evi_korgms20_select\". It is aggressive but predictable.\n\n// Korg OTA dual-amplifier modified Sallen-Key topology filter.\n// The 'KLM' OTA chip was found in the later MS-20s & other Korg synthesisers - it is\n// different to the earlier 'Korg 35' single-amplifier unbuffered Korg chip found in the\n// earlier MS-20s & MS-10 and also in the 'monotron' series.\n// For 'Korg 35' chip 'emulation' @see: \"evi_korgms10.gendsp\". For a smoother\n// 'Korg OTA' filter @see: \"evi_korgms20_select\". Thanks to Will Pirkle.\n\nrequire(\"evi_tanh.genexpr\");\nrequire(\"evi_interp.genexpr\");\n\n// filter 1x\nSandKone(X, hz, res, load)\n{\n    History\tstate0(0), state1(0), state2(0);\t\t\t\t\t// S&K state initialise\n    k1\t    = res + res;\t// 0..1 .. 0..2\n\n    // prewarp to alpha/beta\n    g\t\t=  tanA2(hz * PI / SAMPLERATE);\t\t\t\t\t    // hz to norm\n    oneg\t=  1 + g;\t\t\t\t\t\t\t\t\t\t\t// divisor\n    alphas\t=  g / oneg;\t\t\t\t\t\t\t\t\t\t// G (feedforward)\n    betalp\t= (k1 - (k1 * alphas)) / oneg;\t\t\t\t\t\t// feedback...\n    betahp\t= -1 / oneg;\t\t\t\t\t\t\t\t\t\t// ...\n    alpha0\t=  1 / (1 - (k1 * alphas) + (k1 * alphas * alphas));// u scalar value\n    k2\t\t= (1 / k1);\n\n    // 1st lowpass integrator\n    lp1vn\t= (X - state1) * alphas;\n    lp1\t\t= lp1vn + state1;\n    state1\t= lp1vn + lp1;\n\n    // make s35 from feedbacks\n    hp1fb\t= state0 * betahp;\n    lp2fb\t= state2 * betalp;\n    s35\t\t= hp1fb + lp2fb;\n\n    // create nonlinear s35\n    u\t\t= alpha0 * (lp1 + s35);\n    u\t\t= tanhLxA((u * load), load);\n\n    // 2nd lowpass integrator\n    lp2vn\t= (u - state2) * alphas;\n    lp2\t\t= lp2vn + state2;\n    state2\t= lp2vn + lp2;\n\n    Y\t\t= k1 * lp2;\n\n    // highpass feedback loop\n    hp1vn\t= (Y - state0) * alphas;\n    bp1\t\t= hp1vn + state0;\n    state0\t= hp1vn + bp1;\n    hp1\t\t= Y - bp1;\t\t// 6 dB HP\n\n    LP\t\t= Y * k2;\t\t// 12 dB LP\n\n    return  dcblock(LP) * 0.944061, dcblock(hp1) * 0.901571;    // 12dB LP, 6dB HP\n}\n\n// filter 2x\nSandKtwo(X0, X1, hz, res, load)\n{\n    History\tstate0(0), state1(0), state2(0);\t\t\t\t\t// S&K state initialise\n    k1\t    = res + res;\t// 0..1 .. 0..2\n\n    // prewarp to alpha/beta\n    g\t\t=  tanA2(hz * PI / SAMPLERATE) * 0.5;\t\t\t    // hz to norm, os\n    oneg\t=  1 + g;\t\t\t\t\t\t\t\t\t\t\t// divisor\n    alphas\t=  g / oneg;\t\t\t\t\t\t\t\t\t\t// G (feedforward)\n    betalp\t= (k1 - (k1 * alphas)) / oneg;\t\t\t\t\t\t// feedback...\n    betahp\t= -1 / oneg;\t\t\t\t\t\t\t\t\t\t// ...\n    alpha0\t=  1 / (1 - (k1 * alphas) + (k1 * alphas * alphas));// u scalar value\n    k2\t\t= (1 / k1);\n\n    // pass 1\n\n    // 1st lowpass integrator\n    lp1vn0\t= (X0 - state1) * alphas;\n    lp10\t= lp1vn0 + state1;\n    state1\t= lp1vn0 + lp10;\n\n    // make s35 from feedbacks\n    hp1fb0\t= state0 * betahp;\n    lp2fb0\t= state2 * betalp;\n    s350\t= hp1fb0 + lp2fb0;\n\n    // create nonlinear s35\n    u0\t\t= alpha0 * (lp10 + s350);\n    u0\t\t= tanhLxA((u0 * load), load);\n\n    // 2nd lowpass integrator\n    lp2vn0\t= (u0 - state2) * alphas;\n    lp20\t= lp2vn0 + state2;\n    state2\t= lp2vn0 + lp20;\n\n    Y0\t\t= k1 * lp20;\n\n    // highpass feedback loop\n    hp1vn0\t= (Y0 - state0) * alphas;\n    bp10\t= hp1vn0 + state0;\n    state0\t= hp1vn0 + bp10;\n    hp10\t= Y0 - bp10;\t// 6 dB HP\n\n    LP0\t\t= Y0 * k2;\t\t// 12 dB LP\n\n    // pass 2\n\n    // 1st lowpass integrator\n    lp1vn1\t= (X1 - state1) * alphas;\n    lp11\t= lp1vn1 + state1;\n    state1\t= lp1vn1 + lp11;\n\n    // make s35 from feedbacks\n    hp1fb1\t= state0 * betahp;\n    lp2fb1\t= state2 * betalp;\n    s351\t= hp1fb1 + lp2fb1;\n\n    // create nonlinear s35\n    u1\t\t= alpha0 * (lp11 + s351);\n    u1\t\t= tanhLxA((u1 * load), load);\n\n    // 2nd lowpass integrator\n    lp2vn1\t= (u1 - state2) * alphas;\n    lp21\t= lp2vn1 + state2;\n    state2\t= lp2vn1 + lp21;\n\n    Y1\t\t= k1 * lp21;\n\n    // highpass feedback loop\n    hp1vn1\t= (Y1 - state0) * alphas;\n    bp11    = hp1vn1 + state0;\n    state0\t= hp1vn1 + bp11;\n    hp11\t= Y1 - bp11;\t// 6 dB HP\n\n    LP1\t\t= Y1 * k2;\t\t// 12 dB LP\n\n    return  dcblock(LP0) * 0.944061, dcblock(LP1) * 0.944061,           // 12dB LP x2\r\n                dcblock(hp10) * 0.901571, dcblock(hp11) * 0.901571;     // 6dB HP x2\n}\n\n// fixed 2x quasi oversampling 4-point, 2 processing loops, 2 outputs\nSandKtwo_2x4point( XIN, hz, res, load )\n{\t// up 2\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 2 out1\n\tHistory\tdmT2_10(0), dmT1_10(0), dmT0_10(0);\n\t// down 2 out2\n\tHistory\tdmT2_11(0), dmT1_11(0), dmT0_11(0);\n\t// align\n\tHistory\tdoX00(0), doX01(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= cubic_hermite_interp(0.5,\tumTm1_0, umT0_0, umT1_0, x0_0_a);\n\tx2_0\t= umT1_0 + 0;\n\n\t// process 2x\n\ty1_00, y2_00, y1_01, y2_01\t= SandKtwo(x1_0, x2_0, hz, res, load);\n\n\t// down 2x out1\n\ty2_00_a\t= y2_00 + 0;\n\ty2_10\t= cubic_hermite_interp(0.5,\ty2_00_a,\tdmT0_10, dmT1_10, dmT2_10);\n\n\t// down 2x out2\n\ty2_01_a\t= y2_01 + 0;\n\ty2_11\t= cubic_hermite_interp(0.5,\ty2_01_a,\tdmT0_11, dmT1_11, dmT2_11);\n\n\ty0_00\t= (doX00 + y2_10) * 0.5;\n\ty0_01\t= (doX01 + y2_11) * 0.5;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX00\t= y1_00;\n\tdoX01\t= y1_01;\n\n\tdmT2_10\t= dmT1_10;\n\tdmT1_10\t= dmT0_10;\n\tdmT0_10\t= y2_00;\n\n\tdmT2_11\t= dmT1_11;\n\tdmT1_11\t= dmT0_11;\n\tdmT0_11\t= y2_01;\n\n\treturn y0_00, y0_01;\n}\n\nParam   load(1.333333333333, min=0.5, max=2);           // do not change\nParam   oversample(0, min=0, max=1);                    // default 1x\nos      = int(oversample);\n\nX\t    = in1;\nhz\t    = in2;\t        // hz\nres\t    = in3;          // 0..1\n\n// TPT Korg OTA filter\nif (os) {\n    // 2x slightly limits resonance for high frequencies, not as useful for highpass\n    out1, out2  = SandKtwo_2x4point(X, hz, res, load);\n}\nelse {\n    // default\n    out1, out2  = SandKone(X, hz, res, load);\n}\n\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 49.0, 58.0, 775.0, 732.0 ]
                }
            },
