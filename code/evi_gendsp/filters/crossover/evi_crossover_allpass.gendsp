                    "patching_rect": [ 429.0, 19.0, 355.0, 22.0 ],
                    "text": "in 2 (signal/float) Allpass Frequency in Hz @min 10 @max 20000"
                }
            },
            {
                "box": {
                    "code": "\r\n// allpass filters used by the evieve crossovers code, so you can allpass-compensate\r\n// your split or mixed-in audio signals using the same filters as the evieve crossovers.\r\n\r\n\r\nrequire(\"evi_crossovers.genexpr\");\r\n\r\nParam   order(0, min=0, max=1); // 0 = 1-pole allpass (default), 1 = 2-pole allpass\r\npoles   = int(order);\r\n\r\nallpass = 0;\r\nif (poles > 0) {\r\n    allpass = eviXoverAllpass2(in1, in2);   // 2-pole compensates 4-pole crossover\r\n} else {\r\n    allpass = eviXoverAllpass1(in1, in2);   // 1-pole compensates 2-pole crossover (default)\r\n}\r\n\r\nout1    = allpass;\r\n\r\n\r\n// Note: for crossovers, including 2- & 3- band-split crossovers,\r\n// @see: \"evi_crossover.gendsp\" / [evi.crossover~]\r\n// @see: \"evi_crossover_3band.gendsp\" / [evi.crossover.3band~]\r\n// @see: \"evi_crossover_sum.gendsp\" / [evi.crossover.sum~]\r\n// @see: \"evi_cross.gendsp\" / [evi.cross~]\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 735.0, 435.0 ]
                }
            },
            {
