                    "patching_rect": [ 342.0, 13.0, 226.0, 35.0 ],
                    "text": "in 2 (signal/float) Low Crossover Frequency in Hz @min 10 @max 20000"
                }
            },
            {
                "box": {
                    "code": "\r\n// 3-band (low/mid/high) crossovers, 2 or 4 pole slopes\r\n// Linkwitz-Rileys sum perfectly flat\r\n\r\nrequire(\"evi_crossovers.genexpr\");\r\n\r\nParam   align(1, min=0, max=1); // 0 = no allpass alignment, 1 = allpass align in this split? (default)\r\nParam   order(1, min=0, max=1); // 0 = 2-pole xover, 1 = 4-pole xover (default)\r\npoles   = int(order);\r\nap      = int(align);\r\n\r\n// if using \"evi_crossover_sum.gendsp\" / [evi.crossover.sum~] downstream you must turn 'align' off,\r\n// but by default 'align' is on. apparently allpass alignment should come when summing, but\r\n// i am not sure this makes much difference?\r\n\r\nyLow, yMid, yHigh = 0;\r\nif (poles > 0) {\r\n    yLow, yMid, yHigh = eviXover4pole3band(in1, in2, in3);  // 4-pole (default)\r\n    if (ap > 0) {\r\n        yLow    = eviXoverAllpass2(yLow, in3);              // allpass 2 (default)\r\n    }\r\n} else {\r\n    yLow, yMid, yHigh = eviXover2pole3band(in1, in2, in3);  // 2-pole\r\n    if (ap > 0) {\r\n        yLow    = eviXoverAllpass1(yLow, in3);              // allpass 1\r\n    }\r\n}\r\n\r\nout1    = yLow;     // pre or post alignment depending on 'align' attribute\r\nout2    = yMid;\r\nout3    = yHigh;\r\n\r\n// Note: for additional crossovers including 2-band crossovers,\r\n// @see: \"evi_cross.gendsp\" / [evi.cross~] - 4-pole only\r\n// @see: \"evi_crossover.gendsp\" / [evi.crossover~]\r\n// @see: \"evi_crossover_sum.gendsp\" / [evi.crossover.sum~]\r\n// @see: \"evi_crossover_allpass.gendsp\" / [evi.crossover.allpass~]\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 3,
                    "outlettype": [ "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 812.0, 607.0 ]
                }
