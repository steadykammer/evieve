                    "patching_rect": [ 432.0, 19.0, 264.0, 22.0 ],
                    "text": "in 2 (signal/float) Delay Time in samples 1.5..2.5"
                }
            },
            {
                "box": {
                    "code": "\r\n// thirian fractional delay allpass filter\r\n// http://dafx09.como.polimi.it/proceedings/papers/paper_72.pdf\r\n\r\nthirianAcoef(delay)    // delay in samples, should be clipped 1.5..2.5\r\n{\r\n    D  =  clip(delay, 1.5, 2.5);\r\n    a1 = -((D - 2) / (D + 1));\r\n    a2 =  ((D - 1) * (D - 2)) / ((D + 1) * (D + 2));\r\n    return a1, a2;\r\n}\r\n\r\n// \"Delay D is chosen between 1.5 and 2.5 for maximal flatness at DC\"\r\nthirianAllpass(xn, D)\r\n{\r\n    History x0(0), x1(0), y0(0), y1(0);\r\n    a1, a2 = thirianAcoef(D);\r\n    y  = (a1 * x0) + (a2 * xn) + x1 - (a1 * y0) - (a2 * y1);\r\n    x1 = x0;\r\n    y1 = y0;\r\n    x0 = xn;\r\n    y0 = y;\r\n    return y;\r\n}\r\n\r\nout1    = thirianAllpass(in1, in2);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 647.0, 462.0 ]
                }
            },
