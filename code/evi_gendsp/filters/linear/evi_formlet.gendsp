                    "patching_rect": [ 49.0, 50.0, 154.0, 22.0 ],
                    "text": "in 1 (signal) Input (Impulse)"
                }
            },
            {
                "box": {
                    "id": "obj-2",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 657.0, 50.0, 239.0, 22.0 ],
                    "text": "in 2 (signal/float) Filter Frequency in PITCH"
                }
            },
            {
                "box": {
                    "code": "\r\n// this is a direct form filter, so modulation is limited.\r\n// based on SuperCollider 'Formlet()' - GPLv2 - but with extras.\r\n// I made this in 2014 for some Huddersfield friends :-)\r\n\r\nrequire(\"evi_smooth.genexpr\");\r\n\r\n// !! all inputs in pitch !!\r\n// can all be param rate\r\npitch2HzCoeffs(pitch, offset, bandwidth, spread)\r\n{\r\n    twopisr = TWOPI / samplerate;\r\n    minHz = samplerate * 0.00022;\r\n    maxHz = samplerate * 0.458334;\r\n\r\n    decayBandspread = (spread < 0 ? spread : 0) + bandwidth;\t\t// minus filter 2 pitch\r\n\tattackBandspread = (spread > 0 ? spread : 0) + bandwidth;\t\t// plus filter 1 pitch\r\n\r\n\tdecayW0 = (clip((mtofApprox((pitch + offset) + decayBandspread)), minHz, maxHz)) * twopisr;\r\n\tattackW0 = (clip((mtofApprox((pitch + offset) - attackBandspread)), minHz, maxHz)) * twopisr;\r\n\r\n    return  attackW0, decayW0;\r\n}\r\n\r\n// calculate resonant direct form b-coefficients\r\n// frequency in post warped normalised value, ringTime is -60dB ring time in seconds\r\nringCoefs(w0, ringTime)\r\n{\r\n    LOGTH   = -6.907755278982137;       // ln(0.001) = -60dB\n\tR       = maximum(expA(LOGTH / (ringTime * samplerate)), 0);\n\tR2      = R + R;\n\tRR      = R * R;\n\tcosT    = (R2 * cos73(w0)) / (1 + RR);\n\treturn  (R2 * cosT), -RR;\t\t\t// return two feedback coefficients b1 & b2\r\n}\r\n\r\n// attackTime / decayTime are -60dB ring times in seconds\r\n// attackW0 / decayW0 in post warped normalised values\r\n// loosely based on SuperCollider 'Formlet()'\nformletD(xin, attackW0, decayW0, attackTime, decayTime)\r\n{\n\tHistory y1(0), y2(0), y11(0), y22(0);\n\r\n\t// get ringCoefs()\n\tb1, b2 = ringCoefs(attackW0, attackTime);\n\tb11, b22 = ringCoefs(decayW0, decayTime);\n\r\n\t// filter2, filter1\n\ty00 = xin + b11 * y11 + b22 * y22;\r\n\ty0 = xin + b1 * y1 + b2 * y2;\n \tfofilt = 0.25 * ((y00 - y22) - (y0 - y2));  // reduce\r\n\r\n\t// update\r\n\ty22 = y11;\n\ty11 = y00;\r\n\ty2 = y1;\r\n\ty1 = y0;\n\r\n\treturn fofilt;\n}\r\n\r\n// optional attack / decay smooth time in milliseconds (not needed in general)\r\nParam smoothtime(0, min=0, max=111);\r\n// optional frequency smooth time in milliseconds\r\nParam smoothfreq(0, min=0, max=666);\r\n\r\n// modulations in semitones\r\nParam offset(0, min=-24, max=24);\t\t// band offset up to ± 2 octaves\r\nParam width(0, min=0, max=24);\t\t\t// band width up to ± 2 octaves\r\nParam spread(0, min=-12, max=12);\t\t// band spread up to ± 1 octave\r\n\r\n// attack / decay are -60dB ring times in milliseconds\r\nParam attack(10, min=10, max=59999);    // must @clip low because direct form\r\nParam decay(100, min=11, max=60000);\r\n\r\n// param rate\r\nAT = attack * 0.001;\r\nDT = decay * 0.001;\r\n\r\n// potentially param rate\r\nattackW0, decayW0 = pitch2HzCoeffs(in2, offset, width, spread);\r\n\r\n// audio rate\r\n\r\nif (smoothfreq > 0) {\r\n    attackW0, decayW0 = logsmoothBank2(attackW0, decayW0, smoothfreq*0.001);\r\n}\r\n\r\nif (smoothtime > 0) {\r\n    AT, DT = expsmoothBank2(AT, DT, smoothtime*0.001);\r\n}\r\n\r\nX = dcblock(in1);\r\nformletFilter = formletD(X, attackW0, decayW0, AT, DT);\r\nout1 = dcblock(formletFilter);\r\n\r\n/*\r\nIf attack time == decay time (and there are no pitch offsets) then\r\nthe signal cancels out, and if attack time > decay time then the impulse\r\nresponse is inverted.\r\n\r\nIf spread & width == 0 then filter acts like a normal formlet filter.\r\nIf offset == 0 then frequency is as input.\r\n*/\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 120.0, 847.0, 670.0 ]
                }
            },
            {
                "box": {
                    "id": "obj-4",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 49.0, 807.0, 161.0, 22.0 ],
                    "text": "out 1 (signal) Formlet Output"
                }
            },
            {
                "box": {
                    "id": "obj-6",
                    "linecount": 8,
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 205.0, 4.0, 451.0, 114.0 ],
                    "text": "// modulations in semitones\nParam offset(0, min=-24, max=24);        // band offset up to ± 2 octaves\nParam width(0, min=0, max=24);            // band width up to ± 2 octaves\nParam spread(0, min=-12, max=12);        // band spread up to ± 1 octave\n\n// attack / decay are -60dB ring times in milliseconds\nParam attack(10, min=10, max=60000);\nParam decay(100, min=10, max=60000);"
                }
            }
        ],
