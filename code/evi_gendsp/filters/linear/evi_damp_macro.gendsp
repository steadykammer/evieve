        "integercoordinates": 1,
        "boxes": [
            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 19.0, 134.0, 22.0 ],
                    "text": "in 1 (signal) Audio Input"
                }
            },
            {
                "box": {
                    "code": "\r\n// a 'one knob' (\"damp\" parameter) macroisation for quick onepole damping filters\r\n// useful for light damping or inside a feedback loop\r\n// @see: \"evi_damp.gendsp\" / [evi.damp~] for more control\r\n// @see: \"evi_onepole_shelving.gendsp\" / [evi.onepole.shelving~] for cut/boost\r\n// @see: \"evi_tone_macro.gendsp\" / [evi.tone.macro~] for the opposite\r\n\r\nrequire(\"evi_rcfilters.genexpr\");\r\nrequire(\"evi_smooth.genexpr\");\r\n\r\n// param rate\r\n\r\nParam   damp(0., min=0, max=1);\r\nParam   smooth(0., min=0, max=999);\r\n\r\n// cheapo macroisation, surprisingly it works, is even accross 0..1 range\r\n\r\nsqdamp = sqrt(damp);\r\ndampHzLpHs = ((1 - sqdamp) * 17000) + 1000;\r\ndampHzHpLs = ((damp * damp) * 390) + 10;\r\ng1, d1 = rcDampCoeffs0(dampHzLpHs, sqdamp);\r\ng2, d2 = rcDampCoeffs0(dampHzHpLs, sqrt(sqdamp));\r\n\r\nglp = g1; ghp = g2; lk = d1; hk = d2;\r\n\r\n// audio rate\r\n\r\nif (smooth > 0) {\r\n    glp, lk, ghp, hk = expsmoothBank4(glp, lk, ghp, hk, smooth*0.001);\r\n}\r\n\r\nout1 = rcFilterDampBandpass(in1, glp, ghp, lk, hk);\r\n\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 687.0, 537.0 ]
                }
            },
            {
                "box": {
                    "id": "obj-4",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 49.0, 612.0, 199.0, 22.0 ],
                    "text": "out 1 (signal) Damped Audio Output"
                }
            }
        ],
        "lines": [
