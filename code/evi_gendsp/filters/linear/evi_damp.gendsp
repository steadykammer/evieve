            {
                "box": {
                    "id": "obj-2",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 208.0, 19.0, 354.0, 22.0 ],
                    "text": "in 2 (signal/float) Frequency in Hz @min 1 @max samplerate*0.5"
                }
            },
            {
                "box": {
                    "code": "\r\n// onepole damping filter using trapezoidal integration, simultaneous outputs, very smooth and very cheap,\r\n// useful for damping in reverbs and other situations.\r\n// frequency input in Hz, shelving input (damp) is linear 0..1, optional smoothing attributes are default off.\r\n\r\n// @see: \"evi_onepole.gendsp\" / [evi.onepole~] for linear onepoles.\r\n// @see: \"evi_onepole_shelving.gendsp\" / [evi.onepole.shelving~] for onepole shelving.\r\n// @see: \"evi_filter_shelving.gendsp\" / [evi.filter.shelving~] etc for twopoles.\r\n\r\nrequire(\"evi_rcfilters.genexpr\");\r\n\r\n\r\nParam   smoothfreq(0., min=0, max=333);     // ms\r\nParam   smoothdamp(0., min=0, max=333);     // ms\r\n\r\n// \"Damp\" (in3) input:\r\n// 0 == bypassed, 1 == low or high pass, 0..1 == shelving attenuation\r\n\r\ng, k    = rcDampCoeffs0(in2, in3);          // could just as easily be 'sqrt(in3)'\r\n\r\nif (smoothfreq > 0) {\r\n    g   = evi_logsmooth(g, smoothfreq);\r\n}\r\n\r\nif (smoothdamp > 0) {\r\n    k   = evi_expsmooth(k, smoothdamp);\r\n}\r\n\r\nLpHs, HpLs  = rcFilterDampLpHp(in1, g, k);\r\n\r\nout1    = LpHs;     // lowpass/highshelf    // with damp @ 0.71..0.99 similar to MSP [onepole~] depending on Hz\r\nout2    = HpLs;     // highpass/lowshelf\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 34.0, 58.0, 872.0, 542.0 ]
                }
            },
            {
                "box": {
                    "id": "obj-4",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 34.0, 617.0, 207.0, 22.0 ],
                    "text": "out 1 (signal) 6dB Lowpass/Highshelf"
                }
            }
