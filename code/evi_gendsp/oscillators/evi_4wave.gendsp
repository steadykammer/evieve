            {
                "box": {
                    "code": "\r\nrequire(\"evi_polyblep_four.genexpr\");\r\nrequire(\"evi_polyblep_utility.genexpr\");\r\n\r\ntwoHarm(x)\n{\n    a = 0.006024096385542;\n    b = 0.03125;\n    c = 0.0625;\n    x2 = x * x;\n    y = x - a * x2 - b * x * x2 + c;\n    return dcblock(y);\n}\r\n\r\n// TODO: Hard Sync\r\n\r\nParam   zerosync(0, min=0, max=1);\r\nzero    = int(zerosync);        // match tri phase zero crossings\r\n\r\nreset       = in2;              // naive, do not use\r\nfreqInHz    = maximum(in1, 0);  // no neg freq, sorry\r\n\r\nt\t        = phasor(freqInHz, reset);\r\ndt\t        = freqInHz / SAMPLERATE;\r\n\r\ntt  = t;\r\nif (zero) {\r\n    tt = wrap(t - 0.25, 0, 1);\r\n}\r\n\r\n// simultaneous phase synchronous saw, rect, tri, sine\r\nout1        = decorelateOsc(dcblock(polysaw4(t, dt)));\r\nout2        = decorelateOsc(dcblock(polyrect4(t, dt)));\r\nout3        = decorelateOsc(dcblock(polytri4(tt, dt)));\r\nout4        = twoHarm(sin73b(t * TWOPI) * sqrt1_2);\r\n// phase\r\nout5        = t;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
