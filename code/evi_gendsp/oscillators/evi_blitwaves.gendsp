                }
            },
            {
                "box": {
                    "fontface": 0,
                    "fontname": "Arial",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 466.0, 19.0, 259.0, 22.0 ],
                    "text": "in 2 (signal/float) Pulse Width 0..1 @default 0.5"
                }
            },
            {
                "box": {
                    "code": "\r\n// zero aliasing classic synth wave shapes, dsf-blit-like algo, sweep/modulation works with no noise, & very cheap :-)\r\n// good for subtractive because we stay very bright right up to nyquist, but no hard sync :-(\r\n// by pete for evieve, 2019\r\n\r\n//require(\"evi_biquad.genexpr\");    // these two only needed if editing for options...\r\n//require(\"evi_rcfilters.genexpr\");\r\nrequire(\"evi_smooth.genexpr\");\r\nrequire(\"evi_trig.genexpr\");\r\nrequire(\"evi_adaa.genexpr\");        // for 'sine' only\r\n\r\n// simple integrator\r\n\r\nleaky(x, f)\r\n{\r\n\tHistory\tleak(0);\r\n\ty\t\t= ( (x - leak) * (f * 0.25) ) + leak;\r\n\tleak\t= y;\r\n\treturn\ty;\r\n}\r\n\r\n//\t//\t//\tBLITs\r\n\r\neviSect(T, P, M)\r\n{\t// we get a tiny bit of noise below -100dB with sin73, switch to sin121 if you care about this\r\n\treturn\t(sin73((T + 0.5) * P) * M) - 1;\r\n}\r\n\r\n// deluxe, a lot more expensive, but crossfades out the top harmonic - much nicer\r\neviBlit(Ph, Mt, Mf)\r\n{\r\n\tMp\t\t= 1 / sin121(0.5 * Ph);\t\t\t\t\t\t// must be at least ...121 for accuracy\r\n\tx0\t\t= eviSect((maximum((Mt - 1), 0)), Ph, Mp);\r\n\tx1\t\t= eviSect(Mt, Ph, Mp);\r\n\treturn\tinterp(Mf*Mf, x0, x1, mode=\"cosine\") * 0.5; // cosine but Mf is squared, ridiculous? i like it\r\n}\n\r\n//\t//\t//\r\n\r\nHistory\tthisReset(1);//, Ff(0);\r\n//History\tprevSR(0);\r\nParam\tsmooth(22, min=0, max=333);\t\t\t\t// ms\r\nParam\taddsync(1, min=0, max=2);\t\t\t\t// out6: 0 = off, 1 = main phase output, 2 = pwm phase output\r\nParam\taddtrain(0, min=0, max=2);\t\t\t\t// out5: 0 = off, 1 = train based on main phase, 2 = train based on pwm phase\r\nParam\taddsine(0, min=0, max=1);\t\t\t\t// out4: 0 = SINE off, 1 = SINE on (considerable CPU management)\r\nsmoothsamps = mstosamps(smooth);\r\nLAURA\t= 1.059463094359;\r\nJASON\t= 2.221441469079183;\r\nCPS_LIMIT\t= 0.0001;\r\n\r\nHz\t\t\t= in1;\r\nWidth\t\t= in2;\r\nnaiveReset\t= in3;\t\t\t\t\t\t\t\t// <<-- do not use (does not work properly if freq really high anyway)\r\n/*\r\n// why doesn't this work ?!\r\nsr05 = 0;\r\nsr01 = 0;\r\nsrWN = 0;\r\nomWN = 0;\r\nMaxFreq = 0;\r\nfilterRolloff = 0;\r\n// we only need to update these values if SR changes (& on init)\r\nif (prevSR != SAMPLERATE) {\r\n\tsr05 = SAMPLERATE * 0.5;\r\n\tsr01 = SAMPLERATE * 0.01;\r\n\tMaxFreq\t= sr05 - sr01;\r\n\tsrWN = sr01 / SAMPLERATE;\r\n\tomWN = 1 - (srWN + srWN);\r\n//\tfilterRolloff = rcPreWarp2(MaxFreq);\r\n\tprevSR = SAMPLERATE;\r\n}\r\n*/\r\nsr05 = SAMPLERATE * 0.5;\r\nsr01 = SAMPLERATE * 0.01;\r\nMaxFreq\t= sr05 - sr01;\t\t\t\t\t\t\t// we want it to kick in a bit below nyquist\r\nsrWN = sr01 / SAMPLERATE;\r\nomWN = 1 - (srWN + srWN);\r\n\r\n//filterRolloff = rcPreWarp2(MaxFreq);\r\n\r\n// unlike pure DSF BLIT, we do not have to latch changes as rolloff/etc takes care of this for us\r\n// but if no latching option, we should exact-smooth \"F\" (because trunc/fract) and exact-smooth \"P\" (because center)\r\nF\t\t= maximum(Hz, 0);\t\t\t\t\t\t// Hz\r\nif (smooth > 0) {\r\n\tF\t= eviLine(F, smoothsamps);\r\n}\r\nFf\t\t= maximum(F / SAMPLERATE, CPS_LIMIT);\t// Increment\r\nFn\t\t= Ff * TWOPI;\r\nP\t\t= (Width * omWN) + srWN;\t\t\t\t// 0..1, edges SR dependent\t// NOTE: Width not clipped so wraps around if desired\r\nPp\t\t= P;\t\t\t\t\t\t\t\t\t// Pp = no smoothing\r\nif (smooth > 0) {\r\n\tP\t= eviLine(P, smoothsamps);\r\n}\r\n\r\n//filterZero = rcPreWarp1(76.1268 * Fn);\r\n\r\nM\t\t= abs((P + P) - 1);\t\t\t\t\t\t// maintain energy in TRI, sort of...\r\nWt\t\t= ((M * M * M * M) * 16) + 4;\r\nFa\t\t= 2 - maximum(Fn, 1);\r\n\r\nMFdF\t= MaxFreq / F;\r\nMt\t\t= trunc(MFdF);\r\nMf\t\t= fract(MFdF);\r\n\r\nPhase\t= phasor(F, naiveReset);//naiveReset ? 0 : Phase + Ff;\r\nPhW\t\t= wrap((Phase + P), 0, 1);\r\nPh\t\t= (Phase * TWOPI);\r\nPwm\t\t= (PhW * TWOPI);\r\noutPhase = 0;\r\noutPh\t = latch(int(addsync), thisReset);\r\nif (outPh > 0) {\r\n\toutPhase = (outPh - 1) ? PhW : Phase;\r\n}\r\npeteTrain\t= 0;\r\ntrnPh\t\t= latch(int(addtrain), thisReset);\r\nif (trnPh > 0) {\r\n\tpetePhase\t= (trnPh - 1) ? PhW : Phase;\r\n\tpeteTrain\t= petePhase < latch(Pp, thisReset);\r\n}\r\n\r\nblit_1\t= eviBlit(Ph, Mt, Mf);\r\nblit_2\t= eviBlit(Pwm, Mt, Mf);\r\n\r\nblit_saw\t= dcblock(blit_1);\r\nblit_rect\t= blit_1 - blit_2;\r\n\r\nbottom\t\t= minimum(F, 10) * 0.1;\t// extend down to zero Hz, no DC\r\nthisReset\t= (delta(Phase) < 0) + (Ff <= CPS_LIMIT) + naiveReset;\r\n\r\n// integrate...\r\n\r\n// these are much nicer \"straight lines\" buzzy oscillators, but sadly we get\r\n// the nightmare blit-dc-dropout problem using the direct forms with mul Fn externally\r\n\r\n//SAW\t\t= biquadTdf2(blit_saw, -0.331, 0, 0, -0.999, 0) * Fn;\r\n//RECT\t\t= biquadTdf2(blit_rect, 0.31, 0, 0, -0.9997, 0) * Fn;\r\n//TRI\t\t= biquadTdf2(RECT * 2, 0.397, 0, 0, -0.9997, 0) * Fn;\r\n\r\n// so we just use the cheap leaky instead with Fn in the filter - these oscs are usable at least\r\n\r\nSAW\t\t\t= leaky(-blit_saw, Fn) * LAURA * bottom;\r\nRECT\t\t= leaky(blit_rect, Fn) * bottom;\r\nTRI\t\t\t= leaky((RECT * Wt) * Fa, Fn) * LAURA * bottom;\r\n\r\nSINE\t\t= 0;\r\nadsn\t\t= latch(int(addsine), thisReset);\r\nif (adsn) {\t// ...73 fine for accuracy here\t// you think \"leaky()\" is wrong here, but it is not :-)\r\n//\tSINE\t= adSc1(leaky(cos73(Ph), Fn) * JASON) * SQRT2 * bottom;\r\n\tSINE\t= atanAdaa2(leaky(cos73(Ph), Fn) * JASON) * SQRT2 * bottom;\r\n\t// ^^ all sine variations work fine: cos73(Ph), cos73(Pwm), sin73(Ph), sin73(Pwm), just depends what you want (phase)\r\n\t// ^^ sadly, the SINE phase does not line up at exact zero crossings, regardless of which function or phase driver you use\r\n//\tSINE\t= rcFilterHp(SINE, filterZero);\t// leaves residual DC at bottom of bottom\r\n}\r\n\r\n// interesting weird SAW that also works...\r\n//interestingPwmSAW\t= leaky(SAW - blit_2, Fn) * LAURA * LAURA * bottom;\r\n//interestingPwmSAW\t= rcFilterHp(interestingPwmSAW, filterZero);\t// leaves residual DC at bottom of bottom\r\n\r\n//SAW\t= rcFilter(SAW, filterRolloff);\t    // some people might like it (but not needed with this algo)\r\n//SAW\t= rcFilterHp(SAW, filterZero);\t\t// leaves residual DC at bottom of bottom\r\n\r\n//RECT\t= rcFilter(RECT, filterRolloff);\t// some people might like it (but not needed with this algo)\r\n//RECT\t= rcFilterHp(RECT, filterZero);\t\t// leaves residual DC at bottom of bottom\r\n\r\n//TRI\t= rcFilterHp(TRI, filterZero);\t\t// leaves residual DC at bottom of bottom\r\n\r\nout1\t= SAW;\r\nout2\t= RECT;\r\nout3\t= TRI;\r\nout4\t= SINE;\r\n\r\nout5\t= peteTrain;\t\t\t\t\t\t// Train is a rectified naive square 0/1 running at period, like [train] or [train~]\r\nout6\t= outPhase;\t\t\t\t\t\t\t// ^^ needed for certain weird things, don't worry\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 6,
                    "outlettype": [ "", "", "", "", "", "" ],
                    "patching_rect": [ 34.0, 56.0, 1005.0, 576.0 ]
                }
