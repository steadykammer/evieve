                    "patching_rect": [ 413.0, 19.0, 435.0, 22.0 ],
                    "text": "in 2 (signal/float) Pulse Width 0..1 if type attr == 1 @default 0.5 @min 0 @max 1"
                }
            },
            {
                "box": {
                    "code": "\nrequire(\"evi_polyblep_utility.genexpr\");\nrequire(\"evi_polyblep_two.genexpr\");\n\r\n// this is here to avoid require hell\npoly_half20(t, dt, pw)\n{\n\th\t= 0;\n\tfdp\t= 1.2732395447351628;\t\t// 4 / PI\n\tt6\t= (pw * 0.5 + t + 0.75) - pw;\n\tt7\t= t6;\n\tt6\t= wrap(t6, 0, 1);\n\tt77\t= t7 - wrap(t7, 0, 1);\n\tif (t6 < pw) {\n\t\th\t= (sin73(t6 / pw * PI) * 2) - pw * fdp;\n\t} else {\n\t\th\t= 0 - pw * fdp;\n\t}\n\th2\t= (poly_blamp(t7 - t77, dt) + poly_blamp(t6, dt)) / pw * PI * dt + h;\n\treturn\th2;\n}\r\n\nclassicOscSelect(phase, nrm, width, gain, type, wav)\n{\n    osc = 0;\n    if (wav == 1) {            // tri\n        if (type == 1) {\n            pw = (width >= 0.5) ? width : width * 0.8 + 0.1;\n            osc = poly_trip(phase, nrm, pw);\n        }\n        else {  // (type == 0)\n            osc = poly_tri(phase, nrm);\n        }\n    }\n    else if (wav == 2) {       // saw\n        if (type == 1) {\n            osc = morph_saw_tri_saw(phase, nrm, width);\n        }\n        else {  // (type == 0)  // default\n            osc = poly_saw(phase, nrm);\n        }\n    }\n    else if (wav == 3) {       // rect\n        if (type == 1) {\n            pwm = width * 0.9 + 0.05;\n            osc = poly_rect(phase, nrm, pwm);\n        }\n        else {  // (type == 0)\n            osc = poly_sqr(phase, nrm);\n        }\n    }\n    else {  // (wav == 0)      // sine\n        if (type == 1) {\n            pwm = (width >= 0.5) ? width : width * 0.92 + 0.04;\n            osc = poly_half20(phase, nrm, pwm);\n        }\n        else {  // (type == 0)\n            osc = sin73(phase * TWOPI);\n        }\n    }\n\n    return osc * gain;\n}\n\n// only 4-point works for oscillators\n\n// fixed 2x quasi downsampling \nclassicOscSelect_2x_4POINT(phase, nrm, width, gain, type, wav)\n{\t// down 2\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// process 2x\n\ty1_0\t= classicOscSelect(phase, nrm, width, gain, type, wav);\n\ty2_0\t= classicOscSelect(phase, nrm, width, gain, type, wav);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(0.5,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\treturn y0_0;\n}\n\n// fixed 4x quasi downsampling \nclassicOscSelect_4x_4POINT(phase, nrm, width, gain, type, wav)\n{\t// down 2\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// process 4x\n\ty1_0\t= classicOscSelect_2x_4POINT(phase, nrm, width, gain, type, wav);\n\ty2_0\t= classicOscSelect_2x_4POINT(phase, nrm, width, gain, type, wav);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(0.5,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\treturn y0_0;\n}\n\n// fixed 8x quasi downsampling \nclassicOscSelect_8x_4POINT(phase, nrm, width, gain, type, wav)\n{\t// down 2\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// process 8x\n\ty1_0\t= classicOscSelect_4x_4POINT(phase, nrm, width, gain, type, wav);\n\ty2_0\t= classicOscSelect_4x_4POINT(phase, nrm, width, gain, type, wav);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(0.5,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\treturn y0_0;\n}\n\nclassicOscSelectOversample(phase, nrm, width, gain, type, wav, over)\n{\n    History ovdummy(0);\n    osc = 0;\n    if (over == 1) {\n        osc = classicOscSelect_2x_4POINT(phase, nrm, width, gain, type, wav);\n    }\n    else if (over == 2) {\n        osc = classicOscSelect_4x_4POINT(phase, nrm, width, gain, type, wav);\n    }\n    else if (over == 3) {\n        osc = classicOscSelect_8x_4POINT(phase, nrm, width, gain, type, wav);\n    }\n    else {  // (over == 0)\n        osc = classicOscSelect(phase, nrm, width, gain, type, wav);\n    }\n    return osc;\n}\n\n\nParam   oscillator(2, min=0, max=3);    // 0=sine, 1=tri, 2=saw, 3=rect\nParam   type(0, min=0, max=1);          // 0=pure oscillators, 1=pulsewidth versions\n// 2=(if using < 20Hz but < 4k), 3=(if using < 20Hz && > 4k)\nParam   dc(1, min=0, max=3);\t\t\t// 0=off, 1=on,\t2=auto for lfos, 3=auto for oscillators\nParam   compensate(1, min=0, max=2);    // decorrelation high frequency compensation filters, off/1/2\nParam   oversample(1, min=0, max=3);\t// fake oversampling, 0=1x, 1=2x, 2=4x, 3=8x\n\nwav     = int(oscillator);\ntyp     = int(type);\n\ndci\t\t= int(dc);\nfilt\t= int(compensate);\nover\t= int(oversample);\n\nfreqInHz\t= in1;\npulseWidth\t= in2;                      // if \"type\" == 1\nsyncPhase\t= in3;                      // hard sync, NOT IMPLEMENTED YET\n\nt\t\t\t= 0;\nif (change(syncPhase) != 0) {           // if a sync phasor is attached\n\tt\t\t= syncPhase;\n\tif (t >= 0)\n\t\tt  -= trunc(t);\n\telse\n\t\tt  += 1 - trunc(t);\n} else {\n\tt\t\t= phasor(freqInHz);         // no naive reset here\n}\n\ndt\t\t\t= freqInHz / SAMPLERATE;\ndtn\t\t\t= clip((dt + dt), 0, 1);\noscsync\t\t= delta(t) < 0;\ngain\t\t= minimum(scale(clip(freqInHz, 0, 20), 1, 20, 0.9564, 0.5, 3), 0.9564) * (((1 - (filt * (freqInHz < 20))) * 0.157588) + 0.842412);\nsmoothsamps = mstosamps(33);\na, an\t\t= evi_line(gain, smoothsamps);\t// 0.5 for Oscillators, 1.0 for LFOs ... oder ?? (dynamic like dc)\n\nov\t\t\t= latch(over,\toscsync);\nwv\t\t\t= latch(wav,\toscsync);\ntp          = latch(typ,    oscsync);\ndcn\t\t\t= latch(dci,\toscsync);\nft\t\t\t= latch(filt,\toscsync);\n\nosc = 0;\n\r\nif (freqInHz > (SAMPLERATE * 0.25)) {       // sine if above (samplerate / 4)\n    osc\t= sin73(TWOPI * t);                 // or should be cos() here ?\n}\nelse {\n    osc = classicOscSelectOversample(t, dt, pulseWidth, a, tp, wv, ov);\n}\n\n// dcblock\nosc = dynamicDc(osc, dtn, dcn);\n\n// restore high frequencies options...\nif (ft > 0) {\n\tosc = decorelateOsc(osc);      // for Bleps ?\n\tif (ft > 1) {\n\t\tosc = decorelateOsc(osc);  // for Blamps / Bluhs ?\n\t}\n}\n\nout1\t= osc;\nout2\t= t;\nout3\t= oscsync;\n\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 3,
                    "outlettype": [ "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 1112.0, 732.0 ]
                }
