            {
                "box": {
                    "id": "obj-2",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 667.0, 19.0, 250.0, 22.0 ],
                    "text": "in 2 (signal) Signal Rate Phase Reset (Naive)"
                }
            },
            {
                "box": {
                    "code": "\r\n// high quality sine oscillator for modulation purposes\r\n// with sample accurate & clickless automatic phase reset when Hz input is @zero\r\n\r\n// @see also:\r\n// evi_freqshift_hilbert.gendsp\r\n// evi_freqshift_weaver.gendsp\r\n// evi_ringmod.gendsp\r\n\r\nrequire(\"evi_smooth.genexpr\");\r\n\r\n// table\nmodSinOsc(thisphase)\n{\t// this is a Sine\n\treturn\tcycle(wrap(thisphase + 0.75, 0, 1), index=\"phase\");\n}\r\n\r\n// approx\nmodSinOscApprox(thisphase)\n{\n\treturn\tsin73(thisphase * TWOPI);\n}\r\n\r\nHistory\tautoreset(1);\r\nParam\tresetauto(1, min=0, max=1);\t\t\t\t// 0/1 off/on, default on\r\n\r\nParam\tscale(1., min=0);\t\t\t\t\t\t// linear multiply theOsc output to range\r\nParam\toffset(0.);\t\t\t\t\t\t\t\t// offset add theOsc to range\r\n\r\nParam\tsmooth(22.666, min=0, max=333);\t\t\t// ms, reset ramp\r\nParam\tfreqsmooth(20., min=0, max=666);\t\t// ms, Hz input\r\n\r\nsmoothsecs\t= smooth*0.001;\r\nsmoothsamps\t= smoothsecs*samplerate;\r\nsmoothfreq\t= mstosamps(freqsmooth);\r\nrauto\t\t= int(resetauto);\r\nresettime\t= maximum(smoothsamps * 2, vectorsize * 8);\r\n\r\nhz\t\t= in1;\r\nreset\t= delta(in2) < 0;\t\t\t\t\t\t// manual reset, will click, but useful if Hz @ zero\r\n\r\ntheAmp, theAdd\t= expsmoothBank2(scale, offset, smoothsecs);\r\n\r\nif (smoothfreq > 0)\t\t\t\t\t\t\t\t// turn off smoothing if feeding in1 with audio rate modulation\r\n{\r\n\thz, hn\t= eviLine(hz, smoothfreq);\r\n}\r\n\r\n// auto reset\r\nsync\t\t= phasor(hz, (reset + autoreset));\r\nstatic\t\t= delta(sync) != 0;\t\t\t\t\t// phasor is / is not moving\r\nresetramp, rrn\t= eviLine(static, resettime);\t// must be exact ramp\r\nautoreset\t= rauto ? ((change(rrn == 1) > 0) * (static == 0)) : 0;\t// end of down ramp only, not up\r\n\r\ntheOsc\t\t= modSinOscApprox(sync);//modSinOsc(sync) * resetramp;\r\n\r\nout1\t\t= ((theOsc * theAmp) + theAdd) * resetramp;\r\nout2        = theOsc;                           // raw aux\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 49.0, 58.0, 868.0, 732.0 ]
                }
            },
