					"numinlets" : 1,
					"numoutlets" : 0,
					"patching_rect" : [ 49.0, 918.0, 330.0, 22.0 ],
					"text" : "out 1 (signal) modulation -1..1 Sine Oscillator * scale + offset"
				}

			}
 ],
