					"text" : "in 1 (signal/float) Frequency in Hz +/-"
				}

			}
, 			{
				"box" : 				{
					"id" : "obj-2",
					"maxclass" : "newobj",
					"numinlets" : 0,
					"numoutlets" : 1,
					"outlettype" : [ "" ],
					"patching_rect" : [ 667.0, 19.0, 250.0, 22.0 ],
					"text" : "in 2 (signal) Signal Rate Phase Reset (Naive)"
				}

			}
, 			{
				"box" : 				{
					"code" : "\r\n// high quality sine oscillator for modulation purposes\r\n// with sample accurate & clickless automatic phase reset when Hz input is @zero\r\n\r\n// @see also:\r\n// evi_freqshift_hilbert.gendsp\r\n// evi_freqshift_weaver.gendsp\r\n// evi_ringmod.gendsp\r\n\r\n\r\n// not approx\nmodSinOsc(thisphase)\n{\t// this is a Sine\n\treturn\tcycle(wrap(thisphase + 0.75, 0, 1), index=\"phase\");\n}\r\n\r\ncosQ121(x)\n{\n\tc1 =  0.99999999999925182;\n\tc2 = -0.49999999997024012;\n\tc3 =  0.041666666473384543;\n\tc4 = -0.001388888418000423;\n\tc5 =  0.0000248010406484558;\n\tc6 = -0.0000002752469638432;\n\tc7 =  0.0000000019907856854;\n\n\tx2 = x * x;\n\treturn (c1 + x2 * (c2 + x2 * (c3 + x2 * (c4 + x2 * (c5 + x2 * (c6 + c7 * x2))))));\n}\n\ncos121(x)\n{\n\tTWOOVERPI = 0.63661977236758;\t// 2 / PI\n\tx = x % TWOPI;\t\t\t\t\t// phasewrap(x) cheaper ?\n\tx = (x < 0) ? -x : x;\n\tQUAD = int(x * TWOOVERPI);      // get quadrant # (0..3) we are in\n\tcosreturn = 0;\n\tif              (QUAD == 0) {\n\t\tcosreturn =  cosQ121(x);\n\t} else if       (QUAD == 1) {\n\t\tcosreturn = -cosQ121(PI - x);\n\t} else if       (QUAD == 2) {\n\t\tcosreturn = -cosQ121(x - PI);\n\t} else {    //  (QUAD == 3)\n\t\tcosreturn =  cosQ121(TWOPI - x);\n\t}\n\treturn cosreturn;\n}\n\nsin121(x)\n{\n\treturn cos121(HALFPI - x);\n}\r\n\r\n// approx\nmodSinOscApprox(thisphase)\n{\n\treturn\tsin121(thisphase * TWOPI);\n}\r\n\r\n// basic linear scaling like linear part of [scale]\neviMap(valueIn, inLow, inHigh, outLow, outHigh)\n{\n\tmultiplier = (outLow - outHigh) / (inLow - inHigh);\n\treturn (valueIn - inLow) * multiplier + outLow;\n}\n\neviLine(target, duration)\t\t\t// target, duration in samples\n{\n\tHistory\tvalue(0);\n\ttrigger\t= change(target);\n\tramp\t= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);\n\tline\t= eviMap(ramp, 0, 1, latch(value, trigger), latch(target, trigger));\n\tvalue\t= line;\n\treturn\tline, (ramp == 1);\n}\n\r\nexpA(x0)\t\t\t\t\t\t\t// more accurate than 'fastexp()'\n{\n\tx = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;\n\tx *= x; x *= x; x *= x; x *= x; x *= x;\n\treturn x;\n}\n\ntauA(t)\t\t\t\t\t\t\t\t// t is time in seconds\n{\n\ty = expA(-1 / (t * samplerate));\n\treturn y + 0.000128;\n}\n\r\nexpso(x, z)\t\t\t\t\t\t\t// z is pole\n{\n\tHistory w(0);\n\ty = (z * w) + (x * (1 - z));\n\tw = y;\n\treturn y;\n}\n\nexpsmoothBank2(x1, x2, t)\n{\n\tHistory\texps2dummy(0);\n\tz\t\t= tauA(t);\n\ty1\t\t= expso(x1, z);\n\ty2\t\t= expso(x2, z);\n\treturn\ty1, y2;\n}\r\n\r\nHistory\tautoreset(1);\r\nParam\tresetauto(1, min=0, max=1);\t\t\t\t// 0/1 off/on, default on\r\n\r\nParam\tscale(1, min=0);\t\t\t\t\t\t// linear multiply theOsc output to range\r\nParam\toffset(0);\t\t\t\t\t\t\t\t// offset add theOsc to range\r\n\r\nParam\tsmooth(22.666, min=0, max=333);\t\t\t// ms, reset ramp\r\nParam\tfreqsmooth(20, min=0, max=666);\t\t\t// ms, Hz input\r\n\r\nsmoothsecs\t= smooth*0.001;\r\nsmoothsamps\t= smoothsecs*samplerate;\r\nsmoothfreq\t= mstosamps(freqsmooth);\r\nrauto\t\t= int(resetauto);\r\nresettime\t= maximum(smoothsamps * 2, vectorsize * 8);\r\n\r\nhz\t\t= in1;\r\nreset\t= delta(in2) < 0;\t\t\t\t\t\t// manual reset, will click, but useful if Hz @ zero\r\n\r\ntheAmp, theAdd\t= expsmoothBank2(scale, offset, smoothsecs);\r\n\r\nif (smoothfreq > 0)\t\t\t\t\t\t\t\t// turn off smoothing if feeding in1 with audio rate modulation\r\n{\r\n\thz, hn\t= eviLine(hz, smoothfreq);\r\n}\r\n\r\n// auto reset\r\nsync\t\t= phasor(hz, (reset + autoreset));\r\nstatic\t\t= delta(sync) != 0;\t\t\t\t\t// phasor is / is not moving, should add fixdenorm() ?\r\nresetramp, rrn\t= eviLine(static, resettime);\t// must be exact ramp\r\nautoreset\t= rauto ? ((change(rrn == 1) > 0) * (static == 0)) : 0;\t// end of down ramp only, not up\r\n\r\ntheOsc\t\t= modSinOscApprox(sync);//modSinOsc(sync) * resetramp;\r\n\r\nout1\t\t= ((theOsc * theAmp) + theAdd) * resetramp;\r\n\r\n",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 12.0,
					"id" : "obj-3",
					"maxclass" : "codebox",
					"numinlets" : 2,
					"numoutlets" : 1,
					"outlettype" : [ "" ],
					"patching_rect" : [ 49.0, 58.0, 868.0, 843.0 ]
				}

			}
, 			{
