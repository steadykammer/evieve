                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 49.0, 793.0, 195.0, 22.0 ],
                    "text": "out 1 (signal) VOSIM-like Oscillator"
                }
            }
