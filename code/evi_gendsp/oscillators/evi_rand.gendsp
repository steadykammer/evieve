                    "code": "\r\n// like [rand~] (linear)\n// very predictable and gives exact notches\neviRand(p) {\t\t\t\t\t\t\t\t// phasor input, not frequency\n\tHistory prev(0);\n\trr = (delta(p)) < 0;                    // assumes positive freq only\n\ta  = latch(prev, rr);\n\tn  = noise();\n\tb  = latch(n, rr);\n\tnv = mix(a, b, p);\t\t\t\t\t\t// interp(p, a, b, mode=\"cosine\") for more fun\n\tprev = b;\n\treturn nv, n;\n}\r\n\r\nout1 = eviRand(phasor(in1));\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
