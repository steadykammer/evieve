            },
            {
                "box": {
                    "code": "\r\n// Phase Modulation Oscillator by Pete for evieve\r\n// a simplified version of \"Squinewave Oscillator\" by Rasmus Ekman\r\n// also based on gen~ port of Squinewave by Volker Böhm\r\n\r\nnormaliseToLimit(freq, limit)\r\n{\r\n\tw0\t\t= TWOPI / samplerate;\r\n\tw1\t\t= limit * w0;\r\n\treturn\tclip((sqrt((freq * w0) / w1) - (1 - w1)) * (1 + w1), 0, 1); // should not return to 0 ?\r\n}\r\n\r\nParam\tcfmode(1, min=0, max=1);\t\t\t\t\t\t\t\t// in1 cutoff in: 1 = pitch, 0 = Hz\r\nParam\tcfsmooth(20, min=0, max=1000);\t\t\t\t\t\t\t// smooth in1 in ms, 0 == off\r\nParam\tcfmul(0.1, min=0, max=0.5);\t\t\t\t\t\t\t\t// multiplier of samplerate\r\n\r\ndutyIn\t\t= clamp(in5, 0, 1);\r\nduty0\t\t= (dutyIn + dutyIn - 1);\r\ndutycycle\t= duty0 * 0.9998;\t\t\t\t\t\t\t\t\t// -0.9998..0.9998\r\n//harm0\t\t= (clamp(sqrt(in4), 0, 1) * 0.985558) + 0.014142;\t// 0.014142..0.9997, always some harmonics\r\nharm0\t\t= interp(clamp(in4, 0, 1), 0, 0.9997, mode=\"cosine\");// 0. .. 0.9997\r\nharmonics\t= (harm0 * (1 - abs(duty0)) * 0.292893) + (sqrt1_2 * harm0);\r\n\r\nfreq, cf, limit\t= evi_hzpitchmodmods(abs(in1), in2, in3, mode=cfmode, smooth=cfsmooth, high=cfmul, cliplimit=0, outnomod=1);\r\n\r\nphaseraw\t= phasor(freq);\r\nphasemod\t= phaseraw;\r\n//trigger\t\t= 0;\r\n\r\n// based on volker böhm, 2016\r\n// volker's port is really clever and gen~centric, and much better than my initial attempt\r\nif (freq < limit) {\r\n\t// limits\r\n\treduce\t= normaliseToLimit(cf, limit);\r\n\tharm1\t= interp(reduce, harmonics, 0, mode=\"linear\");\r\n\tduty1\t= interp(reduce, dutycycle, 0, mode=\"cosine\");\r\n\thighest\t= limit / freq;\r\n\tlowest\t= highest / (highest + highest - 1);\r\n\t// create kinks\r\n\tkink1\t= 1 / (1 - duty1);\r\n\tkink2\t= 1 / (1 + duty1);\r\n\tsq0\t\t= maximum(1 / (1 - harm1), 1);\r\n\t// clamp & kink factors\r\n\tkink1\t= clamp(kink1, lowest, highest);\r\n\tkink2\t= clamp(kink2, lowest, highest);\r\n\t// clamp & square factors\r\n\tsq1\t\t= minimum(sq0, highest / kink1);\r\n\tsq2\t\t= minimum(sq0, highest / kink2);\r\n\t// create ramps\r\n\tramp1\t= phaseraw * kink1;\r\n\tramp2\t= phaseraw * kink2 - kink2 + 0.5;\r\n\ttrigger\t= ramp1 > 0.5;\r\n\t// clamp & square ramps\r\n\tramp1  *= (1 - trigger) * sq1;\r\n\tramp2  *= trigger * sq2;\r\n\t// create phase modulation signal\r\n\tphasemod  = clip(ramp1 + ramp2, 0, 0.5);\r\n\tphasemod += trigger * 0.5;\r\n//} else {\r\n//\ttrigger\t= delta(phaseraw) < 0;\r\n}\r\n\r\n//phaseModOscillator = cycle(phasemod, index=\"phase\");\r\nphaseModOscillator = cos(phasemod * TWOPI);\r\n\r\nout1 = dcblock(phaseModOscillator * 0.5);\r\nout2 = phasemod;\r\nout3 = phaseraw;\r\n//out4 = trigger;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-5",
                    "maxclass": "codebox",
                    "numinlets": 5,
                    "numoutlets": 3,
                    "outlettype": [ "", "", "" ],
                    "patching_rect": [ 34.0, 58.0, 992.0, 732.0 ]
                }
            },
