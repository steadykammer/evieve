        "integercoordinates": 1,
        "boxes": [
            {
                "box": {
                    "id": "obj-7",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 800.0, 807.0, 113.0, 22.0 ],
                    "text": "out 2 FM output Sin"
                }
            },
            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 34.0, 19.0, 125.0, 22.0 ],
                    "text": "in 1 Index @default 1."
                }
            },
            {
                "box": {
                    "code": "\r\n// this is a quadrature FM/PM xfading mod/carrier setup, based on LIONEL's patch from:\r\n// https://cycling74.com/forums/fm-vs-pm-in-gen-unwanted-artifacts-clicks\r\n// with additions by Graham Wakefield\r\n// Thanks so much!\r\n\r\n// Note: this is a strange param rate only version for specific situations,\r\n// see the more normal 'evi_quadfmpm.gendsp' for a fully audio rate inlets version.\r\n\r\nrequire(\"evi_smooth.genexpr\");\n\r\n// this is not so good, should replace\r\nlpfir3(x0)\r\n{\r\n\tHistory\tx1(0), x2(0);\r\n\ty0\t= (x0*0.5 + x1*0.333333333333 + x2*0.166666666667) * sqrt1_2;\r\n\tx2\t= x1;\r\n\tx1\t= x0;\r\n\treturn\ty0;\r\n}\r\n\r\n// this is one of those really clever Graham Wakefield things, thanks\r\n// output will reach target by a linear ramp whose slope can be no greater than the param maxslope\r\nramplimit(target, maxslope)\t\t\t\t// maxslope = maximum change per ms\r\n{\r\n\tHistory y0(0);\r\n\tmaxsamps\t= sampstoms(maxslope);\t// this is strange?\r\n\ty1\t= clamp(target - y0, -maxsamps, maxsamps) + y0;\r\n\ty0\t= y1;\r\n\treturn\ty1;\r\n}\r\n\r\nHistory modOscPrev(0), carrierCosFb(0), carrierSinFb(0);\r\n\r\nParam\tpitch(48., min=0, max=120);\r\nParam\tmodulationmult(1., min=0, max=100);\r\n\r\nParam\txfadedepth(1., min=0, max=100);\r\nParam\txfadeblend(1., min=0, max=1);\t// % 0..1, default PM\r\n\r\nParam\tmodulationfeedback(0., min=0, max=100);\r\nParam\tcarrierfeedback(0., min=0, max=100);\r\n\r\nParam\tsmooth(10., min=0, max=333);\t// ms\r\nsmoothsecs\t= smooth*0.001;\r\nsmooth_p\t= (smooth > 0);\r\n\r\npitch_a\t= pitch;\r\nmmult_a = modulationmult;\r\nmodfb_a\t= modulationfeedback;\r\ncarfb_a\t= carrierfeedback;\r\nif (smooth_p) {\r\n\tpitch_a\t= logsmooth(pitch, smoothsecs);\r\n\tmmult_a\t= expsmooth(modulationmult, smoothsecs);\r\n\tmodfb_a, carfb_a\t= expsmoothBank2(modulationfeedback, carrierfeedback, smoothsecs);\r\n}\r\n\r\nfreq_a\t= mtofApproxBaseless(pitch_a);\r\nfmm\t\t= freq_a*mmult_a;\r\nfmamount, pmamount\t= p2cApproxQuart(xfadedepth, xfadeblend);\r\n\r\nindex\t= maximum(in1, 1);\r\n\r\n// Op\r\n\r\nmodOsc\t\t= sin73a(phasor(fmm)*twopi + lpfir3(modfb_a*modOscPrev));\r\nmodZerox\t= (modOscPrev*modOsc) <= 0;\r\nmodOscPrev\t= modOsc;\r\nmodBias\t\t= latch(index, modZerox);\r\nmodulator\t= modOsc*modBias;\r\nfmamount\t= ramplimit(fmamount, 0.01);\r\nfmamount\t= latch(fmamount, modZerox);\r\npmamount\t= ramplimit(pmamount, 0.01);\r\n\r\ncarrierPhase\t= (phasor(freq_a + (fmm*modulator*fmamount))*twopi) + (modulator*pmamount);\r\ncarrierCos\t\t= cos(carrierPhase + carrierCosFb);\r\ncarrierSin\t\t= sin(carrierPhase + carrierSinFb);\r\n\r\nif (carfb_a > 0) {\r\n\tcarrierCosFb\t= fixdenorm(lpfir3(carfb_a*carrierCos));\r\n\tcarrierSinFb\t= fixdenorm(lpfir3(carfb_a*carrierSin));\r\n}\r\n\r\nout1\t= dcblock(carrierCos);\r\nout2\t= dcblock(carrierSin);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 34.0, 58.0, 879.0, 732.0 ]
                }
            },
            {
                "box": {
