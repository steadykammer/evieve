            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 19.0, 199.0, 22.0 ],
                    "text": "in 1 (signal) Audio Input for Analysis"
                }
            },
            {
                "box": {
                    "code": "\r\n// this is a very funky noise / oscillators source mixer for e.g. a vocoder, but works as an interesting source on it's own.\r\n// just so you know, i really really like this for some reason.\r\n\r\nrequire(\"evi_smooth.genexpr\");\r\nrequire(\"evi_sources.genexpr\");\r\n\r\n// the first two are here to avoid gen~ bugs circular require hell (would normally require(\"evi_rcfilters.genexpr\"))...\r\n\r\nrcDampCoeffs0b(cutoff, damp)\t\t\t// cutoff in Hz, damp must clamp 0..1 (1 = highpass/lowpass)\n{\n\tg0\t\t=  tanA(PI * cutoff / SAMPLERATE);\t// prewarp\n\tks\t\t= (damp * 0.5) + 0.5;\t\t// damp 0..1 = sqrt..lin\n\tks05\t= (ks - 0.5);\n\tksom\t= ((1 - ks) + 0.5) - 0.5;\n\tg01\t\t=  1 + g0;\n\tg1 \t\t=  g0 / interp((ks05 + ks05), sqrt(g01), g01, mode=\"linear\");\n\td1\t\t= interp((ksom + ksom), sqrt(damp), damp, mode=\"linear\");\n\treturn\tg1, d1;\t\t\t\t\t\t// rc filter warped cf (g)\t// rc filter warped gain (k)\n}\r\n\r\nrcFilterDampb(Vin, g, k)\n{\n\tHistory\t   s(0);\n\tLp\t\t= (g * Vin + s) / (g + 1);\n\ts\t\t= (Lp + Lp) - s;\n\treturn\tVin + (k * (Lp - Vin));\n}\r\n\r\nzeroxEnvs(AudioForAnalysis, response, window, thresh, slope, release)\r\n{\r\n    History zedummy(0);\r\n    xingnum, xgate, xings = likeZerox(AudioForAnalysis, windowSize=window, threshold=thresh);\r\n\r\n    // in samples\r\n    xslope = xingnum * slope;\r\n    envattack = maximum(xslope, 1);\r\n    envdecay = maximum((xslope * vectorsize), vectorsize) * release;\r\n\r\n    env = 0;\r\n    resp = latch(int(response), xings);\r\n    if (resp == 1) {        // linear\r\n        env = eviRampsmooth(xgate, envattack, envdecay); // eviRampsmoothUpdate() ?\r\n    }\r\n    else if (resp == 2) {   // log, default\r\n        env = slide(xgate, envattack, envdecay);\r\n    }\r\n    else if (resp == 3) {   // vactrol fast, stupid using audio rate data to drive params, switch to 'evi_env.genexpr' ?\r\n        env = vactrolBuchla(xgate, rise=envattack, fall=envdecay); // should expose @base ?\r\n    }\r\n    else if (resp == 4) {   // vactrol slow\r\n        // don't ask...\r\n        rise = clip(xslope / vectorsize, 0, 1);\r\n        fall = clip(envdecay / (vectorsize + vectorsize), 0, 1);\r\n        up = rise*rise*rise*7800 + 200;\r\n        down = (fall*0.9999 + 0.0001) * 0.1;\r\n        env = likeAvactrol(xgate, up, down);\r\n        env = minimum(env + env, 1);\r\n    }\r\n    else {\r\n        env = 0;            // allowed to be zero\r\n    }\r\n\r\n    return  env, xingnum;\r\n}\r\n\r\nnoiseSources(ZeroxEnv, MixNoise, pitchLow, pitchHigh)\r\n{\r\n    History nsdummy(0);\r\n    // mix dust..velvet..gaussian\r\n    mixSq = MixNoise * MixNoise;\r\n    analAmp = (MixNoise * 0.93) + 0.07;\r\n    sqrtMixNoise\t= sqrt(MixNoise);\r\n\r\n    dynamicDamp = (1 - ZeroxEnv) * analAmp;\r\n    freqDamp = mtofApprox(eviMap((1 - mixSq), 0, 1, pitchLow, pitchHigh));\r\n\r\n    tpqmHz\t= 0;\t// mapped sqrt(0..1) -->> 10..10000 Hz around 0.5/500\r\n    if (sqrtMixNoise >= 0.5) {\r\n\t    tpqmHz = eviZmap(sqrtMixNoise, 0.5, 1, 500, 10000);\r\n    }\r\n    else {\r\n\t    tpqmHz = eviZmap(sqrtMixNoise, 0, 0.5, 10, 500);\r\n    }\r\n\r\n    tpqmAmp\t= 0;\t// mapped -6dB..0dB -->> 0..1 around sqrt1_2/-6dB\r\n    if (MixNoise >= 0.501187 && MixNoise < sqrt1_2) {\r\n\t    tpqmAmp = eviMap(MixNoise, 0.501187, sqrt1_2, 0, 0.501187);\r\n    }\r\n    else if (MixNoise >= sqrt1_2) {\r\n\t    tpqmAmp = eviZmap(MixNoise, sqrt1_2, 1, 0.501187, 1);\r\n    }\r\n    else {\r\n\t    tpqmAmp = 0;\r\n    }\r\n\r\n    dustVelvet = sparseVelvetNoise(tpqmHz, mixSq);\r\n    gaussian = gaussianNoise(0.6403882032022076);\r\n    interpNoise = interp(tpqmAmp, dustVelvet, gaussian, mode=\"linear\");\r\n\r\n    g, k\t= rcDampCoeffs0b(freqDamp, dynamicDamp);\r\n    rcLP\t= rcFilterDampb(interpNoise, g, k);\r\n\r\n    return  rcLP;\r\n}\r\n\r\n// a silly crossfading wrapper around \"evi_blitwaves.gendsp\", specifically for the vocoder thing for my friend Christoph Resiserer\r\noscSources(freq, width, reset, oscinterp, smoothfreq)           // \"reset\" is naive, do not use it\r\n{\r\n    History\tcomputesine(0), computetrain(1);\t\t\t\t\t// annoying, gen~ will only let me set these dynamically if Histories\r\n    oscSelect\t= oscinterp * 6;                                // oscinterp = 0..1\r\n\r\n    SAW, RECT, TRI, SINE, Train, Sync = evi_blitwaves(freq, width, reset, smooth=smoothfreq, addsine=computesine, addtrain=computetrain);\r\n\r\n    OSC\t\t=\t0;\r\n    if \t\t\t(oscSelect > 0 && oscSelect <= 1) {\r\n\t    OSC\t= interp(oscSelect, 0, Train);\r\n    }\r\n    else if \t(oscSelect > 1 && oscSelect <= 2) {\r\n\t    OSC\t= interp(oscSelect - 1, Train, RECT);\r\n    }\r\n    else if \t(oscSelect > 2 && oscSelect <= 3) {\r\n\t    OSC\t= interp(oscSelect - 2, RECT, SAW, mode=\"cosine\");\t// :-)\r\n    }\r\n    else if \t(oscSelect > 3 && oscSelect <= 4) {\r\n\t    OSC\t= interp(oscSelect - 3, SAW, TRI);\r\n    }\r\n    else if \t(oscSelect > 4 && oscSelect <= 5) {\r\n\t    OSC\t= interp(oscSelect - 4, TRI, SINE);\r\n    }\r\n    else if \t(oscSelect > 5 && oscSelect <= 6) {\r\n\t    OSC\t= interp(oscSelect - 5, SINE, 0);\r\n    }\r\n\r\n    computesine\t\t= oscSelect >= 4;\r\n    computetrain\t= oscSelect <= 2;\r\n\r\n    return  OSC, Sync;\r\n}\r\n\r\nParam   envresponse(2, min=0, max=4);               // 1=linear, 2=log (default), 3=vactrol fast, 4=vactrol slow, 0=off\r\nParam   envwindow(vectorsize, min=16, max=4096);    // in samples, do not change this\r\nParam   envthresh(0.1, min=0, max=1);               // linear threshold for noise (zero crossings) detection\r\nParam   envslope(1., min=0.1, max=10);              // slowness of attack/decay slope\r\nParam   envrelease(2., min=1, max=10);              // slowness of decays\r\n\r\nParam   damppitchlow(94., min=12, max=103);         // pitch...\r\nParam   damppitchhigh(124., min=24, max=125);\r\nParam   noisegain(0., min=-72, max=30);             // in dB\r\n\r\nParam   gainsmooth(0., min=0, max=333);             // in ms, default off, final gains unused by default\r\n\r\n// note: turn off oscsmoothfreq if modulating externally\r\nParam\toscsmoothfreq(22., min=0, max=333);         // in ms, smooth the frequency changes of the oscillators? (in2)\r\nParam\toscgain(0., min=-72, max=30);               // in dB\r\n// note: there might be a problem somewhere if oscsmoothinterp == 0\r\nParam\toscsmoothinterp(30.111, min=0, max=1000);   // in ms, smooth the oscillators interpolation? (in3)\r\noscsmoothinterpsamps    = mstosamps(oscsmoothinterp);\r\n\r\noscGain\t\t= dbtoaApprox(oscgain);\r\nnoiseGain\t= dbtoaApprox(noisegain);\r\nif (gainsmooth > 0) {\r\n    oscGain, noiseGain\t= logsmoothBank2(oscGain, noiseGain, gainsmooth*0.001);\r\n}\r\n\r\n// OscFreq & OscWidth are smoothed by oscsmoothfreq if on, no need to smooth NoiseMix ?\r\nOscFreq = in2;  OscWidth = in3; OscInterp = in4; NoiseMix = in5;\r\nif (oscsmoothinterp > 0) {\r\n    OscInterp\t= eviLine(OscInterp, oscsmoothinterpsamps);\t// must be exact ramp\r\n}\r\nAudioForAnalysis = in1;\r\nEnv, Xingnum = zeroxEnvs(AudioForAnalysis, envresponse, envwindow, envthresh, envslope, envrelease);\r\nMixedNoise = noiseSources(Env, NoiseMix, damppitchlow, damppitchhigh);\r\nOsc, OscSync = oscSources(OscFreq, OscWidth, 0, OscInterp, oscsmoothfreq);\r\nResynthesis = mix((Osc * oscGain), (MixedNoise * noiseGain), Env);  // gains unused by default\r\n\r\nout1 = Resynthesis;\r\nout2 = Osc;\r\nout3 = MixedNoise;\r\nout4 = OscSync;\r\nout5 = Xingnum;\r\nout6 = Env;\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 5,
                    "numoutlets": 6,
                    "outlettype": [ "", "", "", "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 1069.0, 734.0 ]
                }
            },
            {
