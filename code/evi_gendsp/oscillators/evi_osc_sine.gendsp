            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 19.0, 187.0, 22.0 ],
                    "text": "in 1 (signal/float) Frequency in Hz"
                }
            },
            {
                "box": {
                    "code": "\r\nrequire(\"evi_polyblep.genexpr\");\r\n\r\nsineOscSelect(phase, norm, gain, wave)\r\n{\r\n    osc = 0;\r\n    if (wave == 1) {            // cosine\r\n        osc\t= poly_cos(phase);\r\n    }\r\n    else if (wave == 2) {       // halfwave\r\n        osc\t= poly_half(phase, norm);\r\n    }\r\n    else if (wave == 3) {       // fullwave\r\n        osc\t= poly_full(phase, norm);\r\n    }\r\n    else if (wave == 4) {       // invfullwave\r\n        osc\t= poly_intsaw(phase, norm);\r\n    }\r\n    else if (wave == 5) {       // cubic\r\n        osc\t= poly_cubsaw(phase, norm);\r\n    }\r\n    else if (wave == 6) {       // parabola\r\n        osc\t= poly_para(phase, norm);\r\n    }\r\n    else if (wave == 7) {       // squared\r\n        osc\t= poly_sin2(phase, norm);\r\n    }\r\n    else if (wave == 8) {       // alternating\r\n        osc\t= poly_alt(phase, norm);\r\n    }\r\n    else if (wave == 9) {       // camel\r\n        osc\t= poly_camel(phase, norm);\r\n    }\r\n    else if (wave == 10) {       // sawtooth\r\n        osc\t= poly_sawsin(phase, norm);\r\n    }\r\n    else if (wave == 11) {       // pulse\r\n        osc\t= poly_sawp(phase, norm);\r\n    }\r\n    else {  // (wave == 0)      // sine     // default\r\n        osc\t= poly_sin(phase);\r\n    }\r\n\r\n    return osc * gain;\r\n}\r\n\r\n// only 4-point works for oscillators\r\n\r\n// fixed 2x quasi downsampling \nsineOscSelect_2x_4POINT(phase, norm, gain, wave)\n{\t// down 2\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// process 2x\n\ty1_0\t= sineOscSelect(phase, norm, gain, wave);\n\ty2_0\t= sineOscSelect(phase, norm, gain, wave);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(0.5,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\treturn y0_0;\n}\r\n\r\n// fixed 4x quasi downsampling \nsineOscSelect_4x_4POINT(phase, norm, gain, wave)\n{\t// down 2\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// process 4x\n\ty1_0\t= sineOscSelect_2x_4POINT(phase, norm, gain, wave);\n\ty2_0\t= sineOscSelect_2x_4POINT(phase, norm, gain, wave);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(0.5,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\treturn y0_0;\n}\r\n\r\n// fixed 8x quasi downsampling \nsineOscSelect_8x_4POINT(phase, norm, gain, wave)\n{\t// down 2\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// process 8x\n\ty1_0\t= sineOscSelect_4x_4POINT(phase, norm, gain, wave);\n\ty2_0\t= sineOscSelect_4x_4POINT(phase, norm, gain, wave);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(0.5,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\treturn y0_0;\n}\r\n\r\nsineOscSelectOversample(phase, norm, gain, wave, over)\r\n{\r\n    History ovdummy(0);\r\n    osc = 0;\r\n    if (over == 1) {\r\n        osc = sineOscSelect_2x_4POINT(phase, norm, gain, wave);\r\n    }\r\n    else if (over == 2) {\r\n        osc = sineOscSelect_4x_4POINT(phase, norm, gain, wave);\r\n    }\r\n    else if (over == 3) {\r\n        osc = sineOscSelect_8x_4POINT(phase, norm, gain, wave);\r\n    }\r\n    else {  // (over == 0)\r\n        osc = sineOscSelect(phase, norm, gain, wave);\r\n    }\r\n    return osc;\r\n}\r\n\r\n// sine osc types:\r\n// 0=sine, 1=cosine, 2=halfwave, 3=fullwave, 4=invfullwave, 5=cubic, 6=parabola, 7=squared, 8=alternating, 9=camel, 10=sawtooth, 11=pulse\r\nParam   oscillator(0, min=0, max=11);\r\n// 2=(if using < 20Hz but < 4k), 3=(if using < 20Hz && > 4k)\r\nParam   dc(1, min=0, max=3);\t\t\t// 0=off, 1=on,\t2=auto for lfos, 3=auto for oscillators\r\nParam   compensate(1, min=0, max=2);    // decorrelation high frequency compensation filters, off/1/2\r\nParam   oversample(1, min=0, max=3);\t// fake oversampling, 0=1x, 1=2x, 2=4x, 3=8x\r\n\r\nwave    = int(oscillator);\r\ndci\t\t= int(dc);\r\nfilt\t= int(compensate);\r\nover\t= int(oversample);\r\n\r\nfreqInHz\t= in1;\r\nsyncPhase\t= in2;                      // hard sync\r\n\r\nt\t\t\t= 0;\r\nif (change(syncPhase) != 0) {           // if a sync phasor is attached\r\n\tt\t\t= syncPhase;\n\tif (t >= 0)\n\t\tt  -= trunc(t);\n\telse\n\t\tt  += 1 - trunc(t);\r\n} else {\r\n\tt\t\t= phasor(freqInHz);         // no naive reset here\r\n}\r\n\r\ndt\t\t\t= freqInHz / SAMPLERATE;\r\ndtn\t\t\t= clip((dt + dt), 0, 1);\r\noscsync\t\t= delta(t) < 0;\r\ngain\t\t= minimum(scale(clip(freqInHz, 0, 20), 1, 20, 0.9564, 0.5, 3), 0.9564) * (((1 - (filt * (freqInHz < 20))) * 0.157588) + 0.842412);\r\nsmoothsamps = mstosamps(33);\r\na, an\t\t= eviLine(gain, smoothsamps);\t// 0.5 for Oscillators, 1.0 for LFOs ... oder ?? (dynamic like dc)\r\n\r\nov\t\t\t= latch(over,\toscsync);\r\nwv\t\t\t= latch(wave,\toscsync);\r\ndcn\t\t\t= latch(dci,\toscsync);\r\nft\t\t\t= latch(filt,\toscsync);\r\n\r\nosc = 0;\r\nif (freqInHz > (SAMPLERATE * 0.25)) {       // sine if above (samplerate / 4)\n    osc\t= sin73(TWOPI * t);\n}\r\nelse {\r\n    osc = sineOscSelectOversample(t, dt, a, wv, ov);\r\n}\r\n\r\n// dcblock\r\nosc = dynamicDc(osc, dtn, dcn);\r\n\r\n// restore high frequencies options...\r\nif (ft > 0) {\r\n\tosc = decorelate(osc);      // for Bleps ?\r\n\tif (ft > 1) {\r\n\t\tosc = decorelate(osc);  // for Blamps / Bluhs ?\r\n\t}\r\n}\r\n\r\nout1\t= osc;\r\nout2\t= t;\r\nout3\t= oscsync;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 3,
                    "outlettype": [ "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 1112.0, 732.0 ]
                }
            },
