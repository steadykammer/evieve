                    "text": "in 1 Frequency in Hz @default 10 @min -SAMPLERATE*0.5 @max SAMPLERATE*0.5"
                }
            },
            {
                "box": {
                    "code": "\r\n// @see: \"evi_velvetnoise.gendsp\" for an alternative algorithm (\"sparseNoise\")\r\n\r\naudioDust(freq)\r\n{\r\n\tclockThresh\t= 1 - (freq * (1 / (SAMPLERATE * 0.5)));\r\n\tXoxhiro1\t= noise();\r\n\tsync\t\t= Xoxhiro1 > clockThresh;\r\n\tXoxhiro2\t= noise();\r\n\r\n\tdust\t\t= sync * Xoxhiro2;\r\n\treturn\t\tdust, Xoxhiro2, sync;\r\n}\r\n\r\nout1, out2, out3\t= audioDust(in1);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 3,
                    "outlettype": [ "", "", "" ],
                    "patching_rect": [ 34.0, 58.0, 657.0, 287.0 ]
                }
            },
