                    "text": "in 6 Car Feedback"
                }
            },
            {
                "box": {
                    "code": "\r\n// this is a quadrature FM/PM xfading mod/carrier setup, based on LIONEL's patch from:\r\n// https://cycling74.com/forums/fm-vs-pm-in-gen-unwanted-artifacts-clicks\r\n// with additions by Graham Wakefield\r\n// Thanks so much!\r\n\r\nrequire(\"evi_smooth.genexpr\");\n\r\n// this is not so good, should replace\r\nlpfir3(x0)\r\n{\r\n\tHistory\tx1(0), x2(0);\r\n\ty0\t= (x0*0.5 + x1*0.333333333333 + x2*0.166666666667) * sqrt1_2;\r\n\tx2\t= x1;\r\n\tx1\t= x0;\r\n\treturn\ty0;\r\n}\r\n\r\n// this is one of those really clever Graham Wakefield things, thanks\r\n// output will reach target by a linear ramp whose slope can be no greater than the param maxslope\r\nramplimit(target, maxslope)\t\t\t\t// maxslope = maximum change per ms\r\n{\r\n\tHistory y0(0);\r\n\tmaxsamps\t= sampstoms(maxslope);\t// this is strange?\r\n\ty1\t= clamp(target - y0, -maxsamps, maxsamps) + y0;\r\n\ty0\t= y1;\r\n\treturn\ty1;\r\n}\r\n\r\nHistory modOscPrev(0), carrierCosFb(0), carrierSinFb(0);\r\n\r\nParam\tpitch(48, min=0, max=120);\r\nParam\tmodulationmult(1, min=0, max=100);\r\nParam\tpitch_params(1, min=0, max=1);\t// default: use params not inlets\r\n\r\nParam\txfadedepth(1, min=0, max=100);\r\nParam\txfadeblend(1, min=0, max=1);\t// % 0..1, default PM\r\nParam\txfade_params(1, min=0, max=1);\t// default: use params not inlets\r\n\r\nParam\tmodulationfeedback(0, min=0, max=100);\r\nParam\tcarrierfeedback(0, min=0, max=100);\r\nParam\tfeedback_params(1, min=0, max=1);// default: use params not inlets\r\n\r\nParam\tsmooth(22.666, min=0, max=333);\t// ms\r\nsmoothsecs\t= smooth*0.001;\r\nsmooth_p\t= (smooth > 0);\r\n\r\npitch_p\t\t= int(pitch_params);\r\nxfade_p\t\t= int(xfade_params);\r\nfeedback_p\t= int(feedback_params);\r\n\r\n// select params & smoothing, or inputs. this is really stupid, but i needed it.\r\n// it means i can choose either param or audio (modulation) inputs.\r\n\r\npitch_a\t= pitch;\r\nmmult_a = modulationmult;\r\nif ( (pitch_p) && (smooth_p) ) {\r\n\tpitch_a\t= logsmooth(pitch, smoothsecs);\r\n\tmmult_a\t= expsmooth(modulationmult, smoothsecs);\r\n}\r\n\r\nmodfb_a\t= modulationfeedback;\r\ncarfb_a\t= carrierfeedback;\r\nif ( (feedback_p) && (smooth_p) ) {\r\n\tmodfb_a, carfb_a\t= expsmoothBank2(modulationfeedback, carrierfeedback, smoothsecs);\r\n}\r\n\r\nindex\t= maximum(in2, 1);\r\n\r\npitch_a\t= pitch_p ? pitch_a : in1;\r\nmmult_a\t= pitch_p ? mmult_a : in7;\r\nfreq_a\t= mtofApproxBaseless(pitch_a);\r\nfmm\t\t= freq_a*mmult_a;\r\n\r\nmodfb_a\t= feedback_p ? modfb_a : in5;\r\ncarfb_a\t= feedback_p ? carfb_a : in6;\r\n\r\nfmamount, pmamount\t= 0;\r\nif (xfade_p) {\r\n\tfmamount, pmamount\t= p2cApproxQuart(xfadedepth, xfadeblend);\t// params\r\n} else {\r\n\tfmamount, pmamount\t= p2cApprox(in3, in4*halfpi);\t\t\t\t// inlets\r\n}\r\n\r\n// Op\r\n\r\nmodOsc\t\t= sin73(phasor(fmm)*twopi + lpfir3(modfb_a*modOscPrev));\r\nmodZerox\t= (modOscPrev*modOsc) <= 0;\r\nmodOscPrev\t= modOsc;\r\nmodBias\t\t= latch(index, modZerox);\r\nmodulator\t= modOsc*modBias;\r\nfmamount\t= ramplimit(fmamount, 0.01);\r\nfmamount\t= latch(fmamount, modZerox);\t// (gen nightmare: does not compile if above ramplimit inside latch)\r\npmamount\t= ramplimit(pmamount, 0.01);\r\n\r\ncarrierPhase\t= (phasor(freq_a + (fmm*modulator*fmamount))*twopi) + (modulator*pmamount);\r\ncarrierCos\t\t= cos(carrierPhase + carrierCosFb);\r\ncarrierSin\t\t= sin(carrierPhase + carrierSinFb);\r\n\r\nif (carfb_a > 0) {\r\n\tcarrierCosFb\t= fixdenorm(lpfir3(carfb_a*carrierCos));\r\n\tcarrierSinFb\t= fixdenorm(lpfir3(carfb_a*carrierSin));\r\n}\r\n\r\nout1\t= dcblock(carrierCos);\r\nout2\t= dcblock(carrierSin);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 7,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 34.0, 58.0, 879.0, 732.0 ]
                }
