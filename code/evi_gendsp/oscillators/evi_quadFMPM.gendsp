            {
                "box": {
                    "code": "\r\n// this is a quadrature FM/PM xfading mod/carrier setup, based on LIONEL's patch from:\r\n// https://cycling74.com/forums/fm-vs-pm-in-gen-unwanted-artifacts-clicks\r\n// with additions by Graham Wakefield\r\n// Thanks so much!\r\n\r\n// Note, for a strange param rate only version see 'evi_quadfmpm_param.gendsp'.\r\n\r\nrequire(\"evi_approx.genexpr\");\n\r\n// this is not so good, should replace\r\nlpfir3(x0)\r\n{\r\n\tHistory\tx1(0), x2(0);\r\n\ty0\t= (x0*0.5 + x1*0.333333333333 + x2*0.166666666667) * sqrt1_2;\r\n\tx2\t= x1;\r\n\tx1\t= x0;\r\n\treturn\ty0;\r\n}\r\n\r\n// this is one of those really clever Graham Wakefield things, thanks\r\n// output will reach target by a linear ramp whose slope can be no greater than the param maxslope\r\nramplimit(target, maxslope)\t\t\t\t// maxslope = maximum change per ms\r\n{\r\n\tHistory y0(0);\r\n\tmaxsamps\t= sampstoms(maxslope);\t// this is strange?\r\n\ty1\t= clamp(target - y0, -maxsamps, maxsamps) + y0;\r\n\ty0\t= y1;\r\n\treturn\ty1;\r\n}\r\n\r\nHistory modOscPrev(0), carrierCosFb(0), carrierSinFb(0);\r\n\r\nindex\t= maximum(in1, 1);\r\n\r\npitch_a\t= in2;\r\nmmult_a\t= in7;\r\nfreq_a\t= mtofApproxBaseless(pitch_a);\r\nfmm\t\t= freq_a*mmult_a;\r\n\r\nmodfb_a\t= in5;\r\ncarfb_a\t= in6;\r\n\r\nfmamount, pmamount\t= p2cApprox(in3, in4*halfpi);\r\n\r\n// Op\r\n\r\nmodOsc\t\t= sin73a(phasor(fmm)*twopi + lpfir3(modfb_a*modOscPrev));\r\nmodZerox\t= (modOscPrev*modOsc) <= 0;\r\nmodOscPrev\t= modOsc;\r\nmodBias\t\t= latch(index, modZerox);\r\nmodulator\t= modOsc*modBias;\r\nfmamount\t= ramplimit(fmamount, 0.01);\r\nfmamount\t= latch(fmamount, modZerox);\t// (gen: does not compile if above ramplimit inside latch)\r\npmamount\t= ramplimit(pmamount, 0.01);\r\n\r\ncarrierPhase\t= (phasor(freq_a + (fmm*modulator*fmamount))*twopi) + (modulator*pmamount);\r\ncarrierCos\t\t= cos(carrierPhase + carrierCosFb);\r\ncarrierSin\t\t= sin(carrierPhase + carrierSinFb);\r\n\r\nif (carfb_a > 0) {\r\n\tcarrierCosFb\t= fixdenorm(lpfir3(carfb_a*carrierCos));\r\n\tcarrierSinFb\t= fixdenorm(lpfir3(carfb_a*carrierSin));\r\n}\r\n\r\nout1\t= dcblock(carrierCos);\r\nout2\t= dcblock(carrierSin);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 7,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 34.0, 58.0, 879.0, 732.0 ]
                }
