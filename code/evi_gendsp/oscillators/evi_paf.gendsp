                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 49.0, 673.0, 157.0, 22.0 ],
                    "text": "out 1 (signal) PAF Oscillator"
                }
            }
