            {
                "box": {
                    "code": "\r\n// a basic PAF (WavePacket) oscillator\r\n\r\nrequire(\"evi_trig.genexpr\");\r\nrequire(\"evi_rcfilters.genexpr\");\r\n\r\n// like a Puckette wavepacket alternative to PAF\r\nwavePacket(ph, cf, bw)\r\n{\r\n\tsync\t= delta(ph) < 0;\r\n\tph05\t= ph - 0.5;\r\n\tpacket\t= (cos73((ph05 * latch(cf, sync)) * twopi)) * (cos73(clip((ph05 * latch(bw, sync)), -0.5, 0.5) * twopi) + 1);\r\n\treturn\tdcblock(packet) * 0.5;\r\n}\r\n\r\nParam\thighpass(31.25, min=10, max=1000);\r\ng       = rcPreWarp1(highpass);\r\n\r\nfund\t= clip(in1, 0, 18000);\r\ninvfund\t= 1 / fund;\r\n\r\ncff\t\t= in2 * invfund;\r\nbwf\t\t= maximum((in3 * invfund), 1);\r\n\r\nph0\t\t= phasor(fund, in4);\r\nph180\t= wrap((ph0 + 0.5), 0, 1);\r\n\r\npackt1\t= wavePacket(ph0, cff, bwf);\r\npackt2\t= wavePacket(ph180,\tcff, bwf);\r\n\r\nWP\t\t= dcblock(packt1 + packt2);\r\n\r\nout1\t= rcFilterHp(WP, g);\r\nout2\t= packt1;\r\nout3\t= packt2;\r\nout4    = ph0;\r\nout5    = ph180;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 4,
                    "numoutlets": 5,
                    "outlettype": [ "", "", "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 960.0, 598.0 ]
                }
            },
