                    "patching_rect": [ 553.0, 19.0, 238.0, 22.0 ],
                    "text": "in 2 Mix 0..1 @default 0.5 @min 0 @max 1"
                }
            },
            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 19.0, 193.0, 22.0 ],
                    "text": "in 1 Frequency in Hz @default 100"
                }
            },
            {
                "box": {
                    "code": "\r\n// Pete: my porting of this algorithm is a bit stupid with the phasor(), I do not\n// like it, @see: \"evi_audiodust.gendsp\" for different algorithm (compared to\r\n// \"sparseNoise\"), but if you need velvet noise in evieve, this is it\nsparseVelvetNoise(freq, mix, amp=1)\n{\n\tHistory\t\tprevClock(0), prevXos(0);\n\n\tXoshiro256\t=  noise();\n\tclock\t\t=  phasor(freq);\n\tlatchRandom\t= (latch(Xoshiro256, (clock - prevClock)) * 0.5) + 0.5;\n\n\tsparseNoise\t= prevXos * ((clock >= latchRandom) * (prevClock < latchRandom));\n\tprevClock\t= clock;\n\tprevXos\t\t= Xoshiro256;\n\n\tvelvetNoise\t= (sign(sparseNoise) * amp);\n\tmixNoise\t= interp(mix, sparseNoise, velvetNoise, mode=\"cosine\");\n\n\treturn\t\tmixNoise, sparseNoise, velvetNoise;\n}\n\r\nParam\tamplitude(1, min=0, max=1);\r\n\r\nout1, out2, out3\t= sparseVelvetNoise(in1, in2, amp=amplitude);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 3,
                    "outlettype": [ "", "", "" ],
                    "patching_rect": [ 49.0, 60.0, 670.0, 434.0 ]
                }
            },
            {
                "box": {
                    "id": "obj-4",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 49.0, 515.0, 290.0, 22.0 ],
                    "text": "out 1 Mixed Sparse..Velvet (Based on \"in 2\" Mix 0..1)"
                }
            },
            {
                "box": {
                    "id": "obj-9",
                    "linecount": 4,
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 244.0, 0.0, 306.0, 60.0 ],
                    "text": "sort of based on: Matti Karjalainen and Hanna Jarvelainen, \"Reverberation Modeling Using Velvet Noise\", in Proc. 30th Int. Conf. Intelligent Audio Environments (AES07), March 2007."
                }
            }
