				"box" : 				{
					"code" : "\n// ZDF version of [reson~] with smoothing etc, for evieve\n\n// library\n\r\nrequire(\"evi_band_reson_lib.genexpr\");\r\n\r\n// declare\r\n\r\nParam\t\t\tHz(20, min=1, max=22000);\r\nParam\t\t\tQ(0.044194, min=0.01, max=100000);\r\nParam\t\t\tSmooth(20, min=0, max=1000);\r\n\r\n// param rate\r\n\r\nsmoothsamps\t\t= mstosamps(Smooth);\r\n\r\n// keep this out of the while loop\r\na0, a1, a2, b1\t= svfCoeffReson(Hz, Q);\r\n\r\n// filter\r\ny\t\t\t\t= svfSectionReson(in1, a0, a1, a2);\n\nout1\t\t\t= y * eviLine(b1, smoothsamps);\n\r\n",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 12.0,
