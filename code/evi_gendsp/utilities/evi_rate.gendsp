            {
                "box": {
                    "code": "\r\n// do not use this if you need standard rate() features, use rate() instead\r\n// here we reset the rate ramp everytime the sync source changes\r\n\r\nrequire(\"evi_counting.genexpr\");\r\n\r\n// sync: 0 = lock, 1 = off, 2 = cycle <<-- MSP / Gen native ordering, not me !\nParam   sync(0, min=0, max=2);\r\nrs      = int(sync);\r\nreset   = (delta(change(rs)) < 0) + in3;\r\n\r\nout1 = eviRate(in1, in2, reset, sync=rs);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
