, 			{
				"box" : 				{
					"code" : "\r\n// cheaper than 'exp()', more accurate than 'fastexp()'\nexpA(x0)\n{\n\tx = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;\n\tx *= x; x *= x; x *= x; x *= x; x *= x;\n\treturn x;\n}\n\r\nmtofApproxBaseless(pitch)\n{\n\tmtofA = 440 * expA(0.05776226504666 * (pitch - 69));\n\treturn mtofA + 0.120906;\t\t// + offset = accurate for input 48..69\n}\n\nmtofApprox(pitch, base)\t\t\t\t// 'base' should be 440 (hz) for default operation\n{\n\tmtofA = base * expA(0.05776226504666 * (pitch - 69));\n\treturn mtofA + 0.120906;\t\t// + offset = accurate for input 48..69\n}\n\n// by alex harker, perfect accuracy, more expensive than above, but cheaper than 'mtof()'\nmtofApproxPrecision(pitch)\n{\n\tmtofMul\t= 0.05776226504666;\t\t// N.B.\tmtofMul = log(2) / 12\n\tmtofAdd\t= 2.10117843869262;\t\t// N.B.\tmtofAdd = log(440) - (log(2) * 69 / 12)\n\n\treturn\texp((mtofMul * pitch) + mtofAdd);\t// full exp\n}\n\r\nParam\tbase(440, min=415, max=467);\r\nParam\talgo(0, min=0, max=2);\r\nselect\t= int(algo);\r\n\r\nfrequency\t= 0;\r\nif (select == 1) {\r\n\tfrequency\t= mtofApprox(in1, base);\r\n} else if (select == 2) {\r\n\tfrequency\t= mtofApproxPrecision(in1);\r\n} else {\t// select == 0\t// default\r\n\tfrequency\t= mtofApproxBaseless(in1);\r\n}\r\n\r\nout1\t= frequency;\r\n\r\n",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 12.0,
