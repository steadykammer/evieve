{
    "patcher": {
        "fileversion": 1,
        "appversion": {
            "major": 9,
            "minor": 2,
            "revision": 0,
            "architecture": "x64",
            "modernui": 1
        },
        "classnamespace": "dsp.gen",
        "rect": [ 34.0, 100.0, 1050.0, 848.0 ],
        "gridonopen": 2,
        "subpatcher_template": "sub",
        "integercoordinates": 1,
        "boxes": [
            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 19.0, 28.0, 22.0 ],
                    "text": "in 1"
                }
            },
            {
                "box": {
                    "code": "\r\n// evieve: A horrible and expensive in-gen~ window maker template that you should probably never use.\r\n\r\n// utility for KAISER windows\r\ngetBessel(x)\r\n{\r\n\tSum = 0;\r\n\tfor (i = 1; i < 10; i += 1) {\r\n\t\tXtoIpower\t= pow(x / 2, i);\r\n\t\tFactorial\t= 1;\r\n\t\tfor (j = 1;  j  <= i;  j += 1)\r\n\t\t\tFactorial\t*= j;\r\n\t\tSum\t\t   += pow(XtoIpower / Factorial, 2);\r\n\t}\r\n\treturn\t(1 + Sum);\r\n}\r\n\r\n// untility for SINC windows\r\nmakeSinc(x)\r\n{\r\n\toutSinc\t\t= 0;\r\n\r\n\tif (x > -1.0E-5 && x < 1.0E-5)\r\n\t\toutSinc\t= 1;\r\n\telse\r\n\t\toutSinc\t= sin(x) / x;\r\n\r\n\treturn\toutSinc;\r\n}\r\n\r\n//-----------------------------------------------------------------------------\r\n\r\n//Buffer\tWindowData();\t\t\t\t// temp alias for testing\r\nData\t\tWindowData(65536, 1);\t\t// use inside gen~\r\n// init: create window on instantiation only\r\nHistory\t\tinit(1);\r\n// 0, kaiser, sinc, sine, hann, hamming, blackman, flattop, blackman-harris, \r\n// blackman-nutall, nutall, kaiser-bessel, trapezoid, gauss, 14\r\nParam\t\twindow(5, min=0, max=15);\r\n// points: size of window\r\nParam\t\tpoints(9, min=0, max=13);\t// ...\r\n// alpha: not for kaiser or flattop\r\nParam\t\talpha(0, min=0, max=1);\t\t// 0..1\t// create flat top width\r\n// beta: Kaiser, Sinc, and Sine windows only\r\nParam\t\tbeta(0.1, min=0, max=1);\t// 0..1\t// transition bandwidth and sidelobe levels\r\n// gain: usually use 'true', but do not use with FIR filter design\r\nParam\t\tgain(1, min=0, max=1);\t\t// default true\r\n// sinc windows:\r\nParam\t\tzerocrossings(8, min=1, max=16384);\t// # of zero crossings in sinc\r\n\r\nxings\t\t= int(zerocrossings);\t\t// int, 1++\r\nUnityGain\t= int(gain);\t\t\t\t// bool\r\nWindowType\t= int(window);\t\t\t\t// 1..14\r\nwSize\t\t= dim(WindowData);\r\nipoints\t\t= int(points) + 1;\t\t\t// 1..14\r\nspoints\t\t= selector( ipoints, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536 );\r\nN\t\t\t= minimum( spoints, wSize );\t\t\t\t\t// not strictly needed in this setup\r\nnotWin\t\t= ( WindowType < 1 || WindowType > 14 );\t    // zeros\r\nnotZero\t\t= ( WindowType > 0 );\t\t\t\t\t\t\t// ignores\r\n\r\nif ( init * notZero > 0 ) {\r\n\r\n\t// ( WindowType == KAISER ||  WindowType == FLATTOP )\r\n\tAlpha\t= ( WindowType == 1 || WindowType == 8 || notWin ) ? 0 : alpha;\r\n\tBeta\t= beta * 10;\t\t\t\t// 0..10\r\n\r\n\tTopWidth\t\t= int( Alpha * float(N) );\r\n\tif ( TopWidth % 2 != 0 )\r\n\t\tTopWidth   += 1;\r\n\tif ( TopWidth > N )\r\n\t\tTopWidth\t= N;\r\n\r\n\tM\t=  N - TopWidth;\r\n\tMh\t=  M / 2;\r\n\tMd\t=  M + 1;\r\n\tMdh\t= Md / 2;\r\n\r\n\t// -------\r\n\r\n\t// calculate the window for N/2 points, then fold the window over afterwards\r\n\t// TopWidth points set to 1\r\n\r\n\tif\t\t( WindowType == 1 ) {\t\t\t\t\t// (WindowType == KAISER)\r\n   \t\tfor (j = 0; j < M; j += 1) {\r\n\t\r\n\t\t\tTemp\t= Beta * sqrt( 1 - pow( (float((2 * j) + 2) - Md) / Md, 2 ) );\r\n\t\t\tTemp\t= getBessel(Temp) / getBessel(Beta);\r\n\t \t\tpoke( WindowData, Temp, j, 0, index=\"samples\" );\r\n\t\t}\r\n  \t}\r\n\r\n\t// LANCZOS for xings = 1\r\n\telse if ( WindowType == 2 ) {\t\t\t\t\t// (WindowType == SINC)\r\n\t\tfor (j = 0; j < M; j += 1) {\r\n\t\t\tTemp\t= makeSinc( ( float((2 * j) + 1 - M) / Md * PI ) * xings );\r\n\t\t\tpoke( WindowData, ( pow( Temp, Beta ) ), j, 0, index=\"samples\" );\r\n\t\t}\r\n  \t}\r\n\r\n\telse if ( WindowType == 3 ) {\t\t\t\t\t// (WindowType == WINDOWED_SINC)\r\n\t\tfor (j = 0; j < M; j += 1) {\r\n\r\n\t\t\tTempSinc\t= makeSinc( ( float((2 * j) + 1 - M) / Md * PI ) * xings );\r\n\r\n\t\t\tTempKaiser\t= Beta * sqrt( 1 - pow( (float((2 * j) + 2) - Md) / Md, 2 ) );\r\n\t\t\tTempKaiser\t= getBessel(TempKaiser) / getBessel(Beta);\r\n\r\n\t\t\tpoke( WindowData, ( TempSinc * TempKaiser ), j, 0, index=\"samples\" );\r\n\t\t}\r\n  \t}\r\n\r\n\t// HANN if Beta = 2\r\n \telse if ( WindowType == 4 ) {\t\t\t\t\t// (WindowType == SINE)\r\n   \t\tfor (j = 0; j < Mh; j += 1) {\r\n\t\t\tTemp\t= sin(float(j + 1) * PI / Md);\r\n\t\t\tpoke( WindowData, ( pow( Temp, Beta ) ), j, 0, index=\"samples\" );\r\n\t\t}\r\n  \t}\r\n\r\n\t// towards TUKEY if Alpha > 0\r\n\telse if ( WindowType == 5 ) {\t\t\t\t\t// (WindowType == HANN)\r\n\t\tfor (j = 0; j < Mh; j += 1) {\r\n\t\t\tpoke( WindowData, ( 0.5 - 0.5 * cos(float(j + 1) * TWOPI / Md) ), j, 0, index=\"samples\" );\r\n\t\t}\r\n\t}\r\n\r\n\telse if ( WindowType == 6 ) {\t\t\t\t\t// (WindowType == HAMMING)\r\n\t\tfor (j = 0; j < Mh; j += 1) {\r\n\t\t\tpoke( WindowData, ( 0.54 - 0.46 * cos(float(j + 1) * TWOPI / Md) ), j, 0, index=\"samples\" );\r\n\t\t}\r\n\t}\r\n\r\n\telse if ( WindowType == 7 ) {\t\t\t\t\t// (WindowType == BLACKMAN)\r\n\t\tfor (j = 0; j < Mh; j += 1) {\r\n\t\t\tTemp\t= 0.42\r\n\t\t\t- 0.50 * cos(float(j + 1) * TWOPI / Md)\r\n\t\t\t+ 0.08 * cos(float(j + 1) * TWOPI * 2 / Md);\r\n\t\t\tpoke( WindowData, Temp, j, 0, index=\"samples\" );\r\n\t\t}\r\n\t}\r\n\r\n\telse if ( WindowType == 8 ) {\t\t\t\t\t// (WindowType == FLATTOP)\r\n\t\tfor (j = 0; j <= Mh; j += 1) {\r\n\t\t\tfjp12p\t= float(j + 1) * TWOPI;\r\n\t\t\tTemp\t= 1\r\n\t \t\t- 1.93293488969227 * cos( fjp12p\t / Md )\r\n\t \t\t+ 1.28349769674027 * cos( fjp12p * 2 / Md )\r\n\t \t\t- 0.38130801681619 * cos( fjp12p * 3 / Md )\r\n\t \t\t+ 0.02929730258511 * cos( fjp12p * 4 / Md );\r\n\t\t\tpoke( WindowData, ( Temp / ((UnityGain * 3.7) + 1) ), j, 0, index=\"samples\" );\t// dumb pete hack\r\n\t\t}\r\n  \t}\r\n\r\n\telse if ( WindowType == 9 ) {\t\t\t\t\t// (WindowType == BLACKMAN_HARRIS)\r\n\t\tfor (j = 0; j < Mh; j += 1) {\r\n\t\t\tTemp\t= 0.35875\r\n\t \t\t- 0.48829 * cos( float(j + 1) * TWOPI / Md )\r\n\t \t\t+ 0.14128 * cos( float(j + 1) * TWOPI * 2 / Md )\r\n\t \t\t- 0.01168 * cos( float(j + 1) * TWOPI * 3 / Md );\r\n\t\t\tpoke( WindowData, Temp, j, 0, index=\"samples\" );\r\n\t\t}\r\n\t}\r\n\r\n\telse if ( WindowType == 10 ) {\t\t\t\t\t// (WindowType == BLACKMAN_NUTTALL)\r\n\t\tfor (j = 0; j < Mh; j += 1) {\r\n \t\t\tTemp\t= 0.3535819\r\n\t \t\t- 0.4891775 * cos( float(j + 1) * TWOPI / Md )\r\n\t \t\t+ 0.1365995 * cos( float(j + 1) * TWOPI * 2 / Md )\r\n\t \t\t- 0.0106411 * cos( float(j + 1) * TWOPI * 3 / Md );\r\n\t\t\tpoke( WindowData, Temp, j, 0, index=\"samples\" );\r\n\t\t}\r\n  \t}\r\n\r\n\telse if ( WindowType == 11 ) {\t\t\t\t\t// (WindowType == NUTTALL)\r\n   \t\tfor (j = 0; j < Mh; j += 1) {\r\n\t\t\tTemp\t= 0.355768\r\n\t \t\t- 0.487396 * cos( float(j + 1) * TWOPI / Md )\r\n\t \t\t+ 0.144232 * cos( float(j + 1) * TWOPI * 2 / Md )\r\n\t \t\t- 0.012604 * cos( float(j + 1) * TWOPI * 3 / Md );\r\n\t\t\tpoke( WindowData, Temp, j, 0, index=\"samples\" );\r\n\t\t}\r\n\t}\r\n\r\n\telse if ( WindowType == 12 ) {\t\t\t\t\t// (WindowType == KAISER_BESSEL)\r\n   \t\tfor (j = 0; j <= Mh; j += 1) {\r\n\t\t\tTemp = 0.402\r\n\t \t\t- 0.498 * cos(\t\tTWOPI * float(j + 1) / Md )\r\n\t \t\t+ 0.098 * cos( 2 *  TWOPI * float(j + 1) / Md )\r\n\t \t\t+ 0.001 * cos( 3 *  TWOPI * float(j + 1) / Md );\r\n\t\t\tpoke( WindowData, Temp, j, 0, index=\"samples\" );\r\n\t\t}\r\n  \t}\r\n\r\n\t// RECTANGLE for Alpha = 1, TRIANGLE for Alpha = 0\r\n\telse if ( WindowType == 13 ) {\t\t\t\t\t// (WindowType == TRAPEZOID)\r\n\t\tK = int(Mh);\r\n\t\tif (M % 2)\r\n\t\t\tK += 1;\r\n\t\tfor (j = 0; j < K; j += 1) {\r\n\t\t\tpoke( WindowData, ( float(j + 1) / float(K) ), j, 0, index=\"samples\" );\r\n\t\t}\r\n\t}\r\n\r\n\t// This definition is from http://en.wikipedia.org/wiki/Window_function (Gauss Generalized normal window)\r\n\t// We set their p = 2, and use Alpha in the numerator, instead of Sigma in the denominator, as most others do.\r\n\t// Alpha = 2.7183 puts the Gauss window response midway between the Hanning and the Flattop (basically what we want).\r\n\t// It also gives the same BW as the Gauss window used in the HP 89410A Vector Signal Analyzer.\r\n\telse if ( WindowType == 14 ) {\t\t\t\t\t// (WindowType == GAUSS)\r\n\t\tfor (j = 0; j < Mh; j += 1) {\r\n \t\t\tTemp\t= ( float(j + 1) - Mdh ) / Mdh * e;\r\n\t\t\tTemp   *= Temp;\r\n\t\t\tpoke( WindowData, ( exp(-Temp) ), j, 0, index=\"samples\" );\r\n\t\t}\r\n\t}\r\n\r\n\telse {\t\t\t\t\t\t\t\t\t\t\t// zero for now\r\n\t\tfor (j = 0; j < N; j += 1) {\r\n\t\t\tpoke(WindowData, 0, j, 0, index=\"samples\");\r\n\t\t}\r\n \t}\r\n\r\n\t// -------\r\n\r\n\t// fold the coefficients over\r\n\tfor (j = 0; j < Mh; j += 1) {\r\n\t\tTemp\t= peek( WindowData, j, 0, interp=\"none\" );\r\n\t\tpoke( WindowData, Temp, (N - j - 1), 0, index=\"samples\" );\r\n\t}\r\n\r\n\t// flat top if Alpha > 0, cannot be applied to a KAISER or FLATTOP\r\n\tif ( WindowType != 1 &&  WindowType != 8 ) {// WindowType != KAISER && != FLATTOP\r\n\t\tfor (j = Mh; j < (N - Mh); j += 1) {\r\n\t\t\tpoke( WindowData, ( 1 - notWin ), j, 0, index=\"samples\" );\r\n\t\t}\r\n\t}\r\n\r\n\t// UnityGain = true will set the gain of these windows to 1; Do not use this with FIR filter design\r\n\tif ( UnityGain ) {\r\n\t\tSum\t\t\t\t = 0;\r\n\t\tTemp\t\t\t = 0;\r\n\t\tfor (j = 0; j < N; j += 1) {\r\n\t\t\tSum\t\t\t+= peek( WindowData, j, 0, interp=\"none\" );\r\n\t\t}\r\n\t\tSum\t/= float(N);\r\n\t\tif (Sum != 0) {\r\n\t\t\tfor (j = 0; j < N; j += 1)\r\n\t\t\t\tTemp\t/= Sum;\r\n\t\t\t\tpoke( WindowData, Temp, j, 0, index=\"samples\" );\r\n\t\t}\r\n\t}\r\n\r\n\t// finally zero remainder\r\n\tfor (i = N; i < wSize; i += 1) {\r\n\t\tpoke(WindowData, 0, i, 0, index=\"samples\");\r\n\t}\r\n\t// & zero scratch buffer\r\n/*\tfor (i = 0; i < wSize; i += 1) {\r\n\t\tpoke(WindowData, 0, i, 1, index=\"samples\");\r\n\t}\r\n*/\r\n\tinit\t= 0;\t\t\t\t\t\t\t\t\t// deactivate once initialised\r\n}\r\n\r\n//---------------------------------------------------------------------------\r\n\r\ndummy\t= in1 + 0;\r\nout1\t= 0;\r\n\r\n//---------------------------------------------------------------------------\r\n\r\n/*\r\n Iowa Hills Software, LLC\n www.IowaHills.com\n May 1, 2016\n\r\n These are the window definitions. These windows can be used for either\r\n FIR filter design or with an FFT for spectral analysis.\r\n For definitions, see this article:  http://en.wikipedia.org/wiki/Window_function\r\n\r\n This function has 6 inputs\r\n Data is the array, of length N, containing the data to to be windowed.\r\n This data is either an FIR filter sinc pulse, or the data to be analyzed by an fft.\r\n\r\n WindowType is an enum defined in the header file.\r\n e.g. wtKAISER, wtSINC, wtHANNING, wtHAMMING, wtBLACKMAN, ...\r\n\r\n Alpha sets the width of the flat top.\r\n Windows such as the Tukey and Trapezoid are defined to have a variably wide flat top.\r\n As can be seen by its definition, the Tukey is just a Hanning window with a flat top.\r\n Alpha can be used to give any of these windows a partial flat top, except the Flattop and Kaiser.\r\n Alpha = 0 gives the original window. (i.e. no flat top)\r\n To generate a Tukey window, use a Hanning with 0 < Alpha < 1\r\n To generate a Bartlett window (triangular), use a Trapezoid window with Alpha = 0.\r\n Alpha = 1 generates a rectangular window in all cases. (except the Flattop and Kaiser)\r\n\r\n\r\n Beta is used with the Kaiser, Sinc, and Sine windows only.\r\n These three windows are used primarily for FIR filter design. Then\r\n Beta controls the filter's transition bandwidth and the sidelobe levels.\r\n All other windows ignore Beta.\r\n\r\n UnityGain controls whether the gain of these windows is set to unity.\r\n Only the Flattop window has unity gain by design. The Hanning window, for example, has a gain\r\n of 1/2.  UnityGain = true  sets the gain to 1, which preserves the signal's energy level\r\n when these windows are used for spectral analysis.\r\n\r\n Don't use this with FIR filter design however. Since most of the enegy in an FIR sinc pulse\r\n is in the middle of the window, the window needs a peak amplitude of one, not unity gain.\r\n Setting UnityGain = true will simply cause the resulting FIR filter to have excess gain.\r\n\r\n If using these windows for FIR filters, start with the Kaiser, Sinc, or Sine windows and\r\n adjust Beta for the desired transition BW and sidelobe levels (set Alpha = 0).\r\n While the FlatTop is an excellent window for spectral analysis, don't use it for FIR filter design.\r\n It has a peak amplitude of ~ 4.7 which causes the resulting FIR filter to have about this much gain.\r\n It works poorly for FIR filters even if you adjust its peak amplitude.\r\n The Trapezoid also works poorly for FIR filter design.\r\n\r\n If using these windows with an fft for spectral analysis, start with the Hanning, Gauss, or Flattop.\r\n When choosing a window for spectral analysis, you must trade off between resolution and amplitude\r\n accuracy. The Hanning has the best resolution while the Flatop has the best amplitude accuracy.\r\n The Gauss is midway between these two for both accuracy and resolution. These three were\r\n the only windows available in the HP 89410A Vector Signal Analyzer. Which is to say, these three\r\n are the probably the best windows for general purpose signal analysis.\r\n*/\r\n\r\n//---------------------------------------------------------------------------\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 946.0, 732.0 ]
                }
            },
