                    "id": "obj-4",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 34.0, 691.0, 264.0, 22.0 ],
                    "text": "out 1 (int) Number of Zerocrossings per Window"
                }
            },
