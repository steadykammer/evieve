            {
                "box": {
                    "code": "\r\n// basically from the RNBO operator, with additions\r\nlikeZerox(x, r, windowSize=0, threshold=0.1)\n{\r\n\tHistory\tcount(0), index(0);\n\tHistory\tlastSign(0), lastCount(0);\r\n\tHistory\tlastWindowSize(64);\r\n\n\tif ( ((windowSize > 1) && (windowSize != lastWindowSize)) || (r) ) {\n\t\tcount = 0;\n\t\tindex = 0;\n\t\tlastSign = 0;\n\t\tlastWindowSize = windowSize;\n\t\tlastCount = 0;\n\t}\n\r\n\tcurrentSign = x < 0;\r\n\tcrossing = change(currentSign);\n\tif (currentSign != lastSign) {\n\t\tcount += 1;\n\t}\n\tlastSign = currentSign;\n\tindex += 1;\n\n\tif (index >= lastWindowSize) {\n\t\tlastCount = count;\n\t\tcount = 0;\n\t\tindex = 0;\n\t}\n\tvoiced = (lastCount / lastWindowSize) > threshold;\r\n\r\n\treturn lastCount, voiced, crossing;\n}\n\r\nParam\tsize(vectorsize, min=1, max=4096);\t// window in samples (default vectorsize)\r\nParam\tthresh(0.1, min=0, max=1);\t\t\t// thresh in amplitude (default -20dB)\n\r\nout1, out2, out3\t= likeZerox(in1, in2, windowSize=size, threshold=thresh);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 3,
                    "outlettype": [ "", "", "" ],
                    "patching_rect": [ 34.0, 59.0, 696.0, 615.0 ]
                }
            },
