            {
                "box": {
                    "code": "\r\n// exact ramp smoothing, like MSP [line~], with reset function\n// @see also: evi_line, evi_sline, evi_curve, evi_rampsmooth, etc\r\n\n// basic linear scaling like linear part of [scale]\nlineMap(valueIn, inLow, inHigh, outLow, outHigh)\n{\n\tmultiplier = (outLow - outHigh) / (inLow - inHigh);\n\treturn (valueIn - inLow) * multiplier + outLow;\n}\n\neviLineReset(target, duration, reset)       // target, duration in samples, sample reset\n{\n\tHistory\tvalue(0), init(1);\r\n    if (reset) {\r\n        value = 0;\r\n    }\n\ttrigger\t= change(target);\n\tramp\t= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);\n\tline\t= lineMap(ramp, 0, 1, latch((value + (target * init)), trigger), latch(target, trigger));\n\tvalue\t= line;\r\n    init    = 0;\n\treturn\tline, (ramp == 1);\n}\n\r\nout1, out2 = eviLineReset(in1, in2, in3);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 34.0, 58.0, 796.0, 441.0 ]
                }
            },
