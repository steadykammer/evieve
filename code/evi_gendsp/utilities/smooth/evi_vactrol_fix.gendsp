                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 49.0, 616.0, 161.0, 22.0 ],
                    "text": "out 1 Fixed Vactrol Envelope"
                }
            }
