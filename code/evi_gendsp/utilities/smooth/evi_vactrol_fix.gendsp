                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 19.0, 114.0, 22.0 ],
                    "text": "in 1 Trigger Impulse"
                }
            },
            {
                "box": {
                    "code": "\r\n// A fixed vactrol shape with no rise/fall times to specify and input limited to 0..1,\r\n// a cheap drop-in vactrol-like envelope.\r\n// For more fully featured vactrol-like behaviour @see:\r\n// evi_vactrol.gendsp & evi_vactrol_shape.gendsp\r\n\r\nvactrolUD(x, a)\t\t\t\t\t\t// trigger, time\n{\n\treturn x * a / (1 + a);\n}\n\nvactrolFixed(impulse)\t\t\t\t// trigger (internally clamped 0..1)\n{\n\tHistory s1(0);\n\ta_base\t= 3141.592653589793238 / SAMPLERATE;// 1000*PI/samplerate\r\n\r\n\tt_down\t= 10 + 3000*(1 - 0.9*s1);\t\t    // fall time\n\ta_down\t= a_base / t_down;\n\tt_up\t= 1 + 20*(1 - 0.999*s1);\t\t    // rise time\n\ta_up\t= a_base / t_up;\n\r\n    i       = clip(impulse, 0, 1);              // this cheap vactrol will only work if clamped\r\n\tx\t\t= i - s1;\n\tx \t\t= (x < 0) ? vactrolUD(x, a_down) : vactrolUD(x, a_up);\n\ty\t\t= x + s1;\n\ts1\t\t= y + x;\n\r\n\treturn\t  y;\n}\r\n\r\nParam\tscalar(1, min=1, max=10000);            // input clipped, but we can scale the output\r\n\r\nout1    = vactrolFixed(in1) * scalar;           // should abs(in1) ?\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 775.0, 541.0 ]
                }
            },
