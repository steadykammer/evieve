            {
                "box": {
                    "code": "\r\n// exact ramp smoothing, like MSP [line~] but with additional \"S-Curve\" option\n// @see also: evi_line, evi_curve, evi_rampsmooth, etc\r\n\neviScurve(segment)\t\t\t\t\t\t// segment must be linear ramp 0..1\n{\n\ts2\t\t= segment * segment;\n\trec\t\t= 1 - segment;\n\tr2\t\t= rec * rec;\n\treturn\t(segment < 0.5) ? (s2 * 2) : (1 - (r2 * 2));\n}\n\n// basic linear scaling like linear part of [scale]\neviMap(valueIn, inLow, inHigh, outLow, outHigh)\n{\n\tmultiplier = (outLow - outHigh) / (inLow - inHigh);\n\treturn (valueIn - inLow) * multiplier + outLow;\n}\n\r\neviSline(target, duration)\t\t\t\t// target, duration in samples\n{\n\tHistory\tvalue(0), init(1);\n\ttrigger\t= change(target);\n\tramp\t= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);\n\tcramp\t= eviScurve(ramp);\n\tcurve\t= eviMap(cramp, 0, 1, latch((value + (target * init)), trigger), latch(target, trigger));\n\tvalue\t= curve;\r\n    init    = 0;\n\treturn\tcurve, (ramp == 1);\n}\r\n\r\nout1, out2 = eviSline(in1, in2);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 34.0, 58.0, 807.0, 524.0 ]
                }
