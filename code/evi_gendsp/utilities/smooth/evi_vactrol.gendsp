                }
            },
            {
                "box": {
                    "code": "// Vactrol time-domain behaviour filter.\r\n// @see also: evi_vactrol_fix.gendsp & evi_vactrol_shape.gendsp\r\n\r\n// A basic not-really-a-model of the Perkin Elmer VTL5C3, the resistive\r\n// part of a photoresistive opto-isolator.\r\n// As it turns out, the shape (not the behaviour) can be similar to [slide~]\r\n// in MSP/RNBO or [slide] in gen~, achievable via the @shape parameter here.\r\n\r\nvactrolSection(x, a)                        // trigger history, coefficient\r\n{\r\n\treturn x * a / (1 + a);\r\n}\r\n// if 'i' is a single sample 'click', scaling must happen externally\r\nvactrolBuchla(i, r, f, b)       // impulse, rise (samps), fall (samps), base (Hz)\n{\n\tHistory s1(0);\r\n    // it would be good to cache all this, but difficult because of 's1'\r\n\ta_base\t= b*PI/SAMPLERATE;              // b = frequency (default 1016.898263)\r\n\tt_down\t= 10 + f*(1 - 0.9*s1);\n\ta_down\t= a_base/t_down;                // fall coefficient\n\tt_up\t= 1 + r*(1 - 0.999*s1);\n\ta_up\t= a_base/t_up;                  // rise coefficient\r\n\r\n    // is it dangerous not to clip 'i' -1..1 ?? (yes)\r\n\tx\t\t= clamp(i, -1, 1) - s1;\n\tz \t\t= (x < 0) ? vactrolSection(x, a_down) : vactrolSection(x, a_up);\n\ty\t\t= z + s1;\n\ts1\t\t= y + z;\n\treturn\t  y;\t\t\t\t\t\t    // & scale externally\n}\n\r\nParam   shape(0.5, min=0, max=1);           // base frequency, default 1000 Hz\r\nParam\tscalar(1., min=0.1, max=10000);\r\n\r\nbase    = evi_mtofapprox(shape * 81 + 43);  // 100..10000 Hz\r\n\r\nrise\t= in2;\t\t\t\t\t\t\t    // difficult to change\r\nfall\t= in3;\t\t\t\t\t\t\t    // fully changeable\r\n\r\n//mult\t= slide(scalar, rise, rise);\r\nvB      = vactrolBuchla(in1, rise, fall, base);\r\nout1 \t= vB * scalar;//mult;\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 34.0, 62.0, 665.0, 671.0 ]
                }
