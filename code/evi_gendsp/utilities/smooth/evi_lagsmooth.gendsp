            {
                "box": {
                    "code": "\r\nexpA(x0)\n{\n\tx = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;\n\tx *= x; x *= x; x *= x; x *= x; x *= x;\n\treturn x;\n}\n\r\nlagpole(x, c, l)\t\t\t\t\t\t\t// value / coefficient / previous\n{\n//  return ((1 - abs(c)) * x) + (c * l);\r\n\treturn ((1 - c) * x) + (c * l);\t\t\t// no need for abs here ?\n}\n\n// a bit like Supercollider [lag3]\n// original by James MacCartney, mod by me\nlagsmooth(v, lp0)\t\t\t\t\t\t\t// destination value / time (in seconds)\n{\n\tHistory coef(  0.9928302477768374);\t\t// default: @20ms @48kHz\n\tHistory lp1(0), lp2(0), lp3(0);\n\tLOGTH\t= -6.907755278982137;\t\t\t// ln(0.001), fixed threshold of 0.001 (-60 dB)\n\tlp0\t\t= maximum(lp0, 0.008);\t\t\t// <<-- careful! (this is an empirical number)\n\tif (change(lp0))\n\t\tcoef\t= maximum(expA(LOGTH / (lp0 * samplerate)), 0);\n\tlp1\t\t= lagpole(v,\tcoef,\tlp1);\n\tlp2\t\t= lagpole(lp1,\tcoef,\tlp2);\n\tlp3\t\t= lagpole(lp2,\tcoef,\tlp3);\n\treturn\tlp3;\n}\r\n\r\nout1    = lagsmooth(in1, in2*0.001);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 741.0, 518.0 ]
                }
