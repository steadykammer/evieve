            },
            {
                "box": {
                    "id": "obj-2",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 662.0, 19.0, 141.0, 22.0 ],
                    "text": "in 2 (signal) Sync Trigger"
                }
            },
            {
                "box": {
                    "code": "\r\n// 'switch & ramp' with options, overexpensive evieve style\r\n\r\nquartParOneApprox(modphase)\n{\n\tx0\t\t=  modphase - 0.5;\n\t// first quarter    // -0.8284271247461903 = 2 - 4*sqrt1_2\n\tquart\t= -0.8284271247461903 * x0 * x0 + sqrt1_2;\n\tsinq1\t=  quart + x0;\n\tcosq1\t=  quart - x0;\n\n\treturn\tcosq1, sinq1;\n}\r\n\r\neviScurve(segment)\n{\n\ts2\t\t= segment * segment;\n\trec\t\t= 1 - segment;\n\tr2\t\t= rec * rec;\n\treturn\t(segment < 0.5) ? (s2 + s2) : (1 - (r2 + r2));\n}\r\n\r\nHistory ramp(0);\r\n\r\nParam   outblock(1, min=0, max=1); // dcblock output? (not always needed)\r\nParam   shape(0, min=0, max=1); // curve through zero? (very strange option)\r\nParam   curve(0, min=0, max=3); // type: 0=lin, 1=scurve, 2=cos, 3=decay\r\nParam   time(240, min=1, max=samplerate*0.25); // ramp time in samples\r\ncrv     = int(curve);\r\nshp     = bool(shape);\r\nob      = bool(outblock);\r\n\r\nx = in1;\r\ntrig = delta(in2) < 0;\r\nlatchedin = latch(delta(x), trig);\r\n\r\ncrv = latch(crv, trig);\r\nshp = latch(shp, trig);\r\nob = latch(ob, trig);\r\n\r\nramped = 0;\r\nif (crv == 1) { // scurve\r\n    ramp = maximum((trig ? 1 : (ramp-1/time)), 0);\r\n    scurve = eviScurve(ramp);\r\n    scurve = shp ? dcblock(scurve) : scurve;\r\n    ramped = (latchedin * scurve);\r\n}\r\nelse if (crv == 2) { // cos\r\n    ramp = maximum((trig ? 1 : (ramp-1/time)), 0);\r\n    coscurve = quartParOneApprox(1-ramp);\r\n    coscurve = shp ? dcblock(coscurve) : coscurve;\r\n    ramped = (latchedin * coscurve);\r\n}\r\nelse if (crv == 3) { // decay (with hold segment), careful\r\n    retime = sampstoms(time) * 0.2; // :-(\r\n    dcurve = evi_logdecay(evi_trigholdgate(trig, hold=retime), retime);\r\n    dcurve = shp ? dcblock(dcurve) : dcurve;\r\n    ramped = (latchedin * dcurve);\r\n}\r\nelse { // linear (default & cheapest)\r\n    ramp = maximum((trig ? 1 : (ramp-1/time)), 0);\r\n    rshape = shp ? dcblock(ramp) : ramp;\r\n    ramped = (latchedin * rshape);\r\n}\r\n\r\ny = (x - ramped);\r\nout1 = ob ? dcblock(y) : y;\r\nout2 = ramped;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 49.0, 58.0, 632.0, 750.0 ]
                }
            },
