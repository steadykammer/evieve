, 			{
				"box" : 				{
					"code" : "// evieve exact ramp smoothing, expensive ...\r\n// like MSP [line~], with additional \"S-Curve\" option (\"curve\" param, default off)\n\neviScurve(segment)\t\t\t\t\t\t// segment must be linear ramp 0..1\n{\n\ts2\t\t= segment * segment;\n\trec\t\t= 1 - segment;\n\tr2\t\t= rec * rec;\n\treturn\t(segment < 0.5) ? (s2 * 2) : (1 - (r2 * 2));\n}\n\n// basic linear scaling like linear part of [scale]\neviMap(valueIn, inLow, inHigh, outLow, outHigh)\n{\n\tmultiplier = (outLow - outHigh) / (inLow - inHigh);\n\treturn (valueIn - inLow) * multiplier + outLow;\n}\n\neviLine(target, duration)\t\t\t\t// target, duration in samples\n{\n\tHistory\tvalue(0);\n\ttrigger\t= change(target);\n\tramp\t= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);\n\tline\t= eviMap(ramp, 0, 1, latch(value, trigger), latch(target, trigger));\n\tvalue\t= line;\n\treturn\tline, (ramp == 1);\n}\n\r\neviSline(target, duration)\t\t\t\t// target, duration in samples\n{\n\tHistory\tvalue(0);\n\ttrigger\t= change(target);\n\tramp\t= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);\n\tcramp\t= eviScurve(ramp);\n\tcurve\t= eviMap(cramp, 0, 1, latch(value, trigger), latch(target, trigger));\n\tvalue\t= curve;\n\treturn\tcurve, (ramp == 1);\n}\r\n\r\nParam\tcurve(0, min=0, max=1);\r\nsline\t= int(curve);\r\n\r\nevi_line\t= 0;\r\nevi_notify\t= 0;\r\n\r\nif (sline) {\r\n\tevi_line, evi_notify\t= eviSline(in1, in2);\r\n} else {\r\n\tevi_line, evi_notify\t= eviLine(in1, in2);\t// default\r\n}\r\n\r\nout1\t= evi_line;\r\nout2\t= evi_notify;\r\n\r\n",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 12.0,
