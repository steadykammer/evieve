            {
                "box": {
                    "code": "\r\n// evieve Biquad Coefficients Calculator & Filter all in one\r\n\r\nrequire(\"evi_biquad.genexpr\");\r\n\r\n// eviBiquadCoeff(index, cutoff, gain, Q)\n/*\n    index   calculator                              \tparameters\n    0       bypass                                  \tnone\n\t1\t\teviBiquadCoeffLowpass \t\t\t\t\t\tcutoff, Q\n\t2\t\teviBiquadCoeffHighpass \t\t\t\t\t\tcutoff, Q\n\t3\t\teviBiquadCoeffBandpass \t\t\t\t\t\tcutoff, Q\n\t4\t\teviBiquadCoeffNotch \t\t\t\t\t\tcutoff, Q\n\t5\t\teviBiquadCoeffPeakNotch \t\t\t\t\tcutoff, gain, Q\n\t6\t\teviBiquadCoeffLowshelfMSP \t\t\t\t\tcutoff, gain, Q\n\t7\t\teviBiquadCoeffLowshelfCookbook \t\t\t\tcutoff, gain, Q\n\t8\t\teviBiquadCoeffHighshelfMSP \t\t\t\t\tcutoff, gain, Q\n\t9\t\teviBiquadCoeffHighshelfCookbook \t\t\tcutoff, gain, Q\n\t10\t\teviBiquadCoeffResonant \t\t\t\t\t\tcutoff, Q\n\t11\t\teviBiquadCoeffBp \t\t\t\t\t\t\tcutoff, Q\n\t12\t\teviBiquadCoeffAllpass \t\t\t\t\t\tcutoff, Q\n\t13\t\teviBiquadCoeffLowpassGain \t\t\t\t\tcutoff, gain, Q\n\t14\t\teviBiquadCoeffHighpassGain \t\t\t\t\tcutoff, gain, Q\n\t15\t\teviBiquadCoeffBandpassGain \t\t\t\t\tcutoff, gain, Q\n\t16\t\teviBiquadCoeffNotchGain \t\t\t\t\tcutoff, gain, Q\n\t17\t\teviBiquadCoeffResonantGain \t\t\t\t\tcutoff, gain, Q\n\t18\t\teviBiquadCoeffBpGain \t\t\t\t\t\tcutoff, gain, Q\n\t19\t\teviBiquadCoeffAllpassGain \t\t\t\t\tcutoff, gain, Q\n\t20\t\teviBiquadCoeffLowpassAnalog1\t\t\t\tcutoff, Q\n\t21 \t\teviBiquadCoeffLowpassAnalog2\t\t\t\tcutoff, Q\n\t22 \t\teviBiquadCoeffHighpassAnalog\t\t\t\tcutoff, Q\n\t23\t\teviBiquadCoeffBandpassAnalog \t\t\t\tcutoff, Q\n\t24\t\teviBiquadCoeffBandpassGainAnalog \t\t\tcutoff, gain, Q\n\t25 \t\teviBiquadCoeffNotchAnalog \t\t\t\t\tcutoff, Q\n\t26\t\teviBiquadCoeffPeakNotchAnalog1 \t\t\t\tcutoff, gain, Q\n\t27\t\teviBiquadCoeffPeakNotchAnalog2 \t\t\t\tcutoff, gain, Q\n\t28 \t\teviBiquadCoeffLowshelfAnalog1\t\t\t\tcutoff, gain, Q\n\t29\t\teviBiquadCoeffLowshelfAnalog2 \t\t\t\tcutoff, gain\n\t30 \t\teviBiquadCoeffHighshelfAnalog1\t\t\t\tcutoff, gain, Q\n\t31\t\teviBiquadCoeffHighshelfAnalog2 \t\t\t\tcutoff, gain\n\t32 \t\teviBiquadCoeffResonantAnalog\t\t\t\tcutoff, Q\n\t33\t\teviBiquadCoeffButterworthLowpass \t\t\tcutoff\n\t34\t\teviBiquadCoeffButterworthHighpass \t\t\tcutoff\n\t35\t\teviBiquadCoeffButterworthBandpass \t\t\tcutoff, Q\n\t36\t\teviBiquadCoeffButterworthBandreject \t\tcutoff, Q\n\t37\t\teviBiquadCoeffButterworthLowpassGain \t\tcutoff, gain\n\t38\t\teviBiquadCoeffButterworthHighpassGain \t\tcutoff, gain\n\t39\t\teviBiquadCoeffButterworthBandpassGain \t\tcutoff, gain, Q\n\t40\t\teviBiquadCoeffButterworthBandrejectGain \tcutoff, gain, Q\n*/\n\nParam   cutoffunits(0, min=0, max=1);   // 0 = in Hz (default), 1 = in Pitch\r\nParam   gainunits(1, min=0, max=1);     // 0 = linear gain, 1 = gain in dB (default)\r\nParam   filter(0, min=0, max=40);\r\nfilt    = int(filter);\r\ngunits  = int(gainunits);\r\ncfunits = int(cutoffunits);\r\n\r\nQ       = maximum(in4, 0.1);            // standard biquad clipping\r\n\r\ngain    = 1;\r\nif (gunits) {\r\n    gain    = dbtoa(in3);\r\n} else {\r\n    gain    = in3;\r\n}\r\n//gain  = clip(gain, 0.0625, 16);       // like [filtergraph~] ±24dB\r\n\r\ncutoff  = 1000;\r\nif (cfunits) {\r\n    cutoff  = mtof(in2);\r\n} else {\r\n    cutoff  = in2;\r\n}\r\ncutoff  = maximum(cutoff, 1);\r\n\r\nreset   = delta(change(filt)) < 0;\r\na0, a1, a2, b1, b2  = eviBiquadCoeff(filt, cutoff, gain, Q);\r\nout1                = biquadDf2reset(in1, a0, a1, a2, b1, b2, reset);\r\n\r\n",
