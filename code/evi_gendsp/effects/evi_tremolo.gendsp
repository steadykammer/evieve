            {
                "box": {
                    "code": "\r\n// basic tremolo example (is there any other kind?) with selection of LFO shapes and saturation\r\n\r\nrequire(\"evi_crossovers.genexpr\");\r\nrequire(\"evi_counting.genexpr\");\r\nrequire(\"evi_smooth_bank.genexpr\");\r\nrequire(\"evi_adaa.genexpr\");\r\nrequire(\"evi_lfo.genexpr\");\r\n\r\ntremLfoScale(lfo, depth, invdepth, drive, flow)\r\n{\r\n\tosc = ((lfo * depth) + invdepth) * drive;\r\n\treturn mix(drive, osc, flow);\r\n}\r\n\r\ntremAmpMix(xin, lfomix)\r\n{\r\n    History tamdummy(0);\r\n    trem = dcblock(xin * lfomix);\r\n\treturn foldPolyAdaa2(trem);\r\n}\r\n\r\nParam   rate(0.5, min=0, max=1);\r\nParam   depth(0.75, min=0, max=1);\r\nParam   spread(0.25, min=0, max=1);\r\nParam   drive(0.5, min=0, max=1);   // scaled downstream as dB 0..10 saturation range\r\n\r\n// bypass, ramp up, ramp down, tri, sine (default), tanh, square, rand step, rand linear, rand cubic, noise\r\nParam   lfowave(4, min=0, max=10);\r\nParam   lfomode(1, min=0, max=1);   // zero reset 0/1\r\nParam   lfowidth(0.5, min=0, max=1);// pwm 0..1\r\nParam   lfoinvert(0, min=0, max=1); // invert waveform 0/1\r\nParam   lfoskew(1., min=0.5, max=2);// exponent 0.5..2\r\nParam   lfoout(1, min=0, max=1);    // outs4&5 0..1 lfos or amplitude scaled lfos 0/1 ?\r\n\r\nParam   maxhz(11., min=0.1, max=40);        // Hz, range of rate param\r\nParam   crossover(63.5, min=10, max=1000);  // Hz, below is mono saturated bass, above is trem\r\nParam   smooth(15.111, min=0, max=151);     // ms\r\nsmoothsecs = smooth * 0.001;\r\nlfoShape = int(lfowave);\r\nlfoMode = int(lfomode);\r\nlfoInv = int(lfoinvert);\r\nlfoOut = int(lfoout);\r\n\r\nlfoWidth, skew, xover = expsmoothBank3((lfowidth * 0.96 + 0.02), lfoskew, crossover, smoothsecs);\r\nfreqIn, depthIn, spreadIn, driveIn = logsmoothBank4((rate*maxhz), depth, spread, dbtoaApprox(drive*drive*10), smoothsecs);\r\nfreqLow = clip(freqIn, 0, 1);\r\ninvDepth = 1 - depthIn;\r\n\r\nphaseL, phaseR, phaseHz, phaseSpread, syncL, syncR = eviPhasorTwo0(freqIn, spreadIn, in3, minimumhz=0.05, mode=lfoMode);\r\n\r\n// only sync if...\r\nwidthL = lfoMode ? latch(lfoWidth, syncL) : lfoWidth;\r\nwidthR = lfoMode ? latch(lfoWidth, syncR) : lfoWidth;\r\n// always sync\r\nwaveL = latch(lfoShape, syncL);\r\nwaveR = latch(lfoShape, syncR);\r\ninvL = latch(lfoInv, syncL);\r\ninvR = latch(lfoInv, syncR);\r\n\r\nlfo01L = lfoShapes01(phaseL, syncL, widthL, waveL);\r\nlfo01R = lfoShapes01(phaseR, syncR, widthR, waveR);\r\n\r\nlfo01L = invL ? 1 - lfo01L : lfo01L;\r\nlfo01R = invR ? 1 - lfo01R : lfo01R;\r\n\r\nlfo01L = fastskewlfo052ar(lfo01L, skew);\r\nlfo01R = fastskewlfo052ar(lfo01R, skew);\r\n\r\nlfomixL = tremLfoScale(lfo01L, depthIn, invDepth, driveIn, freqLow);\r\nlfomixR = tremLfoScale(lfo01R, depthIn, invDepth, driveIn, freqLow);\r\n\r\nlowL, lowR, inL, inR = eviXover2pole2bandStereo(in1, in2, xover);\r\nlowSat = eCubicAdaa1((lowL + lowR) * 0.555);\r\n\r\nout1 = tremAmpMix(inL, lfomixL) + lowSat;\r\nout2 = tremAmpMix(inR, lfomixR) + lowSat;\r\n\r\nout3 = phaseHz;\r\n\r\nout4 = lfoOut ? lfomixL : lfo01L;\r\nout5 = lfoOut ? lfomixR : lfo01R;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 5,
                    "outlettype": [ "", "", "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 969.0, 732.0 ]
                }
