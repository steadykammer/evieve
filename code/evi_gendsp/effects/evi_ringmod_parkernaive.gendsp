                }
            },
            {
                "box": {
                    "code": "// this is an implementation of the slightly strange Julian Parker 4-diodes RingMod\r\n// @see: \"A Simple Digital Model of the Diode-based Ring-Modulator\", DAFx-11, 2011.\r\n// Hint: this is not good on it's own, not at all usable unless we oversample the hell\r\n// out of it, but if we do throw it in a [poly~ up 16] or [poly~ up 32] it is great!\r\n// TODO: look into Lambert-W & Adaa for the diode part...\r\n\r\npDiode(vin, Vb, VL, H)\t// piece-wise approx\r\n{\r\n\tvout = 0;\r\n\tif (vin <= Vb) {\r\n\t\tvout = 0;\r\n\t} else {\r\n\t\tvlmvb = VL - Vb;\r\n\t\tvlvbmul = 1 / (vlmvb + vlmvb);\r\n\t\tif (vin <= VL) {\r\n\t\t\tvinmvb = vin - Vb;\r\n\t\t\tvout = vinmvb * vinmvb * vlvbmul;\r\n\t\t} else {\r\n\t\t\tvout = vin - (VL - (vlmvb * vlmvb * vlvbmul));\r\n\t\t}\r\n\t\tvout = vout * H;\r\n\t}\r\n\treturn dcblock(vout);\r\n}\r\n\r\npRingmod(car, mod, voltage, knee, slope)\r\n{\r\n\tmoddiv = mod * 0.5;\r\n\tcarin = car + moddiv;\r\n\tmodin = carin - moddiv;\r\n\r\n\tD1 = pDiode(carin, voltage, knee, slope);\r\n\tD2 = pDiode(-carin, voltage, knee, slope);\r\n\tD3 = pDiode(modin, voltage, knee, slope);\r\n\tD4 = pDiode(-modin, voltage, knee, slope);\r\n\r\n\treturn dcblock((D1 + D2) - (D3 + D4));\r\n}\r\n\r\n// diode settings\r\nParam\tvoltage(0.598425, min=0, max=1);\t// soft..hard\r\nParam\tknee(0.598425, min=0, max=1);\t\t// soft..hard\r\nParam\tslope(0.993701, min=0.2, max=1.8);\t// quasi (positive) gain, works just keeping default\r\ninvvolt\t= 1 - voltage;\r\ninvknee\t= invvolt + (1 - knee);\r\n\r\nout1\t= pRingmod(in1, in2, invvolt, invknee, slope);\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 34.0, 61.0, 766.0, 729.0 ]
                }
            },
