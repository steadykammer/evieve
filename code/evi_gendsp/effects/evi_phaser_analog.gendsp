            {
                "box": {
                    "code": "\n// analog-like phaser in the sort of pedal sense (good for mono input but still does quasi stereo well)\n\nrequire(\"evi_smooth_bank.genexpr\");\nrequire(\"evi_rcfilters.genexpr\");\nrequire(\"evi_crossovers.genexpr\");\nrequire(\"evi_lfo.genexpr\");\nrequire(\"evi_adaa.genexpr\");\n\ninputMixCos(xL, xR, stereo)\n{\n\tmonoMix = (xL + xR) * 0.5;\n    yL, yR = xfadeQuartApproxStereo(monoMix, monoMix, xL, xR, stereo);\n\treturn yL, yR, monoMix;\n}\n\noutputMixCos(xL, xR, stereo)\n{\n\tyL = xL;\n\tyR = xfadeQuartApproxMono(xL, xR, stereo);\n\treturn yL, yR;\n}\n\nParam\trate(0.49, min=0, max=8);\nParam\tdepth(0.74, min=0, max=1);\nParam\tcenter(0.52, min=0, max=1);\nParam\tspread(0.632, min=0, max=1);\n\nParam\tduty(0.4, min=0, max=1);\nParam\tshape(0.5, min=0, max=1);\nParam\tskew(1.2, min=0.5, max=2);\r\nParam   zeroreset(0, min=0, max=1);\n\nParam   crossover(104., min=10, max=1000);\nParam   pregain(2., min=-6, max=6);\nParam   postgain(0., min=-6, max=6);\nParam\tfeedback(-0.5, min=-1, max=1);\nParam   smooth(22.666, min=1, max=226);\n\n// advanced, do not use\n//Param   leakymix(0., min=0, max=1); // can be higher than 1 but gets unpredictable\n//Param   lossiness(0.7, min=0, max=1);\n//Param   flavour(0.3, min=-20, max=20);\n//Param   gaintime(2., min=0);\n//Param   gainmode(0, min=0, max=2); // int\n\nHistory circuitM(0), XinAlign(0);\n\nHistory prevNum(7);\nData\tallpassCascade(32, 1); // just change dim() for different available number of stages\nParam\tstages(7, min=2, max=32); // change \"max\" if you change \"dim\"\nmaxSections = dim(allpassCascade);\nnumSections = clamp(int(stages), 2, maxSections);\nnumSectsM1  = numSections - 1; // because final section is solo\nsmoothsecs\t= smooth*0.001;\n\ncentPitch = center * 129;\nrangPitch = centPitch * 0.5;\nrangDepth = depth * rangPitch;\nminPitch = centPitch - rangDepth;\nmaxPitch = minimum((centPitch + rangDepth), 134);\n\nfbsin\t= fastsin(feedback * (((1 - ((maximum(spread, 0.5) - 0.5) * 2)) * 0.75) + 0.75));\nfbpre   = dbtoaApprox(maximum(pregain - (abs(feedback) * 3), -6));\npost    = dbtoaApprox(postgain);\n/*\r\npat     = 0.23283;\nsale\t= (leakymix * leakymix) * pat;\n*/\nomsq12\t\t= 0.2928932188134524; // 1 - sqrt1_2;\nfbattenL\t= 1 - (abs(minimum(fbsin, 0)) * omsq12);\nfbattenR\t= 1 - (maximum(fbsin, 0) * omsq12);\n\nstereoIn\t= spread * 0.61;\nstereoOut   = (spread * 0.82) + 0.18;\n\n// audio rate from here\n\n// smooth\nminPitchS, maxPitchS = cfSmoothLinear2(minPitch, maxPitch, 3, smoothsecs);\nfbsinS, fbpreS, postS = logsmoothBank3(fbsin, fbpre, post, smoothsecs);\nfbattenLs, fbattenRs, stereoInS, stereoOutS = expsmoothBank4(fbattenL, fbattenR, stereoIn, stereoOut, smoothsecs);\nxover = logsmooth(crossover, smoothsecs*1.09);\n\n// lfo\nphase, currentHz, sync = evi_phasor0(rate, 0, mode=zeroreset);\nlfo01\t= lfoMix(phase, duty, shape, skew);\nlfomid\t= mix(minPitchS, maxPitchS, lfo01);\nlfohz\t= mtofApproxBaseless(lfomid);\nlfog    = rcPreWarp2(lfohz);\n\n// audio\nxL      = in1;\nxR      = in2;\nXinL, XinR, Mono  = inputMixCos(xL, xR, stereoInS);\nSub, Xin    = eviXover2pole2band(XinL, xover);\nXinAlign    = Xin; // because Adaa2\nallpassM\t= ((circuitM * fbsinS) + XinAlign) * fbpreS;\n/*\n// noise\nratio1, gainMod1 = lossinessN(lossiness, flavour, gaintime, gainmode);\npreN\t= clip(ratio1 * gainMod1, 0, 1);\nmodN\t= 1 - (sale * preN);\n*/\n// allpass cascade\nfor (j = 0; j < numSectsM1; j += 1) {\n    apS0 = peek(allpassCascade, j, 0, index=\"samples\", interp=\"none\");\n    allpassM, apS1 = rcFilterAllpassCascade(allpassM, lfog, apS0);\n    apW1 = apS1;// * modN;\n    poke(allpassCascade, apW1, j, 0, 0, index=\"samples\");\n}\nif (prevNum != numSections) { // should be before cascade ?\n\t// zero remainder\n\tfor (k = numSectsM1; k < maxSections; k += 1) {\n\t\tpoke(allpassCascade, 0, k, 0, 0, index=\"samples\");\n\t}\n\tprevNum = numSections;\n}\n\n// tap feedback and saturate\ncircuitM\t= dcblock(altTanhSqrtAdaa2(allpassM * fbsinS));\nfinal\t    = dcblock(-rcFilterAllpass((allpassM * postS), lfog));\nsubFinal    = eCubicAdaa1(Sub * 1.122018) + final;\n\n// mix\nphaserL\t\t= (XinAlign + (subFinal * sqrt1_2)) * fbattenLs; // & static atten\nphaserR\t\t= ((subFinal + (subFinal * fbsinS)) + XinR) * fbattenRs;\n\n// out\nmainL, mainR = outputMixCos(phaserL, phaserR, stereoOutS);\n\nout1 = mainL;\nout2 = mainR;\n\nout3 = lfohz;\nout4 = lfo01;\n\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
