            {
                "box": {
                    "code": "\r\n// analog-like phaser in the sort of pedal sense (good for mono input but still does stereo)\r\n\r\nrequire(\"evi_rcfilters.genexpr\");\r\nrequire(\"evi_crossovers.genexpr\");\r\nrequire(\"evi_sources.genexpr\");\r\nrequire(\"evi_lfo.genexpr\");\r\nrequire(\"evi_adaa.genexpr\");\r\n/*\r\nAllPoleWarp(cutoff)\t\t\t\t\t// 6dB onepole Warp (not !)\r\n{\n\treturn clip(sin(cutoff * twopi / samplerate), 0.00001, 0.99999);\r\n}\r\n\r\nAllPoleSection(x, f, H)\t\t\t\t// 6dB onepole Allpass\r\n{\n\tlp = mix(H, x, f);\t\t\t\t// lowpass\n\ty0 = lp;\n\thp = x - lp;\t\t\t\t\t// highpass\n\treturn ((hp * -1) + lp), y0;\n}\r\n\r\nAllPoleSectionFinal(x, f)\t\t\t// 6dB onepole\r\n{\n\tHistory y0(0);\n\tlp = mix(y0, x, f);\t\t\t\t// lowpass\n\ty0 = lp;\n\thp = x - lp;\t\t\t\t\t// highpass\n\treturn (hp * -1) + lp;\n}\r\n\r\nPoleZeroWarp(cutoff)\t\t\t\t// 6dB pole/zero Warp\r\n{\r\n\tfc = (pi * cutoff) / samplerate;\t\t\t// !! no check for min/max 'cutoff' here\n\ta0 = minimum(((2 * sin(fc)) / (cos(fc) + sin(fc))), 0.999999);\n\ta1 = 1 - (a0 * 2);\r\n\treturn a0, a1;\r\n}\r\n\r\nPoleZeroSection(x, a0, a1, Q)\t\t// 6dB pole/zero\r\n{\n\tw = x * a0;\n\tlp = Q + w;\t\t\t\t\t\t// lowpass\n\tR = w + (lp * a1);\n\thp = x - lp;\t\t\t\t\t// highpass\n\treturn ((hp * -1) + lp), R;\n}\r\n\r\nPoleZeroSectionFinal(x, a0, a1)\t\t// 6dB pole/zero\r\n{\n\tHistory R(0);\n\tw = x * a0;\n\tlp = R + w;\t\t\t\t\t\t// lowpass\n\tR = w + (lp * a1);\n\thp = x - lp;\t\t\t\t\t// highpass\n\treturn (hp * -1) + lp;\n}\r\n\r\niirWarp(cutoff)\t\t\t\t\t\t// 6dB iir BLT\r\n{\t// alex, non-approx tan for you, but i think this very dangerous (must not get near nyquist)\r\n\treturn tan(cutoff * (pi / samplerate));\t// !! no check for min/max 'cutoff' here\r\n}\r\n\r\niirSection(x, w, H)\t\t\t\t\t// 6dB iir Allpass\r\n{\r\n\tz = (x - ((w - 1) * H)) * (1 / (w + 1));\n\thp = z - H;\t\t\t\t\t\t// highpass\n\tlp = (z + H) * w;\t\t\t\t// lowpass\n\ty0 = z;\n\treturn ((hp * -1) + lp), y0;\n}\r\n\r\niirSectionFinal(x, w)\t\t\t\t// 6dB iir\r\n{\n\tHistory y0(0);\n\tz = (x - ((w - 1) * y0)) * (1 / (w + 1));\n\thp = z - y0;\t\t\t\t\t// highpass\n\tlp = (z + y0) * w;\t\t\t\t// lowpass\n\ty0 = z;\n\treturn (hp * -1) + lp;\n}\r\n\r\nwarpGlobal(cutoff, section)\r\n{\r\n\t// global clip\r\n\tcf = clip(cutoff, 5, (samplerate * 0.44));\t\t// no need for precision here\r\n\t// choose warp\r\n\tw, a = 0;\r\n\tif (section == 1) {\r\n\t\tw, a = PoleZeroWarp(cf);\r\n\t} else if (section == 2) {\r\n\t\tw = iirWarp(cf);\r\n\t} else {\t// section == 0\r\n\t\tw = AllPoleWarp(cf);\r\n\t}\r\n\treturn w, a;\r\n}\r\n\r\nsectionGlobal(x, w, a, H, s)\r\n{\r\n\tHistory dummy(0);\t// trick gen\r\n\t// choose filter\r\n\ty, y0 = 0;\r\n\tif (s == 1) {\r\n\t\ty, y0 = PoleZeroSection(x, w, a, H);\r\n\t} else if (s == 2) {\r\n\t\ty, y0 = iirSection(x, w, H);\r\n\t} else {\t// s == 0\r\n\t\ty, y0 = AllPoleSection(x, w, H);\r\n\t}\r\n\treturn y, y0;\r\n}\r\n\r\nfinalSection(x, w, a, s)\r\n{\r\n\tHistory dummy(0);\t// trick gen\r\n\t// choose filter\r\n\ty = 0;\r\n\tif (s == 1) {\r\n\t\ty = PoleZeroSectionFinal(x, w, a);\r\n\t} else if (s == 2) {\r\n\t\ty = iirSectionFinal(x, w);\r\n\t} else {\t// s == 0\r\n\t\ty = AllPoleSectionFinal(x, w);\r\n\t}\r\n\treturn y;\r\n}\r\n*/\ninputMixCos(xL, xR, stereo)\r\n{\n\tmonoMix = (xL + xR) * 0.5;\n    yL, yR = xfadeQuartApproxStereo(monoMix, monoMix, xL, xR, stereo);\n\treturn yL, yR, monoMix;\n}\n\noutputMixCos(xL, xR, stereo)\r\n{\n\tyL = xL;\r\n\tyR = xfadeQuartApproxMono(xL, xR, stereo);\n\treturn yL, yR;\n}\r\n\r\nParam\trate(0.5, min=0, max=8);\nParam\tdepth(0.75, min=0, max=1);\nParam\tcenter(0.52, min=0, max=1);\nParam\tspread(0.5, min=0, max=1);\n\nParam\tduty(0.4, min=0, max=1);\nParam\tshape(0.5, min=0, max=1);\nParam\tskew(1.2, min=0.5, max=2);\n\r\nParam   xover(104., min=10, max=1000);\r\nParam   pregain(0., min=-6, max=6);\r\nParam   postgain(0., min=-6, max=6);\r\nParam\tfeedback(-0.5, min=-1, max=1);\r\nParam   smooth(22.666, min=0, max=226);\r\n\r\nParam   leakymix(0., min=0, max=10);\r\nParam   lossiness(0.7, min=0, max=1);\r\nParam   flavour(0.3, min=-20, max=20);\r\nParam   gaintime(2., min=0);\r\nParam   gainmode(0, min=0, max=2);\r\n\nHistory circuitM(0);\r\n\r\nHistory prevNum(7);\nData\tallpassCascade(32, 1);\t// just change dim() for different available number of stages\nParam\tstages(7);\nmaxSections = dim(allpassCascade);\nnumSections = clamp(int(stages), 2, maxSections);\r\nnumSectsM1  = numSections - 1;  // because final section is solo\nsmoothsecs\t= smooth*0.001;\n\r\ncentPitch = center * 134;\r\nrangPitch = centPitch * 0.5;\r\nrangDepth = depth * rangPitch;\r\nminPitch = centPitch - rangDepth;\r\nmaxPitch = centPitch + rangDepth;\r\n\r\nfbmul\t= ((1 - ((maximum(spread, 0.5) - 0.5) * 2)) * 0.75) + 0.75;\r\nfbsin\t= fastsin(feedback * fbmul);\r\nfbfuck = abs(feedback) * 3;\r\nfuck = maximum(pregain - fbfuck, -6);\r\n\r\n//mainPhase, mainHz, mainSync = evi_phasor0(rate, 0);\r\nphase = phasor(rate);\r\n\r\n// lfo\r\nlfo01\t= lfoMix(phase, duty, shape, skew);\r\nlfomid\t= mix(minPitch, maxPitch, lfo01);\r\nlfohz\t= mtofApproxBaseless(lfomid);\r\nlfog    = rcPreWarp1(lfohz);\r\n\r\nxL      = in1;\nxR      = in2;\nstereoIn\t= spread * 0.61;\r\nXinL, XinR, Mono  = inputMixCos(xL, xR, stereoIn);\r\nSub, Xin    = eviXover2pole2band(XinL, xover);\r\nallpassM\t= ((circuitM * fbsin) + Xin) * dbtoaApprox(fuck);\r\n\r\npa \t    = 0.23283;\r\nsale\t= (leakymix * leakymix) * pa;\r\nratio1, gainMod1 = lossinessN(lossiness, flavour, gaintime, gainmode);\r\npreN\t= clip(ratio1 * gainMod1, 0, 1);\r\nmodN\t= 1 - (sale * preN);\r\n\r\n// allpass cascade\nfor (j = 0; j < numSectsM1; j += 1) {\n    apS0 = peek(allpassCascade, j, 0, index=\"samples\", interp=\"none\");\r\n    allpassM, apS1 = rcFilterAllpassCascade(allpassM, lfog, apS0);\r\n    apW1 = apS1 * modN;\r\n    poke(allpassCascade, apW1, j, 0, 0, index=\"samples\");\r\n}\r\nif (prevNum != numSections) { // should be before cascade ?\n\t// zero remainder\n\tfor (k = numSectsM1; k < maxSections; k += 1) {\n\t\tpoke(allpassCascade, 0, k, 0, 0, index=\"samples\");\n\t}\n\tprevNum = numSections;\n}\r\n\r\n// tap feedback and saturate\r\ncircuitM\t= dcblock(atanAdaa2(allpassM * fbsin));\r\nfinal\t    = dcblock(rcFilterAllpass((allpassM * dbtoaApprox(postgain)), lfog) * -1);\r\nsubFinal    = eCubicAdaa1(Sub) + final;\r\n\r\nomsq12\t\t= 1 - sqrt1_2;\r\nfbattenL\t= 1 - (abs(minimum(fbsin, 0)) * omsq12);\r\nfbattenR\t= 1 - (maximum(fbsin, 0) * omsq12);\r\nphaserL\t\t= (Xin + (subFinal * sqrt1_2)) * fbattenL;     // & static atten\r\nphaserR\t\t= ((subFinal + (subFinal * fbsin)) + XinR) * fbattenR;\r\n\r\nstereoOut\t = (spread * 0.82) + 0.18;\r\nmainL, mainR = outputMixCos(phaserL, phaserR, stereoOut);\r\n\r\nout1 = mainL;\r\nout2 = mainR;\r\n\r\nout3 = minPitch;//lfo01;\r\nout4 = maxPitch;//lfohz;\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 4,
                    "outlettype": [ "", "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 775.0, 732.0 ]
                }
