            },
            {
                "box": {
                    "code": "\r\n// analog like phaser in the sort of pedal sense\r\n\r\nrequire(\"evi_rcfilters.genexpr\");\r\nrequire(\"evi_crossovers.genexpr\");\r\nrequire(\"evi_sources.genexpr\");\r\nrequire(\"evi_lfo.genexpr\");\r\nrequire(\"evi_adaa.genexpr\");\r\n\ninputMixCos(xL, xR, stereo)\r\n{\n\tmonoMix = (xL + xR) * 0.5;\n    yL, yR = xfadeQuartApproxStereo(monoMix, monoMix, xL, xR, stereo);\n\treturn yL, yR, monoMix;\n}\n\noutputMixCos(xL, xR, stereo)\r\n{\n\tyL = xL;\r\n\tyR = xfadeQuartApproxMono(xL, xR, stereo);\n\treturn yL, yR;\n}\r\n\r\nParam\trate(0.5, min=0, max=8);\nParam\tdepth(0.75, min=0, max=1);\nParam\tcenter(0.52, min=0, max=1);\nParam\tspread(0.5, min=0, max=1);\n\nParam\tduty(0.4, min=0, max=1);\nParam\tshape(0.5, min=0, max=1);\nParam\tskew(1.2, min=0.5, max=2);\n\r\nParam   xover(104., min=10, max=1000);\r\nParam   pregain(0., min=-6, max=6);\r\nParam   postgain(0., min=-6, max=6);\r\nParam\tfeedback(-0.5, min=-1, max=1);\r\nParam   smooth(22.666, min=0, max=226);\r\n\r\nParam   leakymix(0., min=0, max=10);\r\nParam   lossiness(0.7, min=0, max=1);\r\nParam   flavour(0.3, min=-20, max=20);\r\nParam   gaintime(2., min=0);\r\nParam   gainmode(0, min=0, max=2);\r\n\nHistory circuitM(0);\r\n\r\nHistory prevNum(7);\nData\tallpassCascade(32, 1);\t// just change dim() for different available number of stages\nParam\tstages(7);\nmaxSections = dim(allpassCascade);\nnumSections = clamp(int(stages), 2, maxSections);\r\nnumSectsM1  = numSections - 1;  // because final section is solo\nsmoothsecs\t= smooth*0.001;\n\r\ncentPitch = center * 134;\r\nrangPitch = centPitch * 0.5;\r\nrangDepth = depth * rangPitch;\r\nminPitch = centPitch - rangDepth;\r\nmaxPitch = centPitch + rangDepth;\r\n\r\nfbmul\t= ((1 - ((maximum(spread, 0.5) - 0.5) * 2)) * 0.75) + 0.75;\r\nfbsin\t= fastsin(feedback * fbmul);\r\n\r\n//mainPhase, mainHz, mainSync = evi_phasor0(rate, 0);\r\nphase = phasor(rate);\r\n\r\n// lfo\r\nlfo01\t= lfoMix(phase, duty, shape, skew);\r\nlfomid\t= mix(minPitch, maxPitch, lfo01);\r\nlfohz\t= mtofApproxBaseless(lfomid);\r\nlfog    = rcPreWarp1(lfohz);\r\n\r\nxL      = in1;\nxR      = in2;\nstereoIn\t= spread * 0.61;\r\nXinL, XinR, Mono  = inputMixCos(xL, xR, stereoIn);\r\nSub, Xin    = eviXover2pole2band(XinL, xover);\r\nallpassM\t= (circuitM * fbsin) + Xin;\r\n\r\npa \t    = 0.23283;\r\nsale\t= (leakymix * leakymix) * pa;\r\nratio1, gainMod1 = lossinessN(lossiness, flavour, gaintime, gainmode);\r\npreN\t= clip(ratio1 * gainMod1, 0, 1);\r\nmodN\t= 1 - (sale * preN);\r\n\r\n// allpass cascade\nfor (j = 0; j < numSectsM1; j += 1) {\n    apS0 = peek(allpassCascade, j, 0);\r\n    allpassM, apS1 = rcFilterAllpassCascade(allpassM, lfog, apS0);\r\n    apW1 = apS1 * modN;\r\n    poke(allpassCascade, apW1, j, 0, 0);\r\n}\r\nif (prevNum != numSections) { // should be before cascade ?\n\t// zero remainder\n\tfor (k = numSectsM1; k < maxSections; k += 1) {\n\t\tpoke(allpassCascade, 0, k, 0, 0);\n\t}\n\tprevNum = numSections;\n}\r\n\r\n// tap feedback and saturate\r\ncircuitM\t= dcblock(atanAdaa2(allpassM * dbtoaApprox(pregain)));\r\nfinal\t    = dcblock(rcFilterAllpass((allpassM * dbtoaApprox(postgain)), lfog) * -1);\r\nsubFinal    = eCubicAdaa1(Sub) + final;\r\n\r\nomsq12\t\t= 1 - sqrt1_2;\r\nfbattenL\t= 1 - (abs(minimum(fbsin, 0)) * omsq12);\r\nfbattenR\t= 1 - (maximum(fbsin, 0) * omsq12);\r\nphaserL\t\t= (Xin + (subFinal * sqrt1_2)) * fbattenL;     // & static atten\r\nphaserR\t\t= ((subFinal + (subFinal * fbsin)) + XinR) * fbattenR;\r\n\r\nstereoOut\t = (spread * 0.82) + 0.18;\r\nmainL, mainR = outputMixCos(phaserL, phaserR, stereoOut);\r\n\r\nout1 = mainL;\r\nout2 = mainR;\r\n\r\nout3 = lfo01;\r\nout4 = lfohz;\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 4,
                    "outlettype": [ "", "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 775.0, 732.0 ]
                }
