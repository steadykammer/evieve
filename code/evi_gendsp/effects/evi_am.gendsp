            {
                "box": {
                    "code": "\r\n// simple AM example with saturation and a selection of LFO shapes\r\n\r\nrequire(\"evi_counting.genexpr\");\r\nrequire(\"evi_smooth_bank.genexpr\");\r\nrequire(\"evi_adaa.genexpr\");\r\nrequire(\"evi_lfo.genexpr\");\r\n\r\nParam   rate(9., min=1, max=100);       // Hz\r\nParam   factor(1., min=0.125, max=8);\r\nParam   depth(0.5, min=0, max=1);\r\nParam   spread(0.5, min=0, max=1);\r\nParam   gain(0., min=-40, max=40);      // dB\r\n// bypass, up, down, tri, sine (default), tanh, square, rand step, rand linear, rand cubic, noise\r\nParam   lfowave(4, min=0, max=10);\r\nParam   lfowidth(0.5, min=0, max=1);\r\nParam   lfomode(0, min=0, max=1);\r\nParam   lfoout(1, min=0, max=1);        // flag 0/1 (output)\r\n\r\nParam   stereo(0, min=0, max=1);        // flag 0/1 (inputs)\r\nParam   smooth(26., min=0, max=266);    // ms\r\nsmoothsecs = smooth*0.001;\r\nstro = int(stereo);\r\nlfo = int(lfoout);\r\nlfoMode = int(lfomode);\r\n\r\nfreq = rate * factor;\r\ngn = dbtoaApprox(gain);\r\ngnlow = min(gn, 1);\r\ndrive = max(gn, 1);\r\namount = depth + (depth * (gnlow - 1));\r\nspr = spread * 0.5;\r\n\r\nfreqIn, spreadIn, widthIn = expsmoothBank3(freq, spr, lfowidth, smoothsecs*sqrt2);\r\namountIn, gainIn, driveIn = logsmoothBank3(amount, gnlow, drive, smoothsecs);\r\n\r\nreset = (delta(change(lfoMode)) < 0) + in3;\r\nphaseL, phaseR, currentHz, currentSpread, syncL, syncR \r\n    = eviPhasorTwo0(freqIn, spreadIn, reset, minimumhz=0.125, mode=lfoMode);\r\n\r\nwaveL = latch(lfowave, syncL);\r\nwaveR = latch(lfowave, syncR);\r\nmodOscL = lfoShapes11(phaseL, syncL, widthIn, waveL);\r\nmodOscR = lfoShapes11(phaseR, syncR, widthIn, waveR);\r\n\r\n// AM\r\ngnMdp = gainIn - amountIn;\r\namL = (modOscL * amountIn) + gnMdp;\r\namR = (modOscR * amountIn) + gnMdp;\r\n\r\ndriveOut = max(driveIn * 0.25, 1);\r\namL = amL * driveIn;\r\namR = amR * driveIn;\r\n\r\ninL = in1;\r\ninR = stro ? in2 : inL;\r\n\r\nammL = dcblock(inL * amL);\r\nammR = dcblock(inR * amR);\r\n\r\nmainL = eCubicAdaa2(ammL * driveOut);\r\nmainR = eCubicAdaa2(ammR * driveOut);\r\n\r\nout1 = mainL;\r\nout2 = mainR;\r\n\r\nout3 = lfo ? amL : modOscL;\r\nout4 = lfo ? amR : modOscR;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 4,
                    "outlettype": [ "", "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 775.0, 732.0 ]
                }
            }
