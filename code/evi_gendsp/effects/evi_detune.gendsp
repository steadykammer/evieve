            {
                "box": {
                    "code": "\r\n// lofi and old school stereo detune effect\n// loosely based on 'mda detune' copyright (c) 1998-2000 Paul Kellett (mda-vst.com)\r\n// @see: 'evi_detune_wrap.gendsp' or [evi.detune.wrap~] for a more complex and expensive version of this algorithm\n\nrequire(\"evi_smooth_bank.genexpr\");\nrequire(\"evi_crossovers.genexpr\");\nrequire(\"evi_utilities.genexpr\");\n\r\npolyNom(x)\n{\n\tx2 = x*x;\n\tx3 = x*x2;\n\treturn (x + (x3 * -0.18963)) + (x3 * x2 * 0.016182);\n}\n\npolySat(x)\n{\n\tp531 = polyNom(x);\n\tpn = -1.8153 > x ? -1 : p531;\n\treturn x > 1.8153 ? 1 : pn;\n}\r\n\nHistory init(1), prevSize(4096), prevWin(4);\n\nData\tdetuneData(4096, 2);\t\t\t\t\t\t// chan1 = audio, chan2 = window\nHistory\tpos0(0), pos1(0), pos2(0);\t\t\t\t\t// write / read phases\nHistory phaseReset(1);\n\nHistory dryL(0), dryR(0);                           // align\n\nParam   crossover(250., min=125, max=1000);         // detune takes place above crossover freq\nParam   drywet(sqrt1_2, min=0, max=1);              // entire effect\n\nParam\tdetune(0.3, min=0, max=1);\nParam\tmix(0.9, min=0, max=1);                     // dry/wet of just detune effect\nParam\twindow(4, min=0, max=5);\t\t\t\t\t// detune window, default 4 == \"Hann\"\nParam\tlatency(4, min=0, max=4);\t\t\t\t\t// 0..4, default 4 = 4096 samples\n\nParam   smooth(22., min=0, max=333);                // ms\nsmsecs  = smooth * 0.001;\nsmsamps = smsecs * samplerate;\n\ndimdata     = dim(detuneData);\nreset\t\t= clip(in3, 0, 1);\nretrigger\t= (delta(reset) > 0) > 0;\n\n// WINDOW\n\nwinsize = selector((int(latency) + 1), 256, 512, 1024, 2048, 4096); // size in samples of write section\nSize    = latch(int(winsize), phaseReset + retrigger);\nSize05  = Size / 2;\nWin     = latch(int(window), phaseReset + retrigger);\na0, a1, a2 = windowCoeffs(Win);\n\n// horrible\r\nif ((init) || (prevSize != Size) || (prevWin != Win)) {\n    for (w = 0; w < winsize; w += 1) {\n        win = winMan(w, a0, a1, a2, windowsize=winsize);\n        poke(detuneData, win, w, 1, index=\"samples\");\t// window function to 'detuneData' chan2\n    }\n\tfor (k = winsize; k < dimdata; k += 1) {\n\t\tpoke(detuneData, 0, k, 1, index=\"samples\");\t\t// zero rest of window data\n        poke(detuneData, 0, k, 0, index=\"samples\");     // zero remainder audio buffer\n\t}\n    init = 0;\n}\nprevSize = Size;\nprevWin = Win;\n\n// DETUNE\n\nlaura\t= 1.059463094359295264561825;\n//semi\t= evi_line((3 * detune * detune * detune), smsamps); // original\nsemi\t= evi_line((3 * detune * detune), smsamps);\ndpos2\t= pow(laura, semi);\t\t\t\t                // dpos2 (must be accurate = use 'pow()')\ndpos1\t= 1 / dpos2;\n//dryMix, wetMix = logsmoothBank2((1 - (mix * mix)), ((2 - mix) * mix), smsecs); // original, this does not work well\ndryMix, wetMix = logsmoothBank2(1 - mix, mix, smsecs);  // note, you think this is wrong, but linear is correct here\n\n// PHASES\n\np0\t\t= wrap(((retrigger ? 0 : pos0) - 1),     0, Size);\t// drive poke\np1\t\t= wrap(((retrigger ? 0 : pos1) - dpos1), 0, Size);\t// read peeks L\np2\t\t= wrap(((retrigger ? 0 : pos2) - dpos2), 0, Size);\t// read peeks R\npos0\t= p0;\npos1\t= p1;\npos2\t= p2;\n\nphaseReset = delta(p0) > 0;\n\nxL      = in1;\nxR      = in2;\ndryL    = xL;\ndryR    = xR;\n// xover\nxoverLowL, xoverLowR, wetInL, wetInR = eviXover2pole2bandStereo(xL, xR, crossover);\n\n// INPUTS\n\ncircMonoWet = wetMix * ((wetInL + wetInR) * 0.5);\t// 'mix' wet input to detuneData poke\ncircLdry = wetInL * dryMix;\t\t\t\t\t\t\t// 'dry' Left mix\ncircRdry = wetInR * dryMix;\t\t\t\t\t\t\t// 'dry' Right mix\n// always write input to buffer\npoke(detuneData, circMonoWet, p0, 0, index=\"samples\", boundmode=\"wrap\");\n\n// DETUNE\n\n// problem, if size = buffersize, 'detune' is smooth and lovely, but if size < buffersize,\n// tiny bit of aliasing in 'detune'. problem is the wrapping in pos* and below. <<-- TODO\n// detuneL (Up)\nLp1i = Size == dimdata ? p1 : trunc(p1);\t\t// phase\nLp2i = wrap((Lp1i + Size05),  0, Size);\t\t    // 180-degree phase\nLp0i = wrap((Lp1i - p0),      0, Size);\t\t    // window phase\nLax  = peek(detuneData, Lp1i, 0, interp=\"cubic\", boundmode=\"wrap\", index=\"samples\");\t // read audio from detuneData\nLbx  = peek(detuneData, Lp2i, 0, interp=\"cubic\", boundmode=\"wrap\", index=\"samples\");\t // 180-degree output\nLx   = peek(detuneData, Lp0i, 1, interp=\"linear\", boundmode=\"wrap\", index=\"samples\");    // read window from windowMem\npreSumL = Lbx + (Lx * (Lax - Lbx));\t\t\t\t// c = Left\n// detuneR (Down)\nRp1i = Size == dimdata ? p2 : trunc(p2);\t\t// phase\nRp2i = wrap((Rp1i + Size05),  0, Size);\t\t    // 180-degree phase\nRp0i = wrap((Rp1i - p0),      0, Size);\t\t    // window phase\nRax  = peek(detuneData, Rp1i, 0, interp=\"cubic\", boundmode=\"wrap\", index=\"samples\");\t// read audio from detuneData\nRbx  = peek(detuneData, Rp2i, 0, interp=\"cubic\", boundmode=\"wrap\", index=\"samples\");\t// 180-degree output\nRx   = peek(detuneData, Rp0i, 1, interp=\"linear\", boundmode=\"wrap\", index=\"samples\");\t// read window from windowMem\npreSumR = Rbx + (Rx * (Rax - Rbx));\t\t\t\t// d = Right\n\n// LOW END\n\nlowMono = (xoverLowL + xoverLowR) * sqrt1_2;\nlowSat  = polySat(lowMono) * sqrt1_2;\nlowSumL = lowSat + circLdry;\nlowSumR = lowSat + circRdry;\n\n// OUTPUTS\n\nwetL    = lowSumL + preSumL;\nwetR    = lowSumR + preSumR;\n\n// xfade dry / wet & output\noutputL, outputR = stereoXfadePar(dryL, dryR, wetL, wetR, drywet);\n\nout1 = outputL;\nout2 = outputR;\n\nout3 = p0;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 3,
                    "outlettype": [ "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 931.0, 732.0 ]
                }
