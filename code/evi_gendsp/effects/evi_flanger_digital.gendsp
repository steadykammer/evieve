            {
                "box": {
                    "code": "\n// basic 2-stage digital flanger example\n\nrequire(\"evi_counting.genexpr\");\nrequire(\"evi_smooth.genexpr\");\nrequire(\"evi_lfo.genexpr\");\n\n// main\nParam\trate(0.1, min=0, max=1);\nParam   maxhz(2.69, min=0, max=100);        // hz\nParam   mintime(0.03, min=0, max=200);      // ms\nParam   maxtime(2.1, min=0, max=200);       // ms\nParam\tdepth(0.74, min=0, max=1);\nParam\tspread(0.7, min=0, max=1);\n// lfo\nParam\tduty(0.4, min=0, max=1);\nParam\tshape(0.5, min=0, max=1);           // tri..sine 0..1\nParam\tskew(1.2, min=0.5, max=2);          // exponent\nParam\tzeroreset(0, min=0, max=1);         // flag 0/1\n// mixing\nParam   gain(0., min=-10, max=10);          // dB -10..10\nParam   invert(0, min=0, max=1);            // flag 0/1\nParam\tfeedback(-0.5, min=-1, max=1);\t    // linear gain -1..1\nParam   feedforward(0.25, min=0, max=1);    // \nParam   inject(0.75, min=0, max=1);\nParam\tcross(0., min=0, max=1);\nParam   drywet(0.75, min=0, max=1);         // % 0..1\r\nParam   stereo(0, min=0, max=1);            // flag 0/1 (inputs)\n\nParam   smooth(30.111, min=0, max=301);     // ms\nsmoothsecs  = smooth*0.001;\nsmoothsamps = smoothsecs*samplerate;\r\nstro        = int(stereo);\nphaseMode   = int(zeroreset);\ninvSign     = (int(invert) > 0) ? -1 : 1;\n\ndelayMin = mintime;\ndelayMax = ((maxtime - mintime) * depth) + mintime;\ndelayMin = min(delayMin, delayMax);\ndelayMax = max(delayMin, delayMax);\n\nfreqIn, minMs, maxMs, spreadIn = logsmoothBank4(rate*maxhz, delayMin, delayMax, spread*spread, smoothsecs);\ndutyScale, shapeScale, skewScale = expsmoothBank3(duty, shape, skew, smoothsecs*sqrt1_2);\nfbGain, ffMix, crossMix, inJect = logsmoothBank4(feedback*0.5, feedforward, cross, inject, smoothsecs*sqrt2);\npostGain = logsmooth((dbtoaApprox(gain) * invSign), smoothsecs);\ndryWet = eviLine(drywet, smoothsamps);\n\nphaseL, phaseR, phaseHz, phaseSpread, syncL, syncR = eviPhasorTwo0(freqIn, spreadIn, in3, minimumhz=0.05, mode=phaseMode);\n\nlfoL = lfoMix(phaseL, dutyScale, shapeScale, skewScale);\nlfoR = lfoMix(phaseR, dutyScale, shapeScale, skewScale);\n\ndelayL = mix(minMs, maxMs, lfoL);\ndelayR = mix(minMs, maxMs, lfoR);\n\r\ninL = in1;\r\ninR = stro ? in2 : inL;\r\n\n                  // delay,   gain,   ff,    fb\nwetL = evi_comb(inL, delayL, -inJect, ffMix, fbGain);\nwetR = evi_comb(inR, delayR, -inJect, ffMix, fbGain);\n\nwetL = mix(wetL, wetR, crossMix) * postGain;\nwetR = mix(wetR, wetL, crossMix) * postGain;\n\nwetL = evi_comb(wetL, delayL+minMs, inJect, -ffMix, fbGain);\nwetR = evi_comb(wetR, delayR+minMs, inJect, -ffMix, fbGain);\n\nout1 = xfadeQuartApproxMono(in1, wetL, dryWet);\nout2 = xfadeQuartApproxMono(in2, wetR, dryWet);\n\nout3 = lfoL;\nout4 = lfoR;\n\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 4,
                    "outlettype": [ "", "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 1057.0, 732.0 ]
                }
            }
