            {
                "box": {
                    "code": "\r\n//\t//\t//\tevi_sustainfdn.gendsp\r\n//\t//\t//\t16 line feeback delay network\r\n//\t//\t//\tby pete for evieve\r\n//  //  //  NOTE: this is a heavily edited version of real reverb \"evi_sustainverb.gendsp\"...\r\n//  //  //  ...for the purposes of the rod polyphonic sustainer. not much use to anyone else\r\n\r\n\r\n//\t//\t//\tlibrary\r\n\r\nrequire(\"evi_reverb_library.genexpr\");\r\n\r\n\r\n//\t//\t//\tdeclare\r\n\r\n// constants in samples from external javascript, defaults are for 48kHz samplerate\r\n\r\n// early times are unused here, but here to eat up the use of evi_sustainverb wrapping code\r\nParam\tearlyTime1 \t(\t69,\t\tmin=1, max=1502\t\t);\nParam\tearlyTime2 \t(\t155,\tmin=1, max=1502\t\t);\nParam\tearlyTime3 \t(\t251,\tmin=1, max=1502\t\t);\nParam\tearlyTime4 \t(\t376,\tmin=1, max=1502\t\t);\n\r\nParam\tdelayTime1 \t(\t480,\tmin=1, max=25056\t);\nParam\tdelayTime2 \t(\t559,\tmin=1, max=25056\t);\nParam\tdelayTime3 \t(\t646,\tmin=1, max=25056\t);\nParam\tdelayTime4 \t(\t803,\tmin=1, max=25056\t);\nParam\tdelayTime5 \t(\t969,\tmin=1, max=25056\t);\nParam\tdelayTime6 \t(\t1236,\tmin=1, max=25056\t);\nParam\tdelayTime7 \t(\t1511,\tmin=1, max=25056\t);\nParam\tdelayTime8 \t(\t1838,\tmin=1, max=25056\t);\nParam\tdelayTime9 \t(\t2241,\tmin=1, max=25056\t);\nParam\tdelayTime10 (\t2662,\tmin=1, max=25056\t);\nParam\tdelayTime11 (\t3128,\tmin=1, max=25056\t);\nParam\tdelayTime12 (\t3688,\tmin=1, max=25056\t);\nParam\tdelayTime13 (\t4251,\tmin=1, max=25056\t);\nParam\tdelayTime14 (\t4861,\tmin=1, max=25056\t);\nParam\tdelayTime15 (\t5539,\tmin=1, max=25056\t);\nParam\tdelayTime16 (\t6264,\tmin=1, max=25056\t);\n\r\nDelay\tfdnDelay1\t(\tdelayTime1+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay2\t(\tdelayTime2+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay3\t(\tdelayTime3+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay4\t(\tdelayTime4+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay5\t(\tdelayTime5+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay6\t(\tdelayTime6+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay7\t(\tdelayTime7+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay8\t(\tdelayTime8+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay9\t(\tdelayTime9+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay10\t(\tdelayTime10+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay11\t(\tdelayTime11+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay12\t(\tdelayTime12+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay13\t(\tdelayTime13+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay14\t(\tdelayTime14+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay15\t(\tdelayTime15+1,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay16\t(\tdelayTime16+1,\t1,\tfeedback=1\t);\r\n\r\nParam\tsmoothtime(10, min=1, max=500);\t\t// ms\r\nParam\tfeedback(0, min=0, max=1);\t        // % 0..1\r\nParam\tgain(0, min=-80, max=20);\t\t    // dB\r\nParam   fbinlet(0, min=0, max=1);           // inlet for all-audio-rate MC version\r\nfbin    = int(fbinlet);\r\n\r\n//\t//\t//\tparse param rate\r\n\r\nsmoothsecs\t= smoothtime * 0.001;\r\nsmoothsamps\t= smoothsecs * samplerate;\r\n\r\noutgain\t\t= dbtoaApprox(gain);\r\n\r\nfb_0        = 0;\r\nif (fbin) {\r\n    fb_0    = in3;\r\n} else {\r\n    fb_0    = feedback;\r\n}\r\n\r\nfb_0\t\t= sqrt(fb_0) * 0.25;\t\t    // you think this is a stupid multiplier, but it is correct\r\n\r\n\r\n//\t//\t//\tparse audio rate\r\n\r\nfb0\t\t\t= eviLine(fb_0, smoothsamps);\r\noutAmp      = logsmooth(outgain, smoothsecs);\r\n\r\n\r\n//\t//\t//\tprocessing\t\t(static & integer delay times so no interpolation)\r\n\r\nxL\t\t= in1+0;\r\nxR\t\t= in2+0;\r\n\r\n// fdn read...\r\n\r\nfb01\t= fdnDelay1.read(delayTime1,\tinterp=\"none\");\r\nfb02\t= fdnDelay2.read(delayTime2,\tinterp=\"none\");\r\n\r\nfb1\t\t= (fb01\t +\txL)\t\t\t\t\t\t\t        * fb0;\r\nfb2\t\t= (fb02\t +\txR)\t\t\t\t\t\t\t        * fb0;\r\nfb3\t\t=  fdnDelay3.read(delayTime3,\tinterp=\"none\")  * fb0;\r\nfb4\t\t=  fdnDelay4.read(delayTime4,\tinterp=\"none\")  * fb0;\r\n\r\nfb5\t\t=  fdnDelay5.read(delayTime5,\tinterp=\"none\")\t* fb0;\r\nfb6\t\t=  fdnDelay6.read(delayTime6,\tinterp=\"none\")\t* fb0;\r\nfb7\t\t=  fdnDelay7.read(delayTime7,\tinterp=\"none\")\t* fb0;\r\nfb8\t\t=  fdnDelay8.read(delayTime8,\tinterp=\"none\")\t* fb0;\r\nfb9\t\t=  fdnDelay9.read(delayTime9,\tinterp=\"none\")\t* fb0;\r\nfb10\t=  fdnDelay10.read(delayTime10,\tinterp=\"none\")\t* fb0;\r\nfb11\t=  fdnDelay11.read(delayTime11,\tinterp=\"none\")\t* fb0;\r\nfb12\t=  fdnDelay12.read(delayTime12,\tinterp=\"none\")\t* fb0;\r\nfb13\t=  fdnDelay13.read(delayTime13,\tinterp=\"none\")\t* fb0;\r\nfb14\t=  fdnDelay14.read(delayTime14,\tinterp=\"none\")\t* fb0;\r\nfb15\t=  fdnDelay15.read(delayTime15,\tinterp=\"none\")\t* fb0;\r\nfb16\t=  fdnDelay16.read(delayTime16,\tinterp=\"none\")\t* fb0;\r\n\r\n// fdn matrix...\r\n\r\ndx1, dx2, dx3, dx4, dx5, dx6, dx7, dx8, dx9, dx10, dx11, dx12, dx13, dx14, dx15, dx16\t\r\n\t\t= butterfly16(fb1, fb2, fb3, fb4, fb5, fb6, fb7, fb8, fb9, fb10, fb11, fb12, fb13, fb14, fb15, fb16);\r\n\r\n// aux taps...\r\n\r\ntapOut1\t= dcblock(dx13);\r\ntapOut2\t= dcblock(dx14);\r\ntapOut3\t= dcblock(dx15);\r\ntapOut4\t= dcblock(dx16);\r\n\r\n// main taps...\r\n\r\n// should be butterfly ??\r\nfdnL\t= (tapOut1 + tapOut2) * sqrt1_2 * outAmp;\r\nfdnR\t= (tapOut3 + tapOut4) * sqrt1_2 * outAmp;\r\n\r\n// fdn write (update delay lines)...\r\n\r\nfdnDelay1.write\t\t(\tfixdenorm(dx1)\t\t);\r\nfdnDelay2.write\t\t(\tfixdenorm(dx2)\t\t);\r\nfdnDelay3.write\t\t(\tfixdenorm(dx3)\t\t);\r\nfdnDelay4.write\t\t(\tfixdenorm(dx4)\t\t);\r\nfdnDelay5.write\t\t(\tfixdenorm(dx5)\t\t);\r\nfdnDelay6.write\t\t(\tfixdenorm(dx6)\t\t);\r\nfdnDelay7.write\t\t(\tfixdenorm(dx7)\t\t);\r\nfdnDelay8.write\t\t(\tfixdenorm(dx8)\t\t);\r\nfdnDelay9.write\t\t(\tfixdenorm(dx9)\t\t);\r\nfdnDelay10.write\t(\tfixdenorm(dx10)\t\t);\r\nfdnDelay11.write\t(\tfixdenorm(dx11)\t\t);\r\nfdnDelay12.write\t(\tfixdenorm(dx12)\t\t);\r\nfdnDelay13.write\t(\tfixdenorm(dx13)\t\t);\r\nfdnDelay14.write\t(\tfixdenorm(dx14)\t\t);\r\nfdnDelay15.write\t(\tfixdenorm(dx15)\t\t);\r\nfdnDelay16.write\t(\tfixdenorm(dx16)\t\t);\r\n\r\n// outputs...\r\n\r\nout1\t= fdnL;\r\nout2\t= fdnR;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 34.0, 56.0, 915.0, 702.0 ]
                }
            },
