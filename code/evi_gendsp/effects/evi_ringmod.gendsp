        "boxes": [
            {
                "box": {
                    "code": "\r\n// over complex ring modulator, evieve stylee\r\n\r\n// lib\r\n\r\nrequire(\"evi_ringmod_enhanced.genexpr\");\r\n\r\n// param rate ...\n\r\nParam\thighpass(40, min=10, max=400);\t\t\t\t\t// hz\r\nParam\tcutoff(samplerate*0.25, min=1000, max=samplerate*0.5);\t// butterworth hz\r\nParam\torder(0, min=0, max=8);\t\t\t\t\t\t\t// butterworth LP slope, default bypassed\r\nParam\tdrive(0.5, min=0, max=4);\t\t\t\t\t\t// % 0..1..\r\nParam\ttopology(0, min=0, max=1);\t\t\t\t\t\t// waveshape placement, quirky\r\nParam\tquality(1, min=0, max=4);\t\t// 0=1x/Adaa1, 1=1x/Adaa2, 2=4x/Adaa2, 3=8x/Adaa2\r\nord\t\t= int(order);\t\t\t\t\t\t\t\t\t// 4=8x/Adaa2_4x\r\ntop\t\t= int(topology);\r\nos\t\t= int(quality);\r\npidrive, sindrive\t= sinParam(drive);\r\nnf\t\t= rcPreWarp1(highpass);\t\t\t// fixed highpass ?, not smoothed for now !\r\n\r\n// audio rate ...\r\n\r\nX\t\t= 0;\r\ndrivepi, drivesin\t= expsmoothBank2(pidrive, sindrive, 0.022666);\r\n\r\nif (os == 1) {\t\t\t\t\t// os 1 = 1x/Adaa2\r\n\tX\t= evieveRingmodAdaa2(\t\t\tin1, in2, nf, drivepi, drivesin, top);\r\n} else if (os == 2) {\t\t\t// os 2 = 4x/Adaa2, default\r\n\tX\t= evieveRingmodAdaa2__4x_6POINT(in1, in2, nf, drivepi, drivesin, top);\r\n} else if (os == 3) {\t\t\t// os 3 = 8x/Adaa2\r\n\tX\t= evieveRingmodAdaa2__8x_6POINT(in1, in2, nf, drivepi, drivesin, top);\r\n} else if (os == 4) {\t\t\t// os 5 = 8x/Adaa2_4x\r\n\tX\t= evieveRingmodAdaa2_4x__8x_6POINT(in1, in2, nf, drivepi, drivesin, top);\r\n} else {\t\t\t\t\t\t// os 0 = 1x/Adaa1\r\n\tX\t= evieveRingmodAdaa1(\t\t\tin1, in2, nf, drivepi, drivesin, top);\r\n}\r\n\r\n//        default bypassed\r\nout1\t= linearButterworthLP8(X, cutoff, order=ord); // cutoff smoothed, order clicks\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
