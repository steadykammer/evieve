            {
                "box": {
                    "fontname": "Arial",
                    "fontsize": 12.0,
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 30.0, 17.0, 148.0, 22.0 ],
                    "text": "in 1 In Mono / In Left / In 1"
                }
            },
            {
                "box": {
                    "code": "\n// -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\n\n// evi_plateverb.gendsp\n\n// \"yafr2\" from MSP\n// \"Plate reverb, in the style of Griesinger\", by Randy Jones\n\n// This version by Pete for evieve, with dry/wet and eq added, as well \n// as modifications for better filtering, interpolation, smoothing, etc\n\n// This version is quite expensive and therefore not so useful\n// Use the \"Lite\" version (evi_plateverb_lite.gendsp) with no zero hold delay changes \n// if you are not going to be making realtime changes to the \"size\" and \"diffuse\" parameters\n\n// -- -- -- -- -- -- -- -- -- --\tfunctions (library)\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\n\nrequire(\"evi_reverb_library.genexpr\");\n\n\n// -------\tdeclare\n\n// reverb\nParam\tsize(0.3, min=0, max=1);\nParam\tdecay(0.6, min=0, max=1);\nParam\tdiffuse(0.3, min=0, max=1);\n// damp (compute coefficients externally in gen no tilde)\nParam\tdamp(0.67682, min=0, max=1);\t\t// pre-warped frequency (a 0..1) (default 6593Hz @48kHz)\n// eq (compute coefficients externally in gen no tilde)\nParam\thighshelfG(0.123758, min=0, max=1);\t// pre-warped frequency (g / (1 + g)) (default 2000Hz @48kHz)\nParam\thighshelfK(0., min=-3, max=1);\t\t// -3=shelfboost..0=bypass..shelf..1=pass\nParam\tlowshelfG(0.032214, min=0, max=1);\t// pre-warped frequency (g / (1 + g)) (default 500Hz @48kHz)\nParam\tlowshelfK(0., min=-3, max=1);\t\t// -3=shelfboost..0=bypass..shelf..1=pass\n// mix\nParam\twet(-3., min=-90, max=0);\t\t\t\t\t\t\t// wet '0' dB & dry '-90' dB...\nParam\tdry(-15., min=-90, max=0);\t\t\t\t\t\t\t// ...= 'yafr2' default (no dry)\nParam\tpan(0.5, min=0, max=1);\t\t\t\t\t\t\t\t// pan for DRY signal in MONO mode\nParam\tstereo(0, min=0, max=2);\t\t\t\t\t\t\t// input is mono / stereo / 2-chans ?\nParam\tbypass(0, min=0, max=1);\t\t\t\t\t\t\t// also cpu-off, but no reset in gen~ !!\n\nHistory\tdryL(0), dryR(0);\t\t\t\t\t\t\t\t\t// compensate dry\n\nDelay\ttapsL(samplerate*0.26636, 1, feedback=1);\t\t\t// loops, ± modulation time\nDelay\ttapsR(samplerate*0.25995, 1, feedback=1);\n\r\n// constants, not user\n\nParam\tSUMMUL\t\t(  0.14285714285714285, min=0, max=1);\t// 1/7\nParam\tSUMMULINV\t(  0.8571428571428572,  min=0, max=1);\t// 1 - SUMMUL;\nParam\tSUMMUL05\t(  0.07142857142857142, min=0, max=1);\t// 0.5 * SUMMUL\nParam\tSUMMULSQ\t(  0.3779644730092272,  min=0, max=1);\t// 1/sqrt(7)\n\nParam\tAPGAIN1\t\t(  0.75,\tmin= 0, max= 1);\nParam\tAPGAIN2\t\t(  0.625,\tmin= 0, max= 1);\nParam\tAPGAIN3\t\t( -sqrt1_2,\tmin=-1, max= 1);\nParam\tAPGAIN4\t\t(  0.5,\t\tmin= 0, max= 1);\n\n// smooth\n\nParam\tsmoothtime(49., min=1, max=500);// ms\nsmoothsecs\t= smoothtime * 0.001;\t\t// secs\nsmoothsamps\t= smoothsecs * samplerate;\t// samps\n\n\n// -------\tfixed constants\n\nSRATE\t\t=  samplerate + 0;\n\napTime1\t\t=  0.00476 * SRATE;\napTime2\t\t=  0.00358 * SRATE;\napTime3\t\t=  0.01273 * SRATE;\napTime4\t\t=  0.00930 * SRATE;\n\n\n// -------\tparse (param rate)\n\nmodDepth\t= 0.033;\t\t\t\t\t// in seconds; yafr2 has this at 20 miliiseconds\n\nsizescale\t= (size * 1.59) + 0.01;\nsizediff\t=  sizescale * diffuse;\ndecayscale\t= (decay * SUMMULINV) + SUMMUL05;\n\nwetAmp\t\t= (wet > -90) ? dbtoaApprox(wet) : 0;\ndryAmp\t\t= (dry > -90) ? dbtoaApprox(dry) : 0;\npanscale\t= (pan * 0.75) + 0.125;\n\n// iStereo ('stereo' param): 0 = mono (L) input / 1 = stereo (L/R) source / 2 = uncorrelated 2-channels\niStereo\t\t=  int(stereo);\nstereoMul\t= (iStereo == 2) ? sqrt1_2 : 0.5;\t\t// !! not smoothed !!\n\n\n// -------\ttimes dynamic (param rate)\n\nLtimeMul2\t= sizescale * (0.14960 * SRATE);\t\t// will add modL in samples...\nRtimeMul2\t= sizescale * (0.14170 * SRATE);\t\t// will add modR in samples...\n\nCtimeMul1L\t= sizediff \t* (0.110   * SRATE);\nCtimeMul2L\t= sizediff \t* (0.160   * SRATE);\nCtimeMul3L\t= sizediff  * (0.050   * SRATE);\nCtimeMul4L\t= sizediff  * (0.025   * SRATE);\nCtimeMul5L\t= sizediff  * (0.069   * SRATE);\nCtimeMul6L\t= sizediff  * (0.080   * SRATE);\nCtimeMul7L\t= sizediff  * (0.075   * SRATE);\n\nCtimeMul1R\t= sizediff \t* (0.110   * SRATE);\nCtimeMul2R\t= sizediff \t* (0.135   * SRATE);\nCtimeMul3R\t= sizediff  * (0.055   * SRATE);\nCtimeMul4R\t= sizediff  * (0.003   * SRATE);\nCtimeMul5R\t= sizediff  * (0.035   * SRATE);\nCtimeMul6R\t= sizediff  * (0.027   * SRATE);\nCtimeMul7R\t= sizediff  * (0.052   * SRATE);\n\n\n// -------\tinputs / outputs (audio rate from here)\n\nx0  = 0;\n//xN\t= 0;\nif (iStereo >  0) {\n\tx0\t\t= (in1 + in2) * stereoMul;\t\t\t\t// !! stereoMul not smoothed !!\n\tdryL\t=  in1;\t\t\t\t\t\t\t\t\t// compensate\n\tdryR\t=  in2;\n} else {\n\tdryPan\t\t=  eviLine(panscale, smoothsamps);\n\tcosL, sinR\t=  quartParOneApprox(dryPan);\n\tx0\t\t=  in1;\n//\txN\t\t=  in2;\n\tdryL\t=  in1 * cosL;\t\t\t\t\t\t\t// & compensate\n\tdryR\t=  in1 * sinR;\n}\n\nrvrbL\t\t=  dryL;\nrvrbR\t\t=  dryR;\ndryLmix\t\t=  dryL;\ndryRmix\t\t=  dryR;\n\n\n// -------\tbypass (smooth and cpu)\n\niBypass\t\t= int(bypass);\npassSmooth\t= iBypass ? 0.333 : 0.666;\nPASS\t\t= eviLine(iBypass, passSmooth*samplerate);\niPass\t\t= 1 - PASS;\n\nif (PASS < 1) {\n\n\n// -------\tsmoothing (audio rate)\n\n// technically can get away without the cost of smoothing 'decayscale' & 'damp', but not ideal\ndamping, decMulL\t= logsmoothBank2(damp, decayscale, smoothsecs);\ndecMulR\t= decMulL;\n\nwetMix, dryMix\t= logsmoothBank2(wetAmp, dryAmp, smoothsecs);\nwetMix\t\t\t= wetMix * SUMMUL * iPass;\ndryAtten\t\t= dryMix * SUMMULSQ * iPass;\n\neqHighK\t\t\t\t= eviLine(highshelfK, smoothsamps);\neqLowK\t\t\t\t= eviLine(lowshelfK, smoothsamps);\neqHighG, eqLowG\t\t= logsmoothBank2(highshelfG, lowshelfG, smoothsecs);\n\n// the problem with this reverb algo / the decision to make:\n// firstly, sounds shit for this reverb doing big smooths here <<-- i did this for taps\n// secondly, should smooth 'size' and 'diffuse' and pass on, or do 22 smoothers at end of calcs ??\n// thirdly, expensively zero hold delay changes with double bufffers <<-- i did this for diffusion\n\nsizemul\t\t=  eviSline(sizescale, smoothsamps);\n\n\n// -------\ttimes dynamic (smoothed)\n\nLtimeMul1\t=  sizemul * (0.02258 * SRATE);\nLtimeMul3\t=  sizemul * (0.06048 * SRATE);\nLtimeMul4\t=  sizemul * (0.12500 * SRATE);\n\nRtimeMul1\t=  sizemul * (0.03051 * SRATE);\nRtimeMul3\t=  sizemul * (0.08924 * SRATE);\nRtimeMul4\t=  sizemul * (0.10628 * SRATE);\n\n\n// -------\tdry mixes\t(do pan shit here too ?) (cosL, sinR)\n\ndryLmix\t\t=  dryL * dryMix;\ndryRmix\t\t=  dryR * dryMix;\ndryLatten\t=  dryL * dryAtten;\ndryRatten\t=  dryR * dryAtten;\n\n\n// -------\tearly\n\n// input bandwidth (damp)\nx1\t= poleZeroDamp((x0 * iPass),\tdamping);\n\n// early reflect (static)\nx1\t= fffbAllpassShort(x1,\tAPGAIN1,\tapTime1);\nx1\t= fffbAllpassShort(x1,\tAPGAIN1,\tapTime2);\nx1\t= fffbAllpassShort(x1,\tAPGAIN2,\tapTime3);\nx1\t= fffbAllpassShort(x1,\tAPGAIN2,\tapTime4);\n\n\n// -------\ttaps\n\n// taps left\ntap4L\t= tapsL.read(LtimeMul4,\tinterp=\"spline\");\ntap1L\t= fffbAllpassLong((x1 + tap4L),\t\t\tAPGAIN3,\t\tLtimeMul1);\ntap2L\t= delayReadZero1mod(tap1L, LtimeMul2,\tsmoothsamps,\t(modDepth - 0.00602));// + modulation (L)\ndampL\t= poleZeroDamp((tap2L + dryRatten),\t\tdamping);\t\t\t\t\t// + inject partial dry (R)\ntap3L\t= fffbAllpassLong((dampL * decMulL),\tAPGAIN4,\t\tLtimeMul3);\ntapsL.write(tap3L);\n\n// taps right\ntap4R\t= tapsR.read(RtimeMul4,\tinterp=\"spline\");\ntap1R\t= fffbAllpassLong((x1 + tap4R),\t\t\tAPGAIN3,\t\tRtimeMul1);\ntap2R\t= delayReadZero1mod(tap1R, RtimeMul2,\tsmoothsamps,\t(modDepth + 0.00021));// + modulation (R)\ndampR\t= poleZeroDamp((tap2R + dryLatten),\t\tdamping);\t\t\t\t\t// + inject partial dry (L)\ntap3R\t= fffbAllpassLong((dampR * decMulR),\tAPGAIN4,\t\tRtimeMul3);\ntapsR.write(tap3R);\n\n\n// -------\twrite / read / sum\n\nsum1L, sum2L\t= delayReadZero2(tap1L, CtimeMul1L, CtimeMul2L,\tsmoothsamps);\nsum1R, sum2R\t= delayReadZero2(tap1R, CtimeMul1R, CtimeMul2R,\tsmoothsamps);\n\n// sum left\nsumLeft\t\t\t= \n(sum1L\t\t\t+ \nsum2L\t\t\t- \ndelayReadZero1(tap3L, CtimeMul3L, smoothsamps) + \ndelayReadZero1(tap4L, CtimeMul4L, smoothsamps) - \ndelayReadZero1(tap2R, CtimeMul5L, smoothsamps) - \ndelayReadZero1(tap3R, CtimeMul6L, smoothsamps) - \ndelayReadZero1(tap4R, CtimeMul7L, smoothsamps));\n\n// sum right\nsumRight\t\t= \n(sum1R\t\t\t+ \nsum2R\t\t\t- \ndelayReadZero1(tap3R, CtimeMul3R, smoothsamps) + \ndelayReadZero1(tap4R, CtimeMul4R, smoothsamps) - \ndelayReadZero1(tap2L, CtimeMul5R, smoothsamps) - \ndelayReadZero1(tap3L, CtimeMul6R, smoothsamps) - \ndelayReadZero1(tap4L, CtimeMul7R, smoothsamps));\n\nrvrbL\t\t\t=  sumLeft * wetMix;\nrvrbR\t\t\t= sumRight * wetMix;\n\n\n// -------\teq\n\n// 1-pole eq cut/boost shelf filters\n// if high/lowshelfK params == 1, filters become high/lowpasses\n// if high/lowshelfK params == 0, do not compute\n\nif (eqHighK != 0) {\n\trvrbL\t= rcFilterDamp(rvrbL, eqHighG, eqHighK);\t\t// highshelf\n\trvrbR\t= rcFilterDamp(rvrbR, eqHighG, eqHighK);\n}\n\n//if (eqLowK != 0) { \t\t\t\t\t\t\t\t\t\t// cpu manage not click-free for low :-(\n\trvrbL   = rcFilterDampHp(rvrbL, eqLowG, eqLowK);\t\t// lowshelf\n\trvrbR   = rcFilterDampHp(rvrbR, eqLowG, eqLowK);\n//}\n\n\n// --- bypass (smooth and cpu)\n\n}\t// end\n\n\n// -------\tsum & output\n\nout1\t= interp(PASS, (rvrbL + dryLmix), dryL, mode=\"cosine\");\nout2\t= interp(PASS, (rvrbR + dryRmix), dryR, mode=\"cosine\");\n\n\n// -------\n\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 30.0, 54.0, 864.0, 675.0 ]
                }
            },
