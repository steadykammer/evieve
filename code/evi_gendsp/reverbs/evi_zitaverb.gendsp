                    "patching_rect": [ 1038.0, 19.0, 87.0, 22.0 ],
                    "text": "in 2 Audio In R"
                }
            },
            {
                "box": {
                    "code": "\r\n//\t//\t//\tevi_zitaverb.gendsp\r\n//\t//\t//\tstereo FDN / Allpass reverb for gen~ by Pete for evieve\r\n//\t//\t//\ta port (and modification) of the famous open source \"zita-rev-1\" by Fons Adriaensen\r\n//\t//\t//\tOriginal Copyright (C) 2003-2011 Fons Adriaensen <fons@linuxaudio.org>, LGPL v2\r\n\r\n\r\n//\t//\t//\tLIB\r\n\r\nrequire(\"evi_reverb_library.genexpr\");\r\n\r\n\r\n//\t//\t//\tDECLARE\r\n\r\n// constants in samples from external javascript, defaults are for 48kHz samplerate\r\nParam\tapTime1(977,\tmin=1, max=6068);\nParam\tapTime2(1172,\tmin=1, max=6068);\nParam\tapTime3(1517,\tmin=1, max=6068);\nParam\tapTime4(1312,\tmin=1, max=6068);\nParam\tapTime5(1099,\tmin=1, max=6068);\nParam\tapTime6(1406,\tmin=1, max=6068);\nParam\tapTime7(646,\tmin=1, max=6068);\nParam\tapTime8(918,\tmin=1, max=6068);\n\r\nParam\tfbTime1(7350,\tmin=1, max=49323);\nParam\tfbTime2(10099,\tmin=1, max=49323);\nParam\tfbTime3(6136,\tmin=1, max=49323);\nParam\tfbTime4(12331,\tmin=1, max=49323);\nParam\tfbTime5(8386,\tmin=1, max=49323);\nParam\tfbTime6(9231,\tmin=1, max=49323);\nParam\tfbTime7(6000,\tmin=1, max=49323);\nParam\tfbTime8(10560,\tmin=1, max=49323);\n\r\nParam\tdfTime1(6373,\tmin=1, max=44075);\nParam\tdfTime2(8927,\tmin=1, max=44075);\nParam\tdfTime3(4619,\tmin=1, max=44075);\nParam\tdfTime4(11019,\tmin=1, max=44075);\nParam\tdfTime5(7287,\tmin=1, max=44075);\nParam\tdfTime6(7825,\tmin=1, max=44075);\nParam\tdfTime7(5354,\tmin=1, max=44075);\nParam\tdfTime8(9642,\tmin=1, max=44075);\n\r\n// fdn\r\nDelay\tfbDelay1\t(\tfbTime1+1,\tfeedback=1\t);\r\nDelay\tfbDelay2\t(\tfbTime2+1,\tfeedback=1\t);\r\nDelay\tfbDelay3\t(\tfbTime3+1,\tfeedback=1\t);\r\nDelay\tfbDelay4\t(\tfbTime4+1,\tfeedback=1\t);\r\nDelay\tfbDelay5\t(\tfbTime5+1,\tfeedback=1\t);\r\nDelay\tfbDelay6\t(\tfbTime6+1,\tfeedback=1\t);\r\nDelay\tfbDelay7\t(\tfbTime7+1,\tfeedback=1\t);\r\nDelay\tfbDelay8\t(\tfbTime8+1,\tfeedback=1\t);\r\n\r\n// pre\r\nDelay\tPreDelayL\t(\tsamplerate*0.170+1,\t\tfeedback=0\t);\r\nDelay\tPreDelayR\t(\tsamplerate*0.170+1,\t\tfeedback=0\t);\r\n\r\nHistory\txL(0), xR(0);\t\t\t\t\t\t// align dry signals\r\nHistory\ttL(0), tR(0);\t\t\t\t\t\t// align tapped signals\r\n\r\n// reverb controls\r\nParam\tpredelay\t(\t19.,\t\tmin= 0,\t\tmax= 170\t);\t// ms\r\nParam\tcrossover\t(\t315.,\t\tmin= 31.25,\tmax= 1260\t);\t// Hz\r\nParam\tlowdecay\t(\t3.333333,\tmin= 0.06,\tmax= 60\t\t);\t// seconds, low RT60\r\nParam\tmiddecay\t(\t2.222222,\tmin= 0.06,\tmax= 60\t\t);\t// seconds, mid RT60\r\nParam\tdamp\t\t(\t3780.,\t\tmin= 500,\tmax= 15000\t);\t// Hz (1000 .. 8000 ?)\t// maximum will actually be sr/4\r\n//Param\tfeedback\t(\t1.,\t\t\tmin= 0.001,\tmax= 1\t\t);\t// amplitude, for testing only, keep at '1' !!\r\n\r\n// eq coefficients\r\n// calculated externally, defaults: samplerate: 48000 / lowshelf: 315 Hz, 0 dB, 1.0 res / highshelf: 1260 Hz, 0 dB, 0.5 res\r\n// (pointless min/max are only for avoiding code export forcing 0..1)\nParam\teq1_a1\t\t(\t0.979389,\tmin=-1,\t\tmax= 1\t\t);\nParam\teq1_a2\t\t(\t0.020195,\tmin=-1,\t\tmax= 1\t\t);\nParam\teq1_a3\t\t(\t0.000416,\tmin=-1,\t\tmax= 1\t\t);\nParam\teq1_m0\t\t(\t1.,\t\t\tmin=-16,\tmax= 16\t\t);\t// eq1_m0 static @ '1' for lowshelf or bell choices\nParam\teq1_m1\t\t(\t0.,\t\t\tmin=-16,\tmax= 16\t\t);\nParam\teq1_m2\t\t(\t0.,\t\t\tmin=-16,\tmax= 16\t\t);\r\nParam\teq2_a1\t\t(\t0.853140,\tmin=-1,\t\tmax= 1\t\t);\nParam\teq2_a2\t\t(\t0.070516,\tmin=-1,\t\tmax= 1\t\t);\nParam\teq2_a3\t\t(\t0.005828,\tmin=-1,\t\tmax= 1\t\t);\nParam\teq2_m0\t\t(\t1.,\t\t\tmin=-16,\tmax= 16\t\t);\t// (highshelf / bell requires eq2_m0 coefficient)\nParam\teq2_m1\t\t(\t0.,\t\t\tmin=-16,\tmax= 16\t\t);\nParam\teq2_m2\t\t(\t0.,\t\t\tmin=-16,\tmax= 16\t\t);\n\r\n// mix controls\r\nParam\tgain\t\t(  -1.,\t\t\tmin=-80,\tmax= 20\t\t);\t// dB\r\nParam\tdrywet\t\t(\t0.8666,\t\tmin= 0,\t\tmax= 1\t\t);\t// % 0..1\r\nParam\tbypass\t\t(\t0,\t\t\tmin= 0,\t\tmax= 1\t\t);\t// 'mix' to real '0'\r\n\r\n\r\n//\t//\t//\tCONSTANTS\r\n\r\nParam\tsqrt8const\t ( 2.8284271247461903,\tmin=  0,\tmax= 10);//  sqrt(N)\t[ N = 8 fdn lines ]\r\nParam\tsqrt8constMul( 0.35355339059327373,\tmin=  0,\tmax= 1 );//  1 / sqrt8const; (sqrt(0.125))\r\nParam\tm3l10const\t (-6.907755278982138,\tmin=-10,\tmax= 0 );// -3 * log(10)\r\nParam\tgainAPconst\t ( 0.6033,\t\t\t\tmin=  0,\tmax= 1 );// -0.6 or +0.6 allpass gains\r\n//Param\tgainAPconst\t ( 0.690775527898214,\tmin=  0,\tmax= 1 );//  abs( m3l10const / 10 )\r\nParam\tconst3mul\t ( 0.333333333333333,\tmin=  0,\tmax= 1 );//  1 / 3\r\n//Param\ttapMul\t\t ( 0.37,\t\t\t\tmin=  0,\tmax= 1 );//  fons\r\n\r\n\r\n//\t//\t//\tPARSE PARAM RATE\r\n\r\nxover_N\t\t= twopi * crossover / samplerate;\r\ndamp_M\t\t= minimum(damp, (samplerate * 0.25));\ndamp_N\t\t= 1 - cosQ73(twopi * damp_M / samplerate);\n\r\n//pd_Samp\t= maximum(mstosamps(predelay), 1);// not convinced we need this clip\r\npd_Samp\t\t= mstosamps(predelay);\r\nl_t60samp\t= lowdecay * samplerate;\r\nm_t60samp\t= middecay * samplerate;\r\n\r\n//fb_0\t\t= feedback;\r\n//out_amp\t= dbtoaApprox(gain);\t\t\t\t\t\t\t\t// not using\r\ndw_mix\t\t= ((drywet * 0.9998) + 0.0002) * (1 - int(bypass));\t// '0' only if 'bypass' == '1'\r\n//dw_mix\t= drywet * (1 - int(bypass));\r\n\r\n//wlo, glo, whi, gmf\t= delayFiltCoeff(dfTime[n], l_t60samp, m_t60samp, xover_N, damp_N, m3l10const);\r\n\r\n\r\n//\t//\t//\tPARSE AUDIO RATE\r\n\r\nsr015\t\t\t= 0.015111 * samplerate;\r\nxoverN\t\t\t= eviLine(xover_N, sr015);\r\ndampN\t\t\t= eviLine(damp_N, sr015);\r\n\r\n\r\npdSamp\t\t\t= eviLine(pd_Samp, (0.022666 * samplerate));\r\nlt60samp, mt60samp\t\r\n\t\t\t\t= logsmoothBank2(l_t60samp, m_t60samp, 0.022666);\r\n\r\n//outamp\t\t= logsmooth(out_amp, 0.030222);\t\t\t\t// not using\r\nmix\t\t\t\t= eviLine(dw_mix, (0.30222 * samplerate));\t// exact ramp for cpu management\r\n\r\n// inputs\r\n\r\nxL\t\t= in1;\t\t// align\r\nxR\t\t= in2;\r\n\r\nPreDelayL.write(in1);\r\nPreDelayR.write(in2);\r\n\r\n\r\n//\t//\t//\tCPU MANAGE with mix\r\n\r\n//invmix\t= 1 - mix;\r\n//invxL\t= xL * invmix * sqrt8constMul;\r\n//invxR\t= xR * invmix * sqrt8constMul;\r\n\r\nyL\t\t= xL;\r\nyR\t\t= xR;\r\n\r\ndelIn1\t= 0;//invxL;\r\ndelIn3\t= 0;//invxL;\r\ndelIn5\t= 0;//invxL;\r\ndelIn7\t= 0;//invxL;\r\ndelIn2\t= 0;//invxR;\r\ndelIn4\t= 0;//invxR;\r\ndelIn6\t= 0;//invxR;\r\ndelIn8\t= 0;//invxR;\r\n\r\nif (mix > 0) {\t\t\t// '0' only if 'bypass' == '1'\r\n\r\n\r\n// \t//\t//\tPRE DELAY\r\n\r\ninL\t\t= PreDelayL.read(pdSamp, interp=\"fastcubic\") * const3mul;//sqrt8constMul;\r\ninR\t\t= PreDelayR.read(pdSamp, interp=\"fastcubic\") * const3mul;//sqrt8constMul;\r\n\r\n\r\n//\t//\t//\t8X8 FEEDBACK DELAY NETWORK\r\n\r\n// sum & fan to inputs, allpass network, through fdn matrix\r\n\r\nfb1, fb2, fb3, fb4, fb5, fb6, fb7, fb8\t\r\n\t\t= hadamard8(\r\n\t\t\t\t\tapDelaySingle((fbDelay1.read(fbTime1, interp=\"none\") + inL), apTime1,  gainAPconst),\r\n\t\t\t\t\tapDelaySingle((fbDelay2.read(fbTime2, interp=\"none\") + inR), apTime2, -gainAPconst),\r\n\t\t\t\t\tapDelaySingle((fbDelay3.read(fbTime3, interp=\"none\") - inL), apTime3,  gainAPconst),\r\n\t\t\t\t\tapDelaySingle((fbDelay4.read(fbTime4, interp=\"none\") - inR), apTime4, -gainAPconst),\r\n\t\t\t\t\tapDelaySingle((fbDelay5.read(fbTime5, interp=\"none\") + inL), apTime5,  gainAPconst),\r\n\t\t\t\t\tapDelaySingle((fbDelay6.read(fbTime6, interp=\"none\") + inR), apTime6, -gainAPconst),\r\n\t\t\t\t\tapDelaySingle((fbDelay7.read(fbTime7, interp=\"none\") - inL), apTime7,  gainAPconst),\r\n\t\t\t\t\tapDelaySingle((fbDelay8.read(fbTime8, interp=\"none\") - inR), apTime8, -gainAPconst)\r\n\t\t\t\t   );\r\n\r\n// lowshelf / lowpass damping network\r\n\r\n// we should really do coefficients at param rate or externally, but cannot get delay times in before main loop of export\r\ndelIn1\t= delayFilter(fb1 * sqrt8constMul, dfTime1, lt60samp, mt60samp, xoverN, dampN, m3l10const);\r\ndelIn2\t= delayFilter(fb2 * sqrt8constMul, dfTime2, lt60samp, mt60samp, xoverN, dampN, m3l10const);\r\ndelIn3\t= delayFilter(fb3 * sqrt8constMul, dfTime3, lt60samp, mt60samp, xoverN, dampN, m3l10const);\r\ndelIn4\t= delayFilter(fb4 * sqrt8constMul, dfTime4, lt60samp, mt60samp, xoverN, dampN, m3l10const);\r\ndelIn5\t= delayFilter(fb5 * sqrt8constMul, dfTime5, lt60samp, mt60samp, xoverN, dampN, m3l10const);\r\ndelIn6\t= delayFilter(fb6 * sqrt8constMul, dfTime6, lt60samp, mt60samp, xoverN, dampN, m3l10const);\r\ndelIn7\t= delayFilter(fb7 * sqrt8constMul, dfTime7, lt60samp, mt60samp, xoverN, dampN, m3l10const);\r\ndelIn8\t= delayFilter(fb8 * sqrt8constMul, dfTime8, lt60samp, mt60samp, xoverN, dampN, m3l10const);\r\n\r\n\r\n//\t//\t//\tPOST PROCESSING CHAIN\r\n\r\n// taps\r\n\r\ntL, tR\t= butterfly2(fb2, fb3);\t// funny Fons\r\nyL\t\t= tL * sqrt8constMul;//tapMul;\r\nyR\t\t= tR * sqrt8constMul;//tapMul;\r\n\r\n// eq\r\n\r\n// coefficients external\r\nyL, yR\t= eviSvfTwoSectionsStereo(yL, yR,\t\t\r\n\t\t\t\teq1_a1, eq1_a2, eq1_a3, eq1_m0, eq1_m1, eq1_m2, eq2_a1, eq2_a2, eq2_a3, eq2_m0, eq2_m1, eq2_m2);\r\n\r\n\r\n}\t//\t//\tend CPU MANAGE with mix\r\n\r\n// delay line inputs (outside of mix manage)\r\n\r\nfbDelay1.write(fixdenorm(delIn1));\r\nfbDelay2.write(fixdenorm(delIn2));\r\nfbDelay3.write(fixdenorm(delIn3));\r\nfbDelay4.write(fixdenorm(delIn4));\r\nfbDelay5.write(fixdenorm(delIn5));\r\nfbDelay6.write(fixdenorm(delIn6));\r\nfbDelay7.write(fixdenorm(delIn7));\r\nfbDelay8.write(fixdenorm(delIn8));\r\n\r\n// dry/wet mix\r\n\r\nrvrbL, rvrbR\t= xfadeQuartApproxStereo(xL, xR, yL, yR, mix);\r\n\r\n// output gain\t// no\r\n\r\n//rvrbL\t= rvrbL * outamp;\r\n//rvrbR\t= rvrbR * outamp;\r\n\r\n// outputs\r\n\r\nout1\t= rvrbL;\r\nout2\t= rvrbR;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 45.0, 56.0, 1012.0, 675.0 ]
                }
            },
