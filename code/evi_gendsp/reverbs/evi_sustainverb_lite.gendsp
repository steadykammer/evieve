            {
                "box": {
                    "code": "\r\n//\t//\t//\tevi_sustainverb_lite.gendsp\r\n//\t//\t//\t4 line feeback delay network after Miller Puckette (@see: rev2.pd), BSD\r\n//\t//\t//\tby pete for evieve, with extras\r\n//\t//\t//\tfor a much better reverb, see the big sister evi_sustainverb.gendsp (16x16 network)\r\n\r\n\r\n//\t//\t//\tlibrary\r\n\r\nrequire(\"evi_reverb_library.genexpr\");\r\n\r\n\r\n//\t//\t//\tdeclare\r\n\r\n// constants in samples from external javascript, defaults are for 48kHz samplerate\r\nParam\tearlyTime1 \t(\t3612,\tmin=1, max=14449\t);\nParam\tearlyTime2 \t(\t2090,\tmin=1, max=8359\t\t);\nParam\tearlyTime3 \t(\t1238,\tmin=1, max=4953\t\t);\nParam\tearlyTime4 \t(\t931,\tmin=1, max=3723\t\t);\nParam\tearlyTime5 \t(\t785,\tmin=1, max=3142\t\t);\nParam\tearlyTime6 \t(\t655,\tmin=1, max=2620\t\t);\n\r\nDelay\tearly1\t\t(\tearlyTime1,\t\tfeedback=0\t);\r\nDelay\tearly2\t\t(\tearlyTime2,\t\tfeedback=0\t);\r\nDelay\tearly3\t\t(\tearlyTime3,\t\tfeedback=0\t);\r\nDelay\tearly4\t\t(\tearlyTime4,\t\tfeedback=0\t);\r\nDelay\tearly5\t\t(\tearlyTime5,\t\tfeedback=0\t);\r\nDelay\tearly6\t\t(\tearlyTime6,\t\tfeedback=0\t);\r\n\r\n// Miller Puckette's tuning:\r\nParam\tdelayTime1 \t(\t2815,\tmin=1, max=16536\t);\nParam\tdelayTime2 \t(\t3333,\tmin=1, max=16536\t);\nParam\tdelayTime3 \t(\t3577,\tmin=1, max=16536\t);\nParam\tdelayTime4 \t(\t4134,\tmin=1, max=16536\t);\n\r\nDelay\tfdnDelay1\t(\tdelayTime1+1,\tfeedback=1\t);\r\nDelay\tfdnDelay2\t(\tdelayTime2+1,\tfeedback=1\t);\r\nDelay\tfdnDelay3\t(\tdelayTime3+1,\tfeedback=1\t);\r\nDelay\tfdnDelay4\t(\tdelayTime4+1,\tfeedback=1\t);\r\n\r\n// global controls\r\nParam\tsmoothtime(22.666, min=0, max=300);\t// ms\r\n// reverb controls\r\nParam\tearly(sqrt1_2, min=0, max=1);\t\t// % 0..1 ( OR 0/1 )\r\nParam\tlate(0.803554, min=0, max=1);\t\t// % 0..1\r\n// damping controls\r\nParam\tcrossover(3000, min=500, max=15000);// Hz\r\nParam\tdamp(0.1, min=0, max=1);\t\t\t// % 0..1\r\n// mixing controls\r\nParam\tfdnsum(0, min=0, max=1);\t\t\t// % 0..1 ( OR 0/1 )\r\nParam\tdrywet(0.8666, min=0, max=1);\t\t// % 0..1\r\n\r\n\r\n//\t//\t//\tparse param rate\r\n\r\nsmoothsecs\t= smoothtime * 0.001;\r\nsmoothsamps\t= smoothsecs * samplerate;\r\n\r\ninv_early\t= 1 - early;\r\nfb_0\t\t= sqrt(late) * 0.5;\t\t\t\t// this is correct\r\n\r\nG, K\t\t= rcDampCoeffs0(crossover, ((1 - damp) - 1));\r\n\r\n\r\n//\t//\t//\tparse audio rate\r\n\r\n//earlymix, fdnmix\t= multiLine2(inv_early, fdnsum, smoothsamps);\r\nearlymix\t\t\t= eviLine(inv_early, smoothsamps);\r\nfdnmix\t\t\t\t= eviLine(fdnsum, smoothsamps);\r\nfb0\t\t\t\t\t= logsmooth(fb_0, smoothsecs);\r\nxover, damp00\t\t= expsmoothBank2(G, K, smoothsecs);\r\ndamp01\t\t\t\t= damp00 * 0.804199;\t// a bit funky\r\nmix\t\t\t\t\t= eviLine(drywet, samplerate*0.333333);\r\n\r\n\r\n//\t//\t//\tprocessing\t\t(static & integer delay times so no interpolation)\r\n\r\nxL\t\t= in1+0;\r\nxR\t\t= in2+0;\r\n\r\n// (earlymix) additional early reflections...\r\n\r\nearly1.write\t(\txR\t\t\t);\r\ne1r\t= early1.read(earlyTime1, interp=\"none\");\r\nep1\t= xL  + e1r;\r\nearly2.write\t(\txL  - e1r\t);\r\n\r\n// cpu management not that important as whole sustainverb is very cheap?\r\n//if (mix > 0) {\t//\t//\t//\tbegin :: CPU mute if mix @ 0 %\r\n\r\ne2r\t= early2.read(earlyTime2, interp=\"none\");\r\nep2\t= ep1 + e2r;\r\nearly3.write\t(\tep1 - e2r\t);\r\ne3r\t= early3.read(earlyTime3, interp=\"none\");\r\nep3\t= ep2 + e3r;\r\nearly4.write\t(\tep2 - e3r\t);\r\ne4r\t= early4.read(earlyTime4, interp=\"none\");\r\nep4\t= ep3 + e4r;\r\nearly5.write\t(\tep3 - e4r\t);\r\ne5r\t= early5.read(earlyTime5, interp=\"none\");\r\nep5\t= ep4 + e5r;\r\nearly6.write\t(\tep4 - e5r\t);\r\ne6r\t= early6.read(earlyTime6, interp=\"none\");\r\n\t\r\ntapIn1\t= interp(\tearlymix,\tep5 * 0.251189,\t\txL,\t\tmode=\"linear\");\r\ntapIn2\t= interp(\tearlymix,\te6r * 0.251189,\t\txR,\t\tmode=\"linear\");\r\n\r\n// input conditioning and damping to fdn...\r\n\r\n// high or low pass if damp0 == 1, bypass if damp0 == 0, else low or high shelf attenuation\r\ndamp1\t= rcFilterDamp(\tfdnDelay1.read(delayTime1,\tinterp=\"none\"),\t\txover,\tdamp00);\r\ndamp2\t= rcFilterDamp(\tfdnDelay2.read(delayTime2,\tinterp=\"none\"),\t\txover,\tdamp00);\r\ndamp3\t= rcFilterDamp(\tfdnDelay3.read(delayTime3,\tinterp=\"none\"),\t\txover,\tdamp01);\r\ndamp4\t= rcFilterDamp(\tfdnDelay4.read(delayTime4,\tinterp=\"none\"),\t\txover,\tdamp01);\r\n\r\n// fdn read...\r\n\r\nfb1\t\t= tapIn1\t+\t(damp1\t* fb0);\r\nfb2\t\t= tapIn2\t+\t(damp2\t* fb0);\r\nfb3\t\t=\t\t\t\t damp3\t* fb0 ;\r\nfb4\t\t=\t\t\t\t damp4\t* fb0 ;\r\n\r\n// fdn matrix...\r\n\r\ndx1, dx2, dx3, dx4\t= butterflyMatrix(fb1, fb2, fb3, fb4);\r\n\r\n// taps...\r\n\r\ntapOut1\t= dcblock(fb1 * 0.177828);\r\ntapOut2\t= dcblock(fb2 * 0.177828);\r\ntapOut3\t= dcblock(fb3 * 0.251189);\r\ntapOut4\t= dcblock(fb4 * 0.251189);\r\n\r\n// main taps...\r\n\r\n// should be butterfly tap ??\r\nfdnL\t= interp(\tfdnmix,\t\ttapOut1,\t((tapOut1 + tapOut2) * 0.501187),\tmode=\"linear\");\r\nfdnR\t= interp(\tfdnmix,\t\ttapOut3,\t((tapOut3 + tapOut4) * 0.501187),\tmode=\"linear\");\r\n\r\n// add dry/wet...\r\n\r\nrvrbL, rvrbR\t= xfadeQuartApproxStereo(xL, xR, fdnL, fdnR, mix);\r\n\r\n\r\n//}\t//\t//\t//\tend :: CPU mute if mix @ 0 %\r\n\r\n\r\n// fdn write (update delay lines)...\r\n\r\nfdnDelay1.write\t\t(\tfixdenorm(dx1)\t\t);\r\nfdnDelay2.write\t\t(\tfixdenorm(dx2)\t\t);\r\nfdnDelay3.write\t\t(\tfixdenorm(dx3)\t\t);\r\nfdnDelay4.write\t\t(\tfixdenorm(dx4)\t\t);\r\n\r\n// outputs...\r\n\r\nout1\t= rvrbL;\r\nout2\t= rvrbR;\r\n\r\nout3\t= fdnL;\r\nout4\t= fdnR;\r\n\r\nout5\t= tapOut1;\r\nout6\t= tapOut2;\r\nout7\t= tapOut3;\r\nout8\t= tapOut4;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 8,
                    "outlettype": [ "", "", "", "", "", "", "", "" ],
                    "patching_rect": [ 30.0, 56.0, 873.0, 705.0 ]
                }
            }
        ],
