, 			{
				"box" : 				{
					"code" : "\r\n//\t//\t//\tevi_algoverb.gendsp\r\n//\t//\t//\ttrue stereo algorithmic reverb for gen~ by Pete Dowling for evieve\r\n//\t//\t//\tbased on allpass 'diffuse delay' design by Martijn Zwartjes\r\n\r\n\r\n//\t//\t//\tlibrary of custom functions for algoverb\r\n\r\nrequire(\"evi_algoverb_library.genexpr\");\r\n\r\n\r\n//\t//\t//\tdeclare\r\n\r\n// global\r\n\r\nParam\tsmoothtime(50, min=0, max=500);\t\t// in ms\r\nParam\tabsorbtion(0.186, min=0, max=1);\t// % 0..1\r\nParam\tearlylate(0.46, min=0, max=1);\t\t// early..late % 0..1\r\nParam\tearlylock(1, min=0, max=1);\t\t\t// hysterisis\t// always int, no user interaction\r\nParam\tlatelock(1, min=0, max=1);\t\t\t// hysterisis\t// always int, no user interaction\r\nParam\tdrywet(0.4, min=0, max=1);\t\t\t// dry..wet % 0..1\r\n\r\n// pre delay\r\n\r\n// compensate dry L/R for minimum delay\r\nHistory\tcompensateDryL(0), compensateDryR(0);\r\n\r\n// support @ up to 400 ms\r\n\r\nDelay\tpreDelayL(samplerate*0.4, 1, feedback=0);\r\nDelay\tpreDelayR(samplerate*0.4, 1, feedback=0);\r\n\r\nParam\tpreTime(16, min=0, max=400);\t\t// delay time in ms\r\nParam\tpreSymmetry(0.33, min=-1, max=1);\t// L/R offset\r\n\r\n// damping high/low shelfs eqs\r\n\r\n// coefficients, defaults:\r\n// samplerate: 48000\r\n// lowshelf: 69.3 Hz, -0.7 dB, 0.5 res\r\n// highshelf: 1108.7 Hz, -1.2 dB, 0.5 res\n// (pointless min/max are only for avoiding code export forcing 0..1)\r\nParam\tdamp1_a1( 0.990808,\tmin=-1, max=1);\nParam\tdamp1_a2( 0.004585,\tmin=-1, max=1);\nParam\tdamp1_a3( 0.000021,\tmin=-1, max=1);\nParam\tdamp1_m0( 1,\t\tmin=-2, max=2);\t// damp1_m0 static @ '1' for lowshelf\nParam\tdamp1_m1(-0.078988,\tmin=-2, max=2);\nParam\tdamp1_m2(-0.077429,\tmin=-2, max=2);\r\nParam\tdamp2_a1( 0.873073,\tmin=-1, max=1);\nParam\tdamp2_a2( 0.061311,\tmin=-1, max=1);\nParam\tdamp2_a3( 0.004305,\tmin=-1, max=1);\nParam\tdamp2_m0( 0.870964,\tmin=-2, max=2);\nParam\tdamp2_m1( 0.124581,\tmin=-2, max=2);\nParam\tdamp2_m2( 0.129036,\tmin=-2, max=2);\n\r\n// early reflections\r\n\r\nParam\tearlySize(31.992, min=-12, max=60);\r\nParam\tearlySymmetry(1.7, min=-4, max=4);\r\nParam\tearlyDiffusion(0.7, min=0, max=1);\r\n\r\n// late reflections\r\n\r\nParam\tlateSize(0.984, min=-24, max=48);\r\nParam\tlateSymmetry(-1.3, min=-3, max=3);\r\nParam\tlateDiffusion(0.7, min=0, max=1);\r\n\r\n// support 6.428243 .. 581.818179 ms (incl. ± modulation)\r\nDelay\trtDelayL(samplerate*0.582, 1, feedback=1);\r\nDelay\trtDelayR(samplerate*0.582, 1, feedback=1);\r\n\r\nParam\tdecay(0.475, min=0, max=1);\t// % 0..1\t(rt60 = decay * 120)\r\n\r\n// modulation\r\n\r\nParam\tmodFrequency(0.23, min=0, max=1);\r\nParam\tmodAmplitude(0.15, min=0, max=1);\t// amplitude = ms\r\n\r\n// master eq, end of wet chain, fixed high/low shelfs but could be other filter types\r\n\r\n// coefficients, defaults:\r\n// samplerate: 48000\r\n// lowshelf: 92.5 Hz, -3.5 dB, 1.0 res\r\n// highshelf: 2217.5 Hz, -7. dB, 1.0 res\r\n// (pointless min/max are only for avoiding code export forcing 0..1)\nParam\teq1_a1( 0.993304,\tmin=-1,\t\tmax=1\t);\nParam\teq1_a2( 0.006651,\tmin=-1,\t\tmax=1\t);\nParam\teq1_a3( 0.000045,\tmin=-1,\t\tmax=1\t);\nParam\teq1_m0( 1,\t\t\tmin=-16,\tmax=16\t);\t// eq1_m0 static @ '1' for lowshelf\nParam\teq1_m1(-0.182477,\tmin=-16,\tmax=16\t);\nParam\teq1_m2(-0.331656,\tmin=-16,\tmax=16\t);\r\nParam\teq2_a1( 0.882013,\tmin=-1,\t\tmax=1\t);\nParam\teq2_a2( 0.105393,\tmin=-1,\t\tmax=1\t);\nParam\teq2_a3( 0.012594,\tmin=-1,\t\tmax=1\t);\nParam\teq2_m0( 0.446684,\tmin=-16,\tmax=16\t);\nParam\teq2_m1( 0.22166,\tmin=-16,\tmax=16\t);\nParam\teq2_m2( 0.553316,\tmin=-16,\tmax=16\t);\n\r\n// global cpu mute (& passes inputs to outputs)\r\n\r\nParam\tmute(0, min=0, max=1);\r\n\r\n\r\n//\t//\t//\tparse param rate from here ...\r\n\r\n// globals\r\n\r\npreSymActive\t= preSymmetry != 0;\r\nearlySymActive\t= earlySymmetry != 0;\t// not using unless we change if/else blocking below, compiler ignores it\r\nlateSymActive\t= lateSymmetry != 0;\r\n\r\nsmoothsecs\t= smoothtime * 0.001;\r\nsmoothsamps\t= smoothsecs * samplerate;\r\nmodSmooth\t= 0.066 * samplerate;\r\nelSmooth\t= mstosamps(smoothtime + 33);\r\ndwSmooth\t= mstosamps(smoothtime + 333);\r\nmmSmooth\t= 0.166 * samplerate;\r\n\r\nf1m0\t\t=  1;\r\nf3m0\t\t=  1;\t// must pass (and smooth) eq1_m0 instead if other filter types required\r\napunity\t\t=  1;\r\npowF\t\t=  1.1220184543019633;\r\n//expT\t\t= -6.9077552789821;\r\n\r\n// below 'apgaincoefficient1' 'clamp()' presumes:\r\n// \tdamp\tlowshelf:\tHz 10 .. 1000 only, dB input -6..0 only, slope fixed @ 0.5\r\n// \tdamp\thighshelf: \tany Hz, dB input -6..0 only, slope fixed @ 0.5\r\nabsorb\t\t\t\t\t= absorbtion * absorbtion;\r\napgaincoefficient0\t\t= 2;\t\t\t\t\t\t\t// lowshelf affect on depth\r\napgaincoefficient1\t\t= clamp( ( (((1 - damp2_m0) + damp2_m1) * 0.413517) + 0.586483 ) + \r\n\t\t\t\t\t\t\t( ((damp1_a1 + damp1_a2) * damp1_a3) * (1 - ((damp1_m1 + damp1_m2) * apgaincoefficient0)) ), \r\n\t\t\t\t\t\t\t\t0.586484, 0.981584 );\r\napgaincoefficient2\t\t= interp(absorb, 0.981584, apgaincoefficient1, mode=\"cosine\");\r\n\r\n// for pre delay\r\n\r\npdTimeS\t\t\t\t=  mstosamps(preTime);\t\t\t\t// samples\r\npdTimeL, pdTimeR\t=  0;\r\n\r\n// for late reflections\r\n\r\nrt60value\t\t\t\t= decay * 120;\t\t\t\t\t// using dB scale\r\nrt60coeff\t\t\t\t= pow(powF, rt60value) * 0.001;\t// 0.001..1000\r\n\r\n// for diffusion\t// stupid\r\n\r\nearlyDiff\t= (earlyDiffusion * 0.98) + 0.01;\r\nlateDiff\t= (lateDiffusion * 0.98) + 0.01;\r\nfbCross\t\t=  1 - (absorbtion * sqrt1_2);\r\n\r\n// computing the following ~100 lines all of the time and keeping them out of if/else blocking actually saves a\r\n// considerable amount of cpu, as it forces the calculations to be at param rate at the beginning of the perform routine\r\n// and out of the while loop (the main sample loop) in the exported code.\r\n\r\n// for pre delay\r\n\r\n//if (preSymActive) {\r\n\r\n\tpdTimeL\t\t= pdTimeS * (1 - preSymmetry);\r\n\tpdTimeR\t\t= pdTimeS * (preSymmetry + 1);\r\n\r\n//}\r\n\r\n// for early reflections\r\n\r\n//erTime1L, erTime2L, erTime3L\t= 0;\r\n//erTime1R, erTime2R, erTime3R\t= 0;\r\n\r\n//if (earlySymActive) {\r\n\r\n\teSizeL\t\t= earlySize - earlySymmetry;\r\n\teSizeR\t\t= earlySize + earlySymmetry;\r\n\r\n\terTime1L\t= pitch2timeSamps(eSizeL,\t8);\t\t// MZ offsets\r\n\terTime2L\t= pitch2timeSamps(eSizeL,\t4);\r\n\terTime3L\t= pitch2timeSamps(eSizeL,\t0);\r\n\r\n\terTime1R\t= pitch2timeSamps(eSizeR,\t8);\r\n\terTime2R\t= pitch2timeSamps(eSizeR,\t4);\r\n\terTime3R\t= pitch2timeSamps(eSizeR,\t0);\r\n\r\n//} else {\r\n/*\r\n\terTime1L\t= pitch2timeSamps(earlySize,\t8);\r\n\terTime2L\t= pitch2timeSamps(earlySize,\t4);\r\n\terTime3L\t= pitch2timeSamps(earlySize,\t0);\r\n\r\n\terTime1R\t= erTime1L;\r\n\terTime2R\t= erTime2L;\r\n\terTime3R\t= erTime3L;\r\n*/\r\n//}\r\n\r\n// for late reflections\r\n\r\n//rt60mulL, rt60mulR\t\t\t= 0;\t\t\t\t// t60([decay time] / rt60coeff)\r\n\r\n//decayTimeL, decayTimeR\t\t= 0;\r\n//lrTime1L, lrTime2L, lrTime3L\t= 0;\r\n//lrTime1R, lrTime2R, lrTime3R\t= 0;\r\n\r\n//if (lateSymActive) {\r\n\r\n\tlrSizeL\t\t= lateSize - lateSymmetry;\r\n\tlrSizeR\t\t= lateSize + lateSymmetry;\r\n\r\n\tlrTime1L\t= pitch2timeSecs(lrSizeL,\t9);\t\t// MZ offsets\r\n\tlrTime2L\t= pitch2timeSecs(lrSizeL,\t6);\r\n\tlrTime3L\t= pitch2timeSecs(lrSizeL,\t3);\r\n\tdecayTimeL\t= pitch2timeSecs(lrSizeL,\t0);\r\n\r\n\tlrTime1R\t= pitch2timeSecs(lrSizeR,\t9);\r\n\tlrTime2R\t= pitch2timeSecs(lrSizeR,\t6);\r\n\tlrTime3R\t= pitch2timeSecs(lrSizeR,\t3);\r\n\tdecayTimeR\t= pitch2timeSecs(lrSizeR,\t0);\r\n\r\n\t// calculations take into account three stages of allpass diffuse delays before them, and 'decay' concept,\r\n\t// as real t60 multiplier would be 'expA(expT / (mstosamps(decayTimeX * 1000) / rt60coeff));'\r\n\trt60mulL\t= pow(powF, (maximum((decayTimeL / rt60coeff) * -60, -144)));\t// !! approx these !!\r\n\trt60mulR\t= pow(powF, (maximum((decayTimeR / rt60coeff) * -60, -144)));\r\n\r\n//} else {\r\n/*\r\n\tlrTime1L\t= pitch2timeSecs(lateSize,\t9);\r\n\tlrTime2L\t= pitch2timeSecs(lateSize,\t6);\r\n\tlrTime3L\t= pitch2timeSecs(lateSize,\t3);\r\n\tdecayTimeL\t= pitch2timeSecs(lateSize,\t0);\r\n\r\n\t// calculation takes into account three stages of allpass diffuse delays before it, and 'decay' concept,\r\n\t// as real t60 multiplier would be 'expA(expT / ((mstosamps(decayTimeL * 1000) / rt60coeff));'\r\n\trt60mulL\t= pow(powF, (maximum((decayTimeL / rt60coeff) * -60, -144)));\t// !! could approx this ??\r\n*/\r\n//}\r\n\r\n\r\n//\t//\t//\tparse audio inputs\r\n\r\n// for pre delay\r\n\r\npreDelayL.write(\tin1 + 0\t);\r\npreDelayR.write(\tin2 + 0\t);\r\n\r\ndryL\t\t= compensateDryL + 0;\r\ndryR\t\t= compensateDryR + 0;\r\nwetXl\t\t= dryL + 0;\r\nwetXr\t\t= dryR + 0;\r\n\r\n// for mixing & MUTE\r\n\r\nlateLeft\t= wetXl + 0;\r\nlateRight\t= wetXr + 0;\r\nwetYl\t\t= 0;\r\nwetYr\t\t= 0;\r\n\r\n\r\n//\t//\t//\tparse audio rate from here ...\r\n\r\n// exact ramps for cpu management\r\nearlyLateMix\t= eviLine(earlylate, elSmooth);\r\ndryWetMix\t\t= eviSline(drywet, dwSmooth);\t\t\t// no need for full eviSline for dryWetMix ?\r\nmuteMix\t\t\t= eviLine(int(mute), mmSmooth);\r\n\r\n\r\n//\t//\t//\tGLOBAL MUTE (muteMix) off / on\t//\t//\t//\tSTART\r\n\r\nif (muteMix < 1) {\r\n\r\n\r\n// reassignments (to \"f_...\") forces previous calculations to stay at param rate in the exported C++\r\n\r\n// for pre delay\r\n\r\nf_pdTimeL, f_pdTimeR\t= 0;\r\nprocessPreDelay\t\t\t= 0;\r\n\r\nif (preSymActive) {\r\n\r\n\tf_pdTimeL\t\t\t= eviLine(pdTimeL, smoothsamps);\r\n\tf_pdTimeR\t\t\t= eviLine(pdTimeR, smoothsamps);\r\n\tprocessPreDelay\t\t= (f_pdTimeL != 0) || (f_pdTimeR != 0);\r\n\r\n} else {\r\n\r\n\tf_pdTimeL\t\t\t=  eviLine(pdTimeS, smoothsamps);\r\n\tf_pdTimeR\t\t\t=  f_pdTimeL;\r\n\tprocessPreDelay\t\t= (f_pdTimeL > 0);\r\n\r\n}\r\n\r\n// for damp (eq) coefficients ('a' coefficients ok because zdf, but we smooth 'm' gains)\r\n\r\nf1a1\t= damp1_a1;\tf1a2\t= damp1_a2;\tf1a3\t= damp1_a3;\r\nf1m1\t= eviLine(damp1_m1, smoothsamps);\r\nf1m2\t= eviLine(damp1_m2, smoothsamps);\r\n\r\nf2a1\t= damp2_a1;\tf2a2\t= damp2_a2;\tf2a3\t= damp2_a3;\r\nss08\t= smoothsamps * 0.8;\r\nf2m0\t= eviLine(damp2_m0, ss08);\r\nf2m1\t= eviLine(damp2_m1, ss08);\r\nf2m2\t= eviLine(damp2_m2, ss08);\r\n\r\n//dampactive\t\t\t\t= ((f1m1 + f1m2) != 0) || ((f2m1 + f2m2) != 0);\r\napgain\t\t\t\t\t\t= expsmooth(apgaincoefficient2, (smoothsecs * sqrt2));\r\n\r\n// for early reflections\r\n\r\nf_earlyDiff\t\t\t= logsmooth(earlyDiff, smoothsecs);\r\n\r\neTm1L, eTm2L, eTm3L\t= logsmoothBank3(erTime1L, erTime2L, erTime3L, smoothsecs);\r\neTm1R, eTm2R, eTm3R\t= logsmoothBank3(erTime1R, erTime2R, erTime3R, smoothsecs);\r\n\r\n// for modulation\r\n\r\nmodRate\t\t\t= expsmooth(modFrequency, (smoothsecs * 0.333333));\r\nmodDepth, mdn\t= eviLine(modAmplitude * 0.001, modSmooth);\t// secs\r\n\r\n// for late reflections\r\n\r\nf_lrTime1L, f_lrTime2L, f_lrTime3L\t\t= logsmoothBank3(lrTime1L, lrTime2L, lrTime3L, smoothsecs);\r\nf_lrTime1R, f_lrTime2R, f_lrTime3R\t\t= 0;\r\nf_decayTimeL, f_decayTimeR\t\t\t\t= 0;\r\nf_rt60mulL, f_rt60mulR\t\t\t\t\t= 0;\r\n\r\nif (lateSymActive) {\r\n\r\n\tf_decayTimeL, f_decayTimeR\t= logsmoothBank2(decayTimeL, decayTimeR, smoothsecs);\r\n\tf_rt60mulL, f_rt60mulR\t\t= logsmoothBank2(rt60mulL, rt60mulR, (smoothsecs * 0.666666));\r\n\r\n\tf_lrTime1R, f_lrTime2R, f_lrTime3R\t= logsmoothBank3(lrTime1R, lrTime2R, lrTime3R, smoothsecs);\r\n\r\n} else {\r\n\r\n\tf_rt60mulL\t\t= logsmooth(rt60mulL, (smoothsecs * 0.666666));\r\n\tf_decayTimeL\t= logsmooth(decayTimeL, smoothsecs);\r\n\r\n\tf_lrTime1R\t\t= f_lrTime1L;\r\n\tf_lrTime2R\t\t= f_lrTime2L;\r\n\tf_lrTime3R\t\t= f_lrTime3L;\r\n\tf_decayTimeR\t= f_decayTimeL;\r\n\tf_rt60mulR\t\t= f_rt60mulL;\r\n\r\n}\r\n\r\nf_lateDiff, f_fbCross\t=  logsmoothBank2(lateDiff, fbCross, smoothsecs);\r\n\r\n// for main eq coefficients ('a' coefficients ok because zdf, but we smooth 'm' gains)\r\n\r\nf3a1\t= eq1_a1;\tf3a2\t= eq1_a2;\tf3a3\t= eq1_a3;\r\nf3m1\t= eviLine(eq1_m1, smoothsamps);\r\nf3m2\t= eviLine(eq1_m2, smoothsamps);\r\n\r\nf4a1\t= eq2_a1;\tf4a2\t= eq2_a2;\tf4a3\t= eq2_a3;\r\nf4m0\t= eviLine(eq2_m0, ss08);\r\nf4m1\t= eviLine(eq2_m1, ss08);\r\nf4m2\t= eviLine(eq2_m2, ss08);\r\n\r\n//eqactive\t\t\t\t\t= ((f3m1 + f3m2) != 0) || ((f4m1 + f4m2) != 0);\r\n\r\n\r\n//\t//\t//\tprocessing\r\n\r\n//\t//\t//\tprocess pre delay\r\n\r\nif (processPreDelay) {\r\n\r\n\twetXl\t= preDelayL.read(maximum(f_pdTimeL, 1), interp=\"cubic\");\r\n\twetXr\t= preDelayR.read(maximum(f_pdTimeR, 1), interp=\"cubic\");\r\n\r\n}\r\n\r\n\r\n//\t//\t//\tonly process early reflections if NOT 100 % late\t//\t//\t//\tSTART\r\n\t//\t(only really useful if Gen allowed us to zero all delay lines on release)\r\n\t//\t(but we have a hysterisis here calculated externally at max message rate so sort of works for cpu)\r\n\r\nearlyLeft\t= wetXl;\r\nearlyRight\t= wetXr;\r\nif ( (earlyLateMix < 1) || (earlylock) ) {\r\n\r\n\r\n//\t//\t//\tprocess early reflections\r\n\r\neDiffuse1L\t= DiffuseDelayShort(wetXl,\t\teTm1L, f_earlyDiff, apunity, \r\n\t\t\t\t\tf1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\neDiffuse1R\t= DiffuseDelayShort(wetXr,\t\teTm1R, f_earlyDiff, apunity, \r\n\t\t\t\t\tf1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\n\r\neDiffuse2L\t= DiffuseDelayShort(eDiffuse1L,\teTm2L, f_earlyDiff, apunity, \r\n\t\t\t\t\tf1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\neDiffuse2R\t= DiffuseDelayShort(eDiffuse1R,\teTm2R, f_earlyDiff, apunity, \r\n\t\t\t\t\tf1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\n\r\neDiffuse3L\t= DiffuseDelayShort(eDiffuse2L,\teTm3L, f_earlyDiff, apgain, \r\n\t\t\t\t\tf1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\neDiffuse3R\t= DiffuseDelayShort(eDiffuse2R,\teTm3R, f_earlyDiff, apgain, \r\n\t\t\t\t\tf1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\n\r\nearlyLeft\t= svfTwoBands(eDiffuse3L, f1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\nearlyRight\t= svfTwoBands(eDiffuse3R, f1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\n\r\n\r\n}\t//\t//\t//\tonly process early reflections if NOT 100 % late\t//\t//\t//\tEND\r\n\r\n\r\n//\t//\t//\tonly process late reflections if NOT 100 % early\t//\t//\t//\tSTART\r\n\t//\t(only really useful if Gen allowed us to zero all delay lines on release)\r\n\t//\t(but we have a hysterisis here calculated externally at max message rate so sort of works for cpu)\r\n\r\nlateLeft\t= earlyLeft;\r\nlateRight\t= earlyRight;\r\nif ( (earlyLateMix > 0) || (latelock) ) {\r\n\r\n\r\n//\t//\t//\tprocess modulation\r\n\r\nmodulation1, modulation2, modulation3, modulation4, \r\n\tmodulation5, modulation6, modulation7, modulation8\t\r\n\t\t= eightMod(modRate, modDepth);\r\n\r\nrTmodL\t= (f_decayTimeL + modulation4) * samplerate;\r\nrTmodR\t= (f_decayTimeR + modulation8) * samplerate;\r\n\r\nlrMod1L\t= (f_lrTime1L + modulation1) * samplerate;\r\nlrMod2L\t= (f_lrTime2L + modulation2) * samplerate;\r\nlrMod3L\t= (f_lrTime3L + modulation3) * samplerate;\r\n\r\nlrMod1R\t= (f_lrTime1R + modulation5) * samplerate;\r\nlrMod2R\t= (f_lrTime2R + modulation6) * samplerate;\r\nlrMod3R\t= (f_lrTime3R + modulation7) * samplerate;\r\n\r\n\r\n//\t//\t//\tprocess late reflections\r\n\r\nfbL\t\t\t= rtDelayL.read(rTmodL, interp=\"spline\") * f_rt60mulL;\r\nfbR\t\t\t= rtDelayR.read(rTmodR, interp=\"spline\") * f_rt60mulR;\r\nlrFbL\t\t= interp(f_fbCross, fbL, fbR, mode=\"linear\");\t// feedback swaps\t// crossfade must be linear\r\nlrFbR\t\t= interp(f_fbCross, fbR, fbL, mode=\"linear\");\t// ...\t\t\t\t// ...\r\nlrXl\t\t= earlyLeft\t\t+ lrFbL;\r\nlrXr\t\t= earlyRight\t+ lrFbR;\r\n\r\nlDiffuse1L\t= DiffuseDelayLong(lrXl,\t\tlrMod1L, f_lateDiff, apunity, \r\n\t\t\t\t\tf1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\nlDiffuse1R\t= DiffuseDelayLong(lrXr,\t\tlrMod1R, f_lateDiff, apunity, \r\n\t\t\t\t\tf1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\n\r\nlDiffuse2L\t= DiffuseDelayLong(lDiffuse1L,\tlrMod2L, f_lateDiff, apgain, \r\n\t\t\t\t\tf1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\nlDiffuse2R\t= DiffuseDelayLong(lDiffuse1R,\tlrMod2R, f_lateDiff, apgain, \r\n\t\t\t\t\tf1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\n\r\nlDiffuse3L\t= DiffuseDelayLong(lDiffuse2L,\tlrMod3L, f_lateDiff, apgain, \r\n\t\t\t\t\tf1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\nlDiffuse3R\t= DiffuseDelayLong(lDiffuse2R,\tlrMod3R, f_lateDiff, apgain, \r\n\t\t\t\t\tf1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\n\r\nlateLeft\t= svfTwoBands(lDiffuse3L, f1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\nlateRight\t= svfTwoBands(lDiffuse3R, f1a1, f1a2, f1a3, f1m0, f1m1, f1m2, f2a1, f2a2, f2a3, f2m0, f2m1, f2m2);\r\n\r\n\r\n}\t//\t//\t//\tonly process late reflections if NOT 100 % early\t//\t//\t//\tEND\r\n\r\n\r\n//\t//\t//\tprocess early / late mix\r\n\r\nelmL, elmR\t= xfadeQuartApproxStereo(earlyLeft, earlyRight, lateLeft, lateRight, earlyLateMix);\r\n\r\n\r\n//\t//\t//\tprocess main eq (± 24 dB gains)\r\n\r\nwetYl\t\t= svfTwoBands(elmL, f3a1, f3a2, f3a3, f3m0, f3m1, f3m2, f4a1, f4a2, f4a3, f4m0, f4m1, f4m2);\r\nwetYr\t\t= svfTwoBands(elmR, f3a1, f3a2, f3a3, f3m0, f3m1, f3m2, f4a1, f4a2, f4a3, f4m0, f4m1, f4m2);\r\n\r\n\r\n}\t//\t//\t//\tGLOBAL MUTE (muteMix) off / on\t//\t//\t//\tEND\r\n\r\n\r\n//\t//\t//\tprocess updates\r\n\r\ncompensateDryL\t=\t(\tin1 + 0\t);\r\ncompensateDryR\t=\t(\tin2 + 0\t);\r\n\r\nlateWriteL, lateWriteR\t= xfadeQuartApproxStereo(lateLeft, lateRight, wetXl, wetXr, muteMix);\t// limiter here ?\r\n\r\nrtDelayL.write(lateWriteL);\r\nrtDelayR.write(lateWriteR);\r\n\r\n\r\n//\t//\t//\tprocess dry / wet (& bypass)\t(cpu stays on)\r\n\r\nrvrbL, rvrbR\t= xfadeQuartApproxStereo(dryL, dryR, wetYl, wetYr, dryWetMix);\r\n\r\n\r\n//\t//\t//\tprocess global mute\t\t(cpu on / off)\t\t(mute should really zero all memory)\r\n\r\nout1, out2\t\t= xfadeQuartApproxStereo(rvrbL, rvrbR, in1 + 0, in2 + 0, muteMix);\r\n\r\n",
