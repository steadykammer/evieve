                    "numoutlets": 0,
                    "patching_rect": [ 777.5, 746.0, 109.0, 22.0 ],
                    "text": "out 2 Reverb Right"
                }
            },
            {
                "box": {
                    "fontname": "Arial",
                    "fontsize": 12.0,
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 30.0, 17.0, 148.0, 22.0 ],
                    "text": "in 1 In Mono / In Left / In 1"
                }
            },
            {
                "box": {
                    "code": "\n// -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\n\n// evi_plateverb_lite.gendsp\n\n// \"yafr2\" from MSP\n// \"Plate reverb, in the style of Griesinger\", by Randy Jones\n\n// This version by Pete for evieve, with dry/wet and eq added, as well \r\n// as modifications for better filtering, interpolation, smoothing, etc\n\r\n// This version is the \"Lite\" version (less expensive than the 'full' version, 'evi_plateverb.gendsp')\r\n// If you need buttery smooth updating of parameters in realtime, use the full \r\n// version, if not, this version should be fine (gains are smooth, decay &\r\n// damp are quite smooth, everything else clicks like original)\n\n// -- -- -- -- -- -- -- -- -- --\tfunctions (library)\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\n\nrequire(\"evi_reverb_library_old.genexpr\");\r\n\r\n\n// -------\tdeclare\n\r\n// reverb\nParam\tsize(0.2, min=0, max=1);\r\nParam\tdecay(0.6, min=0, max=1);\r\nParam\tdiffuse(0.3, min=0, max=1);\r\n// damp (compute coefficients externally in gen no tilde)\r\nParam\tdamp(0.67682, min=0, max=1);\t\t// pre-warped frequency (a 0..1) (default 6593Hz @48kHz)\n// eq (compute coefficients externally in gen no tilde)\nParam\thighshelfG(0.123758, min=0, max=1);\t// pre-warped frequency (g / (1 + g)) (default 2000Hz @48kHz)\nParam\thighshelfK(0, min=-3, max=1);\t\t// -3=shelfboost..0=bypass..shelf..1=pass\nParam\tlowshelfG(0.032214, min=0, max=1);\t// pre-warped frequency (g / (1 + g)) (default 500Hz @48kHz)\nParam\tlowshelfK(0, min=-3, max=1);\t\t// -3=shelfboost..0=bypass..shelf..1=pass\n// mix\r\nParam\twet(-3, min=-90, max=0);\t\t\t\t\t\t\t// wet '0' dB & dry '-90' dB...\r\nParam\tdry(-15, min=-90, max=0);\t\t\t\t\t\t\t// ...= 'yafr2' default (no dry)\r\nParam\tpan(0.5, min=0, max=1);\t\t\t\t\t\t\t\t// pan for DRY signal in MONO mode\r\nParam\tstereo(0, min=0, max=2);\t\t\t\t\t\t\t// input is mono / stereo / 2-chans ?\r\nParam\tbypass(0, min=0, max=1);\t\t\t\t\t\t\t// also cpu-off, but no reset in gen~ !!\r\n\r\nHistory\tdryL(0), dryR(0);\t\t\t\t\t\t\t\t\t// compensate\r\n\r\nDelay\ttapsL(samplerate*0.20010,\t3,\tfeedback=1);\t\t// loops...\r\nDelay\ttapsR(samplerate*0.17005,\t3,\tfeedback=1);\r\n\r\n// in this \"Lite\" version of plate, we have no zero delay holds, so...\r\nDelay\tmodDelayL(samplerate*0.25969,\t3,\tfeedback=0);\r\nDelay\tmodDelayR(samplerate*0.24666,\t3,\tfeedback=0);\r\n\r\nDelay\tsum2L(samplerate*0.0570,\t1,\tfeedback=0);\r\nDelay\tsum2R(samplerate*0.1107,\t1,\tfeedback=0);\r\nDelay\tsum4L(samplerate*0.0834,\t2,\tfeedback=0);\r\nDelay\tsum4R(samplerate*0.1210,\t2,\tfeedback=0);\r\n\r\n// constants, not user\r\n\r\nParam\tsumMul\t\t(  0.14285714285714285, min=0, max=1);\t// 1/7\r\nParam\tsumMulinv\t(  0.8571428571428572,  min=0, max=1);\t// 1 - sumMul;\r\nParam\tsumMul05\t(  0.07142857142857142, min=0, max=1);\t// 0.5 * sumMul\r\nParam\tsumMulSq\t(  0.3779644730092272,  min=0, max=1);\t// 1/sqrt(7)\r\n\r\nParam\tapGain1\t\t(  0.75,\tmin= 0, max= 1);\r\nParam\tapGain2\t\t(  0.625,\tmin= 0, max= 1);\r\nParam\tapGain3\t\t( -sqrt1_2,\tmin=-1, max= 1);\r\nParam\tapGain4\t\t(  0.5,\t\tmin= 0, max= 1);\r\n\r\nParam\tsmoothtime(30, min=0, max=500);\t// ms\r\nsmoothsecs\t= smoothtime * 0.001;\t\t// secs\r\nsmoothsamps\t= smoothsecs * samplerate;\t// samps\r\n\r\n\r\n// -------\tfixed constants\r\n\r\nSRATE\t\t=  samplerate + 0;\r\n\r\napTime1\t\t=  0.00476 * SRATE;\r\napTime2\t\t=  0.00358 * SRATE;\r\napTime3\t\t=  0.01273 * SRATE;\r\napTime4\t\t=  0.00930 * SRATE;\r\n\r\n\r\n// -------\tparse (param rate)\r\n\r\nmodDepth\t= 0.020;\t\t\t\t\t\t\t\t// in seconds\r\n\r\nsizescale\t= (size * 1.59) + 0.01;\r\nsizediff\t=  sizescale * diffuse;\r\ndecayscale\t= (decay * sumMulinv) + sumMul05;\r\n\r\nwetAmp\t\t= (wet > -90) ? dbtoaApprox(wet) : 0;\r\ndryAmp\t\t= (dry > -90) ? dbtoaApprox(dry) : 0;\r\n\r\n// not smoothed in \"Lite\" version\r\ncosL, sinR\t=  quartOneParApprox((pan * 0.75) + 0.125);\r\ndamping\t\t=  damp + 0;\r\ndecMulL\t\t=  decayscale + 0;\r\ndecMulR\t\t=  decMulL + 0;\r\neqHighG\t\t=  highshelfG + 0;\r\neqLowG\t\t=  lowshelfG + 0;\r\n\r\n// iStereo ('stereo' param): 0 = mono (L) input / 1 = stereo (L/R) source / 2 = uncorrelated 2-channels\r\niStereo\t\t=  int(stereo);\r\nstereoMul\t= (iStereo == 2) ? sqrt1_2 : 0.5;\t\t// !! not smoothed !!\r\n\r\n\r\n// -------\ttimes dynamic (param rate)\r\n\r\nLtimeMul2\t= sizescale * (0.14960 * SRATE);\t\t// will add modL in samples...\r\nRtimeMul2\t= sizescale * (0.14170 * SRATE);\t\t// will add modR in samples...\r\n\r\nLtimeMul1\t= sizescale * (0.02258 * SRATE);\r\nLtimeMul3\t= sizescale * (0.06048 * SRATE);\r\nLtimeMul4\t= sizescale * (0.12500 * SRATE);\r\n\r\nRtimeMul1\t= sizescale * (0.03051 * SRATE);\r\nRtimeMul3\t= sizescale * (0.08924 * SRATE);\r\nRtimeMul4\t= sizescale * (0.10628 * SRATE);\r\n\r\nCtimeMul1L\t= sizediff \t* (0.110   * SRATE);\r\nCtimeMul2L\t= sizediff \t* (0.160   * SRATE);\r\nCtimeMul3L\t= sizediff  * (0.050   * SRATE);\r\nCtimeMul4L\t= sizediff  * (0.025   * SRATE);\r\nCtimeMul5L\t= sizediff  * (0.069   * SRATE);\r\nCtimeMul6L\t= sizediff  * (0.080   * SRATE);\r\nCtimeMul7L\t= sizediff  * (0.075   * SRATE);\r\n\r\nCtimeMul1R\t= sizediff \t* (0.110   * SRATE);\r\nCtimeMul2R\t= sizediff \t* (0.135   * SRATE);\r\nCtimeMul3R\t= sizediff  * (0.055   * SRATE);\r\nCtimeMul4R\t= sizediff  * (0.003   * SRATE);\r\nCtimeMul5R\t= sizediff  * (0.035   * SRATE);\r\nCtimeMul6R\t= sizediff  * (0.027   * SRATE);\r\nCtimeMul7R\t= sizediff  * (0.052   * SRATE);\r\n\r\n\r\n// -------\tinputs / outputs (audio rate from here)\r\n\r\nx0, xN\t\t=  0;\r\nif (iStereo >  0) {\r\n\tx0\t\t= (in1 + in2) * stereoMul;\t\t\t\t// !! stereoMul not smoothed !!\r\n\tdryL\t=  in1;\t\t\t\t\t\t\t\t\t// compensate\r\n\tdryR\t=  in2;\r\n} else {\r\n\tx0\t\t=  in1;\r\n\txN\t\t=  in2;\r\n\tdryL\t=  in1 * cosL;\t\t\t\t\t\t\t// & compensate\r\n\tdryR\t=  in1 * sinR;\r\n}\r\n\r\nrvrbL\t\t=  dryL;\r\nrvrbR\t\t=  dryR;\r\ndryLmix\t\t=  dryL;\r\ndryRmix\t\t=  dryR;\r\n\r\n\r\n// -------\tbypass (smooth and cpu)\r\n\r\niBypass\t\t= int(bypass);\r\npassSmooth\t= iBypass ? 0.333 : 0.666;\r\nPASS\t\t= eviLine(iBypass, passSmooth*samplerate);\r\niPass\t\t= 1 - PASS;\r\n\r\nif (PASS < 1) {\r\n\r\n\r\n// -------\tsmoothing (audio rate)\r\n\r\nwetMix, dryMix\t\t= logsmoothBank2(wetAmp, dryAmp, smoothsecs);\r\nwetMix\t\t\t\t= wetMix * sumMul * iPass;\r\ndryAtten\t\t\t= dryMix * sumMulSq * iPass;\r\n\r\neqHighK, eqLowK\t\t= logsmoothBank2(highshelfK, lowshelfK, smoothsecs);\r\n\r\n// the problem with this reverb algo / the decision to make:\r\n// firstly, sounds shit for this reverb doing big smooths here ?\r\n// secondly, should smooth 'size' and 'diffuse' and pass on, or do 22 smoothers at end of calcs ?\r\n// thirdly, expensively zero hold delay changes with double bufffers ?\r\n\r\n// ^^ in this \"Lite\" version, we do not do any of this :-(\r\n\r\n\r\n// -------\ttimes dynamic (smoothed)\r\n\r\n\r\n// -------\tdry mixes\t(do pan shit here too ?) (cosL, sinR)\r\n\r\ndryLmix\t\t=  dryL * dryMix;\r\ndryRmix\t\t=  dryR * dryMix;\r\ndryLatten\t=  dryL * dryAtten;\r\ndryRatten\t=  dryR * dryAtten;\r\n\r\n\r\n// -------\tearly\r\n\r\n// input bandwidth (damp)\r\nx1\t= poleZeroDamp((x0 * iPass),\tdamping);\r\n\r\n// early reflect (static)\r\nx1\t= fffbAllpassShort(x1,\tapGain1,\tapTime1);\r\nx1\t= fffbAllpassShort(x1,\tapGain1,\tapTime2);\r\nx1\t= fffbAllpassShort(x1,\tapGain2,\tapTime3);\r\nx1\t= fffbAllpassShort(x1,\tapGain2,\tapTime4);\r\n\r\n\r\n// -------\ttaps\t-------\tthis seems to be the most expensive bit in this \"Lite\" gen~ version\r\n//\t\t\t\t\t\t\tbut reducing interpolations does not make much difference\r\n\r\n// modulation\t// do low undershoots get clamped ?\r\nmod0L\t= noiseMod(modDepth + 0.00031);\t\t// (LtimeMul2 + mod0L) from -0.018194 to +0.25967 seconds\r\nmod0R\t= noiseMod(modDepth - 0.00010);\t\t// (RtimeMul2 + mod0R) from -0.018683 to +0.24662 seconds\r\nmod0L\t= mod0L * samplerate;\r\nmod0R\t= mod0R * samplerate;\r\n\r\n// taps left\r\ntap4L\t= tapsL.read(LtimeMul4,\tinterp=\"linear\");\t// \"spline\"\r\ntap1L\t= fffbAllpassLong((x1 + tap4L),\t\t\tapGain3,\t\tLtimeMul1);\r\nmodDelayL.write(tap1L);\r\ntap2L\t= modDelayL.read((LtimeMul2 + mod0L),\tinterp=\"cubic\");\t\t\t// + modulation (L)\r\ndampL\t= poleZeroDamp((tap2L + dryRatten),\t\tdamping);\t\t\t\t\t// + inject partial dry (R)\r\ntap3L\t= fffbAllpassLong((dampL * decMulL),\tapGain4,\t\tLtimeMul3);\r\ntapsL.write(tap3L);\r\n\r\n// taps right\r\ntap4R\t= tapsR.read(RtimeMul4,\tinterp=\"linear\");\t// \"spline\"\r\ntap1R\t= fffbAllpassLong((x1 + tap4R),\t\t\tapGain3,\t\tRtimeMul1);\r\nmodDelayR.write(tap1R);\r\ntap2R\t= modDelayR.read((RtimeMul2 + mod0R),\tinterp=\"cubic\");\t\t\t// + modulation (R)\r\ndampR\t= poleZeroDamp((tap2R + dryLatten),\t\tdamping);\t\t\t\t\t// + inject partial dry (L)\r\ntap3R\t= fffbAllpassLong((dampR * decMulR),\tapGain4,\t\tRtimeMul3);\r\ntapsR.write(tap3R);\r\n\r\n\r\n// -------\twrite / read / sum\t-------\tpretty horrid in this \"Lite\" version\r\n\r\nsum2L.write(tap2L);\r\nsum4L.write(tap4L);\r\n\r\nsum2R.write(tap2R);\r\nsum4R.write(tap4R);\r\n\r\nsum1_L\t= modDelayL.read(CtimeMul1L, interp=\"fastcubic\");\r\nsum2_L\t= modDelayL.read(CtimeMul2L, interp=\"fastcubic\");\r\nsum1_R\t= modDelayR.read(CtimeMul1R, interp=\"fastcubic\");\r\nsum2_R\t= modDelayR.read(CtimeMul2R, interp=\"fastcubic\");\r\n\r\n// sum left\r\nsumLeft\t\t\t= (\r\nsum1_L\t\t\t+ \r\nsum2_L\t\t\t- \r\ntapsL.read(\tCtimeMul3L, interp=\"fastcubic\"\t) +\r\nsum4L.read(\tCtimeMul4L, interp=\"fastcubic\"\t) -\r\nsum2R.read(\tCtimeMul5L, interp=\"fastcubic\"\t) -\r\ntapsR.read(\tCtimeMul6L, interp=\"fastcubic\"\t) -\r\nsum4R.read(\tCtimeMul7L, interp=\"fastcubic\"\t)\r\n);\r\n\r\n// sum right\r\nsumRight\t\t= (\r\nsum1_R\t\t\t+ \r\nsum2_R\t\t\t- \r\ntapsR.read(\tCtimeMul3R, interp=\"fastcubic\"\t) +\r\nsum4R.read(\tCtimeMul4R, interp=\"fastcubic\"\t) -\r\nsum2L.read(\tCtimeMul5R, interp=\"fastcubic\"\t) -\r\ntapsL.read(\tCtimeMul6R, interp=\"fastcubic\"\t) -\r\nsum4L.read(\tCtimeMul7R, interp=\"fastcubic\"\t)\r\n);\r\n\r\nrvrbL\t\t\t=  sumLeft * wetMix;\r\nrvrbR\t\t\t= sumRight * wetMix;\r\n\r\n\r\n// -------\teq\r\n\r\n// 1-pole eq cut/boost shelf filters\r\n// if high/lowshelfK params == 1, filters become high/lowpasses\r\n// if high/lowshelfK params == 0, do not compute\r\n\r\n//if (eqHighK != 0) {\t\t\t\t\t\t\t\t\t\t// ramps not exact in \"Lite\" version :-(\r\n\teq0L, rvrbL\t= rcFilterEq(rvrbL, eqHighG, eqHighK);\t\t// highshelf\r\n\teq0R, rvrbR\t= rcFilterEq(rvrbR, eqHighG, eqHighK);\r\n//}\r\n\r\n//if (eqLowK != 0) {\t\t\t\t\t\t\t\t\t\t// cpu manage not click-free for low :-(\r\n\trvrbL, eq0L\t= rcFilterEq(rvrbL, eqLowG, eqLowK);\t\t// lowshelf\r\n\trvrbR, eq0R\t= rcFilterEq(rvrbR, eqLowG, eqLowK);\r\n//}\r\n\r\n\r\n// --- bypass (smooth and cpu)\r\n\r\n}\t// end\r\n\r\n\r\n// -------\tsum & output\r\n\r\nout1\t= interp(PASS, (rvrbL + dryLmix), dryL, mode=\"cosine\");\r\nout2\t= interp(PASS, (rvrbR + dryRmix), dryR, mode=\"cosine\");\r\n\r\n\r\n// -------\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 30.0, 54.0, 864.0, 675.0 ]
                }
            },
