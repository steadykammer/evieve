            {
                "box": {
                    "code": "\r\n//\r\n\r\n//require(\"evi_overdrive.genexpr\");\r\n\r\n//\r\n\r\ntanA(x)                             // cheaper approx tan(0..1)\n{\n\tx2      = (x * x);\n\tx3      = (x2 * x);\n\tx5      = (x2 * x3);\n\treturn   ((x5 * 0.133333333333) + (x3 * 0.333333333333)) + x;\n}\n\nrcPreWarp(cutoff)\n{\n\tg0\t\t=  tanA(PI * cutoff / SAMPLERATE);\n\treturn\tg0 / (1 + g0);\n}\n\n// fixed mode=0 version, no branching, keep out of while loop in export\nrcDampCoeffs0(cutoff, damp)\t\t\t// cutoff in Hz, damp must clamp 0..1 (1 = highpass/lowpass)\n{\n\tg0\t\t=  tanA(PI * cutoff / SAMPLERATE);\t// prewarp\n\tks\t\t= (damp * 0.5) + 0.5;\t// damp 0..1 = sqrt..lin\n\tks05\t= (ks - 0.5);\n\tksom\t= ((1 - ks) + 0.5) - 0.5;\n\tg01\t\t=  1 + g0;\n\tg1 \t\t=  g0 / interp((ks05 + ks05), sqrt(g01), g01, mode=\"linear\");\n\td1\t\t= interp((ksom + ksom), sqrt(damp), damp, mode=\"linear\");\n\treturn\tg1, d1;\t\t\t\t\t// rc filter warped cf (g)\t// rc filter warped gain (k)\n}\n\n// High or Low Pass if k == 1, Bypass if k == 0, else Low or High Shelf attenuation\nrcFilterDampHpLp(Vin, g, k)\n{\n\tHistory\t   s(0);\n\tLp\t\t= (g * Vin + s) / (g + 1);\n\ts\t\t= (Lp + Lp) - s;\n\treturn\t(k * Lp) - Vin, Vin + (k * (Lp - Vin)); // HP , LP\n}\n\neviLog1p(value)   // :-(\n{\n  if (value > -1.0e-8 && value < 1.0e-8)\n\treturn value - (value * value) * 0.5;\n\n  return log(1 + value);\n}\n\nhermite_sixpoint_interp(f0, ym2, ym1, y0, y1, y2, y3)\n{\n  f1    =  f0 - 0.5;\n  even1 = ym2 + y3;\n  odd1  = ym2 - y3;\n  even2 = ym1 + y2;\n  odd2  = ym1 - y2;\n  even3 =  y0 + y1;\n  odd3  =  y0 - y1;\n\n  c0  = 0.01171875*even1    - 0.09765625*even2    + 0.5859375*even3;\n  c1  = 0.2109375*odd2    - 1.463541666667*odd3 - 0.033854166667*odd1;\n  c2  = 0.40625*even2     - 0.354166666667*even3  - 0.052083333333*even1;\n  c3  = 0.1875*odd1     - 1.104166666667*odd2 + 2.375*odd3;\n  c4  = 0.020833333333*even1  - 0.0625*even2      + 0.041666666667*even3;\n  c5  = 1.041666666667*odd2 - 2.083333333333*odd3 - 0.208333333333*odd1;\n\n  return ((((c5*f1 + c4)*f1 + c3)*f1 + c2)*f1 + c1)*f1 + c0;\n}\n\nexpA(x0)\t\t\t\t\t\t\t// more accurate than 'fastexp()'\n{\n\tx = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;\n\tx *= x; x *= x; x *= x; x *= x; x *= x;\n\treturn x;\n}\n\ntauA(t)\t\t\t\t\t\t\t\t// t is time in seconds\n{\n\ty = expA(-1 / (t * samplerate));\n\treturn y + 0.000128;\n}\n\nexpso(x, z)\t\t\t\t\t\t\t// z is pole\n{\n\tHistory w(0);\n\ty = (z * w) + (x * (1 - z));\n\tw = y;\n\treturn y;\n}\n\nexpsmoothBank3(x1, x2, x3, t)\n{\n\tHistory\texpsdummy3(0);\n\tz\t\t= tauA(t);\n\ty1\t\t= expso(x1, z);\n\ty2\t\t= expso(x2, z);\n\ty3\t\t= expso(x3, z);\n\treturn\ty1, y2, y3;\n}\n\nlogsmooth(x, s)                     // s = time to drop 6dB (in seconds)\n{\n\tHistory z(0);\n//  ad = LN2 / maximum((s * samplerate), 1);\n\tad = LN2 / (s * samplerate);\n\ty  = ((x - z) * ad) + z;\n\tz  = y;\n\treturn y;\n}\n\n//\n\nexpApprox(x)\n{\n  x = 1 + (0.062500309 + (0.0019527233 + (0.0000408663 + (0.00000060184965 + 0.000000010856791*x)*x)*x)*x)*x;\n  x *= x; x *= x; x *= x;\n  return x*x;\n}\n\npow2Approx(y) // approx pow(2, y)\n{\n  return expApprox(y * LN2);\n}\n\ncoshApprox(x)\n{\n  return 0.5 * (expApprox(x) + expApprox(-x));\n}\n\nlog2Approx(x) // sorry\n{\n  return (-0.2119568027628040757e-1 + (-0.38815224340108325886 + (-0.8900051141728954376 + (0.4001641794691007527\n\t  + (0.79615191430677253059 + 0.10303694407435362078*x)*x)*x)*x)*x) /\n\t\t(0.298115002929551095e-2 + (0.1066700361116609290 + (0.6070463053447878628 + (0.8584931203106122717\n\t\t  + (0.30170842595823793523 + 0.16863931436090069014e-1*x)*x)*x)*x)*x);\n}\n\nlogApprox(x)\n{\n  return LN2 * log2Approx(x);\n}\n\nlog10Approx(x)\n{\n  return 0.3010299956639811 * log2Approx(x); // log10(2)*log2(x)\n}\n\nlog1pApprox(x)\n{\n  if (x > -1.0e-8 && x < 1.0e-8)\n\treturn x - (x * x) * 0.5;\n\n  return logApprox(1 + x);\n}\n\n// works for waveshapers too :-)\ndecorelate(x)\n{\n\tHistory\tz1(0);\n\ty = 1.371308261611209 * x + z1;\n\tz1 = 0.08785458027104826 * x - 0.45916284188226 * y;\n\treturn y;\n}\n\n//\n\n/**\n * Li2() ::\n * @brief Real dilogarithm mathrm{Li}_2(x)\n * @param x real argument\n * @return mathrm{Li}_2(x)\n * @author Alexander Voigt\n * @license GPL v3\n * \n * Implemented as an economized Pade approximation with a\n * maximum error of 4.16e-18 <<-- definitely worse with pete's implementation :-)\n */\nLi2Approx(x) // this is really stupid in gen~, & N.B. - cannot use Approxes in negative branches\n{\n\tMPIPI6\t= -1.6449340668482264;\t// -PI*PI/6\n\tMPIPI12\t= -0.8224670334241132;\t// -PI*PI/12\n\tPIPI6\t=  1.6449340668482264;\t//  PI*PI/6\n\tPIPI3\t=  3.289868133696453;\t//  PI*PI/3\n\n\tli1 = 0;\n\thorner = 0;\n\ty = 0;\n\tr = 0;\n\ts = 1;\n\n\t// transform to [0, 1/2)\n\tif (x < -1) {\n\t\tomx = 1 - x;\n\t\tl = log(omx); // must be log()\n\t\ty = 1/omx;\n\t\tr = MPIPI6 + l*(0.5*l - log(-x)); // must be log()\n\t\ts = 1;\n\t\thorner = 1;\n\t} else if (x == -1) {\n\t\tli1 = MPIPI12;\n\t\thorner = 0;\n\t} else if (x < 0) {\n\t\tl = eviLog1p(-x); // must be log()\n\t\ty = x/(x - 1);\n\t\tr = -0.5*l*l;\n\t\ts = -1;\n\t\thorner = 1;\n\t} else if (x == 0) {\n\t\tli1 = 0;\n\t\thorner = 0;\n\t} else if (x < 0.5) {\n\t\ty = x;\n\t\tr = 0;\n\t\ts = 1;\n\t\thorner = 1;\n\t} else if (x < 1) {\n\t\tomx = 1 - x;\n\t\ty = omx;\n\t\tr = PIPI6 - logApprox(x)*logApprox(omx);\n\t\ts = -1;\n\t\thorner = 1;\n\t} else if (x == 1) {\n\t\tli1 = PIPI6;\n\t\thorner = 0;\n\t} else if (x < 2) {\n\t\tomodx = 1 - 1/x;\n\t\tl = logApprox(x);\n\t\ty = omodx;\n\t\tr = PIPI6 - l*(logApprox(omodx) + 0.5*l);\n\t\ts = 1;\n\t\thorner = 1;\n\t} else {\n\t\tl = logApprox(x);\n\t\ty = 1/x;\n\t\tr = PIPI3 - 0.5*l*l;\n\t\ts = -1;\n\t\thorner = 1;\n\t}\n\n\tz = y - 0.25;\n\n\t// unroll horner because gen~, sorry :-(\n\n\tp = -2.4630612614645039828e-4;\n\tp = p*z +  3.1608910440687221695e-2;\n\tp = p*z + -4.6937565143754629578e-1;\n\tp = p*z +  2.4733515209909815443;\n\tp = p*z + -6.0516124315132409155;\n\tp = p*z +  7.4819657596286408905;\n\tp = p*z + -4.5353562730201404017;\n\tp = p*z +  1.0706105563309304277;\n\n\tq = -3.2116618742475189569e-3;\n\tq = q*z +  9.8554565816757007266e-2;\n\tq = q*z + -8.9936784740041174897e-1;\n\tq = q*z +  3.6245392503925290187;\n\tq = q*z + -7.4634190853767468810;\n\tq = q*z +  8.1790029773247428573;\n\tq = q*z + -4.5355682121856044935;\n\tq = q*z +  1.0000000000000000000;\n\n\tli2 = r + s*y*p/q;\n\n\treturn horner ? li2 : li1;\n}\n\n// these are the antiderivatives of the approximation, not of a real tanh - that is crucial !\n// sadly we still end up with a bloody Li2 in the 2nd order :-(\n\n// note: this tanh approx becomes not-tanh-like above about +22dB input gain (wave folds)\n// note: the entire approx is -6dB down, but we boost it on input before adaa to match tanh()\n\naltTanhF0(x)\n{\n\t// not one of the better tanh() approxes, but the antiderivatives are more manageable\n\t// than many of the others, swings and roundabouts\n\tex = (-1 / (expApprox(x) + 1));\n\treturn ex + ex + 1;\n}\n\naltTanhF1(x)\n{\n\tlex = log(exp(x) + 1); // not exp- or log- Approx() !\n\treturn lex + lex - x;\n}\n\naltTanhF2(x)\n{\n\tli2ex = Li2Approx(-exp(x)); // not expApprox() !\n\treturn -(li2ex + li2ex + li2ex + li2ex + x*x) * 0.5;\n}\n\naltTanhAdaa1(x0, reset)\n{\n\tHistory x1(0), s1(0);\n\teps = 0.000001;\t// TODO, precision\n\tif (reset) {\n\t\tx1 = 0; s1 = 0;\n\t}\n\n\ty1 = x0;\n\td0 = x0 - x1;\n\ts0 = altTanhF1(x0);\t// func1\n\tif ((x1 == 0 && s1 == 0) || (abs(d0) < eps)) {\t// ill condition\n\t\ty1 = altTanhF0(0.5 * (x0 + x1));\t// func0\n\t} else {\n\t\ty1 = (s0 - s1) / d0;\n\t}\n\n\ts1 = s0;\n\tx1 = x0;\n\treturn y1;\n}\n\naltTanhAdaa2(x0, reset)\n{\n\tHistory x1(0), x2(0), s1(0);\n\teps = 0.000001;\t// TODO, precision\n\tif (reset) {\n\t\tx1 = 0; x2 = 0; s1 = 0;\n\t}\n\n\ts0 = x0;\n\td0 = x0 - x1;\n\tf2_x1 = altTanhF2(x1);\t// func2\n\tif (abs(d0) < eps) {\t// ill condition\n\t\ts0 = altTanhF1(0.5 * (x0 + x1));\t// func1\n\t} else {\n\t\ts0 = (altTanhF2(x0) - f2_x1) / d0;\t// func2\n\t}\n\n\ty1 = x0;\n\td1 = x0 - x2;\n\tif (x1 == 0 && x2 == 0) {\t// ill condition\n\t\ty1 = altTanhF0(x0 + (x1 + x1) + x2) * 0.25;\t// func0\n\t} else if (abs(d1) < eps) {\t// ill condition\n\t\tx_bar = 0.5 * (x0 + x2);\n\t\tx_delta = x_bar - x1;\n\t\tif (x_delta < eps) {\t// ill condition\n\t\t\ty1 = altTanhF0((x_bar + x1) * 0.5);\t// func0\n\t\t} else {\n\t\t\ty1 = (2 / x_delta) * (altTanhF1(x_bar) + (f2_x1 - altTanhF2(x_bar)) / x_delta);\t// func1, func2\n\t\t}\n\t} else {\n\t\ts0s1 = s0 - s1;\n\t\ty1 = (s0s1 + s0s1) / d1;\n\t}\n\n\ts1 = s0;\n\tx2 = x1;\n\tx1 = x0;\n\treturn y1;\n}\n\n// altTanhAdaa1 oversampling...\n\n// fixed 2x quasi oversampling (hermite6)\naltTanhAdaa1_2x_6POINT(XIN, reset)\n{\t// up 2\n\tHistory umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory doX0(0);\n\n\t// up 2x\n\tx0_0_a  = XIN + 0;\n\tx1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0  = umT2_0 + 0;\n\n\t// process 2x\n\ty1_0  = altTanhAdaa1(x1_0, reset);\n\ty2_0  = altTanhAdaa1(x2_0, reset);\n\n\t// down 2x\n\ty2_0_a  = y2_0 + 0;\n\ty2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0  = (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0 = umTm1_0;\n\tumTm1_0 = umT0_0;\n\tumT0_0  = umT1_0;\n\tumT1_0  = umT2_0;\n\tumT2_0  = x0_0_a;\n\n\tdoX0  = y1_0;\n\n\tdmT3_1  = dmT2_1;\n\tdmT2_1  = dmT1_1;\n\tdmT1_1  = dmT0_1;\n\tdmT0_1  = dmTm1_1;\n\tdmTm1_1 = y2_0;\n\n\treturn dcblock(y0_0);\n}\n\n// fixed 4x quasi oversampling (hermite6)\naltTanhAdaa1_4x_6POINT(XIN, reset)\n{\t// up 2\n\tHistory umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory doX0(0);\n\n\t// up 2x\n\tx0_0_a  = XIN + 0;\n\tx1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0  = umT2_0 + 0;\n\n\t// process 2x\n\ty1_0  = altTanhAdaa1_2x_6POINT(x1_0, reset);\n\ty2_0  = altTanhAdaa1_2x_6POINT(x2_0, reset);\n\n\t// down 2x\n\ty2_0_a  = y2_0 + 0;\n\ty2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0  = (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0 = umTm1_0;\n\tumTm1_0 = umT0_0;\n\tumT0_0  = umT1_0;\n\tumT1_0  = umT2_0;\n\tumT2_0  = x0_0_a;\n\n\tdoX0  = y1_0;\n\n\tdmT3_1  = dmT2_1;\n\tdmT2_1  = dmT1_1;\n\tdmT1_1  = dmT0_1;\n\tdmT0_1  = dmTm1_1;\n\tdmTm1_1 = y2_0;\n\n\treturn dcblock(y0_0);\n}\n\n// altTanhAdaa2 oversampling...\n\n// fixed 2x quasi oversampling (hermite6)\naltTanhAdaa2_2x_6POINT(XIN, reset)\n{\t// up 2\n\tHistory umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory doX0(0);\n\n\t// up 2x\n\tx0_0_a  = XIN + 0;\n\tx1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0  = umT2_0 + 0;\n\n\t// process 2x\n\ty1_0  = altTanhAdaa2(x1_0, reset);\n\ty2_0  = altTanhAdaa2(x2_0, reset);\n\n\t// down 2x\n\ty2_0_a  = y2_0 + 0;\n\ty2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0  = (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0 = umTm1_0;\n\tumTm1_0 = umT0_0;\n\tumT0_0  = umT1_0;\n\tumT1_0  = umT2_0;\n\tumT2_0  = x0_0_a;\n\n\tdoX0  = y1_0;\n\n\tdmT3_1  = dmT2_1;\n\tdmT2_1  = dmT1_1;\n\tdmT1_1  = dmT0_1;\n\tdmT0_1  = dmTm1_1;\n\tdmTm1_1 = y2_0;\n\n\treturn dcblock(y0_0);\n}\n\n// fixed 4x quasi oversampling (hermite6)\naltTanhAdaa2_4x_6POINT(XIN, reset)\n{\t// up 2\n\tHistory umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory doX0(0);\n\n\t// up 2x\n\tx0_0_a  = XIN + 0;\n\tx1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0  = umT2_0 + 0;\n\n\t// process 2x\n\ty1_0  = altTanhAdaa2_2x_6POINT(x1_0, reset);\n\ty2_0  = altTanhAdaa2_2x_6POINT(x2_0, reset);\n\n\t// down 2x\n\ty2_0_a  = y2_0 + 0;\n\ty2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0  = (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0 = umTm1_0;\n\tumTm1_0 = umT0_0;\n\tumT0_0  = umT1_0;\n\tumT1_0  = umT2_0;\n\tumT2_0  = x0_0_a;\n\n\tdoX0  = y1_0;\n\n\tdmT3_1  = dmT2_1;\n\tdmT2_1  = dmT1_1;\n\tdmT1_1  = dmT0_1;\n\tdmT0_1  = dmTm1_1;\n\tdmTm1_1 = y2_0;\n\n\treturn dcblock(y0_0);\n}\n\n//\n\r\nHistory\treset(1);\r\n\r\n// input filter shaping\r\nParam\tlowcutoff(40, min=10, max=400);\t\t// hz ...\r\nParam\thighcutoff(4000, min=1000, max=16000);\r\nParam\tlowdamp(0.5, min=0, max=1);\t\t\t// default shelfs ...\r\nParam\thighdamp(0.5, min=0, max=1);\r\n\r\nParam\tsmooth(22.666, min=0, max=333);\t\t// smooth in2 & io in ms\r\nParam\tio(0, min=-1, max=1);\t\t        // 0..-1 pre-boost/post-atten, 0..1 inverse, ± 12 dB, 0.138071 ± 3 dB\r\nParam\thfcompensate(1, min=0, max=1);\t\t// default on\r\nParam\taa(3, min=0, max=5);\t\t\t\t// default Adaa2\r\nadaaxx\t= int(aa);\r\nhfcomp\t= int(hfcompensate);\r\nsmoothsecs\t\t= smooth * 0.001;\t\t\t// secs\r\n\r\nresetaa\t= delta(change(adaaxx)) < 0;\r\nresethf\t= delta(change(hfcomp)) < 0;\r\nreset\t= resetaa + resethf;\r\n\r\ndrive\t= in2 + 0;\r\niowrapper\t= (abs(io) * 3) + 1;\t\t\t// 1..4 = ± 12 dB\r\niogain, lowfilter, highfilter\t= expsmoothBank3(iowrapper, lowdamp, highdamp, 0.022666);\r\nio_in\t= io >= 0 ? 1 / iogain : iogain;\r\nio_out\t= io < 0 ? 1 / iogain : iogain;\r\n\r\nif (smooth > 0) {\t\t\t\t\t\t\t// turn off if modulating in2 at audio rate\r\n\tdrive\t= logsmooth(drive, smoothsecs);\r\n}\r\n\r\ntanhinput\t\t= in1 + 0;\r\nlp\t\t\t\t= tanhinput;\r\nhp, lopath, hipath\t= 0;\r\nk1, k2\t\t\t= 0;\r\nif (lowdamp > 0 || highdamp > 0) {\r\n\tg1, k1\t\t= rcDampCoeffs0(lowcutoff, lowfilter);\r\n\tg2, k2\t\t= rcDampCoeffs0(highcutoff, highfilter);\r\n\thp, lopath\t= rcFilterDampHpLp(tanhinput, g1, k1);\r\n\thipath, lp\t= rcFilterDampHpLp(hp, g2, k2);\r\n}\r\n\r\n// +6 dB (needed for this approx, this is not extra gain !), followed by drive gain, followed by io wrapper\r\ntanhinput\t= lp * 1.995262 * drive * io_in;\r\ntanhoutput\t= 0;\r\nif (adaaxx == 1) {\r\n\ttanhoutput = altTanhAdaa1_2x_6POINT(tanhinput, reset);\r\n} else if (adaaxx == 2) {\r\n\ttanhoutput = altTanhAdaa1_4x_6POINT(tanhinput, reset);\r\n} else if (adaaxx == 3) {\t// default\r\n\ttanhoutput = altTanhAdaa2(tanhinput, reset);\r\n} else if (adaaxx == 4) {\r\n\ttanhoutput = altTanhAdaa2_2x_6POINT(tanhinput, reset);\r\n} else if (adaaxx == 5) {\r\n\ttanhoutput = altTanhAdaa2_4x_6POINT(tanhinput, reset);\r\n} else {\t\t\t\t\t// (adaaxx == 0)\r\n\ttanhoutput = altTanhAdaa1(tanhinput, reset);\r\n}\r\n\r\nif (hfcomp) {\r\n\ttanhoutput = decorelate(tanhoutput);\r\n}\r\n\r\nout1\t= ( tanhoutput + (lopath * sqrt(k1) * 0.5) + (hipath * (k2*k2) * sqrt1_2) ) * io_out;\r\n\r\n",
