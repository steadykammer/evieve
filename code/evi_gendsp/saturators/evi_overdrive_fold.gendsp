                    "patching_rect": [ 543.0, 20.0, 399.0, 22.0 ],
                    "text": "in 2 (signal/float) Drive (linear gain 1..100) @default 1 @min 1 @max 100"
                }
            },
            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 19.0, 95.0, 22.0 ],
                    "text": "in 1 Input Signal"
                }
            },
            {
                "box": {
                    "code": "\r\n// these are the antiderivatives of the approximation, not of a real tanh - that is crucial !\n// sadly we still end up with a bloody Li2 in the 2nd order :-(\n\n// note: this tanh approx becomes not-tanh-like above about +22dB input gain (wave folds)\n// note: the entire approx is -6dB down, but we boost it on input before adaa to match tanh()\n\r\nrequire(\"evi_saturators.genexpr\");\nrequire(\"evi_smooth.genexpr\");\nrequire(\"evi_rcfilters.genexpr\");\n\r\nHistory\treset(1);\r\n\r\n// input filter shaping\r\nParam\tlowcutoff(40., min=10, max=400);\t// hz ...\r\nParam\thighcutoff(4000., min=1000, max=16000);\r\nParam\tlowdamp(0.5, min=0, max=1);\t\t\t// default shelfs ...\r\nParam\thighdamp(0.5, min=0, max=1);\r\n\r\nParam\tsmooth(22.666, min=0, max=333);\t\t// smooth in2 & io in ms\r\nParam\tio(0., min=-1, max=1);\t\t        // 0..-1 pre-boost/post-atten, 0..1 inverse, ± 12 dB, 0.138071 ± 3 dB\r\nParam\thfcompensate(1, min=0, max=1);\t\t// default on\r\nParam\taa(3, min=0, max=5);\t\t\t\t// default Adaa2\r\nadaaxx\t= int(aa);\r\nhfcomp\t= int(hfcompensate);\r\nsmoothsecs\t\t= smooth * 0.001;\t\t\t// secs\r\n\r\nresetaa\t= delta(change(adaaxx)) < 0;\r\nresethf\t= delta(change(hfcomp)) < 0;\r\nreset\t= resetaa + resethf;\r\n\r\ndrive\t= in2 + 0;\r\niowrapper\t= (abs(io) * 3) + 1;\t\t\t// 1..4 = ± 12 dB\r\niogain, lowfilter, highfilter\t= expsmoothBank3(iowrapper, lowdamp, highdamp, 0.022666);\r\nio_in\t= io >= 0 ? 1 / iogain : iogain;\r\nio_out\t= io < 0 ? 1 / iogain : iogain;\r\n\r\nif (smooth > 0) {\t\t\t\t\t\t\t// turn off if modulating in2 at audio rate\r\n\tdrive\t= logsmooth(drive, smoothsecs);\r\n}\r\n\r\ntanhinput\t\t= in1 + 0;\r\nlp\t\t\t\t= tanhinput;\r\nhp, lopath, hipath\t= 0;\r\nk1, k2\t\t\t= 0;\r\nif (lowdamp > 0 || highdamp > 0) {\r\n\tg1, k1\t\t= rcDampCoeffs0(lowcutoff, lowfilter);\r\n\tg2, k2\t\t= rcDampCoeffs0(highcutoff, highfilter);\r\n\tlopath, hp\t= rcFilterDampLpHp(tanhinput, g1, k1);\r\n\tlp, hipath\t= rcFilterDampLpHp(hp, g2, k2);\r\n}\r\n\r\ntanhinput\t= lp * drive * io_in;\r\ntanhoutput\t= 0;\r\nif (adaaxx == 1) {\r\n\ttanhoutput = altTanhAdaa1_2x_6POINT(tanhinput, reset);\r\n} else if (adaaxx == 2) {\r\n\ttanhoutput = altTanhAdaa1_4x_6POINT(tanhinput, reset);\r\n} else if (adaaxx == 3) {\t// default\r\n\ttanhoutput = altTanhAdaa2(tanhinput, reset);\r\n} else if (adaaxx == 4) {\r\n\ttanhoutput = altTanhAdaa2_2x_6POINT(tanhinput, reset);\r\n} else if (adaaxx == 5) {\r\n\ttanhoutput = altTanhAdaa2_4x_6POINT(tanhinput, reset);\r\n} else {\t\t\t\t\t// (adaaxx == 0)\r\n\ttanhoutput = altTanhAdaa1(tanhinput, reset);\r\n}\r\n\r\nif (hfcomp) {\r\n\ttanhoutput = decorelate(tanhoutput);\r\n}\r\n\r\nout1\t= (tanhoutput + (lopath * sqrt(k1) * 0.5) + (hipath * (k2*k2) * sqrt1_2)) * io_out;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 893.0, 732.0 ]
                }
            },
            {
                "box": {
                    "id": "obj-4",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 49.0, 807.0, 418.0, 22.0 ],
                    "text": "out 1 Tanh(x)-based Saturation Out - antialiased for your audio not for Maths"
                }
            },
            {
                "box": {
                    "id": "obj-6",
                    "linecount": 2,
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 161.0, 14.0, 365.0, 33.0 ],
                    "text": "this is an antialiased tanh(x) approximation for saturating your audio, not for Maths, including pre / post gain & filtering stages",
                    "textjustification": 1
                }
            }
        ],
