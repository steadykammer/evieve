        "boxes": [
            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 19.0, 179.0, 22.0 ],
                    "text": "in 1 (signal) Audio to be Shaped"
                }
            },
            {
                "box": {
                    "code": "\r\n// sometimes we just need to add some harmonics to our audio. that is what this does, even or odd.\r\n\r\nhShapeCoeff(shape)\r\n{\r\n    sgz = shape > 0;\r\n\r\n    ashape = abs(shape);\r\n    sshape = ashape * ashape;\r\n    pshape = (shape + 1) * 0.5;\r\n\r\n    spc = clip(shape, 0, 1);\r\n    snp = clip(shape, -1, 0) + 1;\r\n\r\n    return ashape, sshape, pshape, spc, snp, sgz;\r\n}\r\n\r\nhEven(x)\r\n{\r\n    a0 = x * x;\r\n    a1 = a0 * a0;\r\n    a2 = a1 * a1;\r\n    a3 = a2 * a2;\r\n    return a0, a1, a2, a3;\r\n}\r\n\r\nhOdd(x, a0, a1, a2)\r\n{\r\n    b0 = x * a0;\r\n    b1 = b0 * a0;\r\n    b2 = b1 * a1;\r\n    b3 = b2 * a2;\r\n    return b0, b1, b2, b3;\r\n}\r\n\r\nhMix(mix, c0, c1, c2, c3)\r\n{   // sorry\r\n    return interp((clip(mix, 3, 4) - 3), \r\n            (interp((clip(mix, 2, 3) - 2), \r\n                (interp((clip(mix, 1, 2) - 1), \r\n                    (c0), (c1), mode=\"cosine\") * clip(mix, 0, 1)), \r\n                        (c2), mode=\"cosine\")), \r\n                            (c3), mode=\"cosine\");\r\n}\r\n\r\nhShaper(x, shape, harmonics, compensate=1)\r\n{\r\n    hc = 1; // todo, compensate odd + harmonics == 0\r\n    hmf = harmonics * 4;    // harmonics coeffs\r\n\r\n    ashape, sshape, pshape, spc, snp, sgz = hShapeCoeff(shape); // shape coeffs\r\n\r\n    sinterp = spc * hmf;\r\n    hinterp = hmf - (snp * hmf);\r\n    v = ((1 - sqrt(harmonics * (shape < 0))) * 0.055939) + 0.944061;    // compensate\r\n\r\n    // even harmonics\r\n    a0, a1, a2, a3 = hEven(x);\r\n    // odd harmonics\r\n    b0, b1, b2, b3 = hOdd(x, a0, a1, a2);\r\n\r\n    odd = hMix(sinterp, (b0 * hc), b1, b2, b3);\r\n    even = hMix(hinterp, a0, a1, (a2 * v), (a3 * v));\r\n    shaper = sgz ? odd : dcblock(even); // 1..8 harmonics\r\n\r\n    shaped = (((sshape * shaper) + x) * (1 - (spc * 0.5))) * (((pshape * pshape) * 0.076989) + 0.630957);\r\n    return (shaped) * (compensate ? (((1 - ashape) * 0.412538) + 1) : 1);\r\n}\r\n\r\nParam   shape(0., min=-1, max=1);       // > 0 == odd harmonics, < 0 = even harmonics\r\nParam   harmonics(0.5, min=0, max=1);   // 0..1 = 0..8 harmonics (0 = 0, 0.25 = 1, 0.5 = 2, 0.75 = 4, 1 = 8)\r\nParam   compensate(1, min=0, max=1);    // gain compensation\r\n\r\nParam   smooth(0., min=0, max=666);     // optional smoothing in ms (default off)\r\nsmoothsamps = mstosamps(smooth);\r\n\r\nc   = int(compensate);\r\ns   = shape;\r\nh   = harmonics;\r\nif (smooth > 0) {\r\n    s   = evi_line(s, smoothsamps);     // must be exact smoothers 'cos of crossings\r\n    h   = evi_line(h, smoothsamps);\r\n}\r\n\r\nout1    = hShaper(in1, s, h, compensate=c);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 865.0, 732.0 ]
                }
            },
