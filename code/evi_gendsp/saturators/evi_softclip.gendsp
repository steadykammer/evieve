            },
            {
                "box": {
                    "code": "\r\n// evi_softclip.gendsp by pete for evieve, cheap tanh()-like soft clipping, anti-aliased with a simple second-order Adaa\r\n// NOTE: this is tanh()-like providing input energy NOT above +6dB above full scale, after which it is a different (foldback) saturation\r\n// NOTE: do NOT use this above +6dB input anyway, because it is not well anti-aliased after this point.\r\n// For more options, greater bandwidth and high-gain anti-aliasing, @see: evi_clip_hardsoft.gendsp (more expensive).\r\n\r\naltTanhF0(x)\n{\n  return x / (1 + (0.28 * x*x)); // PM\n}\n\naltTanhF1(x)\n{\n  return (25 * log(7 * x*x + 25)) * 0.071428571428571;\n}\n\naltTanhF2(x)\n{\n\treturn (25 * (x * log(7 * x*x + 25) - 14 * (x * 0.142857142857143 - (5 * atan((2.645751311064591 * x) * 0.2)) * 0.053994924715604))) * 0.071428571428571;\r\n}\n\r\n// first order Adaa\r\naltTanhAdaa1(x0)\n{\n  History x1(0), s1(0);\n  eps = 0.000001;  // TODO, work out precision\n\n  y1 = 0;\n  d0 = x0 - x1;\n  s0 = altTanhF1(x0);    // func1\n  if ((x1 == 0 && s1 == 0) || (abs(d0) < eps)) {  // ill condition\n    y1 = altTanhF0(0.5 * (x0 + x1)); // func0\n  } else {\n    y1 = (s0 - s1) / d0;\n  }\n\n  s1 = s0;\n  x1 = x0;\n  return y1;\n}\n\r\n// main\r\n\n// second order Adaa\r\naltTanhAdaa2(x0)\n{\n  History x1(0), x2(0), s1(0);\n  eps = 0.000001;  // TODO, work out precision\n\n  s0 = x0;//0;\n  d0 = x0 - x1;\n  f2_x1 = altTanhF2(x1); // func2\n  if (abs(d0) < eps) {  // ill condition\n    s0 = altTanhF1(0.5 * (x0 + x1)); // func1\n  } else {\n    s0 = (altTanhF2(x0) - f2_x1) / d0; // func2\n  }\n\n  y1 = x0;//0;\n  d1 = x0 - x2;\n  if (x1 == 0 && x2 == 0) { // ill condition\n    y1 = altTanhF0(x0 + (x1 + x1) + x2) * 0.25; // func0\n  } else if (abs(d1) < eps) { // ill condition\n    x_bar = 0.5 * (x0 + x2);\n    x_delta = x_bar - x1;\n    if (x_delta < eps) {  // ill condition\n      y1 = altTanhF0((x_bar + x1) * 0.5);  // func0\n    } else {\n      y1 = (2 / x_delta) * (altTanhF1(x_bar) + (f2_x1 - altTanhF2(x_bar)) / x_delta); // func1, func2\n    }\n  } else {\n    s0s1 = s0 - s1;\n    y1 = (s0s1 + s0s1) / d1;\n  }\n\n  s1 = s0;\n  x2 = x1;\n  x1 = x0;\n  return y1;\n}\n\r\n// not used here...\r\n\r\nhermite_sixpoint_interp(f0, ym2, ym1, y0, y1, y2, y3)\n{\n  f1    =  f0 - 0.5;\n  even1 = ym2 + y3;\n  odd1  = ym2 - y3;\n  even2 = ym1 + y2;\n  odd2  = ym1 - y2;\n  even3 =  y0 + y1;\n  odd3  =  y0 - y1;\n\n  c0  = 0.01171875*even1    - 0.09765625*even2    + 0.5859375*even3;\n  c1  = 0.2109375*odd2    - 1.463541666667*odd3 - 0.033854166667*odd1;\n  c2  = 0.40625*even2     - 0.354166666667*even3  - 0.052083333333*even1;\n  c3  = 0.1875*odd1     - 1.104166666667*odd2 + 2.375*odd3;\n  c4  = 0.020833333333*even1  - 0.0625*even2      + 0.041666666667*even3;\n  c5  = 1.041666666667*odd2 - 2.083333333333*odd3 - 0.208333333333*odd1;\n\n  return ((((c5*f1 + c4)*f1 + c3)*f1 + c2)*f1 + c1)*f1 + c0;\n}\r\n\n// altTanhAdaa1 oversampling...\n\n// fixed 2x quasi oversampling (hermite6)\naltTanhAdaa1_2x_6POINT(XIN)\n{ // up 2\n  History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n  // down 2\n  History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n  // align\n  History doX0(0);\n\n  // up 2x\n  x0_0_a  = XIN + 0;\n  x1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n  x2_0  = umT2_0 + 0;\n\n  // process 2x\n  y1_0  = altTanhAdaa1(x1_0);\n  y2_0  = altTanhAdaa1(x2_0);\n\n  // down 2x\n  y2_0_a  = y2_0 + 0;\n  y2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n  y0_0  = (doX0 + y2_1) * 0.5;\n\n  // update\n  umTm2_0 = umTm1_0;\n  umTm1_0 = umT0_0;\n  umT0_0  = umT1_0;\n  umT1_0  = umT2_0;\n  umT2_0  = x0_0_a;\n\n  doX0  = y1_0;\n\n  dmT3_1  = dmT2_1;\n  dmT2_1  = dmT1_1;\n  dmT1_1  = dmT0_1;\n  dmT0_1  = dmTm1_1;\n  dmTm1_1 = y2_0;\n\n  return dcblock(y0_0);\n}\n\n// fixed 4x quasi oversampling (hermite6)\naltTanhAdaa1_4x_6POINT(XIN)\n{ // up 2\n  History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n  // down 2\n  History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n  // align\n  History doX0(0);\n\n  // up 2x\n  x0_0_a  = XIN + 0;\n  x1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n  x2_0  = umT2_0 + 0;\n\n  // process 4x\n  y1_0  = altTanhAdaa1_2x_6POINT(x1_0);\n  y2_0  = altTanhAdaa1_2x_6POINT(x2_0);\n\n  // down 2x\n  y2_0_a  = y2_0 + 0;\n  y2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n  y0_0  = (doX0 + y2_1) * 0.5;\n\n  // update\n  umTm2_0 = umTm1_0;\n  umTm1_0 = umT0_0;\n  umT0_0  = umT1_0;\n  umT1_0  = umT2_0;\n  umT2_0  = x0_0_a;\n\n  doX0  = y1_0;\n\n  dmT3_1  = dmT2_1;\n  dmT2_1  = dmT1_1;\n  dmT1_1  = dmT0_1;\n  dmT0_1  = dmTm1_1;\n  dmTm1_1 = y2_0;\n\n  return dcblock(y0_0);\n}\n\n// altTanhAdaa2 oversampling...\n\n// fixed 2x quasi oversampling (hermite6)\naltTanhAdaa2_2x_6POINT(XIN)\n{ // up 2\n  History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n  // down 2\n  History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n  // align\n  History doX0(0);\n\n  // up 2x\n  x0_0_a  = XIN + 0;\n  x1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n  x2_0  = umT2_0 + 0;\n\n  // process 2x\n  y1_0  = altTanhAdaa2(x1_0);\n  y2_0  = altTanhAdaa2(x2_0);\n\n  // down 2x\n  y2_0_a  = y2_0 + 0;\n  y2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n  y0_0  = (doX0 + y2_1) * 0.5;\n\n  // update\n  umTm2_0 = umTm1_0;\n  umTm1_0 = umT0_0;\n  umT0_0  = umT1_0;\n  umT1_0  = umT2_0;\n  umT2_0  = x0_0_a;\n\n  doX0  = y1_0;\n\n  dmT3_1  = dmT2_1;\n  dmT2_1  = dmT1_1;\n  dmT1_1  = dmT0_1;\n  dmT0_1  = dmTm1_1;\n  dmTm1_1 = y2_0;\n\n  return dcblock(y0_0);\n}\n\n// fixed 4x quasi oversampling (hermite6)\naltTanhAdaa2_4x_6POINT(XIN)\n{ // up 2\n  History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n  // down 2\n  History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n  // align\n  History doX0(0);\n\n  // up 2x\n  x0_0_a  = XIN + 0;\n  x1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n  x2_0  = umT2_0 + 0;\n\n  // process 4x\n  y1_0  = altTanhAdaa2_2x_6POINT(x1_0);\n  y2_0  = altTanhAdaa2_2x_6POINT(x2_0);\n\n  // down 2x\n  y2_0_a  = y2_0 + 0;\n  y2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n  y0_0  = (doX0 + y2_1) * 0.5;\n\n  // update\n  umTm2_0 = umTm1_0;\n  umTm1_0 = umT0_0;\n  umT0_0  = umT1_0;\n  umT1_0  = umT2_0;\n  umT2_0  = x0_0_a;\n\n  doX0  = y1_0;\n\n  dmT3_1  = dmT2_1;\n  dmT2_1  = dmT1_1;\n  dmT1_1  = dmT0_1;\n  dmT0_1  = dmTm1_1;\n  dmTm1_1 = y2_0;\n\n  return dcblock(y0_0);\n}\n\r\n\r\nout1 = altTanhAdaa2(in1);\r\n\r\n// also useful:\r\n//out1 = altTanhAdaa1_4x_6POINT(in1);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
