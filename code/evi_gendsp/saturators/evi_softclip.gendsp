            {
                "box": {
                    "code": "\r\n// evi_softclip.gendsp by pete for evieve, cheap tanh()-like soft clipping, anti-aliased with a simple second-order Adaa\r\n// NOTE: this is tanh()-like providing input energy NOT above +6dB above full scale, after which it is a different (foldback) saturation\r\n\r\n// For more options, greater bandwidth and high-gain anti-aliasing, @see: evi_clip_hardsoft.gendsp (more expensive).\r\n// For hard clipping only @see: \"evi_hardclip.gendsp\".\r\n\r\n\r\nrequire(\"evi_adaa.genexpr\");\r\n\r\n\r\nout1 = altTanhAdaa2(in1);\r\n\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
