                    "patching_rect": [ 531.0, 807.0, 247.0, 22.0 ],
                    "text": "out 2 (signal) Dynamic Linear Gain Envelope"
                }
            },
            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 19.0, 192.0, 22.0 ],
                    "text": "in 1 (signal) Audio to be Destroyed"
                }
            },
            {
                "box": {
                    "code": "\n// it started on this thread in 2012:\n// https://cycling74.com/forums/valve-distortion\n// thanks to rodrigo constanzo and peter mcculloch\n\nrequire(\"evi_valves.genexpr\");\n\nHistory init(1), od(4147200000), prevSR(0);\nHistory k1(0.), k2(0.), k3(0.), k4(0.), k5(0.), k6(0.), VT(0.);\nDelay   align(samplerate*0.0625, 1, feedback=0);\n\n// param rate from here\n\nParam   bass(0., min=-10, max=10); // input bass in dB\nParam   treble(0., min=-10, max=10); // input treble in dB\nParam   compensate(0.5, min=0, max=1); // % 0..1, post-sat positive high shelf\nParam   makeup(0., min=0, max=10); // makeup gain in dB\nParam   highpass(40., min=10, max=400); // final highpass in Hz\n\r\nParam   envshape(0.5, min=0, max=1); // vactrol shape (filter cutoff), flat..sharp\nParam   envscale(0.25, min=0, max=1); // compress gain env (& the more compressed, the higher the gain)\n// !! in SAMPLES; any less than 100 you will have problems with fast transient material\nParam   envinterval(200, min=100, max=2000); // average samples\n// !! in SAMPLES; for a useful macroisation see the helpfile\nParam   envattack(20, min=1, max=1000); // TEMP\nParam   envrelease(2000, min=100, max=samplerate); // TEMP\n\n// if one of these is on we have single gain env (normal), if both are on we have double\n// enveloping (crazy), if both are off we have no dynamic gain and we are quasi 'static' distortion\nParam   envasym(1, min=0, max=1); // place gain envelope before asymmetric processing stage\nParam   envvalve(0, min=0, max=1); // place gain envelope on input to distortion stages\n\nParam   asymmetry(0., min=-6, max=6); // fake dB (favours negative regardless, but does 'add gain')\nParam   hysterisis(0.5, min=0, max=1); // amount of hysterisis envelopes 0..1, unaligned shifts in ± gain\n\nParam   diode(1, min=0, max=1); // select diode algo, 0='soft', 1='hard'\ndio     = int(diode);\n\neint    = int(envinterval + 0.5);\necomp   = envscale * 0.5; // 0..0.5, default 0.125\r\nebase   = evi_mtofapprox(envshape * 81 + 43); // 100..10000 Hz around envshape=0.5 is 1000 Hz\n\nvalveenv = int(envvalve);\nasymenv  = int(envasym);\nasymskew = dbtoaApprox(asymmetry); // ± 6dB = 0.5..2 around 1\n\nmug, muk = rcDampCoeffs1(6000, compensate); // highshelf compensation @6kHz, pre rcOnePole()\nmakeUpGain = dbtoaApprox(makeup); // manual but pre rcOnePole()\ntoneG = rcPreWarp2(15000); // Hz, todo\nhighG = rcPreWarp1(highpass); // Hz\n\nup = int(envattack + 0.5);\ndown = int(envrelease + 0.5);\nuphalf = maximum(int(up * 0.5 + 0.5), 1);\ndownhalf = int(down * 0.5 + 0.5);\n\n// audio rate from here\n\nif ( (init) || (prevSR != SAMPLERATE) ) {\n    od   = mstosamps(86400000);\n    k1, k2, k3, k4, k5, k6, VT = diodeCoeffsV(SAMPLERATE);\n    prevSR = SAMPLERATE;\n    init = 0;\n}\nheat = clip((elapsed / od), 0, 1);\n\nresetavg = delta(change(eint)) < 0;\nresetdio = delta(change(dio)) < 0;\nreset = resetavg + resetdio;\n\r\nlatency = eint + uphalf;\nX = safe20dB(in1); // if user input > 20dB above FS will antialias hardclip, otherwise totally linear\nXenv = clip(X, -1, 1); // :-(\nalign.write(X);\nxAlign = align.read(latency, interp=\"none\"); // \"none\" is tenous because of uphalf\nxAenv = clip(xAlign, -1, 1); // :-(\n\navgMedium, avgIndex = averageCore(abs(Xenv + Xenv), reset, windowSize=eint);\r\nenvData = avgMedium;\n\nzeroxSmooth = sampstoms(down + down);\n// increasing 'countDiv' makes bias env smaller for noisey input audio\nthreshEnv, countEnv, xings = zeroxEnvs(xAenv, zeroxSmooth, resetavg, countDiv=10); // align with 'averageData()'\n\nenvMain = vactrol(envData*0.5, up, down, ebase, resetavg)*2; // main for gainEnv\nenvSub = vactrol(avgMedium*0.5, uphalf, downhalf, ebase, resetavg)*2;\n//invSub = 1 - (envSub * hysterisis); // not used\n\n// 'immediate' based on 'X', not xAlign\nenvImm = immediateEnv(Xenv, 0.000001, zeroxSmooth*0.001, resetavg); // secs\n// dcblock is for shape, not for dc\nenvHyst1 = dcblock(clip((envSub - slide(envData, uphalf, downhalf)), -1, 1)) * hysterisis;\nenvHyst2 = 1 - ((envSub - envImm) * hysterisis * countEnv);\n\n// goes above and below 1 so we get a compression expansion effect, depends on 'envscale'\ngainEnv = (envMain + threshEnv) * (1 - ecomp) + ecomp + ecomp;// + ecomp; // 0..2++\nbiasEnv = clip((envMain - envSub) * countEnv, -0.333333333333, 0.333333333333);\n\n// if one of these is on we have single gain env (normal), if both are on we have double\n// enveloping (crazy), if both are off we have no dynamic gain and we are quasi 'static' distortion\ngainEnvPre = asymenv ? gainEnv : 1;\ngainEnvPost = valveenv ? gainEnv : 1;\n\n// input EQ (gain) is post envelope makers\nXIN = xAlign;\nif (treble != 0 || bass != 0) { // only compute if engaged\n    XIN = evi_baxandall(xAlign, treble=treble, bass=bass, smooth=1);\n}\n\nasymInput = XIN * gainEnvPre;\nasymHist1 = abs(envHyst1) + 1; // pos env, boost smaller\nasymHist2 = (0 - (envHyst1 * envHyst1)) + 1; // neg env, attenuate bigger\nasymOutput, asymPos, asymNeg = asymExecute(asymInput, asymskew, asymHist1, asymHist2, heat, softhard=dio, low=2.1, high=3.9);\n\nvalveInput = asymOutput * 0.25; // approx -4..4 .. -1..1\n\n// ^^ until this point everything has been high gain linear\n\n// nonlinear, \"asymmetrical double sided\"\nvalve = 0;\n// do not additionally dcblock anything in this block\nif (dio) {  // 'hard'\n    valve = diodeWrapGB_8x(valveInput, k1, k2, k3, k4, k5, k6, VT, gainEnvPost, biasEnv, reset) * 1.995262;\n}\nelse {      // 'soft'\n    ingain, outgain = atanDriveV(gainEnvPost);\n    ataninput = valveInput * ingain + biasEnv;\n    valve = atanAdaa2_4x_6POINT(ataninput, reset) * outgain;\n}\n\n// marketing people call this \"air\"\nvalveOutput = rcFilterDamp(valve * envHyst2, mug, muk); // * hysterisis, through high frequency compensation\n\n// similar arrangement to 'evi_tone_macro.gendsp':\neviValve = rcOnePole(valveOutput * makeUpGain, toneG); // NR nonlinear onepole\nout1 = rcFilterHp(eviValve, highG); // main\n\nout2 = gainEnv; // main env, linear, 0..2++\nout3 = latency; // latency in samples\n\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 3,
                    "outlettype": [ "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 983.0, 732.0 ]
                }
            },
