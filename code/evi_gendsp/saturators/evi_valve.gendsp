                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 49.0, 807.0, 168.0, 22.0 ],
                    "text": "out 1 (signal) Valve Goodness"
                }
            }
        ],
