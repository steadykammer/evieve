            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 19.0, 192.0, 22.0 ],
                    "text": "in 1 (signal) Audio to be Destroyed"
                }
            },
            {
                "box": {
                    "code": "\r\n// it started on this thread in 2012:\r\n// https://cycling74.com/forums/valve-distortion\r\n// thanks to rodrigo constanzo and peter mcculloch\r\n\r\nrequire(\"evi_valves.genexpr\");\r\n\r\nHistory init(1), od(4147200000), prevSR(0);\r\nHistory k1(0.), k2(0.), k3(0.), k4(0.), k5(0.), k6(0.), VT(0.);\r\nDelay   align(samplerate*0.0625, 1, feedback=0);\r\n\r\n// param rate from here\r\n\r\nParam   bass(0., min=-10, max=10); // input bass in dB\r\nParam   treble(0., min=-10, max=10); // input treble in dB\r\nParam   compensate(0.5, min=0, max=1); // % 0..1, post-sat positive high shelf\r\nParam   makeup(0., min=0, max=10); // makeup gain in dB\r\nParam   highpass(40., min=10, max=400); // final highpass in Hz\r\n\r\nParam   envtype(0, min=0, max=2); // fast, medium, slow\r\nParam   envscale(0.24, min=0, max=1); // compress gain env (& the more compressed, the higher the gain)\r\n// any less than 100 you will have problems with fast transient material\r\nParam   envinterval(200, min=100, max=2000); // average samples\r\nParam   envmode(1, min=0, max=2); // bipolar, absolute, rms (do not use bipolar)\r\n\r\n// in samples\r\nParam   attack(20, min=10, max=1000); // TEMP\r\nParam   decay(2000, min=100, max=10000); // TEMP\r\n\r\n// if one of these is on we have single gain env (normal), if both are on we have double\r\n// enveloping (crazy), if both are off we have no dynamic gain and we are quasi 'static' distortion\r\nParam   envasym(1, min=0, max=1);\r\nParam   envvalve(0, min=0, max=1);\r\n\r\nParam   asymmetry(0., min=-6, max=6); // fake dB (favours negative regardless, but does 'add gain')\r\nParam   hysterisis(0.5, min=0, max=1); // amount of hysterisis envelopes 0..1, shifts in your audio\r\n\r\nParam   diode(1, min=0, max=1); // select diode algo, 0='soft', 1='hard'\r\ndio     = int(diode);\r\n\r\netype   = int(envtype);\r\neint    = int(envinterval);\r\nemode   = int(envmode);\r\nenvcomp = envscale * 0.5; // 0..0.5, default 0.12\r\n\r\nvalveenv = int(envvalve);\r\nasymenv  = int(envasym);\r\nasymskew = dbtoaApprox(asymmetry); // 0.5..2 around 1\r\n\r\nmug, muk = rcDampCoeffs1(6000, compensate); // highshelf compensation @6kHz, pre rcOnePole()\r\nmakeUpGain = dbtoaApprox(makeup); // manual but pre rcOnePole()\r\ntoneG = rcPreWarp2(15000); // Hz, todo\r\nhighG = rcPreWarp1(highpass); // Hz\r\n\r\nup = int(attack);\r\ndown = int(decay);\r\nuphalf = int(up * 0.5);\r\ndownhalf = int(down * 0.5);\r\n\r\n// audio rate from here\r\n\r\nif ( (init) || (prevSR != SAMPLERATE) ) {\r\n    od   = mstosamps(86400000);\r\n    k1, k2, k3, k4, k5, k6, VT = diodeCoeffsV(SAMPLERATE);\r\n    prevSR = SAMPLERATE;\r\n    init = 0;\r\n}\r\nheat = clip((elapsed / od), 0, 1);\r\n\r\nresetavg = (delta(change(etype)) < 0) + (delta(change(eint)) < 0) + (delta(change(emode)) < 0);\r\nresetdio = delta(change(dio)) < 0;\r\nreset = resetavg + resetdio;\r\n\r\nX = safe20dB(in1); // if user input > 20dB above FS will antialias hardclip, otherwise totally linear\r\nalign.write(X);\r\nxAlign = align.read(eint, interp=\"none\");\r\n\r\n// pete says, \"e works\"\r\navgFast, avgMedium, avgSlow = averageData(X * e, reset, interval=eint, mode=emode);\r\nenvData = selector((etype + 1), avgFast, avgMedium, avgSlow);\r\n\r\nzeroxSmooth = sampstoms(down + down);\r\n// increasing 'countDiv' makes bias env smaller for noisey input audio\r\nthreshEnv, countEnv, xings = zeroxEnvs(xAlign, zeroxSmooth, resetavg, countDiv=10); // align with 'averageData()'\r\n\r\nenvMain = vactrol(envData, up, down, resetavg); // main for gainEnv: avgFast, avgMedium or avgSlow\r\nenvSub = vactrol(avgMedium, uphalf, downhalf, resetavg); // always 'avgMedium'\r\n//invSub = 1 - (envSub * hysterisis); // not used\r\n\r\n// 'immediate' based on 'X', not xAlign\r\nenvImm = immediateEnv(X, 0.000001, zeroxSmooth*0.001, resetavg); // secs\r\n// dcblock is for shape, not for dc\r\nenvHyst1 = dcblock(clip((envSub - slide(envData, uphalf, downhalf)), -1, 1)) * hysterisis;\r\nenvHyst2 = 1 - ((envSub - envImm) * hysterisis * countEnv);\r\n\r\n// goes above and below 1 so we get a compression expansion effect, depends on 'envscale'\r\ngainEnv = (envMain + threshEnv) * (1 - envcomp) + envcomp + envcomp + envcomp; // 0..2++\r\nbiasEnv = clip((envMain - envSub) * countEnv, -0.333333333333, 0.333333333333);\r\n\r\n// if one of these is on we have single gain env (normal), if both are on we have double\r\n// enveloping (crazy), if both are off we have no dynamic gain and we are quasi 'static' distortion\r\ngainEnvPre = asymenv ? gainEnv : 1;\r\ngainEnvPost = valveenv ? gainEnv : 1;\r\n\r\n// input EQ (gain) is post envelope makers\r\nXIN = xAlign;\r\nif (treble != 0 || bass != 0) { // only compute if engaged\r\n    XIN = evi_baxandall(xAlign, treble=treble, bass=bass, smooth=1);\r\n}\r\n\r\nasymInput = XIN * gainEnvPre;\r\nasymHist1 = abs(envHyst1) + 1;//envHyst1 + 1; // pos env, boost smaller\r\nasymHist2 = (0 - (envHyst1 * envHyst1)) + 1; // neg env, attenuate bigger\r\nasymOutput, asymPos, asymNeg = asymExecute(asymInput, asymskew, asymHist1, asymHist2, heat, softhard=dio, low=2.1, high=3.9);\r\n\r\nvalveInput = asymOutput * 0.25; // approx -4..4 .. -1..1\r\n\r\n// ^^ until this point everything has been linear (high gain)\r\n\r\n// nonlinear, \"asymmetrical double sided\"\r\nvalve = 0;\r\n// do not additionally dcblock anything in this block\r\nif (dio) {  // 'hard'\r\n    valve = diodeGB_8x_4POINT(valveInput, k1, k2, k3, k4, k5, k6, VT, gainEnvPost, biasEnv, reset) * 1.995262;\r\n}\r\nelse {      // 'soft'\r\n    ingain, outgain = atanDriveV(gainEnvPost);\r\n    ataninput = valveInput * ingain + biasEnv;\r\n    valve = atanAdaa2_4x_6POINT(ataninput, reset) * outgain;\r\n}\r\n\r\n// marketing people call this \"air\"\r\nvalveOutput = rcFilterDamp(valve * envHyst2, mug, muk); // * hysterisis, through hf compensation\r\n\r\n// similar arrangement to 'evi_tone_macro.gendsp':\r\neviValve = rcOnePole(valveOutput * makeUpGain, toneG); // NR nonlinear onepole\r\nout1 = rcFilterHp(eviValve, highG); // main\r\n\r\nout2 = gainEnv; // main env, linear, 0..2++\r\nout3 = eint; // latency in samples\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 3,
                    "outlettype": [ "", "", "" ],
                    "patching_rect": [ 49.0, 58.0, 983.0, 732.0 ]
                }
            },
            {
                "box": {
