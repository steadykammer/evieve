            {
                "box": {
                    "code": "\r\nrequire(\"evi_adaa.genexpr\");\r\n\r\n// antialiased soft clipping\r\n\r\n// it is strongly advised that you never change these 'constants':\r\nParam   softH(sqrt1_2, min=0.01, max=2);\r\nParam   softRatio(sqrt1_2, min=0, max=1);\r\nParam   softC(sqrt1_2, min=0.64, max=1.4);\r\nParam   softR(sqrt1_2, min=0.01, max=0.99);\r\nParam   softBeta(4., min=2, max=32);\r\nParam   softS(0.01, min=0, max=0.05);\r\n\r\n// select:\r\nParam   algo(0, min=0, max=1);  // 0 = clearer harmonics, 1 = more bassy\r\nalg     = int(algo);\r\n\r\n// audio:\r\nresponder = 0;\r\nif (alg == 1) {\r\n    responder = softclipNAdaa2(in1, C=softC, R=softR, beta=softBeta, S=softS);\r\n}\r\nelse {\r\n    responder = softclip2Adaa2(in1, h=softH, ratio=softRatio);\r\n}\r\n\r\nout1 = responder;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
