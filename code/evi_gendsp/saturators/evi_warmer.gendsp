        "classnamespace": "dsp.gen",
        "rect": [ 594.0, 256.0, 884.0, 692.0 ],
        "gridonopen": 2,
        "integercoordinates": 1,
        "boxes": [
            {
                "box": {
                    "code": "/*\n\tI made this for Andreas Wetterberg in 2013\r\n\tI updated it in 2021\r\n\tIt is based on a Tom Szilagyi idea\r\n*/\r\n\r\nrequire(\"evi_warmer_lib.genexpr\");\r\n\r\nHistory med(0), prevmed(0), prevout(0);\n\r\n// param rate\r\n\r\nParam highpass(100., min=10, max=400);\r\nParam order(3, min=0, max=8);\nParam cutoff(samplerate*0.125, min=samplerate*0.00125, max=samplerate*0.25);\n// turn off (0) if doing audio rate modulation of drive & blend:\nParam smooth(30.111, min=0, max=301.11);// in ms\n\nParam ingain(1., min=-48, max=48);\nParam outgain(-1., min=-24, max=24);\n\nParam drive(2., min=0, max=10);\nParam blend(-2., min=-10, max=10);\n\nParam bassslope(0.23228, min=0, max=1);\nParam bassmix(0.333333, min=0, max=1);\nParam bassgain(-1., min=-12, max=12);\t// fold\nParam bassboost(0, min=0, max=1);\t\t// 0=soft, 1=hard\nbb = int(bassboost);\nss = smooth > 0;\r\nsmoothsecs = smooth * 0.001;\nord = int(order);\n\nbs = bassslope * 254 + 3;\nbg = dbtoaApprox(bassgain);\ningn = dbtoaApprox(ingain);\noutgn = dbtoaApprox(outgain);\r\nhp = rcPreWarp1(highpass);\n\r\n// audio rate\r\n\r\ng = logsmooth(hp, smoothsecs);\r\n\ndrve = (drive * 0.99) + 0.1;\nblnd = blend;\nif (ss) {\n\tdrve = logsmooth(drve, smoothsecs);\n\tblnd = eviLine(blnd, vectorsize*4);\n}\n\n// sadly this has to be audio rate because of zero crossings etc\nsrct, ap, kpa, kpb, an, kna, knb, pwrq = szilagyi(drve, blnd, samplerate);\n\nbbev = eviSline(bb, mstosamps(smooth+100));\nxinput = in1 * (1 - bbev);\nif (bbev > 0) {\n\ts, g = expsmoothBank2(bs, bg, 0.015222);\n\tm = eviLine(bassmix, vectorsize*6);\n\txinput = boost((in1 * bbev), s, m, g);\n}\n\ning, outg = expsmoothBank2(ingn, outgn, 0.022666);\n\nxin = dcblock(xinput * ing);\nmed = 0;\nif (xin > 0) {\n\tmed = (sD(ap + xin * (kpa - xin)) + kpb) * pwrq;    // sD() like D() but Adaa\n} else {\n\tmed = -((sD(an - xin * (kna + xin)) + knb) * pwrq);\n}\nmed = dcblock(med);\n\r\nyy = maximum((srct * (med - prevmed + prevout)), -1);\nX = saturateAdaa2_4x_6POINT(yy * outg, -0.9886, 1) * sqrt1_2;\n\r\nX = rcFilterHp(X, g);\r\n\r\nG = 0;\r\nY = 0;\r\n// linear Butterworth\r\nif (ord > 0) {\r\n\tCF\t= logsmooth(cutoff, smooth);\r\n\tG\t= fWarp(CF);\t\t\t\t\t\t// get G coefficient if not bypassed\r\n\tif\t\t\t(ord == 1) {\r\n\t\tY\t= lp1p(X,\tG);\r\n\t} else if\t(ord == 2) {\r\n\t\tY\t= lp2p(X,\tG, 1.4142135623730951);\r\n\t} else if\t(ord == 4) {\r\n\t\ty0\t= lp2p(X,\tG, 0.7653668647301797);\r\n\t\tY\t= lp2p(y0,\tG, 1.8477590650225735);\r\n\t} else if\t(ord == 5) {\r\n\t\ty0\t= lp2p(X,\tG, 0.6180339887498949);\r\n\t\ty1\t= lp2p(y0,\tG, 1.618033988749895);\r\n\t\tY\t= lp1p(y1,\tG);\r\n\t} else if\t(ord == 6) {\r\n\t\ty0\t= lp2p(X,\tG, 0.5176380902050419);\r\n\t\ty1\t= lp2p(y0,\tG, 1.4142135623730951);\r\n\t\tY\t= lp2p(y1,\tG, 1.9318516525781366);\r\n\t} else if\t(ord == 7) {\r\n\t\ty0\t= lp2p(X,\tG, 0.4450418679126289);\r\n\t\ty1\t= lp2p(y0,\tG, 1.2469796037174672);\r\n\t\ty2\t= lp2p(y1,\tG, 1.8019377358048383);\r\n\t\tY\t= lp1p(y2,\tG);\r\n\t} else if\t(ord == 8) {\r\n\t\ty0\t= lp2p(X,\tG, 0.39018064403225666);\r\n\t\ty1\t= lp2p(y0,\tG, 1.1111404660392046);\r\n\t\ty2\t= lp2p(y1,\tG, 1.6629392246050905);\r\n\t\tY\t= lp2p(y2,\tG, 1.9615705608064609);\r\n\t} else {//\t(ord == 3)\t\t\t\t\t// default\r\n\t\ty0\t= lp2p(X,\tG, 1.0000000000000002);\r\n\t\tY\t= lp1p(y0,\tG);\r\n\t}\r\n\r\n} else {\t//\t(ord == 0)\t\t\t\t\t// bypassed\r\n\tG\t= 0.414226;\r\n\tY\t= X;\r\n}\r\n\r\nout1 = Y;\n\r\nprevmed = fixdenorm(med);\nprevout = fixdenorm(yy);\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
