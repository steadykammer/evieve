        "classnamespace": "dsp.gen",
        "rect": [ 594.0, 256.0, 884.0, 692.0 ],
        "gridonopen": 2,
        "integercoordinates": 1,
        "boxes": [
            {
                "box": {
                    "code": "/*\n\tI made this for Andreas Wetterberg in 2013\r\n\tI updated it in 2021\r\n\tIt is based on a Tom Szilagyi idea\r\n*/\r\n\r\nrequire(\"evi_warmer_lib.genexpr\");\r\n\r\nHistory med(0), prevmed(0), prevout(0);\n\r\n// param rate\r\n\r\n//Param highpass(100., min=10, max=400); // no\r\nParam order(3, min=0, max=8);\nParam cutoff(samplerate*0.125, min=samplerate*0.00125, max=samplerate*0.25);\n// turn off (0) if doing audio rate modulation of drive & blend:\nParam smooth(30.111, min=0, max=301.11);// in ms\n\nParam ingain(1., min=-24, max=24);\nParam outgain(-1., min=-24, max=24);\n\nParam drive(2., min=0, max=10);\nParam blend(-2., min=-10, max=10);\n\nParam foldslope(0.23228, min=0, max=1);\nParam foldmix(0.333333, min=0, max=1);\nParam foldgain(-1., min=-12, max=12);\t// fold\nParam foldboost(0, min=0, max=1);\t\t// 0=soft, 1=hard\nbb = int(foldboost);\nss = smooth > 0;\r\nsmoothsecs = smooth * 0.001;\nord = int(order);\n\nbs = foldslope * 254 + 3;\nbg = dbtoaApprox(foldgain);\ningn = dbtoaApprox(ingain);\noutgn = dbtoaApprox(outgain);\r\n//hp = rcPreWarp1(highpass); // no\ndrve = (drive * 0.99) + 0.1;\nblnd = blend;\n\r\n// audio rate\r\n\r\n//g = logsmooth(hp, smoothsecs); // no\r\n\nif (ss) {\n\tdrve = logsmooth(drve, smoothsecs);\n\tblnd = eviLine(blnd, vectorsize*4);\n}\n\n// sadly this has to be audio rate because of zero crossings etc\nsrct, ap, kpa, kpb, an, kna, knb, pwrq = szilagyi(drve, blnd, samplerate);\n\nbbev = eviSline(bb, mstosamps(smooth+100));\r\nxin1 = in1 * (1 - bbev);\nxin2 = 0;\r\nif (bbev > 0) {\n\ts, g = expsmoothBank2(bs, bg, smoothsecs*0.501);\n\tm = eviLine(foldmix, vectorsize*6);\n\txin2 = boost((in1 * bbev), s, m, g);    \n}\nxinput = xin1 + xin2;\r\n\ning, outg = expsmoothBank2(ingn, outgn, smoothsecs*0.666666);\n\nxin = dcblock(xinput * ing);\nif (xin > 0) {\n\tmed = (sD(ap + xin * (kpa - xin)) + kpb) * pwrq;    // sD() like D() but Adaa\n} else {\n\tmed = -((sD(an - xin * (kna + xin)) + knb) * pwrq);\n}\nmed = dcblock(med);\n\r\nyy = maximum((srct * (med - prevmed + prevout)), -1);\nX = saturateAdaa2_4x_6POINT(yy * outg, -0.9886, 1) * sqrt1_2;\n\r\n//X = rcFilterHp(X, g); // no\r\n\r\nY = linearButterworthLP8(X, cutoff, order=ord);\r\n\r\nout1 = Y;\n\r\nprevmed = fixdenorm(med);\nprevout = fixdenorm(yy);\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 34.0, 58.0, 810.0, 575.0 ]
                }
