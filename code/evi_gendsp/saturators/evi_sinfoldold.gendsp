, 			{
				"box" : 				{
					"code" : "\r\n// sine shaping wavefolder by Pete for evieve. \"I think it sounds pretty good,\r\n// but watch out for those bumps in the fundamental\".\r\n\r\n// Cubic Hermite, McCartney / Harker\t// 8 muls, 11 ±\t// NOT gen~ [interp mode=\"cubic\"]\n// Faster and better quality than the gen~ \"cubic\" (which is the interp from [groove~])\ncubic_hermite_interp(f, y0, y1, y2, y3)\n{\n//\tc0\t\t= y1;\n\tc1\t\t= 0.5 * (y2 - y0);\n\tc2\t\t= y0 - 2.5 * y1 + y2 + y2 - 0.5 * y3;\n\tc3\t\t= 0.5 * (y3 - y0) + 1.5 * (y1 - y2);\n\treturn\t((c3 * f + c2) * f + c1) * f + y1;\n}\n\ncosQ32(x)\n{\n\tc1 =  0.99940307;\n\tc2 = -0.49558072;\n\tc3 =  0.03679168;\n\n\tx2 =  x * x;\n\treturn (c1 + x2 * (c2 + c3 * x2));\n}\n\ncos32quad12(x)\t// cheap cheat, not exactly correct\n{\t\t\t\t\t\t\t\t\t// no branching, stay out of while loop\n\treturn (x < 0.636619772368) ? cosQ32(x) : -cosQ32(pi - x);\n}\n\n// based on an idea by jhno & Trond Lossius\nsinParam(drive)\t\t\t\t\t\t// for param rate\n{\n\tpidrive\t\t= drive*3.110176727054 + 0.031415926536;\n\tsindrive\t= 1 / cos32quad12(halfpi - minimum(pidrive, halfpi));\n\treturn\tpidrive, sindrive;\n}\n\nsinFold(x, pidrive, sindrive)\t\t// for audio rate\n{\n\treturn sin(x * pidrive) * sindrive;\n}\n\n// fixed 4x (not really) quasi oversampling\r\nsinFold4x(XIN, pidrive, sindrive)\n{\t// up 4\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 4\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\tHistory\tdmT2_2(0), dmT1_2(0), dmT0_2(0);\n\tHistory\tdmT2_3(0), dmT1_3(0), dmT0_3(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 4x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= interp(0.25,\tumTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\tx2_0\t= interp(0.5,\tumTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\tx3_0\t= interp(0.75,\tumTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\n\t// process 4x\n\ty1_0\t= sinFold(x1_0,\t\t\tpidrive, sindrive);\n\ty2_0\t= sinFold(x2_0,\t\t\tpidrive, sindrive);\n\ty3_0\t= sinFold(x3_0,\t\t\tpidrive, sindrive);\n\ty4_0\t= sinFold(umT1_0 + 0,\tpidrive, sindrive);\n\n\t// down 4x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(0.25,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\n\ty3_0_a\t= y3_0 + 0;\n\ty3_1\t= interp(0.5,\ty3_0_a,\tdmT0_2, dmT1_2, dmT2_2, mode=\"spline\");\n\n\ty4_0_a\t= y4_0 + 0;\n\ty4_1\t= interp(0.75,\ty4_0_a,\tdmT0_3, dmT1_3, dmT2_3, mode=\"spline\");\n\n\ty0_0\t= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\tdmT2_2\t= dmT1_2;\n\tdmT1_2\t= dmT0_2;\n\tdmT0_2\t= y3_0;\n\n\tdmT2_3\t= dmT1_3;\n\tdmT1_3\t= dmT0_3;\n\tdmT0_3\t= y4_0;\n\n\treturn dcblock(y0_0);\n}\n\n// fixed 8x (not really) quasi oversampling\r\nsinFold8x(XIN, pidrive, sindrive)\n{\t// up 2\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 2\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= cubic_hermite_interp(0.5,\tumTm1_0, umT0_0, umT1_0, x0_0_a);\n\tx2_0\t= umT1_0 + 0;\n\n\t// process 8x\n\ty1_0\t= sinFold4x(x1_0, pidrive, sindrive);\n\ty2_0\t= sinFold4x(x2_0, pidrive, sindrive);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= cubic_hermite_interp(0.5,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\treturn dcblock(y0_0);\n}\n\nexpA(x0)\t\t\t\t\t\t\t// more accurate than 'fastexp()'\n{\n\tx = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;\n\tx *= x; x *= x; x *= x; x *= x; x *= x;\n\treturn x;\n}\n\ntauA(t)\t\t\t\t\t\t\t\t// t is time in seconds\n{\n\ty = expA(-1 / (t * samplerate));\n\treturn y + 0.000128;\n}\n\r\nexpso(x, z)\t\t\t\t\t\t\t// z is pole\n{\n\tHistory w(0);\n\ty = (z * w) + (x * (1 - z));\n\tw = y;\n\treturn y;\n}\n\nexpsmoothBank2(x1, x2, t)\t\t\t// t is smooth time in seconds\n{\n\tHistory\texps2dummy(0);\n\tz\t\t= tauA(t);\n\ty1\t\t= expso(x1, z);\n\ty2\t\t= expso(x2, z);\n\treturn\ty1, y2;\n}\n\r\n// param rate ...\r\n\r\nParam\tdrive(0.5, min=0, max=4);\t\t// % 0..1.. up to 2 is pretty safe, up to 4 be careful\r\nParam\tsmooth(22.666, min=1, max=666);\t// ms\r\nsmoothsecs\t\t\t= smooth*0.001;\r\ncompensate\t\t\t= 0.984292036732;\t// because approxes, and general fudgyness\r\npidrive, sindrive\t= sinParam(drive);\r\n\r\n// audio rate ...\r\n\r\ndrivepi, drivesin\t= expsmoothBank2(pidrive, sindrive, smoothsecs);\r\nout1\t\t\t\t= sinFold8x(in1*compensate, drivepi, drivesin);\r\n\r\n",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 12.0,
					"id" : "obj-3",
					"maxclass" : "codebox",
					"numinlets" : 1,
					"numoutlets" : 1,
					"outlettype" : [ "" ],
					"patching_rect" : [ 49.0, 58.0, 759.0, 732.0 ]
				}

			}
