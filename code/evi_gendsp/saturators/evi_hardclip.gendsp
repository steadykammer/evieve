        "boxes": [
            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 19.0, 196.0, 22.0 ],
                    "text": "in 1 Audio Input to be treated nicely"
                }
            },
            {
                "box": {
                    "code": "\n// hard clipping for your audio, the evieve way.\n// anti derivative anti aliasing, 1st & 2nd orders.\n// also fake oversampling options, 2x & 4x for both 1st & 2nd orders.\n// this works well up to about +40dB input.\n\n\nrequire(\"evi_interp.genexpr\");\n\n\nxSgnP(x) // no zero\n{\n\treturn (0 < x) - (x < 0);\n}\n\nxRangeP(x, range=1)\n{\n\treturn abs(x) <= range;\n}\n\r\n\nfuncHc0(x, clip=1)\n{\n\treturn clamp(x, -clip, clip);\n}\n\nfuncHc1(x, limit=1)\n{\n\tad1 = x;\n\tir = xRangeP(x, range=limit);\n\tif (ir) {\n\t\tad1 = x * x * 0.5;\n\t} else {\n\t\tad1 = x * xSgnP(x) - 0.5;\n\t}\n\treturn ad1;\n}\n\nfuncHc2(x, limit=1)\n{\n\tad2 = x;\n\tods = 0.166666666666667;\n\tir = xRangeP(x, range=limit);\n\tif (ir) {\n\t\tad2 = x * x * x * ods;\n\t} else {\n\t\tx05 = x * 0.5;\n\t\tad2 = ((x * x05) + ods) * xSgnP(x) - x05;\n\t}\n\treturn ad2;\n}\n\r\n\n// in the below, \"limit\" only really works with very small deviations from '1' :-(\n\nadHc1(x, limit=1) // first antiderivative\n{\n\tHistory x1(0), ad1_x1(0);\n\tTOL = 0.00001;\n\txmx1 = x - x1;\n\tillCondition = abs(xmx1) < TOL;\n\tad1_x = funcHc1(x, limit=limit);\n\n\ty = 0;\n\tif (illCondition) {\n\t\ty = funcHc0(0.5 * (x + x1), clip=limit);\n\t} else {\n\t\ty = (ad1_x - ad1_x1) / xmx1;\n\t}\n\n\tad1_x1 = ad1_x;\n\tx1 = x;\n\n\treturn y;\n}\n\nadHc2(x, limit=1) // second antiderivative\n{\n\tHistory x1(0), x2(0), ad2_x1(0), d2(0);\n\tTOL = 0.00001;\n\txmx2 = x - x2;\n\tillCondition = abs(xmx2) < TOL;\n\n\td1 = x;\n\txmx1 = x - x1;\n\td1Condition = abs(xmx1) < TOL;\n\tad2_x0 = funcHc2(x, limit=limit);\n\tif (d1Condition) {\n\t\td1 = funcHc1(0.5 * (x + x1), limit=limit);\n\t} else {\n\t\td1 = (ad2_x0 - ad2_x1) / xmx1;\n\t}\n\n\tfb = x;\n\txBar = 0.5 * (x + x2);\n\tdelta = xBar - x1;\n\tfallbackCondition = abs(delta) < TOL;\n\tif (fallbackCondition) {\n\t\tfb = funcHc0(0.5 * (xBar + x1), clip=limit);\n\t} else {\n\t\tfb = (2 / delta) * (funcHc1(xBar, limit=limit) + (ad2_x1 - funcHc2(xBar, limit=limit)) / delta);\n\t}\n\n\ty = x;\n\tif (illCondition) {\n\t\ty = fb;\n\t} else {\n\t\ty = (2 / xmx2) * (d1 - d2);\n\t}\n\n\td2 = d1;\n\tx2 = x1;\n\tx1 = x;\n\tad2_x1 = ad2_x0;\n\n\treturn y;\n}\n\r\n\n// fixed 2x quasi oversampling (hermite6)\nadHc1_2x_6POINT(XIN, thresh=1)\n{\t// up 2\n\tHistory\tumTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory\tdmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= hermite_sixpoint_interp(0.5,\tumTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0\t= umT2_0 + 0;\n\n\t// process 2x\n\ty1_0\t= adHc1(x1_0, limit=thresh);\n\ty2_0\t= adHc1(x2_0, limit=thresh);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= hermite_sixpoint_interp(0.5,\ty2_0_a,\tdmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0\t= umTm1_0;\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0 \t= umT2_0;\n\tumT2_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT3_1\t= dmT2_1;\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= dmTm1_1;\n\tdmTm1_1\t= y2_0;\n\n\treturn dcblock(y0_0);\n}\n\n// fixed 4x quasi oversampling (hermite6)\nadHc1_4x_6POINT(XIN, thresh=1)\n{\t// up 2\n\tHistory\tumTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory\tdmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= hermite_sixpoint_interp(0.5,\tumTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0\t= umT2_0 + 0;\n\n\t// process 4x\n\ty1_0\t= adHc1_2x_6POINT(x1_0, thresh=thresh);\n\ty2_0\t= adHc1_2x_6POINT(x2_0, thresh=thresh);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= hermite_sixpoint_interp(0.5,\ty2_0_a,\tdmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0\t= umTm1_0;\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0 \t= umT2_0;\n\tumT2_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT3_1\t= dmT2_1;\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= dmTm1_1;\n\tdmTm1_1\t= y2_0;\n\n\treturn dcblock(y0_0);\n}\n\r\n\n// fixed 2x quasi oversampling (hermite6)\nadHc2_2x_6POINT(XIN, thresh=1)\n{\t// up 2\n\tHistory\tumTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory\tdmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= hermite_sixpoint_interp(0.5,\tumTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0\t= umT2_0 + 0;\n\n\t// process 2x\n\ty1_0\t= adHc2(x1_0, limit=thresh);\n\ty2_0\t= adHc2(x2_0, limit=thresh);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= hermite_sixpoint_interp(0.5,\ty2_0_a,\tdmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0\t= umTm1_0;\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0 \t= umT2_0;\n\tumT2_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT3_1\t= dmT2_1;\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= dmTm1_1;\n\tdmTm1_1\t= y2_0;\n\n\treturn dcblock(y0_0);\n}\n\n// fixed 4x quasi oversampling (hermite6)\nadHc2_4x_6POINT(XIN, thresh=1)\n{\t// up 2\n\tHistory\tumTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory\tdmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= hermite_sixpoint_interp(0.5,\tumTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0\t= umT2_0 + 0;\n\n\t// process 4x\n\ty1_0\t= adHc2_2x_6POINT(x1_0, thresh=thresh);\n\ty2_0\t= adHc2_2x_6POINT(x2_0, thresh=thresh);\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= hermite_sixpoint_interp(0.5,\ty2_0_a,\tdmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0\t= umTm1_0;\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0 \t= umT2_0;\n\tumT2_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT3_1\t= dmT2_1;\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= dmTm1_1;\n\tdmTm1_1\t= y2_0;\n\n\treturn dcblock(y0_0);\n}\n\r\n\r\n// do not use \"limit\"\r\nParam   limit(1, min=0.9, max=1.1);\r\nParam   aa(3, min=0, max=5);    // default Adaa 2nd order\r\naaxx    = int(aa);\r\n\nclipped = 0;\r\nif (aaxx == 1) {\r\n    clipped = adHc1_2x_6POINT(in1, thresh=limit);\r\n}\r\nelse if (aaxx == 2) {\r\n    clipped = adHc1_4x_6POINT(in1, thresh=limit);\r\n}\r\nelse if (aaxx == 3) {\r\n    clipped = adHc2(in1, limit=limit);\r\n}\r\nelse if (aaxx == 4) {\r\n    clipped = adHc2_2x_6POINT(in1, thresh=limit);\r\n}\r\nelse if (aaxx == 5) {\r\n    clipped = adHc2_4x_6POINT(in1, thresh=limit);\r\n}\r\nelse {\r\n    clipped = adHc1(in1, limit=limit);\r\n}\r\n\r\nout1    = clipped;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 824.0, 732.0 ]
                }
