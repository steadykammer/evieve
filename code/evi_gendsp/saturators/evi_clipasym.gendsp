                    "outlettype": [ "" ],
                    "patching_rect": [ 34.0, 19.0, 75.0, 22.0 ],
                    "text": "in 1 Audio In"
                }
            },
            {
                "box": {
                    "id": "obj-2",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 458.0, 19.0, 255.0, 22.0 ],
                    "text": "in 2 Asymmetry @min 0 @max 1 @default 0.5"
                }
            },
            {
                "box": {
                    "code": "\r\n// vaguely inspired by the nonlinear part of the K35 in the MS10\r\n// note, this isn't very good in terms of anti aliasing\r\n\r\nrequire(\"evi_smooth.genexpr\");\r\nrequire(\"evi_waveshaping.genexpr\");\r\n\r\n// asymetric\r\naTanhLxAS(x, a, s)\t\t\t\t\t\t\t// s = 0..1\r\n{\r\n\ttnhXa\t= 0;\r\n\tss\t\t= eviScurve(s);\r\n\tover\t= eviMap(s*s, 0, 1, 1.23, 3.000001);\r\n\tunder\t= eviMap(ss, 0, 1, 0.94, 0.333333);\r\n\tif (x > 0) {\r\n\t\ttnhXa\t= tanhLApprox(x / a * over);\r\n\t\ttnhXa\t= tnhXa * a * under;\r\n\t} else {\r\n\t\ttnhXa\t= tanhLApprox(x / a * under);\r\n\t\ttnhXa\t= tnhXa * a * over;\r\n\t}\r\n\treturn\tdcblock(tnhXa);\r\n}\r\n\r\n// fixed 3x quasi oversampling\naTanhLxAS3x(XIN, a, s)\n{\t// up 3\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 3\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\tHistory\tdmT2_2(0), dmT1_2(0), dmT0_2(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\tODT\t\t= 0.3333333333333333;\n\tTDT\t\t= 0.6666666666666667;\n\n\t// up 3x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= umT0_0 + 0;\n\tx2_0\t= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\tx3_0\t= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\n\t// process 3x\n\ty1_0\t= aTanhLxAS(x1_0, a, s);\n\ty2_0\t= aTanhLxAS(x2_0, a, s);\n\ty3_0\t= aTanhLxAS(x3_0, a, s);\n\n\t// down 3x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(TDT,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\ty3_0_a\t= y3_0 + 0;\n\ty3_1\t= interp(ODT,\ty3_0_a,\tdmT0_2, dmT1_2, dmT2_2, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1 + y3_1) * ODT;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\tdmT2_2\t= dmT1_2;\n\tdmT1_2\t= dmT0_2;\n\tdmT0_2\t= y3_0;\n\n\treturn dcblock(y0_0);\n}\r\n\r\n// fixed 9x quasi oversampling\naTanhLxAS9x(XIN, a, s)\n{\t// up 3\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 3\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\tHistory\tdmT2_2(0), dmT1_2(0), dmT0_2(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\tODT\t\t= 0.3333333333333333;\n\tTDT\t\t= 0.6666666666666667;\n\n\t// up 3x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= umT0_0 + 0;\n\tx2_0\t= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\tx3_0\t= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\n\t// process 3x\n\ty1_0\t= aTanhLxAS3x(x1_0, a, s);\n\ty2_0\t= aTanhLxAS3x(x2_0, a, s);\n\ty3_0\t= aTanhLxAS3x(x3_0, a, s);\n\n\t// down 3x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(TDT,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\ty3_0_a\t= y3_0 + 0;\n\ty3_1\t= interp(ODT,\ty3_0_a,\tdmT0_2, dmT1_2, dmT2_2, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1 + y3_1) * ODT;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\tdmT2_2\t= dmT1_2;\n\tdmT1_2\t= dmT0_2;\n\tdmT0_2\t= y3_0;\n\n\treturn dcblock(y0_0);\n}\n\r\n// asymetric\r\nthbxAS(x, a, s)\t\t\t\t\t\t\t// s = 0..1\r\n{\r\n\tdnlXa\t= 0;\r\n\tss\t\t= eviScurve(s);\r\n\tover\t= eviMap(s*s, 0, 1, 1.23, 3.000001);\r\n\tunder\t= eviMap(ss, 0, 1, 0.94, 0.333333);\r\n\tif (x > 0) {\r\n\t\tdnlXa\t= thbNL(x / a * over);\r\n\t\tdnlXa\t= dnlXa * a * under;\r\n\t} else {\r\n\t\tdnlXa\t= thbNL(x / a * under);\r\n\t\tdnlXa\t= dnlXa * a * over;\r\n\t}\r\n\treturn\tdcblock(dnlXa);\r\n}\r\n\n// fixed 3x quasi oversampling\nthbxAS3x(XIN, a, s)\n{\t// up 3\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 3\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\tHistory\tdmT2_2(0), dmT1_2(0), dmT0_2(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\tODT\t\t= 0.3333333333333333;\n\tTDT\t\t= 0.6666666666666667;\n\n\t// up 3x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= umT0_0 + 0;\n\tx2_0\t= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\tx3_0\t= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\n\t// process 3x\n\ty1_0\t= thbxAS(x1_0, a, s);\n\ty2_0\t= thbxAS(x2_0, a, s);\n\ty3_0\t= thbxAS(x3_0, a, s);\n\n\t// down 3x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(TDT,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\ty3_0_a\t= y3_0 + 0;\n\ty3_1\t= interp(ODT,\ty3_0_a,\tdmT0_2, dmT1_2, dmT2_2, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1 + y3_1) * ODT;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\tdmT2_2\t= dmT1_2;\n\tdmT1_2\t= dmT0_2;\n\tdmT0_2\t= y3_0;\n\n\treturn dcblock(y0_0);\n}\n\r\n// fixed 9x quasi oversampling\nthbxAS3x9x(XIN, a, s)\n{\t// up 3\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 3\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\tHistory\tdmT2_2(0), dmT1_2(0), dmT0_2(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\tODT\t\t= 0.3333333333333333;\n\tTDT\t\t= 0.6666666666666667;\n\n\t// up 3x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= umT0_0 + 0;\n\tx2_0\t= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\tx3_0\t= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\n\t// process 3x\n\ty1_0\t= thbxAS3x(x1_0, a, s);\n\ty2_0\t= thbxAS3x(x2_0, a, s);\n\ty3_0\t= thbxAS3x(x3_0, a, s);\n\n\t// down 3x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(TDT,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\ty3_0_a\t= y3_0 + 0;\n\ty3_1\t= interp(ODT,\ty3_0_a,\tdmT0_2, dmT1_2, dmT2_2, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1 + y3_1) * ODT;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\tdmT2_2\t= dmT1_2;\n\tdmT1_2\t= dmT0_2;\n\tdmT0_2\t= y3_0;\n\n\treturn dcblock(y0_0);\n}\r\n\r\nParam\tsmooth(22.666, min=0, max=226.66);\t    // in ms\r\nParam   bounds(1, min=0, max=1);                // 0 = full range, 1 = stay in bounds\r\nParam\tnonlin(0, min=0, max=1);\t\t\t\t// 0 = cubic, 1 = tanh\r\nn\t\t= int(nonlin);\r\nb       = int(bounds);\r\n\r\ns\t\t= (in2 * in2 * in2 * 0.5) + 0.5;\t    // in2 = 0..1\r\na\t\t= (sqrt(1 - s) * 3.73) + 0.251189;\t\t// -12..12 dB\r\nm\t\t= ((s * s * s) + 0.995262) - 0.120262;\t// max +6dB\r\n\r\n// turn off if using audio rate modulation on in2\r\nif (smooth > 0) {\r\n\ta, s\t= expsmoothBank2(a, s, smooth*0.001);\r\n\tm\t\t= eviLine(m, mstosamps(smooth));\r\n}\r\n\r\nasym = 0;\r\nif (n) {\r\n\tasym\t= aTanhLxAS9x(in1, a, s) * m;\r\n} else {\r\n    // more korg-ish sound\r\n\tasym\t= thbxAS3x9x(in1, a, s) * m;\r\n}\r\n\r\nout1 = asym * (b ? sqrt1_2 : 1);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 34.0, 58.0, 678.0, 785.0 ]
                }
