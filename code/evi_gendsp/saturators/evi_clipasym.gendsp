, 			{
				"box" : 				{
					"code" : "\r\n// vaguely inspired by the nonlinear part of the K35 in the MS10\r\n\r\n\r\neviScurve(segment)\t\t\t\t\t\t\t// segment must be linear ramp 0..1\n{\n\ts2\t\t= segment * segment;\n\trec\t\t= 1 - segment;\n\tr2\t\t= rec * rec;\n\treturn\t(segment < 0.5) ? (s2 * 2) : (1 - (r2 * 2));\n}\n\n// basic linear scaling like linear part of [scale]\neviMap(valueIn, inLow, inHigh, outLow, outHigh)\n{\n\tmultiplier = (outLow - outHigh) / (inLow - inHigh);\n\treturn (valueIn - inLow) * multiplier + outLow;\n}\n\r\neviLine(target, duration)\t\t\t\t\t// target, duration in samples\n{\n\tHistory\tvalue(0);\n\ttrigger\t= change(target);\n\tramp\t= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);\n\tline\t= eviMap(ramp, 0, 1, latch(value, trigger), latch(target, trigger));\n\tvalue\t= line;\n\treturn\tline, (ramp == 1);\n}\n\neviSline(target, duration)\t\t\t\t\t// target, duration in samples\n{\n\tHistory\tvalue(0);\n\ttrigger\t= change(target);\n\tramp\t= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);\n\tcramp\t= eviScurve(ramp);\n\tcurve\t= eviMap(cramp, 0, 1, latch(value, trigger), latch(target, trigger));\n\tvalue\t= curve;\n\treturn\tcurve, (ramp == 1);\n}\r\n\r\nexpA(x0)\t\t\t\t\t\t\t\t\t// (more accurate than 'fastexp()')\n{\n\tx = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;\n\tx *= x; x *= x; x *= x; x *= x; x *= x;\n\treturn x;\n}\n\ntauA(t)\n{\n\ty = expA(-1 / (t * samplerate));\n\treturn y + 0.000128;\n}\n\r\nexpso(x, z)\t\t\t\t\t\t\t\t\t// z is pole\n{\n\tHistory w(0);\n\ty = (z * w) + (x * (1 - z));\n\tw = y;\n\treturn y;\n}\r\n\r\nexpsmooth(x, t)\t\t\t\t\t\t\t\t// t is smooth time in seconds\n{\n\tHistory w(0);\n\tz = tauA(t);\n\ty = (z * w) + (x * (1 - z));\n\tw = y;\n\treturn y;\n}\r\n\nexpsmoothBank2(x1, x2, t)\n{\n\tHistory\texps2dummy(0);\n\tz\t\t= tauA(t);\n\ty1\t\t= expso(x1, z);\n\ty2\t\t= expso(x2, z);\n\treturn\ty1, y2;\n}\r\n\r\n// tanh() approx\r\ntnhL(x)\n{\n\tx2\t=\tx * x;\n\ta\t= (((x2 + 378) * x2 + 17325) * x2 + 135135) * x;\n\tb\t= ((28 * x2 + 3150) * x2 + 62370) * x2 + 135135;\n\treturn\tclamp((a / b), -1, 1);\n}\n\r\naTnhLxA(x, a)\t\t\t\t\t\t\t\t// a = 1..4\r\n{\r\n\ttnhXa\t= tnhL(x / a);\r\n\treturn\t(tnhXa * a), tnhXa;\r\n}\r\n\r\n// asymetric\r\naTnhLxAS(x, a, s)\t\t\t\t\t\t\t// s = 0..1\r\n{\r\n\ttnhXa\t= 0;\r\n\tss\t\t= eviScurve(s);\r\n\tover\t= eviMap(s*s, 0, 1, 1.23, 3.000001);\r\n\tunder\t= eviMap(ss, 0, 1, 0.94, 0.333333);\r\n\tif (x > 0) {\r\n\t\ttnhXa\t= tnhL(x / a * over);\r\n\t\ttnhXa\t= tnhXa * a * under;\r\n\t} else {\r\n\t\ttnhXa\t= tnhL(x / a * under);\r\n\t\ttnhXa\t= tnhXa * a * over;\r\n\t}\r\n\treturn\tdcblock(tnhXa);\r\n}\r\n\r\n// fixed 3x oversampling, plus voodoo for GenExpr\naTnhLxAS3x(XIN, a, s)\n{\t// up 3\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 3\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\tHistory\tdmT2_2(0), dmT1_2(0), dmT0_2(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\tODT\t\t= 0.3333333333333333;\n\tTDT\t\t= 0.6666666666666667;\n\n\t// up 3x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= umT0_0 + 0;\n\tx2_0\t= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\tx3_0\t= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\n\t// process 3x\n\ty1_0\t= aTnhLxAS(x1_0, a, s);\n\ty2_0\t= aTnhLxAS(x2_0, a, s);\n\ty3_0\t= aTnhLxAS(x3_0, a, s);\n\n\t// down 3x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(TDT,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\ty3_0_a\t= y3_0 + 0;\n\ty3_1\t= interp(ODT,\ty3_0_a,\tdmT0_2, dmT1_2, dmT2_2, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1 + y3_1) * ODT;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\tdmT2_2\t= dmT1_2;\n\tdmT1_2\t= dmT0_2;\n\tdmT0_2\t= y3_0;\n\n\treturn dcblock(y0_0);\n}\r\n\r\n// fixed 9x oversampling, plus voodoo for GenExpr\naTnhLxAS9x(XIN, a, s)\n{\t// up 3\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 3\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\tHistory\tdmT2_2(0), dmT1_2(0), dmT0_2(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\tODT\t\t= 0.3333333333333333;\n\tTDT\t\t= 0.6666666666666667;\n\n\t// up 3x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= umT0_0 + 0;\n\tx2_0\t= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\tx3_0\t= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\n\t// process 3x\n\ty1_0\t= aTnhLxAS3x(x1_0, a, s);\n\ty2_0\t= aTnhLxAS3x(x2_0, a, s);\n\ty3_0\t= aTnhLxAS3x(x3_0, a, s);\n\n\t// down 3x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(TDT,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\ty3_0_a\t= y3_0 + 0;\n\ty3_1\t= interp(ODT,\ty3_0_a,\tdmT0_2, dmT1_2, dmT2_2, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1 + y3_1) * ODT;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\tdmT2_2\t= dmT1_2;\n\tdmT1_2\t= dmT0_2;\n\tdmT0_2\t= y3_0;\n\n\treturn dcblock(y0_0);\n}\r\n\r\n// cubic approx\ndnl(x0)\n{\n\tx1\t= clip(x0, -1, 1);\n\tnx\t= 0.55032120814910446 * x1;\t\t// transfer function * clamped input\n\tnx3 = nx * nx * nx;\n\treturn\tx1 - (nx3 + nx3);\n}\n\r\ndnlxA(x, a)\t\t\t\t\t\t\t\t// a = 1..4\r\n{\r\n\tdnlXa\t= dnl(x / a);\r\n\treturn\t(dnlXa * a), dnlXa;\r\n}\r\n\r\n// asymetric\r\ndnlxAS(x, a, s)\t\t\t\t\t\t\t// s = 0..1\r\n{\r\n\tdnlXa\t= 0;\r\n\tss\t\t= eviScurve(s);\r\n\tover\t= eviMap(s*s, 0, 1, 1.23, 3.000001);\r\n\tunder\t= eviMap(ss, 0, 1, 0.94, 0.333333);\r\n\tif (x > 0) {\r\n\t\tdnlXa\t= dnl(x / a * over);\r\n\t\tdnlXa\t= dnlXa * a * under;\r\n\t} else {\r\n\t\tdnlXa\t= dnl(x / a * under);\r\n\t\tdnlXa\t= dnlXa * a * over;\r\n\t}\r\n\treturn\tdcblock(dnlXa);\r\n}\r\n\n// fixed 3x oversampling, plus voodoo for GenExpr\ndnlxAS3x(XIN, a, s)\n{\t// up 3\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 3\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\tHistory\tdmT2_2(0), dmT1_2(0), dmT0_2(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\tODT\t\t= 0.3333333333333333;\n\tTDT\t\t= 0.6666666666666667;\n\n\t// up 3x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= umT0_0 + 0;\n\tx2_0\t= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\tx3_0\t= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\n\t// process 3x\n\ty1_0\t= dnlxAS(x1_0, a, s);\n\ty2_0\t= dnlxAS(x2_0, a, s);\n\ty3_0\t= dnlxAS(x3_0, a, s);\n\n\t// down 3x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(TDT,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\ty3_0_a\t= y3_0 + 0;\n\ty3_1\t= interp(ODT,\ty3_0_a,\tdmT0_2, dmT1_2, dmT2_2, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1 + y3_1) * ODT;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\tdmT2_2\t= dmT1_2;\n\tdmT1_2\t= dmT0_2;\n\tdmT0_2\t= y3_0;\n\n\treturn dcblock(y0_0);\n}\n\r\n// fixed 9x oversampling, plus voodoo for GenExpr\ndnlxAS3x9x(XIN, a, s)\n{\t// up 3\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 3\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\tHistory\tdmT2_2(0), dmT1_2(0), dmT0_2(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\tODT\t\t= 0.3333333333333333;\n\tTDT\t\t= 0.6666666666666667;\n\n\t// up 3x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= umT0_0 + 0;\n\tx2_0\t= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\tx3_0\t= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\n\t// process 3x\n\ty1_0\t= dnlxAS3x(x1_0, a, s);\n\ty2_0\t= dnlxAS3x(x2_0, a, s);\n\ty3_0\t= dnlxAS3x(x3_0, a, s);\n\n\t// down 3x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(TDT,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\ty3_0_a\t= y3_0 + 0;\n\ty3_1\t= interp(ODT,\ty3_0_a,\tdmT0_2, dmT1_2, dmT2_2, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1 + y3_1) * ODT;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\tdmT2_2\t= dmT1_2;\n\tdmT1_2\t= dmT0_2;\n\tdmT0_2\t= y3_0;\n\n\treturn dcblock(y0_0);\n}\r\n\r\nParam\tsmooth(0.022666, min=0, max=0.22666);\t// in seconds, sorry\r\nParam\tnonlin(0, min=0, max=1);\t\t\t\t// 0 = cubic, 1 = tanh\r\nn\t\t= int(nonlin);\r\n\r\ns\t\t= (in2 * 0.5) + 0.5;\t\t\t\t\t// in2 = 0..1\r\na\t\t= (sqrt(1 - s) * 3.73) + 0.251189;\t\t// -12..12 dB\r\nm\t\t= ((s * s * s) + 0.995262) - 0.120262;\t// max +6dB\r\n\r\n// turn off if using audio rate modulation on in2\r\nif (smooth > 0) {\r\n\ta, s\t= expsmoothBank2(a, s, smooth);\r\n\tm\t\t= eviLine(m, smooth*samplerate);\r\n}\r\n\r\nif (n) {\r\n\tout1\t= aTnhLxAS9x(in1, a, s) * m;\r\n} else {\r\n\tout1\t= dnlxAS3x9x(in1, a, s) * m;\r\n}\r\n\r\n",
