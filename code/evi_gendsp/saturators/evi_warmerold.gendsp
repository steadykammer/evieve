        "integercoordinates": 1,
        "boxes": [
            {
                "box": {
                    "code": "/*\n\tI made this for Andreas Wetterberg in 2013\r\n\tI updated it in 2021\r\n\tIt is based on a Tom Szilagyi idea\r\n*/\r\n\nexpA(x0)\t\t\t\t\t\t\t// more accurate than 'fastexp()'\n{\n\tx = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;\n\tx *= x; x *= x; x *= x; x *= x; x *= x;\n\treturn x;\n}\n\ntauA(t)\n{\n\ty = expA(-1 / (t * samplerate));\n\treturn y + 0.000128;\n}\n\ndbtoaApprox(db)\n{\n\tdbtoaA = expA(0.11512925464970 * db);\n\treturn dbtoaA + 0.000128;\t\t// + offset = 0 dB == 1 amplitude\n}\n\r\ntnA2(x)\t\t\t\t\t\t\t\t// approx tan(0..halfpi)\n{\n\ta\t= ((((x * -0.0896638) + 0.0388452) * x) + 1.00005) * x;\r\n\tb\t= (((x * -0.430871) + 0.0404318) * x) + 1;\r\n\treturn\ta / b;\r\n}\r\n\nfWarp(cf)\r\n{\n\tf = (cf * (pi / samplerate)) * (1 / twopi);\n\tw = (f - trunc(f)) * twopi;\n\treturn tnA2(w);\t\t\t\t\t// tan approximation (G for butterworth)\n}\n\r\neviScurve(segment)\t\t\t\t\t// segment must be linear ramp 0..1\n{\n\ts2\t\t= segment * segment;\n\trec\t\t= 1 - segment;\n\tr2\t\t= rec * rec;\n\treturn\t(segment < 0.5) ? (s2 * 2) : (1 - (r2 * 2));\n}\n\n// basic linear scaling like linear part of [scale]\neviMap(valueIn, inLow, inHigh, outLow, outHigh)\n{\n\tmultiplier = (outLow - outHigh) / (inLow - inHigh);\n\treturn (valueIn - inLow) * multiplier + outLow;\n}\n\neviLine(target, duration)\t\t\t// target, duration in samples\n{\n\tHistory\tvalue(0);\n\ttrigger\t= change(target);\n\tramp\t= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);\n\tline\t= eviMap(ramp, 0, 1, latch(value, trigger), latch(target, trigger));\n\tvalue\t= line;\n\treturn\tline, (ramp == 1);\n}\n\neviSline(target, duration)\t\t\t// target, duration in samples\n{\n\tHistory\tvalue(0);\n\ttrigger\t= change(target);\n\tramp\t= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);\n\tcramp\t= eviScurve(ramp);\n\tcurve\t= eviMap(cramp, 0, 1, latch(value, trigger), latch(target, trigger));\n\tvalue\t= curve;\n\treturn\tcurve, (ramp == 1);\n}\n\nexpso(x, z)\t\t\t\t\t\t\t// z is pole\n{\n\tHistory w(0);\n\ty = (z * w) + (x * (1 - z));\n\tw = y;\n\treturn y;\n}\n\nexpsmooth(x, t)\t\t\t\t\t\t// t is smooth time in seconds\n{\n\tHistory w(0);\n\tz = tauA(t);\n\ty = (z * w) + (x * (1 - z));\n\tw = y;\n\treturn y;\n}\n\nexpsmoothBank2(x1, x2, t)\n{\n\tHistory\texps2dummy(0);\n\tz\t\t= tauA(t);\n\ty1\t\t= expso(x1, z);\n\ty2\t\t= expso(x2, z);\n\treturn\ty1, y2;\n}\n\nlogsmooth(x, s)\t\t\t\t\t\t// s = time to drop 6dB (in seconds)\n{\n\tHistory z(0);\n//\tad = LN2 / maximum((s * samplerate), 1);\n\tad = LN2 / (s * samplerate);\n\ty  = ((x - z) * ad) + z;\n\tz  = y;\n\treturn y;\n}\n\r\nD(x)\r\n{\r\n\treturn sqrt(x * sign(x));\r\n}\r\n\r\nszilagyi(drive, blend, sr)\t// sr = samplerate\r\n{\r\n\tsr01 = sr * 0.1;\n\tsrct = sr01 / (sr01 + 1);\n\r\n\trdrive = 12 / drive;\r\n\trdrive2 = rdrive * rdrive;\r\n\trd22 = rdrive2 + rdrive2;\n\trbdr = rdrive / (10.5 - blend) * 23.636364;\r\n\trbdr2 = rbdr * rbdr;\r\n\r\n\tkp0 = D(rd22 - 1);\n\tkpa = kp0 + 1;\n\tkpb = (2 - kpa) * 0.5;\n\r\n\tap = (rdrive2 - kpa + 1) * 0.5;\n\tkc = kpa / D(kp0 + kp0 - rd22);\n\tkc2 = kc * kc;\r\n\tsq = kc2 + 1;\r\n\tdsq = D(sq);\r\n\r\n\tkdm = rbdr / dsq;\n\tknb = -(kdm);\n\tkna = (kc + kc) * kdm;\n\r\n\tan = rbdr2 / sq;\r\n\timr = (knb + knb) + D(kna + kna + an + an + an + an - 1);\n\tpwrq = 2 / (imr + 1);\n\r\n\treturn srct, ap, kpa, kpb, an, kna, knb, pwrq;\r\n}\r\n\r\nsaturate(x, l, h)\r\n{\r\n\tx = clip(x, l, h);\r\n\treturn 0.5 * x * (3 - (x * x));\r\n}\r\n\r\n// fixed 3x oversampling, plus voodoo for GenExpr\nsaturate3x(XIN, l, h)\n{\t// up 3\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 3\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\tHistory\tdmT2_2(0), dmT1_2(0), dmT0_2(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\tODT\t\t= 0.3333333333333333;\n\tTDT\t\t= 0.6666666666666667;\n\n\t// up 3x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= umT0_0 + 0;\n\tx2_0\t= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\tx3_0\t= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\n\t// process 3x\n\ty1_0\t= saturate(x1_0, l, h);\n\ty2_0\t= saturate(x2_0, l, h);\n\ty3_0\t= saturate(x3_0, l, h);\n\n\t// down 3x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(TDT,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\ty3_0_a\t= y3_0 + 0;\n\ty3_1\t= interp(ODT,\ty3_0_a,\tdmT0_2, dmT1_2, dmT2_2, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1 + y3_1) * ODT;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\tdmT2_2\t= dmT1_2;\n\tdmT1_2\t= dmT0_2;\n\tdmT0_2\t= y3_0;\n\n\treturn dcblock(y0_0);\n}\r\n\r\n// fixed 9x oversampling, plus voodoo for GenExpr\nsaturate9x(XIN, l, h)\n{\t// up 3\n\tHistory\tumTm1_0(0), umT0_0(0), umT1_0(0);\n\t// down 3\n\tHistory\tdmT2_1(0), dmT1_1(0), dmT0_1(0);\n\tHistory\tdmT2_2(0), dmT1_2(0), dmT0_2(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\tODT\t\t= 0.3333333333333333;\n\tTDT\t\t= 0.6666666666666667;\n\n\t// up 3x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= umT0_0 + 0;\n\tx2_0\t= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\tx3_0\t= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode=\"spline\");\n\n\t// process 3x\n\ty1_0\t= saturate3x(x1_0, l, h);\n\ty2_0\t= saturate3x(x2_0, l, h);\n\ty3_0\t= saturate3x(x3_0, l, h);\n\n\t// down 3x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= interp(TDT,\ty2_0_a,\tdmT0_1, dmT1_1, dmT2_1, mode=\"spline\");\n\ty3_0_a\t= y3_0 + 0;\n\ty3_1\t= interp(ODT,\ty3_0_a,\tdmT0_2, dmT1_2, dmT2_2, mode=\"spline\");\n\n\ty0_0\t= (doX0 + y2_1 + y3_1) * ODT;\n\n\t// update\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= y2_0;\n\n\tdmT2_2\t= dmT1_2;\n\tdmT1_2\t= dmT0_2;\n\tdmT0_2\t= y3_0;\n\n\treturn dcblock(y0_0);\n}\r\n\r\nboost(x, s, m, g)\r\n{\r\n\tHistory c1(0);\r\n\r\n\tc0 = (x + (c1 * s)) * (1 / (s + 1));\r\n\r\n\tgn = clip(g, 0.9886, 2.818383);\r\n\ty = saturate9x((x + (c0 * m)) * g, -gn, gn*0.9886);\r\n\r\n\tc1 = c0;\r\n\treturn dcblock(y);\r\n}\n\r\nlp1p(x, g)\t\t\t\t\t\t\t\t// 1-pole zdf section\r\n{\r\n\tHistory p(0);\r\n\tc = (x - p) * (g / (g + 1));\r\n\ty = c + p;\r\n\tp = c + y;\r\n\treturn y;\r\n}\r\n\r\nlp2p(x, g, r)\t\t\t\t\t\t\t// 2-pole zdf section\r\n{\r\n\tHistory p0(0), p1(0);\r\n\tc0 = r + g;\r\n\tc1 = (g / ((c0 * g) + 1)) * (x - (p1 + (p0 * c0)));\r\n\tc2 = c1 + p0;\r\n\tc3 = c2 * g;\r\n\ty  = c3 + p1;\r\n\tp0 = c1 + c2;\r\n\tp1 = c3 + y;\r\n\treturn y;\r\n}\r\n\r\n\r\n\tParam order(3, min=0, max=8);\r\n\tParam cutoff(samplerate*0.125, min=samplerate*0.00125, max=samplerate*0.25);\r\n\tHistory med(0), prevmed(0), prevout(0);\r\n\t// turn off (0) if doing audio rate modulation of drive & blend\r\n\tParam smooth(0.030111, min=0, max=0.30111);// in seconds\r\n\t\r\n\tParam ingain(1, min=-48, max=48);\r\n\tParam outgain(-1, min=-24, max=24);\r\n\t\r\n\tParam drive(2, min=0, max=10);\r\n\tParam blend(-2, min=-10, max=10);\r\n\r\n\tParam bassslope(0.23228, min=0, max=1);\r\n\tParam bassmix(0.333333, min=0, max=1);\r\n\tParam bassgain(-1, min=-12, max=12);\t// fold\r\n\tParam bassboost(0, min=0, max=1);\t\t// 0=soft, 1=hard\r\n\tbb = int(bassboost);\r\n\tss = smooth > 0;\r\n\tord = int(order);\r\n\r\n\tbs = bassslope * 254 + 3;\r\n\tbg = dbtoaApprox(bassgain);\r\n\tingn = dbtoaApprox(ingain);\r\n\toutgn = dbtoaApprox(outgain);\r\n\r\n\tdrve = (drive * 0.99) + 0.1;\r\n\tblnd = blend;\r\n\tif (ss) {\r\n\t\tdrve = logsmooth(drve, smooth);\r\n\t\tblnd = eviLine(blnd, vectorsize + vectorsize);\r\n\t}\r\n\r\n\t// sadly this has to be audio rate because of zero crossings etc\r\n\tsrct, ap, kpa, kpb, an, kna, knb, pwrq = szilagyi(drve, blnd, samplerate);\r\n\r\n\tbbev = eviSline(bb, (smooth + 0.1) * samplerate);\r\n\txinput = in1 * (1 - bbev);\r\n\tif (bbev > 0) {\r\n\t\ts, g = expsmoothBank2(bs, bg, 0.015222);\r\n\t\tm = eviLine(bassmix, vectorsize + vectorsize + vectorsize);\r\n\t\txinput = boost((in1 * bbev), s, m, g);\r\n\t}\r\n\r\n\ting, outg = expsmoothBank2(ingn, outgn, 0.022666);\r\n\r\n\txin = xinput * ing;\r\n\tmed = 0;\r\n\tif (xin > 0) {\r\n\t\tmed = (D(ap + xin * (kpa - xin)) + kpb) * pwrq;\r\n\t} else {\r\n\t\tmed = -((D(an - xin * (kna + xin)) + knb) * pwrq);\r\n\t}\r\n\r\n\ty = maximum((srct * (med - prevmed + prevout)), -1);\n\tX = dcblock(saturate9x(y * outg, -0.9886, 1)) * sqrt1_2;\n\r\n\r\nG = 0;\r\nY = 0;\r\n// linear Butterworth\r\nif (ord > 0) {\r\n\tCF\t= logsmooth(cutoff, smooth);\r\n\tG\t= fWarp(CF);\t\t\t\t\t\t// get G coefficient if not bypassed\r\n\tif\t\t\t(ord == 1) {\r\n\t\tY\t= lp1p(X,\tG);\r\n\t} else if\t(ord == 2) {\r\n\t\tY\t= lp2p(X,\tG, 1.4142135623730951);\r\n\t} else if\t(ord == 4) {\r\n\t\ty0\t= lp2p(X,\tG, 0.7653668647301797);\r\n\t\tY\t= lp2p(y0,\tG, 1.8477590650225735);\r\n\t} else if\t(ord == 5) {\r\n\t\ty0\t= lp2p(X,\tG, 0.6180339887498949);\r\n\t\ty1\t= lp2p(y0,\tG, 1.618033988749895);\r\n\t\tY\t= lp1p(y1,\tG);\r\n\t} else if\t(ord == 6) {\r\n\t\ty0\t= lp2p(X,\tG, 0.5176380902050419);\r\n\t\ty1\t= lp2p(y0,\tG, 1.4142135623730951);\r\n\t\tY\t= lp2p(y1,\tG, 1.9318516525781366);\r\n\t} else if\t(ord == 7) {\r\n\t\ty0\t= lp2p(X,\tG, 0.4450418679126289);\r\n\t\ty1\t= lp2p(y0,\tG, 1.2469796037174672);\r\n\t\ty2\t= lp2p(y1,\tG, 1.8019377358048383);\r\n\t\tY\t= lp1p(y2,\tG);\r\n\t} else if\t(ord == 8) {\r\n\t\ty0\t= lp2p(X,\tG, 0.39018064403225666);\r\n\t\ty1\t= lp2p(y0,\tG, 1.1111404660392046);\r\n\t\ty2\t= lp2p(y1,\tG, 1.6629392246050905);\r\n\t\tY\t= lp2p(y2,\tG, 1.9615705608064609);\r\n\t} else {//\t(ord == 3)\t\t\t\t\t// default\r\n\t\ty0\t= lp2p(X,\tG, 1.0000000000000002);\r\n\t\tY\t= lp1p(y0,\tG);\r\n\t}\r\n\r\n} else {\t//\t(ord == 0)\t\t\t\t\t// bypassed\r\n\tG\t= 0.414226;\r\n\tY\t= X;\r\n}\r\n\r\n\r\n\tout1 = Y;\n\r\n\tprevmed = fixdenorm(med);\n\tprevout = fixdenorm(y);\n\r\n",
                    "fontface": 0,
