, 			{
				"box" : 				{
					"code" : "\r\n// -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n// A mono-in, stereo-out reverb implementation by Juhana Sadeharju (kouhia@nic.funet.fi)\r\n// Originally Max/MSP-ified by Olaf Matthes (2004)\r\n// Version 1.0test5, (c) 1999-2006 Juhana Sadeharju / Olaf Matthes\r\n// Originally Gen-ified by Graham Wakefield (2011)\r\n// 64-bit MSP reference version by Volker Böhm (2016)\r\n\r\n// This GenExpr version by Pete for evieve, with various modifications \r\n// and filter improvements and parameter smoothing etc (2016)\r\n\r\n// N.B. - there are slight differences in sound from the various Max versions,\r\n// but this version is closer to the original (Sadeharju) and with slightly\r\n// more diffuseness in the early taps and low-mid\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\tfunctions (library)\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\nrequire(\"evi_reverb_library.genexpr\");\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\tparams (reverb)\t\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n// original Olaf Matthes comments in \"quotes\" underneath each Param declaration\r\n// defaults are roughly Olaf Matthes 'church' preset\r\n\r\n// pre-warped frequency - scaling & filter are different in this version to original\r\n// 'bandwidth' 1 - (g / (1 + g)) 0..1\r\n// & new system over originals, amount of bandwidth attenuation:\r\n// high or how pass if k == 1, bypass if k == 0, else low or high shelf attenuation\r\n// [ k ] % 0..1 (1 - attenuation)\r\nParam\tbandwidth(0.69, min=0, max=1);\r\n// \"This is like a damping control for the input, it has a similar effect to the damping\r\n// control, but is subtly different.\" <<-- bit of a strange comment\r\n//\r\n\r\n// pre-warped frequency - scaling & filters are different in this version to original\r\n// 'damping' 1 - (g / (1 + g)) 0..1\r\n// & new system over originals, amount of damping attenuation:\r\n// high or how pass if k == 1, bypass if k == 0, else low or high shelf attenuation\r\n// [ k ] % 0..1 (attenuation ++)\r\nParam\tdamping(0.41, min=0, max=1);\r\n// \"This controls the high frequency damping (a lowpass filter), values near 0 will\r\n// make it sound very bright, values near 1 will make it sound very dark.\"\r\n//\r\n\r\n// 'roomsize' in meters\r\nParam\tsize(80, min=0.1, max=300);\t// min=1 ?\r\n// \"The size of the room, in meters. Excessivly large, and excessivly small values will\r\n// make it sound a bit unrealistic. Values of around 30 sound good.\"\r\n//\r\n\r\n// 'revtime' (feeds rt60) in seconds\r\nParam\tdecay(4.85, min=0.1, max=360);\r\n// \"Reverb decay time, in seconds. 7 is a good place to start. 0.1 - 360 seconds!\"\r\n//\r\n\r\n// in Juhana Sadeharju & Graham Wakefield verion, not available (fixed)\r\n// in Olaf Matthes version, object creation argument only:\r\n//\r\n// offsets L/R levels, could be in degrees but 0..1 here\r\n// L/R width % 0..1\r\nParam\tspread(0.22, min=0, max=1);\r\n// \"Second argument is stereo spreading (0 - 1) which defaults to 0.15\"\r\n//\r\n\r\n// early refelections level in dB\r\nParam\tearly(-9, min=-90, max=0);\r\n// \"The quantity of early reflections (scatter reflections directly from the source).\r\n// Think of Lexicon's ambiance patches.\"\r\n//\r\n\r\n// 'tail' level in dB\r\nParam\tlate(-11, min=-90, max=0);\r\n// \"The level of the classic reverb tail reflections.\"\r\n//\r\n\r\n// dry level in dB\r\nParam\tdry(-3, min=-90, max=0);\r\n// \"The level of the unreverberated signal.\"\r\n//\r\n\r\n// toggle, 1=bypassed, quasi cpu saving\r\nParam\tbypass(0, min=0, max=1);\r\n// \"Bypass, signal uneffected when set to 1. Can be used to compare reverb signal with\r\n// original signal and to save CPU power when gigaverb~ is not used.\"\r\n//\r\n\r\n// !! TODO !! (need to rewite all Delays as Data/poke/sample systems with 'clear' as for-loop)\r\n//\r\n// this may or may not work, we will see...\r\nHistory\tclear(0);\r\n// \"Clear the delay lines after a DSP overblow, or to get rid of any remaining delay tails.\"\r\n//\r\n\r\n// this is essentially a mono-in stereo-out reverb, but you can toggle 'stereo' 'on' ('1')\r\n// to explicitly control L/R signals into late diffusion section (and dry L/R),\r\n// default '0' 'off' (mono-in, stereo-out)\r\n// !! no smoothing !!\r\nParam\tstereo(0, min=0, max=2);\r\n\r\n\r\n// -- -- -- -- -- --\tparams (eq)\t(compute coefficients externally)\t-- -- -- -- -- -- \\\\\r\n\r\n// pre-warped frequency (g / (1 + g)) (defaults 2000Hz & 500Hz @48kHz)\r\nParam\thighshelfG(0.123758, min=0, max=1);\r\nParam\tlowshelfG(0.032214, min=0, max=1);\r\n// -3=shelfboost..0=bypass..shelf..1=pass\r\nParam\thighshelfK(0, min=-3, max=1);\r\nParam\tlowshelfK(0, min=-3, max=1);\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\t\t\tdeclare\t\t\t-- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\nHistory\txL(0), xR(0);\t\t\t\t\t\t\t\t\t\t\t// compensate\r\n\r\n// four early taps + minimum 5 samples offset\r\nDelay\tearlyTaps\t(\t0.361776*samplerate+5,\t4,\tfeedback=0\t);\r\n\r\n// FDN\r\nDelay\tfdnDelay1\t(\t0.882359*samplerate,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay2\t(\t0.720443*samplerate,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay3\t(\t0.623927*samplerate,\t1,\tfeedback=1\t);\r\nDelay\tfdnDelay4\t(\t0.558052*samplerate,\t1,\tfeedback=1\t);\r\n\r\n// constants, not user\r\nParam\tdiv340\t\t(\t0.0029411764705882,\t\tmin=  0, max=1);// / 340\r\nParam\tdiv1341\t\t(\t0.00074571215510813,\tmin=  0, max=1);// / 1341\r\nParam\tm3l10const\t(  -6.907755278982138,\t\tmin=-10, max=0);// -3 * log(10)\r\n\r\nParam\tsmoothtime\t( \t50,\tmin=1,\tmax=500\t\t);\t\t\t\t// parameter smoothing in ms\r\nsmoothsecs\t=\t\tsmoothtime * 0.001;\r\nsmoothsamps\t=\t\tsmoothsecs * samplerate;\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\tparse (param rate)\t-- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n// iStereo ('stereo' param): 0 = mono (L) input / \r\n// 1 = stereo (L/R) source / 2 = uncorrelated 2-channels\r\niStereo\t\t=  int(stereo);\r\nstereoMul\t= (iStereo == 2) ? sqrt1_2 : 0.5;\t\t\t\t\t// !! not smoothed !!\r\n\r\n// gains\r\nelgain\t\t= (early > -90) ? dbtoaApprox(early) : 0;\r\nltgain\t\t= (late > -90) ? dbtoaApprox(late) : 0;\r\ndygain\t\t= (dry > -90) ? dbtoaApprox(dry) : 0;\r\n\r\n// input bandwidth filter\r\nbwK\t\t\t= sqrt(1 - ((bandwidth * 0.999718) + 0.000282));\t// pete says: i have no  idea why\r\nbwG\t\t\t= 1 -  sqrt(bwK);\t\t\t\t\t\t\t\t\t// i did this or what is going on\r\n\r\n// damping filters\r\ndampK\t\t= sqrt(damping * 0.999718);\t\t\t\t\t\t\t// pete says: i have no  idea why\r\ndampG\t\t= 1 -  sqrt(dampK);\t\t\t\t\t\t\t\t\t// i did this or what is going on\r\n\r\nsizecoeff\t= size * samplerate * div340;\t\t\t\t\t\t// size * samplerate / 340\r\n//rt_60\t\t= pow(pow(10, -60 / 20), 1 / (decay * samplerate));\r\nrt_60\t\t= exp( m3l10const * ( 1 / ( decay * samplerate ) ) );\r\n\r\n// early times\r\n//pTime\t\t= round((sizecoeff * 0.110732,\tmode=\"trunc\");\t\t// Wakefield\r\neTTime1\t\t= int(floor(sizecoeff * 0.410 + 0.5) + 5);\r\neTTime2\t\t= int(floor(sizecoeff * 0.300 + 0.5) + 5);\r\neTTime3\t\t= int(floor(sizecoeff * 0.155 + 0.5) + 5);\r\neTTime4\t\t= int(5);\t\t\t\t\t\t\t\t// Sadeharju = * 0.000 = fixed 5 samples\r\n\r\n// early gains\r\neTGain1\t\t=  pow(rt_60,  eTTime1);\t\t\t\t// !! horrid !!\r\neTGain2\t\t=  pow(rt_60,  eTTime2);\r\neTGain3\t\t=  pow(rt_60,  eTTime3);\r\n//eTGain4\t=  pow(rt_60,  eTTime4);\t\t\t\t// ( eTTime4 fixed @ 5 samples )\r\neTGain4\t\t= (rt_60 * rt_60 * rt_60 * rt_60 * rt_60);\r\n\r\n// fdn times\t// pete not convinced by these\r\nfTime1\t\t=  int(floor(\tsizecoeff\t\t\t\t+ 0.5)\t);\t// * 1.0\r\nfTime2\t\t=  int(floor(\tsizecoeff * 0.816490\t+ 0.5)\t);\r\nfTime3\t\t=  int(floor(\tsizecoeff * 0.707107\t+ 0.5)\t);\t// NOT sqrt1_2 double ?\r\nfTime4Pre\t=  \t\t\t\tsizecoeff * 0.632450;\r\nfTime4\t\t=  int(floor(\tfTime4Pre\t\t\t\t+ 0.5)\t);\r\n\r\n// fdn gains\r\nfTGain1\t\t= -(pow(rt_60, fTime1));\t\t\t\t// !! horrid !!\r\nfTGain2\t\t= -(pow(rt_60, fTime2));\r\nfTGain3\t\t= -(pow(rt_60, fTime3));\r\nfTGain4\t\t= -(pow(rt_60, fTime4));\r\n\r\n// pre diffuse time (truncate)\r\ndiffscale\t= int(fTime4Pre * div1341);\t// different to fdnTime4 because 'spread' is only...\r\npTime\t\t= int(diffscale * 210);\t\t// ...dealt with at instantiation time in original\r\n\r\n// late diffuse times\t// 'spread' here is 0..1\t// all late times returned are integers\r\nlTime1, lTime2, lTime3\t= spreadLate(diffscale,  12.5541,  256.2138, spread);\r\nlTime4, lTime5, lTime6\t= spreadLate(diffscale, -56.8366, -38.0445,\t spread);\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\tsmooth (audio rate)\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n// filtering\r\nsss12\t\t\t\t= smoothsamps * sqrt1_2;\r\ngbw\t\t\t\t\t= eviLine(bwG, sss12);\r\nkbw\t\t\t\t\t= eviLine(bwK, sss12);\r\ngdamp\t\t\t\t= eviLine(dampG, smoothsamps);\r\nkdamp\t\t\t\t= eviLine(dampK, smoothsamps);\r\n\r\n\r\neqHighG, eqLowG\t\t\t= expsmoothBank2(highshelfG, lowshelfG, smoothsecs);\r\nsss2\t\t\t\t\t= smoothsamps * sqrt2;\r\neqHighK\t\t\t\t\t= eviLine(highshelfK, sss2);\r\neqLowK\t\t\t\t\t= eviLine(lowshelfK, sss2);\r\n\r\n\r\n// early times\r\nssecss12\t= smoothsecs * sqrt1_2;\r\npdTime, eTapTime1, eTapTime2, eTapTime3\t= logsmoothBank4(pTime, eTTime1, \r\n\t\t\teTTime2, eTTime3, ssecss12);\r\n/*\r\n// no smoothing:\r\npdTime\t\t= pTime;\teTapTime1\t= eTTime1;\r\neTapTime2\t= eTTime2;\teTapTime3\t= eTTime3;\r\n*/\r\neTapTime4\t= eTTime4;\r\n\r\n// early gains\r\neTapGain1, eTapGain2, eTapGain3, eTapGain4\t= expsmoothBank4(eTGain1, \r\n\t\t\teTGain2, eTGain3, eTGain4, ssecss12);\r\n\r\n// fdn times\r\nfdnTime1, fdnTime2, fdnTime3, fdnTime4\t= logsmoothBank4(fTime1, \r\n\t\t\tfTime2, fTime3, fTime4, smoothsecs);\r\n/*\r\n// no smoothing:\r\nfdnTime1\t= fTime1;\tfdnTime2\t= fTime2;\r\nfdnTime3\t= fTime3;\tfdnTime4\t= fTime4;\r\n*/\r\n// fdn gains\r\nfTapGain1, fTapGain2, fTapGain3, fTapGain4\t= expsmoothBank4(fTGain1, \r\n\t\t\tfTGain2, fTGain3, fTGain4, smoothsecs);\r\n\r\n// late times\r\nlateTime1, lateTime2, lateTime3, lateTime4, lateTime5, lateTime6\t= logsmoothBank6(lTime1, \r\n\t\t\tlTime2, lTime3, lTime4, lTime5, lTime6, (smoothsecs * sqrt2));\r\n/*\r\n// no smoothing:\r\nlateTime1\t= lTime1;\tlateTime2\t= lTime2;\tlateTime3\t= lTime3;\r\nlateTime4\t= lTime4;\tlateTime5\t= lTime5;\tlateTime6\t= lTime6;\r\n*/\r\n// global gains\r\nearlygain, en\t= eviLine(elgain,\t\tsss12);\r\nlategain, ln\t= eviLine(ltgain,\t\tsss2);\r\ndrygain, mn\t\t= eviLine(dygain,\t\tsmoothsamps);\r\n\r\negain60\t\t\t= maximum(earlygain,\t0.001);\t\t\t\t// earlygain but minimum -60 dB\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\taudio inputs\t\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\nx0\t\t\t=  0;\r\nap_xL\t\t=  0;\r\nap_xR\t\t=  0;\r\nif (iStereo >  0) {\t\t\t\t\t\t// if 2 (stereo or 2-channel) inputs\r\n\tx0\t\t= (in1 + in2) * stereoMul;\t// reverb input\t\t// !! stereoMul not smoothed !!\r\n\txL\t\t=  in1;\t\t\t\t\t\t// compensate\r\n\txR\t\t=  in2;\r\n\t// in Sadeharju, xL & xR are multiplied on late diffuser input by 'earlygain'\r\n\tap_xL\t=  in1\t\t  * egain60;\t// \r\n\tap_xR\t=  in2\t\t  * egain60;\r\n} else {\t\t\t\t\t\t\t\t// else 1 (mono) input\r\n\tx0\t\t=  in1;\t\t\t\t\t\t// reverb input\r\n\txL\t\t=  in1;\t\t\t\t\t\t// compensate\r\n\txR\t\t=  xL + 0;\r\n\t// in Sadeharju, xL & xR are multiplied on late diffuser input by 'earlygain'\r\n\tap_xL\t=  in1\t\t  * egain60;\t// \r\n\tap_xR\t=  ap_xL + 0;\r\n}\r\n\r\nrvrbL\t= xL;\r\nrvrbR\t= xR;\r\nmix\t\t= eviLine(int(1 - bypass), 0.333*samplerate);\r\n\r\nif (mix > 0) {\t//\t//\t//\tstart: BYPASS\r\n// ^^ not very useful because cannot include smoothers\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\tinput processing\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n// input bandwidth (low-shelf/pass)\r\nxHp, xIn\t= rcFilterDamp( x0,\tgbw, kbw );\r\n\r\n// pre diffusion allpass delay\r\nxPd\t\t\t= DiffAllpass( xIn, 0.77, pdTime );\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\tearly processing\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n/*\r\nxTap1, xTap2, xTap3, xTap4\t= eTaps( xPd, eTapGain1, eTapGain2, eTapGain3, eTapGain4, \r\n\t\t\t\t\t\t\t\teTapTime1, eTapTime2, eTapTime3, eTapTime4 );\r\n*/\r\n// early taps\r\nearlyTaps.write(xPd);\r\n\r\neTap1\t= earlyTaps.read(eTapTime1,\tinterp=\"fastcubic\");\r\neTap2\t= earlyTaps.read(eTapTime2, interp=\"fastcubic\");\r\neTap3\t= earlyTaps.read(eTapTime3, interp=\"fastcubic\");\r\neTap4\t= earlyTaps.read(eTapTime4, interp=\"none\");\t// eTapTime4 is fixed integer\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t// so fixed \"none\"\r\n// tap to fdn\r\nxTap1\t= eTap1  *  eTapGain1;\r\nxTap2\t= eTap2  *  eTapGain2;\r\nxTap3\t= eTap3  *  eTapGain3;\r\nxTap4\t= eTap4  *  eTapGain4;\r\n\r\n// why is this a feedback in Sadeharju / Böhm ??\r\n//earlyTaps.write(xPd);\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\t\tfdn read\t\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n/*\r\nfD1, fD2, fD3, fD4\t= fdNetwork( xTap1, xTap2, xTap3, xTap4, fTapGain1, fTapGain2, fTapGain3, \r\n\t\t\t\t\t\t\tfTapGain4, fdnTime1, fdnTime2, fdnTime3, fdnTime4, gdamp, kdamp );\r\n*/\r\n// fdn taps\r\nfdnLine1\t= fdnDelay1.read(fdnTime1,\tinterp=\"spline\");\r\nfdnLine2\t= fdnDelay2.read(fdnTime2,\tinterp=\"spline\");\r\nfdnLine3\t= fdnDelay3.read(fdnTime3,\tinterp=\"spline\");\r\nfdnLine4\t= fdnDelay4.read(fdnTime4,\tinterp=\"spline\");\r\n\r\nfTap1\t\t= fdnLine1  *  fTapGain1;\r\nfTap2\t\t= fdnLine2  *  fTapGain2;\r\nfTap3\t\t= fdnLine3  *  fTapGain3;\r\nfTap4\t\t= fdnLine4  *  fTapGain4;\r\n\r\n// fdn damp\r\nfHp1, fD1\t= rcFilterDamp(fTap1,\tgdamp,\tkdamp);\r\nfHp2, fD2\t= rcFilterDamp(fTap2,\tgdamp,\tkdamp);\r\nfHp3, fD3\t= rcFilterDamp(fTap3,\tgdamp,\tkdamp);\r\nfHp4, fD4\t= rcFilterDamp(fTap4,\tgdamp,\tkdamp);\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\tsum early / fdn\t\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n// sum to late diffusion\r\n\r\napIn\t= ((xTap1 * earlygain) + (fD1 * lategain)) - \r\n\t\t\t((xTap2 * earlygain) + (fD2 * lategain)) + \r\n\t\t\t\t((xTap3 * earlygain) + (fD3 * lategain)) -\r\n\t\t\t\t\t((xTap4 * earlygain) + (fD4 * lategain));\r\n\r\napIn\t= dcblock(apIn);\r\napInL\t= apIn + ap_xL ;\r\napInR\t= apIn + ap_xR ;\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\t\tfdn write\t\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n// fdn matrix\r\nfdnMat1\t\t= ( fD1 + fD2 - fD3 - fD4 )  *  0.5;\r\nfdnMat2\t\t= ( fD1 - fD2 - fD3 + fD4 )  *  0.5;\r\nfdnMat3\t\t= (-fD1 + fD2 - fD3 + fD4 )  *  0.5;\r\nfdnMat4\t\t= ( fD1 + fD2 + fD3 + fD4 )  *  0.5;\r\n/*\r\n// fdn damp 2\r\nfdG\t\t\t\t= gdamp * 0.125;\t\t// fix for science :-)\r\nfdK\t\t\t\t= 1;\t\t\t\t\t// highpass, zero @ dc\r\nfdnMat1, fLp1\t= rcFilterDamp(fdnMat1,\tfdG,\tfdK);\r\nfdnMat2, fLp2\t= rcFilterDamp(fdnMat2,\tfdG,\tfdK);\r\nfdnMat3, fLp3\t= rcFilterDamp(fdnMat3,\tfdG,\tfdK);\r\nfdnMat4, fLp4\t= rcFilterDamp(fdnMat4,\tfdG,\tfdK);\r\n*/\r\n// write feedback\r\nfdnDelay1.write(xTap1 + fdnMat1);\r\nfdnDelay2.write(xTap2 + fdnMat2);\r\nfdnDelay3.write(xTap3 + fdnMat3);\r\nfdnDelay4.write(xTap4 + fdnMat4);\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\tlate processing\t\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n/*\r\nrvrbL, rvrbR\t= lateDiffusion(apInL, apInR, lateTime1, lateTime2, \r\n\t\t\t\t\t\t\tlateTime3, lateTime4, lateTime5, lateTime6);\r\n*/\r\n// L\r\nyApL\t= DiffAllpass( apInL ,\t0.707946,\tlateTime1);\t\t// 0.75\r\nyApL\t= DiffAllpass( yApL,\t0.630957,\tlateTime2);\t\t// 0.625\r\nyApL\t= DiffAllpass( yApL,\t0.623735,\tlateTime3);\t\t// 0.625\r\n//yApL\t= DiffAllpass( yApL,\t0.562341,\tlateTime1);\t\t// 0.5\t\t// pete\r\n\r\n// R\r\nyApR\t= DiffAllpass( apInR ,\t0.707946,\tlateTime4);\t\t// 0.75\r\nyApR\t= DiffAllpass( yApR,\t0.630957,\tlateTime5);\t\t// 0.625\r\nyApR\t= DiffAllpass( yApR,\t0.638263,\tlateTime6);\t\t// 0.625\r\n//yApR\t= DiffAllpass( yApR,\t0.562341,\tlateTime4);\t\t// 0.5\t\t// pete\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\t\teq wet\t\t\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\nrvrbL\t= yApL;\r\nrvrbR\t= yApR;\r\n\r\n// 1-pole eq cut/boost shelf filters\r\n// if high/lowshelfK params == 1, filters become high/lowpasses\r\n// if high/lowshelfK params == 0, thru (do not compute)\r\n\r\nif (eqHighK != 0) {\r\n\teq0L, rvrbL\t= rcFilterEq(rvrbL, eqHighG, eqHighK);\t\t// highshelf\r\n\teq0R, rvrbR\t= rcFilterEq(rvrbR, eqHighG, eqHighK);\r\n}\r\n\r\n//if (eqLowK != 0) {\t\t\t\t\t\t\t\t\t\t// cpu manage not click-free for low :-(\r\n\trvrbL, eq0L\t= rcFilterEq(rvrbL, eqLowG, eqLowK);\t\t// lowshelf\r\n\trvrbR, eq0R\t= rcFilterEq(rvrbR, eqLowG, eqLowK);\r\n//}\r\n\r\n\r\n}\t\t\t\t//\t//\t//\tend: BYPASS\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\t\tsum & output\t\t-- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\nrvrbL\t\t= interp(mix, xL, (xL * drygain) + rvrbL, mode=\"cosine\");\r\nrvrbR\t\t= interp(mix, xR, (xR * drygain) + rvrbR, mode=\"cosine\");\r\n\r\nout1\t\t= rvrbL;\r\nout2\t\t= rvrbR;\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n",
					"fontface" : 0,
