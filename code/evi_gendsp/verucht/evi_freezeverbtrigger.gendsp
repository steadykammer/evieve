            {
                "box": {
                    "code": "\r\n// -- -- -- -- -- -- -- -- -- --\tevi_freezeverbtrigger.gendsp    -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n// Basic Schroeder / Moorer reverb model\r\n// Based on the famous 'freeverb' tuning by Jezar at Dreampoint (http://www.dreampoint.co.uk)\r\n// Source reference is the Pd/MSP implementations by Olaf Mathes (& Volker Böhm updates)\r\n\r\n// This version by Pete for evieve, with various modifications, filter improvements\r\n// and parameter smoothing etc, as well as new predelay and eq sections (2018)...\r\n// ...and of course a buttery smooth freeze effect\r\n\r\n// !! this is an expensive version with sample accurate retriggering of freeze functionality\r\n// for rod, @see: 'evi_freezeverb.gendsp' for the more normal and cheaper version !!\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\t\tlibrary\t\t\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\nrequire(\"evi_reverb_library.genexpr\");\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\t\tdeclare\t\t\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n// constants in samples from external javascript, defaults are for 48kHz samplerate\r\n\r\n// early tap times\r\nParam\tetap1samps(\t69,\t\tmin=1, max=1502);\nParam\tetap2samps(\t155,\tmin=1, max=1502);\nParam\tetap3samps(\t251,\tmin=1, max=1502);\nParam\tetap4samps(\t376,\tmin=1, max=1502);\n// comb tap times\r\n// jezar's original constants in integer samples @ current samplerate\r\n// jezar's original constants were set in samples @44.1kHz samplerate\r\n// ref: 1116, 1188, 1277, 1356, 1422, 1491, 1557, 1617\r\nParam\tcomb1samps(\t1215,\tmin=1, max=7040);\nParam\tcomb2samps(\t1293,\tmin=1, max=7040);\nParam\tcomb3samps(\t1390,\tmin=1, max=7040);\nParam\tcomb4samps(\t1476,\tmin=1, max=7040);\nParam\tcomb5samps(\t1548,\tmin=1, max=7040);\nParam\tcomb6samps(\t1623,\tmin=1, max=7040);\nParam\tcomb7samps(\t1695,\tmin=1, max=7040);\nParam\tcomb8samps(\t1760,\tmin=1, max=7040);\n// allpass tap times\r\n// ref: 556, 441, 341, 225\r\nParam\tap1samps(\t605,\tmin=1, max=2421);\nParam\tap2samps(\t480,\tmin=1, max=2421);\nParam\tap3samps(\t371,\tmin=1, max=2421);\nParam\tap4samps(\t245,\tmin=1, max=2421);\n// spread tap times\t\t// make these dynamic with 'width' ?\r\nParam\tcSprSamps(\t50,\t\tmin=1, max=200);\nParam\taSprSamps(\t24,\t\tmin=1, max=200);\n\r\n// early delay lines\r\n\r\nDelay\tearlyTap1(\tetap1samps+1,\t1,\tfeedback=0);\r\nDelay\tearlyTap2(\tetap2samps+1,\t1,\tfeedback=0);\r\nDelay\tearlyTap3(\tetap3samps+1,\t1,\tfeedback=0);\r\nDelay\tearlyTap4(\tetap4samps+1,\t1,\tfeedback=0);\r\n\r\nHistory\txL(0), xR(0);\t// compensate\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\t\tparams\t\t\t-- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n// reverb\r\nParam\tpre(9., min=0, max=143);\t\t\t\t\t// pre delay time in ms\r\nParam\tsize(0.78, min=0, max=1);\t\t\t\t\t// % 0..1 \"roomsize\" (comb filters feedback)\r\nParam\tdamp(0.42, min=0, max=1);\t\t\t\t\t// % 0..1, comb filters damping\r\nParam\twidth(0.7, min=0, max=1);\t\t\t\t\t// % 0..1\r\n// gains\r\nParam\tearly(-20., min=-90, max=0);\t\t\t\t// dB (or init off?)\r\nParam\twet(-9.542434, min=-90, max=0);\t\t\t\t// dB (init 1/scalewet)\r\nParam\tdry(-12., min=-90, max=0);\t\t\t\t\t// dB\r\n// eq (compute coefficients externally in gen no tilde)\r\nParam\thighshelfG(0.123758, min=0, max=1);\t\t\t// pre-warped frequency (g / (1 + g)) (default 2000Hz @48kHz)\r\nParam\thighshelfK(0., min=-3, max=1);\t\t\t\t// -3=shelfboost..0=bypass..shelf..1=pass\r\nParam\tlowshelfG(0.032214, min=0, max=1);\t\t\t// pre-warped frequency (g / (1 + g)) (default 500Hz @48kHz)\r\nParam\tlowshelfK(0., min=-3, max=1);\t\t\t\t// -3=shelfboost..0=bypass..shelf..1=pass\r\n// special\r\nHistory\tmode(0), check(0);\t\t\t\t\t        // freeze 0/1/2, the reason we are here\r\nParam\tbypass(0, min=0, max=1);\t\t\t\t\t// also cpu-off, but no reset in gen~ !\r\nHistory\tpassH(0);\t\t\t\t\t\t\t\t\t// latch bypass smoother\r\n//History\tclear(0);\t\t\t\t\t\t\t\t// TODO\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\t\tsetup\t\t-- -- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n// constants, not user\r\nParam\t\tSQRT8MUL\t( 0.353553390593274, min=0, max=1);\t// sqrt1_2 * 0.5;\r\nParam\t\tFIXEDGAIN\t( 0.015,\tmin=0, max=1\t\t );\t// ?\r\nParam\t\tSCALEEARLY\t( 0.555555,\tmin=0, max=1\t\t );\r\nParam\t\tSCALEWET\t( 3.,\t\tmin=0, max=10\t\t );\nParam\t\tSCALEDRY\t( 2.,\t\tmin=0, max=10\t\t );\nParam\t\tSCALEDAMP\t( 0.4,\t\tmin=0, max=1\t\t );\nParam\t\tSCALEROOM\t( 0.28,\t\tmin=0, max=1\t\t );\nParam\t\tOFFSETROOM\t( 0.7,\t\tmin=0, max=1\t\t );\r\nParam\t\tALLPASSFB\t( 0.5,\t\tmin=0, max=1\t\t );\t// ?\r\n\r\nParam\t\tsmoothtime\t( 10.,\t\tmin=1, max=100\t\t );\t// ms\r\nsmoothsecs\t= smoothtime * 0.001;\t\t\t\t\t// secs\r\nsmsecslong\t= smoothsecs * 2.666667;\t\t\t\t// secs * 3\r\nsmoothsamps\t= smoothsecs * samplerate;\t\t\t\t// samps\r\nsmsampslong\t= smoothsamps * 3.333333;\t\t\t\t// samps * 3\r\nlatency     = maximum(int(smsampslong + 0.5), vectorsize);\r\niBypass\t\t= int(bypass);\r\n\r\nSRATE\t\t= samplerate + 0;\r\n\r\n// -- -- -- -- -- -- -- -- -- --\tparse (param rate)\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\npdTime\t\t=  mstosamps(pre);\r\n\r\nxgain\t\t=  FIXEDGAIN;\r\nroomsize1\t= (size * SCALEROOM) + OFFSETROOM;\t// comb feedback\t// (size * size) ?\r\nroomsize2\t=  roomsize1;\r\ndamping1\t=  damp * SCALEDAMP;\t\t\t\t// comb damp\r\ndamping2\t=  damping1;\r\n\r\nearlygain0\t= (early > -90) ? dbtoaApprox(early) : 0;\r\nearlygain1\t=  earlygain0 * SCALEEARLY;\r\n\r\ndrygain0\t= (dry > -90) ? dbtoaApprox(dry) : 0;\r\ndrygain1\t=  drygain0   * SCALEDRY;\r\n\r\nwidth1\t\t= (width * 0.5) + 0.5;\r\nwetgain0\t= (wet > -90) ? dbtoaApprox(wet) : 0;\r\nwetgain0\t=  wetgain0 *   SCALEWET;\r\nwetgain1\t=  wetgain0 *\twidth1;\r\nwetgain2\t=  wetgain0 * ((1 - width) * 0.5);\r\n\r\n\r\n// -- -- -- -- -- -- -- -- --\tBYPASS\t(smooth & cpu manage)\t-- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\npN\t\t= 1;\t\t\t// latch\r\nPASS\t= 0;\r\niPass\t= 1;\r\nif ( (iBypass != passH) || (passH == 1) ) {\r\n\tPASS, pN\t=  eviLine(iBypass, (0.666 * samplerate));\t// exact ramp (smooth bypass)\r\n\tiPass\t\t=  1 - PASS;\r\n}\r\nxL\t\t=  in1;\t\t\t// align\r\nxR\t\t=  in2;\r\nxLdry\t=  xL * PASS;\r\nxRdry\t=  xR * PASS;\r\nrvrbL\t=  xLdry + 0;\r\nrvrbR\t=  xRdry + 0;\r\n\r\nif (PASS < 1) {\t\t\t// start BYPASS\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\tparse (audio rate)\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n// freeze behaviour, smoothed by parameter changes downstream\r\n// unlike original(s), 'freeze' is click-free and silky smooth in this implementation :-)\r\n\r\n// @ audio rate - much more expensive than \"evi_freezeverb.gendsp\":\r\n\r\nfreeze      =  trunc(in3);                      // 0/1/2\r\nretrig      =  delta(in4) < 0;\r\n\r\nif (retrig) {\r\n    mode = 0;\r\n    check = 1;\r\n}\r\n\r\nif (mode > 0) {\t\t\t\t\t\t\t\t    // freeze + dry (like originals)\r\n    check = 0;\r\n\troomsize2\t=  1 ;\r\n\tdamping2\t=  0 ;\r\n\txgain\t\t=  0 ;\r\n    if (mode == 2) {\t\t\t\t\t\t\t// freeze solo (for evieve)\r\n\t    drygain1\t=  0 ;\r\n\t    earlygain1\t=  0 ;\r\n    }\r\n}\r\nelse {\r\n    roomsize2 = roomsize1;\r\n    damping2 = damping1;\r\n    xgain = FIXEDGAIN;\r\n    drygain1 = drygain0 * SCALEDRY;\r\n    earlygain1 = earlygain0 * SCALEEARLY;\r\n}\r\n\r\n// exact ramps\r\nroomsize3, rmn\t\t\t\t\t\t= eviSline(roomsize2, smsampslong); // because longest ramp\r\nif (check) {\r\n    mode\t\t                    =  (rmn) ? freeze : 0;\r\n}\r\nelse {\r\n    mode                            = freeze;\r\n}\r\ndamping3\t\t\t\t\t\t\t= eviLine(damping2, smsampslong);\r\ndamping4\t\t\t\t\t\t\t= 1 - damping3;\r\n\r\nwidth2\t\t\t\t\t\t\t\t= expsmooth((width1 - 0.1), smsecslong);\r\n\r\nwetgain3, wetgain4\t\t\t\t\t= logsmoothBank2(wetgain1, wetgain2, smoothsecs);\r\n\r\n// exact ramps\r\ningain\t\t\t\t\t\t\t\t= eviSline(xgain, smoothsamps);\r\nearlygain2\t\t\t\t\t\t\t= eviLine(earlygain1, smoothsamps);\r\ndrygain2\t\t\t\t\t\t\t= eviLine(drygain1, smoothsamps);\r\n\r\neqHighG, eqLowG\t\t\t\t\t\t= expsmoothBank2(highshelfG, lowshelfG, smoothsecs);\r\n\r\n// exact ramps\r\neqHighK\t\t\t\t\t\t\t\t= eviLine(highshelfK, smoothsamps);\r\neqLowK\t\t\t\t\t\t\t\t= eviLine(lowshelfK, smoothsamps);\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\t\tprocess\t\t\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\nx0\t\t= ((in1 + in2) * ingain) * iPass;\t\t// & smooth bypass\r\n\r\n// direct signal\r\n\r\nx1\t\t= preDelayVar(x0, pdTime, smoothsamps);\t// only compute if pdTime > 0\r\n\r\n// early reflect taps\r\n\r\nearlL\t= 0;\r\nearlR\t= 0;\r\nearlyTap1.write(xR * iPass);\t\t\t\t\t// & smooth bypass\r\n//earlyTap1.write((xR * -1) * iPass);\r\n\r\nif (earlygain2 > 0) {\t\t\t\t\t\t\t// only compute if earlygain > 0\r\n\r\n\tet1\t\t= earlyTap1.read(etap1samps, interp=\"none\");\r\n\tpt1\t\t= xL + et1;\r\n\tmt1\t\t= xL - et1;\r\n\r\n\tearlyTap2.write(mt1);\r\n\tet2\t\t= earlyTap2.read(etap2samps, interp=\"none\");\r\n\tpt2\t\t= pt1 + et2;\r\n\tmt2\t\t= pt1 - et2;\r\n\r\n\tearlyTap3.write(mt2);\r\n\tet3\t\t= earlyTap3.read(etap3samps, interp=\"none\");\r\n\tpt3\t\t= pt2 + et3;\r\n\tmt3\t\t= pt2 - et3;\r\n\r\n\tearlyTap4.write(mt3);\r\n\tearlR\t= earlyTap4.read(etap4samps, interp=\"none\")\t* SQRT8MUL;\r\n\tearlL\t= pt3\t\t\t\t\t\t\t\t\t\t* SQRT8MUL;\r\n\r\n\tearlL\t= earlL * earlygain2;\r\n\tearlR\t= earlR * earlygain2;\r\n}\r\n\r\nearlyL, earlyR\t= xfadeQuartApproxStereo(earlL, earlR, earlR, earlL, width2);\r\n\r\n// parallel combs\r\n// (we really do mean \"earl*\" and not \"early*\" here)\r\ncInL\t= (x1 + (earlL * ingain)) * iPass;\t\t// & smooth bypass\r\ncInR\t= (x1 + (earlR * ingain)) * iPass;\r\n\r\n// combs left\r\ncomb1L\t= fbComb(cInL, damping3, damping4, roomsize3,\t\tcomb1samps\t\t\t\t\t\t);\r\ncomb2L\t= fbComb(cInL, damping3, damping4, roomsize3,\t\tcomb2samps\t\t\t\t\t\t);\r\ncomb3L\t= fbComb(cInL, damping3, damping4, roomsize3,\t\tcomb3samps\t\t\t\t\t\t);\r\ncomb4L\t= fbComb(cInL, damping3, damping4, roomsize3,\t\tcomb4samps\t\t\t\t\t\t);\r\ncomb5L\t= fbComb(cInL, damping3, damping4, roomsize3,\t\tcomb5samps\t\t\t\t\t\t);\r\ncomb6L\t= fbComb(cInL, damping3, damping4, roomsize3,\tint(comb6samps - (cSprSamps / 2))\t);\r\ncomb7L\t= fbComb(cInL, damping3, damping4, roomsize3,\t\tcomb7samps\t\t\t\t\t\t);\r\ncomb8L\t= fbComb(cInL, damping3, damping4, roomsize3,\t   (comb8samps -  cSprSamps)\t\t);\r\n\r\ncombsL\t= comb1L + comb2L + comb3L + comb4L + comb5L + comb6L + comb7L + comb8L;\r\n\r\n// combs right\r\ncomb1R\t= fbComb(cInR, damping3, damping4, roomsize3,\t   (comb1samps + cSprSamps)\t\t\t);\r\ncomb2R\t= fbComb(cInR, damping3, damping4, roomsize3,\t   (comb2samps + cSprSamps)\t\t\t);\r\ncomb3R\t= fbComb(cInR, damping3, damping4, roomsize3,\t   (comb3samps + cSprSamps)\t\t\t);\r\ncomb4R\t= fbComb(cInR, damping3, damping4, roomsize3,\t   (comb4samps + cSprSamps)\t\t\t);\r\ncomb5R\t= fbComb(cInR, damping3, damping4, roomsize3,\t   (comb5samps + cSprSamps)\t\t\t);\r\ncomb6R\t= fbComb(cInR, damping3, damping4, roomsize3,\t\tcomb6samps\t\t\t\t\t\t);\r\ncomb7R\t= fbComb(cInR, damping3, damping4, roomsize3,\t   (comb7samps + cSprSamps)\t\t\t);\r\ncomb8R\t= fbComb(cInR, damping3, damping4, roomsize3,\t\tcomb8samps\t\t\t\t\t\t);\r\n\r\ncombsR\t= comb1R + comb2R + comb3R + comb4R + comb5R + comb6R + comb7R + comb8R;\r\n\r\n// series allpasses\r\n\r\napLin\t= (combsL + earlyL) * iPass;\t\t\t// & smooth bypass\r\napRin\t= (combsR + earlyR) * iPass;\r\n\r\n// allpasses left\r\napL\t\t= fbAllpass(apLin,\t\tALLPASSFB,\t\tap1samps\t\t\t\t\t);\r\napL\t\t= fbAllpass(apL,\t\tALLPASSFB,\t   (ap2samps - aSprSamps)\t\t);\r\napL\t\t= fbAllpass(apL,\t\tALLPASSFB,\t\tap3samps\t\t\t\t\t);\r\napL\t\t= fbAllpass(apL,\t\tALLPASSFB,\tint(ap4samps - (aSprSamps / 2))\t);\r\n\r\n// allpasses right\r\napR\t\t= fbAllpass(apRin,\t\tALLPASSFB,\t   (ap1samps + aSprSamps)\t\t);\r\napR\t\t= fbAllpass(apR,\t\tALLPASSFB,\t\tap2samps\t\t\t\t\t);\r\napR\t\t= fbAllpass(apR,\t\tALLPASSFB,\tint(ap3samps + (aSprSamps / 2))\t);\r\napR\t\t= fbAllpass(apR,\t\tALLPASSFB,\t\tap4samps\t\t\t\t\t);\r\n\r\n// wet & width mix\r\n\r\nrvrbL\t= (apL * wetgain3) + (apR * wetgain4);\r\nrvrbR\t= (apR * wetgain3) + (apL * wetgain4);\r\n\r\n\r\n// -- -- -- -- -- -- -- -- -- --\t\t  eq (wet)\t\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n// 1-pole eq cut/boost shelf filters\r\n// if high/lowshelfK params == 1, filters become high/lowpasses\r\n// if high/lowshelfK params == 0, bypassed (& do not compute)\r\n\r\nif (eqHighK != 0) {\r\n\trvrbL\t= rcFilterDamp(rvrbL, eqHighG, eqHighK);\t\t// highshelf\r\n\trvrbR\t= rcFilterDamp(rvrbR, eqHighG, eqHighK);\r\n}\r\n\r\n//if (eqLowK != 0) { \t\t\t\t\t\t\t\t\t\t// cpu manage not click-free for low :-(\r\n\trvrbL   = rcFilterDampHp(rvrbL, eqLowG, eqLowK);\t\t// lowshelf\r\n\trvrbR   = rcFilterDampHp(rvrbR, eqLowG, eqLowK);\r\n//}\r\n\r\n\r\n// -- -- -- -- -- -- -- -- --\tBYPASS\t(smooth & cpu manage)\t-- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\n// dry gain\r\n\r\nxLdry\t = xL * drygain2;\r\nxRdry\t = xR * drygain2;\r\n\r\n}\t// end BYPASS\r\n\r\npassH\t = latch(iBypass, pN);\r\n\r\n// -- -- -- -- -- -- -- -- -- --\t\toutput\t\t\t-- -- -- -- -- -- -- -- -- -- -- -- -- \\\\\r\n\r\nrvrbOutL = (rvrbL + xLdry);\r\nrvrbOutR = (rvrbR + xRdry);\r\n\r\nout1\t = interp(PASS, rvrbOutL, xL, mode=\"cosine\");\t// & smooth bypass\r\nout2\t = interp(PASS, rvrbOutR, xR, mode=\"cosine\");\r\n\r\nout3     = rvrbL;\r\nout4     = rvrbR;\r\n\r\nout5     = latency;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 4,
                    "numoutlets": 5,
                    "outlettype": [ "", "", "", "", "" ],
                    "patching_rect": [ 34.0, 56.0, 970.0, 706.0 ]
                }
            },
            {
                "box": {
                    "id": "obj-4",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 34.0, 779.0, 140.0, 22.0 ],
                    "text": "out 1 Left Reverb Output"
                }
            },
            {
                "box": {
                    "id": "obj-6",
                    "linecount": 2,
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 154.0, 14.0, 196.0, 33.0 ],
                    "text": "<<-- input is actually mono summed & attenuated  -->>",
