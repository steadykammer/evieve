                    "text": "in 2 (float) Low Frequency Bound (Hz) @default 20"
                }
            },
            {
                "box": {
                    "code": "\r\n// qfactor calculation specifically for [mc.evi.bands~], not much use elsewhere, based on the Tim Place patcher\r\n\r\nHistory\tinit(1), prev_bands(16), prev_low(20), prev_high(20000), prev_tun(440);\r\nBuffer\tbandfreqs();\t\t\t\t\t\t// alias to parent\r\n\r\nParam\tcompensate(1, min=0, max=1);\t\t// gain compensation, @default on\r\nParam\tnyquist(22588.235294);\t\t\t\t// default 48kHz SR\r\nParam\ttuning(440, min=415, max=467);\r\nParam\tbandsmax(128, min=2);\t\t\t\t// external buffer size in samps\r\nmaxbands\t= int(bandsmax);\r\ncomp\t\t= int(compensate);\r\n\r\nnumbands\t= int(clamp(in1, 2, maxbands));\r\nfreqlow\t\t= clamp(in2, 10, nyquist);\r\nfreqhigh\t= clamp(in3, 10, nyquist);\r\nbandwidth\t= clamp(in4, 0.0001, 1);\t\t// max Q 10000 .. min Q 0.01\r\nbw\t\t\t= 1 / bandwidth;\t\t\t\t// works best with high exponent (4?) on input feed\r\n\r\nlowfreq\t\t= minimum(freqlow, freqhigh);\r\nhighfreq\t= maximum(freqhigh, freqlow);\r\nlowpitch\t= ftom(lowfreq, tuning);\r\nhighpitch\t= ftom(highfreq, tuning);\r\n\r\nnumbandsm1\t= numbands - 1;\r\nqfactor\t\t= 4.419428;\t\t\t\t\t\t// @default 4.419428 (16 bands, 20..20000 Hz)\r\n\r\nif ( (init) || (prev_bands != numbands) || (prev_low != lowpitch) || (prev_high != highpitch) || (prev_tun != tuning) )\r\n{\r\n\tfor (j = 0; j < numbands; j += 1)\r\n\t{\r\n\t\tbandfreqs.poke(( mtof(scale(( j / numbandsm1 ), 0, 1, lowpitch, highpitch, 1), tuning) ), j, 0, 0, index=\"samples\");\r\n\t}\r\n\r\n\tfor (k = numbands; k < maxbands; k += 1)\r\n\t{\r\n\t\tbandfreqs.poke(0, k, 0, 0, index=\"samples\");\r\n\t}\r\n\r\n\tlowestfreq\t= bandfreqs.peek(0, 0, interp=\"none\");\r\n\tqfactor\t\t= (lowestfreq / ((bandfreqs.peek(1, 0, interp=\"none\") - lowestfreq) * 0.5)) + 1;\r\n\tinit\t\t= 0;\r\n}\r\n\r\nout1\t\t= qfactor * bw;\r\nout2\t\t= comp ? sqrt(bw) : 1;\r\n\r\nprev_bands\t= numbands;\r\nprev_low\t= lowpitch;\r\nprev_high\t= highpitch;\r\nprev_tun\t= tuning;\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 4,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 50.0, 58.0, 1001.0, 781.0 ]
                }
            }
