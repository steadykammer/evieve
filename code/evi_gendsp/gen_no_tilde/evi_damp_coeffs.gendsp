            {
                "box": {
                    "code": "\r\n// coefficients at Max schedular rate for two evieve onepole damping filters\r\n\r\nrequire(\"evi_rcfilters.genexpr\");\r\n\r\nParam   HOST_SR(48000); // must be a Param to pass onto an embedded Param\r\n\r\nParam\tcutoffhigh(2000, min=500, max=15000);\t\t\t// Hz\r\nParam\tdamphigh(0, min=-1, max=1);\t\t\t\t\t\t// % ± 1\r\n\r\nParam\tcutofflow(500, min=62.5, max=4000);\t\t\t\t// Hz\r\nParam\tdamplow(0, min=-1, max=1);\t\t\t\t\t\t// % ± 1\r\n\r\nParam\tmode(0, min=0, max=2);\t\t\t\t\t\t\t// int 0/1/2, *)\r\nkout\t= int(mode);\r\n\r\ngLow,\tkLow\t= rcDampCoeffsNoTilde(cutofflow, damplow, kout, AUDIO_SR=HOST_SR);\r\ngHigh,\tkHigh\t= rcDampCoeffsNoTilde(cutoffhigh, damphigh, kout, AUDIO_SR=HOST_SR);\r\n\r\nout1\t= gLow;\r\nout2\t= kLow;\r\n\r\nout3\t= gHigh;\r\nout4\t= kHigh;\r\n\r\n\r\n/*\r\n    *) 'damp' -1..1 maps to d1 (k) as...\n\t\tif mode==0:\t 0=bypass..shelfattenuate..+1=pass (abs or clip damp)\n\t\tif mode==1:\t+0.75=shelfattenuate..0=bypass..-3=shelfboost\n\t\tif mode==2:\t+1=pass..shelfattenuate..0=bypass..-3=shelfboost\n\r\n    @see: \"evi_rcfilters.genexpr\" for details\r\n*/\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
