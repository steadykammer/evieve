            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 19.0, 368.0, 22.0 ],
                    "text": "in 1 (float) Input value in either pitch octave semitones cents or ratio"
                }
            },
            {
                "box": {
                    "code": "\r\n// translated values are clamped so that any input/output combination never produces -inf or nan\r\n\r\nParam   base(440, min=415, max=467);\r\nParam   offset(60, min=0, max=120);\r\n\r\nParam   input(2, min=0, max=4); // 0=pitch, 1=octave, 2=semitones, 3=cents, 4=ratio\r\nParam   output(0, min=0, max=3); // 0=ratio, 1=semitones, 2=hz, 3=pitch\r\n\r\ninp     = int(input);\r\noutp    = int(output);\r\n\r\nLOGTWODIVTWELVE = 0.057762265046662105;\r\nTWELVEDIVLOGTWO = 17.3123404906675609;\r\nMIDDLEC = mtof(offset, base);\r\n\r\nX = in1;\r\nY = 0;\r\n\r\nin_ratio = 0;\r\nif (inp == 4) { // 4=in_ratio\r\n    in_ratio = ((outp == 1) || (outp == 3)) ? maximum(X, 0.000001) : X;\r\n}\r\nelse { // 0=in_pitch, 1=in_octave, 2=in_semitones, 3=in_cents\r\n    in_semitones = (inp == 0) ? (X - 60) : ((inp == 1) ? (X * 12) : ((inp == 3) ? (X * 0.01) : X));\r\n    in_clamp = (inp == 0) ? (12251) : ((inp == 1) ? (1015) : ((inp == 3) ? (1219162) : (12191)));\r\n    in_ratio = clamp(exp(LOGTWODIVTWELVE * in_semitones), -in_clamp, in_clamp);\r\n}\r\n\r\nif (outp > 1) {\r\n    Y = in_ratio * MIDDLEC; // 2=out_hz\r\n    if (outp == 3) {\r\n        Y = ftom(Y, base); // 3=out_pitch\r\n    }\r\n}\r\nelse {\r\n    Y = in_ratio; // 0=out_ratio\r\n    if (outp == 1) {\r\n        Y = log(Y) * TWELVEDIVLOGTWO; // 1=out_semitones\r\n    }\r\n}\r\n\r\nout1 = Y;\r\nout2 = in_ratio;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 49.0, 58.0, 796.0, 706.0 ]
                }
            },
