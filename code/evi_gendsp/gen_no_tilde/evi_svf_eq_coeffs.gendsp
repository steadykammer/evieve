, 			{
				"box" : 				{
					"code" : "/*\r\ntnA(x)\n{\n\tx2 = (x * x);\n\tx3 = (x2 * x);\n\tx5 = (x2 * x3);\n\treturn ((x5 * 0.133333) + (x3 * 0.333333)) + x;\n}\n*/\r\nmtnA(x)\n{\n\tx2\t\t= x * x;\n\treturn\tx * (0.999999492001 + x2 * -0.096524608111) / (1 + x2 * (-0.429867256894 + x2 * 0.009981877999));\n}\n\n// get gain-filter coefficients (use with 'svfSection()')\r\n\nsvfEQcoeff(hz, db, q, filter, hostsamplerate)\n{\r\n\ta1, a2, a3\t\t= 0;\n\tm0, m1, m2\t\t= 0;\n\n\tA\t= sqrt(exp(0.11512925464970 * db));\t\t// must be exact exp() for gain filters cpu management\n\tA2\t= A * A;\n\tg\t= mtnA(pi * hz / hostsamplerate);\t\t// approx for changing samplerates\n\n\tif (filter > 0) {\r\n\r\n\t\tif\t\t\t\t\t(filter == 1) {\t\t// BELL\n\t\t\t\tk\t= 1 / (q * A);\n\t\t\t\ta1\t= 1 / (1 + g * (g + k));\n\t\t\t\ta2\t= g * a1;\n\t\t\t\ta3\t= g * a2;\n\n\t\t\t\tm0\t= 1;\n\t\t\t\tm1\t= k * (A2 - 1);\n\t\t\t\tm2\t= 0;\n\t\t} else {\t//\t\t(filter == 2 || 3)\n\t\t\tsA\t= sqrt(A);\n\n\t\t\tif\t\t\t\t(filter == 2) {\t\t// LOWSHELF\n\t\t\t\tg\t= g / sA;\n\t\t\t\tk\t= 1 / q;\n\t\t\t\ta1\t= 1 / (1 + g * (g + k));\n\t\t\t\ta2\t= g * a1;\n\t\t\t\ta3\t= g * a2;\n\n\t\t\t\tm0\t= 1;\n\t\t\t\tm1\t= k * (A - 1);\n\t\t\t\tm2\t= A2 - 1;\n\t\t\t} else {\t//\t(filter == 3)\t\t// HIGHSELF\n\t\t\t\tg\t= g * sA;\n\t\t\t\tk\t= 1 / q;\n\t\t\t\ta1\t= 1 / (1 + g * (g + k));\n\t\t\t\ta2\t= g * a1;\n\t\t\t\ta3\t= g * a2;\n\n\t\t\t\tm0\t= A2;\n\t\t\t\tm1\t= k * (1 - A) * A;\n\t\t\t\tm2\t= 1 - A2;\r\n\t\t\t}\n\t\t}\n\r\n\t}\r\n\n\treturn\ta1, a2, a3, m0, m1, m2;\n}\n\r\nParam\tcutoff1(250, min=10, max=18000);\t\t\t// Hz\r\nParam\tgain1(0, min=-15, max=15);\t\t\t\t\t// dB (default off)\r\nParam\tresonance1(0.5, min=0.05, max=20);\t\t\t// \r\n\r\nParam\tcutoff2(2000, min=30, max=20000);\t\t\t// Hz\r\nParam\tgain2(0, min=-15, max=15);\t\t\t\t\t// dB (default off)\r\nParam\tresonance2(0.5, min=0.05, max=20);\t\t\t// \r\n\r\nParam\tfilter1(2, min=0, max=3);\t// choose filter type (lowshelf)\r\nParam\tfilter2(3, min=0, max=3);\t// choose filter type (highshelf)\r\nfilt1\t= int(filter1);\r\nfilt2\t= int(filter2);\r\n\r\nHOST_SR\t= in1 + 0;\r\n\r\na1_f1, a2_f1, a3_f1, m0_f1, m1_f1, m2_f1\t= svfEQcoeff(cutoff1, gain1, resonance1, filt1, HOST_SR);\t// LS\r\na1_f2, a2_f2, a3_f2, m0_f2, m1_f2, m2_f2\t= svfEQcoeff(cutoff2, gain2, resonance2, filt2, HOST_SR);\t// HS\r\n\r\nout1, out2, out3, out4,  out5,  out6\t\t= a1_f1, a2_f1, a3_f1, m0_f1, m1_f1, m2_f1;\r\nout7, out8, out9, out10, out11, out12\t\t= a1_f2, a2_f2, a3_f2, m0_f2, m1_f2, m2_f2;\r\n\r\n",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 12.0,
