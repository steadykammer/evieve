            {
                "box": {
                    "code": "\r\n// shelving coefficients at Max schedular rate for the 'LTO' version of the evieve SVF Section\r\n\r\nrequire(\"evi_svf.genexpr\");\r\n\r\nmapFilt(filt)\r\n{\r\n    return selector(filt+1, 0, 3, 2, 5); // 0, 3, 2, 5, bypass, bell, lowshelf, highshelf\r\n}\r\n\r\nParam   HOST_SR(48000);             // must be a Param to pass onto an embedded Param, this is broken gen i think\r\n\r\nParam\tcutoff1(250, min=10, max=18000);\t\t\t// Hz\r\nParam\tgain1(0, min=-15, max=15);\t\t\t\t\t// dB (default off)\r\nParam\tresonance1(0.5, min=0.05, max=20);\t\t\t// \r\n\r\nParam\tcutoff2(2000, min=30, max=20000);\t\t\t// Hz\r\nParam\tgain2(0, min=-15, max=15);\t\t\t\t\t// dB (default off)\r\nParam\tresonance2(0.5, min=0.05, max=20);\t\t\t// \r\n\r\n// 0 = bypass, 1 = bell, 2 = lowshelf, 3 = highshelf\r\nParam\tfilter1(2, min=0, max=3);\t// choose filter type (default lowshelf)\r\nParam\tfilter2(3, min=0, max=3);\t// choose filter type (default highshelf)\r\nfilt1\t= mapFilt(int(filter1));\r\nfilt2\t= mapFilt(int(filter2));\r\n\r\nlinear1 = dbtoaApprox(gain1);\r\nlinear2 = dbtoaApprox(gain2);\r\n\r\na1_f1, a2_f1, a3_f1, m0_f1, m1_f1, m2_f1\t= svfSectionCoeffEqNoTilde(filt1, cutoff1, linear1, resonance1, AUDIO_SR=HOST_SR);\t// LS\r\na1_f2, a2_f2, a3_f2, m0_f2, m1_f2, m2_f2\t= svfSectionCoeffEqNoTilde(filt2, cutoff2, linear2, resonance2, AUDIO_SR=HOST_SR);\t// HS\r\n\r\nout1, out2, out3, out4,  out5,  out6\t\t= a1_f1, a2_f1, a3_f1, m0_f1, m1_f1, m2_f1;\r\nout7, out8, out9, out10, out11, out12\t\t= a1_f2, a2_f2, a3_f2, m0_f2, m1_f2, m2_f2;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
