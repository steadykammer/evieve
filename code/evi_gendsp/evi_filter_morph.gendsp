                    "outlettype": [ "" ],
                    "patching_rect": [ 170.0, 13.0, 225.0, 35.0 ],
                    "text": "in 2 (signal/float) Frequency in Hz @min 1 @max samplerate*0.5 @default 1000"
                }
            },
            {
                "box": {
                    "code": "\r\n// a linear TPT SVF which can morph between LP..BP..HP via the 5th ('Morph') inlet.\r\n// all inlets can be audio-rate modulated and the filters remain stable and clean.\r\n// @see also: \"evi_svfsmooth.gendsp\" / [evi.svfsmooth~] for nonlinear LP..BP..HP morphing.\r\n\r\nrequire(\"evi_svf.genexpr\");\r\n\r\n\nParam   smooth(22.666, min=0, max=1000); // in ms\r\n\r\nX       = in1;\r\ncutoff  = in2;  // Hz\r\ndB      = in3;  // dB\r\nbw      = in4 * 0.5 + 0.5;  // 0..1\r\nmorph   = in5;  // 0..1 % LP..BP..HP\r\n\r\n// 'morph' 0..1 interpolates LP..BP..HP\r\n// gain in dB, bandwidth 0..1, smooth in ms\r\nfilterMorph = eviFilterMorph(X, cutoff, dB, bw, morph, smooth=smooth);\r\n\r\nout1 = filterMorph;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 5,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 34.0, 65.0, 758.0, 397.0 ]
                }
            },
            {
                "box": {
                    "id": "obj-4",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 34.0, 479.0, 201.0, 22.0 ],
                    "text": "out 1 (signal) Morphing Filter Output"
                }
            }
        ],
