, 			{
				"box" : 				{
					"code" : "\r\n//\r\n\r\nhermite_sixpoint_interp(f0, ym2, ym1, y0, y1, y2, y3)\n{\n\tf1    =  f0 - 0.5;\n\teven1 = ym2 + y3;\n\todd1  = ym2 - y3;\n\teven2 = ym1 + y2;\n\todd2  = ym1 - y2;\n\teven3 =  y0 + y1;\n\todd3  =  y0 - y1;\n\n\tc0  = 0.01171875*even1\t\t- 0.09765625*even2\t\t+ 0.5859375*even3;\n\tc1  = 0.2109375*odd2\t\t- 1.463541666667*odd3\t- 0.033854166667*odd1;\n\tc2  = 0.40625*even2\t\t\t- 0.354166666667*even3\t- 0.052083333333*even1;\n\tc3  = 0.1875*odd1\t\t\t- 1.104166666667*odd2\t+ 2.375*odd3;\n\tc4  = 0.020833333333*even1\t- 0.0625*even2\t\t\t+ 0.041666666667*even3;\n\tc5  = 1.041666666667*odd2\t- 2.083333333333*odd3\t- 0.208333333333*odd1;\n\n\treturn ((((c5*f1 + c4)*f1 + c3)*f1 + c2)*f1 + c1)*f1 + c0;\n}\r\n\r\n//\r\n\r\n// Alternative to tanh(), it is not the same but does almost sound the same\r\n// (sort of) and is much easier to create the 2nd order antiderivative of.\r\n// Adaa2 and above are much cheaper than tanh(). i would describe it as a \"buzzy\" tanh().\r\n\r\naltTanhF0(x)\n{\n\treturn x / sqrt(1 + (x*x));\n}\n\naltTanhF1(x)\n{\n\treturn sqrt(1 + (x*x));\n}\n\naltTanhF2(x)\n{\n\txs = sqrt(1 + (x*x));\n\treturn (log(abs(xs + x)) + x * xs) * 0.5;\n}\n\r\naltTanhAdaa1(x0)\n{\n\tHistory x1(0), s1(0);\n\teps = 0.000001;\t// TODO, precision\n\n\ty1 = x0;\n\td0 = x0 - x1;\n\ts0 = altTanhF1(x0);\t// func1\n\tif ((x1 == 0 && s1 == 0) || (abs(d0) < eps)) {\t// ill condition\n\t\ty1 = altTanhF0(0.5 * (x0 + x1));\t// func0\n\t} else {\n\t\ty1 = (s0 - s1) / d0;\n\t}\n\n\ts1 = s0;\n\tx1 = x0;\n\treturn y1;\n}\n\naltTanhAdaa2(x0)\n{\n\tHistory x1(0), x2(0), s1(0);\n\teps = 0.000001;\t// TODO, precision\n\n\ts0 = x0;\n\td0 = x0 - x1;\n\tf2_x1 = altTanhF2(x1);\t// func2\n\tif (abs(d0) < eps) {\t// ill condition\n\t\ts0 = altTanhF1(0.5 * (x0 + x1));\t// func1\n\t} else {\n\t\ts0 = (altTanhF2(x0) - f2_x1) / d0;\t// func2\n\t}\n\n\ty1 = x0;\n\td1 = x0 - x2;\n\tif (x1 == 0 && x2 == 0) {\t// ill condition\n\t\ty1 = altTanhF0(x0 + (x1 + x1) + x2) * 0.25;\t// func0\n\t} else if (abs(d1) < eps) {\t// ill condition\n\t\tx_bar = 0.5 * (x0 + x2);\n\t\tx_delta = x_bar - x1;\n\t\tif (x_delta < eps) {\t// ill condition\n\t\t\ty1 = altTanhF0((x_bar + x1) * 0.5);\t// func0\n\t\t} else {\n\t\t\ty1 = (2 / x_delta) * (altTanhF1(x_bar) + (f2_x1 - altTanhF2(x_bar)) / x_delta);\t// func1, func2\n\t\t}\n\t} else {\n\t\ts0s1 = s0 - s1;\n\t\ty1 = (s0s1 + s0s1) / d1;\n\t}\n\n\ts1 = s0;\n\tx2 = x1;\n\tx1 = x0;\n\treturn y1;\n}\n\n// altTanhAdaa1 oversampling...\n\n// fixed 2x quasi oversampling (hermite6)\naltTanhAdaa1_2x_6POINT(XIN)\n{\t// up 2\n\tHistory umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory doX0(0);\n\n\t// up 2x\n\tx0_0_a  = XIN + 0;\n\tx1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0  = umT2_0 + 0;\n\n\t// process 2x\n\ty1_0  = altTanhAdaa1(x1_0);\n\ty2_0  = altTanhAdaa1(x2_0);\n\n\t// down 2x\n\ty2_0_a  = y2_0 + 0;\n\ty2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0  = (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0 = umTm1_0;\n\tumTm1_0 = umT0_0;\n\tumT0_0  = umT1_0;\n\tumT1_0  = umT2_0;\n\tumT2_0  = x0_0_a;\r\n\r\n\tdoX0  = y1_0;\n\n\tdmT3_1  = dmT2_1;\n\tdmT2_1  = dmT1_1;\n\tdmT1_1  = dmT0_1;\n\tdmT0_1  = dmTm1_1;\n\tdmTm1_1 = y2_0;\n\n\treturn dcblock(y0_0);\n}\n\n// fixed 4x quasi oversampling (hermite6)\naltTanhAdaa1_4x_6POINT(XIN)\n{\t// up 2\n\tHistory umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory doX0(0);\n\n\t// up 2x\n\tx0_0_a  = XIN + 0;\n\tx1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0  = umT2_0 + 0;\n\n\t// process 2x\n\ty1_0  = altTanhAdaa1_2x_6POINT(x1_0);\n\ty2_0  = altTanhAdaa1_2x_6POINT(x2_0);\n\n\t// down 2x\n\ty2_0_a  = y2_0 + 0;\n\ty2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0  = (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0 = umTm1_0;\n\tumTm1_0 = umT0_0;\n\tumT0_0  = umT1_0;\n\tumT1_0  = umT2_0;\n\tumT2_0  = x0_0_a;\r\n\r\n\tdoX0  = y1_0;\n\n\tdmT3_1  = dmT2_1;\n\tdmT2_1  = dmT1_1;\n\tdmT1_1  = dmT0_1;\n\tdmT0_1  = dmTm1_1;\n\tdmTm1_1 = y2_0;\n\n\treturn dcblock(y0_0);\n}\n\n// altTanhAdaa2 oversampling...\n\n// fixed 2x quasi oversampling (hermite6)\naltTanhAdaa2_2x_6POINT(XIN)\n{\t// up 2\n\tHistory umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory doX0(0);\n\n\t// up 2x\n\tx0_0_a  = XIN + 0;\n\tx1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0  = umT2_0 + 0;\n\n\t// process 2x\n\ty1_0  = altTanhAdaa2(x1_0);\n\ty2_0  = altTanhAdaa2(x2_0);\n\n\t// down 2x\n\ty2_0_a  = y2_0 + 0;\n\ty2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0  = (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0 = umTm1_0;\n\tumTm1_0 = umT0_0;\n\tumT0_0  = umT1_0;\n\tumT1_0  = umT2_0;\n\tumT2_0  = x0_0_a;\r\n\r\n\tdoX0  = y1_0;\n\n\tdmT3_1  = dmT2_1;\n\tdmT2_1  = dmT1_1;\n\tdmT1_1  = dmT0_1;\n\tdmT0_1  = dmTm1_1;\n\tdmTm1_1 = y2_0;\n\n\treturn dcblock(y0_0);\n}\n\n// fixed 4x quasi oversampling (hermite6)\naltTanhAdaa2_4x_6POINT(XIN)\n{\t// up 2\n\tHistory umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory doX0(0);\n\n\t// up 2x\n\tx0_0_a  = XIN + 0;\n\tx1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0  = umT2_0 + 0;\n\n\t// process 2x\n\ty1_0  = altTanhAdaa2_2x_6POINT(x1_0);\n\ty2_0  = altTanhAdaa2_2x_6POINT(x2_0);\n\n\t// down 2x\n\ty2_0_a  = y2_0 + 0;\n\ty2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0  = (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0 = umTm1_0;\n\tumTm1_0 = umT0_0;\n\tumT0_0  = umT1_0;\n\tumT1_0  = umT2_0;\n\tumT2_0  = x0_0_a;\r\n\r\n\tdoX0  = y1_0;\n\n\tdmT3_1  = dmT2_1;\n\tdmT2_1  = dmT1_1;\n\tdmT1_1  = dmT0_1;\n\tdmT0_1  = dmTm1_1;\n\tdmTm1_1 = y2_0;\n\n\treturn dcblock(y0_0);\n}\n\r\n//\r\n\r\n// works for waveshapers too :-)\ndecorelate(x)\n{\n\tHistory\tz1(0);\n\ty = 1.371308261611209 * x + z1;\n\tz1 = 0.08785458027104826 * x - 0.45916284188226 * y;\n\treturn y;\n}\r\n\r\n//\r\n\r\nParam\thfcompensate(1, min=0, max=1);\t\t// default on\r\nParam\taa(3, min=0, max=5);\t\t\t\t// default Adaa2\r\nadaaxx\t= int(aa);\r\nhfcomp\t= int(hfcompensate);\r\n\r\nsqrtinput\t= in1 + 0;\r\nsqrtoutput\t= 0;\r\nif (adaaxx == 1) {\r\n\ttanhoutput = altTanhAdaa1_2x_6POINT(sqrtinput);\r\n} else if (adaaxx == 2) {\r\n\tsqrtoutput = altTanhAdaa1_4x_6POINT(sqrtinput);\r\n} else if (adaaxx == 3) {\t// default\r\n\tsqrtoutput = altTanhAdaa2(sqrtinput);\r\n} else if (adaaxx == 4) {\r\n\tsqrtoutput = altTanhAdaa2_2x_6POINT(sqrtinput);\r\n} else if (adaaxx == 5) {\r\n\tsqrtoutput = altTanhAdaa2_4x_6POINT(sqrtinput);\r\n} else {\t\t\t\t\t// (adaaxx == 0)\r\n\tsqrtoutput = altTanhAdaa1(sqrtinput);\r\n}\r\n\r\nif (hfcomp) {\r\n\tsqrtoutput = decorelate(sqrtoutput);\r\n}\r\n\r\nout1\t= sqrtoutput;\r\n\r\n",
					"fontface" : 0,
