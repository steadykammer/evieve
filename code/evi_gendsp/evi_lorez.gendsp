                    "outlettype": [ "" ],
                    "patching_rect": [ 34.0, 19.0, 101.0, 22.0 ],
                    "text": "in 1 (signal) Input"
                }
            },
            {
                "box": {
                    "id": "obj-2",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 193.0, 19.0, 329.0, 22.0 ],
                    "text": "in 2 (signal/float) Cutoff in Hz @min 1 @max samplerate*0.5"
                }
            },
            {
                "box": {
                    "code": "\r\n// Nonlinear 12dB TPT Lowpass with excellent modulation properties.\r\n// @see also: \"evi_lores.gendsp\" (which is a closer match to MSP [lores~]).\r\n\r\nrequire(\"evi_approx.genexpr\");\r\nrequire(\"evi_interp.genexpr\");\r\n\r\n// two poles of a ladder with allpass alignment and naive nonlinearity\r\n// (but works ok here). based on a Will Pirkle 'App Note', thank you.\r\ntwopoleLadder(xin, hz, res) // self-oscillates at res==1 but gets a bit funky up high,\r\n{                           // low freq res is very cool, rodrigo should like it.\r\n    History s1(0), s2(0), s3(0);\r\n    // painful coefficients\r\n    invsr = 1 / samplerate;\r\n    invsr05 = invsr * 0.5;\r\n    k = res + res + res; // one less if linear\r\n    k2 = sqrt2 + 0.353553 * res;\r\n    w = twopi * hz;\r\n    g0 = ((2 / invsr) * tanA2(w * invsr05)) * invsr05;\r\n    g1 = 1 + g0;\r\n    g = g0 / g1;\r\n    ga = (g + g) - 1;\r\n    lp1fb = g * ga / g1;\r\n    lp2fb = ga / g1;\r\n    ap3fb = 2 / g1;\r\n    alpha = 1 / (1 + k * ga * g * g);\r\n    // nonlinear\r\n    mK = ((s1 * lp1fb) + (s2 * lp2fb) + (s3 * ap3fb)) * -k;\r\n    X = mK + xin;\r\n    //u = X * alpha; // if linear\r\n    // we purposefully do not gain-wrap our atan() inside the loop\r\n    u = atanA(X * alpha); // cannot be adaa in loop\r\n    // lowpass 1\r\n    xg = (u - s1) * g;\r\n    lp1 = xg + s1;\r\n    s1 = xg + lp1;\r\n    // lowpass 2\r\n    yg = (lp1 - s2) * g;\r\n    lp2 = yg + s2;\r\n    s2 = yg + lp2;\r\n    // allpass\r\n    zg = (lp2 - s3) * g;\r\n    lp3 = zg + s3;\r\n    hp3 = lp2 - lp3;\r\n    ap3 = (lp3 - hp3) * k2;\r\n    s3 = zg + lp3;\r\n    // tap\r\n    return ap3;\r\n}\r\n\r\ntwopoleLadderCoeff(hz, res)\r\n{\r\n    // painful coefficients\r\n    invsr = 1 / samplerate;\r\n    invsr05 = invsr * 0.5;\r\n    k = res + res + res; // one less if linear\r\n    k2 = sqrt2 + 0.353553 * res;\r\n    w = twopi * hz;\r\n    g0 = ((2 / invsr) * tanA2(w * invsr05)) * invsr05;\r\n    g1 = 1 + g0;\r\n    g = g0 / g1;\r\n    ga = (g + g) - 1;\r\n    lp1fb = g * ga / g1;\r\n    lp2fb = ga / g1;\r\n    ap3fb = 2 / g1;\r\n    alpha = 1 / (1 + k * ga * g * g);\r\n    return g, lp1fb, lp2fb, ap3fb, alpha, k, k2;\r\n}\r\n\r\ntwopoleLadderFilter(xin, g, lp1fb, lp2fb, ap3fb, alpha, k, k2)\r\n{\r\n    History s1(0), s2(0), s3(0);\r\n    // nonlinear\r\n    mK = ((s1 * lp1fb) + (s2 * lp2fb) + (s3 * ap3fb)) * -k;\r\n    X = mK + xin;\r\n    //u = X * alpha; // if linear\r\n    // we purposefully do not gain-wrap our atan() inside the loop\r\n    u = atanA(X * alpha); // cannot be adaa in loop\r\n    // lowpass 1\r\n    xg = (u - s1) * g;\r\n    lp1 = xg + s1;\r\n    s1 = xg + lp1;\r\n    // lowpass 2\r\n    yg = (lp1 - s2) * g;\r\n    lp2 = yg + s2;\r\n    s2 = yg + lp2;\r\n    // allpass\r\n    zg = (lp2 - s3) * g;\r\n    lp3 = zg + s3;\r\n    hp3 = lp2 - lp3;\r\n    ap3 = (lp3 - hp3) * k2;\r\n    s3 = zg + lp3;\r\n    // tap\r\n    return ap3;\r\n}\r\n\r\n// fixed 2x quasi oversampling (hermite6)\ntwopoleLadder_2x( XIN, hz, res )\n{\t// up 2\n\tHistory\tumTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory\tdmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= hermite_sixpoint_interp(0.5,\tumTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0\t= umT2_0 + 0;\n\n\t// process 2x\n\ty1_0\t= twopoleLadder( x1_0, hz, res );\n\ty2_0\t= twopoleLadder( x2_0, hz, res );\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= hermite_sixpoint_interp(0.5,\ty2_0_a,\tdmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0\t= umTm1_0;\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0 \t= umT2_0;\n\tumT2_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT3_1\t= dmT2_1;\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= dmTm1_1;\n\tdmTm1_1\t= y2_0;\n\n\treturn dcblock(y0_0);\n}\n\n// fixed 4x quasi oversampling (hermite6)\ntwopoleLadder_4x( XIN, hz, res )\n{\t// up 2\n\tHistory\tumTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory\tdmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= hermite_sixpoint_interp(0.5,\tumTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0\t= umT2_0 + 0;\n\n\t// process 2x\n\ty1_0\t= twopoleLadder_2x( x1_0, hz, res );\n\ty2_0\t= twopoleLadder_2x( x2_0, hz, res );\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= hermite_sixpoint_interp(0.5,\ty2_0_a,\tdmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0\t= umTm1_0;\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0 \t= umT2_0;\n\tumT2_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT3_1\t= dmT2_1;\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= dmTm1_1;\n\tdmTm1_1\t= y2_0;\n\n\treturn dcblock(y0_0);\n}\r\n\r\n// fixed 2x quasi oversampling (hermite6)\ntwopoleLadderFilter_2x( XIN, g, lp1fb, lp2fb, ap3fb, alpha, k, k2 )\n{\t// up 2\n\tHistory\tumTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory\tdmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= hermite_sixpoint_interp(0.5,\tumTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0\t= umT2_0 + 0;\n\n\t// process 2x\n\ty1_0\t= twopoleLadderFilter( x1_0, g, lp1fb, lp2fb, ap3fb, alpha, k, k2 );\n\ty2_0\t= twopoleLadderFilter( x2_0, g, lp1fb, lp2fb, ap3fb, alpha, k, k2 );\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= hermite_sixpoint_interp(0.5,\ty2_0_a,\tdmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0\t= umTm1_0;\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0 \t= umT2_0;\n\tumT2_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT3_1\t= dmT2_1;\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= dmTm1_1;\n\tdmTm1_1\t= y2_0;\n\n\treturn dcblock(y0_0);\n}\n\n// fixed 4x quasi oversampling (hermite6)\ntwopoleLadderFilter_4x( XIN, g, lp1fb, lp2fb, ap3fb, alpha, k, k2)\n{\t// up 2\n\tHistory\tumTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);\n\t// down 2\n\tHistory\tdmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);\n\t// align\n\tHistory\tdoX0(0);\n\n\t// up 2x\n\tx0_0_a\t= XIN + 0;\n\tx1_0\t= hermite_sixpoint_interp(0.5,\tumTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);\n\tx2_0\t= umT2_0 + 0;\n\n\t// process 2x\n\ty1_0\t= twopoleLadderFilter_2x( x1_0, g, lp1fb, lp2fb, ap3fb, alpha, k, k2 );\n\ty2_0\t= twopoleLadderFilter_2x( x2_0, g, lp1fb, lp2fb, ap3fb, alpha, k, k2 );\n\n\t// down 2x\n\ty2_0_a\t= y2_0 + 0;\n\ty2_1\t= hermite_sixpoint_interp(0.5,\ty2_0_a,\tdmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);\n\n\ty0_0\t= (doX0 + y2_1) * 0.5;\n\n\t// update\n\tumTm2_0\t= umTm1_0;\n\tumTm1_0\t= umT0_0;\n\tumT0_0\t= umT1_0;\n\tumT1_0 \t= umT2_0;\n\tumT2_0\t= x0_0_a;\n\n\tdoX0\t= y1_0;\n\n\tdmT3_1\t= dmT2_1;\n\tdmT2_1\t= dmT1_1;\n\tdmT1_1\t= dmT0_1;\n\tdmT0_1\t= dmTm1_1;\n\tdmTm1_1\t= y2_0;\n\n\treturn dcblock(y0_0);\n}\r\n\r\nParam   oversample(1, min=0, max=2); // 1x, 2x, 4x\r\nos      = int(oversample);\r\n\r\nlorez = 0;\r\n// for some reason my separate coefficients (cheaper) version is not working so well...\r\n// ...so we just use the full ladder filter\r\nif (os == 1) {  // default\r\n    lorez = twopoleLadder_2x(in1, in2, in3);\r\n} else if (os == 2) {\r\n    lorez = twopoleLadder_4x(in1, in2, in3);\r\n} else {        // 1x\r\n    lorez = twopoleLadder(in1, in2, in3);\r\n}\r\n\r\nout1 = lorez;\r\n\r\n/*\r\n// for some reason my separate coefficients (cheaper) version is not working so well...\r\nlorez = 0;\r\nif (os > 0) {\r\n    g, lp1fb, lp2fb, ap3fb, alpha, k, k2 = twopoleLadderCoeff(in2, in3);\r\n    if (os == 1) {  // default\r\n        lorez = twopoleLadderFilter_2x(in1, g, lp1fb, lp2fb, ap3fb, alpha, k, k2);\r\n    } else {        // os == 2\r\n        lorez = twopoleLadderFilter_4x(in1, g, lp1fb, lp2fb, ap3fb, alpha, k, k2);\r\n    }\r\n} else {            // 1x\r\n    lorez = twopoleLadder(in1, in2, in3);\r\n}\r\n*/\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
