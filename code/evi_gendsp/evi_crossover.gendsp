            },
            {
                "box": {
                    "code": "\r\n// 2-band (low/high) crossovers, 2 or 4 pole slopes\r\n// Linkwitz-Rileys sum perfectly flat\r\n\r\nrequire(\"evi_crossovers.genexpr\");\r\n\r\nParam   order(0, min=0, max=1);     // 0 = 2-pole xover, 1 = 4-pole xover\r\npoles   = int(order);\r\n\r\nyLow, yHigh = 0;\r\nif (poles > 0) {\r\n    yLow, yHigh = eviXover4pole2band(in1, in2); // 4-pole\r\n} else {\r\n    yLow, yHigh = eviXover2pole2band(in1, in2); // 2-pole (default)\r\n}\r\n\r\nout1    = yLow;\r\nout2    = yHigh;\r\n\r\n// Note: for additional crossovers and 3-band-split crossovers,\r\n// @see: \"evi_cross.gendsp\" / [evi.cross~] - 4-pole only\r\n// @see: \"evi_crossover_3band.gendsp\" / [evi.crossover.3band~]\r\n// @see: \"evi_crossover_sum.gendsp\" / [evi.crossover.sum~]\r\n// @see: \"evi_crossover_allpass.gendsp\" / [evi.crossover.allpass~]\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
