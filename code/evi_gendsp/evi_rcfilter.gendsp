                "box": {
                    "id": "obj-2",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 472.0, 19.0, 360.0, 22.0 ],
                    "text": "in 2 (signal/float) Hz (default) or g depending on 'prewarp' attribute"
                }
            },
            {
                "box": {
                    "code": "\r\n// nonlinear analog onepole filter using trapezoidal integration and newton-raphson loop,\r\n// \"oversample\" param in addition to newton loop. @see: \"evi_rcfilters.genexpr\" for details.\r\n// choice of frequency input in Hz (default) or normalised 0..1, optional smoothing is default off.\r\n// @see: \"evi_onepole.gendsp\" / [evi.onepole~] for multimode linear version.\r\n\r\nrequire(\"evi_rcfilters.genexpr\");\r\nrequire(\"evi_smooth.genexpr\");\r\n\r\nParam   smooth(0, min=0, max=333);      // ms\r\nParam   oversample(0, min=0, max=1);    // 1 = 2x oversampling, 0 = 1x (default)\r\nParam   prewarp(1, min=0, max=1);       // 1 = input in Hz, 0 = input in 0..1 quasi radians\r\npw      = int(prewarp);\r\nos      = int(oversample);\r\n\r\ng       = pw ? rcPreWarp2(clamp(in2, 1, samplerate*0.5)) : clamp(in2, 0, 1);\r\n\r\nif (smooth > 0) {\r\n    g   = logsmooth(g, smooth*0.001);\r\n}\r\n\r\nrclp    = 0;\r\n\r\nif (os) {\r\n    rclp    = rcOnePole_x2(in1, g);\r\n}\r\nelse {\r\n    rclp    = rcOnePole(in1, g);\r\n}\r\n\r\nout1    = rclp;\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 34.0, 58.0, 798.0, 518.0 ]
                }
            },
            {
                "box": {
                    "id": "obj-4",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 34.0, 593.0, 208.0, 22.0 ],
                    "text": "out 1 (signal) 6dB Nonlinear Lowpass"
                }
            }
        ],
        "lines": [
