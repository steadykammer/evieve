            {
                "box": {
                    "code": "\r\nrequire(\"evi_tanh.genexpr\");\r\n\r\nHistory\tstate1(0), state2(0);\t\t\t\t// SVF state initialise\r\n\r\nX\t= in1;\r\nw2\t= in2;\r\nr2\t= in3;\r\ntl\t= in4;\r\n\r\n// integrators, post state, feedback\r\ns1\t= state1;\r\ng2\t= w2 * w2;\r\ns2\t= state2 + (s1 * w2);\r\n\r\n// resonance\r\ngG\t=   w2 * r2;\r\nsG\t=   s1 * r2;\r\ngS\t= -(g2 + gG);                           // invert feedback\r\nsS\t= -(s2 + sG);\r\n\r\n// solve\r\nonedivgS\t= 1 / (1 - gS);\r\nx0\t\t\t= ((X * gS) + sS) * onedivgS;\t// audio input\r\ny0\t\t\t= X + x0;\t\t\t\t\t\t// y0 = HP\r\n\r\n// integrator 1, post state, nonlinear\r\nx1\t= y0 * w2;\r\ny1\t= tanhLxA((x1 + state1), tl);\t\t\t// y1 = BP\r\n\r\n// integrator 2, post state, nonlinear\r\nx2\t= y1 * w2;\r\ny2\t= tanhLxA((x2 + state2), tl);\t\t\t// y2 = LP\r\ny3\t= y0 + y2;\t\t\t\t\t\t\t\t// y3 = BN\t// (y1 * r2)\r\n\r\n// integrator 1, update state\r\nstate1\t\t= x1 + y1;\r\n\r\n// integrator 2, update state\r\nstate2\t\t= x2 + y2;\r\n\r\nout1, out2, out3, out4\t= y2, y1, y0, y3;\t// LP, BP, HP, BN\r\n\r\n",
                    "fontface": 0,
