            {
                "box": {
                    "id": "obj-2",
                    "linecount": 2,
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 419.0, 29.0, 154.0, 35.0 ],
                    "text": "in 2 (signal/float) Delay in ms @min 0.1 @max 1000"
                }
            },
            {
                "box": {
                    "code": "\r\n// \"evi_allpass.gendsp\" is an allpass delay like MSP [allpass~] and has the same structure,\r\n// but we use cubic interpolation for smoother high end decays, and we tame the gain\r\n// coefficient so no digital clipping or aliasing. Quite different (worse?!) than MSP.\r\n// This abstraction also includes an optional 'feedbackmix' param which does ridiculous\r\n// nonlinear comb effects - you should probably not use this at all (default off).\r\n// @see also: evi_teeth / [evi.teeth~] and evi_comb / [evi.comb~] for similar delays.\r\n\r\nrequire(\"evi_smooth.genexpr\");              // incl. _utilities & _approx\r\n\r\nDelay   FFdelay(samplerate, 1, feedback=0);\r\nDelay   FBdelay(samplerate, 1, feedback=1);\r\n\r\nParam   smooth(0, min=0, max=333);\r\nParam   feedbackmix(0, min=0, max=1);\r\n\r\nfbmix  = feedbackmix;\r\nif (smooth > 0) {\r\n    fbmix = eviLine(feedbackmix, mstosamps(smooth));\r\n}\r\n\r\nFgain   = in3 * 0.9997;                     // direct+feedback gain\r\nFtime   = mstosamps(in2);\r\nX       = in1;\r\n\r\nFFdelay.write(X);\r\nFFdelayOut  = FFdelay.read(Ftime, 0, interp=\"spline\");\r\n\r\nFBdelayOut  = FBdelay.read(Ftime, 0, interp=\"spline\");\r\nFFFB        = (X - FBdelayOut) * Fgain;\r\n\r\ninternalSat = FFFB;\r\nif (fbmix > 0) {\r\n    // Adaa no good here (timing)\r\n    internalSat = atanA(FFFB) * 2.152778;   // multiply taken from 'atanDrive()'\r\n}\r\n\r\nY = fixdenorm(FFdelayOut + FFFB);\r\nEwrite  = xfadeQuartApproxMono(Y, fixdenorm(FFdelayOut - internalSat), fbmix);\r\nFBdelay.write(Ewrite);\r\n\r\nout1 = dcblock(Y);                          // allpass ish\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 50.0, 87.0, 757.0, 689.0 ]
                }
            },
            {
                "box": {
                    "id": "obj-4",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 50.0, 793.0, 223.0, 22.0 ],
                    "text": "out 1 (signal) Allpass Delay Filter Output"
                }
            }
        ],
