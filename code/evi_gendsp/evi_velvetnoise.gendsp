					"text" : "in 1 Frequency in Hz @default 100"
				}

			}
, 			{
				"box" : 				{
					"code" : "\r\n// Pete: this algorithm is really stupid with the phasor(), I do not like it\r\n// @see: \"evi_audiodust.gendsp\" for cheaper algorithm (compared to \"sparseNoise\")\r\nsparseVelvetNoise(freq, mix, amp=1)\r\n{\r\n\tHistory\t\tprevClock(0), prevXox(0);\r\n\r\n\tXoxhiro256\t=  noise();\r\n\tclock\t\t=  phasor(freq);\r\n\tlatchRandom\t= (latch(Xoxhiro256, (clock - prevClock)) * 0.5) + 0.5;\r\n\r\n\tsparseNoise\t= prevXox * ((clock >= latchRandom) * (prevClock < latchRandom));\r\n\tprevClock\t= clock;\r\n\tprevXox\t\t= Xoxhiro256;\r\n\r\n\tvelvetNoise\t= (sign(sparseNoise) * amp);\r\n\tmixNoise\t= interp(mix, sparseNoise, velvetNoise, mode=\"cosine\");\r\n\r\n\treturn\t\tmixNoise, sparseNoise, velvetNoise;\r\n}\r\n\r\nParam\tamplitude(1, min=0, max=1);\r\n\r\nout1, out2, out3\t= sparseVelvetNoise(in1, in2, amp=amplitude);\r\n\r\n",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 12.0,
					"id" : "obj-3",
					"maxclass" : "codebox",
					"numinlets" : 2,
					"numoutlets" : 3,
					"outlettype" : [ "", "", "" ],
					"patching_rect" : [ 49.0, 60.0, 670.0, 423.0 ]
				}

			}
, 			{
