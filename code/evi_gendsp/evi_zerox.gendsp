, 			{
				"box" : 				{
					"code" : "\r\n// basically from the gen~ example, with additions\r\nsimpleZerox(x, threshold=0.1)\n{\r\n\tHistory\tperiod(0);\n\n\tcurrentSign = x < 0;\t\t\t// detect zero crossing...\r\n\tcrossing = change(currentSign);\t// ...& report sign\n\r\n\tperiodAccum = period + 1;\t\t// increment period counter\r\n\tperiodCount = latch(periodAccum, crossing);\r\n\tvoiced = (periodCount / vectorsize) > threshold; // fixed\r\n\t// zero counter on zero crossing\r\n\tperiod = periodAccum * (crossing == 0);\r\n\r\n\treturn periodCount, voiced, crossing;\t\t\t // -voiced ?\n}\n\r\nParam\tthresh(0.1, min=0, max=1);\t// thresh in amplitude (default -20dB)\n\r\nout1, out2, out3\t= simpleZerox(in1, threshold=thresh);\r\n\r\n",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 12.0,
