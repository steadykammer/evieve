{
    "patcher": {
        "fileversion": 1,
        "appversion": {
            "major": 9,
            "minor": 2,
            "revision": 0,
            "architecture": "x64",
            "modernui": 1
        },
        "classnamespace": "dsp.gen",
        "rect": [ 684.0, 100.0, 794.0, 848.0 ],
        "gridonopen": 2,
        "subpatcher_template": "sub",
        "integercoordinates": 1,
        "boxes": [
            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 19.0, 219.0, 22.0 ],
                    "text": "in 1 Audio In that must be treated nicely"
                }
            },
            {
                "box": {
                    "code": "\r\n// simple but antialiased clipping for your audio\r\n// antiderivative anti aliasing + quasi oversampling, by Pete for evieve, 2022\r\n// \"Diode\" aliases far sooner than \"Hard\" or \"Soft\", see evi.valve~ for better diode\r\n\r\nrequire(\"evi_clipping.genexpr\");\r\n\r\nHistory prevSR(0), initS(1), initD(1);\r\nHistory k1(0.), k2(0.), k3(0.), k4(0.), k5(0.), k6(0.), VT(0.), A1(0.);\r\n\r\nParam\toversampling(2, min=0, max=2);\t// 0 = 1x, 1 = 2x, 2 = 4x\r\nParam\tclip(0, min=0, max=3);\t\t\t// 0 = Hard, 1 = Soft, 2 = Diode, 3 = Asym\r\ncp\t\t= int(clip);\r\nos\t\t= int(oversampling);\r\n\r\nX\t\t= xMega(dcblock(in1), xCONST=0.1);       // ..+40dB\r\nreset   = (delta(change(cp)) < 0) + (delta(change(os)) < 0);\r\n\r\nY\t\t= 0;\r\n// Y gains for fake oversampling are tuned to take up to +40dB input\r\nif (cp == 1) { // soft clip\r\n    fs = 1 - evi_logsmooth(initS, 999); // the only way\r\n\tif (os == 1) {\r\n\t\tY = adSc2_2x_6POINT_fix2(X, reset) * 0.955101;\r\n\t} else if (os == 2) {\r\n\t\tY = adSc2_4x_6POINT(X, reset) * 0.93656;\r\n\t} else {\r\n\t\tY = adSc2(X, 1, reset) * 0.998008;\r\n\t}\r\n    Y = Y * fs;\r\n    initS = 0;\r\n} else if (cp == 2) { // diode clip\r\n    fd = 1 - evi_logsmooth(initD, 666); // the only way\r\n    if (prevSR != SAMPLERATE) {\r\n        k1, k2, k3, k4, k5, k6, VT, A1 = diodeCoeffs(SAMPLERATE);\r\n        prevSR = SAMPLERATE;\r\n    }\r\n\tif (os == 1) {\r\n\t\tY = diode_4x_4POINT(X, k1, k2, k3, k4, k5, k6, VT, A1, reset);\r\n\t} else if (os == 2) {\r\n\t\tY = diode_8x_4POINT(X, k1, k2, k3, k4, k5, k6, VT, A1, reset);\r\n\t} else {\r\n\t\tY = diode_2x_4POINT(X, k1, k2, k3, k4, k5, k6, VT, A1, reset); // not great\r\n\t}\r\n\tY = Y * fd * 3.162278; // not wrong\r\n    initD = 0;\r\n} else if (cp == 3) { // asymmetric clip\r\n\tif (os == 1) {\r\n\t\tY = asym_2x_6POINT(X);\r\n\t} else if (os == 2) {\r\n\t\tY = asym_4x_6POINT(X);\r\n\t} else {\r\n\t\tY = asym(X); // avoid\r\n\t}\r\n} else { // cp == 0 // hard clip\r\n\tif (os == 1) {\r\n\t\tY = adHc2_2x_6POINT(X, reset) * 0.953396;\r\n\t} else if (os == 2) {\r\n\t\tY = adHc2_4x_6POINT(X, reset) * 0.92928;\t// // // default\r\n\t} else {\r\n\t\tY = adHc2(X, reset) * 0.996263;\r\n\t}\r\n}\r\n\r\nout1 = dcblock(Y * 0.999999);\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 49.0, 58.0, 699.0, 732.0 ]
                }
            },
            {
                "box": {
                    "id": "obj-4",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 49.0, 807.0, 201.0, 22.0 ],
                    "text": "out 1 Anti Aliased Clipped Audio Out"
                }
            }
        ],
        "lines": [
            {
                "patchline": {
                    "destination": [ "obj-3", 0 ],
                    "source": [ "obj-1", 0 ]
                }
            },
            {
                "patchline": {
                    "destination": [ "obj-4", 0 ],
                    "source": [ "obj-3", 0 ]
                }
            }
        ],
        "autosave": 0
    }
}