                    "text": "in 2 (signal/float) Crossover Frequency in Hz @min 10 @max 20000"
                }
            },
            {
                "box": {
                    "code": "\r\n// \"evi_cross.gendsp\" / [evi.cross~] differs from MSP [cross~] in the following ways:\r\n\r\n// [evi.cross~] is a steeper 4-pole crossover slope ([cross~] is a 3-pole slope), \r\n// because 3rd order is not possible with flat summing Linkwitz-Riley.\r\n// [evi.cross~] is a proper Linkwitz-Riley crossover which sums perfectly flat\r\n// (whereas [cross~] is pure Butterworths and sums with a +3dB bump).\r\n// [evi.cross~] remains stable under modulation.\r\n\r\n\r\nrequire(\"evi_crossovers.genexpr\");\r\n\r\n\r\nout1, out2  = eviXover4pole2band(in1, in2);\r\n\r\n\r\n// Note: for additional 2-pole crossovers, and 3-band-split crossovers,\r\n// @see: \"evi_crossover.gendsp\" / [evi.crossover~]\r\n// @see: \"evi_crossover_3band.gendsp\" / [evi.crossover.3band~]\r\n// @see: \"evi_crossover_sum.gendsp\" / [evi.crossover.sum~]\r\n// @see: \"evi_crossover_allpass.gendsp\" / [evi.crossover.allpass~]\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 49.0, 58.0, 735.0, 392.0 ]
                }
