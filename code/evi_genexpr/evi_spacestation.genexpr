// make oversampling choice on tnhL mono nonlinearity
tnhLNonlin(xin, oversampling)
{
	History tnhldummy(0);			// for embedding
	y = 0;
	if (oversampling == 1) {		// use 3x oversampling
		y = tnhL3x(xin);
	} else if (oversampling == 2) {	// use 6x oversampling
		y = tnhL6x(xin);
	} else {						// BYPASSED
		y = xin;
	}
	return y;
}

// make oversampling choice on parabolsat mono nonlinearity
parabolNonlin(xin, am, cl, oversampling)
{
	History pbldummy(0);			// for embedding
	y = 0;
	if (oversampling == 1) {		// use 3x oversampling
		y = parabol3x(xin, am, cl);
	} else if (oversampling == 2) {	// use 6x oversampling
		y = parabol6x(xin, am, cl);
	} else {						// BYPASSED
		y = xin;
	}
	return y;
}


//	//	//	filters

rcPreWarp(cutoff)						// prewarp
{
	g0		=  tnA(pi * cutoff / samplerate);
	return	g0 / (1 + g0);
}
/*
rcDampCoeffs(cutoff, damp, mode)		// *)
{
	d1		= 0;
	// prewarp
	g0		=  tnA(pi * cutoff / samplerate);
	// account for pass/shelf
	ka	=  abs(damp);					// 0..1 = sqrt..lin
	ks	= (ka * 0.5) + 0.5;
	g01	=  1 + g0;
	g1 	=  g0 / interp((2 * (ks - 0.5)), sqrt(g01), g01, mode="linear");
	// shelf/pass (damp) control
	if (mode > 0) {			// nice way of getting approx ± 10dB
		d1		= -(pow(4, damp) - 1);
		if (mode == 2) {	// extend attenuation range to make pass choice
			d1	=  (d1 > 0) ? (d1 * 1.333333) : d1;
		}
	} else {// (mode == 0)	// for attenuation ('damping') only (0..1 input)
		d1	= interp((2 * (((1 - ks) + 0.5) - 0.5)), sqrt(ka), ka, mode="linear");
	}

	return g1, d1;			// rc filter warped cf (g)	// rc filter warped gain (k)

	// *) N.B., 'damp' -1..1 maps to d1 (k) as...
	//		- if mode==0:	 0=bypass..shelfattenuate..+1=pass (abs or clip damp)
	//		- if mode==1:	+0.75=shelfattenuate..0=bypass..-3=shelfboost
	//		- if mode==2:	+1=pass..shelfattenuate..0=bypass..-3=shelfboost
}
*/
rcDampCoeffs(cutoff, damp)				// fixed mode=2 version, no branching, keep out of while loop in export
{
	// prewarp
	g0		=  tnA(pi * cutoff / samplerate);
	// account for pass/shelf
	ka	=  abs(damp);					// 0..1 = sqrt..lin
	ks	= (ka * 0.5) + 0.5;
	g01	=  1 + g0;
	g1 	=  g0 / interp((2 * (ks - 0.5)), sqrt(g01), g01, mode="linear");
	// shelf/pass (damp) control
	d1	= -(pow(4, damp) - 1);			// this is just horrible
	// extend attenuation range to make pass choice
	d1	=  (d1 > 0) ? (d1 * 1.333333) : d1;

	return g1, d1;						// rc filter warped cf (g)	// rc filter warped gain (k)
}

// linear OnePole RC filter (trapezoidal)
rcFilter(Vin, g)
{
	History	  s(0);
	Vout	= (g * Vin + s) / (g + 1);
	s		= (Vout + Vout) - s;
	return	  Vout;
}

rcFilterHpLp(Vin, g)
{
	History	  s(0);
	VoutLp	= (g * Vin + s) / (g + 1);
	s		= (VoutLp + VoutLp) - s;
	Hp		= Vin - VoutLp;
	return	  Hp, VoutLp;
}

// dual bandpass version, one in one out
rcFilterBandpass(xp, ghp, glp)
{
	History	rcfbdummy(0);
	lp		= rcFilter(xp, glp);
	hp, hl	= rcFilterHpLp(lp, ghp);
	return	hp;
}

// High or Low Pass if k == 1, Bypass if k == 0, else Low or High Shelf attenuation
rcFilterDamp(Vin, g, k)
{
	History	   s(0);
	Lp		= (g * Vin + s) / (g + 1);
	s		= (Lp + Lp) - s;
	Hp		=  Lp - Vin;				// must be y-x

	return	Vin + (k * Hp);
}

// High or Low Pass if k == 1, Bypass if k == 0, else Low or High Shelf attenuation
rcFilterDampHpLp(Vin, g, k)
{
	History	   s(0);
	Lp		= (g * Vin + s) / (g + 1);
	s		= (Lp + Lp) - s;
	Hp		=  Lp - Vin;				// must be y-x

	LpHs	=  Vin + (k * Hp);
	HpLs	= (k * Lp) - Vin;

	return	   HpLs, LpHs;
}

rcFilterDampBandpass(Vin, ghp, glp, hk, lk)
{
	History	rcfdbdummy(0);
	lphs1			= rcFilterDamp(Vin, glp, lk);
	hpls2, lphs2	= rcFilterDampHpLp(lphs1, ghp, hk);
	return	hpls2;
}

//	//	//	fdn

// approx pow(x, 0.5..2)
fastskew(x, skew)					// !! skew must be clipped 0.5..2 !!
{
	y		= 0;

	if (skew < 1) {
		sk5	= skew - 0.5;
		y 	= interp(sk5 + sk5, sqrt(x), x);	
	} else {
 		y	= interp(skew - 1, x, x * x);
	}

	return	y;
}

lfoCalc(phase, duty, shape, skew)	// input phase must be wrapped 0..1 for tri phase
{
    tri = (phase < duty) ? (phase / duty) : (1 - phase) / (1 - duty);

	sphase = wrap(phase - 0.25, 0, 1);
   	sine = (sphase > 0.5) ? sphase - 1 : sphase;
    sine = sine * (4 - (abs(sine) * 8)) + 0.5;
            
    return fastskew(interp(shape, tri, sine), skew);
}

// cheap parabolic approx
parabolWrap(phase) // phase must be phase (phasor) wrapped 0..1
{
	x	= wrap(phase, -0.5, 0.5); // this is stupid and needlessly expensive, can't i just do (x = phase - 0.5) ?
//	x 	= phase - 0.5; // ah, but now the phase is wrong :-( <<-- does it matter ?
	y	= (8 - (abs(x) * 16)) * x;
	return	y;
}

oneMod1(modFreq, modDepth, modOffset, _modDuty, _modShape, _modSkew)
{
	History 	onemod1dummy(0);
	modPhase	= phasor(modFreq);
	return		parabolWrap(modPhase + modOffset) * modDepth;
}

oneMod2(modFreq, modDepth, modOffset, modDuty, modShape, modSkew)
{
	History 	onemod2dummy(0);
	modPhase	= wrap(phasor(modFreq) + modOffset, 0, 1);
	return		(lfoCalc(modPhase, modDuty, modShape, modSkew) * (modDepth + modDepth)) - modDepth;
}

delmod2(delay1, delay2, rate, depth, offset1, offset2)
{
	History delmod2dummy(0);
	mod1	= oneMod1(rate, depth, offset1, 0, 0, 0);
	mod2	= oneMod1(rate, depth, offset2, 0, 0, 0);
	time1	= delay1 + mod1;
	time2	= delay2 + mod2;
	return	time1, time2;
}

delmod4(delay1, delay2, delay3, delay4, rate1, rate2, depth, offset1, offset2, offset3, offset4)
{
	History delmod4dummy(0);
	time1, time2	= delmod2(delay1, delay2, rate1, depth, offset1, offset2);
	time3, time4	= delmod2(delay3, delay4, rate2, depth, offset3, offset4);
	return	time1, time2, time3, time4;
}

//	//	//	mix

xfadeSqrtStereo(a, b, c, d, x)
{
	cL, cR	= ctrlSqrt(x);
	return ((a * cL) + (c * cR)), ((b * cL) + (d * cR));
}

