// fixed 3x quasi oversampling mono
parabol3x(XIN, a, c)
{	// up 3
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// up 3x
	x0_0_a	= XIN + 0;
	x1_0	= umT0_0 + 0;
	x2_0	= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");
	x3_0	= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");

	// process 3x
	y1_0	= parabolsat(x1_0, a, c);
	y2_0	= parabolsat(x2_0, a, c);
	y3_0	= parabolsat(x3_0, a, c);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");
	y3_0_a	= y3_0 + 0;
	y3_1	= interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2, mode="spline");

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return y0_0;
}

// fixed 6x quasi oversampling mono
parabol6x(XIN, a, c)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a, mode="cubic");
	x2_0	= umT1_0 + 0;

	// process 6x
	y1_0	= parabol3x(x1_0, a, c);
	y2_0	= parabol3x(x2_0, a, c);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="cubic");

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}
