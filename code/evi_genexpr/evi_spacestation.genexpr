
// evi_majorverb.gendsp, a strange reverb-like effect by Pete for evieve,
// based on Christopher Moore's legendary 1978 Ursa Major Space Station algorithm
// @see: https://patentimages.storage.googleapis.com/69/db/19/ea420d3f72ccd2/US4268717.pdf
// I would not have fully understood it all without the Tom Erbe examples.

// This is not an attempt to model the 1970's digital hardware, but more of a trope on it, 
// although it does sound very close to the original with the right settings :-)
// Nonlinearities and trap filters have been added, much as you might find in an analogue delay,
// and different modulation, interpolation, smoothing, filtering modifications, etc.
// The key features (for me) are the ability to screw up the recirculation settings into a crazy
// and cool performable feedback matrix drone machine.


//	//	//	utilities

// approx exp(x) (more accurate than 'fastexp()')
expA(x0)
{
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;
	x *= x; x *= x; x *= x; x *= x; x *= x;
	return x;
}

// excellent accuracy to about +36 dB, after which you are on your own
dbtoaApprox(db)
{
	dbtoaA = expA(0.11512925464970 * db);
	return dbtoaA + 0.000128;		// + offset = 0 dB == 1 amplitude
}

// cheap tan approx for BLT
tnA(x)		// 0..1 input
{
	x2 = (x * x);
	x3 = (x2 * x);
	x5 = (x2 * x3);
	return ((x5 * 0.133333) + (x3 * 0.333333)) + x;
}

// for square root xfade
ctrlSqrt(x)
{
	cL = sqrt(1 - x);
	cR = sqrt(x);
	return cL, cR;
}


//	//	//	smoothing

tauA(t)								// approximate 'exp(-1 / (seconds * samplerate))'
{
	y = expA(-1 / (t * samplerate));
	return y + 0.000128;			// approximation has excellent accuracy above...
}									// ...0.01 seconds (10 milliseconds) input

expsmooth(x, t)		// x = value	// t is smooth time in seconds
{
	History w(0);
	z = tauA(t);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

// for exp envs
expso(x, z)									// z is pole
{
	History w(0);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expsmoothBank2(x1, x2, t)					// t is smooth time in seconds...
{
	History	expsdummy2(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	return	y1, y2;
}

logsmooth(x, s)		// x = value			// s = time to drop 6dB (in seconds)
{
	History z(0);
	ad = LN2 / (s * samplerate);			// no maximum check
	y  = ((x - z) * ad) + z;
	z  = y;
	return y;
}

// for log envs
logsad(s)									// s = time to drop 6dB (in seconds)
{
//	return	LN2 / (s * samplerate);
	return	LN2 / maximum((s * samplerate), 1);// incl. maximum check
}

// for log banks
logso(x, ad)
{
	History z(0);
	y = ((x - z) * ad) + z;
	z = y;
	return y;
}

logsmoothBank2(x1, x2, s)
{
	History	logsdummy2(0);
	ad		= logsad(s);
	y1		= logso(x1, ad);
	y2		= logso(x2, ad);
	return	y1, y2;
}

logsmoothBank3(x1, x2, x3, s)
{
	History	logsdummy3(0);
	ad		= logsad(s);
	y1		= logso(x1, ad);
	y2		= logso(x2, ad);
	y3		= logso(x3, ad);
	return	y1, y2, y3;
}

logsmoothBank4(x1, x2, x3, x4, s)
{
	History	logsdummy4(0);
	ad		= logsad(s);
	y1		= logso(x1, ad);
	y2		= logso(x2, ad);
	y3		= logso(x3, ad);
	y4		= logso(x4, ad);
	return	y1, y2, y3, y4;
}

// basic linear scaling like linear part of [scale]
eviMap(valueIn, inLow, inHigh, outLow, outHigh)
{
	multiplier = (outLow - outHigh) / (inLow - inHigh);
	return (valueIn - inLow) * multiplier + outLow;
}

// a bit like MSP [line~], i.e. exact destination
eviLine(target, duration)				// target, duration in samples
{
	History	value(0);
	trigger	= change(target);
	ramp	= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);
	line	= eviMap(ramp, 0, 1, latch(value, trigger), latch(target, trigger));
	value	= line;
	return	line, (ramp == 1);
}


//	//	//	nonlinear

// HQ tanh lambert approximation
tnhL(x)
{
	x2 = x * x;
	a  = (((x2 + 378) * x2 + 17325) * x2 + 135135) * x;
	b  = ((28 * x2 + 3150) * x2 + 62370) * x2 + 135135;
	return clamp((a / b), -1, 1);
}

// parabolic saturation
parabolsat(x, a, c)					// a=amplitude (default 1), c=clip (default 2)
{
	c2 = c + c;
	p  = clip((x * a), -c2, c2);
	m  = 1 - (abs(p) * (0.25 / c));
	y  = p * m;
	return y;
}

// fixed 3x quasi oversampling mono
tnhL3x(XIN)
{	// up 3
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// up 3x
	x0_0_a	= XIN + 0;
	x1_0	= umT0_0 + 0;
	x2_0	= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");
	x3_0	= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");

	// process 3x
	y1_0	= tnhL(x1_0);
	y2_0	= tnhL(x2_0);
	y3_0	= tnhL(x3_0);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");
	y3_0_a	= y3_0 + 0;
	y3_1	= interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2, mode="spline");

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return y0_0;
}

// fixed 6x quasi oversampling mono
tnhL6x(XIN)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a, mode="cubic");
	x2_0	= umT1_0 + 0;

	// process 6x
	y1_0	= tnhL3x(x1_0);
	y2_0	= tnhL3x(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="cubic");

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}
