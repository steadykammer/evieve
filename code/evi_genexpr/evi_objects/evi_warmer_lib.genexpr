/*
	I made this for Andreas Wetterberg in 2013
	I updated it in 2021
	It is based on a Tom Szilagyi idea
*/

require("evi_smooth.genexpr");
require("evi_rcfilters.genexpr");
require("evi_butterworth.genexpr");

D(x)
{
  return sqrt(x * sign(x));
}

szilagyi(drive, blend, sr)  // sr = samplerate
{
  sr01 = sr * 0.1;
  srct = sr01 / (sr01 + 1);

  rdrive = 12 / drive;
  rdrive2 = rdrive * rdrive;
  rd22 = rdrive2 + rdrive2;
  rbdr = rdrive / (10.5 - blend) * 23.636364;
  rbdr2 = rbdr * rbdr;

  kp0 = D(rd22 - 1);
  kpa = kp0 + 1;
  kpb = (2 - kpa) * 0.5;

  ap = (rdrive2 - kpa + 1) * 0.5;
  kc = kpa / D(kp0 + kp0 - rd22);
  kc2 = kc * kc;
  sq = kc2 + 1;
  dsq = D(sq);

  kdm = rbdr / dsq;
  knb = -(kdm);
  kna = (kc + kc) * kdm;

  an = rbdr2 / sq;
  imr = (knb + knb) + D(kna + kna + an + an + an + an - 1);
  pwrq = 2 / (imr + 1);

  return srct, ap, kpa, kpb, an, kna, knb, pwrq;
}

