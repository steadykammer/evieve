lp1p(x, g)                // 1-pole zdf section
{
  History p(0);
  c = (x - p) * (g / (g + 1));
  y = c + p;
  p = c + y;
  return y;
}

lp2p(x, g, r)             // 2-pole zdf section
{
  History p0(0), p1(0);
  c0 = r + g;
  c1 = (g / ((c0 * g) + 1)) * (x - (p1 + (p0 * c0)));
  c2 = c1 + p0;
  c3 = c2 * g;
  y  = c3 + p1;
  p0 = c1 + c2;
  p1 = c3 + y;
  return y;
}
