// includes 'evi_interp.genexpr', 'evi_adaa.genexpr', adaa includes 'evi_utilities.genexpr', utilities includes 'evi_approx.genexpr'
require("evi_saturators.genexpr");
require("evi_env.genexpr");
require("evi_fastskew.genexpr");
require("evi_rcfilters.genexpr");


//	//	//	utilities	//	//	//
// other envs used are in 'evi_env.genexpr'


safe20dB(x)
{
    return hardclipAdaa1(x * 0.1) * 10;
}

safe40dB(x)
{
    return hardclipAdaa1(x * 0.01) * 100;
}

// this idea is butchered from Peter McCulloch's legendary thread post, with pete skew
clipEnv(x, skew) // skew = 0.5..2 around '1'
{
    ac = clip(x, -0.2, 0.3) + 0.2;
    ac2 = ac + ac;
    env1 = fastskew052ar(ac2, skew);
    env2 = 1 - env1;
    return ac, env1, env2;
}

// asymmetry set by @low (pos) & @high (neg) multiplied by skew (±6dB)
asymExecute(x, skew, hyst1, hyst2, heat, softhard=1, low=2.1, high=3.9)
{
    slow = skew * low;
    shigh = skew * high;
    ac, env1, env2 = clipEnv(x, skew); // using a fast 'slide()' on these envs can be interesting (boomy)
	age = heat * 0.995262; // pete stuff
    pos = x * slow * env1 * hyst1 * (1 - age);
    neg = x * shigh * env2 * hyst2 * (1 + age);
	// dcblock pre mix so our taps have round edges
    dcpos = dcblock(pos);
    dcneg = dcblock(neg);
    beides = softhard ? (pos + neg) : (dcpos + dcneg); // high gain
    return beides, dcpos, dcneg;
}


//  //  //  Atan Clip   //  //  //
// the rest of the atan functions are in 'evi_saturators.genexpr' etc


// gain compensation wrapper around the atan() function
atanDriveV(drive)
{
	pre = maximum(drive, 1);
	post = maximum((1 / atanA(drive)), 0.1); // naive approx for control rate
	return pre, post;
}


//	//	//	Diode Clip	//	//	//
// here we remake what we already have in the 'evi_clipping.genexpr' to expose gain and bias as inlets

// Copyright (C) 2022-2024 Orastron Srl unipersonale
// Stefano D'Angelo, GPL v3

// omega
w3v(x)
{
	x1 = -3.341459552768620;
	x2 =  8;
	a  = -1.314293149877800e-3;
	b  =  4.775931364975583e-2;
	c  =  3.631952663804445e-1;
	d  =  6.313183464296682e-1;
	return (x < x1) ? 0 : ((x < x2) ? d + x * (c + x * (b + x * a)) : x - logApprox(x));
}

w4v(x) // Wright's omega
{
	y = w3v(x);
	return y - (y - expApprox(x - y)) / (y + 1);
}

// coefficients
diodeCoeffsV(SR) // param rate, in fact this only ever needs updating if the samplerate changes
{
	// component values
	// Is	= 0.0000000000000001;
	// R	= 2200;
	// C	= 0.00000001;
	Param	CR(0.000022); 			// C * R
	Param	IR(0.00000000000022);	// Is * R
	Param	VT(0.026);

	// absolute constants
	k1 = 45454.545454545454545;		// 1 / (C * R)
	k4 = 38.461538461538462;		// 1 / VT

	// samplerate dependent constants
	B0 =  SR + SR;
	B1 = -B0;
	B2 =  B0 * CR + 1;
	// A1 =  1;

	// k
	k2 = CR / B2;
	k3 = IR / B2;
	k5 = logApprox(IR / (B2 * VT));	// this must be logApprox()
	k6 = B1 - B0;

	return k1, k2, k3, k4, k5, k6, VT;//, A1;
}

// naive
diodeV(Vin, k1, k2, k3, k4, k5, k6, VT, reset) // audio rate
{
	History	p1(0);
	if (reset) {
		p1 = 0;
	}

	q = k1 * Vin - p1;
	r = xSgn(q);
	w = k2 * q + k3 * r;

	Vout = w - VT * r * w4v(k4 * r * w + k5);
	// p1 = k6 * Vout - A1 * p1;
	p1 = k6 * Vout - p1;
  
	return Vout;
}

// for gain & bias as params, @see: 'evi_clipping.genexpr'

// naive wrap
diodeWrapGB(Vin, k1, k2, k3, k4, k5, k6, VT, gain, bias, reset)
{
	History didu(0);
	d0 = gain * Vin + bias;
	d1 = diodeV(d0, k1, k2, k3, k4, k5, k6, VT, reset);
	return dcblock(d1 - w4v(bias));
}

// naive 2x quasi oversampling (cubic4)
diodeGB_2x_4POINT(XIN, k1, k2, k3, k4, k5, k6, VT, gain, bias, reset)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 2x
	y1_0	= diodeWrapGB(x1_0, k1, k2, k3, k4, k5, k6, VT, gain, bias, reset);
	y2_0	= diodeWrapGB(x2_0, k1, k2, k3, k4, k5, k6, VT, gain, bias, reset);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return (y0_0);
}

// naive 4x quasi oversampling (cubic4)
diodeGB_4x_4POINT(XIN, k1, k2, k3, k4, k5, k6, VT, gain, bias, reset)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 2x
	y1_0	= diodeGB_2x_4POINT(x1_0, k1, k2, k3, k4, k5, k6, VT, gain, bias, reset);
	y2_0	= diodeGB_2x_4POINT(x2_0, k1, k2, k3, k4, k5, k6, VT, gain, bias, reset);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return (y0_0);
}

// naive 8x quasi oversampling (cubic4)
diodeGB_8x_4POINT(XIN, k1, k2, k3, k4, k5, k6, VT, gain, bias, reset)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 8x
	y1_0	= diodeGB_4x_4POINT(x1_0, k1, k2, k3, k4, k5, k6, VT, gain, bias, reset);
	y2_0	= diodeGB_4x_4POINT(x2_0, k1, k2, k3, k4, k5, k6, VT, gain, bias, reset);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return (y0_0);
}

//	//	//

// for filter 2x oversampling
diodeV2(Vin0, Vin1, k1, k2, k3, k4, k5, k6, VT, reset)
{
	// shared state

	History	p1(0);
	if (reset) {
		p1 = 0;
	}

	// pass 1

	q0 = k1 * Vin0 - p1;
	r0 = xSgn(q0);
	w0 = k2 * q0 + k3 * r0;

	Vout0 = w0 - VT * r0 * w4v(k4 * r0 * w0 + k5);
	p1 = k6 * Vout0 - p1;

	// pass 2

	q1 = k1 * Vin1 - p1;
	r1 = xSgn(q1);
	w1 = k2 * q1 + k3 * r1;

	Vout1 = w1 - VT * r1 * w4v(k4 * r1 * w1 + k5);
	p1 = k6 * Vout1 - p1;

	// returns

	return Vout0, Vout1;
}

// for filter 4x oversampling
diodeV4(Vin0, Vin1, Vin2, Vin3, k1, k2, k3, k4, k5, k6, VT, reset)
{
	// shared state

	History	p1(0);
	if (reset) {
		p1 = 0;
	}

	// pass 1

	q0 = k1 * Vin0 - p1;
	r0 = xSgn(q0);
	w0 = k2 * q0 + k3 * r0;

	Vout0 = w0 - VT * r0 * w4v(k4 * r0 * w0 + k5);
	p1 = k6 * Vout0 - p1;

	// pass 2

	q1 = k1 * Vin1 - p1;
	r1 = xSgn(q1);
	w1 = k2 * q1 + k3 * r1;

	Vout1 = w1 - VT * r1 * w4v(k4 * r1 * w1 + k5);
	p1 = k6 * Vout1 - p1;

	// pass 3

	q2 = k1 * Vin2 - p1;
	r2 = xSgn(q2);
	w2 = k2 * q2 + k3 * r2;

	Vout2 = w2 - VT * r2 * w4v(k4 * r2 * w2 + k5);
	p1 = k6 * Vout2 - p1;

	// pass 4

	q3 = k1 * Vin3 - p1;
	r3 = xSgn(q3);
	w3 = k2 * q3 + k3 * r3;

	Vout3 = w3 - VT * r3 * w4v(k4 * r3 * w3 + k5);
	p1 = k6 * Vout3 - p1;

	// returns

	return Vout0, Vout1, Vout2, Vout3;
}

// for filter 8x oversampling
diodeV8(Vin0, Vin1, Vin2, Vin3, Vin4, Vin5, Vin6, Vin7, k1, k2, k3, k4, k5, k6, VT, reset)
{
	// shared state

	History	p1(0);
	if (reset) {
		p1 = 0;
	}

	// pass 1

	q0 = k1 * Vin0 - p1;
	r0 = xSgn(q0);
	w0 = k2 * q0 + k3 * r0;

	Vout0 = w0 - VT * r0 * w4v(k4 * r0 * w0 + k5);
	p1 = k6 * Vout0 - p1;

	// pass 2

	q1 = k1 * Vin1 - p1;
	r1 = xSgn(q1);
	w1 = k2 * q1 + k3 * r1;

	Vout1 = w1 - VT * r1 * w4v(k4 * r1 * w1 + k5);
	p1 = k6 * Vout1 - p1;

	// pass 3

	q2 = k1 * Vin2 - p1;
	r2 = xSgn(q2);
	w2 = k2 * q2 + k3 * r2;

	Vout2 = w2 - VT * r2 * w4v(k4 * r2 * w2 + k5);
	p1 = k6 * Vout2 - p1;

	// pass 4

	q3 = k1 * Vin3 - p1;
	r3 = xSgn(q3);
	w3 = k2 * q3 + k3 * r3;

	Vout3 = w3 - VT * r3 * w4v(k4 * r3 * w3 + k5);
	p1 = k6 * Vout3 - p1;

	// pass 5

	q4 = k1 * Vin4 - p1;
	r4 = xSgn(q4);
	w4 = k2 * q4 + k3 * r4;

	Vout4 = w4 - VT * r4 * w4v(k4 * r4 * w4 + k5);
	p1 = k6 * Vout4 - p1;

	// pass 6

	q5 = k1 * Vin5 - p1;
	r5 = xSgn(q5);
	w5 = k2 * q5 + k3 * r5;

	Vout5 = w5 - VT * r5 * w4v(k4 * r5 * w5 + k5);
	p1 = k6 * Vout5 - p1;

	// pass 7

	q6 = k1 * Vin6 - p1;
	r6 = xSgn(q6);
	w6 = k2 * q6 + k3 * r6;

	Vout6 = w6 - VT * r6 * w4v(k4 * r6 * w6 + k5);
	p1 = k6 * Vout6 - p1;

	// pass 8

	q7 = k1 * Vin7 - p1;
	r7 = xSgn(q7);
	w7 = k2 * q7 + k3 * r7;

	Vout7 = w7 - VT * r7 * w4v(k4 * r7 * w7 + k5);
	p1 = k6 * Vout7 - p1;

	// returns

	return Vout0, Vout1, Vout2, Vout3, Vout4, Vout5, Vout6, Vout7;
}

//	//	//

// fixed 2x quasi oversampling (cubic4)
diodeV2_2x(XIN, k1, k2, k3, k4, k5, k6, VT, reset)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 2x
	y1_0, y2_0	= diodeV2(x1_0, x2_0, k1, k2, k3, k4, k5, k6, VT, reset);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}

// fixed 4x quasi oversampling (cubic4)
diodeV4_4x(XIN, k1, k2, k3, k4, k5, k6, VT, reset)
{	// up 4
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// up 4x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.25,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= cubic_hermite_interp(0.5,	    umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0	= cubic_hermite_interp(0.75,	umTm1_0, umT0_0, umT1_0, x0_0_a);

	// process 4x
	y1_0, y2_0, y3_0, y4_0	= diodeV4(x1_0, x2_0, x3_0, (umT1_0 + 0), k1, k2, k3, k4, k5, k6, VT, reset);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(0.5,	    y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3);

    // this seems the wrong way to sum to me
	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return y0_0;
}

// fixed 8x quasi oversampling (cubic4)
diodeV8_8x(XIN, k1, k2, k3, k4, k5, k6, VT, reset)
{	// up 8
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 8
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	History	dmT2_4(0), dmT1_4(0), dmT0_4(0);
	History	dmT2_5(0), dmT1_5(0), dmT0_5(0);
	History	dmT2_6(0), dmT1_6(0), dmT0_6(0);
	History	dmT2_7(0), dmT1_7(0), dmT0_7(0);
	// align
	History	doX0(0);

	// up 8x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.125,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= cubic_hermite_interp(0.25,    umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0	= cubic_hermite_interp(0.375,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x4_0	= cubic_hermite_interp(0.5,	    umTm1_0, umT0_0, umT1_0, x0_0_a);
	x5_0	= cubic_hermite_interp(0.625,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x6_0	= cubic_hermite_interp(0.75,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x7_0	= cubic_hermite_interp(0.875,	umTm1_0, umT0_0, umT1_0, x0_0_a);

	// process 8x
	y1_0, y2_0, y3_0, y4_0, y5_0, y6_0, y7_0, y8_0	
        = diodeV8(x1_0, x2_0, x3_0, x4_0, x5_0, x6_0, x7_0, (umT1_0 + 0), k1, k2, k3, k4, k5, k6, VT, reset);

	// down 8x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.125,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(0.25,    y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.375,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3);

	y5_0_a	= y5_0 + 0;
	y5_1	= cubic_hermite_interp(0.5,	    y5_0_a,	dmT0_4, dmT1_4, dmT2_4);

	y6_0_a	= y6_0 + 0;
	y6_1	= cubic_hermite_interp(0.625,	y6_0_a,	dmT0_5, dmT1_5, dmT2_5);

	y7_0_a	= y7_0 + 0;
	y7_1	= cubic_hermite_interp(0.75,	y7_0_a,	dmT0_6, dmT1_6, dmT2_6);

	y8_0_a	= y8_0 + 0;
	y8_1	= cubic_hermite_interp(0.875,	y8_0_a,	dmT0_7, dmT1_7, dmT2_7);

    // this seems the wrong way to sum to me
	y0_0	= (((((((doX0 + y2_1) + y3_1) + y4_1) + y5_1) + y6_1) + y7_1) + y8_1) * 0.125;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	dmT2_4	= dmT1_4;
	dmT1_4	= dmT0_4;
	dmT0_4	= y5_0;

	dmT2_5	= dmT1_5;
	dmT1_5	= dmT0_5;
	dmT0_5	= y6_0;

	dmT2_6	= dmT1_6;
	dmT1_6	= dmT0_6;
	dmT0_6	= y7_0;

	dmT2_7	= dmT1_7;
	dmT1_7	= dmT0_7;
	dmT0_7	= y8_0;

	return y0_0;
}

//	//	//

diodeWrapGB_2x(Vin, k1, k2, k3, k4, k5, k6, VT, gain, bias, reset)
{
	History didu2(0);
	d0 = gain * Vin + bias;
	d1 = diodeV2_2x(d0, k1, k2, k3, k4, k5, k6, VT, reset);
	return dcblock(d1 - w4v(bias));
}

diodeWrapGB_4x(Vin, k1, k2, k3, k4, k5, k6, VT, gain, bias, reset)
{
	History didu4(0);
	d0 = gain * Vin + bias;
	d1 = diodeV4_4x(d0, k1, k2, k3, k4, k5, k6, VT, reset);
	return dcblock(d1 - w4v(bias));
}

diodeWrapGB_8x(Vin, k1, k2, k3, k4, k5, k6, VT, gain, bias, reset)
{
	History didu8(0);
	d0 = gain * Vin + bias;
	d1 = diodeV8_8x(d0, k1, k2, k3, k4, k5, k6, VT, reset);
	return dcblock(d1 - w4v(bias));
}
