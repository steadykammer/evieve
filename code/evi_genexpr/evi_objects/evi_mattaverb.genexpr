
// lib for...
// evi_mattaverb.gendsp by Pete for evieve
// a simple allpass diffusion reverb with minimal controls interaction
// true stereo input/output, no early reflections, designed wet and spacey but very dampable
// based on ancient macroisations by my friend Matt Jackson, has elements of our Diffuse.amxd


// cheap tan approx for BLT
tnA(x)								// 0..1 input
{
	x2 = (x * x);
	x3 = (x2 * x);
	x5 = (x2 * x3);
	return ((x5 * 0.133333) + (x3 * 0.333333)) + x;
}

expA(x0)							// approx exp(x) (more accurate than 'fastexp()')
{
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;
	x *= x; x *= x; x *= x; x *= x; x *= x;
	return x;
}

tauA(t)								// approximate 'exp(-1 / (seconds * samplerate))'
{
	y = expA(-1 / (t * samplerate));
	return y + 0.000128;			// approximation has excellent accuracy above...
}									// ...0.01 seconds (10 milliseconds) input

quartOneParApprox(modphase)								// 'modphase' must be clipped 0..1
{
	x0		=  modphase - 0.5;							// 1 sub
	// first quarter									// angle = 0 .. halfpi
	quart	= -0.8284271247461903 * x0 * x0 + sqrt1_2;	// 2 mul, 1 add, (-0.8284271247461903 = 2 - 4*sqrt1_2)
	sinq1	=  quart + x0;								// 1 add
	cosq1	=  quart - x0;								// 1 sub

	return	cosq1, sinq1;
}

// + offset = accurate for input pitch 48 .. pitch 69
mtofApprox(pitch, base)
{
	mtofA = base * expA(0.057762265 * (pitch - 69));
	return mtofA + 0.120906;
}

// accuracy as native
mtofBaseless(pitch)
{
	mtofMul	= 0.05776226504666;		// = log(2) / 12
	mtofAdd	= 2.10117843869262;		// = log(440) - (log(2) * 69 / 12)

	return	exp((mtofMul * pitch) + mtofAdd);
}

dbtoaApprox(db)
{
	dbtoaA = expA(0.11512925464970 * db);
	return dbtoaA + 0.000128;		// + offset = 0 dB == 1 amplitude
}

gainCoeff(normalised)
{
	return (2 - normalised) * normalised;
}

filterParams(high, low, base)		// 0..1 % = no damp .. maximum damp
{
	hiPass	= mtofApprox((high * 24) + 40, base);
	loPass	= mtofApprox(((1 - low) * 34) + 86, base);
	hiAtten	= gainCoeff(high);// * -18;					// not dB anymore...
	loAtten	= gainCoeff(low);// * -12;					// ...
	return	hiPass, hiAtten, loPass, loAtten;			// Hz, % 0..1, Hz, % 0..1
}

sizeParams(size)					// a(n almost) faithful matt's macroisation homage
{
	sizeMod = (0.31 - (size * -0.69)) * size;
	sizeModClip = minimum(sizeMod, 0.2);
	sizeClipNorm = sizeModClip + sizeModClip + sizeModClip + sizeModClip + sizeModClip;
	sizeL = (30 - (sizeMod * 16)) + ((1 - (sizeClipNorm * sizeClipNorm)) * 12);
	sizeR = sizeL - ((gainCoeff(size) * 2) + 1);
//	diff = (scale(sizeModClip, 0, 0.2, 0.6, 1, 0.363) * ((maximum(sizeMod, 0.0001) / 24) + 0.5)) * -1;	// matt
//	diff = -((sqrt((sizeModClip + sizeModClip) + 0.6) * (maximum(sizeMod, 0.0001) * 0.041667 + 0.5)));	// compromise
	// bigger range, cheaper compute:
	diff = -((((sizeModClip + sizeModClip) + 0.6) * sqrt((sizeMod * 0.363) + sqrt1_2) * (maximum(sizeMod, 0.0001) * 0.041667 + 0.5)));
	rt60dB = sizeMod * -96;
	modA = (1.5 - size) * size;
	modAmount = (modA + modA + 0.5) * 24;
	modSpread = (size * size * 0.76) + 0.22;
	return sizeL, sizeR, diff, rt60dB, modAmount, modSpread;
}

pitch2time(pitch)	// 'pitch' in, samples out
{
//	return (1 / (440 * expA(0.057762265046662105 * (pitch - 69)))) * samplerate;
	// we need the exp() accuracy here low in the range
	return (1 / exp((0.057762265046662105 * pitch) + 2.10117843869262)) * samplerate;
}

expsmooth(x, t)						// t is smooth time in seconds
{
	History w(0);
	z = tauA(t);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expso(x, z)
{
	History w(0);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expsmoothBank2(x1, x2, t)
{
	History	expsdummy2(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	return	y1, y2;
}

logsad(s)
{
	return	LN2 / maximum((s * samplerate), 1);
}

logsmooth(x, s)						// s = time to drop 6dB (in seconds)
{
	History z(0);
	ad = logsad(s);
	y  = ((x - z) * ad) + z;
	z  = y;
	return y;
}

logso(x, ad)
{
	History z(0);
	y = ((x - z) * ad) + z;
	z = y;
	return y;
}

logsmoothBank2(x1, x2, s)
{
	History	logsdummy2(0);
	ad		= logsad(s);
	y1		= logso(x1, ad);
	y2		= logso(x2, ad);
	return	y1, y2;
}

eviScurve(segment)					// segment must be linear ramp 0..1
{
	s2		= segment * segment;
	rec		= 1 - segment;
	r2		= rec * rec;
	return	(segment < 0.5) ? (s2 * 2) : (1 - (r2 * 2));
}

// basic linear scaling like linear part of [scale]
eviMap(valueIn, inLow, inHigh, outLow, outHigh)
{
	multiplier = (outLow - outHigh) / (inLow - inHigh);
	return (valueIn - inLow) * multiplier + outLow;
}

eviLine(target, duration)			// target, duration in samples
{
	History	value(0);
	trigger	= change(target);
	ramp	= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);
	line	= eviMap(ramp, 0, 1, latch(value, trigger), latch(target, trigger));
	value	= line;
	return	line, (ramp == 1);
}

eviSline(target, duration)			// target, duration in samples
{
	History	value(0);
	trigger	= change(target);
	ramp	= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);
	cramp	= eviScurve(ramp);
	curve	= eviMap(cramp, 0, 1, latch(value, trigger), latch(target, trigger));
	value	= curve;
	return	curve, (ramp == 1);
}

// fixed mode=0 version, no branching, keep out of while loop in export
rcDampCoeffs0(cutoff, damp)
{
	// prewarp
	g0		=  tnA(pi * cutoff / samplerate);
	// account for pass/shelf
	ka	=  abs(damp);					// 0..1 = sqrt..lin
	ks	= (ka * 0.5) + 0.5;
	g01	=  1 + g0;
	g1 	=  g0 / interp((2 * (ks - 0.5)), sqrt(g01), g01, mode="linear");
	// shelf/pass (damp) control
	d1	= interp((2 * (((1 - ks) + 0.5) - 0.5)), sqrt(ka), ka, mode="linear");

	return g1, d1;						// rc filter warped cf (g)	// rc filter warped gain (k)
}

// fixed mode=2 version, no branching, keep out of while loop in export
rcDampCoeffs2(cutoff, damp)
{
	// prewarp
	g0		=  tnA(pi * cutoff / samplerate);
	// account for pass/shelf
	ka	=  abs(damp);				// 0..1 = sqrt..lin
	ks	= (ka * 0.5) + 0.5;
	g01	=  1 + g0;
	g1 	=  g0 / interp((2 * (ks - 0.5)), sqrt(g01), g01, mode="linear");
	// shelf/pass (damp) control
	d1	= -(pow(4, damp) - 1);		// !! this is just horrible !!
	// extend attenuation range to make pass choice
	d1	=  (d1 > 0) ? (d1 * 1.333333) : d1;

	return g1, d1;					// rc filter warped cf (g)	// rc filter warped gain (k)
}

// High or Low Pass if k == 1, Bypass if k == 0, else Low or High Shelf boost / attenuation
rcFilterDamp(Vin, g, k)				// g = pre-warped normalised frequency (g / (1 + g))
{
	History	   s(0);
	Lp		= (g * Vin + s) / (g + 1);
	s		=  2 * Lp - s;
	Hp		=  Lp - Vin;			// !! must be y-x way round for shelfs !!

	LpHs	=  Vin + (k * Hp);
	HpLs	= (k * Lp) - Vin;

	return	   HpLs, LpHs;
}

allpassDiffuseShort(x, time, diffusion)
{
	History	apdiffshort(0);
	Delay	AllpassDiffuseS(int(samplerate*0.029090208+1.5), 1, feedback=1);

	fb		= AllpassDiffuseS.read(time, interp="cubic");
	y		= (x * -(diffusion)) + fb;
	AllpassDiffuseS.write(x + (fixdenorm(y) * diffusion));

	return	y;
}

allpassDiffuseLong(x, time, diffusion)
{
	History	apdifflong(0);
	Delay	AllpassDiffuseL(int(samplerate*0.045295298+1.5), 1, feedback=1);

	fb		= AllpassDiffuseL.read(time, interp="cubic");
	y		= (x * -(diffusion)) + fb;
	AllpassDiffuseL.write(x + (fixdenorm(y) * diffusion));

	return	y;
}

allpassDiffuseDamp(x, time, diffusion, g0, k0, g1, k1, damp)
{
	History	apdiffdamp(0);
	Delay	AllpassDiffuseD(int(samplerate*0.055983894+1.5), 1, feedback=1);

	fb		= AllpassDiffuseD.read(time, interp="spline");
	if ( (damp) && ( (k0 != 0) || (k1 != 0) ) ) {
		fb	= rcFilterDamp(fb, g0, k0);
		fb	= rcFilterDamp(fb, g1, k1);
	}
	y		= (x * -(diffusion)) + fb;
	AllpassDiffuseD.write(x + (fixdenorm(y) * diffusion));

	return	y;
}

// cheap parabolic approx
parabolWrap(phase)
{
	x	= wrap(phase, -0.5, 0.5);
	y	= (8 - (abs(x) * 16)) * x;
	return	y;
}

// 8 sine modulators (4 L, 4 R), 1 phase
// a bit funky
eightModMatt(modFreq, modDepth, modSpread)
{
	modulation1, modulation3, modulation6, modulation8	= 0;
	modulation2, modulation4, modulation5, modulation7	= 0;

	if (modDepth > 0) {

		modPhase	= phasor(modFreq) - 0.5;

		modulation4	= parabolWrap(modPhase + 0.125);
		modulation6	= parabolWrap(modPhase + 0.25);
		modulation8	= parabolWrap(modPhase + 0.375);
		modulation2	= parabolWrap(modPhase + 0.5);

		modulation3	= (-(modulation4) + 1) * modDepth;
		modulation5	= (-(modulation6) + 1) * modDepth;
		modulation7	= (-(modulation8) + 1) * modDepth;
		modulation1	= (-(modulation2) + 1) * modDepth;

		modulation2	= (modulation2 + 1) * modDepth;
		modulation4	= (modulation4 + 1) * modDepth;
		modulation6	= (modulation6 + 1) * modDepth;
//		mod8		= (modulation8 + 1);
//		freqMod		= (2 - mod8);
//		modulation8	= (mod8 * modDepth);
		modulation8	= (modulation8 + 1) * modDepth;

		modulation5 = mix(modulation1, modulation5, modSpread);
		modulation6 = mix(modulation2, modulation6, modSpread);
		modulation7 = mix(modulation3, modulation7, modSpread);
		modulation8 = mix(modulation4, modulation8, modSpread);

	}

	return	modulation1, modulation2, modulation3, modulation4, modulation5, modulation6, modulation7, modulation8;
}

xfadeQuartApproxStereo(a, b, c, d, q)						// q is control, must be clipped 0..1
{
	qL, qR	= quartOneParApprox(q);							// cos/sin
	return	((a * qL) + (c * qR)), ((b * qL) + (d * qR));	// out mix L, out mix R
}

