
// Deluxe but dirty MS20-inspired old-school-style filter emulation,
// 12dB lowpass or 6dB highpass.
// Based on a classic by Tony Hardie-Bick ("DFM-1 Digital Filter Module"), 2010.
// Thanks to Jonny Stutters for his SuperCollider port, 2011.
// Dirty MSP/gen~ reworking by fat Pete, 2013 (thanks to Matt Jackson for the LUT assistance).
// LICENSE: GPLv2.

// @see: "evi_korgms10.gendsp", "evi_korgms20.gendsp" & "evi_korgms20_select.gendsp"
// for better (?) 'emulations' of the Korg MS-10 / MS-20 filter chips.

require("evi_smooth.genexpr");				// incl. "_utilities" & _approx"
require("evi_sources.genexpr");
require("evi_interp.genexpr");

// noise...

// wrap box-muller with local gain stage
gaussnoise(ngain)
{
	History noisedummy(0);
	nc = 0.00001;
	ng = (ngain < nc) ? nc : (ngain * 0.05);
	return ng * gaussianNoise(0.6403882032022076);
}

// nonlinear...

// cubic nonlinearity (thb)
dnl(x0)
{
	nb = 0.55032120814910446;	// thb 'transfer function'
	x1	= clip(x0, -1, 1);
	nx	= nb * x1;
	nx3 = nx * nx * nx;
	return	x1 - (nx3 + nx3);
}

// fixed 3x fake oversampling
dnl3x(XIN)
{	// up 3
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// up 3x
	x0_0_a	= XIN + 0;
	x1_0	= umT0_0 + 0;
	x2_0	= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");
	x3_0	= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");

	// process 3x
	y1_0	= dnl(x1_0);
	y2_0	= dnl(x2_0);
	y3_0	= dnl(x3_0);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");
	y3_0_a	= y3_0 + 0;
	y3_1	= interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2, mode="spline");

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return dcblock(y0_0);
}

// make oversampling choice on nonlinearity
dnlNonlin(xin, oversampling)
{
	History dnldummy(0);
//	N = 0.55032120814910446;
	y = 0;
	if (oversampling > 0) {			// use 3x
		y = dnl3x(xin);
	} else {						// use 1x
		y = dnl(xin);
	}
	return y;
}

// thb filter...

// x = direct input;
// l = lowpass gain;
// h = highpass gain;
// a = stage 1 coefficient (factor of cutoff & lut);
// b = stage 2 coefficient (factor of cutoff & lut);
// r = resonance corrected (factor of cutoff, resonance & lut);
// noisegain = noise injection level;
// POSTGAIN = postgain const;
// HEADROOM = headroom (factor of noise in filter);
// nl = internal nonlinearity 'oversampling' choice;
dft(x, l, h, a, b, r, noisegain, POSTGAIN, HEADROOM, nl)
{
	History za(0), zb(0), zr(0), zh(0);
	History zy(0), zn(0);								// output

	// non-linearity
	zy = dnlNonlin(zb, nl);

	// filter
	za = x * l + r * (zy - zr) + a * za;				// stage 1
	zb = za * (1 - b) + (x - zh) * h + b * zb + zn;		// stage 2

	// update
	zh = x;
	zr = zy;
	zn = gaussnoise(noisegain);

	return (zy * HEADROOM) * POSTGAIN;
}

dft2(x0, x1, l, h, a, b, r, noisegain, POSTGAIN, HEADROOM, nl)
{
	History za(0), zb(0), zr(0), zh(0);
	History zy0(0), zy1(0), zn(0);						// output

	// pass 1

	// nonlinearity
	zy0 = dnlNonlin(zb, nl);

	// filter
	za = x0 * l + r * (zy0 - zr) + a * za;				// stage 1
	zb = za * (1 - b) + (x0 - zh) * h + b * zb + zn;	// stage 2

	// update
	zh = x0;
	zr = zy0;

	zn = gaussnoise(noisegain);

	// pass 2

	// nonlinearity
	zy1 = dnlNonlin(zb, nl);

	// filter
	za = x1 * l + r * (zy1 - zr) + a * za;				// stage 1
	zb = za * (1 - b) + (x1 - zh) * h + b * zb + zn;	// stage 2

	// update
	zh = x1;
	zr = zy1;

	return (zy0 * HEADROOM) * POSTGAIN, (zy1 * HEADROOM) * POSTGAIN;
}

// fixed 2x quasi oversampling (hermite6)
dft2_2x6( XIN, l, h, a, b, r, noisegain, POSTGAIN, HEADROOM, nl )
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 2x
    y1_0, y2_0 = dft2(x1_0, x2_0, l, h, a, b, r, noisegain, POSTGAIN, HEADROOM, nl);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return y0_0;
}

// fixed 2x quasi oversampling (cubic4)
dft2_2x4( XIN, l, h, a, b, r, noisegain, POSTGAIN, HEADROOM, nl )
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 2x
	y1_0, y2_0	= dft2(x1_0, x2_0, l, h, a, b, r, noisegain, POSTGAIN, HEADROOM, nl);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}

// fixed 3x bad oversampling
dft3x(XIN, l, h, a, b, r, ng, n, nl)
{	// up 3
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// up 3x
	x0_0_a	= XIN + 0;
	x1_0	= umT0_0 + 0;
	x2_0	= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");
	x3_0	= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");

	// process 3x
	y1_0	= dft(x1_0,		l, h, a, b, r, ng, n, nl);
	y2_0	= dft(x2_0,		l, h, a, b, r, ng, n, nl);
	y3_0	= dft(x3_0,		l, h, a, b, r, ng, n, nl);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");
	y3_0_a	= y3_0 + 0;
	y3_1	= interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2, mode="spline");

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return dcblock(y0_0);
}

// fixed 12x very bad oversampling
dft12x(XIN, l, h, a, b, r, ng, n, nl)
{	// up 4
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// up 4x
	x0_0_a	= XIN + 0;
	x1_0	= interp(0.25,	umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");
	x2_0	= interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");
	x3_0	= interp(0.75,	umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");

	// process 12x
	y1_0	= dft3x(x1_0,		l, h, a, b, r, ng, n, nl);
	y2_0	= dft3x(x2_0,		l, h, a, b, r, ng, n, nl);
	y3_0	= dft3x(x3_0,		l, h, a, b, r, ng, n, nl);
	y4_0	= dft3x(umT1_0 + 0,	l, h, a, b, r, ng, n, nl);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");

	y3_0_a	= y3_0 + 0;
	y3_1	= interp(0.5,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2, mode="spline");

	y4_0_a	= y4_0 + 0;
	y4_1	= interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3, mode="spline");

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return dcblock(y0_0);
}

// make oversampling etc choice on entire filter
dfts(x, l, h, a, b, r, N, os)		// os fades between 1..2..1 if filter switched lowpass..highpass..lowpass,
{									//  otherwise 'int' selector
	History dftsdummy(0);
	POSTGAIN = 1.425;				// (1 - 0.05) * 3 / 2
	HEADROOM = (1 - (N * 0.05)) * 0.998849;
	NLOS = 0;//(os == 0);
	y = 0;
	if (os == 1) {					// use 2x oversampling lowpass
		y = dft2_2x6(x, l, h, a, b, r, N, POSTGAIN, HEADROOM, NLOS);
	} else if (os > 1 && os < 2) {
		y = interp(os,
			dft2_2x6(x, l, h, a, b, r, N, POSTGAIN, HEADROOM, NLOS),
			dft2_2x4(x, l, h, a, b, r, N, POSTGAIN, HEADROOM, NLOS),
			mode="cosine");			// better plop
	} else if (os == 2) {			// use 2x oversampling highpass
		y = dft2_2x4(x, l, h, a, b, r, N, POSTGAIN, HEADROOM, NLOS);
	} else if (os == 3) {			// use fake 12x
		y = dft12x(x, l, h, a, b, r, N, POSTGAIN, HEADROOM, NLOS);
	} else {						// 1x
		y = dft(x, l, h, a, b, r, N, POSTGAIN, HEADROOM, NLOS);
	}
	return dcblock(y);
}

