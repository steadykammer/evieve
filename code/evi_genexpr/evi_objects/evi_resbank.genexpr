
// three different resonant-like filters for filterbank style setups
// by pete for evieve


// approxes

expA(x0)
{
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;
	x *= x; x *= x; x *= x; x *= x; x *= x;
	return x;
}

tauA(t)
{
	y = expA(-1 / (t * SAMPLERATE));
	return y + 0.000128;
}

tanA2(x)							// tan(0..halfpi)
{
	a	= ((((x * -0.0896638) + 0.0388452) * x) + 1.00005) * x;
	b	= (((x * -0.430871) + 0.0404318) * x) + 1;
	return	a / b;
}

cosQ32(x)
{
	c1 =  0.99940307;
	c2 = -0.49558072;
	c3 =  0.03679168;
	x2 =  x * x;
	return (c1 + x2 * (c2 + c3 * x2));
}

cos32(x) {
	twodivpi = 0.63661977236758;	// 2 / pi
	x = x % TWOPI;
	x = (x < 0) ? -x : x;
	quad = int(x * twodivpi);		// get quadrant # (0 to 3) we're in
	// param rate version (keep out of while loop)
	return (quad == 0) ? cosQ32(x) : (quad == 1) ? -cosQ32(PI - x) : (quad == 2) ? -cosQ32(x - PI) : cosQ32(TWOPI - x);
}

acosT(x)			// for x 1..0.2, rubbish, but fine for this usage
{
	onediveleven = 0.09090909090909091;
	sq1x = sqrt(1 - x);
	return	SQRT2 * (sq1x + onediveleven * (sq1x * sq1x * sq1x));
}

expApprox(x)
{
	x = 1 + (0.062500309 + (0.0019527233 + (0.0000408663 + (0.00000060184965 + 0.000000010856791*x)*x)*x)*x)*x;
	x *= x; x *= x; x *= x;
	return x*x;
}

pow2Approx(y) // approx pow(2, y)
{
	return expApprox(y * LN2);
}

coshApprox(x)
{
	return 0.5 * (expApprox(x) + expApprox(-x));
}

log2Approx(x) // sorry
{
	return (-0.2119568027628040757e-1 + (-0.38815224340108325886 + (-0.8900051141728954376 + (0.4001641794691007527
			+ (0.79615191430677253059 + 0.10303694407435362078*x)*x)*x)*x)*x) /
				(0.298115002929551095e-2 + (0.1066700361116609290 + (0.6070463053447878628 + (0.8584931203106122717
					+ (0.30170842595823793523 + 0.16863931436090069014e-1*x)*x)*x)*x)*x);
}

logApprox(x)
{
	return LN2 * log2Approx(x);
}

log10Approx(x)
{
	return 0.3010299956639811 * log2Approx(x); // log10(2)*log2(x)
}


// smoothing

logsad(s)									// s = time to drop 6dB (in seconds)
{
	return	LN2 / (s * SAMPLERATE);
//	return	LN2 / maximum((s * SAMPLERATE), 1);// incl. maximum check
}

logso(x, ad)
{
	History z(0);
	y = ((x - z) * ad) + z;
	z = y;
	return y;
}

logsmooth(x, s)
{
	History	logsdummy1(0);
	ad		= logsad(s);
	y		= logso(x, ad);
	return	y;
}

logsmoothBank2(x1, x2, s)
{
	History	logsdummy2(0);
	ad		= logsad(s);
	y1		= logso(x1, ad);
	y2		= logso(x2, ad);
	return	y1, y2;
}

expso(x, z)									// z is pole
{
	History w(0);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expsmoothBank2(x1, x2, t)
{
	History	expsdummy2(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	return	y1, y2;
}

expsmoothBank4(x1, x2, x3, x4, t)
{
	History	expsdummy4(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	y4		= expso(x4, z);
	return	y1, y2, y3, y4;
}

eviMap(valueIn, inLow, inHigh, outLow, outHigh)	// basic linear scaling like linear part of [scale]
{
    multiplier = (outLow - outHigh) / (inLow - inHigh);
    return (valueIn - inLow) * multiplier + outLow;
}

eviLine(target, duration)						// target, duration in samples
{
	History val(0);
    trigger	= change(target);
    ramp	= clamp(accum((1 / latch(duration, trigger)), trigger), 0, 1);
    lin 	= eviMap(ramp, 0, 1, latch(val, trigger), latch(target, trigger));
    val 	= lin;
    return  lin, (ramp == 1);
}


// nonlin

hermite_sixpoint_interp(f0, ym2, ym1, y0, y1, y2, y3)
{
	f1		=  f0 - 0.5;
	even1	= ym2 + y3;
	odd1	= ym2 - y3;
	even2	= ym1 + y2;
	odd2	= ym1 - y2;
	even3	=  y0 + y1;
	odd3	=  y0 - y1;

	c0	= 0.01171875*even1		- 0.09765625*even2		+ 0.5859375*even3;
	c1	= 0.2109375*odd2		- 1.463541666667*odd3	- 0.033854166667*odd1;
	c2	= 0.40625*even2			- 0.354166666667*even3	- 0.052083333333*even1;
	c3	= 0.1875*odd1			- 1.104166666667*odd2	+ 2.375*odd3;
	c4	= 0.020833333333*even1	- 0.0625*even2			+ 0.041666666667*even3;
	c5	= 1.041666666667*odd2	- 2.083333333333*odd3	- 0.208333333333*odd1;

	return ((((c5*f1 + c4)*f1 + c3)*f1 + c2)*f1 + c1)*f1 + c0;
}

funcSc0(x) // tanh Lambert approx
{
	x2 = x * x;
	a = (((x2 + 378) * x2 + 17325) * x2 + 135135) * x;
	b = ((28 * x2 + 3150) * x2 + 62370) * x2 + 135135;
	return clamp((a / b), -1, 1); // clamp() ?
}

funcSc1(x)
{
	// only possible to use approxes for first antiderivative, 2nd order does not work with these approxes :-(
	return logApprox(coshApprox(x));
}

adSc1(x)	// first antiderivative only
{
	History x1(0), ad1_x1(0);
	TOL = 0.00001; // i've seen this in some sources as 0.018
	xmx1 = x - x1;
	illCondition = abs(xmx1) < TOL;
	ad1_x = funcSc1(x);

	y = 0;
	if (illCondition) {
		y = funcSc0(0.5 * (x + x1));
	} else {
		y = (ad1_x - ad1_x1) / xmx1;
	}

	ad1_x1 = ad1_x;
	x1 = x;

	return y;
}

adSc1_2x_6POINT(XIN)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 2x
	y1_0	= adSc1(x1_0);
	y2_0	= adSc1(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return dcblock(y0_0);
}


// coefficients

rcPreWarp0(cutoff)
{
	return	tanA2(PI * cutoff / SAMPLERATE);
}

svfButterCoeffs(R)	// TODO: could optimise more by just using cosQ32()'s
{
	threepidiveight = 1.1780972450961724;
	pidiveight = 0.39269908169872414;

	a4 = acosT(R) * 0.251189;
	R1 = cos32(a4 + threepidiveight);
	R2 = cos32(threepidiveight - a4);
	R3 = cos32(a4 + pidiveight);
	R4 = cos32(pidiveight - a4);

	return R1+R1, R2+R2, R3+R3, R4+R4;
}

svfButterPreWarp(cutoff, resonance)				// use with "svfButterBp()"
{
	sR	= resonance;//sqrt(resonance);
	R	= 1 - (sR * 0.988553); // this mul upsets me (other people clip, but not me)
	RR	= R + R;

	R1, R2, R3, R4 = svfButterCoeffs(R);

	w0	= clip(rcPreWarp0(cutoff), 0.000001, HALFPI);
	pk	= ((1 - w0) * 0.41421356237309515) + 1;	// everybody needs a bosom for a pillow
	pksR = RR * (pk + (sqrt1_2 * sR));

	return w0, pksR, R1, R2, R3, R4;
}

// no dB gain required for filterbank usage
svfCoeffReson(hz, q)							// use with "svfSectionReson()"
{
	g 	= rcPreWarp0(hz);
	k 	= 1 / q;								// ('adaptive Q' goes here)
	a0	= 1 / (1 + g * (g + k));
	a1	= g * a0;
	a2 	= g * a1;
	// if k is const +6dB it is the same as MSP [reson~], just so you know :-)
	// however, if using in banks (e.g. via [mc.gen~] or [poly~] this multiplier is a total waste of cycles
	// and you could just comment out the below line and deal with linear gain globally
	//k = k * 1.995262;
	return 	a0, a1, a2, k;
}


// filters

// used for '1956'

svfButterBp(x, w, k)			// transposed tpt svf
{
	History	s1(0), s2(0);

	g0	= -((w * w) + (w * k));
	// this seems a bit suspicious to me (there must be a cheaper way)...
	y0	= x + (((x * g0) - ((s2 + (s1 * w)) + (s1 * k))) * (1 / (1 - g0)));
								// y0 = HP
	x1	= y0 * w;
	y1	= x1 + s1;				// y1 = BP

	x2	= y1 * w;
	y2	= x2 + s2;				// y2 = LP
//	y3	= y0 + y2;				// y3 = BN
//	y3	= y1 * k;				// y3 = BPn (y1 * r2)

	s1	= fixdenorm(x1 + y1);
	s2	= fixdenorm(x2 + y2);

	return y1;					// only BP required here
}

// used for '1998'

svfSectionReson(v0, a0, a1, a2)					// linear trapezoidal zdf
{
	History ic1eq(0), ic2eq(0);
    v3		=  v0 - ic2eq;
    v2		=  ic2eq + (a1 * ic1eq) + (a2 * v3);
    v1		= (a0 * ic1eq) + (a1 * v3);
    ic1eq	= fixdenorm(v1 + v1) - ic1eq;
    ic2eq	= fixdenorm(v2 + v2) - ic2eq;
    return 	v1;									// only v1 required for reson filter
}

// used for nonlinear-ish '1977'

onepole_init(x, g, s, k) {			// initial feedback loop settings
	spg = s + g;
	smg = s - g;
	x > spg * k ? spg : x;
	x < smg * k ? smg : x;
	return x;
}

onepole_II(g, s, w, n, z) {			// onepole part II - only signal after the delayed signal
	zz = z + z;
	g = g * w * n;
	s = ((s * w) + zz) * n;
	return g, s, zz;
}

onepole_I(y, w, n, z, zz) {			// onepole part I - direct signal mixed with the delayed signal
	t = ((y - (((y * w) + zz) * n)) * w) + z;
	return t + z, t;
}

// nonlinearity (usually with exit loop as function of k, but not here)
onepole_next(y, x, g, s, k)
{
//	t = tanhL(x - (k * y));
	t = adSc1((x - (k * y)), 0);	// 1st order antiderivative... ...2nd order is fucked
//	t = adSc1_2x_6POINT((x - (k * y)), 0);	// 1st order antiderivative but 2x oversampled
	return y - (((t * g) + s - y) / ((((t * t) - 1) * k * g) - 1));
}
/*
// for wraparound nonlinearity
onepole_sat(x, nl)
{
	y = 0;
	if (nl > 0) {
		k1, k2, k3, k4, k5, k6, VT, A1 = diodeCoeffs(SAMPLERATE);
		y = diode_2x_6POINT(x, k1, k2, k3, k4, k5, k6, VT, A1);
	} else {
		y = adSc2(x, 0);			// 2nd order antiderivative
	}
	return y;
}
*/
// it is a shocking bastardisation of an evieve transistor ladder
onepole4(x, w, k)
{
	History z1, z2, z3, z4;
	n = 1 / (w + 1);						// rcPreWarp1/2

	g, s, zz1 = onepole_II(1, 0, w, n, z1);	// filter cascade part II
	g, s, zz2 = onepole_II(g, s, w, n, z2);
	g, s, zz3 = onepole_II(g, s, w, n, z3);
	g, s, zz4 = onepole_II(g, s, w, n, z4);

	y  = onepole_init(x, g, s, k);
	y  = onepole_next(y, x, g, s, k);		// would normally be an iterative nonlinear cascade
//	y0 = onepole_sat((x - (y * k)), 0);		// for 'proper' ladder...
	y0 = x - (y * k * SQRT1_2);				// ...but none for our filterbank (must clamp w & k !)

	y1, z1 = onepole_I(y0, w, n, z1, zz1);	// filter cascade part I
	y2, z2 = onepole_I(y1, w, n, z2, zz2);
	y3, z3 = onepole_I(y2, w, n, z3, zz3);
	y4, z4 = onepole_I(y3, w, n, z4, zz4);

	// 1: LP_24dB, 2: LP_12dB, 3: BP_18dB, 4: HP_24dB	// HP only possible because no onepole_sat()
	return y4, y2, (-y3 + y4), ((y0 - y1) * 0.5);
}

