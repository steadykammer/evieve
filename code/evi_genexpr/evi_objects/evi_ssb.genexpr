
//	//	//	functions for the evieve single side band processors
//	//	//	@see: 'evi_freqshift_weaver.gendsp' & 'evi_freqshift_hilbert.gendsp'

require("evi_sinfold_lib.genexpr");
require("evi_cossin.genexpr");
require("evi_biquads_extras.genexpr");
require("evi_rcfilters.genexpr");

//  //  //

// complex ring mod
complexRing(real, imag, rmod, imod) {

	cosp = real * rmod;
	sinp = imag * imod;

	uppersideband = cosp + sinp;
	lowersideband = cosp - sinp;

	return uppersideband, lowersideband, cosp, sinp;
}

//  //  //

// actually different to what we end up with post-Adaa
sinFoldNaive(x, pidrive, sindrive)
{
	return sin(x * pidrive) * sindrive;
}

//  //  //

fWarp(cf)
{
	f = (cf * (PI / samplerate)) * (1 / TWOPI);
	w = (f - trunc(f)) * TWOPI;
	return tanA2(w);			// tan approximation (G for butterworth)
}

lp1p(x, g)							// 1-pole section
{
	History p(0);
	c = (x - p) * (g / (g + 1));
	y = c + p;
	p = c + y;
	return y;
}

lp2p(x, g, r)						// 2-pole zdf section
{
	History p0(0), p1(0);
	c0 = r + g;
	c1 = (g / ((c0 * g) + 1)) * (x - (p1 + (p0 * c0)));
	c2 = c1 + p0;
	c3 = c2 * g;
	y  = c3 + p1;
	p0 = c1 + c2;
	p1 = c3 + y;
	return y;
}

butterworthLowpass4(X, G)
{
	History bl4(0);

	y0	= lp2p(X,	G,	0.7653668647301797);
	Y	= lp2p(y0,	G,	1.8477590650225735);

	return Y;
}

butterworthLowpass8(X, G)
{
	History bl8(0);

	y0	= lp2p(X,	G,	0.3901806440322567);
	y1	= lp2p(y0,	G,	1.1111404660392046);
	y2	= lp2p(y1,	G,	1.6629392246050905);
	Y	= lp2p(y2,	G,	1.9615705608064609);

	return Y;
}

//  //  //

