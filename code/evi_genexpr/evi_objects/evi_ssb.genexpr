  // down 2x
  y2_0_a  = y2_0 + 0;
  y2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

  y0_0  = (doX0 + y2_1) * 0.5;

  // update
  umTm2_0 = umTm1_0;
  umTm1_0 = umT0_0;
  umT0_0  = umT1_0;
  umT1_0  = umT2_0;
  umT2_0  = x0_0_a;

  doX0  = y1_0;

  dmT3_1  = dmT2_1;
  dmT2_1  = dmT1_1;
  dmT1_1  = dmT0_1;
  dmT0_1  = dmTm1_1;
  dmTm1_1 = y2_0;

  return dcblock(y0_0);
}

//  //  //

sinFoldAdaa1(x, pidrive, sindrive)
{
	return sinAdaa1(x * pidrive) * sindrive;
}

sinFoldAdaa1_2x(x, pidrive, sindrive)
{
	return sinAdaa1_2x_6POINT(x * pidrive) * sindrive;
}

sinFoldAdaa1_4x(x, pidrive, sindrive)
{
	return sinAdaa1_4x_6POINT(x * pidrive) * sindrive;
}

sinFoldAdaa2(x, pidrive, sindrive)
{
	return sinAdaa2(x * pidrive) * sindrive;
}

sinFoldAdaa2_2x(x, pidrive, sindrive)
{
	return sinAdaa2_2x_6POINT(x * pidrive) * sindrive;
}

sinFoldAdaa2_4x(x, pidrive, sindrive)
{
	return sinAdaa2_4x_6POINT(x * pidrive) * sindrive;
}

//  //  //

log2Approx(x) // sorry
{
  return (-0.2119568027628040757e-1 + (-0.38815224340108325886 + (-0.8900051141728954376 + (0.4001641794691007527
      + (0.79615191430677253059 + 0.10303694407435362078*x)*x)*x)*x)*x) /
        (0.298115002929551095e-2 + (0.1066700361116609290 + (0.6070463053447878628 + (0.8584931203106122717
          + (0.30170842595823793523 + 0.16863931436090069014e-1*x)*x)*x)*x)*x);
}

logApprox(x)
{
  return LN2 * log2Approx(x);
}

log1pApprox(x)
{
  if (x > -1.0e-8 && x < 1.0e-8)
    return x - (x * x) * 0.5;

  return logApprox(1 + x);
}

expA(x0)							// more accurate than 'fastexp()'
{
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;
	x *= x; x *= x; x *= x; x *= x; x *= x;
	return x;
}

tauA(t)								// t is time in seconds
{
	y = expA(-1 / (t * samplerate));
	return y + 0.000128;
}

// transpose semitones input (0=none), like [transratio] & [evi.transratio]
transratioApprox(pitch)					// pitch default = 0
{
	return expA(0.05776226504666 * pitch) + 0.000128;
}

// more accurate than the ftom approx
mtofApproxBaseless(pitch)
{
	mtofA = 440 * transratioApprox(pitch - 69);
	return mtofA + 0.120906;		// + offset = accurate for input 48..69
}

// very accurate from approx 20..5000 Hz input,
// actually perfect for pitch output 51..76
// below 20Hz input, output is a bit funky (should clip), above 5k input, output
// increasingly inaccurate until input/output off by about 2 semitones at 125..129 pitch
ftomApproxBaseless(frequency)
{
	ftomA = 69 + (17.312340490668193 * logApprox(frequency / 440));
	return ftomA;
}

dbtoaApprox(db)
{
	dbtoaA = expA(0.11512925464970 * db);
	return dbtoaA + 0.000128;		// + offset = 0 dB == 1 amplitude
}

fWarp(cf)
{
	f = (cf * (PI / samplerate)) * (1 / TWOPI);
	w = (f - trunc(f)) * TWOPI;
	return tanA2(w);				// tan approximation (G for butterworth)
}

// NOTE: this is broken
eviScurve(segment)					// segment must be linear ramp 0..1
{
	s2		= segment * segment;
	rec		= 1 - segment;
	r2		= rec * rec;
	return	(segment < 0.5) ? (s2 + s2) : (1 - (r2 + r2));
}

// basic linear scaling like linear part of [scale]
eviMap(valueIn, inLow, inHigh, outLow, outHigh)
{
	multiplier = (outLow - outHigh) / (inLow - inHigh);
	return (valueIn - inLow) * multiplier + outLow;
}

eviLine(target, duration)			// target, duration in samples
{
	History	value(0);
	trigger	= change(target);
	ramp	= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);
	line	= eviMap(ramp, 0, 1, latch(value, trigger), latch(target, trigger));
	value	= line;
	return	line, (ramp == 1);
}

eviSline(target, duration)			// target, duration in samples
{
	History	value(0);
	trigger	= change(target);
	ramp	= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);
	cramp	= eviScurve(ramp);
	curve	= eviMap(cramp, 0, 1, latch(value, trigger), latch(target, trigger));
	value	= curve;
	return	curve, (ramp == 1);
}

expso(x, z)							// z is pole
{
	History w(0);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expsmooth(x, t)						// t is smooth time in seconds
{
	History w(0);
	z = tauA(t);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expsmoothBank2(x1, x2, t)
{
	History	exps2dummy(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	return	y1, y2;
}

logsmooth(x, s)						// s = time to drop 6dB (in seconds)
{
	History z(0);
//	ad = LN2 / maximum((s * samplerate), 1);
	ad = LN2 / (s * samplerate);
	y  = ((x - z) * ad) + z;
	z  = y;
	return y;
}

// fixed mode=0 version, no branching, keep out of while loop
rcDampCoeffs(cutoff, damp)			// cutoff in Hz, damp clamp 0..1 (1 = highpass/lowpass)
{
	g0		=  tanA(PI * cutoff / samplerate);	// prewarp
	ks		= (damp * 0.5) + 0.5;	// damp 0..1 = sqrt..lin
	ks05	= (ks - 0.5);
	ksom	= ((1 - ks) + 0.5) - 0.5;
	g01		=  1 + g0;
	g1 		=  g0 / interp((ks05 + ks05), sqrt(g01), g01, mode="linear");
	d1		= interp((ksom + ksom), sqrt(damp), damp, mode="linear");
	return	g1, d1;					// rc filter warped cf (g)	// rc filter warped gain (k)
}

rcFilterHpLp(Vin, g)				// g = prewarped normalised frequency (g / (1 + g))
{
	History	  s(0);
	VoutLp	= (g * Vin + s) / (g + 1);
	s		= 2 * VoutLp - s;
	Hp		= Vin - VoutLp;
	return	  Hp, VoutLp;
}

// High or Low Pass if k == 1, Bypass if k == 0, else Low or High Shelf boost / attenuation
rcFilterDamp(Vin, g, k)				// g = pre-warped normalised frequency (g / (1 + g))
{
	History	   s(0);
	Lp		= ( g * Vin + s) / (g + 1);
	s		= (Lp + Lp) - s;
	Hp		=  Lp - Vin;			// !! must be y-x way round for shelfs !!

	LpHs	=  Vin + (k * Hp);
	HpLs	= (k * Lp) - Vin;

	return	   HpLs, LpHs;
}

lp1p(x, g)							// 1-pole section
{
	History p(0);
	c = (x - p) * (g / (g + 1));
	y = c + p;
	p = c + y;
	return y;
}

lp2p(x, g, r)						// 2-pole zdf section
{
	History p0(0), p1(0);
	c0 = r + g;
	c1 = (g / ((c0 * g) + 1)) * (x - (p1 + (p0 * c0)));
	c2 = c1 + p0;
	c3 = c2 * g;
	y  = c3 + p1;
	p0 = c1 + c2;
	p1 = c3 + y;
	return y;
}

butterworthLowpass4(X, G)
{
	History bl4(0);

	y0	= lp2p(X,	G,	0.7653668647301797);
	Y	= lp2p(y0,	G,	1.8477590650225735);

	return Y;
}

butterworthLowpass8(X, G)
{
	History bl8(0);

	y0	= lp2p(X,	G,	0.3901806440322567);
	y1	= lp2p(y0,	G,	1.1111404660392046);
	y2	= lp2p(y1,	G,	1.6629392246050905);
	Y	= lp2p(y2,	G,	1.9615705608064609);

	return Y;
}

