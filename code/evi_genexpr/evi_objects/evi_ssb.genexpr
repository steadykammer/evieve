
//	//	//	functions for the evieve single side band processors
//	//	//	@see: 'evi_freqshift_weaver.gendsp' & 'evi_freqshift_hilbert.gendsp'

// for first quarter only, optimized so that never lets sqrt(sinapprox(x)^2+cosapprox(x)^2)
// exceed 1, always gives exact results at modphase 0, 0.5, 1 (0/1, sqrt1_2, 1/0)
quartParApproxOne(modphase)								// 'modphase' must be clamped 0..1
{
	x0		=  modphase - 0.5;							// 1 sub
	// first quarter									// angle = 0 .. HALFPI
	quart	= -0.8284271247461903 * x0 * x0 + sqrt1_2;	// 2 mul, 1 add, (-0.8284271247461903 = 2 - 4*sqrt1_2)
	sinq1	=  quart + x0;								// 1 add
	cosq1	=  quart - x0;								// 1 sub

	return	cosq1, sinq1;
}

xfadeQuartApproxMono(a, c, q)		// q is control, must be clamped 0..1
{
	qL, qR	= quartParApproxOne(q);	// cos/sin
	return	((a * qL) + (c * qR));	// out mix L + out mix R
}

tanA(x)								// cheaper approx tan(0..1)
{
	x2		= (x * x);
	x3		= (x2 * x);
	x5		= (x2 * x3);
	return	 ((x5 * 0.133333) + (x3 * 0.333333)) + x;
}

tanA2(x)							// better approx tan(0..HALFPI)
{
	a	= ((((x * -0.0896638) + 0.0388452) * x) + 1.00005) * x;
	b	= (((x * -0.430871) + 0.0404318) * x) + 1;
	return	a / b;
}

// in this setup the quad osc must be high quality and precise, not approx
quadratureOsc(thisphase, thisspread)// thisspread is of course nuts and experimental, must == 0.75
{
	re		= cycle(thisphase, index="phase");
	im		= cycle(wrap(thisphase + thisspread, 0, 1), index="phase");

	return	re, im;
}

// better complex oscs, thanks to Martin Vicanek
quadOsc(frequency, reset)
{
	History	u(1), v(0);				// init cos, init sin

	w1		= TWOPI * frequency / samplerate;
	k1		= tanA2(0.5*w1);
	k2		= (k1 + k1) / (1 + k1*k1);

	omega	= u - k1*v;
	v		= reset ? 0 : v + k2*omega;
	u		= reset ? 1 : omega - k1*v;

	return	u, v;					// cos, sin
}

// better complex oscs with sync outs
quadOscSync(frequency, reset)
{
	History	u(1), v(0);				// init cos, init sin

	w1		= TWOPI * frequency / samplerate;
	k1		= tanA2(0.5*w1);
	k2		= (k1 + k1) / (1 + k1*k1);

	omega	= u - k1*v;
	v		= reset ? 0 : v + k2*omega;
	u		= reset ? 1 : omega - k1*v;
									// normalised phase:
	vsync	= change(v > 0) > 0;	// + 0.00 for sin zero-crossing
	usync	= change(u > 0) > 0;	// + 0.75 for cos zero-crossing

	return	u, v, usync, vsync;		// cos, sin, cossync, sinsync
}

// complex ring mod
complexRing(real, imag, rmod, imod) {

	cosp = real * rmod;
	sinp = imag * imod;

	uppersideband = cosp + sinp;
	lowersideband = cosp - sinp;

	return uppersideband, lowersideband, cosp, sinp;
}

// Transposed Direct Form 2
biquadTdf2(x0, a0, a1, a2, b1, b2)
{
	History	x1(0), x2(0);

	y1	=  (x0 * a0)  +  x2;
	x2	= ((x0 * a1)  - (y1 * b1)) + x1;
	x1	=  (x0 * a2)  - (y1 * b2);

	return	y1;
}

// 8-pole Polyphase IIR Halfband Allpass Cascade
// Biquad Cascade
// (this could be optimised by getting rid of the lazy biquads and unrolling)
evi_hilbert_biquads(y0, hc1, hc2, hc3, hc4, hc5, hc6, hc7, hc8)
{
	// align
	History x0(0);
	// first phase allpass cascade (phase reference path c coefficients)
	x1	= biquadTdf2(x0,		hc1,	0, -1, 0,	-hc1);
	x2	= biquadTdf2(x1,		hc2,	0, -1, 0,	-hc2);
	x3	= biquadTdf2(x2,		hc3,	0, -1, 0,	-hc3);
	x4	= biquadTdf2(x3,		hc4,	0, -1, 0,	-hc4);
	// second phase allpass cascade (+90 degrees path c coefficients)
	y1	= biquadTdf2(y0,		hc5,	0, -1, 0,	-hc5);
	y2	= biquadTdf2(y1,		hc6,	0, -1, 0,	-hc6);
	y3	= biquadTdf2(y2,		hc7,	0, -1, 0,	-hc7);
	y4	= biquadTdf2(y3,		hc8,	0, -1, 0,	-hc8);
	// update
	x0	= y0;
	// real, imaginary
	return	x4, y4;
}

// Transposed Direct Form 2, with a1, a2, b1 & b2 factored out as per hilbert allpass
hilbertTdf2(x0, a0)
{
	History	x1(0), x2(0);

	y1	= (x0  *  a0) +  x2;
	x2	=  x1;
	x1	= -x0  - (y1  * -a0);

	return	y1;
}

// 8-pole Polyphase IIR Halfband Allpass Cascade, optimised
// Biquad Cascade
evi_hilbert_cascade(y0, hc1, hc2, hc3, hc4, hc5, hc6, hc7, hc8)
{
	// align
	History x0(0);
	// first phase allpass cascade (phase reference path c coefficients)
	x1	= hilbertTdf2(x0,	hc1);
	x2	= hilbertTdf2(x1,	hc2);
	x3	= hilbertTdf2(x2,	hc3);
	x4	= hilbertTdf2(x3,	hc4);
	// second phase allpass cascade (+90 degrees path c coefficients)
	y1	= hilbertTdf2(y0,	hc5);
	y2	= hilbertTdf2(y1,	hc6);
	y3	= hilbertTdf2(y2,	hc7);
	y4	= hilbertTdf2(y3,	hc8);
	// update
	x0	= y0;
	// real, imaginary
	return	x4, y4;
}

cubic_hermite_interp(f, y0, y1, y2, y3)
{
//	c0		= y1;
	c1		= 0.5 * (y2 - y0);
	c2		= y0 - 2.5 * y1 + y2 + y2 - 0.5 * y3;
	c3		= 0.5 * (y3 - y0) + 1.5 * (y1 - y2);
	return	((c3 * f + c2) * f + c1) * f + y1;
}

hermite_sixpoint_interp(f0, ym2, ym1, y0, y1, y2, y3)
{
  f1    =  f0 - 0.5;
  even1 = ym2 + y3;
  odd1  = ym2 - y3;
  even2 = ym1 + y2;
  odd2  = ym1 - y2;
  even3 =  y0 + y1;
  odd3  =  y0 - y1;

  c0  = 0.01171875*even1    - 0.09765625*even2    + 0.5859375*even3;
  c1  = 0.2109375*odd2    - 1.463541666667*odd3 - 0.033854166667*odd1;
  c2  = 0.40625*even2     - 0.354166666667*even3  - 0.052083333333*even1;
  c3  = 0.1875*odd1     - 1.104166666667*odd2 + 2.375*odd3;
  c4  = 0.020833333333*even1  - 0.0625*even2      + 0.041666666667*even3;
  c5  = 1.041666666667*odd2 - 2.083333333333*odd3 - 0.208333333333*odd1;

  return ((((c5*f1 + c4)*f1 + c3)*f1 + c2)*f1 + c1)*f1 + c0;
}

cosQ32(x)
{
	c1 =  0.99940307;
	c2 = -0.49558072;
	c3 =  0.03679168;

	x2 =  x * x;
	return (c1 + x2 * (c2 + c3 * x2));
}

cos32quad12(x)	// cheap cheat, not exactly correct
{									// no branching, stay out of while loop
	return (x < 0.636619772368) ? cosQ32(x) : -cosQ32(PI - x);
}

// based on an idea by jhno & Trond Lossius
sinParam(drive)						// for param rate
{
	pidrive		= drive*3.110176727054 + 0.031415926536;
	sindrive	= 1 / cos32quad12(HALFPI - minimum(pidrive, HALFPI));
	return	pidrive, sindrive;
}

// actually different to what we end up with post-Adaa
sinFoldNaive(x, pidrive, sindrive)
{
	return sin(x * pidrive) * sindrive;
}

