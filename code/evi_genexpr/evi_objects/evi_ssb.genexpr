//	//	//	functions for the evieve single side band processors
//	//	//	@see: 'evi_freqshift_weaver.gendsp' & 'evi_freqshift_hilbert.gendsp'

require("evi_sinfold_lib.genexpr");
require("evi_cossin.genexpr");
require("evi_biquads_extras.genexpr");
require("evi_rcfilters.genexpr");
require("evi_butterworth.genexpr");

//  //  //

// complex ring mod
complexRing(real, imag, rmod, imod) {

	cosp = real * rmod;
	sinp = imag * imod;

	uppersideband = cosp + sinp;
	lowersideband = cosp - sinp;

	return uppersideband, lowersideband, cosp, sinp;
}

//  //  //
