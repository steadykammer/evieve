*/

sinJ0(x)
{
  return sin(x);
}

sinJ1(x)
{
  return -cos(x);
}

sinJ2(x)
{
  return -sin(x);
}

// About "eps" precision in the Adaa1 & Adaa2:
// "0.00000001" just about works for all oversampling factors we use here,
// but it is not perfect. It is very hard to get the sweet spot.
// The problem is is that our oversampling is not real oversampling but
// just an interpolation hack, and this has an effect on the very small numbers.
// I might program something like this:
/*
	eps = (osf == 2) ? 0.000000000001 : ((osf == 4) ? 0.00000001 : 0.000001);
*/
// ...where "osf" is the integer oversampling factor 2, 4 or 8,
// passed into the Adaa* function. This would be horrible of course.

sinAdaa1(x0)
{
  History x1(0), s1(0);
  eps = 0.00000001;   // TODO
	//  0.0000000001  // 
  y1 = x0;
  d0 = x0 - x1;
  s0 = sinJ1(x0);    // func1
  if ((x1 == 0 && s1 == 0) || (abs(d0) < eps)) {  // ill condition
	y1 = sinJ0(0.5 * (x0 + x1)); // func0
  } else {
	y1 = (s0 - s1) / d0;
  }

  s1 = s0;
  x1 = x0;
  return y1;
}

sinAdaa2(x0)
{
  History x1(0), x2(0), s1(0);
  eps = 0.00000001;   // TODO
	//  0.0000000001  // 
  s0 = x0;
  d0 = x0 - x1;
  f2_x1 = sinJ2(x1); // func2
  if (abs(d0) < eps) {  // ill condition
	s0 = sinJ1(0.5 * (x0 + x1)); // func1
  } else {
	s0 = (sinJ2(x0) - f2_x1) / d0; // func2
  }

  y1 = x0;
  d1 = x0 - x2;
  if (x1 == 0 && x2 == 0) { // ill condition
	y1 = sinJ0(x0 + (x1 + x1) + x2) * 0.25; // func0
  } else if (abs(d1) < eps) { // ill condition
	x_bar = 0.5 * (x0 + x2);
	x_delta = x_bar - x1;
	if (x_delta < eps) {  // ill condition
	  y1 = sinJ0((x_bar + x1) * 0.5);  // func0
	} else {
	  y1 = (2 / x_delta) * (sinJ1(x_bar) + (f2_x1 - sinJ2(x_bar)) / x_delta); // func1, func2
	}
  } else {
	s0s1 = s0 - s1;
	y1 = (s0s1 + s0s1) / d1;
  }

  s1 = s0;
  x2 = x1;
  x1 = x0;
  return y1;
}

// sinAdaa1 oversampling...

// fixed 2x quasi oversampling (hermite6)
sinAdaa1_2x_6POINT(XIN)
{ // up 2
  History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
  // down 2
  History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
  // align
  History doX0(0);

  // up 2x
  x0_0_a  = XIN + 0;
  x1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
  x2_0  = umT2_0 + 0;

  // process 2x
  y1_0  = sinAdaa1(x1_0);
  y2_0  = sinAdaa1(x2_0);

  // down 2x
  y2_0_a  = y2_0 + 0;
  y2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

  y0_0  = (doX0 + y2_1) * 0.5;

  // update
  umTm2_0 = umTm1_0;
  umTm1_0 = umT0_0;
  umT0_0  = umT1_0;
  umT1_0  = umT2_0;
  umT2_0  = x0_0_a;

  doX0  = y1_0;

  dmT3_1  = dmT2_1;
  dmT2_1  = dmT1_1;
  dmT1_1  = dmT0_1;
  dmT0_1  = dmTm1_1;
  dmTm1_1 = y2_0;

  return dcblock(y0_0);
}

// fixed 4x quasi oversampling (hermite6)
sinAdaa1_4x_6POINT(XIN)
{ // up 2
  History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
  // down 2
  History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
  // align
  History doX0(0);

  // up 2x
  x0_0_a  = XIN + 0;
  x1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
  x2_0  = umT2_0 + 0;

  // process 4x
  y1_0  = sinAdaa1_2x_6POINT(x1_0);
  y2_0  = sinAdaa1_2x_6POINT(x2_0);

  // down 2x
  y2_0_a  = y2_0 + 0;
  y2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

  y0_0  = (doX0 + y2_1) * 0.5;

  // update
  umTm2_0 = umTm1_0;
  umTm1_0 = umT0_0;
  umT0_0  = umT1_0;
  umT1_0  = umT2_0;
  umT2_0  = x0_0_a;

  doX0  = y1_0;

  dmT3_1  = dmT2_1;
  dmT2_1  = dmT1_1;
  dmT1_1  = dmT0_1;
  dmT0_1  = dmTm1_1;
  dmTm1_1 = y2_0;

  return dcblock(y0_0);
}

// sinAdaa2 oversampling...

