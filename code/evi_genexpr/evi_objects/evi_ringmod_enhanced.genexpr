evieveRingmodAdaa1_4x(xin1, xin2, g, p, s, t)
{
	History x1(0), x2(0), y1(0);
	fdt     = 0.416666666667;
	tdt     = 0.666666666666;

	stage1  = xin1 + x1;
	stage2  = xin2 + x2;
	smix, l = rcFilterHpLp(stage1 * stage2 * fdt, g);
	
	rmod, emod  = 0;
	if (t) {    // waveshape mid chain, sometimes really cool
		rmod    = sinFoldAdaa1_4x(smix, p, s);
		emod    = rmod - fixdenorm(y1 * sqrt1_2);
	} else {    // waveshape end of chain, default
		rmod    = smix - fixdenorm(y1 * tdt);
		emod    = sinFoldAdaa1_4x(dcblock(rmod), p, s);
	}

	x1 = xin1;  // ff1
	x2 = xin2;  // ff2
	y1 = rmod;  // fb

	return dcblock(emod);
}

evieveRingmodAdaa2_2x(xin1, xin2, g, p, s, t)
{
	History x1(0), x2(0), y1(0);
	fdt     = 0.416666666667;
	tdt     = 0.666666666666;

	stage1  = xin1 + x1;
	stage2  = xin2 + x2;
	smix, l = rcFilterHpLp(stage1 * stage2 * fdt, g);
	
	rmod, emod  = 0;
	if (t) {    // waveshape mid chain, sometimes really cool
		rmod    = sinFoldAdaa2_2x(smix, p, s);
		emod    = rmod - fixdenorm(y1 * sqrt1_2);
	} else {    // waveshape end of chain, default
		rmod    = smix - fixdenorm(y1 * tdt);
		emod    = sinFoldAdaa2_2x(dcblock(rmod), p, s);
	}

	x1 = xin1;  // ff1
	x2 = xin2;  // ff2
	y1 = rmod;  // fb

	return dcblock(emod);
}

evieveRingmodAdaa2_4x(xin1, xin2, g, p, s, t)
{
	History x1(0), x2(0), y1(0);
	fdt     = 0.416666666667;
	tdt     = 0.666666666666;

	stage1  = xin1 + x1;
	stage2  = xin2 + x2;
	smix, l = rcFilterHpLp(stage1 * stage2 * fdt, g);
	
	rmod, emod  = 0;
	if (t) {    // waveshape mid chain, sometimes really cool
		rmod    = sinFoldAdaa2_4x(smix, p, s);
		emod    = rmod - fixdenorm(y1 * sqrt1_2);
	} else {    // waveshape end of chain, default
		rmod    = smix - fixdenorm(y1 * tdt);
		emod    = sinFoldAdaa2_4x(dcblock(rmod), p, s);
	}

	x1 = xin1;  // ff1
	x2 = xin2;  // ff2
	y1 = rmod;  // fb

	return dcblock(emod);
}

