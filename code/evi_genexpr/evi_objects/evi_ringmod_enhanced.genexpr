}

//  //  //

sinFoldAdaa1(x, pidrive, sindrive)
{
	return sinAdaa1(x * pidrive) * sindrive;
}

sinFoldAdaa1_2x(x, pidrive, sindrive)
{
	return sinAdaa1_2x_6POINT(x * pidrive) * sindrive;
}

sinFoldAdaa1_4x(x, pidrive, sindrive)
{
	return sinAdaa1_4x_6POINT(x * pidrive) * sindrive;
}

sinFoldAdaa2(x, pidrive, sindrive)
{
	return sinAdaa2(x * pidrive) * sindrive;
}

sinFoldAdaa2_2x(x, pidrive, sindrive)
{
	return sinAdaa2_2x_6POINT(x * pidrive) * sindrive;
}

sinFoldAdaa2_4x(x, pidrive, sindrive)
{
	return sinAdaa2_4x_6POINT(x * pidrive) * sindrive;
}

//  //  //

logsmooth(x, s)                     // s = time to drop 6dB (in seconds)
{
	History z(0);
//  ad = LN2 / maximum((s * samplerate), 1);
	ad = LN2 / (s * samplerate);
	y  = ((x - z) * ad) + z;
	z  = y;
	return y;
}

expso(x, z)                         // z is pole
{
	History w(0);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expsmoothBank2(x1, x2, t)           // t is smooth time in seconds
{
	History exps2dummy(0);
	z       = tauA(t);
	y1      = expso(x1, z);
	y2      = expso(x2, z);
	return  y1, y2;
}

fWarp(cf)
{
	f = (cf * (pi / samplerate)) * (1 / twopi);
	w = (f - trunc(f)) * twopi;
	return tanA2(w);                // tan approximation (G for butterworth)
}

rcPreWarp(cutoff)
{
	g0      =  tanA(pi * cutoff / samplerate);
	return  g0 / (1 + g0);
}

rcFilterHpLp(Vin, g)                // g = prewarped normalised frequency (g / (1 + g))
{
	History   s(0);
	VoutLp  = (g * Vin + s) / (g + 1);
	s       = (VoutLp + VoutLp) - s;
	Hp      = Vin - VoutLp;         // must be y-x
	return    Hp, VoutLp;
}

// fixed mode=0 version, no branching, keep out of while loop
rcDampCoeffs(cutoff, damp)          // cutoff in Hz, damp clamp 0..1 (1 = highpass/lowpass)
{
	g0      =  tanA(pi * cutoff / samplerate);  // prewarp
	ks      = (damp * 0.5) + 0.5;   // damp 0..1 = sqrt..lin
	ks05    = (ks - 0.5);
	ksom    = ((1 - ks) + 0.5) - 0.5;
	g01     =  1 + g0;
	g1      =  g0 / interp((ks05 + ks05), sqrt(g01), g01, mode="linear");
	d1      = interp((ksom + ksom), sqrt(damp), damp, mode="linear");
	return  g1, d1;                 // rc filter warped cf (g)  // rc filter warped gain (k)
}

// High or Low Pass if k == 1, Bypass if k == 0, else Low or High Shelf boost / attenuation
rcFilterDamp(Vin, g, k)             // g = pre-warped normalised frequency (g / (1 + g))
{
	History    s(0);
	Lp      = ( g * Vin + s) / (g + 1);
	s       = (Lp + Lp) - s;
	Hp      =  Lp - Vin;            // must be y-x

	LpHs    =  Vin + (k * Hp);
	HpLs    = (k * Lp) - Vin;

	return     HpLs, LpHs;
}

//  //  //

// based on "enhanced ring mod", after Beat Frei, ICST
// license at end of this file
simpleRingmod(xin1, xin2)
{
	History x1(0), x2(0), y1(0);

	stage1  = xin1 + x1;
	stage2  = xin2 + x2;
	smix    = (stage1 * stage2) * 0.416666666667;
	rmod    = smix - fixdenorm(y1 * 0.666666666666);

	x1 = xin1;
	x2 = xin2;
	y1 = rmod;

	return dcblock(rmod);
}

//

pDiode(vin, Vb, VL, H)	// piece-wise approx
{
	vout = 0;
	if (vin <= Vb) {
		vout = 0;
	} else {
		vlmvb = VL - Vb;
		vlvbmul = 1 / (vlmvb + vlmvb);
		if (vin <= VL) {
			vinmvb = vin - Vb;
			vout = vinmvb * vinmvb * vlvbmul;
		} else {
			vout = vin - (VL - (vlmvb * vlmvb * vlvbmul));
		}
		vout = vout * H;
	}
	return dcblock(vout);
}

// based on the Julian Parker 4-diode RingMod
pRingmod(car, mod, voltage, knee, slope)
{
	moddiv = mod * 0.5;
	carin = car + moddiv;
	modin = carin - moddiv;

	D1 = pDiode(carin, voltage, knee, slope);
	D2 = pDiode(-carin, voltage, knee, slope);
	D3 = pDiode(modin, voltage, knee, slope);
	D4 = pDiode(-modin, voltage, knee, slope);

	return dcblock((D1 + D2) - (D3 + D4));
}

// usage of above pRingmod:
/*
Param	voltage(0.598425, min=0, max=1);
Param	knee(0.598425, min=0, max=1);
Param	slope(0.993701, min=0.2, max=1.8);
invvolt	= 1 - voltage;
invknee	= invvolt + (1 - knee);
out1	= pRingmod(in1, in2, invvolt, invknee, slope);
*/
// ...but do not bother without insane amounts of oversampling :-(


// theoretically "evieveRingmod*()" could have even further
// output gain compensation depending on "sinFold*()"" drive ?

evieveRingmodAdaa1(xin1, xin2, g, p, s, t)
{
	History x1(0), x2(0), y1(0);
	fdt     = 0.416666666667;
	tdt     = 0.666666666666;

	stage1  = xin1 + x1;
	stage2  = xin2 + x2;
	smix, l = rcFilterHpLp(stage1 * stage2 * fdt, g);
	
	rmod, emod  = 0;
	if (t) {    // waveshape mid chain, sometimes really cool
		rmod    = sinFoldAdaa1(smix, p, s);
		emod    = rmod - fixdenorm(y1 * sqrt1_2);
	} else {    // waveshape end of chain, default
		rmod    = smix - fixdenorm(y1 * tdt);
		emod    = sinFoldAdaa1(dcblock(rmod), p, s);
	}

	x1 = xin1;  // ff1
	x2 = xin2;  // ff2
	y1 = rmod;  // fb

	return dcblock(emod);
}

