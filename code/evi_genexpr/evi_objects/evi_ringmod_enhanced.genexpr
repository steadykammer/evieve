  x1_0_b  = hermite_sixpoint_interp(0.5,  vmTm2_0, vmTm1_0, vmT0_0, vmT1_0, vmT2_0, x0_0_b);
  x2_0_b  = vmT2_0 + 0;

  // process 4x
  y1_0    = evieveRingmodAdaa2__2x_6POINT(x1_0_a, x1_0_b, g, p, s, t);
  y2_0    = evieveRingmodAdaa2__2x_6POINT(x2_0_a, x2_0_b, g, p, s, t);

  // down 2x
  y2_0_a  = y2_0 + 0;
  y2_1    = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

  y0_0    = (doX0 + y2_1) * 0.5;

  // update in1
  umTm2_0 = umTm1_0;
  umTm1_0 = umT0_0;
  umT0_0  = umT1_0;
  umT1_0  = umT2_0;
  umT2_0  = x0_0_a;

  // update in2
  vmTm2_0 = vmTm1_0;
  vmTm1_0 = vmT0_0;
  vmT0_0  = vmT1_0;
  vmT1_0  = vmT2_0;
  vmT2_0  = x0_0_b;

  doX0    = y1_0;

  dmT3_1  = dmT2_1;
  dmT2_1  = dmT1_1;
  dmT1_1  = dmT0_1;
  dmT0_1  = dmTm1_1;
  dmTm1_1 = y2_0;

  return dcblock(y0_0);
}

