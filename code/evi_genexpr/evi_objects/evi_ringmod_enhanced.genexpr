// fixed 4x quasi oversampling (hermite6), with two audio inlets, both resampled
evieveRingmodAdaa2_4x__4x_6POINT(XIN1, XIN2, g, p, s, t)
{ // up 2 in1
  History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
  // up 2 in2
  History vmTm2_0(0), vmTm1_0(0), vmT0_0(0), vmT1_0(0), vmT2_0(0);
  // down 2
  History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
  // align
  History doX0(0);

  // up 2x in1
  x0_0_a  = XIN1 + 0;
  x1_0_a  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
  x2_0_a  = umT2_0 + 0;

  // up 2x in2
  x0_0_b  = XIN2 + 0;
  x1_0_b  = hermite_sixpoint_interp(0.5,  vmTm2_0, vmTm1_0, vmT0_0, vmT1_0, vmT2_0, x0_0_b);
  x2_0_b  = vmT2_0 + 0;

  // process 4x
  y1_0    = evieveRingmodAdaa2_4x__2x_6POINT(x1_0_a, x1_0_b, g, p, s, t);
  y2_0    = evieveRingmodAdaa2_4x__2x_6POINT(x2_0_a, x2_0_b, g, p, s, t);

  // down 2x
  y2_0_a  = y2_0 + 0;
  y2_1    = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

  y0_0    = (doX0 + y2_1) * 0.5;

  // update in1
  umTm2_0 = umTm1_0;
  umTm1_0 = umT0_0;
  umT0_0  = umT1_0;
  umT1_0  = umT2_0;
  umT2_0  = x0_0_a;

  // update in2
  vmTm2_0 = vmTm1_0;
  vmTm1_0 = vmT0_0;
  vmT0_0  = vmT1_0;
  vmT1_0  = vmT2_0;
  vmT2_0  = x0_0_b;

  doX0    = y1_0;

  dmT3_1  = dmT2_1;
  dmT2_1  = dmT1_1;
  dmT1_1  = dmT0_1;
  dmT0_1  = dmTm1_1;
  dmTm1_1 = y2_0;

  return dcblock(y0_0);
}

// fixed 8x quasi oversampling (hermite6), with two audio inlets, both resampled
evieveRingmodAdaa2_4x__8x_6POINT(XIN1, XIN2, g, p, s, t)
{ // up 2 in1
  History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
  // up 2 in2
  History vmTm2_0(0), vmTm1_0(0), vmT0_0(0), vmT1_0(0), vmT2_0(0);
  // down 2
  History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
  // align
  History doX0(0);

  // up 2x in1
  x0_0_a  = XIN1 + 0;
  x1_0_a  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
  x2_0_a  = umT2_0 + 0;

  // up 2x in2
  x0_0_b  = XIN2 + 0;
  x1_0_b  = hermite_sixpoint_interp(0.5,  vmTm2_0, vmTm1_0, vmT0_0, vmT1_0, vmT2_0, x0_0_b);
  x2_0_b  = vmT2_0 + 0;

  // process 8x
  y1_0    = evieveRingmodAdaa2_4x__4x_6POINT(x1_0_a, x1_0_b, g, p, s, t);
  y2_0    = evieveRingmodAdaa2_4x__4x_6POINT(x2_0_a, x2_0_b, g, p, s, t);

  // down 2x
  y2_0_a  = y2_0 + 0;
  y2_1    = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

  y0_0    = (doX0 + y2_1) * 0.5;

  // update in1
  umTm2_0 = umTm1_0;
  umTm1_0 = umT0_0;
  umT0_0  = umT1_0;
  umT1_0  = umT2_0;
  umT2_0  = x0_0_a;

  // update in2
  vmTm2_0 = vmTm1_0;
  vmTm1_0 = vmT0_0;
  vmT0_0  = vmT1_0;
  vmT1_0  = vmT2_0;
  vmT2_0  = x0_0_b;

  doX0    = y1_0;

  dmT3_1  = dmT2_1;
  dmT2_1  = dmT1_1;
  dmT1_1  = dmT0_1;
  dmT0_1  = dmTm1_1;
  dmTm1_1 = y2_0;

  return dcblock(y0_0);
}


// for zdf linear butterworths

lp1p(x, g)                          // 1-pole section
{
	History p(0);
	c = (x - p) * (g / (g + 1));
	y = c + p;
	p = c + y;
	return y;
}

lp2p(x, g, r)                       // 2-pole zdf section
{
	History p0(0), p1(0);
	c0 = r + g;
	c1 = (g / ((c0 * g) + 1)) * (x - (p1 + (p0 * c0)));
	c2 = c1 + p0;
	c3 = c2 * g;
	y  = c3 + p1;
	p0 = c1 + c2;
	p1 = c3 + y;
	return y;
}

linearButterworthLP8(X, cutoff, order=3)
{
	Y       = 0;
	if (order > 0) {
		CF  = logsmooth(cutoff, 0.033111);
		G   = fWarp(CF);                // get G coefficient if not bypassed
		if          (order == 1) {
			Y   = lp1p(X,   G);
		} else if   (order == 2) {
			Y   = lp2p(X,   G, 1.4142135623730951);
		} else if   (order == 4) {
			y0  = lp2p(X,   G, 0.7653668647301797);
			Y   = lp2p(y0,  G, 1.8477590650225735);
		} else if   (order == 5) {
			y0  = lp2p(X,   G, 0.6180339887498949);
			y1  = lp2p(y0,  G, 1.618033988749895);
			Y   = lp1p(y1,  G);
		} else if   (order == 6) {
			y0  = lp2p(X,   G, 0.5176380902050419);
			y1  = lp2p(y0,  G, 1.4142135623730951);
			Y   = lp2p(y1,  G, 1.9318516525781366);
		} else if   (order == 7) {
			y0  = lp2p(X,   G, 0.4450418679126289);
			y1  = lp2p(y0,  G, 1.2469796037174672);
			y2  = lp2p(y1,  G, 1.8019377358048383);
			Y   = lp1p(y2,  G);
		} else if   (order == 8) {
			y0  = lp2p(X,   G, 0.39018064403225666);
			y1  = lp2p(y0,  G, 1.1111404660392046);
			y2  = lp2p(y1,  G, 1.6629392246050905);
			Y   = lp2p(y2,  G, 1.9615705608064609);
		} else {//  (order == 3)				// default
			y0  = lp2p(X,   G, 1.0000000000000002);
			Y   = lp1p(y0,  G);
		}

	} else {    //  (order == 0)			// bypassed
		Y   = X;
	}

	return Y;
}


