  vmTm1_0 = vmT0_0;
  vmT0_0  = vmT1_0;
  vmT1_0  = vmT2_0;
  vmT2_0  = x0_0_b;

  doX0    = y1_0;

  dmT3_1  = dmT2_1;
  dmT2_1  = dmT1_1;
