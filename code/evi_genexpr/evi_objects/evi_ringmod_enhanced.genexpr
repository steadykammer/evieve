//  //  //

// Adaa1... (only one)

// fixed 2x quasi oversampling (hermite6), with two audio inlets, both resampled
evieveRingmodAdaa1__2x_6POINT(XIN1, XIN2, g, p, s, t)
{ // up 2 in1
  History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
  // up 2 in2
  History vmTm2_0(0), vmTm1_0(0), vmT0_0(0), vmT1_0(0), vmT2_0(0);
  // down 2
  History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
  // align
  History doX0(0);

  // up 2x in1
  x0_0_a  = XIN1 + 0;
  x1_0_a  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
  x2_0_a  = umT2_0 + 0;

  // up 2x in2
  x0_0_b  = XIN2 + 0;
  x1_0_b  = hermite_sixpoint_interp(0.5,  vmTm2_0, vmTm1_0, vmT0_0, vmT1_0, vmT2_0, x0_0_b);
  x2_0_b  = vmT2_0 + 0;

  // process 2x
  y1_0    = evieveRingmodAdaa1(x1_0_a, x1_0_b, g, p, s, t);
  y2_0    = evieveRingmodAdaa1(x2_0_a, x2_0_b, g, p, s, t);

  // down 2x
  y2_0_a  = y2_0 + 0;
  y2_1    = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

  y0_0    = (doX0 + y2_1) * 0.5;

  // update in1
  umTm2_0 = umTm1_0;
  umTm1_0 = umT0_0;
  umT0_0  = umT1_0;
  umT1_0  = umT2_0;
  umT2_0  = x0_0_a;

  // update in2
  vmTm2_0 = vmTm1_0;
  vmTm1_0 = vmT0_0;
  vmT0_0  = vmT1_0;
  vmT1_0  = vmT2_0;
  vmT2_0  = x0_0_b;

  doX0    = y1_0;

  dmT3_1  = dmT2_1;
  dmT2_1  = dmT1_1;
  dmT1_1  = dmT0_1;
  dmT0_1  = dmTm1_1;
  dmTm1_1 = y2_0;

  return dcblock(y0_0);
}

// Adaa2 ...

// for Adaa2 & 2x, this does not work well on its own (the intracacies of precision
// and approximations etc), but we still use it as a building block for 4x & 8x

// fixed 2x quasi oversampling (hermite6), with two audio inlets, both resampled
evieveRingmodAdaa2__2x_6POINT(XIN1, XIN2, g, p, s, t)
{ // up 2 in1
  History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
  // up 2 in2
  History vmTm2_0(0), vmTm1_0(0), vmT0_0(0), vmT1_0(0), vmT2_0(0);
  // down 2
  History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
  // align
  History doX0(0);

  // up 2x in1
  x0_0_a  = XIN1 + 0;
  x1_0_a  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
  x2_0_a  = umT2_0 + 0;

  // up 2x in2
  x0_0_b  = XIN2 + 0;
  x1_0_b  = hermite_sixpoint_interp(0.5,  vmTm2_0, vmTm1_0, vmT0_0, vmT1_0, vmT2_0, x0_0_b);
  x2_0_b  = vmT2_0 + 0;

  // process 2x
  y1_0    = evieveRingmodAdaa2(x1_0_a, x1_0_b, g, p, s, t);
  y2_0    = evieveRingmodAdaa2(x2_0_a, x2_0_b, g, p, s, t);

  // down 2x
  y2_0_a  = y2_0 + 0;
  y2_1    = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

  y0_0    = (doX0 + y2_1) * 0.5;

  // update in1
  umTm2_0 = umTm1_0;
  umTm1_0 = umT0_0;
  umT0_0  = umT1_0;
  umT1_0  = umT2_0;
  umT2_0  = x0_0_a;

  // update in2
  vmTm2_0 = vmTm1_0;
  vmTm1_0 = vmT0_0;
  vmT0_0  = vmT1_0;
  vmT1_0  = vmT2_0;
  vmT2_0  = x0_0_b;

  doX0    = y1_0;

  dmT3_1  = dmT2_1;
  dmT2_1  = dmT1_1;
  dmT1_1  = dmT0_1;
  dmT0_1  = dmTm1_1;
  dmTm1_1 = y2_0;

  return dcblock(y0_0);
}

// fixed 4x quasi oversampling (hermite6), with two audio inlets, both resampled
evieveRingmodAdaa2__4x_6POINT(XIN1, XIN2, g, p, s, t)
{ // up 2 in1
  History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
  // up 2 in2
  History vmTm2_0(0), vmTm1_0(0), vmT0_0(0), vmT1_0(0), vmT2_0(0);
  // down 2
  History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
  // align
  History doX0(0);

  // up 2x in1
  x0_0_a  = XIN1 + 0;
  x1_0_a  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
  x2_0_a  = umT2_0 + 0;

  // up 2x in2
