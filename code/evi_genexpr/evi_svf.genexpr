	tiltR		= (yLR * cL) + yBR + (yHR * cH);
	return 		tiltL, tiltR;
}

// no "gain" used in this filter, but we remain consistent
// with inlets in case of patching situations, bad idea?
eviFilterAllpassNorm(x, cutoff, db, Q, smooth=0)// smooth time in ms
{
	History efandummy(0);
	smoothsecs	= smooth * 0.001;
	g, r, h, cL, cB, cH = tptSvfCoeffAllpassNorm(cutoff, 1, Q);
	yL, yB, yH 	= tptSvf(x, g, r, h);
	if (smooth > 0) {
		cB 		= expsmooth(cB, smoothsecs);
	}
	allpass		= yL + (yB * cB) + yH;
	return 		allpass;
}

eviFilterAllpassNormStereo(xL, xR, cutoff, db, Q, smooth=0)
{
	History efansdummy(0);
	smoothsecs	= smooth * 0.001;
	g, r, h, cL, cB, cH = tptSvfCoeffAllpassNorm(cutoff, 1, Q);
	yLL, yBL, yHL 	= tptSvf(xL, g, r, h);
	yLR, yBR, yHR 	= tptSvf(xR, g, r, h);
	if (smooth > 0) {
		cB 		= expsmooth(cB, smoothsecs);
	}
	allpassL	= yLL + (yBL * cB) + yHL;
	allpassR	= yLR + (yBR * cB) + yHR;
	return 		allpassL, allpassR;
}


//	//	//	different all-in-one sections (Simper)

//	//	//	LTO

svfLtoMulti(v0, cutoff, Q)
{
	History v0z(0), v1(0), v2(0);

	g	= tanA2(PI * cutoff / SAMPLERATE);
	k	= 1 / Q;
	gk	= g + k;

	ginv = g / (1 + g * gk);
	g1	 = ginv;
	g2	 = (gk + gk) * ginv;
	g3	 = g * ginv;
	g4	 = ginv + ginv;

	vlz	= v1;
	v2z	= v2;
	v3	= v0 + v0z - (v2z + v2z);
	v1 += g1 * v3 - g2 * vlz;
	v2 += g3 * v3 + g4 * vlz;
	v0z	= v0;

	notch	= v0 - k * band;		// notch
	low		= v2;					// low
	band	= v1;					// band
	high	= notch - low;			// high

	return	low, band, high, notch;
}

svfLtoSingle(v0, cutoff, Q, filt)
{
	History v0z(0), v1(0), v2(0);

	g	= tanA2(PI * cutoff / SAMPLERATE);
	k	= 1 / Q;
	gk	= g + k;

	ginv = g / (1 + g * gk);
	g1	 = ginv;
	g2	 = (gk + gk) * ginv;
	g3	 = g * ginv;
	g4	 = ginv + ginv;

	vlz	= v1;
	v2z	= v2;
	v3	= v0 + v0z - (v2z + v2z);
	v1 += g1 * v3 - g2 * vlz;
	v2 += g3 * v3 + g4 * vlz;
	v0z	= v0;

	y	= 0;
	if (filt == 1) {
		y	= v1;					// band
	} else if (filt == 2) {
		y	= v0 - k * v1 - v2;		// high
	} else if (filt == 3) {
		y	= v0 - k * v1;			// notch
	} else {// filt == 0
		y	= v2;					// low
    }

	return	y;
}

svfLtoBell(v00, cutoff, gain, Q)	// gain in dB !
{
	History v0z(0), v1(0), v2(0);

	gb	= fastpow(10, (gain * 0.025)) + 0.028652;
	g	= tanA2(PI * cutoff / SAMPLERATE);
	k	= (1 / Q) / gb;
	gk	= g + k;

	gi	 = k * (gb * gb - 1);
	ginv = g / (1 + g * gk);
	g1	 = ginv;
	g2	 = (gk + gk) * ginv;
	g3	 = g * ginv;
	g4	 = ginv + ginv;

	v0	= gi * v00;
	vlz	= v1;
	v2z	= v2;
	v3	= v0 + v0z - (v2z + v2z);
	v1 += g1 * v3 - g2 * vlz;
	v2 += g3 * v3 + g4 * vlz;
	v0z	= v0;

	return	v00 + v1;				// bell
}

//	//	//	Sin

// Solved for SIN (theoretically more stable low-end response when modulating
// but in always-64-bit-doubles environment of Gen should not make much difference.
// But these filters are different and interesting and support easy non-linear
// behaviour in a simple way

// i think this is the filter i manipulate for [evi.lores~]
svfSinMulti(X, cutoff, damp)
{
	History ic1eq(0), ic2eq(0);

	k	= 1 - (damp * 0.992);//1 - damp;	// shitty
	w	= PI * cutoff / SAMPLERATE;
	s1	= sin73(w);
	s2	= sin73(w + w);
	nrm	= 1 / (2 + (k * s1));				// k == damp
	g0	= s2 * nrm;
	g1	= ((-2 * s1 * s1) - (k * s2)) * nrm;
	g2	= ((s1 + s1) * s1) * nrm;

	t0	=   X - ic2eq;						// X == v0
	gt1	=  g1 * ic1eq;
	gt0	=  g0 * ic1eq;
	t1	= (g0 * t0) + gt1;
	t2	= (g2 * t0) + gt0;

	band	=  t1   +  ic1eq;
	low		=  t2   +  ic2eq;
	high	= (X    - (damp * band)) - low;
	peak	=  high -  low;
	notch	=  high +  low;

	ic1eq  += (t1 + t1);
	ic2eq  += (t2 + t2);

	return low, band, high, peak, notch;
}

svfSinSingle(X, cutoff, damp, filt)
{
	History ic1eq(0), ic2eq(0);

	k	= 1 - (damp * 0.992);//1 - damp;	// shitty
	w	= PI * cutoff / SAMPLERATE;
	s1	= sin73(w);
	s2	= sin73(w + w);
	nrm	= 1 / (2 + (k * s1));				// k == damp
	g0	= s2 * nrm;
	g1	= ((-2 * s1 * s1) - (k * s2)) * nrm;
	g2	= ((s1 + s1) * s1) * nrm;

	t0	=   X - ic2eq;						// X == v0
	gt1	=  g1 * ic1eq;
	gt0	=  g0 * ic1eq;
	t1	= (g0 * t0) + gt1;
	t2	= (g2 * t0) + gt0;

	y	= 0;
	if 				(filt == 0) {
		y		= t2 + ic2eq;				// low
	} else if 		(filt == 1) {
		y		= t1 + ic1eq;				// band
	} else {	//	(filt > 1) {
		band	= t1 + ic1eq;
		low		= t2 + ic2eq;
		high	= (X - (k * band)) - low;
		if			(filt == 2) {
			y	= high;						// high
		} else if	(filt == 3) {
			y	= high - low;				// peak
		} else { //  filt == 4) {
			y	= high + low;				// notch
		}
	}

	ic1eq  += (t1 + t1);
	ic2eq  += (t2 + t2);

	return	y;
}

