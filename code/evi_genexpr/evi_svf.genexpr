
//	//	//	Self contained linear SVF filters with coefficients calculators
//	//	//	For use in place of biquads, including EQ-ing, when you actually need good quality :-)

//require("evi_smooth.genexpr");	// includes '_utilities' & '_approx'
// ^^ gen~ is broken, so temporarily we declare extra stuff here:
//==================================begin temp
tanA2(x)
{
	a	= ((((x * -0.0896638) + 0.0388452) * x) + 1.00005) * x;
	b	= (((x * -0.430871) + 0.0404318) * x) + 1;
	return	a / b;
}

expA(x0)
{
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;
	x *= x; x *= x; x *= x; x *= x; x *= x;
	return x;
}

tauA(t)											// t = seconds
{
	y = expA(-1 / (t * samplerate));
	return y + 0.000128;
}

dbtoaApprox(db)
{
	dbtoaA = expA(0.11512925464970 * db);
	return dbtoaA + 0.000128;					// + offset = 0 dB == 1 amplitude
}

expso(x, z)										// z is pole
{
	History w(0);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expsmooth(x, t)									// t is smooth time in seconds
{
	History w(0);
	z = tauA(t);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expsmoothBank2(x1, x2, t)
{
	History	expsdummy2(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	return	y1, y2;
}

expsmoothBank3(x1, x2, x3, t)
{
	History	expsdummy3(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	return	y1, y2, y3;
}

bandwidth2Q(bandwidth)
{
	x = expA(0.346573590279973 * bandwidth);	// exp(0.5 * log(2) * bandwidth)
	return	1 / (x - 1 / x);
}
//==================================end temp


//	//	//	TPT (Topology Preserving Transform, Zavalishin et al)
//	//	//	This linear core is also used as the basis for many of the nonlinear filters in evieve
//	//	//	This is also used in the linear [evi.svf~] replacement & [evi.multimode~]

// the linear filter
// we use this filter section to create all of our filter types by summing the outputs
tptSvf(x, g, r, a)
{
	History	s1(0), s2(0);

	// compute highpass output
	yH	= (x - (r + g) * s1 - s2) * a;	// (x - r * s1 - g * s1 - s2) * a

	// compute bandpass output by applying 1st integrator to highpass output
	gyH	= g * yH;
	yB	= gyH + s1;
	s1	= gyH + yB;						// state update in 1st integrator

	// compute lowpass output by applying 2nd integrator to bandpass output
	gyB	= g * yB;
	yL	= gyB + s2;
	s2	= gyB + yL;						// state update in 2nd integrator

	return	yL, yB, yH;					// lowpass, bandpass, highpass
}

tptSvfReset(x, g, r, a, reset)
{
	History	s1(0), s2(0);
	if (reset) {
		s1 = 0;
		s2 = 0;
	}

	// compute highpass output
	yH	= (x - (r + g) * s1 - s2) * a;	// (x - r * s1 - g * s1 - s2) * a

	// compute bandpass output by applying 1st integrator to highpass output
	gyH	= g * yH;
	yB	= gyH + s1;
	s1	= gyH + yB;						// state update in 1st integrator

	// compute lowpass output by applying 2nd integrator to bandpass output
	gyB	= g * yB;
	yL	= gyB + s2;
	s2	= gyB + yL;						// state update in 2nd integrator

	return	yL, yB, yH;					// lowpass, bandpass, highpass
}

/*
	Calculators ("filter" parameter is integer index - sorry, that is gen~)

	Index	Filter

	0 		Bypass
	1 		Lowpass
	2 		Highpass
	3 		Bandpass
	4 		Notch
	5 		Resonant
	6 		Bell
	7 		Lowshelf
	8 		Highshelf
	9 		Tilt
	10 		Allpass
*/
// make g, r, h & summing gains
// look how simple this is compared to Direct Form !
tptSvfCoeff(filter, cutoff, gain, Q)	// gain is linear !
{
	cL, cB, cH	= 0;					// LP, BP, HP gain staging for summing the outputs

	w	= PI * cutoff / SAMPLERATE;		// prewarp cutoff
	g 	= tanA2(w);						// embedded integrator gain
	r 	= sqrt2;						// damp, pre gain

	if			(filter == 1) {			// LOWPASS
		r 	= 1 / Q;
		cL	= gain;
		cB	= 0;
		cH	= 0;
	} else if	(filter == 2) {			// HIGHPASS
		r 	= 1 / Q;
		cL	= 0;
		cB	= 0;
		cH	= gain;
	} else if	(filter == 3) {			// BANDPASS_SKIRT 
		r 	= 1 / Q;
		cL	= 0;
		cB	= gain;
		cH	= 0;
	} else if	(filter == 4) {			// BANDREJECT (NOTCH)
		r 	= 1 / Q;
		cL	= gain;
		cB	= 0;
		cH	= gain;
	} else if	(filter == 5) {			// BANDPASS_PEAK (RESON) (accepts much higher 'Q')
		r 	= 1 / Q;
		cL	= 0;
		cB	= r * gain;
		cH	= 0;
	} else if	(filter == 6) {			// BELL
		r	= w / ((g + g) * Q);		// access w for bell
		r	= g / tanA2(w / (r + sqrt(r * r + 1)));
		r	= r * r;
		s 	= sqrt(((r * r + 1) / r - 2) / (gain + gain + gain + gain));
		r	= (s + s);
		cL	= 1;
		cB	= r * gain;
		cH	= 1;
	} else if	(filter == 7) {			// LOWSHELF
		A	= sqrt(gain);
		g  /= sqrt(A);					// scale cutoff frequency for shelfs
		rh	= 0.5 / Q;
		rh += sqrt((rh * rh) + 1);
		r  -= 1 / rh;
		cL	= gain;
		cB	= r * A;
		cH	= 1;
	} else if	(filter == 8) {			// HIGHSHELF
		A	= sqrt(gain);
		g  *= sqrt(A);					// scale cutoff frequency for shelfs
		rh	= 0.5 / Q;
		rh += sqrt((rh * rh) + 1);
		r  -= 1 / rh;
		cL	= 1;
		cB	= r * A;
		cH	= gain;
	} else if (filter == 9) {			// TILT
		A	= sqrt(gain);
        AA	= A * A;
        g	= g * A;					// g *= sqrt(A) ??
        dQ  = 1 / Q - 1;
        rs	= 1 / (sqrt(dQ + dQ + 2));
        r	= 1 / rs;
        cL	= 1 / AA;
        cB	= 1;
        cH	= AA;
	} else if	(filter == 10) {		// ALLPASS (normalised)
		r 	=  1 / Q;
		cL	=  1;                       // gain ?
		cB	= -r;
		cH	=  1;                       // gain ?
	} else { // (filter == 0)			// BYPASS
		g	= 0;						// tanA2(halfpi) (tan approx is safely 0)
		r	= 1;						// 1 / Q
		cL	= 1; 
		cB	= r;
		cH	= 1;
	}

	// feedback factor
	h	= 1 / (1 + (r + g) * g);		// 1 / (1 + r * g + g * g)

	return	g, r, h, cL, cB, cH;
}

// version for gen no tilde, because Max
tptSvfCoeffNoTilde(filter, cutoff, gain, Q, AUDIO_SR=48000)	// gain is linear !
{
	cL, cB, cH	= 0;					// LP, BP, HP gain staging for summing the outputs

	w	= PI * cutoff / AUDIO_SR;		// prewarp cutoff
	g 	= tanA2(w);						// embedded integrator gain
	r 	= sqrt2;						// damp, pre gain

	if			(filter == 1) {			// LOWPASS
		r 	= 1 / Q;
		cL	= gain;
		cB	= 0;
		cH	= 0;
	} else if	(filter == 2) {			// HIGHPASS
		r 	= 1 / Q;
		cL	= 0;
		cB	= 0;
		cH	= gain;
	} else if	(filter == 3) {			// BANDPASS_SKIRT 
		r 	= 1 / Q;
		cL	= 0;
		cB	= gain;
		cH	= 0;
	} else if	(filter == 4) {			// BANDREJECT (NOTCH)
		r 	= 1 / Q;
		cL	= gain;
		cB	= 0;
		cH	= gain;
	} else if	(filter == 5) {			// BANDPASS_PEAK (RESON) (accepts much higher 'Q')
		r 	= 1 / Q;
		cL	= 0;
		cB	= r * gain;
		cH	= 0;
	} else if	(filter == 6) {			// BELL
		r	= w / ((g + g) * Q);		// access w for bell
		r	= g / tanA2(w / (r + sqrt(r * r + 1)));
		r	= r * r;
		s 	= sqrt(((r * r + 1) / r - 2) / (gain + gain + gain + gain));
		r	= (s + s);
		cL	= 1;
		cB	= r * gain;
		cH	= 1;
	} else if	(filter == 7) {			// LOWSHELF
		A	= sqrt(gain);
		g  /= sqrt(A);					// scale cutoff frequency for shelfs
		rh	= 0.5 / Q;
		rh += sqrt((rh * rh) + 1);
		r  -= 1 / rh;
		cL	= gain;
		cB	= r * A;
		cH	= 1;
	} else if	(filter == 8) {			// HIGHSHELF
		A	= sqrt(gain);
		g  *= sqrt(A);					// scale cutoff frequency for shelfs
		rh	= 0.5 / Q;
		rh += sqrt((rh * rh) + 1);
		r  -= 1 / rh;
		cL	= 1;
		cB	= r * A;
		cH	= gain;
	} else if (filter == 9) {			// TILT
		A	= sqrt(gain);
        AA	= A * A;
        g	= g * A;					// g *= sqrt(A) ??
        dQ  = 1 / Q - 1;
        rs	= 1 / (sqrt(dQ + dQ + 2));
        r	= 1 / rs;
        cL	= 1 / AA;
        cB	= 1;
        cH	= AA;
	} else if	(filter == 10) {		// ALLPASS (normalised)
		r 	=  1 / Q;
		cL	=  1;                       // gain ?
		cB	= -r;
		cH	=  1;                       // gain ?
	} else { // (filter == 0)			// BYPASS
		g	= 0;						// tanA2(halfpi) (tan approx is safely 0)
		r	= 1;						// 1 / Q
		cL	= 1; 
		cB	= r;
		cH	= 1;
	}

	// feedback factor
	h	= 1 / (1 + (r + g) * g);		// 1 / (1 + r * g + g * g)

	return	g, r, h, cL, cB, cH;
}

// all in one section for use in gen~/GenExpr
eviFilterTpt(x, cutoff, db, Q, filter, smooth=0)	// gain in dB, smooth time in ms
{
	History eftdummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	g, r, h, cL, cB, cH = tptSvfCoeff(filter, cutoff, gain, Q);
	yL, yB, yH 	= tptSvf(x, g, r, h);
	if (smooth > 0) {
		cL, cB, cH 		= expsmoothBank3(cL, cB, cH, smoothsecs);
	}
	filtered	= (yL * cL) + (yB * cB) + (yH * cH);
	return 		filtered;
}

eviFilterTptReset(x, cutoff, db, Q, filter, reset, smooth=0)	// gain in dB, smooth time in ms
{
	History eftrdummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	g, r, h, cL, cB, cH = tptSvfCoeff(filter, cutoff, gain, Q);
	yL, yB, yH 	= tptSvfReset(x, g, r, h, reset);
	if (smooth > 0) {
		cL, cB, cH 		= expsmoothBank3(cL, cB, cH, smoothsecs);
	}
	filtered	= (yL * cL) + (yB * cB) + (yH * cH);
	return 		filtered;
}

/*
	EQ Calculators ("filter" parameter is integer index - sorry, that is gen~)

	Index	Filter

	0 		Bypass
	1 		Highpass
	2 		Lowshelf
	3 		Bell
	4 		Notch
	5 		Highshelf
	6 		Lowpass
*/
// coefficients just for EQ-ing, note different ordering as well
tptSvfCoeffEq(filter, cutoff, gain, Q)	// gain is linear !
{
	cL, cB, cH	= 0;					// LP, BP, HP gain staging for summing the outputs

	w	= PI * cutoff / SAMPLERATE;		// prewarp cutoff
	g 	= tanA2(w);						// embedded integrator gain
	r 	= sqrt2;						// damp, pre gain

	if			(filter == 1) {			// HIGHPASS
		r 	= 1 / Q;
		cL	= 0;
		cB	= 0;
		cH	= gain;
	} else if	(filter == 2) {			// LOWSHELF
		A	= sqrt(gain);
		g  /= sqrt(A);					// scale cutoff frequency for shelfs
		rh	= 0.5 / Q;
		rh += sqrt((rh * rh) + 1);
		r  -= 1 / rh;
		cL	= gain;
		cB	= r * A;
		cH	= 1;
	} else if	(filter == 3) {			// BELL
		r	= w / ((g + g) * Q);		// access w for bell
		r	= g / tanA2(w / (r + sqrt(r * r + 1)));
		r	= r * r;
		s 	= sqrt(((r * r + 1) / r - 2) / (gain + gain + gain + gain));
		r	= (s + s);
		cL	= 1;
		cB	= r * gain;
		cH	= 1;
	} else if	(filter == 4) {			// NOTCH
		r 	= 1 / Q;
		cL	= gain;
		cB	= 0;
		cH	= gain;
	} else if	(filter == 5) {			// HIGHSHELF
		A	= sqrt(gain);
		g  *= sqrt(A);					// scale cutoff frequency for shelfs
		rh	= 0.5 / Q;
		rh += sqrt((rh * rh) + 1);
		r  -= 1 / rh;
		cL	= 1;
		cB	= r * A;
		cH	= gain;
	} else if	(filter == 6) {			// LOWPASS
		r 	= 1 / Q;
		cL	= gain;
		cB	= 0;
		cH	= 0;
	} else { // (filter == 0)			// BYPASS
		g	= 0;						// tanA2(halfpi) (tan approx is safely 0)
		r	= 1;						// 1 / Q
		cL	= 1; 
		cB	= r;
		cH	= 1;
	}

	// feedback factor
	h	= 1 / (1 + (r + g) * g);		// 1 / (1 + r * g + g * g)

	return	g, r, h, cL, cB, cH;
}

// version for gen no tilde, because Max
tptSvfCoeffEqNoTilde(filter, cutoff, gain, Q, AUDIO_SR=48000)	// gain is linear !
{
	cL, cB, cH	= 0;					// LP, BP, HP gain staging for summing the outputs

	w	= PI * cutoff / AUDIO_SR;		// prewarp cutoff
	g 	= tanA2(w);						// embedded integrator gain
	r 	= sqrt2;						// damp, pre gain

	if			(filter == 1) {			// HIGHPASS
		r 	= 1 / Q;
		cL	= 0;
		cB	= 0;
		cH	= gain;
	} else if	(filter == 2) {			// LOWSHELF
		A	= sqrt(gain);
		g  /= sqrt(A);					// scale cutoff frequency for shelfs
		rh	= 0.5 / Q;
		rh += sqrt((rh * rh) + 1);
		r  -= 1 / rh;
		cL	= gain;
		cB	= r * A;
		cH	= 1;
	} else if	(filter == 3) {			// BELL
		r	= w / ((g + g) * Q);		// access w for bell
		r	= g / tanA2(w / (r + sqrt(r * r + 1)));
		r	= r * r;
		s 	= sqrt(((r * r + 1) / r - 2) / (gain + gain + gain + gain));
		r	= (s + s);
		cL	= 1;
		cB	= r * gain;
		cH	= 1;
	} else if	(filter == 4) {			// NOTCH
		r 	= 1 / Q;
		cL	= gain;
		cB	= 0;
		cH	= gain;
	} else if	(filter == 5) {			// HIGHSHELF
		A	= sqrt(gain);
		g  *= sqrt(A);					// scale cutoff frequency for shelfs
		rh	= 0.5 / Q;
		rh += sqrt((rh * rh) + 1);
		r  -= 1 / rh;
		cL	= 1;
		cB	= r * A;
		cH	= gain;
	} else if	(filter == 6) {			// LOWPASS
		r 	= 1 / Q;
		cL	= gain;
		cB	= 0;
		cH	= 0;
	} else { // (filter == 0)			// BYPASS
		g	= 0;						// tanA2(halfpi) (tan approx is safely 0)
		r	= 1;						// 1 / Q
		cL	= 1; 
		cB	= r;
		cH	= 1;
	}

	// feedback factor
	h	= 1 / (1 + (r + g) * g);		// 1 / (1 + r * g + g * g)

	return	g, r, h, cL, cB, cH;
}

// the linear filter, summed internally for EQ sections
tptSvfEq(x, g, r, h, cL, cB, cH)
{
	History	s1(0), s2(0);
	yH	= (x - (r + g) * s1 - s2) * h;
	gyH	= g * yH;
	yB	= gyH + s1;
	s1	= gyH + yB;
	gyB	= g * yB;
	yL	= gyB + s2;
	s2	= gyB + yL;
	// summed low, band, high
	return	(yL * cL) + (yB * cB) + (yH * cH);
}

tptSvfEqReset(x, g, r, h, cL, cB, cH, reset)
{
	History	s1(0), s2(0);
	if (reset) {
		s1 = 0;
		s2 = 0;
	}
	yH	= (x - (r + g) * s1 - s2) * h;
	gyH	= g * yH;
	yB	= gyH + s1;
	s1	= gyH + yB;
	gyB	= g * yB;
	yL	= gyB + s2;
	s2	= gyB + yL;
	// summed low, band, high
	return	(yL * cL) + (yB * cB) + (yH * cH);
}

