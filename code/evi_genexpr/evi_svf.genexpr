	eqR			= tptSvfEq(xR, g, r, h, cL, cB, cH);
	return 		eqL, eqR;
}
*/

// special morphing filter section, use with 'tptSvf()'
// ...'morph' 0..1 interpolates LP..BP..HP

// morph filter coefficients (based on Schmidt)
tptSvfCoeffMorph(cutoff, gain, Q, morph)			// gain is Linear
{
	g	= tanA2(PI * cutoff / SAMPLERATE);
//	a	= expA(0.11512925464970 * db) + 0.000128;	// dBtoA
	r	= 1 / Q;
	x	= (morph + morph) - 1;

	cL	= maximum(-x, 0);
	cH	= maximum( x, 0);
	cB	= 1 - (cL + cH);
//	cB	= fastpow( cB, 0.25) * 1.02196;	// function should map the range 0..1 monotonically
	cB	= sqrt(sqrt(cB));
	// 'sc' scaling ensures constant gain at cutoff
	sc	= Q * sqrt((r * r) / (cL * cL + cB * cB + cH * cH - (cL + cL) * cH)) * gain;
	cL *= sc;
	cB *= sc;
	cH *= sc;

	// feedback factor
	h	= 1 / (1 + (r + g) * g);		// 1 / (1 + r * g + g * g)

	return	g, r, h, cL, cB, cH;
}

// 'morph' 0..1 interpolates LP..BP..HP
eviFilterMorph(x, hz, db, bw, morph, smooth=22.666)	// gain in dB, bandwidth 0..1, smooth in ms
{
	History efmdummy(0);
	smoothsecs	= smooth * 0.001;
	gain		= dbtoaApprox(db);
	q 			= bandwidth2Q(((1 - sqrt(bw)) * 9.95) + 0.05);	// bw 0..1 to bandwidth to q, 10 octaves range
	g, r, h, cL, cB, cH = tptSvfCoeffMorph(hz, gain, q, morph);
	yL, yB, yH 	= tptSvf(x, g, r, h);
	if (smooth > 0) {
		cL, cB, cH 		= expsmoothBank3(cL, cB, cH, smoothsecs);
	}
	morphed		= (yL * cL) + (yB * cB) + (yH * cH);
	return 		morphed;
}

// 'morph' 0..1 interpolates LP..BP..HP
eviFilterMorphStereo(xL, xR, hz, db, bw, morph, smooth=22.666)	// gain in dB, bandwidth 0..1, smooth in ms
{
	History efmsdummy(0);
	smoothsecs	= smooth * 0.001;
	gain		= dbtoaApprox(db);
	q 			= bandwidth2Q(((1 - sqrt(bw)) * 9.95) + 0.05);	// bw 0..1 to bandwidth to q, 10 octaves range
	g, r, h, cL, cB, cH = tptSvfCoeffMorph(hz, gain, q, morph);
	yLL, yBL, yHL 		= tptSvf(xL, g, r, h);
	yLR, yBR, yHR 		= tptSvf(xR, g, r, h);
	if (smooth > 0) {
		cL, cB, cH 		= expsmoothBank3(cL, cB, cH, smoothsecs);
	}
	morphL		= (yLL * cL) + (yBL * cB) + (yHL * cH);
	morphR		= (yLR * cL) + (yBR * cB) + (yHR * cH);
	return 		morphL, morphR;
}


//	//	//	LTO (Linear Trapezoidal Optimised, Simper)
//	//	//	Alternative version, in practice we use these for EQ-ing, above for individual filters

// the linear filter - as far as I know this is the core filter used in Ableton Live 'EQ8'
// we use this filter section to create all of our filters, types summed on output
svfSection(v0, a1, a2, a3, m0, m1, m2)			// a's = coefficients, m's = mixing gains
{
	History	ic1eq(0), ic2eq(0);

	v3		=  v0 - ic2eq;
	v1		= (a1 * ic1eq) + (a2 * v3);
	v2		=  ic2eq + (a2 * ic1eq) + (a3 * v3);
	ic1eq	= (v1 + v1) - ic1eq;
	ic2eq	= (v2 + v2) - ic2eq;

	return	(m0 * v0) + (m1 * v1) + (m2 * v2);
}

svfSectionReset(v0, a1, a2, a3, m0, m1, m2, reset)	// a's = coefficients, m's = mixing gains
{
	History	ic1eq(0), ic2eq(0);
	if (reset) {
		ic1eq = 0;
		ic2eq = 0;
	}

	v3		=  v0 - ic2eq;
	v1		= (a1 * ic1eq) + (a2 * v3);
	v2		=  ic2eq + (a2 * ic1eq) + (a3 * v3);
	ic1eq	= (v1 + v1) - ic1eq;
	ic2eq	= (v2 + v2) - ic2eq;

	return	(m0 * v0) + (m1 * v1) + (m2 * v2);
}

/*
	Calculators ("filter" parameter is integer index - sorry, that is gen~)

	Index	Filter

	0 		Bypass
	1 		Lowpass
	2 		Highpass
	3 		Bandpass
	4 		Peak
	5 		Notch
	6 		Resonant
	7 		Allpass
	8 		Bell
	9 		Lowshelf
	10 		Highshelf
*/
// make a1, a2, a3 & summing gains
// look how simple this is compared to Direct Form !
svfSectionCoeff(filter, cutoff, gain, Q)		// gain is Linear !
{
	a1, a2, a3		= 0;						// coefficients
	m0, m1, m2		= 0;						// mixing gains

	g	= tanA2(PI * cutoff / SAMPLERATE);

	if ((filter > 0) && (filter < 8)) {

//		A	= expA(0.11512925464970 * gain) + 0.000128;	// dBtoA, if gain was in dB
		A 	= maximum(gain, 0.001);
		k	= 1 / Q;							// 'adaptive Q' goes here ...
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		if				(filter == 1) {			// LOWPASS
				m0	=  0;
				m1	=  0;
				m2	=  A;
		} else if		(filter == 2) {			// HIGHPASS
				m0	=  A;
				m1	= -k * A;
				m2	= -A;
		} else if		(filter == 3) {			// BANDPASS (CLASSIC)
				m0	=  0;
				m1	=  A;
				m2	=  0;
		} else if		(filter == 4) {			// PEAK
				m0	=  A;
				m1	= -k * A;
				m2	= -2 * A;
		} else if		(filter == 5) {			// NOTCH
				m0	=  A;
				m1	= -k * A;
				m2	=  0;
		} else if       (filter == 6) {			// RESONANT (BANDPASS) (accepts much higher 'Q')
				m0	=  0;
				m1	=  k * A;
				m2	=  0;
		} else {	//	(filter == 7) {			// ALLPASS (normalised)
				m0	=  1;
				m1	= -k;
				m2	=  1;
		}

	} else if ((filter >= 8) && (filter <= 10)) {

//		A	= fastpow(10, (gain * 0.025)) + 0.028652;	// if gain was in dB, instead of below
		A 	= sqrt(maximum(gain, 0.001));
		AA	= A * A;

		if				(filter == 8) {			// BELL
			k	= 1 / (Q * A);
			a1	= 1 / (1 + g * (g + k));
			a2	= g * a1;
			a3	= g * a2;

			m0	= 1;
			m1	= k * (AA - 1);
			m2	= 0;

		} else {	//	(filter == 9 || 10)

			sA	= sqrt(A);
			k	= 1 / Q;

			if			(filter == 9) {			// LOWSHELF
				g	= g / sA;
				a1	= 1 / (1 + g * (g + k));
				a2	= g * a1;
				a3	= g * a2;

				m0	= 1;
				m1	= k * (A - 1);
				m2	= AA - 1;

			} else { //	(filter == 10)			// HIGHSELF

				g	= g * sA;
				a1	= 1 / (1 + g * (g + k));
				a2	= g * a1;
				a3	= g * a2;

				m0	= AA;
				m1	= k * (1 - A) * A;
				m2	= 1 - AA;
			}

		}

	} else {	//		(filter <= 0 || >= 11)	// BYPASS
		a1, a2, a3	= 0;
		m1, m2		= 0;
		m0			= 1;
	}

	return	a1, a2, a3, m0, m1, m2;
}

// version for gen no tilde, because Max, must pass in samplerate
svfSectionCoeffNoTilde(filter, cutoff, gain, Q, AUDIO_SR=48000)	// gain is Linear !
{
	a1, a2, a3		= 0;						// coefficients
	m0, m1, m2		= 0;						// mixing gains

	g	= tanA2(PI * cutoff / AUDIO_SR);

	if ((filter > 0) && (filter < 8)) {

//		A	= expA(0.11512925464970 * gain) + 0.000128;	// dBtoA, if gain was in dB
		A 	= maximum(gain, 0.001);
		k	= 1 / Q;							// 'adaptive Q' goes here ...
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		if				(filter == 1) {			// LOWPASS
				m0	=  0;
				m1	=  0;
				m2	=  A;
		} else if		(filter == 2) {			// HIGHPASS
				m0	=  A;
				m1	= -k * A;
				m2	= -A;
		} else if		(filter == 3) {			// BANDPASS (CLASSIC)
				m0	=  0;
				m1	=  A;
				m2	=  0;
		} else if		(filter == 4) {			// PEAK
				m0	=  A;
				m1	= -k * A;
				m2	= -2 * A;
		} else if		(filter == 5) {			// NOTCH
				m0	=  A;
				m1	= -k * A;
				m2	=  0;
		} else if       (filter == 6) {			// RESONANT (BANDPASS) (accepts much higher 'Q')
				m0	=  0;
				m1	=  k * A;
				m2	=  0;
		} else {	//	(filter == 7) {			// ALLPASS (normalised)
				m0	=  1;
				m1	= -k;
				m2	=  1;
		}

	} else if ((filter >= 8) && (filter <= 10)) {

//		A	= fastpow(10, (gain * 0.025)) + 0.028652;	// if gain was in dB, instead of below
		A 	= sqrt(maximum(gain, 0.001));
		AA	= A * A;

		if				(filter == 8) {			// BELL
			k	= 1 / (Q * A);
			a1	= 1 / (1 + g * (g + k));
			a2	= g * a1;
			a3	= g * a2;

			m0	= 1;
			m1	= k * (AA - 1);
			m2	= 0;

		} else {	//	(filter == 9 || 10)

			sA	= sqrt(A);
			k	= 1 / Q;

			if			(filter == 9) {			// LOWSHELF
				g	= g / sA;
				a1	= 1 / (1 + g * (g + k));
				a2	= g * a1;
				a3	= g * a2;

				m0	= 1;
				m1	= k * (A - 1);
				m2	= AA - 1;

			} else { //	(filter == 10)			// HIGHSELF

				g	= g * sA;
				a1	= 1 / (1 + g * (g + k));
				a2	= g * a1;
				a3	= g * a2;

				m0	= AA;
				m1	= k * (1 - A) * A;
				m2	= 1 - AA;
			}

		}

	} else {	//		(filter <= 0 || >= 11)	// BYPASS
		a1, a2, a3	= 0;
		m1, m2		= 0;
		m0			= 1;
	}

	return	a1, a2, a3, m0, m1, m2;
}

// all in one section for use in gen~/GenExpr
eviFilterLto(x, cutoff, db, Q, filter, smooth=0)	// gain in dB, smooth time in ms
{
	History efldummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	a1, a2, a3, m0, m1, m2	= svfSectionCoeff(filter, cutoff, gain, Q);
	if (smooth > 0) {
		m0, m1, m2 			= expsmoothBank3(m0, m1, m2, smoothsecs);
	}
	filtered 	= svfSection(x, a1, a2, a3, m0, m1, m2);
	return 		filtered;
}

eviFilterLtoReset(x, cutoff, db, Q, filter, reset, smooth=0)	// gain in dB, smooth time in ms
{
	History eflrdummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	a1, a2, a3, m0, m1, m2	= svfSectionCoeff(filter, cutoff, gain, Q);
	if (smooth > 0) {
		m0, m1, m2 			= expsmoothBank3(m0, m1, m2, smoothsecs);
	}
	filtered 	= svfSectionReset(x, a1, a2, a3, m0, m1, m2, reset);
	return 		filtered;
}

/*
	EQ Calculators ("filter" parameter is integer index - sorry, that is gen~)

	Index	Filter

	0 		Bypass
	1 		Highpass
	2 		Lowshelf
	3 		Bell
	4 		Notch
	5 		Highshelf
	6 		Lowpass
*/
// coefficients just for EQ-ing, note different ordering as well
svfSectionCoeffEq(filter, cutoff, gain, Q)		// gain is Linear !
{
	a1, a2, a3		= 0;						// coefficients
	m0, m1, m2		= 0;						// mixing gains

	g	= tanA2(PI * cutoff / SAMPLERATE);

	if				(filter == 1) {				// HIGHPASS
		A 	= maximum(gain, 0.001);
		k	= 1 / Q;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;
		
		m0	=  A;
		m1	= -k * A;
		m2	= -A;
	} else if		(filter == 2) {				// LOWSHELF
		A 	= sqrt(maximum(gain, 0.001));
		AA	= A * A;
		sA	= sqrt(A);
		k	= 1 / Q;

		g	= g / sA;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	= 1;
		m1	= k * (A - 1);
		m2	= AA - 1;
	} else if		(filter == 3) {				// BELL
		A 	= sqrt(maximum(gain, 0.001));
		AA	= A * A;
		k	= 1 / (Q * A);

		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	= 1;
		m1	= k * (AA - 1);
		m2	= 0;
	} else if		(filter == 4) {				// NOTCH
		A 	= maximum(gain, 0.001);
		k	= 1 / Q;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	=  A;
		m1	= -k * A;
		m2	=  0;

	} else if 		(filter == 5) {				// HIGHSELF
		A 	= sqrt(maximum(gain, 0.001));
		AA	= A * A;
		sA	= sqrt(A);
		k	= 1 / Q;

		g	= g * sA;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	= AA;
		m1	= k * (1 - A) * A;
		m2	= 1 - AA;
	} else if		(filter == 6) {				// LOWPASS
		A 	= maximum(gain, 0.001);
		k	= 1 / Q;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	=  0;
		m1	=  0;
		m2	=  A;
	} else {	//	(filter <= 0 || >= 7)		// BYPASS
		a1, a2, a3	= 0;
		m1, m2		= 0;
		m0			= 1;
	}

	return	a1, a2, a3, m0, m1, m2;
}

// version for gen no tilde, because Max, must pass in samplerate
svfSectionCoeffEqNoTilde(filter, cutoff, gain, Q, AUDIO_SR=48000)	// gain is Linear !
{
	a1, a2, a3		= 0;						// coefficients
	m0, m1, m2		= 0;						// mixing gains

	g	= tanA2(PI * cutoff / AUDIO_SR);

	if				(filter == 1) {				// HIGHPASS
		A 	= maximum(gain, 0.001);
		k	= 1 / Q;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;
		
		m0	=  A;
		m1	= -k * A;
		m2	= -A;
	} else if		(filter == 2) {				// LOWSHELF
		A 	= sqrt(maximum(gain, 0.001));
		AA	= A * A;
		sA	= sqrt(A);
		k	= 1 / Q;

		g	= g / sA;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	= 1;
		m1	= k * (A - 1);
		m2	= AA - 1;
	} else if		(filter == 3) {				// BELL
		A 	= sqrt(maximum(gain, 0.001));
		AA	= A * A;
		k	= 1 / (Q * A);

		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	= 1;
		m1	= k * (AA - 1);
		m2	= 0;
	} else if		(filter == 4) {				// NOTCH
		A 	= maximum(gain, 0.001);
		k	= 1 / Q;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	=  A;
		m1	= -k * A;
		m2	=  0;

	} else if 		(filter == 5) {				// HIGHSELF
		A 	= sqrt(maximum(gain, 0.001));
		AA	= A * A;
		sA	= sqrt(A);
		k	= 1 / Q;

		g	= g * sA;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	= AA;
		m1	= k * (1 - A) * A;
		m2	= 1 - AA;
	} else if		(filter == 6) {				// LOWPASS
		A 	= maximum(gain, 0.001);
		k	= 1 / Q;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	=  0;
		m1	=  0;
		m2	=  A;
	} else {	//	(filter <= 0 || >= 7)		// BYPASS
		a1, a2, a3	= 0;
		m1, m2		= 0;
		m0			= 1;
	}

	return	a1, a2, a3, m0, m1, m2;
}

//	//	//	all in one sections for using in parametric EQ-ing etc

eviFilterEq(x, cutoff, db, Q, filter, smooth=0)	// gain in dB, smooth time in ms)
{
	History 	efedummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	a1, a2, a3, m0, m1, m2	= svfSectionCoeffEq(filter, cutoff, gain, Q);
	if (smooth > 0) {
		m0, m1, m2 			= expsmoothBank3(m0, m1, m2, smoothsecs);
	}
	eq 			= svfSection(x, a1, a2, a3, m0, m1, m2);
	return 		eq;
}

// for 'eviFilterEq4()' "filter" must only be lowpass or highpass !
eviFilterEq4(x, cutoff, db, Q, filter, smooth=0)	// gain in dB, smooth time in ms)
{
	History 	efe4dummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	a11, a21, a31, m01, m11, m21	= svfSectionCoeffEq(filter, cutoff, gain, Q * 0.666666);//sqrt2);
	a12, a22, a32, m02, m12, m22	= svfSectionCoeffEq(filter, cutoff, gain, Q * 0.333333);//sqrt1_2);
	if (smooth > 0) {
		m01, m11, m21	= expsmoothBank3(m01, m11, m21, smoothsecs);
		m02, m12, m22	= expsmoothBank3(m02, m12, m22, smoothsecs);
	}
	eq1 		= svfSection(x, a11, a21, a31, m01, m11, m21);
	eq2 		= svfSection(eq1, a12, a22, a32, m02, m12, m22);
	return 		eq2;
}

eviFilterEqStereo(xL, xR, cutoff, db, Q, filter, smooth=0)	// gain in dB, smooth time in ms)
{
	History 	efesdummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	a1, a2, a3, m0, m1, m2	= svfSectionCoeffEq(filter, cutoff, gain, Q);
	if (smooth > 0) {
		m0, m1, m2 			= expsmoothBank3(m0, m1, m2, smoothsecs);
	}
	eqL			= svfSection(xL, a1, a2, a3, m0, m1, m2);
	eqR			= svfSection(xR, a1, a2, a3, m0, m1, m2);
	return 		eqL, eqR;
}

// for 'eviFilterEqStereo4()' "filter" must only be lowpass or highpass !
eviFilterEqStereo4(xL, xR, cutoff, db, Q, filter, smooth=0)	// gain in dB, smooth time in ms)
{
	History 	efes4dummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	a11, a21, a31, m01, m11, m21	= svfSectionCoeffEq(filter, cutoff, gain, Q * 0.666666);//sqrt2);
	a12, a22, a32, m02, m12, m22	= svfSectionCoeffEq(filter, cutoff, gain, Q * 0.333333);//sqrt1_2);
	if (smooth > 0) {
		m01, m11, m21	= expsmoothBank3(m01, m11, m21, smoothsecs);
		m02, m12, m22	= expsmoothBank3(m02, m12, m22, smoothsecs);
	}
	eq1L 		= svfSection(xL, a11, a21, a31, m01, m11, m21);
	eq1R 		= svfSection(xR, a11, a21, a31, m01, m11, m21);
	eq2L 		= svfSection(eq1L, a12, a22, a32, m02, m12, m22);
	eq2R 		= svfSection(eq1R, a12, a22, a32, m02, m12, m22);
	return 		eq2L, eq2R;
}

eviParametric2(x, filter1, cutoff1, db1, Q1, filter2, cutoff2, db2, Q2, smooth=0)
{
	History ep2dummy(0);
	band1	= eviFilterEq(x, cutoff1, db1, Q1, filter1, smooth=smooth);
	band2	= eviFilterEq(band1, cutoff2, db2, Q2, filter2, smooth=smooth);
	return 	band2;
}

eviParametric3(x, filter1, cutoff1, db1, Q1, filter2, cutoff2, db2, Q2, filter3, cutoff3, db3, Q3, smooth=0)
{
	History ep3dummy(0);
	band1	= eviFilterEq(x,		cutoff1, db1, Q1, filter1, smooth=smooth);
	band2	= eviFilterEq(band1,	cutoff2, db2, Q2, filter2, smooth=smooth);
	band3	= eviFilterEq(band2,	cutoff3, db3, Q3, filter3, smooth=smooth);
	return 	band3;
}

eviParametricStereo2(xL, xR, filter1, cutoff1, db1, Q1, filter2, cutoff2, db2, Q2, smooth=0)
{
	History eps2dummy(0);
	band1L, band1R	= eviFilterEqStereo(xL, xR, cutoff1, db1, Q1, filter1, smooth=smooth);
	band2L, band2R	= eviFilterEqStereo(band1L, band1R, cutoff2, db2, Q2, filter2, smooth=smooth);
	return 	band2L, band2R;
}

eviParametricStereo3(xL, xR, filter1, cutoff1, db1, Q1, filter2, cutoff2, db2, Q2, filter3, cutoff3, db3, Q3, smooth=0)
{
	History eps3dummy(0);
	band1L, band1R	= eviFilterEqStereo(xL,		xR,		cutoff1, db1, Q1, filter1, smooth=smooth);
	band2L, band2R	= eviFilterEqStereo(band1L, band1R,	cutoff2, db2, Q2, filter2, smooth=smooth);
	band3L, band3R	= eviFilterEqStereo(band2L, band2R,	cutoff3, db3, Q3, filter3, smooth=smooth);
	return 	band3L, band3R;
}

// ...note, we have reached the limit of args to a GenExpr function
// ...for higher order EQ-ing, build from 'eviFilterEq()' etc inline


//	//	//	individual filter sections using TPT

// individual filter coefficients for the TPT SVF

tptSvfCoeffLowpass(cutoff, gain, Q)		// gain is linear !
{
	w	= PI * cutoff / SAMPLERATE;		// prewarp cutoff
	g 	= tanA2(w);						// embedded integrator gain
	r 	= 1 / Q;						// damp

	cL	= gain;
	cB	= 0;
	cH	= 0;

	h	= 1 / (1 + (r + g) * g);		// feedback factor

	return	g, r, h, cL, cB, cH;
}

tptSvfCoeffHighpass(cutoff, gain, Q)	// gain is linear !
{
	w	= PI * cutoff / SAMPLERATE;		// prewarp cutoff
	g 	= tanA2(w);						// embedded integrator gain
	r 	= 1 / Q;						// damp

	cL	= 0;
	cB	= 0;
	cH	= gain;

	h	= 1 / (1 + (r + g) * g);		// feedback factor

	return	g, r, h, cL, cB, cH;
}

tptSvfCoeffBandpass(cutoff, gain, Q)	// gain is linear !
{
	w	= PI * cutoff / SAMPLERATE;		// prewarp cutoff
	g 	= tanA2(w);						// embedded integrator gain
	r 	= 1 / Q;						// damp

	cL	= 0;
	cB	= gain;
	cH	= 0;

	h	= 1 / (1 + (r + g) * g);		// feedback factor

	return	g, r, h, cL, cB, cH;
}

tptSvfCoeffBandreject(cutoff, gain, Q)	// gain is linear !
{
	w	= PI * cutoff / SAMPLERATE;		// prewarp cutoff
	g 	= tanA2(w);						// embedded integrator gain
	r 	= 1 / Q;						// damp

	cL	= gain;
	cB	= 0;
	cH	= gain;

	h	= 1 / (1 + (r + g) * g);		// feedback factor

	return	g, r, h, cL, cB, cH;
}

tptSvfCoeffResonant(cutoff, gain, Q)	// gain is linear !
{
	w	= PI * cutoff / SAMPLERATE;		// prewarp cutoff
	g 	= tanA2(w);						// embedded integrator gain
	r 	= 1 / Q;						// damp

	cL	= 0;
	cB	= r * gain;
	cH	= 0;

	h	= 1 / (1 + (r + g) * g);		// feedback factor

	return	g, r, h, cL, cB, cH;
}

tptSvfCoeffPeakNotch(cutoff, gain, Q)	// gain is linear !
{
	w	= PI * cutoff / SAMPLERATE;		// prewarp cutoff
	g 	= tanA2(w);						// embedded integrator gain

	r	= w / ((g + g) * Q);
	r	= g / tanA2(w / (r + sqrt(r * r + 1)));
	r	= r * r;
	s 	= sqrt(((r * r + 1) / r - 2) / (gain + gain + gain + gain));
	r	= (s + s);
	cL	= 1;
	cB	= r * gain;
	cH	= 1;

	h	= 1 / (1 + (r + g) * g);		// feedback factor

	return	g, r, h, cL, cB, cH;
}

tptSvfCoeffLowshelf(cutoff, gain, Q)	// gain is linear !
{
	w	= PI * cutoff / SAMPLERATE;		// prewarp cutoff
	g 	= tanA2(w);						// embedded integrator gain

	A	= sqrt(gain);
	g  /= sqrt(A);
	rh	= 0.5 / Q;
	rh += sqrt((rh * rh) + 1);
	r  -= 1 / rh;
	cL	= gain;
	cB	= r * A;
	cH	= 1;

	h	= 1 / (1 + (r + g) * g);		// feedback factor

	return	g, r, h, cL, cB, cH;
}

tptSvfCoeffHighshelf(cutoff, gain, Q)	// gain is linear !
{
	w	= PI * cutoff / SAMPLERATE;		// prewarp cutoff
	g 	= tanA2(w);						// embedded integrator gain

	A	= sqrt(gain);
	g  *= sqrt(A);
	rh	= 0.5 / Q;
	rh += sqrt((rh * rh) + 1);
	r  -= 1 / rh;
	cL	= 1;
	cB	= r * A;
	cH	= gain;

	h	= 1 / (1 + (r + g) * g);		// feedback factor

	return	g, r, h, cL, cB, cH;
}

tptSvfCoeffTilt(cutoff, gain, Q)		// gain is linear !
{
	w	= PI * cutoff / SAMPLERATE;		// prewarp cutoff
	g 	= tanA2(w);						// embedded integrator gain

	A	= sqrt(gain);
    AA	= A * A;
    g	= g * A;
    dQ  = 1 / Q - 1;
    rs	= 1 / (sqrt(dQ + dQ + 2));
    r	= 1 / rs;
    cL	= 1 / AA;
    cB	= 1;
    cH	= AA;

	h	= 1 / (1 + (r + g) * g);		// feedback factor

	return	g, r, h, cL, cB, cH;
}

// no "gain" used in this filter, but we remain consistent
// with inlets in case of patching situations, bad idea?
// (we might actually add gain one day)
tptSvfCoeffAllpassNorm(cutoff, gain, Q)	// gain is linear !
{
	w	= PI * cutoff / SAMPLERATE;		// prewarp cutoff
	g 	= tanA2(w);						// embedded integrator gain
	r 	= 1 / Q;						// damp

	cL	=  1;
	cB	= -r;
	cH	=  1;

	h	= 1 / (1 + (r + g) * g);		// feedback factor

	return	g, r, h, cL, cB, cH;
}

// filter sections (individual sections for use in gen~/GenExpr)

eviFilterLowpass(x, cutoff, db, Q, smooth=0)	// gain in dB, smooth time in ms
{
	History efldummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	g, r, h, cL, cB, cH = tptSvfCoeffLowpass(cutoff, gain, Q);
	yL, yB, yH 	= tptSvf(x, g, r, h);
	if (smooth > 0) {
		cL 		= expsmooth(cL, smoothsecs);
	}
	lowpass		= (yL * cL);
	return 		lowpass;
}

eviFilterLowpassStereo(xL, xR, cutoff, db, Q, smooth=0)
{
	History eflsdummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	g, r, h, cL, cB, cH = tptSvfCoeffLowpass(cutoff, gain, Q);
	yLL, yBL, yHL 	= tptSvf(xL, g, r, h);
	yLR, yBR, yHR 	= tptSvf(xR, g, r, h);
	if (smooth > 0) {
		cL 		= expsmooth(cL, smoothsecs);
	}
	lowpassL	= (yLL * cL);
	lowpassR	= (yLR * cL);
	return 		lowpassL, lowpassR;
}

eviFilterHighpass(x, cutoff, db, Q, smooth=0)	// gain in dB, smooth time in ms
{
	History efhdummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	g, r, h, cL, cB, cH = tptSvfCoeffHighpass(cutoff, gain, Q);
	yL, yB, yH 	= tptSvf(x, g, r, h);
	if (smooth > 0) {
		cH 		= expsmooth(cH, smoothsecs);
	}
	highpass	= (yH * cH);
	return 		highpass;
}

