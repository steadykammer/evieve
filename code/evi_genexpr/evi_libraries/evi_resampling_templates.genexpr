//	//	//	//	//	//


//	//	//	SECTION 2:
//	//	//	the next part of this file repeats the above but for downsampling stages only.
//	//	//	this is useful for generators such as oscillators that only require
//	//	//	the multiple processing then interpolation on output.
//	//	//	these are therefore a bit cheaper as no upsampling stage is neeeded,
//	//	//	but the trade off is that they are not very effective :-(


// EXAMPLE, required for "YOUR_GENERATOR_FUNCTION_GOES_HERE()"
// simple 2 point polyBLEP
poly_blep(t, dt)
{
	yblep	= 0;
	if (t < dt) {
		alpha	=  (t / dt) - 1;
		yblep	= -(alpha * alpha);
	} else if (t > 1 - dt) {
		alpha	=  (t - 1) / dt + 1;
		yblep	=  (alpha * alpha);
	} else {
		yblep	=  0;
	}
	return	yblep;
}
// EXAMPLE


YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt)
{	// EXAMPLE
	// interesting polyblep sawtooth-pulse oscilaltor that aliases in high range
	t2	= wrap(t + 0.5, 0, 1);
	w	= 0;
	if (t2 >= 0.5) {
		w	= (cos(t2 * twopi) + 1) - 0.5;	// (should approx cos() here)
	} else {
		w	= 0 - 0.5;
	}
	wp	= (-poly_blep(t2, dt) + w);
	return	wp * 0.5;
	// EXAMPLE
}


// fixed 2x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_2x_4POINT(t, dt)
{	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// process 2x
	y1_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);
	y2_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}


// fixed 3x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_3x_4POINT(t, dt)
{	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// process 3x
	y1_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);
	y2_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);
	y3_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);
	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return y0_0;
}


// fixed 4x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_4x_4POINT(t, dt)
{	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// process 4x
	y1_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);
	y2_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);
	y3_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);
	y4_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(0.5,		y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3);

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return y0_0;
}


// the following higher order downsamplers are made from combining the previous 
// basic 2x, 3x & 4x downsamplers, so you will also have to replace the processing 
// functions with wrapped lower order resampling functions


// fixed 6x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_6x_4POINT(t, dt)
{	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// process 6x
	y1_0	= EVI_DOWNSAMPLE_TEMPLATE_3x_4POINT(t, dt);
	y2_0	= EVI_DOWNSAMPLE_TEMPLATE_3x_4POINT(t, dt);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}


// fixed 8x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_8x_4POINT(t, dt)
{	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// process 8x
	y1_0	= EVI_DOWNSAMPLE_TEMPLATE_4x_4POINT(t, dt);
	y2_0	= EVI_DOWNSAMPLE_TEMPLATE_4x_4POINT(t, dt);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}


// fixed 9x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_9x_4POINT(t, dt)
{	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// process 9x
	y1_0	= EVI_DOWNSAMPLE_TEMPLATE_3x_4POINT(t, dt);
	y2_0	= EVI_DOWNSAMPLE_TEMPLATE_3x_4POINT(t, dt);
	y3_0	= EVI_DOWNSAMPLE_TEMPLATE_3x_4POINT(t, dt);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);
	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return y0_0;
}


// fixed 12x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_12x_4POINT(t, dt)
{
	return 0;
}


// fixed 16x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_16x_4POINT(t, dt)
{
	return 0;
}


// !! for testing ONLY !!
TEST_DOWNSAMPLER_4POINT(t, dt, order)
{
	y 		= 0;
	z		= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);

	if 			(order == 1) {
		y 	= EVI_DOWNSAMPLE_TEMPLATE_2x_4POINT(t, dt);
	} else if	(order == 2) {
		y 	= EVI_DOWNSAMPLE_TEMPLATE_3x_4POINT(t, dt);
	} else  if	(order == 3) {
		y 	= EVI_DOWNSAMPLE_TEMPLATE_4x_4POINT(t, dt);
	} else  if	(order == 4) {
		y 	= EVI_DOWNSAMPLE_TEMPLATE_6x_4POINT(t, dt);
	} else  if	(order == 5) {
		y 	= EVI_DOWNSAMPLE_TEMPLATE_8x_4POINT(t, dt);
	} else  if	(order == 6) {
		y 	= EVI_DOWNSAMPLE_TEMPLATE_9x_4POINT(t, dt);
	// } else  if	(order == 7) {
	// 	y 	= EVI_DOWNSAMPLE_TEMPLATE_12x_4POINT(t, dt);
	// } else  if	(order == 8) {
	// 	y 	= EVI_DOWNSAMPLE_TEMPLATE_16x_4POINT(t, dt);
	} else {//	(order == 0) {
		y 	= z;
	}

	return 	y, z;
}


//	//	//	//	//	//


//	//	//	SECTION 3:
//	//	//	examples of other configurations...
//	//	//	Two audio inputs, one audio output,
//	//	//	for example a ring modulator.


// EXAMPLE, ringmod with two inputs
// (based on "enhanced ring mod" after Beat Frei, ICST)
EXAMPLE_TWO_INLETS_ONE_OUTLET(xin1, xin2)
{
	History x1(0), x2(0), y1(0);
	stage1	= xin1 + x1;
	stage2	= xin2 + x2;
	smix	= (stage1 * stage2) * 0.416666666667;
	rmod	= smix - (y1 * 0.666666666666);
	x1 = xin1;
	x2 = xin2;
	y1 = rmod;
	return dcblock(rmod);
}

//	//	//	4-point

// fixed 3x quasi oversampling 4-point, with two audio inlets
EVI_RESAMPLE_TEMPLATE_3x_4POINT_TWO_INPUTS(XIN1, XIN2)
{	// up 3 in1
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// up 3 in2
	History	vmTm1_0(0), vmT0_0(0), vmT1_0(0);
	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// up 3x in1
	x0_0_a	= XIN1 + 0;
	x1_0_a	= umT0_0 + 0;
	x2_0_a	= cubic_hermite_interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0_a	= cubic_hermite_interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a);

	// up 3x in2
	x0_0_b	= XIN2 + 0;
	x1_0_b	= vmT0_0 + 0;
	x2_0_b	= cubic_hermite_interp(ODT, vmTm1_0, vmT0_0, vmT1_0, x0_0_b);
	x3_0_b	= cubic_hermite_interp(TDT, vmTm1_0, vmT0_0, vmT1_0, x0_0_b);

	// process 3x
	y1_0	= EXAMPLE_TWO_INLETS_ONE_OUTLET(x1_0_a, x1_0_b);
	y2_0	= EXAMPLE_TWO_INLETS_ONE_OUTLET(x2_0_a, x2_0_b);
	y3_0	= EXAMPLE_TWO_INLETS_ONE_OUTLET(x3_0_a, x3_0_b);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);
	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update in1
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	// update in2
	vmTm1_0	= vmT0_0;
	vmT0_0	= vmT1_0;
	vmT1_0	= x0_0_b;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return	dcblock(y0_0);
}

// fixed 4x quasi oversampling 4-point, with two audio inlets
EVI_RESAMPLE_TEMPLATE_4x_4POINT_TWO_INPUTS(XIN1, XIN2)
{	// up 4 in1
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// up 4 in2
	History	vmTm1_0(0), vmT0_0(0), vmT1_0(0);
	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// up 4x in1
	x0_0_a	= XIN1 + 0;
	x1_0_a	= cubic_hermite_interp(0.25,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0_a	= cubic_hermite_interp(0.5,		umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0_a	= cubic_hermite_interp(0.75,	umTm1_0, umT0_0, umT1_0, x0_0_a);

	// up 4x in2
	x0_0_b	= XIN2 + 0;
	x1_0_b	= cubic_hermite_interp(0.25,	vmTm1_0, vmT0_0, vmT1_0, x0_0_b);
	x2_0_b	= cubic_hermite_interp(0.5,		vmTm1_0, vmT0_0, vmT1_0, x0_0_b);
	x3_0_b	= cubic_hermite_interp(0.75,	vmTm1_0, vmT0_0, vmT1_0, x0_0_b);

	// process 4x
	y1_0	= EXAMPLE_TWO_INLETS_ONE_OUTLET(x1_0_a,		x1_0_b);
	y2_0	= EXAMPLE_TWO_INLETS_ONE_OUTLET(x2_0_a,		x2_0_b);
	y3_0	= EXAMPLE_TWO_INLETS_ONE_OUTLET(x3_0_a,		x3_0_b);
	y4_0	= EXAMPLE_TWO_INLETS_ONE_OUTLET(umT1_0 + 0,	vmT1_0 + 0);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(0.5,		y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3);

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update in1
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	// update in2
	vmTm1_0	= vmT0_0;
	vmT0_0	= vmT1_0;
	vmT1_0	= x0_0_b;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return dcblock(y0_0);
}

//	//	//	6-point

// fixed 2x quasi oversampling 6-point, with two audio inlets
EVI_RESAMPLE_TEMPLATE_2x_6POINT_TWO_INPUTS(XIN1, XIN2)
{	// up 2 in1
	History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// up 2 in2
	History vmTm2_0(0), vmTm1_0(0), vmT0_0(0), vmT1_0(0), vmT2_0(0);
	// down 2
	History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History doX0(0);

	// up 2x in1
	x0_0_a  = XIN1 + 0;
	x1_0_a  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0_a  = umT2_0 + 0;

	// up 2x in2
	x0_0_b  = XIN2 + 0;
	x1_0_b  = hermite_sixpoint_interp(0.5,  vmTm2_0, vmTm1_0, vmT0_0, vmT1_0, vmT2_0, x0_0_b);
	x2_0_b  = vmT2_0 + 0;

	// process 2x
	y1_0    = EXAMPLE_TWO_INLETS_ONE_OUTLET(x1_0_a, x1_0_b);
	y2_0    = EXAMPLE_TWO_INLETS_ONE_OUTLET(x2_0_a, x2_0_b);

	// down 2x
	y2_0_a  = y2_0 + 0;
	y2_1    = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0    = (doX0 + y2_1) * 0.5;

	// update in1
	umTm2_0 = umTm1_0;
	umTm1_0 = umT0_0;
	umT0_0  = umT1_0;
	umT1_0  = umT2_0;
	umT2_0  = x0_0_a;

	// update in2
	vmTm2_0 = vmTm1_0;
	vmTm1_0 = vmT0_0;
	vmT0_0  = vmT1_0;
	vmT1_0  = vmT2_0;
	vmT2_0  = x0_0_b;

	doX0    = y1_0;

	dmT3_1  = dmT2_1;
	dmT2_1  = dmT1_1;
	dmT1_1  = dmT0_1;
	dmT0_1  = dmTm1_1;
	dmTm1_1 = y2_0;

	return dcblock(y0_0);
}

// fixed 4x quasi oversampling 6-point, with two audio inlets
EVI_RESAMPLE_TEMPLATE_4x_6POINT_TWO_INPUTS(XIN1, XIN2)
{	// up 2 in1
	History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// up 2 in2
	History vmTm2_0(0), vmTm1_0(0), vmT0_0(0), vmT1_0(0), vmT2_0(0);
	// down 2
	History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History doX0(0);

	// up 2x in1
	x0_0_a  = XIN1 + 0;
	x1_0_a  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0_a  = umT2_0 + 0;

	// up 2x in2
	x0_0_b  = XIN2 + 0;
	x1_0_b  = hermite_sixpoint_interp(0.5,  vmTm2_0, vmTm1_0, vmT0_0, vmT1_0, vmT2_0, x0_0_b);
	x2_0_b  = vmT2_0 + 0;

	// process 4x
	y1_0    = EVI_RESAMPLE_TEMPLATE_2x_6POINT_TWO_INPUTS(x1_0_a, x1_0_b);
	y2_0    = EVI_RESAMPLE_TEMPLATE_2x_6POINT_TWO_INPUTS(x2_0_a, x2_0_b);

	// down 2x
	y2_0_a  = y2_0 + 0;
	y2_1    = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0    = (doX0 + y2_1) * 0.5;

	// update in1
	umTm2_0 = umTm1_0;
	umTm1_0 = umT0_0;
	umT0_0  = umT1_0;
	umT1_0  = umT2_0;
	umT2_0  = x0_0_a;

	// update in2
	vmTm2_0 = vmTm1_0;
	vmTm1_0 = vmT0_0;
	vmT0_0  = vmT1_0;
	vmT1_0  = vmT2_0;
	vmT2_0  = x0_0_b;

	doX0    = y1_0;

	dmT3_1  = dmT2_1;
	dmT2_1  = dmT1_1;
	dmT1_1  = dmT0_1;
	dmT0_1  = dmTm1_1;
	dmTm1_1 = y2_0;

	return dcblock(y0_0);
}

// fixed 8x quasi oversampling 6-point, with two audio inlets
EVI_RESAMPLE_TEMPLATE_8x_6POINT_TWO_INPUTS(XIN1, XIN2)
{	// up 2 in1
	History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// up 2 in2
	History vmTm2_0(0), vmTm1_0(0), vmT0_0(0), vmT1_0(0), vmT2_0(0);
	// down 2
	History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History doX0(0);

	// up 2x in1
	x0_0_a  = XIN1 + 0;
	x1_0_a  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0_a  = umT2_0 + 0;

	// up 2x in2
	x0_0_b  = XIN2 + 0;
	x1_0_b  = hermite_sixpoint_interp(0.5,  vmTm2_0, vmTm1_0, vmT0_0, vmT1_0, vmT2_0, x0_0_b);
	x2_0_b  = vmT2_0 + 0;

	// process 8x
	y1_0    = EVI_RESAMPLE_TEMPLATE_4x_6POINT_TWO_INPUTS(x1_0_a, x1_0_b);
	y2_0    = EVI_RESAMPLE_TEMPLATE_4x_6POINT_TWO_INPUTS(x2_0_a, x2_0_b);

	// down 2x
	y2_0_a  = y2_0 + 0;
	y2_1    = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0    = (doX0 + y2_1) * 0.5;

	// update in1
	umTm2_0 = umTm1_0;
	umTm1_0 = umT0_0;
	umT0_0  = umT1_0;
	umT1_0  = umT2_0;
	umT2_0  = x0_0_a;

	// update in2
	vmTm2_0 = vmTm1_0;
	vmTm1_0 = vmT0_0;
	vmT0_0  = vmT1_0;
	vmT1_0  = vmT2_0;
	vmT2_0  = x0_0_b;

	doX0    = y1_0;

	dmT3_1  = dmT2_1;
	dmT2_1  = dmT1_1;
	dmT1_1  = dmT0_1;
	dmT0_1  = dmTm1_1;
	dmTm1_1 = y2_0;

	return dcblock(y0_0);
}


//	//	//	//	//	//


//	//	//	SECTION 4:
//	//	//	FILTERS:
//	//	//	This is more complicated. For nonlinear processes with state (i.e., filters)
//	//	//	one needs to prepare the processing (the filter) then apply a slightly
//	//	//	different interpolation routine.
//	//	//	In the example below we use the filter from 'evi_lorez.gendsp' as a starting
//	//	//	point. Note the below code is much worse than the code in that abstraction
//	//	//	as we ignore dependencies for the sake of brevity here...


// two poles of a nonlinear ladder with allpass alignment, ready for 2x oversampling.
// rubbish version for the resampling template demonstration, see 'evi_lorez.gendsp' for the real version
NONLIN_FILTER_TWOPOLE_2PASS(xin0, xin1, hz, res)		// NOTE: two audio inlets are declared! xin0 & xin1
{														// this becomes clearer in below examples
    History s1(0), s2(0), s3(0);

    // painful coefficients, only needed once
    invsr = 1 / samplerate;
    invsr05 = invsr * 0.5;
    k = res + res + res;
    k2 = sqrt2 + 0.353553 * res;
    w = twopi * hz;
    g0 = ((1 / invsr) * tan(w * invsr05)) * invsr05;  // !! (1/invsr) not (2/invsr) for 2x processing
    g1 = 1 + g0;
    g = g0 / g1;
    ga = (g + g) - 1;
    lp1fb = g * ga / g1;
    lp2fb = ga / g1;
    ap3fb = 2 / g1;
    alpha = 1 / (1 + k * ga * g * g);

    // nonlinear feeder, only needed once
    mK = ((s1 * lp1fb) + (s2 * lp2fb) + (s3 * ap3fb)) * -k;

	//	//	//
    //	//	//	pass 1, this is the audio loop of the filter, we repeat it below for double processing
	//	//	//	Note, if we were not oversampling, this is the only 'pass' we would need
	X0 = mK + xin0;
    u0 = atan(X0 * alpha);
    // lowpass 1
    xg0 = (u0 - s1) * g;
    lp10 = xg0 + s1;
    s1 = xg0 + lp10;
    // lowpass 2
    yg0 = (lp10 - s2) * g;
    lp20 = yg0 + s2;
    s2 = yg0 + lp20;
    // allpass
    zg0 = (lp20 - s3) * g;
    lp30 = zg0 + s3;
    hp30 = lp20 - lp30;
    ap30 = (lp30 - hp30) * k2;							// 'ap30' is the first return 
    s3 = zg0 + lp30;

	//	//	//
    //	//	//	pass 2, this is the audio loop of the filter repeated using the same memory state but different variables
	//	//	//
    X1 = mK + xin1;
    u1 = atan(X1 * alpha);
    // lowpass 1
    xg1 = (u1 - s1) * g;
    lp11 = xg1 + s1;
    s1 = xg1 + lp11;
    // lowpass 2
    yg1 = (lp11 - s2) * g;
    lp21 = yg1 + s2;
    s2 = yg1 + lp21;
    // allpass
    zg1 = (lp21 - s3) * g;
    lp31 = zg1 + s3;
    hp31 = lp21 - lp31;
    ap31 = (lp31 - hp31) * k2;							// 'ap31' is the second return
    s3 = zg1 + lp31;

    // taps
    return ap30, ap31;									// NOTE, return two audio outs from both passes of the processing
}


//	//	//	Next, we create an interpolator quasi resampler for 2x processing
//	//	//	(use 4-point for filters)


// fixed 2x quasi oversampling 4-point, 2 processing loops
NONLIN_FILTER_TWOPOLE_2PASS_2x_4POINT( XIN, hz, res )
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 2x
	// Note, we have created two interpolated audio inputs to send to our special filter module (x1_0 & x2_0)
	y1_0, y2_0	= NONLIN_FILTER_TWOPOLE_2PASS(x1_0, x2_0, hz, res);
	// Note, we get both loop retuns from our special filter module (y1_0 & y2_0)

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return dcblock(y0_0);
}


//	//	//	Now we can call it like this:
// lorez = NONLIN_FILTER_TWOPOLE_2PASS_2x_4POINT(in1, in2, in3);
//	//	//	'in1' is our audio input, 'in2' and 'in3' are our frequency and resonance inlets respectively


//	//	//	The above is a 2x oversampling example.
//	//	//	For higher order resampling we need to prepare multiple versions
//	//	//	of our filter when employing this hacky technique.
//	//	//	For an evieve example of how horrible this gets for performing
//	//	//	2x, 3x, 4x, 6x, & 8x filter resampling, see the .genexpr file:
//	//	//	'evi_buchla.genexpr'
//	//	//	or make use of the gen~ abstraction:
//	//	//	'evi_lpg_buchla.gendsp'
//	//	//	(see the 'gen~' tab of the [evi.lpg~] MSP abstraction)
//	//	//	For multimode outputs whilst oversampling, see 'evi_korgms20.gendsp'

