//	//	//	!! These are templates for copy/pasting and testing/making your own quasi resamplers;
//	//	//	it is not advised to "require" this file directly !!

//	//	//

//	//	//	There is no native resampling in gen~, which poses a real problem.
//	//	//	It is almost impossible, or at least prohibitively expensive, to create
//	//	//	proper linear phase polyphase resamplers in gen~. Therefore evieve uses
//	//	//	the very odd interpolation trick detailed in this file, which can have
//	//	//	ok results in certain circumstances.

//	//	//	This file contains some variations on the same idea. First are one in one out
//	//	//	interpolators for memoryless non-linearities. Then the same for two inputs one output.
//	//	//	Finally there are versions which can be used for nonlinear filters. Comments
//	//	//	in the code detail how it is done.

//	//	//

//	//	//	gen~ / GenExpr resamplers by Pete for evieve, thanks to Martijn Zwartjes
//	//	//	(for the idea) and Alex Harker (for finding my mistakes).

//	//	//	Basic cubic interpolation hacks in lieu of real resampling being not
//	//	//	available in gen~. High frequency response is poor using these methods.
//	//	//	These are relatively expensive, and literally process functions x times.
//	//	//	Furthermore, there is no way of making these reusable functions in gen~
//	//	//	so all the code here is for copy/pasting :-(

//	//	//

//	//	//	Custom 4-point cubic and 6-point hermite interpolation:
require("evi_interp.genexpr");
//	//	//	About interpolation:

//	//	//	This technique uses 4-point and 6-point interpolators for different tasks.
//	//	//	We could use the gen~ native [interp] with modes 'cubic', 'spline' & 'spline6'.
//	//	//	However, the native 'cubic' is no use, as it is a sort of weird tri-cubic
//	//	//	and produces strange results with bad high frequency response. Native 'spline' is good,
//	//	//	but quite expensive. Native 'spline6' is strange also, see the 'evi_interp.genexpr' file
//	//	//	for an explanation. So we use evieve interpolators, 'cubic_hermite_interp()' which
//	//	//	is high quality and cheap, and 'hermite_sixpoint_interp()' which is
//	//	//	expensive but works well.

//	//	//	The choice of 4-point/6-point interpolator is down to CPU and situation. For
//	//	//	example, 6-point does not work well for filters as it leaves a notch near nyquist,
//	//	//	whereas sometimes 2x oversampling using 6-point is fine for a basic Adaa non-linearity.

//	//	//


//	//	//	SECTION 1:
//	//	//	These first methods are not good for oscillators or ringing resonance (filters),
//	//	//	as those require really fine interpolation (e.g. use [poly~] for that, or see 'SECTION 4').
//	//	//	In evieve, these methods are mainly used on all the memoryless non-linearities
//	//	//	(as well as anti derivative anti aliasing techniques) and seem reasonable for that task.


// Memoryless non-linearity example:
YOUR_FUNCTION_GOES_HERE(x)
{	// EXAMPLE
	// tanh Lambert approx, excellent numeric and sonic closeness to 'real' tanh
	x2 = x * x;
	a = (((x2 + 378) * x2 + 17325) * x2 + 135135) * x;
	b = ((28 * x2 + 3150) * x2 + 62370) * x2 + 135135;
	return clamp((a / b), -1, 1);
	// EXAMPLE
}

//	//	//	4-point

// fixed 2x quasi oversampling 4-point, plus voodoo for GenExpr
EVI_RESAMPLE_TEMPLATE_2x_4POINT(XIN)			// XIN presumed to be audio signal inlet
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	// could  be native "spline":
	// x1_0	= interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);

	x2_0	= umT1_0 + 0;

	// process 2x
	y1_0	= YOUR_FUNCTION_GOES_HERE(x1_0);	// you could also have other parameter inlets here but
	y2_0	= YOUR_FUNCTION_GOES_HERE(x2_0);	// the first (XIN) inlet is the audio targeted for 'resampling'

	// down 2x
	y2_0_a	= y2_0 + 0;
	// could  be native "spline":
	// y2_1	= interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;								// you should almost always dcblock() the output(s) in use
}


// I am not convinced 3x, 6x, 9x are correct
// fixed 3x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_3x_4POINT(XIN)
{	// up 3
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// up 3x
	x0_0_a	= XIN + 0;
	x1_0	= umT0_0 + 0;	// TODO: work out umT1_0 ?
	x2_0	= cubic_hermite_interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0	= cubic_hermite_interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a);

	// process 3x
	y1_0	= YOUR_FUNCTION_GOES_HERE(x1_0);
	y2_0	= YOUR_FUNCTION_GOES_HERE(x2_0);
	y3_0	= YOUR_FUNCTION_GOES_HERE(x3_0);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);
	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return y0_0;
}


// fixed 4x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_4x_4POINT(XIN)
{	// up 4
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// up 4x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.25,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= cubic_hermite_interp(0.5,		umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0	= cubic_hermite_interp(0.75,	umTm1_0, umT0_0, umT1_0, x0_0_a);


	// process 4x
	y1_0	= YOUR_FUNCTION_GOES_HERE(x1_0);
	y2_0	= YOUR_FUNCTION_GOES_HERE(x2_0);
	y3_0	= YOUR_FUNCTION_GOES_HERE(x3_0);
	y4_0	= YOUR_FUNCTION_GOES_HERE(umT1_0 + 0);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(0.5,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3);

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return y0_0;
}


// the following higher order resamplers are made from combining the previous 
// basic 2x, 3x & 4x resamplers, so you will also have to replace the processing 
// functions with wrapped lower order resampling functions


// I am not convinced 3x, 6x, 9x are correct
// fixed 6x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_6x_4POINT(XIN)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 6x
	y1_0	= EVI_RESAMPLE_TEMPLATE_3x_4POINT(x1_0);
	y2_0	= EVI_RESAMPLE_TEMPLATE_3x_4POINT(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}


// fixed 8x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_8x_4POINT(XIN)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 8x
	y1_0	= EVI_RESAMPLE_TEMPLATE_4x_4POINT(x1_0);
	y2_0	= EVI_RESAMPLE_TEMPLATE_4x_4POINT(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}


// I am not convinced 3x, 6x, 9x are correct
// fixed 9x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_9x_4POINT(XIN)
{	// up 3
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// up 3x
	x0_0_a	= XIN + 0;
	x1_0	= umT0_0 + 0;
	x2_0	= cubic_hermite_interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0	= cubic_hermite_interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a);

	// process 9x
	y1_0	= EVI_RESAMPLE_TEMPLATE_3x_4POINT(x1_0);
	y2_0	= EVI_RESAMPLE_TEMPLATE_3x_4POINT(x2_0);
	y3_0	= EVI_RESAMPLE_TEMPLATE_3x_4POINT(x3_0);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);
	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return y0_0;
}


// you might be thinking we do 12x and 16x now, but i can save you the
// bother - they are pointless using this dodgy interpolation technique

// fixed 12x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_12x_4POINT(XIN)
{
	return XIN;
}
// fixed 16x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_16x_4POINT(XIN)
{
	return XIN;
}


// !! for testing ONLY !!
TEST_RESAMPLER_4POINT(x, order)
{
	y 		= 0;
	if 			(order == 1) {
		y 	= EVI_RESAMPLE_TEMPLATE_2x_4POINT(x);
	} else if	(order == 2) {
		y 	= EVI_RESAMPLE_TEMPLATE_3x_4POINT(x);
	} else  if	(order == 3) {
		y 	= EVI_RESAMPLE_TEMPLATE_4x_4POINT(x);
	} else  if	(order == 4) {
		y 	= EVI_RESAMPLE_TEMPLATE_6x_4POINT(x);
	} else  if	(order == 5) {
		y 	= EVI_RESAMPLE_TEMPLATE_8x_4POINT(x);
	} else  if	(order == 6) {
		y 	= EVI_RESAMPLE_TEMPLATE_9x_4POINT(x);
	// } else  if	(order == 7) {
	// 	y 	= EVI_RESAMPLE_TEMPLATE_12x_4POINT(x);
	// } else  if	(order == 8) {
	// 	y 	= EVI_RESAMPLE_TEMPLATE_16x_4POINT(x);
	} else {//	(order == 0) {
		y 	= YOUR_FUNCTION_GOES_HERE(x);
	}

	return 	y;
}


//	//	//
//	//	//	6-point hermite instead of 4-point like all the above
//	//	//


// fixed 2x quasi oversampling 6-point, this one works and is really useful
EVI_RESAMPLE_TEMPLATE_2x_6POINT(XIN)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 2x
	y1_0	= YOUR_FUNCTION_GOES_HERE(x1_0);
	y2_0	= YOUR_FUNCTION_GOES_HERE(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return y0_0;
}


