
//  //  //  For all evieve TPT SVF filters require "evi_svfs.genexpr".
//  //  //  Because Gen does not cache require files, the evieve SVFs are
//  //  //  separated out into smaller require files such as this one

require("evi_interp.genexpr");	// for tptSvf2x only


// TPT

// the linear filter
// we use this filter section to create all of our filter types by summing the outputs
tptSvf(x, g, r, a)
{
	History	s1(0), s2(0);

	// compute highpass output
	yH	= (x - (r + g) * s1 - s2) * a;	// (x - r * s1 - g * s1 - s2) * a

	// compute bandpass output by applying 1st integrator to highpass output
	gyH	= g * yH;
	yB	= gyH + s1;
	s1	= gyH + yB;						// state update in 1st integrator

	// compute lowpass output by applying 2nd integrator to bandpass output
	gyB	= g * yB;
	yL	= gyB + s2;
	s2	= gyB + yL;						// state update in 2nd integrator

	return	yL, yB, yH;					// lowpass, bandpass, highpass
}

tptSvfReset(x, g, r, a, reset)
{
	History	s1(0), s2(0);
	if (reset) {
		s1 = 0;
		s2 = 0;
	}

	// compute highpass output
	yH	= (x - (r + g) * s1 - s2) * a;	// (x - r * s1 - g * s1 - s2) * a

	// compute bandpass output by applying 1st integrator to highpass output
	gyH	= g * yH;
	yB	= gyH + s1;
	s1	= gyH + yB;						// state update in 1st integrator

	// compute lowpass output by applying 2nd integrator to bandpass output
	gyB	= g * yB;
	yL	= gyB + s2;
	s2	= gyB + yL;						// state update in 2nd integrator

	return	yL, yB, yH;					// lowpass, bandpass, highpass
}

tptSvfOnePole(x, g)	// cL cH to mix
{
	History	s(0);

	v	= (x - s) * g;
	lp	=  v + s;
	hp	=  x - lp;
	s	=  v + lp;

	return lp, hp;
}

// 2x oversampling on the linear twopole filter and all three outs.
// this works, but is not too successful in the task of extending HF response.
// N.B. - requires "evi_interp.genexpr"

tptSvf2(x0, x1, g, r, a)
{
	History	s1(0), s2(0);

    // pass 1

	yH0	    = (x0 - (r + g) * s1 - s2) * a;
	gyH0	= g * yH0;
	yB0	    = gyH0 + s1;
	s1	    = gyH0 + yB0;
	gyB0	= g * yB0;
	yL0	    = gyB0 + s2;
	s2	    = gyB0 + yL0;

    // pass 2

	yH1	    = (x1 - (r + g) * s1 - s2) * a;
	gyH1	= g * yH1;
	yB1	    = gyH1 + s1;
	s1	    = gyH1 + yB1;
	gyB1	= g * yB1;
	yL1	    = gyB1 + s2;
	s2	    = gyB1 + yL1;

	return	yL0, yL1, yB0, yB1, yH0, yH1;
}

// fixed 2x quasi oversampling (cubic4)
tptSvf2_2x( XIN, g, r, a )
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0), doX1(0), doX2(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 2x
	y1_0, y2_0, y3_0, y4_0, y5_0, y6_0 = tptSvf2(x1_0, x2_0, g, r, a);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.5,	y4_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y6_0_a	= y6_0 + 0;
	y6_1	= cubic_hermite_interp(0.5,	y6_0_a,	dmT0_3, dmT1_3, dmT2_3);

	y0_0	= (doX0 + y2_1) * 0.5;
	y0_1	= (doX1 + y4_1) * 0.5;
	y0_2	= (doX2 + y6_1) * 0.5;

	// update input
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;
	doX1	= y3_0;
	doX2	= y5_0;

    // update outputs
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y4_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y6_0;

	return dcblock(y0_0), dcblock(y0_1), dcblock(y0_2);
}

// bad copy paste to get around multiple requires etc
tanApprox2(x)
{
	a	= ((((x * -0.0896638) + 0.0388452) * x) + 1.00005) * x;
	b	= (((x * -0.430871) + 0.0404318) * x) + 1;
	return	a / b;
}

// simple calculator for single 'tptSvf()' unit as in [evi.svf~]
tptSvfUnit(cutoff, Q, os=0)				// Q is full, must be remapped from 0..1 upstream
{
	g 	= tanApprox2(PI * cutoff / SAMPLERATE) * (os ? 0.5 : 1);	// os == oversample flag
	r 	= 1 / Q;
	h	= 1 / (1 + (r + g) * g);
	return 	g, r, h;
}

// external, for writing Historys in/out of a Data for inline cascades
tptSvfExternal(x, g, r, a, s1i, s2i)
{
	yH	= (x - (r + g) * s1i - s2i) * a;
	gyH	= g * yH;
	yB	= gyH + s1i;
	s1o	= gyH + yB;
	gyB	= g * yB;
	yL	= gyB + s2i;
	s2o	= gyB + yL;

	return	yL, yB, yH, s1o, s2o;
}


// LTO

// the linear filter - as far as I know this is the core filter used in Ableton Live 'EQ8'
// we use this filter section to create all of our filters, types summed on output
svfSection(v0, a1, a2, a3, m0, m1, m2)			    // a's = coefficients, m's = mixing gains
{
	History	ic1eq(0), ic2eq(0);

	v3		=  v0 - ic2eq;
	v1		= (a1 * ic1eq) + (a2 * v3);
	v2		=  ic2eq + (a2 * ic1eq) + (a3 * v3);
	ic1eq	= (v1 + v1) - ic1eq;
	ic2eq	= (v2 + v2) - ic2eq;

	return	(m0 * v0) + (m1 * v1) + (m2 * v2);
}

svfSectionReset(v0, a1, a2, a3, m0, m1, m2, reset)	// a's = coefficients, m's = mixing gains
{
	History	ic1eq(0), ic2eq(0);
	if (reset) {
		ic1eq = 0;
		ic2eq = 0;
	}

	v3		=  v0 - ic2eq;
	v1		= (a1 * ic1eq) + (a2 * v3);
	v2		=  ic2eq + (a2 * ic1eq) + (a3 * v3);
	ic1eq	= (v1 + v1) - ic1eq;
	ic2eq	= (v2 + v2) - ic2eq;

	return	(m0 * v0) + (m1 * v1) + (m2 * v2);
}

svfSectionOnePole(x, g)	// m0 m2 to mix
{
	History	iceq(0);

	v		= (x - iceq) * g;
	lp		=  v + iceq;
	hp		=  x - lp;
	iceq	=  v + lp;

	return lp, hp;
}

svfSectionStereo(xL, xR, a1, a2, a3, m0, m1, m2)
{
	yL			= svfSection(xL, a1, a2, a3, m0, m1, m2);
	yR			= svfSection(xR, a1, a2, a3, m0, m1, m2);
	return 		yL, yR;
}

