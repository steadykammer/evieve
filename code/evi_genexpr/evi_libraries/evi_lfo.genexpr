require("evi_sources.genexpr"); // includes many more LFOs

// ---

// next three are a repeat from "evi_fastskew.genexpr" to avoid another require

// negative only
fastskewlfo052neg(x, skewneg)				// !! skewneg must be clamped 0.5..1 !!
{
	sk5	= skewneg - 0.5;
	return mix(sqrt(x), x, sk5 + sk5);	    // Alex and I hate mix(), but sadly it is a tiny bit cheaper
}

// positive only, generally positive is far less accurate in terms of pow(), especially for greater ranges
fastskewlfo052pos(x, skewpos)				// !! skewpos must be clamped 1..2 !!
{
 	return mix(x, x*x, skewpos - 1);
}

// pow(x, 0.5..2), audio rate version (branch, only compute neccessary)
// a branch to select between a sqrt & a multiply does not make much difference ?
fastskewlfo052ar(x, skew)					// !! skew must be clamped 0.5..2 !!
{
	y = 0;
	if (skew < 1) {
		y = fastskewlfo052neg(x, skew);
	} else {
		y = fastskewlfo052pos(x, skew);
	}
	return y;
}

// thanks Alex Harker
// lfo morphable between tri and sine with added skew, phase 0..1 in, wave 0..1 out
lfoMix(phase, duty, shape, skew)	// input phase must be wrapped 0..1 (for tri phase)
{
    tri = (phase < duty) ? (phase / duty) : (1 - phase) / (1 - duty);
	sphase = wrap(phase - 0.25, 0, 1);
   	sine = (sphase > 0.5) ? sphase - 1 : sphase;
    sine = sine * (4 - (abs(sine) * 8)) + 0.5;

    // return fastskewlfo052ar(interp(shape, tri, sine), skew);
    return fastskewlfo052ar(mix(tri, sine, shape), skew);
}

// sine lfo with added skew, phase 0..1 in, wave 0..1 out
lfoSkew(phase, skew)
{
   	sine = (phase > 0.5) ? phase - 1 : phase;
    sine = sine * (4 - (abs(sine) * 8)) + 0.5;
    return fastskewlfo052ar(sine, skew);
}

// ---

// are these 'glide' lfos what Ableton calls 'wander' ??
// either way i modified them from Iftah's Ableton stuff, thanks, they are beautiful

// phase 0..1 in, bipolar -1..1 out
glideLfoBipolar(phase)
{
    History Rng(0), prevRng(0);

	if (delta(phase) < 0)
	{
        signed = noise();
	    prevRng = Rng;
	    Rng = abs(signed + signed);
	}

    cosDrive = 1 + fastsin(phase*PI - HALFPI);
	lfo = ((cosDrive * Rng + (2 - cosDrive) * prevRng) * 0.5) - 1;
    
    return lfo;
}

glideLfoBipolarN(phase, n)  // with external noise source
{
    History Rng(0), prevRng(0);

	if (delta(phase) < 0)
	{
	    prevRng = Rng;
	    Rng = abs(n + n);
	}

    cosDrive = 1 + fastsin(phase*PI - HALFPI);
	lfo = ((cosDrive * Rng + (2 - cosDrive) * prevRng) * 0.5) - 1;
    
    return lfo;
}

// phase 0..1 in, unipolar 0..1 out
glideLfoUnipolar(phase)
{
    History Rng(0), prevRng(0);

	if (delta(phase) < 0)
	{
	    prevRng = Rng;
	    Rng = abs(noise());
	}

    cosDrive = 0.5 + (0.5 * fastsin(phase*PI - HALFPI));
	lfo = (cosDrive * Rng + (1 - cosDrive) * prevRng);
    
    return lfo;
}

glideLfoUnipolarN(phase, n) // with external noise source
{
    History Rng(0), prevRng(0);

	if (delta(phase) < 0)
	{
	    prevRng = Rng;
	    Rng = abs(n);
	}

    cosDrive = 0.5 + (0.5 * fastsin(phase*PI - HALFPI));
	lfo = (cosDrive * Rng + (1 - cosDrive) * prevRng);
    
    return lfo;
}

// ---

// cheap and dirty approx, good enough for lfos
tanhC(x)
{
	x = clip(x, -3, 3);
	return x * ((27 + (x * x)) / (27 + (9 * (x * x))));
}

// stupid
triC(phase, pwm, times, plus)
{
    return (triangle(phase, pwm) * times) + plus;
}

// computed LFOs, phase 0..1 in, wave 0..1 out
lfoShapes01(phase, sync, mod, shape)
{
    History ls01dummy(0);
    lfo = 0;
    if ((shape >= 1) && (shape <= 3)) {
        pwm = shape == 3 ? mod : (shape == 2 ? 0.04 : 0.96); // 3=triangle, 2=ramp down, 1=ramp up
        lfo = triC(phase, pwm, 1, 0);
    }
    else if ((shape == 4) || (shape == 5)) {
        p = wrap(phase, -0.5, 0.5);
        if (shape == 4) {       // sine
            lfo = p * (4 - (abs(p) * 8)) + 0.5;
        }
        else {                  // 5=tanh
            sine = (8 - (abs(p) * 16)) * p;
            lfo = (tanhC(sine * maximum(((mod * mod) * 8), 0.999999)) * 0.5) + 0.5;
        }
    }
    else if (shape == 6) {      // square
        sr10 = samplerate * 0.01;
        lfo = phase > mod;
        lfo = evi_rampsmooth(lfo, sr10, sr10);
    }
    else if (shape > 6) {
        n = noise();
        if ((shape == 7) || (shape == 8)) {
            sr10 = samplerate * 0.01;
            lfo = latch(n, sync);
            if (shape == 8) {   // 8=random step
                sr20 = sr10 + sr10;
                lfo = (lfo * 0.5) + 0.5;
                lfo = evi_rampsmooth(lfo, sr10, sr20);
            }
            else {              // 7=random binary
                sr05 = sr10 * 0.5;
                lfo = lfo > 0;
                lfo = evi_rampsmooth(lfo, sr05, sr05);
            }
        }
        else if ((shape == 9) || (shape == 10)) {
            linear, cosine = eviRandCN(phase, n);
            if (shape == 9) {   // random linear
                lfo = (linear * 0.5) + 0.5;
            }
            else {              // random cosine
                lfo = (cosine * 0.5) + 0.5;
            }
        }
        else if (shape == 11) { // random cubic
            lfo = (eviRandyN(phase, n) * 0.5) + 0.5;
        }
        else if (shape == 12) { // random walk
            lfo = glideLfoUnipolarN(phase, n);
        }
        else {                  // 13=white noise
            lfo = (n * 0.5) + 0.5;
        }
    }
    else {                      // 0=off
        lfo = 0;
    }

    return lfo;
}

// computed LFOs, phase 0..1 in, wave -1..1 out
lfoShapes11(phase, sync, mod, shape)  //  mod 0..1
{
    History ls11dummy(0);
    lfo = 0;
    if ((shape >= 1) && (shape <= 3)) {
        pwm = shape == 3 ? mod : (shape == 2 ? 0.04 : 0.96); // 3=triangle, 2=ramp down, 1=ramp up
        lfo = triC(phase, pwm, 2, -1);
    }
    else if ((shape == 4) || (shape == 5)) {
        p = wrap(phase, -0.5, 0.5);
        sine = (8 - (abs(p) * 16)) * p;
        if (shape == 4) {       // sine
            lfo = sine;
        }
        else {                  // 5=tanh
            lfo = tanhC(sine * maximum(((mod * mod) * 8), 0.999999));
        }
    }
    else if (shape == 6) {      // square
        sr10 = samplerate * 0.01;
        lfo = phase > mod;
        lfo = (evi_rampsmooth(lfo, sr10, sr10) * 2) - 1;
    }
    else if (shape > 6) {
        n = noise();
        if ((shape == 7) || (shape == 8)) {
            sr10 = samplerate * 0.01;
            lfo = latch(n, sync);
            if (shape == 8) {   // 8=random step
                sr20 = sr10 + sr10;
                lfo = evi_rampsmooth(lfo, sr10, sr20);
            }
            else {              // 7=random binary
                sr05 = sr10 * 0.5;
                lfo = lfo > 0;
                lfo = (lfo + lfo) - 1;
                lfo = evi_rampsmooth(lfo, sr05, sr05);
            }
        }
        else if ((shape == 9) || (shape == 10)) {
            linear, cosine = eviRandCN(phase, n);
                                // random 9=linear / 10=cosine
            lfo = (shape == 9) ? linear : cosine;
        }
        else if (shape == 11) { // random cubic
            lfo = eviRandyN(phase, n);
        }
        else if (shape == 12) { // random walk
            lfo = glideLfoBipolarN(phase, n);
        }
        else {                  // 13=white noise
            lfo = n;
        }
    }
    else {                      // 0=off
        lfo = 0;
    }

    return lfo;
}

