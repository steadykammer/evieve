	morphR		= cN * (yLR * cL) + (yHR * cH);
	return 		morphL, morphR;
}

// a formlet filter, work in progress

tptSvfFormlet(x, g, r1, r2, a1, a2)
{
	History	s11(0), s21(0), s12(0), s22(0);

	yH1	= (x - (r1 + g) * s11 - s21) * a1;
	yH2	= (x - (r2 + g) * s12 - s22) * a2;

	gyH1	= g * yH1;
	yB1	    = gyH1 + s11;
	s11	    = gyH1 + yB1;

	gyH2	= g * yH2;
	yB2	    = gyH2 + s12;
	s12	    = gyH2 + yB2;

	gyB1	= g * yB1;
	yL1	    = gyB1 + s21;
	s21	    = gyB1 + yL1;

	gyB2	= g * yB2;
	yL2	    = gyB2 + s22;
	s22	    = gyB2 + yL2;

	return	yB2 - yB1;  // you can mess with the summing here and produce interesting impulses
}

tptSvfCoeffFormlet(cutoff, AT, DT)      // AT/DT are attack/decay times in seconds
{
    LOGTH   = -6.907755278982137;       // ln(0.001) = -60dB
	w		= PI * cutoff / SAMPLERATE;
	g 		= tanA2(w);
	temp 	= samplerate * 0.1;
    // something is wrong with my calculations, time is not right
    // also, at the moment, decay seems to be frequency dependent, which is wrong
	r1 		= 1 - maximum(expA(LOGTH / (AT * temp)), 0);  // t60...
    r2  	= 1 - maximum(expA(LOGTH / (DT * temp)), 0);
//  omg		= 1 - g;
	h1		= 1 / (1 + (r1 + g) * g);	// problem must be in feedback factor, oder?
	h2		= 1 / (1 + (r2 + g) * g);

	return	g, r1, r2, h1, h2;
}

// attack / decay times in ms, must be clamped low, such as 0.01 ?
eviFilterFormlet(x, cutoff, attack, decay)
{
	History prev_cf(0);
	// g corrected for audio rate FM of cutoff
    lin_cf  = cutoff - prev_cf;
    corr_cf = cutoff + 0.5 * lin_cf;
    prev_cf = cutoff;
    AT          = attack * 0.001;
    DT          = decay * 0.001;
	g, r1, r2, h1, h2   = tptSvfCoeffFormlet(corr_cf, AT, DT);
	yB 	        = tptSvfFormlet(x, g, r1, r2, h1, h2);
	fofilt		= yB * 1.995262; // + 6dB, because
	return 		fofilt;
}

