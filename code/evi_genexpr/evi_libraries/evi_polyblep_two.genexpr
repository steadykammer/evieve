		h	= (sin73(t6 / pw * PI) * 2) - pw * fdp;
	} else {
		h	= 0 - pw * fdp;
	}
	h2	= (poly_blamp(t7 - t77, dt) + poly_blamp(t6, dt)) / pw * PI * dt + h;
	return	h2;
}
*/

// !! if you call any of the above functions independently you must deal with gain & dc yourself !!

