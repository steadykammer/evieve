// evieve poly bleps etc

//	//	//	below are 2-point poly bleps, not as good 'evi_polyblep_four.genexpr' ...

// PolyBLEP quasi-bandlimited oscilators
// Implementation and morphing by Pete for evieve
// Sources:
// http://www.acoustics.hut.fi/publications/papers/smc2010-phaseshaping/
// Original paper & Python code Copyright:
// "Phaseshaping Oscillator Algorithms for Musical Sound Synthesis"
// by Jari Kleimola, Victor Lazzarini, Joseph Timoney, and Vesa Valimaki.
// License:
// Public Domain (??)

// bandlimiters

// BLEP, bandlimited step
poly_blep(t, dt)
{
	yblep	= 0;
	if (t < dt) {
		alpha	=  (t / dt) - 1;
		yblep	= -(alpha * alpha);
	} else if (t > 1 - dt) {
		alpha	=  (t - 1) / dt + 1;
		yblep	=  (alpha * alpha);
	} else {
		yblep	=  0;
	}
	return	yblep;
}

// BLAMP, bandlimited ramp
// derived from poly_blep()
poly_blamp(t, dt)
{
	odt		=  0.3333333333333333;
	yblamp	=  0;
	if (t < dt) {
		alpha	= (t / dt) - 1;
		yblamp	=  -odt * alpha * alpha * alpha;
	} else if (t > 1 - dt) {
		alpha	= (t - 1) / dt + 1;
		yblamp	=   odt * alpha * alpha * alpha;
	} else {
		yblamp	=  0;
	}
	return	yblamp;
}

// BLUH, bandlimited curve
// Tale
poly_bluh(t, dt)
{
	ybluh	= 0;
	if (t < dt) {
		alpha	=  (t / dt) - 1;
		ybluh	= ((alpha * alpha * alpha * alpha) - alpha) * -4;
	} else if (t > 1 - dt) {
		alpha	= ((t - 1) / dt + 1);
		ybluh	= ((alpha * alpha * alpha * alpha) - alpha) *  4;
	} else {
		ybluh	=  0;
	}
	return	ybluh;
}

// polyblep waves ...

// sawtooth
/*
poly_saw(t, dt)
{
	t2	= wrap(t + 0.5, 0, 1);
	sw	= (t2 + t2) - 1;
	sw -= poly_blep(t2, dt);
	return	sw;
}
*/
// i am not convinced trunc() cheaper than wrap() in gen~ land (it
// should be) - need to test (could be extrapolated to other oscillators)

// ok for full range
poly_saw(t, dt)
{
	t2 	= t + 0.5;
	t2 -= trunc(t2);
	sw	= (t2 + t2) - 1;
	sw -= poly_blep(t2, dt);
	return	sw;
}

// ramp (-sawtooth)

// ok for full range
poly_ramp(t, dt)
{
	ra	= 1 - (t + t);
	ra += poly_blep(t, dt);
	return	ra;
}

// square

// ok for full range
poly_sqr(t, dt)
{
	t2	= wrap(t + 0.5, 0, 1);
	s	= t < 0.5 ? 1 : -1;
	s  += poly_blep(t, dt) - poly_blep(t2, dt);
	return	s;
}

// ok for full range
// pw: traditional rect osc as expected, morphs between +pulse..-pulse
poly_rect(t, dt, pw)
{
	t1	= wrap(t + 1 - pw, 0, 1);
	r	= -(pw + pw);
	if (t < pw) 
		r += 2;
	r  += poly_blep(t, dt) - poly_blep(t1, dt);
	return	r;
}

// modified square

// this works brilliantly full range, but the further away from pw < 0.5 (> 0.5 works fine) for the (samplerate / 4) switch,
// 'jumps' to sine() because of gain disparity by that point in frequency range...
// ...should probably make a gain compensation as function of pw
// pw: morphs between bipolar_pulse..square_steps..square_rect
poly_sqr2(t, dt, pw)
{
	dyngain	= 0.5;	// this should be the dynamic gain function suggested in above comment, for pw < 0.5
	pw0525	= (pw - 0.5) * 0.25;
	pw0505	= (1 - pw) * 0.5;
	t31		= wrap(t + 0.875 + pw0525, 0, 1);
	t21		= wrap(t + 0.375 + pw0525, 0, 1);
	// sqr_1
	s		= t31 < 0.5 ? 1 : -1;
	s	   += poly_blep(t31, dt) - poly_blep(t21, dt);
	t31	   += pw0505;
	t31		= wrap(t31, 0, 1);
	t21	   += pw0505;
	t21		= wrap(t21, 0, 1);
	// sqr_2
	s	   += t31 < 0.5 ? 1 : -1;
	s	   += poly_blep(t31, dt) - poly_blep(t21, dt);
	return	s * dyngain;
}

// triangle

// ok for full range
poly_tri(t, dt)
{
	t1	= wrap(t + 0.25, 0, 1);
	t3	= wrap(t + 0.75, 0, 1);
	tt	=  t * 4;
	if (tt >= 3) {
		tt -= 4;
	} else if (tt > 1) {
		tt	= 2 - tt;
	}
	dt4 = dt + dt + dt + dt;
	tt += dt4 * (poly_blamp(t1, dt) - poly_blamp(t3, dt));
	return	tt;
}

// modified triangle

// warning: with pw at ± extremes, this aliases easily above approx 500 Hz,
// pw: morphs between -sawtooth..sawtooth as expected
// but just below (e.g. ± 0.99), aliasing supression as good as any of the other classic waveforms here
poly_tri2(t, dt, pw)
{
	pw05	= pw * 0.5;
	t2		= wrap((t + pw05), 0, 1);
	tm		= wrap((t + 1 - pw05), 0, 1);
	tt		= t * 2;
	if (tt >= 2 - pw) {
		tt	= (tt - 2) / pw;
	} else if (tt >= pw) {
		tt	= 1 - (tt - pw) / (1 - pw);
	} else {
		tt /= pw;
	}
	tt += dt / (pw - pw * pw) * (poly_blamp(t2, dt) - poly_blamp(tm, dt));
	return	tt;
}

// triangular pulse

// warning, keep pw > about 0.05; but the further away from pw < 0.5 (> 0.5 works fine) for the (samplerate / 4) switch,
// 'jumps' to sine() because of gain disparity by that point in frequency range...
// ...should probably make a gain compensation as function of pw
// pw: morphs between +pulse..triangle, of course does not zero cross with phase unless pw == 1
poly_trip(t, dt, pw)
{
	dyngain	= 1;	// this should be the dynamic gain function suggested in above comment, for pw < 0.5
	tr		= 0;
	pw05	= pw * 0.5;
	t3		= wrap((t + 0.75 + pw05), 0, 1);
	if (t3 >= pw) {
		tr	= -pw;
	} else {
		tr	= t3 + t3 + t3 + t3;
		if (tr >= (pw + pw)) {
			tr	= 4 - tr / pw - pw;
		} else {
			tr	= tr / pw - pw;
		}
	}
	if (pw > 0) {
		tm	= wrap((t3 + 1 - pw05), 0, 1);
		tf	= wrap((t3 + 1 - pw), 0, 1);
		pbtd = poly_blamp(tm, dt);
		tr += (dt + dt) / pw * (poly_blamp(t3, dt) - (pbtd + pbtd) + poly_blamp(tf, dt));
	}
	return	tr * dyngain;
}

// trapezoids

// ok for full range
poly_trap(t, dt)
{
	tr	= t + t + t + t;
	if (tr >= 3) {
		tr -= 4;
	} else if (tr > 1) {
		tr	= 2 - tr;
	}
	tr	= clamp((tr + tr), -1, 1);	// !! clip !!
	t1	= wrap(t + 0.125, 0, 1);
	t2	= wrap(t1 + 0.5, 0, 1);
	// tri_1
	dt4 = dt + dt + dt + dt;
	tr += dt4 * (poly_blamp(t1, dt) - poly_blamp(t2, dt));
	t11	= wrap(t + 0.375, 0, 1);
	t22	= wrap(t11 + 0.5, 0, 1);
	// tri_2
	tr += dt4 * (poly_blamp(t11, dt) - poly_blamp(t22, dt));
	return	tr;
}

// this is a pretty amazing oscillator, as we have pretty bloody good antialiasing
// for the full frequency range AND for the full pw modulation range (although pw should not go above about +0.99)
// pw: morphs perfectly between triangle..square_rect, always zero crossing
poly_trap2(t, dt, pw)
{
	pw025	= pw * 0.25;
	pws		= 1 / (1 - pw);
	tr		= t + t + t + t;
	if (tr >= 3) {
		tr -= 4;
	} else if (tr > 1) {
		tr	= 2 - tr;
	}
	tr	= clamp(pws * tr, -1, 1);	// !! clip !!
	t1	= wrap(t + 0.25 - pw025, 0, 1);
	t2	= wrap(t1 + 0.5, 0, 1);
	// tri_1
	tr += pws * (dt + dt) * (poly_blamp(t1, dt) - poly_blamp(t2, dt));
	t11	= wrap(t + 0.25 + pw025, 0, 1);
	t22	= wrap(t11 + 0.5, 0, 1);
	// tri_2
	tr += pws * (dt + dt) * (poly_blamp(t11, dt) - poly_blamp(t22, dt));
	return	tr;
}

//	//	//	morphing oscillators	//	//	//

// saw..tri..saw

morph_saw_tri_saw(t, dt, morph)		// morph == 0..1, always perfectly zero crosses
{
	morph_osc	= 0;
	if (morph <= 0) {
		morph_osc	= poly_ramp(t, dt);
	} else if ( (morph > 0) && (morph < 1) ) {
		morph_osc	= poly_tri2(t, dt, morph);
	} else if (morph >= 1) {
		morph_osc	= poly_saw(t, dt);
	}
	return	morph_osc;
}

// from saw to rect through triangle/trapezoid

// believe it or not, this pretty much works perfectly with no audio mixing on the oscillator output
morph_saw_tri_square(t, dt, morph)						// morph controls pwm, perfectly zero crosses throught range
{
	morph_osc	= 0;
	pw_1		= 1 - clip(morph, 0, 0.5);
	pw_2		= (clip(morph, 0.5, 1) - 0.5) * 2;
	if (morph <= 0) {
		morph_osc	= poly_saw(t, dt);
	} else if ( (morph > 0) && (morph <= 0.5) ) {
		morph_osc	= poly_tri2(t, dt, pw_1);
	} else if ( (morph > 0.5) && (morph < 1) ) {
		morph_osc	= poly_trap2(t, dt, pw_2);
	} else if (morph >= 1) {
		morph_osc	= poly_sqr(t, dt);
	}
	return	morph_osc;
}

// pulse..tri..pulse

morph_pulse_tri_pulse(t, dt, morph)			// !! clip morph 0..1
{
	morph_osc	= 0;
	t22			= wrap(t + 0.5, 0, 1);
	pw_0		= morph * 2;
	pw_1		= clip(pw_0, 0, 1);
	pw_2		= (clip(pw_0, 1, 2) - 1);
	pw_11		= (pw_1 >= 0.5) ? pw_1 : pw_1 * 0.8 + 0.1;
	pw_22		= 1 - ((pw_2 <= 0.5) ? pw_2 : pw_2 * 0.8 + 0.1);
	if (pw_0 <= 1) {
		morph_osc	= poly_trip(t, dt, pw_11);
	} else if (pw_0 > 1) {
		morph_osc	= poly_trip(t22, dt, pw_22) * -1;
	}
	return		morph_osc;
}

// from saw to rect negative pulse through triangle and trapezoid

// believe it or not, this pretty much works perfectly with no audio mixing on the oscillator output
morph_sawpulse_trirect(t, dt, morph)				// morph controls pwm and always perfectly zero crosses
{
	morph_osc	= 0;
	pw_0		= morph * 4;
	pw_1		= 1 - (clip(pw_0, 0, 1) * 0.5);
	pw_2		= (clip(pw_0, 1, 3) - 1) * 0.5;
	pw_3		= clip(pw_0, 3, 4) - 3;
	pw_33		= ((pw_3 * pw_3) * 0.45) + 0.5;		// could make it more like "* 0.42" or so to make max tone similar to initial saw ??
	if (pw_0 <= 0) {
		morph_osc	= poly_saw(t, dt);
	} else if ( (pw_0 > 0) && (pw_0 <= 1) ) {
		morph_osc	= poly_tri2(t, dt, pw_1);
	} else if ( (pw_0 > 1) && (pw_0 < 3) ) {
		morph_osc	= poly_trap2(t, dt, pw_2);
	} else if (pw_0 >= 3) {
		morph_osc	= poly_rect(t, dt, pw_33);
	}
	return	morph_osc;
}

// from positive triangle pulse to negative rect pulse through triangle and trapezoid

// believe it or not, this pretty much works perfectly with no audio mixing on the oscillator output
morph_pulsepulse_trirect(t, dt, morph)				// morph controls pwm, zero crossing only 0.25..1
{
	morph_osc	= 0;
	pw_0		= morph * 3;
	pw_1		= clip(pw_0, 0, 1);
	pw_2		= clip(pw_0, 1, 2) - 1;
	pw_3		= clip(pw_0, 2, 3) - 2;
	pw_11		= (pw_1 >= 0.5) ? pw_1 : pw_1 * 0.8 + 0.1;
	pw_33		= ((pw_3 * pw_3) * 0.45) + 0.5;		// 
	if ( (pw_0 >= 0) && (pw_0 <= 1) ) {
		morph_osc	= poly_trip(t, dt, pw_11);
	} else if ( (pw_0 > 1) && (pw_0 < 2) ) {
		morph_osc	= poly_trap2(t, dt, pw_2);
	} else if (pw_0 >= 2) {
		morph_osc	= poly_rect(t, dt, pw_33);
	}
	return	morph_osc;
}

// from positive triangle pulse to bipolar square pulse through triangle and trapezoid

// believe it or not, this pretty much works perfectly with no audio mixing on the oscillator output
morph_pulsebipulse_trirect(t, dt, morph)			// morph controls pwm, zero crossing only 0.25..1
{
	morph_osc	= 0;
	pw_0		= morph * 3;
	pw_1		= clip(pw_0, 0, 1);
	pw_2		= clip(pw_0, 1, 2) - 1;
	pw_3		= 1 - (clip(pw_0, 2, 3) - 2);
	pw_11		= (pw_1 >= 0.5) ? pw_1 : pw_1 * 0.8 + 0.1;
	pw_33		= (pw_3 >= 0.5) ? pw_3 : pw_3 * 0.88 + 0.06;
	if ( (pw_0 >= 0) && (pw_0 < 1) ) {
		morph_osc	= poly_trip(t, dt, pw_11);
	} else if ( (pw_0 >= 1) && (pw_0 < 2) ) {
		morph_osc	= poly_trap2(t, dt, pw_2);
	} else if (pw_0 >= 2) {
		morph_osc	= poly_sqr2(t, dt, pw_33);
	}
	return	morph_osc;
}
