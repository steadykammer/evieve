// szilagyi

szilagyi(x, l, h)
{
	x = clip(x, l, h);
	// x = evi_hardclip(x, l, h);
	return szilagyiAdaa2(x);
}

// fixed 2x quasi oversampling (hermite6)
szilagyiAdaa2_2x_6POINT(XIN, l, h)
{	// up 2
	History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History doX0(0);

	// up 2x
	x0_0_a  = XIN + 0;
	x1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0  = umT2_0 + 0;

	// process 2x
	y1_0  = szilagyi(x1_0, l, h);
	y2_0  = szilagyi(x2_0, l, h);

	// down 2x
	y2_0_a  = y2_0 + 0;
	y2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0  = (doX0 + y2_1) * 0.5;

	// update
	umTm2_0 = umTm1_0;
	umTm1_0 = umT0_0;
	umT0_0  = umT1_0;
	umT1_0  = umT2_0;
	umT2_0  = x0_0_a;

	doX0  = y1_0;

	dmT3_1  = dmT2_1;
	dmT2_1  = dmT1_1;
	dmT1_1  = dmT0_1;
	dmT0_1  = dmTm1_1;
	dmTm1_1 = y2_0;

	return dcblock(y0_0);
}

// fixed 4x quasi oversampling (hermite6)
