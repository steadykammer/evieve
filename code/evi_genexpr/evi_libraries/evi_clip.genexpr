// fixed 2x quasi oversampling (cubic4) fixed 2x
adSc2_2x_4POINT(XIN)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 2x
	y1_0	= adSc2(x1_0, 2);
	y2_0	= adSc2(x2_0, 2);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return dcblock(y0_0);
}

// fixed 4x quasi oversampling (cubic4)
adSc2_4x_4POINT(XIN)
{	// up 4
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// up 4x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.25,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= cubic_hermite_interp(0.5,		umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0	= cubic_hermite_interp(0.75,	umTm1_0, umT0_0, umT1_0, x0_0_a);

	// process 4x
	y1_0	= adSc2(x1_0, 4);
	y2_0	= adSc2(x2_0, 4);
	y3_0	= adSc2(x3_0, 4);
	y4_0	= adSc2(umT1_0 + 0, 4);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(0.5,		y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3);

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return dcblock(y0_0);
}

