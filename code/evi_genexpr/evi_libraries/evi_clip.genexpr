require("evi_utilities.genexpr");
require("evi_interp.genexpr");


//	//	//	Hard Clip	//	//	//

funcHc0(x)
{
	return clamp(x, -1, 1);
}

funcHc1(x) // first antiderivative
{
	ad1 = x;
	ir = xRange(x);
	if (ir) {
		ad1 = x * x * 0.5;
	} else {
		ad1 = x * xSgn(x) - 0.5;
	}
	return ad1;
}

funcHc2(x) // second antiderivative
{
	ad2 = x;
	ods = 0.166666666666667;
	ir = xRange(x);
	if (ir) {
		ad2 = x * x * x * ods;
	} else {
		x05 = x * 0.5;
		ad2 = ((x * x05) + ods) * xSgn(x) - x05;
	}
	return ad2;
}

adHc1(x)
{
	History x1(0), ad1_x1(0);
	TOL = 0.00001;
	xmx1 = x - x1;
	illCondition = abs(xmx1) < TOL;
	ad1_x = funcHc1(x);

	y = 0;
	if (illCondition) {
		y = funcHc0(0.5 * (x + x1));
	} else {
		y = (ad1_x - ad1_x1) / xmx1;
	}

	ad1_x1 = ad1_x;
	x1 = x;

	return y;
}

adHc2(x)
{
	History x1(0), x2(0), ad2_x1(0), d2(0);
	TOL = 0.00001;
	xmx2 = x - x2;
	illCondition = abs(xmx2) < TOL;

	d1 = x;
	xmx1 = x - x1;
	d1Condition = abs(xmx1) < TOL;
	ad2_x0 = funcHc2(x);
	if (d1Condition) {
		d1 = funcHc1(0.5 * (x + x1));
	} else {
		d1 = (ad2_x0 - ad2_x1) / xmx1;
	}

	fb = x;
	xBar = 0.5 * (x + x2);
	delta = xBar - x1;
	fallbackCondition = abs(delta) < TOL;
	if (fallbackCondition) {
		fb = funcHc0(0.5 * (xBar + x1));
	} else {
		fb = (2 / delta) * (funcHc1(xBar) + (ad2_x1 - funcHc2(xBar)) / delta);
	}

	y = x;
	if (illCondition) {
		y = fb;
	} else {
		y = (2 / xmx2) * (d1 - d2);
	}

	d2 = d1;
	x2 = x1;
	x1 = x;
	ad2_x1 = ad2_x0;

	return y;
}

// fixed 2x quasi oversampling (hermite6)
adHc2_2x_6POINT(XIN)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 2x
	y1_0	= adHc2(x1_0);
	y2_0	= adHc2(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return dcblock(y0_0);
}

// fixed 4x quasi oversampling (hermite6)
adHc2_4x_6POINT(XIN)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 4x
	y1_0	= adHc2_2x_6POINT(x1_0);
	y2_0	= adHc2_2x_6POINT(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return dcblock(y0_0);
}

// fixed 2x quasi oversampling (cubic4)
adHc2_2x_4POINT(XIN)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 2x
	y1_0	= adHc2(x1_0);
	y2_0	= adHc2(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return dcblock(y0_0);
}

// fixed 4x quasi oversampling (cubic4)
adHc2_4x_4POINT(XIN)
{	// up 4
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// up 4x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.25,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= cubic_hermite_interp(0.5,		umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0	= cubic_hermite_interp(0.75,	umTm1_0, umT0_0, umT1_0, x0_0_a);

	// process 4x
	y1_0	= adHc2(x1_0);
	y2_0	= adHc2(x2_0);
	y3_0	= adHc2(x3_0);
	y4_0	= adHc2(umT1_0 + 0);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(0.5,		y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3);

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return dcblock(y0_0);
}


//	//	//	Diode Clip	//	//	//

// Copyright (C) 2022-2024 Orastron Srl unipersonale
// Stefano D'Angelo, GPL v3

w3(x)
{
	x1 = -3.341459552768620;
	x2 =  8;
	a  = -1.314293149877800e-3;
	b  =  4.775931364975583e-2;
	c  =  3.631952663804445e-1;
	d  =  6.313183464296682e-1;
	return (x < x1) ? 0 : ((x < x2) ? d + x * (c + x * (b + x * a)) : x - logApprox(x));
}

w4(x) // Wright's omega
{
	y = w3(x);
	return y - (y - expApprox(x - y)) / (y + 1);
}

diodeCoeffs(SR) // param rate, in fact this only ever needs updating if the samplerate changes
{
	// component values
	// Is	= 0.0000000000000001;
	// R	= 2200;
	// C	= 0.00000001;
	Param	CR(0.000022); 			// C * R
	Param	IR(0.00000000000022);	// Is * R
	Param	VT(0.026);

	// absolute constants
	k1 = 45454.545454545454545;		// 1 / (C * R)
	k4 = 38.461538461538462;		// 1 / VT

	// samplerate dependent constants
	B0 =  SR + SR;
	B1 = -B0;
	B2 =  B0 * CR + 1;
	A1 =  1;

	// k
	k2 = CR / B2;
	k3 = IR / B2;
	k5 = logApprox(IR / (B2 * VT));	// this must be logApprox()
	k6 = B1 - A1 * B0;

	return k1, k2, k3, k4, k5, k6, VT, A1;
}

diode(Vin, k1, k2, k3, k4, k5, k6, VT, A1) // audio rate
{
	History	p1(0);

	q = k1 * Vin - p1;
	r = xSgn(q);
	w = k2 * q + k3 * r;

	Vout = w - VT * r * w4(k4 * r * w + k5);
	p1 = k6 * Vout - A1 * p1;
  
	return Vout;
}

// todo: expose gain & bias
diodeWrap(Vin, k1, k2, k3, k4, k5, k6, VT, A1, gain=0.999999, bias=0.000001)
{
	History didu(0);
	d0 = gain * Vin + bias;
	d1 = diode(d0, k1, k2, k3, k4, k5, k6, VT, A1);
	return dcblock(d1 - w4(bias));
}

// fixed 2x quasi oversampling (cubic4)
diode_2x_4POINT(XIN, k1, k2, k3, k4, k5, k6, VT, A1)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 2x
	y1_0	= diodeWrap(x1_0, k1, k2, k3, k4, k5, k6, VT, A1);
	y2_0	= diodeWrap(x2_0, k1, k2, k3, k4, k5, k6, VT, A1);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return (y0_0);
}
