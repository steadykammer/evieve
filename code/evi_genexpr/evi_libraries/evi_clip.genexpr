// fixed 4x quasi oversampling (cubic)
diode_4x_4POINT(XIN, k1, k2, k3, k4, k5, k6, VT, A1)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 2x
	y1_0	= diode_2x_4POINT(x1_0, k1, k2, k3, k4, k5, k6, VT, A1);
	y2_0	= diode_2x_4POINT(x2_0, k1, k2, k3, k4, k5, k6, VT, A1);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return (y0_0);
}

// fixed 8x quasi oversampling (cubic)
diode_8x_4POINT(XIN, k1, k2, k3, k4, k5, k6, VT, A1)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 8x
	y1_0	= diode_4x_4POINT(x1_0, k1, k2, k3, k4, k5, k6, VT, A1);
	y2_0	= diode_4x_4POINT(x2_0, k1, k2, k3, k4, k5, k6, VT, A1);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return (y0_0);
}


//	//	//	Shape Clip	//	//	//

shape(xin)
{
	History hd(0);
	x  = adHc2(xin) * 2.058918;
	a  = sqrt1_2 + expApprox(sqrt(abs(x)) * -sqrt1_2);
	ex = expApprox(x);
	y  = (ex - expApprox(-x * a)) / (ex + 1 / ex);

	return dcblock(y * 0.696916063374902);
}

shapeWrap(x2, drive) // basically the Gloubi-boulga by Laurent de Soras
{
	History hdw(0);
	d  = LN2 * drive;
	s  = 1 / sqrt(d);
	x1 = adHc2(x2);
	x  = clamp(x1 * d, -40, 40); // chosen for dcblock & approxes
	a  = 1 + expApprox(sqrt(abs(x)) * -0.75);
	ex = expApprox(x);
	y  = (ex - expApprox(-x * a)) / (ex + 1 / ex);

	return dcblock(y * s);
}

// fixed 2x quasi oversampling (hermite6)
shape_2x_6POINT(XIN)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 2x
	y1_0	= shape(x1_0);
	y2_0	= shape(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return (y0_0);
}

