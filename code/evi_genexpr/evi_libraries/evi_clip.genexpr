// fixed 4x quasi oversampling (cubic4)
diode_4x_4POINT(XIN, k1, k2, k3, k4, k5, k6, VT, A1)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 2x
	y1_0	= diode_2x_4POINT(x1_0, k1, k2, k3, k4, k5, k6, VT, A1);
	y2_0	= diode_2x_4POINT(x2_0, k1, k2, k3, k4, k5, k6, VT, A1);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return (y0_0);
}

// fixed 8x quasi oversampling (cubic4)
diode_8x_4POINT(XIN, k1, k2, k3, k4, k5, k6, VT, A1)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 8x
	y1_0	= diode_4x_4POINT(x1_0, k1, k2, k3, k4, k5, k6, VT, A1);
	y2_0	= diode_4x_4POINT(x2_0, k1, k2, k3, k4, k5, k6, VT, A1);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return (y0_0);
}


//	//	//	Asym Clip	//	//	//

asym(xin)
{
	History hd(0);
	x  = adHc2(xin) * 2.058918;
	a  = sqrt1_2 + expApprox(sqrt(abs(x)) * -sqrt1_2);
	ex = expApprox(x);
	y  = (ex - expApprox(-x * a)) / (ex + 1 / ex);

	return dcblock(y * 0.696916063374902);
}

asymWrap(x2, drive) // basically the Gloubi-boulga by Laurent de Soras
{
	History hdw(0);
	d  = LN2 * drive;
	s  = 1 / sqrt(d);
	x1 = adHc2(x2);
	x  = clamp(x1 * d, -40, 40); // chosen for dcblock & approxes
	a  = 1 + expApprox(sqrt(abs(x)) * -0.75);
	ex = expApprox(x);
	y  = (ex - expApprox(-x * a)) / (ex + 1 / ex);

	return dcblock(y * s);
}

// fixed 2x quasi oversampling (hermite6)
asym_2x_6POINT(XIN)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 2x
	y1_0	= asym(x1_0);
	y2_0	= asym(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return (y0_0);
}

// fixed 4x quasi oversampling (hermite6)
asym_4x_6POINT(XIN)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 4x
	y1_0	= asym_2x_6POINT(x1_0);
	y2_0	= asym_2x_6POINT(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return (y0_0);
}


//	//	//	Soft Clip	//	//	//

/*
funcSc0(x) // tanh Lambert approx
{
	x2 = x * x;
	a = (((x2 + 378) * x2 + 17325) * x2 + 135135) * x;
	b = ((28 * x2 + 3150) * x2 + 62370) * x2 + 135135;
	return clamp((a / b), -1, 1); // clamp() ?
}
*/
funcSc0(x) // alternative tanh approx
{
	xa		= abs(x);
	x2		= xa * xa;
	x3		= xa * x2;
	x4		= x2 * x2;
	x7		= x3 * x4;
	res		= 1 - (1 / (1 + xa + x2 + 0.58576695 * x3 + 0.55442112 * x4 + 0.057481508 * x7));
	return	(x > 0) ? res : -res; // >= ?
}

funcSc1(x) // first antiderivative, approx version for Adaa1
{
	return logApprox(coshApprox(x));
}

funcSc11(x) // first antiderivative, real version for Adaa2
{
	return log(cosh(x));
//	return logApprox(coshApprox(x)); // Approxes no good for Adaa2 as do not match our tanh() Approx
}

// almost pointless because so expensive with this forced precision
funcSc2(x) // second antiderivative
{
//	C = 0.4112335167120566; // pow(PI,2)/24
	expVal = exp(-2 * x);
	logvalp1 = log(expVal + 1); // logApprox no good
	fsc1x = funcSc11(x);
	return 0.5 * (Li2Approx(-expVal) - x * (x + (logvalp1 + logvalp1) - (fsc1x + fsc1x)));// + C;
//	OR?: F1(x) = F1(x0 * sgn(x)) + ((x*x - x0*x0) / 2) * sgn(x); // need to work out this approx
}

adSc1(x)
{
	History x1(0), ad1_x1(0);
	TOL = 0.00001; // i've seen this in some sources as 0.018
	xmx1 = x - x1;
	illCondition = abs(xmx1) < TOL;
	ad1_x = funcSc1(x);

	y = 0;
	if (illCondition) {
		y = funcSc0(0.5 * (x + x1));
	} else {
		y = (ad1_x - ad1_x1) / xmx1;
	}

	ad1_x1 = ad1_x;
	x1 = x;

	return y;
}

adSc2(x, OS)
{
	History x1(0), x2(0), ad2_x1(0), d2(0);
	TOL = 0.00001;
//	TOLfb = 0.00000001; // because of 2x-fake-oversampling we need much smaller o-precision ?
	xmx2 = x - x2;
	illCondition = abs(xmx2) < TOL;

	d1 = x;
	xmx1 = x - x1;
	d1Condition = abs(xmx1) < TOL;
	ad2_x0 = funcSc2(x);
	if (d1Condition) {
		d1 = funcSc11(0.5 * (x + x1));
	} else {
		d1 = (ad2_x0 - ad2_x1) / xmx1;
	}

	fb = x;
	xBar = 0.5 * (x + x2);
	delta = xBar - x1;
	fallbackCondition = abs(delta) < TOL;
	if (fallbackCondition && OS == 2) {
		// 2x oversampling destroys the precision of our tanh() Approx, so...
		fb = tanh(0.5 * (xBar + x1)); // :-( :-( :-(
	} else if (fallbackCondition) {
		fb = funcSc0(0.5 * (xBar + x1));
	} else {
		fb = (2 / delta) * (funcSc11(xBar) + (ad2_x1 - funcSc2(xBar)) / delta);
	}

	y = x;
	if (illCondition) {
		y = fb;
	} else {
		y = (2 / xmx2) * (d1 - d2);
	}

	d2 = d1;
	x2 = x1;
	x1 = x;
	ad2_x1 = ad2_x0;

	return y;
}

// fixed 2x quasi oversampling (hermite6)
adSc1_2x_6POINT(XIN)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 2x
	y1_0	= adSc1(x1_0);
	y2_0	= adSc1(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return dcblock(y0_0);
}

// fixed 2x quasi oversampling (hermite6) fixed 2x
adSc2_2x_6POINT_fix2(XIN)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 2x
	y1_0	= adSc2(x1_0, 2);
	y2_0	= adSc2(x2_0, 2);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return dcblock(y0_0);
}

