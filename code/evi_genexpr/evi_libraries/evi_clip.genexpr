	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return (y0_0);
}


//	//	//	Soft Clip	//	//	//

/**
 * Li2() ::
 * @brief Real dilogarithm mathrm{Li}_2(x)
 * @param x real argument
 * @return mathrm{Li}_2(x)
 * @author Alexander Voigt
 * @license GPL v3
 * 
 * Implemented as an economized Pade approximation with a
 * maximum error of 4.16e-18 <<-- definitely worse with my implementation :-)
 */
Li2Approx(x) // this is really stupid in gen~, & N.B. - cannot use the Approxes in negative branches
{
	MPIPI6	= -1.6449340668482264;	// -PI*PI/6
	MPIPI12	= -0.8224670334241132;	// -PI*PI/12
	PIPI6	=  1.6449340668482264;	//  PI*PI/6
	PIPI3	=  3.289868133696453;	//  PI*PI/3

	li1 = 0;
	horner = 0;
	y = 0;
	r = 0;
	s = 1;

	// transform to [0, 1/2)
	if (x < -1) {
		omx = 1 - x;
		l = log(omx); // must be log()
		y = 1/omx;
		r = MPIPI6 + l*(0.5*l - log(-x)); // must be log()
		s = 1;
		horner = 1;
	} else if (x == -1) {
		li1 = MPIPI12;
		horner = 0;
	} else if (x < 0) {
		l = fixdenorm(log(-x + 1)); // no "log1p()" in gen~ :-(
		y = x/(x - 1);
		r = -0.5*l*l;
		s = -1;
		horner = 1;
	} else if (x == 0) {
		li1 = 0;
		horner = 0;
	} else if (x < 0.5) {
		y = x;
		r = 0;
		s = 1;
		horner = 1;
	} else if (x < 1) {
		omx = 1 - x;
		y = omx;
		r = PIPI6 - logApprox(x)*logApprox(omx);
		s = -1;
		horner = 1;
	} else if (x == 1) {
		li1 = PIPI6;
		horner = 0;
	} else if (x < 2) {
		omodx = 1 - 1/x;
		l = logApprox(x);
		y = omodx;
		r = PIPI6 - l*(logApprox(omodx) + 0.5*l);
		s = 1;
		horner = 1;
	} else {
		l = logApprox(x);
		y = 1/x;
		r = PIPI3 - 0.5*l*l;
		s = -1;
		horner = 1;
	}

	z = y - 0.25;

	// unroll horner because gen~, sorry :-(

	p = -2.4630612614645039828e-4;
	p = p*z +  3.1608910440687221695e-2;
	p = p*z + -4.6937565143754629578e-1;
	p = p*z +  2.4733515209909815443;
	p = p*z + -6.0516124315132409155;
	p = p*z +  7.4819657596286408905;
	p = p*z + -4.5353562730201404017;
	p = p*z +  1.0706105563309304277;

	q = -3.2116618742475189569e-3;
	q = q*z +  9.8554565816757007266e-2;
	q = q*z + -8.9936784740041174897e-1;
	q = q*z +  3.6245392503925290187;
	q = q*z + -7.4634190853767468810;
	q = q*z +  8.1790029773247428573;
	q = q*z + -4.5355682121856044935;
	q = q*z +  1.0000000000000000000;

	li2 = r + s*y*p/q;

	return horner ? li2 : li1;
}
/*
funcSc0(x) // tanh Lambert approx
{
	x2 = x * x;
	a = (((x2 + 378) * x2 + 17325) * x2 + 135135) * x;
	b = ((28 * x2 + 3150) * x2 + 62370) * x2 + 135135;
	return clamp((a / b), -1, 1); // clamp() ?
}
*/
funcSc0(x) // alternative tanh approx
{
	xa		= abs(x);
	x2		= xa * xa;
	x3		= xa * x2;
	x4		= x2 * x2;
	x7		= x3 * x4;
	res		= 1 - (1 / (1 + xa + x2 + 0.58576695 * x3 + 0.55442112 * x4 + 0.057481508 * x7));
	return	(x > 0) ? res : -res; // >= ?
}

funcSc1(x) // first antiderivative
{
//	return log(cosh(x)); // Approxes no good as do not match our tanh() Approx
	return logApprox(coshApprox(x));
}

funcSc11(x) // first antiderivative
{
	return log(cosh(x)); // Approxes no good as do not match our tanh() Approx
//	return logApprox(coshApprox(x));
}

// almost pointless because so expensive with this forced precision
funcSc2(x) // second antiderivative
{
//	C = 0.4112335167120566; // pow(PI,2)/24
	expVal = exp(-2 * x);
	logvalp1 = log(expVal + 1); // logApprox no good
	fsc1x = funcSc11(x);
	return 0.5 * (Li2Approx(-expVal) - x * (x + (logvalp1 + logvalp1) - (fsc1x + fsc1x)));// + C;
//	OR?: F1(x) = F1(x0 * sgn(x)) + ((x*x - x0*x0) / 2) * sgn(x); // need to work out this approx
}

adSc1(x)
{
	History x1(0), ad1_x1(0);
	TOL = 0.00001; // i've seen this in some sources as 0.018
	xmx1 = x - x1;
	illCondition = abs(xmx1) < TOL;
	ad1_x = funcSc1(x);

	y = 0;
	if (illCondition) {
		y = funcSc0(0.5 * (x + x1));
	} else {
		y = (ad1_x - ad1_x1) / xmx1;
	}

	ad1_x1 = ad1_x;
	x1 = x;

	return y;
}

adSc2(x, OS)
{
	History x1(0), x2(0), ad2_x1(0), d2(0);
	TOL = 0.00001;
//	TOLfb = 0.00000001; // because of 2x-fake-oversampling we need much smaller o-precision ?
	xmx2 = x - x2;
	illCondition = abs(xmx2) < TOL;

	d1 = x;
	xmx1 = x - x1;
	d1Condition = abs(xmx1) < TOL;
	ad2_x0 = funcSc2(x);
	if (d1Condition) {
		d1 = funcSc11(0.5 * (x + x1));
	} else {
		d1 = (ad2_x0 - ad2_x1) / xmx1;
	}

	fb = x;
	xBar = 0.5 * (x + x2);
	delta = xBar - x1;
	fallbackCondition = abs(delta) < TOL;
	if (fallbackCondition && OS == 2) {
		// 2x oversampling destroys the precision of our tanh() Approx, so...
		fb = tanh(0.5 * (xBar + x1)); // :-( :-( :-(
	} else if (fallbackCondition) {
		fb = funcSc0(0.5 * (xBar + x1));
	} else {
		fb = (2 / delta) * (funcSc11(xBar) + (ad2_x1 - funcSc2(xBar)) / delta);
	}

	y = x;
	if (illCondition) {
		y = fb;
	} else {
		y = (2 / xmx2) * (d1 - d2);
	}

	d2 = d1;
	x2 = x1;
	x1 = x;
	ad2_x1 = ad2_x0;

	return y;
}

// fixed 2x quasi oversampling (hermite6)
adSc1_2x_6POINT(XIN)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 2x
	y1_0	= adSc1(x1_0);
	y2_0	= adSc1(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return dcblock(y0_0);
}

// fixed 2x quasi oversampling (hermite6) fixed 2x
adSc2_2x_6POINT_fix2(XIN)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
//	x1_0	= interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a, mode="spline6");
	x2_0	= umT2_0 + 0;

	// process 2x
	y1_0	= adSc2(x1_0, 2);
	y2_0	= adSc2(x2_0, 2);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);
//	y2_1	= interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1, mode="spline6");

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return dcblock(y0_0);
}

// fixed 2x quasi oversampling (hermite6)
adSc2_2x_6POINT(XIN)
