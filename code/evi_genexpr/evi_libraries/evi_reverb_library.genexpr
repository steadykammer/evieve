
//	//	//	evi_reverb_library.genexpr
//	//	//	by Pete for evieve
//	//	//	!! TODO !! -  clean up


// approx...

cosQ52(x) {
	c1 =  0.9999932946;
	c2 = -0.4999124376;
	c3 =  0.0414877472;
	c4 = -0.0012712095;

	x2 = x * x;
	return (c1 + x2 * (c2 + x2 * (c3 + c4 * x2)));
}

cosQ73(x) {
	c1 =  0.999999953464;
	c2 = -0.499999053455;
	c3 =  0.0416635846769;
	c4 = -0.0013853704264;
	c5 =  0.00002315393167;  	

	x2 = x * x;
	return (c1 + x2 * (c2 + x2 * (c3 + x2 * (c4 + c5 * x2))));
}

mtnA(x)		// valid for -halfpi < x < +halfpi
{
	x2		= x * x;
	return	x * (0.999999492001 + x2 * -0.096524608111) / 
				(1 + x2 * (-0.429867256894 + x2 * 0.009981877999));
}

tnA(x)		// valid for 0..1 input
{
	x2		= (x * x);
	x3		= (x2 * x);
	x5		= (x2 * x3);
	return	 ((x5 * 0.133333) + (x3 * 0.333333)) + x;
}

expA(x0)							// approx exp(x) (more accurate than 'fastexp()')
{
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;
	x *= x; x *= x; x *= x; x *= x; x *= x;
	return x;
}

tauA(t)								// approximate 'exp(-1 / (seconds * samplerate))'
{
	y = expA(-1 / (t * samplerate));
	return y + 0.000128;			// approximation has excellent accuracy above...
}									// ...0.01 seconds (10 milliseconds) input

// accuracy: + 4.38 cents .. 108.68 cents @ MIDI 0 .. MIDI 120
mtofApprox(pitch)
{
	mtofMul	= 0.05776226504666;		// log(2) / 12
	mtofAdd	= 2.10117843869262;		// log(440) - (log(2) * 69 / 12)

	return	expA((mtofMul * pitch) + mtofAdd);	// 'expA()' still reasonable accuracy
}

dbtoaApprox(db)
{
	dbtoaA = expA(0.11512925464970 * db);
	return dbtoaA + 0.000128;		// + offset = 0 dB == 1 amplitude
}


// exact ramp smoothing...

eviScurve(segment)						// segment must be linear ramp 0..1
{
	s2		= segment * segment;
	rec		= 1 - segment;
	r2		= rec * rec;
	return	(segment < 0.5) ? (s2 * 2) : (1 - (r2 * 2));
}

// basic linear scaling like linear part of [scale]
eviMap(valueIn, inLow, inHigh, outLow, outHigh)
{
	multiplier = (outLow - outHigh) / (inLow - inHigh);
	return (valueIn - inLow) * multiplier + outLow;
}

eviLine(target, duration)				// target, duration in samples
{
	History	value(0);
	trigger	= change(target);
	ramp	= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);
	line	= eviMap(ramp, 0, 1, latch(value, trigger), latch(target, trigger));
	value	= line;
	return	line, (ramp == 1);
}
/*
eviMultiLine2(target1, target2, duration)
{
	History v1(0), v2(0);

}

eviMultiLine3(target1, target2, target3, duration)
{

}
*/
eviSline(target, duration)				// target, duration in samples
{
	History	value(0);
	trigger	= change(target);
	ramp	= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);
	cramp	= eviScurve(ramp);
	curve	= eviMap(cramp, 0, 1, latch(value, trigger), latch(target, trigger));
	value	= curve;
	return	curve, (ramp == 1);
}


// log smoothing...

logsad(s)
{
	return	LN2 / maximum((s * samplerate), 1);
}

logsmooth(x, s)						// s = time to drop 6dB (in seconds)
{
	History z(0);
	ad = logsad(s);
	y  = ((x - z) * ad) + z;
	z  = y;
	return y;
}

logso(x, ad)
{
	History z(0);
	y = ((x - z) * ad) + z;
	z = y;
	return y;
}

logsmoothBank2(x1, x2, s)
{
	History	logsdummy2(0);
	ad		= logsad(s);
	y1		= logso(x1, ad);
	y2		= logso(x2, ad);
	return	y1, y2;
}

logsmoothBank3(x1, x2, x3, s)
{
	History	logsdummy3(0);
	ad		= logsad(s);
	y1		= logso(x1, ad);
	y2		= logso(x2, ad);
	y3		= logso(x3, ad);
	return	y1, y2, y3;
}

logsmoothBank4(x1, x2, x3, x4, s)
{
	History	logsdummy4(0);
	ad		= logsad(s);
	y1		= logso(x1, ad);
	y2		= logso(x2, ad);
	y3		= logso(x3, ad);
	y4		= logso(x4, ad);
	return	y1, y2, y3, y4;
}

logsmoothBank6(x1, x2, x3, x4, x5, x6, s)
{
	History	logsdummy6(0);
	ad		= logsad(s);
	y1		= logso(x1, ad);
	y2		= logso(x2, ad);
	y3		= logso(x3, ad);
	y4		= logso(x4, ad);
	y5		= logso(x5, ad);
	y6		= logso(x6, ad);
	return	y1, y2, y3, y4, y5, y6;
}

// for 'lagsmooth()'
lagpole(x, c, l)							// value / coefficient / previous
{
//	return ((1 - abs(c)) * x) + (c * l);
	return ((1 - c) * x) + (c * l);			// no need for abs here ?
}

// a bit like Supercollider [lag3]			// original by James MacCartney, mod by me
lagsmooth(v, lp0)							// destination value / time (in seconds)
{
	History coef(  0.9928302477768374);		// default: @20ms @48kHz
	History lp1(0), lp2(0), lp3(0);
	LOGTH		= -6.907755278982137;		// ln(0.0001), fixed threshold of 0.0001 (-80 dB)
	if (change(lp0))
		coef	= maximum(expA(LOGTH / (lp0 * samplerate)), 0);
	lp1		= lagpole(v,	coef,	lp1);
	lp2		= lagpole(lp1,	coef,	lp2);
	lp3		= lagpole(lp2,	coef,	lp3);
	return	lp3;
}


// exp smoothing...

expsmooth(x, t)						// t is smooth time in seconds
{
	History w(0);
	z = tauA(t);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expso(x, z)
{
	History w(0);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expsmoothBank2(x1, x2, t)
{
	History	expsdummy2(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	return	y1, y2;
}

expsmoothBank4(x1, x2, x3, x4, t)
{
	History	expsdummy4(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	y4		= expso(x4, z);
	return	y1, y2, y3, y4;
}


// utilities...

// Sadeharju 'spread' & times for late diffusion
// 'spreadLate()' used only at param rate
spreadLate(diffscale, mul1, mul2, spread)		// diffscale is int(), others doubles
{												// 'spread' here is 0..1
	c		= int(spread	*  mul1	+ 369	);
	d		= int(spread	*  mul2	+ 931	);	// '* 3' baked into 'mul2' here
	t1		= diffscale		* (c	- 210	);
	t2		= diffscale		* (d	- c		);
	t3		= diffscale		* (1341 - d		);
	return	t1, t2, t3;							// Sadeharju has truncated ints
}

// quirky noise lfo...
// ...(really stupid literal port of Randy Jones' MSP lores~ hack)...
// ...should do fastcubic rand instead ??
noiseMod(depth)
{
	History	h2(0), h1(0);
	c0		=  3.902431071622914e-7;
	c1		= -1.998750611177923;
	c2		=  0.9987510014210301;
	H		=	noise();
	h0		= ( H  *  c0 ) - ( (h1 * c1) + (h2 * c2) );
	h2		=	fixdenorm(h1);
	h1		=	fixdenorm(h0);
	return	h0  *  depth;
}

calcDelays(delay, time)										// delay in units, time in samples
{
	History direction(-1), ramp(0), del1(0), del2(0);	

	test1	= ((ramp == 0) && (del1 != delay));
	test2	= ((ramp == 1) && (del2 != delay));
	
	del2	= test1 ? delay : del2;
	del1	= test2 ? delay : del1;
	
	sampletime	= 1 / time;
	direction	= (test1 || test2) ? -direction : direction;
	ramp		= clip(ramp + (direction * sampletime), 0, 1);
	
	return	ramp,	del1,	del2;
}

// we cannot instantiate delay sizes dynamically as we can in genexpr global code :-(

// pre delay variable 											// very expensive but very lovely
preDelayVar(x0, pdTime, pdRamp)
{
	History	pdvdummy(0);
	Delay	preDel(27456,	2,	feedback=0);					// support up to 143ms ...

	preflag		= pdTime > 0;									// manage cpu (1 is 1, 0 is delayed by ramptime)
	precompute, pcn	= eviLine(preflag, pdRamp);

	preDel.write( x0 );											// always write to delay lines
	x1 			= x0;
	if (precompute > 0) {	// manage cpu (only compute if is delayed)
		mixa 	= x0;
		mixb	= x0;
		delayramp, delA, delB	= calcDelays(pdTime, pdRamp);	// delayramp = exact (only compute required)
		pDelA	= delA - 1;
		pDelB	= delB - 1;

		if				((delayramp > 0) && (delayramp < 1)) {	// ...is ramping
			if (pDelA > 0) {
				mixa	= preDel.read(pDelA, 0, interp="fastcubic");
			}
			if (pDelB > 0) {
				mixb	= preDel.read(pDelB, 1, interp="fastcubic");
			}
			x1			= xfadeQuartApproxMono(mixa, mixb, delayramp);
		} else if		(delayramp == 1) {
			if (pDelB > 0) {
				mixb	= preDel.read(pDelB, 1, interp="fastcubic");
			}
			x1			= mixb;
		} else {	//	(delayramp == 0)
			if (pDelA > 0) {
				mixa	= preDel.read(pDelA, 0, interp="fastcubic");
			}
			x1			= mixa;
		}

		x1	= interp(precompute, x0, x1, mode="cosine");
	}						// (precompute == 0) manage cpu (only compute if is delayed)

	return	x1;
}
