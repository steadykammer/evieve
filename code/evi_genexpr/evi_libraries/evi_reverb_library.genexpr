// the following zero hold delays are very expensive
// & we cannot dynamically allocate delay memory here as in global code

delayReadZero1(x0, dTime, dRamp)
{
	History	pdv1sdummy(0);
	Delay	zeroDel2(24577,	2,	feedback=0);

//	preflag		= dTime > 0;							// manage cpu (1 is 1, 0 is delayed by ramptime)
//	precompute, pcn	= eviLine(preflag, dRamp);

	zeroDel2.write(x0);									// always write to delay line
	x1 			= x0;
//	if (precompute > 0) {	// manage cpu (only compute if is delayed)
		mixa 	= x0;
		mixb	= x0;
		// delayramp = exact (only compute required)
		delayramp, delA, delB	= calcDelays(dTime, dRamp);
		pDelA	= delA - 1;
		pDelB	= delB - 1;

		if				((delayramp > 0) && (delayramp < 1)) {	// ...is ramping
			if (pDelA > 0) {
				mixa	= zeroDel2.read(pDelA, interp="fastcubic");
			}
			if (pDelB > 0) {
				mixb	= zeroDel2.read(pDelB, interp="fastcubic");
			}
			x1			= xfadeQuartApproxMono(mixa, mixb, delayramp);
		} else if		(delayramp == 1) {
			if (pDelB > 0) {
				mixb	= zeroDel2.read(pDelB, interp="fastcubic");
			}
			x1			= mixb;
		} else {	//	(delayramp == 0)
			if (pDelA > 0) {
				mixa	= zeroDel2.read(pDelA, interp="fastcubic");
			}
			x1			= mixa;
		}

//		x1	= interp(precompute, x0, x1, mode="cosine");
//	}						// (precompute == 0) manage cpu (only compute if is delayed)

	return	x1;
}

delayReadZero1mod(x0, dTime, dRamp, mDepth)
{
	History	pdv1mdummy(0);
	Delay	zeroDelm(52294,	2,	feedback=0);

	zeroDelm.write(x0);
	x1 		 = x0;
	mod		 = noiseMod(mDepth);	// mDepth in seconds	// (-0.037524 / -0.031373)
	mixa 	 = x0;
	mixb	 = x0;
	delayramp, delA, delB	= calcDelays(dTime, dRamp);		// delayramp = exact (only compute required)
	pDelA	 = delA - 1;
	pDelB	 = delB - 1;
	pDelN	 =  mod * samplerate;							// pDelN adder in samples

	if				((delayramp > 0) && (delayramp < 1)) {	// ...is ramping
		if (pDelA > 0) {
			mixa	= zeroDelm.read((pDelA + pDelN), interp="cubic");// should [fold] all (... + pDelN) ?
		}
		if (pDelB > 0) {
			mixb	= zeroDelm.read((pDelB + pDelN), interp="cubic");
		}
		x1			= xfadeQuartApproxMono(mixa, mixb, delayramp);
	} else if		(delayramp == 1) {
		if (pDelB > 0) {
			mixb	= zeroDelm.read((pDelB + pDelN), interp="cubic");
		}
		x1			= mixb;
	} else {	//	(delayramp == 0)
		if (pDelA > 0) {
			mixa	= zeroDelm.read((pDelA + pDelN), interp="cubic");
		}
		x1			= mixa;
	}

	return	x1;
}

delayReadZero2(x0, dTime1, dTime2, dRamp)// this is stupid
{
	History	pdv2dummy(0);
	Delay	zeroDel4(49153,	4,	feedback=0);

//	dTime0		= dTime1 + dTime2;
//	preflag		= dTime0 > 0;							// manage cpu (1 is 1, 0 is delayed by ramptime)
//	precompute, pcn	= eviLine(preflag, dRamp);

	zeroDel4.write(x0);									// always write to delay line
	x1 			= x0;
	x2			= x0;
//	if (precompute > 0) {	// manage cpu (only compute if is delayed)
		mixa 	= x0;
		mixb	= x0;
		mixc 	= x0;
		mixd	= x0;
		// delayramp* = exact (only compute required)
		delayramp1, delA, delB	= calcDelays(dTime1, dRamp);
		delayramp2, delC, delD	= calcDelays(dTime2, dRamp);
		pDelA	= delA - 1;
		pDelB	= delB - 1;
		pDelC	= delC - 1;
		pDelD	= delD - 1;

		if				((delayramp1 > 0) && (delayramp1 < 1)) {	// ...is ramping
			if (pDelA > 0) {
				mixa	= zeroDel4.read(pDelA, interp="fastcubic");
			}
			if (pDelB > 0) {
				mixb	= zeroDel4.read(pDelB, interp="fastcubic");
			}
			x1			= xfadeQuartApproxMono(mixa, mixb, delayramp1);
		} else if		(delayramp1 == 1) {
			if (pDelB > 0) {
				mixb	= zeroDel4.read(pDelB, interp="fastcubic");
			}
			x1			= mixb;
		} else {	//	(delayramp1 == 0)
			if (pDelA > 0) {
				mixa	= zeroDel4.read(pDelA, interp="fastcubic");
			}
			x1			= mixa;
		}

		if				((delayramp2 > 0) && (delayramp2 < 1)) {	// ...is ramping
			if (pDelC > 0) {
				mixc	= zeroDel4.read(pDelC, interp="fastcubic");
			}
			if (pDelD > 0) {
				mixd	= zeroDel4.read(pDelD, interp="fastcubic");
			}
			x2			= xfadeQuartApproxMono(mixc, mixd, delayramp2);
		} else if		(delayramp2 == 1) {
			if (pDelD > 0) {
				mixd	= zeroDel4.read(pDelD, interp="fastcubic");
			}
			x2			= mixd;
		} else {	//	(delayramp2 == 0)
			if (pDelC > 0) {
				mixc	= zeroDel4.read(pDelC, interp="fastcubic");
			}
			x2			= mixc;
		}

//		x1	= interp(precompute, x0, x1, mode="cosine");
//		x2	= interp(precompute, x0, x2, mode="cosine");
//	}						// (precompute == 0) manage cpu (only compute if is delayed)

	return	x1, x2;
}


// filters...

rcDampCoeffsMode(cutoff, damp, mode)		// *)
{
	d1		= 0;
	// prewarp
	g0		=  tnA(pi * cutoff / samplerate);
	// account for pass/shelf
	ka	=  abs(damp);					// 0..1 = sqrt..lin
	ks	= (ka * 0.5) + 0.5;
	g01	=  1 + g0;
	g1 	=  g0 / interp((2 * (ks - 0.5)), sqrt(g01), g01, mode="linear");
	// shelf/pass (damp) control
	if (mode > 0) {			// nice way of getting approx ± 10dB
		d1		= -(pow(4, damp) - 1);
		if (mode == 2) {	// extend attenuation range to make pass choice
			d1	=  (d1 > 0) ? (d1 * 1.333333) : d1;
		}
	} else {// (mode == 0)	// for attenuation ('damping') only (0..1 input)
		d1	= interp((2 * (((1 - ks) + 0.5) - 0.5)), sqrt(ka), ka, mode="linear");
	}

	return g1, d1;			// rc filter warped cf (g)	// rc filter warped gain (k)

	// *) N.B., 'damp' -1..1 maps to d1 (k) as...
	//		- if mode==0:	 0=bypass..shelfattenuate..+1=pass (abs or clip damp)
	//		- if mode==1:	+0.75=shelfattenuate..0=bypass..-3=shelfboost
	//		- if mode==2:	+1=pass..shelfattenuate..0=bypass..-3=shelfboost
}

rcDampCoeffs(cutoff, damp)				// fixed mode=0 version, no branching, can keep out of while loop
{
	// prewarp
	g0		=  tnA(pi * cutoff / samplerate);
	// account for pass/shelf
	ka	=  abs(damp);					// 0..1 = sqrt..lin
	ks	= (ka * 0.5) + 0.5;
	g01	=  1 + g0;
	g1 	=  g0 / interp((2 * (ks - 0.5)), sqrt(g01), g01, mode="linear");
	// shelf/pass (damp) control
//	d1	= -(pow(4, damp) - 1);			// !! this is just horrible, must fix !!
	// extend attenuation range to make pass choice
//	d1	=  (d1 > 0) ? (d1 * 1.333333) : d1;
	d1	= interp((2 * (((1 - ks) + 0.5) - 0.5)), sqrt(ka), ka, mode="linear");

	return g1, d1;						// rc filter warped cf (g)	// rc filter warped gain (k)
}

poleZeroDamp(x, a)						// a = prewarped normalised frequency 0..1
{
	History		y1(0);
	y0		=  (x * a) + (y1 * (1 - a));
	y1		=	y0;
	return		y0;
}

// linear OnePole RC filter (trapezoidal)
rcFilter(Vin, g)						// g = prewarped normalised frequency (g / (1 + g))
{
	History	  s(0);
	Vout	= (g * Vin + s) / (g + 1);
	s		= 2 * Vout - s;
	return	  Vout;
}

rcFilterHpLp(Vin, g)					// g = prewarped normalised frequency (g / (1 + g))
{
	History	  s(0);
	VoutLp	= (g * Vin + s) / (g + 1);
	s		= 2 * VoutLp - s;
	Hp		= Vin - VoutLp;
	return	  Hp, VoutLp;
}

// High or Low Pass if k == 1, Bypass if k == 0, else Low or High Shelf boost / attenuation
rcFilterDamp(Vin, g, k)					// g = pre-warped normalised frequency (g / (1 + g))
{
	History	   s(0);
	Lp		= ( g * Vin + s) / (g + 1);
	s		= (Lp + Lp) - s;
	Hp		=  Lp - Vin;				// !! must be y-x way round for shelfs !!

	LpHs	=  Vin + (k * Hp);
	HpLs	= (k * Lp) - Vin;

	return	   HpLs, LpHs;
}

// ditto
rcFilterEq(Vin, g, k)					// g = pre-warped normalised frequency (g / (1 + g))
{
	History	   s(0);
	Lp		= ( g * Vin + s) / (g + 1);
	s		= (Lp + Lp) - s;
	Hp		=  Lp - Vin;				// !! must be y-x way round for shelfs !!

	LpHs	=  Vin + (k * Hp);
	HpLs	= (k * Lp) - Vin;

	return	   HpLs, LpHs;
}

fbComb(cIn, cDamp1, cDamp2, cFeedback, cTime)
{
	History	hDamp(0);
	// comb8samps (0.036666666666666670 seconds) + cSprSamps (0.0010430839002267573 seconds) = 0.037709750566894
	Delay	xComb(7241, 1, feedback=1);

	cRead	= xComb.read(cTime, interp="none");			// 'cTime' fixed integer samples, no interp needed
	cLoop	= (cRead * cDamp2) + (hDamp * cDamp1);
	hDamp	= cLoop;									// !! redo lowpass filter !!
	xComb.write(cIn + (cLoop * cFeedback));

	return	cRead;
}

// this is crap; see the discussion (and links) here: http://freeverb3vst.osdn.jp/tips/allpass.shtml
fbAllpass(aIn, aFeedback, aTime)
{
	History	apdummy(0);
	// ap1samps (0.012607709750566893 seconds) + aSprSamps (0.0004988662131519275 seconds) = 0.01310657596372
	Delay	xAllpass(2517, 1, feedback=1);

	aRead	= xAllpass.read(aTime, interp="none");		// 'aTime' fixed integer samples, no interp needed
	xAllpass.write(aIn + (aRead * aFeedback));

	return	aIn - aRead;
}

fbAllpass3(aIn, aFeedback, aTime)
{
	History	ap3dummy(0);
	Delay	xAllpass3(2517, 1, feedback=1);				// samplerate*0.01310657596372

	aRead0	= xAllpass3.read(aTime, interp="none");
	aRead0	= fixdenorm(aRead0);
	xAllpass3.write(aIn + (aRead0 * aFeedback));

	aRead1	= xAllpass3.read(aTime, interp="none");
	allpass	= aRead0 - (aRead1 * aFeedback);
	return	allpass;
}

// we cannot dynamically allocate delay memory here as in global code, because of current gen~ bugs

fffbAllpassShort(aIn, aGain, aTime)		// MSPish
{
	History	apsdummy(0);
	Delay	ffAllpass(2445, 1, feedback=0);
	Delay	fbAllpass(2445, 1, feedback=1);

	ffAllpass.write(aIn);
	// '...Short' also static, no time/gain changes (interp="none")
	ffRead	= ffAllpass.read(aTime, interp="none");
	fbRead	= fbAllpass.read(aTime, interp="none");
	apSum	= ffRead + ((aIn - fbRead) * aGain);
	fbAllpass.write(apSum);

	return	apSum;
}

fffbAllpassMedium(aIn, aGain, aTime)	// MSPish
{
	History	apmdummy(0);
	Delay	ffAllpass(27415, 1, feedback=0);
	Delay	fbAllpass(27415, 1, feedback=1);

	ffAllpass.write(aIn);
	ffRead	= ffAllpass.read(aTime, interp="spline");
	fbRead	= fbAllpass.read(aTime, interp="spline");
	apSum	= ffRead + ((aIn - fbRead) * aGain);
	fbAllpass.write(apSum);

	return	apSum;
}

fffbAllpassLong(aIn, aGain, aTime)		// MSPish
{
	History	apldummy(0);
	Delay	ffAllpass(52294, 1, feedback=0);
	Delay	fbAllpass(52294, 1, feedback=1);

	ffAllpass.write(aIn);
	ffRead	= ffAllpass.read(aTime, interp="spline");
	fbRead	= fbAllpass.read(aTime, interp="spline");
	apSum	= ffRead + ((aIn - fbRead) * aGain);
	fbAllpass.write(apSum);

	return	apSum;
}

// allpass diffusion
DiffAllpass(xIn, xCoeff, xTime)			// xCoeff = 0.75 or 0.625 for gigaverb original
{
	History		xdiffdummy(0);
	Delay		xDiffuse( 52254, 1, feedback=1 );	// support @ up to 300 meters ('size' param)
	xRead		=  xDiffuse.read(  xTime, interp="cubic" );
	xFb			=  xIn - (xRead  * xCoeff );
	xFb			=  fixdenorm(xFb);
	xOut		=  xRead + ( xFb * xCoeff );
	xDiffuse.write(xFb);
	return		xOut;
}

AllpassDiffuseShort(x, time, diffusion, apgain)
{
	History	apdiffshort(0);
	Delay	AllpassDiffuse(64000, 1, feedback=1);

	fb		= AllpassDiffuse.read(maximum(time, 1), interp="spline");
	y		= (x * (diffusion * -1)) + fb;
	AllpassDiffuse.write((x + (fixdenorm(y) * diffusion)) * apgain);

	return	y;
}

AllpassDiffuseLong(x, time, diffusion, apgain)
{
	History	apdifflong(0);
	Delay	AllpassDiffuse(96000, 1, feedback=1);

	fb		= AllpassDiffuse.read(maximum(time, 1), interp="spline");
	y		= (x * (diffusion * -1)) + fb;
	AllpassDiffuse.write((x + (fixdenorm(y) * diffusion)) * apgain);

	return	y;
}
