
//	//	//	evi_reverb_library.genexpr for all the evieve reverbs
//	//	//	by Pete for evieve


require("evi_svfs.genexpr");	// incl. "_smooth", incl. "_utilities" & "_approx"
require("evi_rcfilters.genexpr");	// incl. "_interp"


// Sadeharju 'spread' & times for late diffusion
// 'spreadLate()' used only at param rate
spreadLate(diffscale, mul1, mul2, spread)		// diffscale is int(), others doubles
{												// 'spread' here is 0..1
	c		= int(spread	*  mul1	+ 369);
	d		= int(spread	*  mul2	+ 931);		// '* 3' baked into 'mul2' here
	t1		= diffscale		* (c	- 210);
	t2		= diffscale		* (d	- c);
	t3		= diffscale		* (1341 - d);
	return	t1, t2, t3;							// Sadeharju has truncated ints
}

gainCoeff(normalised)
{
	return (2 - normalised) * normalised;
}

filterParams(high, low, base)		// 0..1 % = no damp .. maximum damp
{
	hiPass	= mtofApprox((high * 24) + 40, base=base);
	loPass	= mtofApprox(((1 - low) * 34) + 86, base=base);
	hiAtten	= gainCoeff(high);// * -18;					// not dB anymore...
	loAtten	= gainCoeff(low);// * -12;					// ...
	return	hiPass, hiAtten, loPass, loAtten;			// Hz, % 0..1, Hz, % 0..1
}

sizeParams(size)					// a(n almost) faithful matt's macroisation homage
{
	sizeMod = (0.31 - (size * -0.69)) * size;
	sizeModClip = minimum(sizeMod, 0.2);
	sizeClipNorm = sizeModClip + sizeModClip + sizeModClip + sizeModClip + sizeModClip;
	sizeL = (30 - (sizeMod * 16)) + ((1 - (sizeClipNorm * sizeClipNorm)) * 12);
	sizeR = sizeL - ((gainCoeff(size) * 2) + 1);
//	diff = (scale(sizeModClip, 0, 0.2, 0.6, 1, 0.363) * ((maximum(sizeMod, 0.0001) / 24) + 0.5)) * -1;	// matt
//	diff = -((sqrt((sizeModClip + sizeModClip) + 0.6) * (maximum(sizeMod, 0.0001) * 0.041667 + 0.5)));	// compromise
	// bigger range, cheaper compute:
	diff = -((((sizeModClip + sizeModClip) + 0.6) * sqrt((sizeMod * 0.363) + sqrt1_2) * (maximum(sizeMod, 0.0001) * 0.041667 + 0.5)));
	rt60dB = sizeMod * -96;
	modA = (1.5 - size) * size;
	modAmount = (modA + modA + 0.5) * 24;
	modSpread = (size * size * 0.76) + 0.22;
	return sizeL, sizeR, diff, rt60dB, modAmount, modSpread;
}

// sadly this is a repeat from "evi_fastskew.genexpr" to avoid another require in "evi_majorverb"

// negative only
fastskewlfo052neg(x, skewneg)				// !! skewneg must be clamped 0.5..1 !!
{
	sk5	= skewneg - 0.5;
	return mix(sqrt(x), x, sk5 + sk5);	// Alex and I hate mix(), but sadly it is a tiny bit cheaper
}

// positive only, generally positive is far less accurate in terms of pow(), especially for greater ranges
fastskewlfo052pos(x, skewpos)				// !! skewpos must be clamped 1..2 !!
{
 	return mix(x, x*x, skewpos - 1);
}

// pow(x, 0.5..2), audio rate version (branch, only compute neccessary)
// a branch to select between a sqrt & a multiply does not make much difference for audio rate
fastskewlfo052ar(x, skew)					// !! skew must be clamped 0.5..2 !!
{
	y = 0;
	if (skew < 1) {
		y = fastskewlfo052neg(x, skew);
	} else {
		y = fastskewlfo052pos(x, skew);
	}
	return y;
}

// thanks Alex
lfoCalc(phase, duty, shape, skew)	// input phase must be wrapped 0..1 for tri phase
{
    tri = (phase < duty) ? (phase / duty) : (1 - phase) / (1 - duty);

	sphase = wrap(phase - 0.25, 0, 1);
   	sine = (sphase > 0.5) ? sphase - 1 : sphase;
    sine = sine * (4 - (abs(sine) * 8)) + 0.5;
            
    return fastskewlfo052ar(interp(shape, tri, sine), skew);
}

oneMod1(modFreq, modDepth, modOffset, _modDuty, _modShape, _modSkew)
{
	History 	onemod1dummy(0);
	modPhase	= phasor(modFreq);
	return		parabolWrap(modPhase + modOffset) * modDepth;
}

oneMod2(modFreq, modDepth, modOffset, modDuty, modShape, modSkew)
{
	History 	onemod2dummy(0);
	modPhase	= wrap(phasor(modFreq) + modOffset, 0, 1);
	return		(lfoCalc(modPhase, modDuty, modShape, modSkew) * (modDepth + modDepth)) - modDepth;
}

delmod2(delay1, delay2, rate, depth, offset1, offset2)
{
	History delmod2dummy(0);
	mod1	= oneMod1(rate, depth, offset1, 0, 0, 0);
	mod2	= oneMod1(rate, depth, offset2, 0, 0, 0);
	time1	= delay1 + mod1;
	time2	= delay2 + mod2;
	return	time1, time2;
}

delmod4(delay1, delay2, delay3, delay4, rate1, rate2, depth, offset1, offset2, offset3, offset4)
{
	History delmod4dummy(0);
	time1, time2	= delmod2(delay1, delay2, rate1, depth, offset1, offset2);
	time3, time4	= delmod2(delay3, delay4, rate2, depth, offset3, offset4);
	return	time1, time2, time3, time4;
}

// quirky noise lfo...
// ...(really stupid literal port of Randy Jones' MSP lores~ hack)...
// ...should do fastcubic rand instead ??
noiseMod(depth)
{
	History	h2(0), h1(0);
	c0		=  3.902431071622914e-7;
	c1		= -1.998750611177923;
	c2		=  0.9987510014210301;
	H		=	noise();
	h0		= (H  *  c0) - ((h1 * c1) + (h2 * c2));
	h2		=	fixdenorm(h1);
	h1		=	fixdenorm(h0);
	return	h0  *  depth;
}

// 8 sine modulators (4 L, 4 R), 1 phase
// pete really doesn't like this, must rewrite
eightMod(modFreq, modDepth)
{
	modulation1, modulation3, modulation6, modulation8	= 0;
	modulation2, modulation4, modulation5, modulation7	= 0;

	if (modDepth > 0) {

		modPhase	= phasor(modFreq);

		modulation1	= parabolWrap(modPhase + 0.125)	* modDepth;
		modulation2	= parabolWrap(modPhase + 0.25)	* modDepth;
		modulation3	= parabolWrap(modPhase + 0.375)	* modDepth;
		modulation4	= parabolWrap(modPhase + 0.5)	* modDepth;
		modulation5	= -modulation1;	// stupid
		modulation6	= -modulation2;
		modulation7	= -modulation3;
		modulation8	= -modulation4;

	}

	return	modulation1, modulation2, modulation3, modulation4, modulation5, modulation6, modulation7, modulation8;
}

// 8 sine modulators (4 L, 4 R), 1 phase
// a bit funky
eightModMatt(modFreq, modDepth, modSpread)
{
	modulation1, modulation3, modulation6, modulation8	= 0;
	modulation2, modulation4, modulation5, modulation7	= 0;

	if (modDepth > 0) {

		modPhase	= phasor(modFreq) - 0.5;

		modulation4	= parabolWrap(modPhase + 0.125);
		modulation6	= parabolWrap(modPhase + 0.25);
		modulation8	= parabolWrap(modPhase + 0.375);
		modulation2	= parabolWrap(modPhase + 0.5);

		modulation3	= (-(modulation4) + 1) * modDepth;
		modulation5	= (-(modulation6) + 1) * modDepth;
		modulation7	= (-(modulation8) + 1) * modDepth;
		modulation1	= (-(modulation2) + 1) * modDepth;

		modulation2	= (modulation2 + 1) * modDepth;
		modulation4	= (modulation4 + 1) * modDepth;
		modulation6	= (modulation6 + 1) * modDepth;
//		mod8		= (modulation8 + 1);
//		freqMod		= (2 - mod8);
//		modulation8	= (mod8 * modDepth);
		modulation8	= (modulation8 + 1) * modDepth;

		modulation5 = mix(modulation1, modulation5, modSpread);
		modulation6 = mix(modulation2, modulation6, modSpread);
		modulation7 = mix(modulation3, modulation7, modSpread);
		modulation8 = mix(modulation4, modulation8, modSpread);

	}

	return	modulation1, modulation2, modulation3, modulation4, modulation5, modulation6, modulation7, modulation8;
}

// freezeverb and plateverb

calcDelays(delay, time)										// delay in units, time in samples
{
	History direction(-1), ramp(0), del1(0), del2(0);	

	test1	= ((ramp == 0) && (del1 != delay));
	test2	= ((ramp == 1) && (del2 != delay));
	
	del2	= test1 ? delay : del2;
	del1	= test2 ? delay : del1;
	
	sampletime	= 1 / time;
	direction	= (test1 || test2) ? -direction : direction;
	ramp		= clip(ramp + (direction * sampletime), 0, 1);
	
	return	ramp,	del1,	del2;
}

// we cannot instantiate delay sizes dynamically as we can in genexpr global code :-(

// freezeverb

// pre delay variable 											// very expensive but very lovely
preDelayVar(x0, pdTime, pdRamp)
{
	History	pdvdummy(0);
	Delay	preDel(27456,	2,	feedback=0);					// support up to 143ms ...

	preflag		= pdTime > 0;									// manage cpu (1 is 1, 0 is delayed by ramptime)
	precompute, pcn	= eviLine(preflag, pdRamp);

	preDel.write(x0);											// always write to delay lines
	x1 			= x0;
	if (precompute > 0) {	// manage cpu (only compute if is delayed)
		delayramp, delA, delB	= calcDelays(pdTime, pdRamp);	// delayramp = exact (only compute required)
		pDelA	= delA - 1;
		pDelB	= delB - 1;

		if				((delayramp > 0) && (delayramp < 1)) {	// ...is ramping
			mixa, mixb	= x0;
			if (pDelA > 0) {
				mixa	= preDel.read(pDelA, 0, interp="fastcubic");
			}
			if (pDelB > 0) {
				mixb	= preDel.read(pDelB, 1, interp="fastcubic");
			}
			x1			= xfadeQuartApproxMono(mixa, mixb, delayramp);
		} else if		(delayramp == 1) {
			mixb = x0;
			if (pDelB > 0) {
				mixb	= preDel.read(pDelB, 1, interp="fastcubic");
			}
			x1			= mixb;
		} else {	//	(delayramp == 0)
			mixa = x0;
			if (pDelA > 0) {
				mixa	= preDel.read(pDelA, 0, interp="fastcubic");
			}
			x1			= mixa;
		}

		x1	= interp(precompute, x0, x1, mode="cosine");
	}

	return	x1;
}

// less expensive than 'preDelayVar()' but not as lovely
preDelayWindow(x0, pdTime0, pdWindow)	// pdWindow == Hz
{
	History	pdvdummy(0);
	Delay	preDelay(27456, 2, feedback=0);

	preDelay.write(x0);

	gater1	= (cycle(pdWindow) + 1) * 0.5;
	gater2	= 1 - gater1;

	pdltch1	= change(delta(gater1) > 0) < 0;
	pdltch2	= change(delta(gater2) > 0) < 0;

	pdTime1	= latch(pdTime0, pdltch1);
	pdTime2	= latch(pdTime0, pdltch2);

	pdmix1	= preDelay.read(pdTime1, 0, interp="cubic");
	pdmix2	= preDelay.read(pdTime2, 1, interp="cubic");

	return	(pdmix1 * gater1) + (pdmix2 * gater2);
}

// the following zero hold delays are very expensive
// & we cannot dynamically allocate delay memory here as in global code

// for plateverb

delayReadZero1(x0, dTime, dRamp)
{
	History	pdv1sdummy(0);
	Delay	zeroDel2(24577,	2,	feedback=0);

	zeroDel2.write(x0);									// always write to delay line
	x1 		= x0;
	// delayramp = exact (only compute required)
	delayramp, delA, delB	= calcDelays(dTime, dRamp);
	pDelA	= delA - 1;
	pDelB	= delB - 1;

	if				((delayramp > 0) && (delayramp < 1)) {	// ...is ramping
		mixa, mixb	= x0;
		if (pDelA > 0) {
			mixa	= zeroDel2.read(pDelA, interp="fastcubic");
		}
		if (pDelB > 0) {
			mixb	= zeroDel2.read(pDelB, interp="fastcubic");
		}
		x1			= xfadeQuartApproxMono(mixa, mixb, delayramp);
	} else if		(delayramp == 1) {
		mixb = x0;
		if (pDelB > 0) {
			mixb	= zeroDel2.read(pDelB, interp="fastcubic");
		}
		x1			= mixb;
	} else {	//	(delayramp == 0)
		mixa = x0;
		if (pDelA > 0) {
			mixa	= zeroDel2.read(pDelA, interp="fastcubic");
		}
		x1			= mixa;
	}

	return	x1;
}

delayReadZero1mod(x0, dTime, dRamp, mDepth)
{
	History	pdv1mdummy(0);
	Delay	zeroDelm(52294,	2,	feedback=0);

	zeroDelm.write(x0);
	x1 		 = x0;
	mod		 = noiseMod(mDepth);	// mDepth in seconds	// (-0.037524 / -0.031373)
	delayramp, delA, delB	= calcDelays(dTime, dRamp);		// delayramp = exact (only compute required)
	pDelA	 = delA - 1;
	pDelB	 = delB - 1;
	pDelN	 =  mod * samplerate;							// pDelN adder in samples

	if				((delayramp > 0) && (delayramp < 1)) {	// ...is ramping
		mixa, mixb	= x0;
		if (pDelA > 0) {
			mixa	= zeroDelm.read((pDelA + pDelN), interp="cubic");// should [fold] all (... + pDelN) ?
		}
		if (pDelB > 0) {
			mixb	= zeroDelm.read((pDelB + pDelN), interp="cubic");
		}
		x1			= xfadeQuartApproxMono(mixa, mixb, delayramp);
	} else if		(delayramp == 1) {
		mixb = x0;
		if (pDelB > 0) {
			mixb	= zeroDelm.read((pDelB + pDelN), interp="cubic");
		}
		x1			= mixb;
	} else {	//	(delayramp == 0)
		mixa = x0;
		if (pDelA > 0) {
			mixa	= zeroDelm.read((pDelA + pDelN), interp="cubic");
		}
		x1			= mixa;
	}

	return	x1;
}

delayReadZero2(x0, dTime1, dTime2, dRamp)// this is stupid
{
	History	pdv2dummy(0);
	Delay	zeroDel4(49153,	4,	feedback=0);

	zeroDel4.write(x0);									// always write to delay line
	x1 		= x0;
	x2		= x0;
	// delayramp* = exact (only compute required)
	delayramp1, delA, delB	= calcDelays(dTime1, dRamp);
	delayramp2, delC, delD	= calcDelays(dTime2, dRamp);
	pDelA	= delA - 1;
	pDelB	= delB - 1;
	pDelC	= delC - 1;
	pDelD	= delD - 1;

	if				((delayramp1 > 0) && (delayramp1 < 1)) {	// ...is ramping
		mixa, mixb	= x0;
		if (pDelA > 0) {
			mixa	= zeroDel4.read(pDelA, interp="fastcubic");
		}
		if (pDelB > 0) {
			mixb	= zeroDel4.read(pDelB, interp="fastcubic");
		}
		x1			= xfadeQuartApproxMono(mixa, mixb, delayramp1);
	} else if		(delayramp1 == 1) {
		mixb = x0;
		if (pDelB > 0) {
			mixb	= zeroDel4.read(pDelB, interp="fastcubic");
		}
		x1			= mixb;
	} else {	//	(delayramp1 == 0)
		mixa = x0;
		if (pDelA > 0) {
			mixa	= zeroDel4.read(pDelA, interp="fastcubic");
		}
		x1			= mixa;
	}

	if				((delayramp2 > 0) && (delayramp2 < 1)) {	// ...is ramping
		mixc, mixd	= x0;
		if (pDelC > 0) {
			mixc	= zeroDel4.read(pDelC, interp="fastcubic");
		}
		if (pDelD > 0) {
			mixd	= zeroDel4.read(pDelD, interp="fastcubic");
		}
		x2			= xfadeQuartApproxMono(mixc, mixd, delayramp2);
	} else if		(delayramp2 == 1) {
		mixd = x0;
		if (pDelD > 0) {
			mixd	= zeroDel4.read(pDelD, interp="fastcubic");
		}
		x2			= mixd;
	} else {	//	(delayramp2 == 0)
		mixc = x0;
		if (pDelC > 0) {
			mixc	= zeroDel4.read(pDelC, interp="fastcubic");
		}
		x2			= mixc;
	}

	return	x1, x2;
}


// additional filters

// plateverb, should replace with rcfilters?
poleZeroDamp(x, a)						// a = prewarped normalised frequency 0..1
{
	History		y1(0);
	y0		=  (x * a) + (y1 * (1 - a));
	y1		=	y0;
	return		y0;
}

// freezeverb

fbComb(cIn, cDamp1, cDamp2, cFeedback, cTime)
{
	History	hDamp(0);
	// comb8samps (0.036666666666666670 seconds) + cSprSamps (0.0010430839002267573 seconds) = 0.037709750566894
	Delay	xComb(7241, 1, feedback=1);

	cRead	= xComb.read(cTime, interp="none");			// 'cTime' fixed integer samples, no interp needed
	cLoop	= (cRead * cDamp2) + (hDamp * cDamp1);
	hDamp	= cLoop;									// !! redo lowpass filter !!
	xComb.write(cIn + (cLoop * cFeedback));

	return	cRead;
}

// this is crap; see the discussion (and links) here: http://freeverb3vst.osdn.jp/tips/allpass.shtml
fbAllpass(aIn, aFeedback, aTime)
{
	History	apdummy(0);
	// ap1samps (0.012607709750566893 seconds) + aSprSamps (0.0004988662131519275 seconds) = 0.01310657596372
	Delay	xAllpass(2517, 1, feedback=1);

	aRead	= xAllpass.read(aTime, interp="none");		// 'aTime' fixed integer samples, no interp needed
	xAllpass.write(aIn + (aRead * aFeedback));

	return	aIn - aRead;
}

// not currently used ?
fbAllpass3(aIn, aFeedback, aTime)
{
	History	ap3dummy(0);
	Delay	xAllpass3(2517, 1, feedback=1);				// samplerate*0.01310657596372

	aRead0	= xAllpass3.read(aTime, interp="none");
	aRead0	= fixdenorm(aRead0);
	xAllpass3.write(aIn + (aRead0 * aFeedback));

	aRead1	= xAllpass3.read(aTime, interp="none");
	allpass	= aRead0 - (aRead1 * aFeedback);
	return	allpass;
}

// plateverbs

fffbAllpassShort(aIn, aGain, aTime)		// MSPish
{
	History	apsdummy(0);
	Delay	ffAllpass(2445, 1, feedback=0);
	Delay	fbAllpass(2445, 1, feedback=1);

	ffAllpass.write(aIn);
	// '...Short' also static, no time/gain changes (interp="none")
	ffRead	= ffAllpass.read(aTime, interp="none");
	fbRead	= fbAllpass.read(aTime, interp="none");
	apSum	= ffRead + ((aIn - fbRead) * aGain);
	fbAllpass.write(apSum);

	return	apSum;
}

fffbAllpassMedium(aIn, aGain, aTime)	// MSPish
{
	History	apmdummy(0);
	Delay	ffAllpass(27415, 1, feedback=0);
	Delay	fbAllpass(27415, 1, feedback=1);

	ffAllpass.write(aIn);
	ffRead	= ffAllpass.read(aTime, interp="spline");
	fbRead	= fbAllpass.read(aTime, interp="spline");
	apSum	= ffRead + ((aIn - fbRead) * aGain);
	fbAllpass.write(apSum);

	return	apSum;
}

fffbAllpassLong(aIn, aGain, aTime)		// MSPish
{
	History	apldummy(0);
	Delay	ffAllpass(52294, 1, feedback=0);
	Delay	fbAllpass(52294, 1, feedback=1);

	ffAllpass.write(aIn);
	ffRead	= ffAllpass.read(aTime, interp="spline");
	fbRead	= fbAllpass.read(aTime, interp="spline");
	apSum	= ffRead + ((aIn - fbRead) * aGain);
	fbAllpass.write(apSum);

	return	apSum;
}

// gigaverb

// allpass diffusion
DiffAllpass(xIn, xCoeff, xTime)			// xCoeff = 0.75 or 0.625 for gigaverb original
{
	History		xdiffdummy(0);
	Delay		xDiffuse(52254, 1, feedback=1);	// support @ up to 300 meters ('size' param)
	xRead		=  xDiffuse.read(xTime, interp="cubic");
	xFb			=  xIn - (xRead  * xCoeff);
	xFb			=  fixdenorm(xFb);
	xOut		=  xRead + (xFb * xCoeff);
	xDiffuse.write(xFb);
	return		xOut;
}

// not currently used ?

AllpassDiffuseShort(x, time, diffusion, apgain)
{
	History	apdiffshort(0);
	Delay	AllpassDiffuse(64000, 1, feedback=1);

	fb		= AllpassDiffuse.read(maximum(time, 1), interp="spline");
	y		= (x * (diffusion * -1)) + fb;
	AllpassDiffuse.write((x + (fixdenorm(y) * diffusion)) * apgain);

	return	y;
}

AllpassDiffuseLong(x, time, diffusion, apgain)
{
	History	apdifflong(0);
	Delay	AllpassDiffuse(96000, 1, feedback=1);

	fb		= AllpassDiffuse.read(maximum(time, 1), interp="spline");
	y		= (x * (diffusion * -1)) + fb;
	AllpassDiffuse.write((x + (fixdenorm(y) * diffusion)) * apgain);

	return	y;
}

// mattaverb

allpassDiffuseShort(x, time, diffusion)
{
	History	apdiffshort(0);
	Delay	AllpassDiffuseS(int(samplerate*0.029090208+1.5), 1, feedback=1);

	fb		= AllpassDiffuseS.read(time, interp="cubic");
	y		= (x * -(diffusion)) + fb;
	AllpassDiffuseS.write(x + (fixdenorm(y) * diffusion));

	return	y;
}

allpassDiffuseLong(x, time, diffusion)
{
	History	apdifflong(0);
	Delay	AllpassDiffuseL(int(samplerate*0.045295298+1.5), 1, feedback=1);

	fb		= AllpassDiffuseL.read(time, interp="cubic");
	y		= (x * -(diffusion)) + fb;
	AllpassDiffuseL.write(x + (fixdenorm(y) * diffusion));

	return	y;
}

allpassDiffuseDamp(x, time, diffusion, g0, k0, g1, k1, damp)
{
	History	apdiffdamp(0);
	Delay	AllpassDiffuseD(int(samplerate*0.055983894+1.5), 1, feedback=1);

	fb		= AllpassDiffuseD.read(time, interp="spline");
	if ((damp) && ((k0 != 0) || (k1 != 0))) {
		fb	= rcFilterDamp(fb, g0, k0);
		fb	= rcFilterDamp(fb, g1, k1);
	}
	y		= (x * -(diffusion)) + fb;
	AllpassDiffuseD.write(x + (fixdenorm(y) * diffusion));

	return	y;
}

// algoverb

// core SHORT allpass filter 'diffuse' delay with (high/low-shelf) filters in feedback path
DiffuseDelayShort(x, time, diffusion, apgain, hs_a1, hs_a2, hs_a3, hs_m0, hs_m1, hs_m2, ls_a1, ls_a2, ls_a3, ls_m0, ls_m1, ls_m2)
{
	History	diffdelshort(0);
	// support 1.911128 .. 308.207444 ms
	Delay	DiffuseDelay(samplerate*0.309, 1, feedback=1);

	fb		= DiffuseDelay.read(maximum(time, 1), interp="cubic");
	eq		= eviSvfTwoSections(fb,	hs_a1, hs_a2, hs_a3, hs_m0, hs_m1, hs_m2, ls_a1, ls_a2, ls_a3, ls_m0, ls_m1, ls_m2);
	y		= (x * -(diffusion)) + eq;
	DiffuseDelay.write((x + (fixdenorm(y) * diffusion)) * apgain);

	return	y;
}

// core LONG allpass filter 'diffuse' delay with (high/low-shelf) filters in feedback path
DiffuseDelayLong(x, time, diffusion, apgain, hs_a1, hs_a2, hs_a3, hs_m0, hs_m1, hs_m2, ls_a1, ls_a2, ls_a3, ls_m0, ls_m1, ls_m2)
{
	History	diffdellong(0);
	// support 3.822256 .. 489.248821 ms (incl. ± modulation)
	Delay	DiffuseDelay(samplerate*0.490, 1, feedback=1);

	fb		= DiffuseDelay.read(maximum(time, 1), interp="spline");
	eq		= eviSvfTwoSections(fb,	hs_a1, hs_a2, hs_a3, hs_m0, hs_m1, hs_m2, ls_a1, ls_a2, ls_a3, ls_m0, ls_m1, ls_m2);
	y		= (x * -(diffusion)) + eq;
	DiffuseDelay.write((x + (fixdenorm(y) * diffusion)) * apgain);

	return	y;
}

// zitaverb

apDelaySingle(apIn, apTime, apGain)		// sort of allpass comb
{
	History	apHa(0);
	Delay	apDelay(6069, 1, feedback=1);
	apRead	= apDelay.read(apTime, interp="none");	// times all ints & fixed...
	apD		= apIn		+ (apRead	*	-apGain);
	apOut	= apRead	+ (apD		*	 apGain);
	apDelay.write(apD);
	return	apOut;
}

// would be nice to separate processing but...
delayFiltCoeff(del, tlo, tmf, wlo, chi, m3l10c)		// dfTime1, lt60samp, mt60samp, xoverN, dampN, m3l10const
{	// coefficients (clever Fons Adriaensen magic here)
	gmf	 =  exp(m3l10c * (del / tmf));
	glo	 = (exp(m3l10c * (del / tlo)) / gmf) - 1;
	g0	 =  exp(m3l10c * (del / (0.5 * tmf))) / gmf;
	g2	 =  g0 * g0;
	t0	 = (1 - g2) / ((g2 + g2) * chi);
	t2	 =  t0 + t0;
	whi	 = (sqrt(1 + t2 + t2) - 1) / t2;

	return	wlo+0, glo, whi, gmf;
}

delayFilt(x0, wlo, glo, whi, gmf)
{
	History	slo(0), shi(0);

	// loop
	slo	+= wlo * (x0 - slo);     // [ + 1e-10f ];
	x0	+= glo * slo;
	shi	+= whi * (x0 - shi);

	return	gmf * shi;
}

delayFilter(x0, del, tlo, tmf, wlo, chi, m3l10c)
{
	History	slo(0), shi(0);

	// coefficients (clever Fons Adriaensen magic here)
	gmf	 =  exp(m3l10c * (del / tmf));
	glo	 = (exp(m3l10c * (del / tlo)) / gmf) - 1;
	g0	 =  exp(m3l10c * (del / (0.5 * tmf))) / gmf;
	g2	 =  g0 * g0;
	t0	 = (1 - g2) / ((g2 + g2) * chi);
	t2	 =  t0 + t0;
	whi	 = (sqrt(1 + t2 + t2) - 1) / t2;

	// filter
	slo	+= wlo * (x0 - slo);     // [ + 1e-10f ];
	x0	+= glo * slo;
	shi	+= whi * (x0 - shi);

	return	gmf * shi;
}

