apDelaySingle(apIn, apTime, apGain)			// schroeder allpass comb
{
	History	apH(0);
	Delay	apDelay(samplerate*0.0317, 1, feedback=1);
	apRead	= apDelay.read(apTime, interp="none");	// times all ints & fixed...
	apD		= apIn	+ (apRead	*  (0 - apGain) );
	apOut	= apH	+ (apD		*		apGain)  ;
	apDelay.write(apD);
