// more like this ?? :
apDelaySingleAlt(apIn, apTime, apGain)		// sort of allpass comb
{
	History	apHa(0);
	Delay	apDelay(6069, 1, feedback=1);
	apRead	= apDelay.read(apTime, interp="none");	// times all ints & fixed...
	apD		= apIn		+ (apRead	*	-apGain);
	apOut	= apRead	+ (apD		*	 apGain);
	apDelay.write(apD);
	return	apOut;
}

// would be nice to separate processing but...
delayFiltCoeff(del, tlo, tmf, wlo, chi, m3l10c)		// dfTime1, lt60samp, mt60samp, xoverN, dampN, m3l10const
{	// coefficients (clever Fons Adriaensen magic here)
	gmf	 =  exp(m3l10c * (del / tmf));
	glo	 = (exp(m3l10c * (del / tlo)) / gmf) - 1;
	g0	 =  exp(m3l10c * (del / (0.5 * tmf))) / gmf;
	g2	 =  g0 * g0;
	t0	 = (1 - g2) / ((g2 + g2) * chi);
	t2	 =  t0 + t0;
	whi	 = (sqrt(1 + t2 + t2) - 1) / t2;

	return	wlo+0, glo, whi, gmf;
}

delayFilt(x0, wlo, glo, whi, gmf)
{
	History	slo(0), shi(0);

	// loop
	slo	+= wlo * (x0 - slo);     // [ + 1e-10f ];
	x0	+= glo * slo;
	shi	+= whi * (x0 - shi);

	return	gmf * shi;
}

delayFilter(x0, del, tlo, tmf, wlo, chi, m3l10c)
{
	History	slo(0), shi(0);

	// coefficients (clever Fons Adriaensen magic here)
	gmf	 =  exp(m3l10c * (del / tmf));
	glo	 = (exp(m3l10c * (del / tlo)) / gmf) - 1;
	g0	 =  exp(m3l10c * (del / (0.5 * tmf))) / gmf;
	g2	 =  g0 * g0;
	t0	 = (1 - g2) / ((g2 + g2) * chi);
	t2	 =  t0 + t0;
	whi	 = (sqrt(1 + t2 + t2) - 1) / t2;

	// filter
	slo	+= wlo * (x0 - slo);     // [ + 1e-10f ];
	x0	+= glo * slo;
	shi	+= whi * (x0 - shi);

	return	gmf * shi;
}

// zdf filter section for eq building
stateVariableFilterSection(v0, a1, a2, a3, m0, m1, m2)
{
	History	ic1eq(0), ic2eq(0);

	v3		=  v0 - ic2eq;
	v2		=  ic2eq + (a2 * ic1eq) + (a3 * v3);
	v1		= (a1 * ic1eq) + (a2 * v3);
	ic1eq	= (v1 + v1) - ic1eq;
	ic2eq	= (v2 + v2) - ic2eq;

	return	(m0 * v0) + (m1 * v1) + (m2 * v2);
}

stateVariableFilterSectionStereo(v0L, v0R, a1, a2, a3, m0, m1, m2)
{
	History	stereodummy(0);
	yL	= stateVariableFilterSection(v0L, a1, a2, a3, m0, m1, m2);
	yR	= stateVariableFilterSection(v0R, a1, a2, a3, m0, m1, m2);
	return	yL, yR;
}

// filter cascade
// 0 dB gain input zeros cpu of gain filters (shelfs, bell), (if coefficients are smoothed, must be by exact ramps, not logs)
svfTwoBandsStereo(band0L, band0R, a11, a21, a31, m01, m11, m21, a12, a22, a32, m02, m12, m22)
{
	History	twobandsdummy(0);
	band1L	= band0L+0;
	band1R	= band0R+0;
	if ( (m11 + m21) != 0 ) {
		band1L, band1R	= stateVariableFilterSectionStereo(band0L+0, band0R+0,	a11, a21, a31, m01, m11, m21);
	}
	band2L	= band1L+0;
	band2R	= band1R+0;
	if ( (m12 + m22) != 0 ) {
		band2L, band2R	= stateVariableFilterSectionStereo(band1L+0, band1R+0,	a12, a22, a32, m02, m12, m22);
	}
	return	band2L, band2R;
}


// mixing...

butterfly8(i1, i2, i3, i4, i5, i6, i7, i8)
{
	b1	= i1 + i5;
	b2	= i2 + i6;
	b3	= i3 + i7;
	b4	= i4 + i8;

	b5	= i1 - i5;
	b6	= i2 - i6;
	b7	= i3 - i7;
	b8	= i4 - i8;

	return	b1, b2, b3, b4, b5, b6, b7, b8;
}

butterfly4(i1, i2, i3, i4)
{
	b1	= i1 + i3;
	b2	= i2 + i4;

	b3	= i1 - i3;
	b4	= i2 - i4;

	return	b1, b2, b3, b4;
}

butterfly2(i1, i2)
{
	b1	= i1 + i2;
	b2	= i1 - i2;

	return	b1, b2;
}

hadamard8(i1, i2, i3, i4, i5, i6, i7, i8)
{
	b1, b2, b3, b4, b5, b6, b7, b8	= butterfly8(i1, i2, i3, i4, i5, i6, i7, i8);
	c1, c2, c3, c4					= butterfly4(b1, b2, b3, b4);
	c5, c6, c7, c8					= butterfly4(b5, b6, b7, b8);
	o1, o2							= butterfly2(c1, c2);
	o3, o4							= butterfly2(c3, c4);
	o5, o6							= butterfly2(c5, c6);
	o7, o8							= butterfly2(c7, c8);

	return	o1, o2, o3, o4, o5, o6, o7, o8;
}

// idiot proof, but idiot made
butterfly16(bf0_1, bf0_2, bf0_3, bf0_4, bf0_5, bf0_6, bf0_7, bf0_8, bf0_9, bf0_10, bf0_11, bf0_12, bf0_13, bf0_14, bf0_15, bf0_16)
{
	bf1_1,	bf1_2	= butterfly2(bf0_1,		bf0_2);
	bf1_3,	bf1_4	= butterfly2(bf0_3,		bf0_4);
	bf1_5,	bf1_6	= butterfly2(bf0_5,		bf0_6);
	bf1_7,	bf1_8	= butterfly2(bf0_7,		bf0_8);
	bf1_9,	bf1_10	= butterfly2(bf0_9,		bf0_10);
	bf1_11,	bf1_12	= butterfly2(bf0_11,	bf0_12);
	bf1_13,	bf1_14	= butterfly2(bf0_13,	bf0_14);
	bf1_15,	bf1_16	= butterfly2(bf0_15,	bf0_16);

	bf2_1,	bf2_3	= butterfly2(bf1_1,		bf1_3);
	bf2_2,	bf2_4	= butterfly2(bf1_2,		bf1_4);
	bf2_5,	bf2_7	= butterfly2(bf1_5,		bf1_7);
	bf2_6,	bf2_8	= butterfly2(bf1_6,		bf1_8);
	bf2_9,	bf2_11	= butterfly2(bf1_9,		bf1_11);
	bf2_10,	bf2_12	= butterfly2(bf1_10,	bf1_12);
	bf2_13,	bf2_15	= butterfly2(bf1_13,	bf1_15);
	bf2_14,	bf2_16	= butterfly2(bf1_14,	bf1_16);

	bf3_1,	bf3_5	= butterfly2(bf2_1,		bf2_5);
	bf3_2,	bf3_6	= butterfly2(bf2_2,		bf2_6);
	bf3_3,	bf3_7	= butterfly2(bf2_3,		bf2_7);
	bf3_4,	bf3_8	= butterfly2(bf2_4,		bf2_8);
	bf3_9,	bf3_13	= butterfly2(bf2_9,		bf2_13);
	bf3_10,	bf3_14	= butterfly2(bf2_10,	bf2_14);
	bf3_11,	bf3_15	= butterfly2(bf2_11,	bf2_15);
	bf3_12,	bf3_16	= butterfly2(bf2_12,	bf2_16);

	bf4_1,	bf4_9	= butterfly2(bf3_1,		bf3_9);
	bf4_2,	bf4_10	= butterfly2(bf3_2,		bf3_10);
	bf4_3,	bf4_11	= butterfly2(bf3_3,		bf3_11);
	bf4_4,	bf4_12	= butterfly2(bf3_4,		bf3_12);
	bf4_5,	bf4_13	= butterfly2(bf3_5,		bf3_13);
	bf4_6,	bf4_14	= butterfly2(bf3_6,		bf3_14);
	bf4_7,	bf4_15	= butterfly2(bf3_7,		bf3_15);
	bf4_8,	bf4_16	= butterfly2(bf3_8,		bf3_16);

	return	bf4_1, bf4_2, bf4_3, bf4_4, bf4_5, bf4_6, bf4_7, bf4_8, bf4_9, bf4_10, bf4_11, bf4_12, bf4_13, bf4_14, bf4_15, bf4_16;
}

butterflyMatrix(i1, i2, i3, i4)
{
	a1, a2			= butterfly2(i1, i2);
	a3, a4			= butterfly2(i3, i4);
	b1, b2, b3, b4	= butterfly4(a1, a2, a3, a4);

	return	b1, b2, b3, b4;
}

// for first quarter only, optimized so that never lets sqrt(sinapprox(x)^2+cosapprox(x)^2)
// exceed 1, always gives exact results at modphase 0, 0.5, 1 (0/1, sqrt1_2, 1/0)
quartOneParApprox(modphase)								// 'modphase' must be clipped 0..1
{
	x0		=  modphase - 0.5;							// 1 sub
	// first quarter									// angle = 0 .. halfpi
	quart	= -0.8284271247461903 * x0 * x0 + sqrt1_2;	// 2 mul, 1 add, (-0.8284271247461903 = 2 - 4*sqrt1_2)
	sinq1	=  quart + x0;								// 1 add
	cosq1	=  quart - x0;								// 1 sub

	return	cosq1, sinq1;
}

xfadeQuartApproxStereo(a, b, c, d, q)						// q is control, must be clipped 0..1
{
	qL, qR	= quartOneParApprox(q);							// cos/sin
	return	((a * qL) + (c * qR)), ((b * qL) + (d * qR));	// out mix L, out mix R
}

xfadeQuartApproxMono(a, b, q)								// q is control, must be clipped 0..1
{
	qL, qR	= quartOneParApprox(q);							// cos/sin
	return	(a * qL) + (b * qR);							// out mix mono
}

panQuartApproxMono(x, p)									// p is control, must be clipped 0..1
{
	pL, pR	= quartOneParApprox(p);							// cos/sin(/quart)
	return	(x * pL), (x * pR);								// out pan L, out pan R
}

panQuartApproxDual(xL, xR, pL, pR)							// p's are controls, must be clipped 0..1
{
	yLL, yLR	= panQuartApproxMono(xL, pL);				// pan L
	yRL, yRR	= panQuartApproxMono(xR, pR);				// pan R
	return		(yLL + yRL), (yLR + yRR);					// out sum L, out sum R
}


// homeless...

// does not work as function
earlyTapsAdd(xL, xR, etap1samps, etap2samps, etap3samps, etap4samps, earlygain)
{
	History etadummy(0);
	Delay	earlyTap1(276,	1, feedback=0);		// 0.00142763*samplerate
	Delay	earlyTap2(623,	1, feedback=0);		// 0.00323873*samplerate
	Delay	earlyTap3(1007,	1, feedback=0);		// 0.00523450*samplerate
	Delay	earlyTap4(1504,	1, feedback=0);		// 0.00782312*samplearte

	earlyTap1.write(xR);

	et1		= earlyTap1.read(etap1samps, interp="none");
	pt1		= xL + et1;
	mt1		= xL - et1;

	earlyTap2.write(mt1);
	et2		= earlyTap2.read(etap2samps, interp="none");
	pt2		= pt1 + et2;
	mt2		= pt1 - et2;

	earlyTap3.write(mt2);
	et3		= earlyTap3.read(etap3samps, interp="none");
	pt3		= pt2 + et3;
	mt3		= pt2 - et3;

	earlyTap4.write(mt3);
	earlyR	= earlyTap4.read(etap4samps, interp="none") * 0.5;
	earlyL	= pt3 * 0.5;

	earlyL	= earlyL * earlygain;
	earlyR	= earlyR * earlygain;

	return	earlyL, earlyR;
}

earlyReflections(xL, xR, bypass)		// not working as function
{
	History etrdummy(0);
	Delay	early1		(	int(floor(0.00142763 * samplerate + 0.5)),	feedback=0	);
	Delay	early2		(	int(floor(0.00323873 * samplerate + 0.5)),	feedback=0	);
	Delay	early3		(	int(floor(0.00523450 * samplerate + 0.5)),	feedback=0	);
	Delay	early4		(	int(floor(0.00782312 * samplerate + 0.5)),	feedback=0	);

	early1.write	(	xR			);
	e1r	= early1.read(earlyTime1, interp="none");
	ep1	= xL  + e1r;

	early2.write	(	xL  - e1r	);
	e2r	= early2.read(earlyTime2, interp="none");
	ep2	= ep1 + e2r;

	early3.write	(	ep1 - e2r	);
	e3r	= early3.read(earlyTime3, interp="none");
	ep3	= ep2 + e3r;

	early4.write	(	ep2 - e3r	);
	e4r	= early4.read(earlyTime4, interp="none");

	yL	= interp(	bypass,		ep3 * 0.354813,	xL	);
	yR	= interp(	bypass,		e4r * 0.354813, xR	);

	return	yL, yR;
}

// early taps
eTaps(tapIn, TapGain1, TapGain2, TapGain3, TapGain4, TapTime1, TapTime2, TapTime3, TapTime4)
{
	History	tapsdummy(0);

	// + 5 samples offset
	Delay	earlyTaps		(	69461,	4,	feedback=0	);	// four early taps

	// early taps
	earlyTaps.write(tapIn);
	eTap1	= earlyTaps.read(TapTime1, interp="fastcubic");
	eTap2	= earlyTaps.read(TapTime2, interp="fastcubic");
	eTap3	= earlyTaps.read(TapTime3, interp="fastcubic");
	eTap4	= earlyTaps.read(TapTime4, interp="none");	// TapTime4 is fixed integer
														// so fixed "none"
	// tap to fdn
	xTap1	= eTap1  *  TapGain1;
	xTap2	= eTap2  *  TapGain2;
	xTap3	= eTap3  *  TapGain3;
	xTap4	= eTap4  *  TapGain4;

	// why is this a feedback in Sadeharju / Böhm ?
	//earlyTaps.write(tapIn);

	return	xTap1, xTap2, xTap3, xTap4;
}

// mini feedback delay network
fdNetwork(xTap1, xTap2, xTap3, xTap4, TapGain1, TapGain2, TapGain3, TapGain4, Time1, Time2, Time3, Time4, dampXover, dampAtten)
{
	History	fdndummy(0);

	Delay	fdnDelay1	(	169413,	1,	feedback=1	);
	Delay	fdnDelay2	(	138325,	1,	feedback=1	);
	Delay	fdnDelay3	(	119794,	1,	feedback=1	);
	Delay	fdnDelay4	(	107146,	1,	feedback=1	);

	// fdn taps
	fdnLine1	= fdnDelay1.read(Time1,	interp="spline");
	fdnLine2	= fdnDelay2.read(Time2,	interp="spline");
	fdnLine3	= fdnDelay3.read(Time3,	interp="spline");
	fdnLine4	= fdnDelay4.read(Time4,	interp="spline");

	fTap1		= fdnLine1  *  TapGain1;
	fTap2		= fdnLine2  *  TapGain2;
	fTap3		= fdnLine3  *  TapGain3;
	fTap4		= fdnLine4  *  TapGain4;

	// fdn damp
	fHp1, fD1	= rcFilterDamp(fTap1,	dampXover,	dampAtten);
	fHp2, fD2	= rcFilterDamp(fTap2,	dampXover,	dampAtten);
	fHp3, fD3	= rcFilterDamp(fTap3,	dampXover,	dampAtten);
	fHp4, fD4	= rcFilterDamp(fTap4,	dampXover,	dampAtten);
/*
	fD1			= poleZeroDamp(fTap1,	dampXover);
	fD2			= poleZeroDamp(fTap2,	dampXover);
	fD3			= poleZeroDamp(fTap3,	dampXover);
	fD4			= poleZeroDamp(fTap4,	dampXover);
*/
	// fdn matrix
	fdnMat1		= ( fD1 + fD2 - fD3 - fD4 )  *  0.5;
	fdnMat2		= ( fD1 - fD2 - fD3 + fD4 )  *  0.5;
	fdnMat3		= (-fD1 + fD2 - fD3 + fD4 )  *  0.5;
	fdnMat4		= ( fD1 + fD2 + fD3 + fD4 )  *  0.5;
/*
	// fdn damp 2
	fdG				= dampXover * 0.125;	// fix for science :-)
	fdK				= 1;					// highpass, zero @ dc
	fdnMat1, fLp1	= rcFilterDamp(fdnMat1,	fdG,	fdK);
	fdnMat2, fLp2	= rcFilterDamp(fdnMat2,	fdG,	fdK);
	fdnMat3, fLp3	= rcFilterDamp(fdnMat3,	fdG,	fdK);
	fdnMat4, fLp4	= rcFilterDamp(fdnMat4,	fdG,	fdK);
*/
	// write feedback
	fdnDelay1.write(fdnMat1 + xTap1);
	fdnDelay2.write(fdnMat2 + xTap2);
	fdnDelay3.write(fdnMat3 + xTap3);
	fdnDelay4.write(fdnMat4 + xTap4);

	return		fD1, fD2, fD3, fD4;
}

// late diffusion allpass chains
lateDiffusion(apInxL, apInxR, lateTime1, lateTime2, lateTime3, lateTime4, lateTime5, lateTime6)
{
	History	ldiffdummy(0);

	// L
	yApL	= DiffAllpass( apInxL,	0.750,	lateTime1);
	yApL	= DiffAllpass( yApL,	0.625,	lateTime2);
	yApL	= DiffAllpass( yApL,	0.625,	lateTime3);
//	yApL	= DiffAllpass( yApL,	0.500,	lateTime1);

	// R
	yApR	= DiffAllpass( apInxR,	0.750,	lateTime4);
	yApR	= DiffAllpass( yApR,	0.625,	lateTime5);
	yApR	= DiffAllpass( yApR,	0.625,	lateTime6);
//	yApR	= DiffAllpass( yApR,	0.500,	lateTime4);

	return	yApL, yApR;
}

