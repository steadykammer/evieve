// like [average~ absolute]
averageAbsolute(inputSample, windowSizeInSamples)
{
	Delay	lastValues(samplerate*0.25, interp="none");
	History	accumulation(0);
	
	absoluteValue	= abs(inputSample);
	accumulation	= accumulation - lastValues.read(512);
	accumulation   += absoluteValue;
	lastValues.write(absoluteValue);
	
	return accumulation / windowSizeInSamples;
}

// generalised for options
averageCore(X, reset, windowSize=0)			// windowSize in samples
{
	Data	averageFrame(samplerate, 1);	// maximum always 1s

	History	frameReset(1);
	History	indexCount(0), indexRead(0);
	History	accumX(0);

	History	prevSize(100);					// init 100 samps like MSP
	size	= int(windowSize);

	audioReset	= delta(reset > 0) > 0;
	thisReset	= frameReset + audioReset;

	if ((size != prevSize) && (size > 0) && (size < samplerate)) {
		prevSize	= size;
		thisReset	= 1;
		for (i = prevSize; i < dim(averageFrame); i += 1)
		{
			poke(averageFrame, 0, i, 0, 0, index="samples");
		}
	}

	if (thisReset  != 0) {
		accumX		= 0;
		indexCount	= 0;
		indexRead	= 0;
		frameReset	= 0;
		thisReset	= 0;
	}

	indexCount	= minimum(indexCount, prevSize);
	indexRead	= wrap(indexRead, 0, prevSize);
	if (indexCount == prevSize) {
		accumX	   -= peek(averageFrame, indexRead, 0, index="samples");
		indexCount -= 1;	// never exceed the window size
	}
	accumX	   += X;
	poke(averageFrame, X, indexRead, 0, 0, index="samples");
	indexRead  += 1;
	indexCount += 1;

	return 		(accumX / indexCount), indexRead;		// mean, count
}

// wrap generalised, expensive
averageWrap(X, reset, interval=500, mode=0)	// interval in samples, mode 0=bipolar, 1=absolute, 2=rms
{
	type	= int(mode);
	typerms	= type == 2;

	Xin		= 0;
	if (type > 0)
	{
		if (typerms)
		{
			Xin	= (X * X);
		}
		else
		{
			Xin	= abs(X);
		}
	}
	else
	{
		Xin	= X;
	}

	average, index	= averageCore(Xin, reset, windowSize=interval);

	if (typerms)
	{
		average		= sqrt(average);
	}

	return 	average, index;

/*
	Xin		= (type > 0) ? (typerms ? (X * X) : abs(X)) : X;

	average, index	= averageCore(Xin, reset, windowSize=interval);
	average			= typerms ? sqrt(average) : average;

	return 	average, index;
*/
}

// this is raw, requires post smoothing (such as 'envAttackDecay()' or 'vactrol()')
// @see: 'envFollSimple()' below
envRawDetect(x, attack, release)	// clamp attack / release to 0..1
{
    History state(0);

    envdelta = abs(x) - state;
    envcoef = (envdelta > 0) ? attack : release;

    state += envdelta * envcoef;

//  return maximum(state, 0);		// do not need this maximum() ?
	return state;
}

envSad(s)									// s = time to drop 6dB (in seconds)
{
//	return	LN2 / (s * samplerate);
	return	LN2 / maximum((s * samplerate), 1);// (0.69314718056 / samples), incl. maximum check
}

// log smooth (decay) envelope follower
envDecay(x,	d)									// d = decay time (to drop 6dB) in seconds
{
	History	z(0);
	ad		= envSad(d);
	ff		= x - z;
	y		= (ff > 0) ? x : ((ff * ad) + z);
	z		= y;
	return	y;
}

// log smooth (attack/decay) envelope follower
envAttackDecay(x, a, d, r)							// a/d = attack/decay times (to 6dB) in seconds, r = reset
{
	History	z(0);
	if (r) {
		z = 0;
	}
	ff		= x - z;
	tt		= (ff > 0) ? a : d;
	ad		= envSad(tt);
	y		= (ff * ad) + z;
//	y		= (ff * ((ff > 0) ? envSad(a) : envSad(d))) + z;
	z		= y;
	return	y;
}

// log smooth (AHR) envelope follower (branching version, cheaper than 'simultaneous version')
envAttackHoldRelease(x, a, h, r)				// a/h/r = attack/hold/release times (to 6dB) in seconds
{
	History	z(0), g(0);
	ff		= x - z;
	hh, env	= 0;
	if (ff > 0)	{
		hh	= maximum((h * samplerate), 1) - 1;
		env	= envSad(a);
	} else {
		hh	= g - 1;
		env	= (hh > 0.000001) ? 0 : envSad(r);
	}
	y		= (ff * env) + z;
	g		= hh;
	z		= y;
	return	y;
}

vactrolSad(x, a)								// trigger, time
{
	return x * a / (1 + a);
}

// "vactrolBuchla()" elsewhere in evieve
vactrol(impulse, rise, fall, reset)				// trigger, rise (samps), fall (samps), reset
{
	History s1(0), a_up(0), a_down(0);
	if (reset) {
		s1 = 0;
		a_up = 0;
		a_down = 0;
	}
	a_base	= 3141.592653589793238/SAMPLERATE;  // 1000*PI/samplerate
    if (delta(rise) || delta(fall) || reset) {
	    t_down	= 10 + fall*(1 - 0.9*s1);		// fall time
	    a_down	= a_base/t_down;
	    t_up	= 1 + rise*(1 - 0.999*s1);		// rise time
	    a_up	= a_base/t_up;
    }
	x		= impulse - s1;
	x 		= (x < 0) ? vactrolSad(x, a_down) : vactrolSad(x, a_up);
	y		= x + s1;
	s1		= y + x;
	return	  y;								// & scale externally
}

// quick, simple, cheap
envFollSimple(X, attack, release)	// attack/release % 0..1
{
	History efsdummy(0);
	att = maximum(attack, 0.001);
	rel = maximum(release, 0.001);
	up = mstosamps(att * 10);
	down = mstosamps(rel * 100);
	detect = envRawDetect(X, att, rel);
	env = slide(detect, up, down);
	return env;
}

