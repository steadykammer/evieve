// you think this is stupid, but it is correct...

sinF0(x)
{
  return sin(x);
}

sinF1(x)
{
  return -cos(x);
}

sinF2(x)
{
    return -sin(x);
}

sinAdaa1(x0, osf)
{
  History x1(0), s1(0);
  eps = (osf <= 2) ? 0.000000000001 : ((osf == 4) ? 0.00000001 : 0.000001);

  y1 = 0;
  d0 = x0 - x1;
  s0 = sinF1(x0);    // func1
  if ((x1 == 0 && s1 == 0) || (abs(d0) < eps)) {  // ill condition
    y1 = sinF0(0.5 * (x0 + x1)); // func0
  } else {
    y1 = (s0 - s1) / d0;
  }

  s1 = s0;
  x1 = x0;
  return y1;
}

sinAdaa2(x0, osf)
{
  History x1(0), x2(0), s1(0);
  eps = (osf <= 2) ? 0.000000000001 : ((osf == 4) ? 0.00000001 : 0.000001);

  s0 = x0;//0;
  d0 = x0 - x1;
  f2_x1 = sinF2(x1); // func2
  if (abs(d0) < eps) {  // ill condition
    s0 = sinF1(0.5 * (x0 + x1)); // func1
  } else {
    s0 = (sinF2(x0) - f2_x1) / d0; // func2
  }

  y1 = x0;//0;
  d1 = x0 - x2;
  if (x1 == 0 && x2 == 0) { // ill condition
    y1 = sinF0(x0 + (x1 + x1) + x2) * 0.25; // func0
  } else if (abs(d1) < eps) { // ill condition
    x_bar = 0.5 * (x0 + x2);
    x_delta = x_bar - x1;
    if (x_delta < eps) {  // ill condition
      y1 = sinF0((x_bar + x1) * 0.5);  // func0
    } else {
      y1 = (2 / x_delta) * (sinF1(x_bar) + (f2_x1 - sinF2(x_bar)) / x_delta); // func1, func2
    }
  } else {
    s0s1 = s0 - s1;
    y1 = (s0s1 + s0s1) / d1;
  }

  s1 = s0;
  x2 = x1;
  x1 = x0;
  return y1;
}


// 

eCubicF0(x)
{
//  x = clip(x, -1, 1);
  return x * (1 - 0.333333333333 * x * x);
}

eCubicF1(x)
{
//  x = clip(x, -1, 1);
  xm3 = x*x - 3;
  return -xm3*xm3 * 0.083333333333333;
}

eCubicF2(x)
{
//  x = clip(x, -1, 1);
//  x2 = x*x;
//  return -(x * (x2*x2 - 10 * x2 + 45)) * 0.016666666666667;
  return -(x * (x*x*x*x - 10 * x*x + 45)) * 0.016666666666667;
}

eCubicAdaa1(x)
{
  History x1(0), s1(0);
  eps = 0.000001;  // TODO, work out precision
  x0 = clip(x, -1, 1);

  y1 = 0;
  d0 = x0 - x1;
  s0 = eCubicF1(x0);    // func1
  if ((x1 == 0 && s1 == 0) || (abs(d0) < eps)) {  // ill condition
    y1 = eCubicF0(0.5 * (x0 + x1)); // func0
  } else {
    y1 = (s0 - s1) / d0;
  }

  s1 = s0;
  x1 = x0;
  return y1;
}

eCubicAdaa2(x)
{
  History x1(0), x2(0), s1(0);
  eps = 0.000001;  // TODO, work out precision
  x0 = clip(x, -1, 1);

  s0 = 0;
  d0 = x0 - x1;
  f2_x1 = eCubicF2(x1); // func2
  if (abs(d0) < eps) {  // ill condition
    s0 = eCubicF1(0.5 * (x0 + x1)); // func1
  } else {
    s0 = (eCubicF2(x0) - f2_x1) / d0; // func2
  }

  y1 = 0;
  d1 = x0 - x2;
  if (x1 == 0 && x2 == 0) { // ill condition
    y1 = eCubicF0(x0 + (x1 + x1) + x2) * 0.25; // func0
  } else if (abs(d1) < eps) { // ill condition
    x_bar = 0.5 * (x0 + x2);
    x_delta = x_bar - x1;
    if (x_delta < eps) {  // ill condition
      y1 = eCubicF0((x_bar + x1) * 0.5);  // func0
    } else {
      y1 = (2 / x_delta) * (eCubicF1(x_bar) + (f2_x1 - eCubicF2(x_bar)) / x_delta); // func1, func2
    }
  } else {
    s0s1 = s0 - s1;
    y1 = (s0s1 + s0s1) / d1;
  }

  s1 = s0;
  x2 = x1;
  x1 = x0;
  return y1;
}

// 

tarrabiaF0(x, a)
{
    k = (a + a) / (1 - a);
    return ((1 + k) * x) / (1 + (k * abs(x)));
}

tarrabiaF1(x, a)
{
    ax = abs(x);
    return ((a + 1) * ((a - 1) * logApprox(abs(a * (ax + ax - 1) + 1)) + (a + a) * ax)) / (4 * a*a);
}

tarrabiaF2(x, a)
{
    ax = abs(x);
    am1 = a - 1;
    apa = a + a;
    loma = logApprox(1 - a);
    return (sign(x) * ((a + 1) * ((am1 + am1) * a * ax * logApprox(abs(a * (ax + ax - 1) + 1)) - am1 * (am1 * logApprox(abs(apa * ax - a + 1)) + apa * ax) + 2 * a*a * x*x) + loma * a*a*a - loma * a*a - loma * a + loma)) / (8 * a*a*a);
}

tarrabiaAdaa1(x0, a)
{
  History x1(0), s1(0);
  eps = 0.00001;  // TODO, work out precision

  y1 = 0;
  d0 = x0 - x1;
  s0 = tarrabiaF1(x0, a);    // func1
  if ((x1 == 0 && s1 == 0) || (abs(d0) < eps)) {  // ill condition
    y1 = tarrabiaF0(0.5 * (x0 + x1), a); // func0
  } else {
    y1 = (s0 - s1) / d0;
  }

  s1 = s0;
  x1 = x0;
  return y1;
}

// this does not work when changing / modulating 'a'
tarrabiaAdaa2(x0, a)
{
  History x1(0), x2(0), s1(0);
  eps = 0.00000000001;  // TODO, work out precision

  s0 = 0;
  d0 = x0 - x1;
  f2_x1 = tarrabiaF2(x1, a); // func2
  if (abs(d0) < eps) {  // ill condition
    s0 = tarrabiaF1(0.5 * (x0 + x1), a); // func1
  } else {
    s0 = (tarrabiaF2(x0, a) - f2_x1) / d0; // func2
  }

  y1 = 0;
  d1 = x0 - x2;
  if (x1 == 0 && x2 == 0) { // ill condition
    y1 = tarrabiaF0(x0 + (x1 + x1) + x2, a) * 0.25; // func0
  } else if (abs(d1) < eps) { // ill condition
    x_bar = 0.5 * (x0 + x2);
    x_delta = x_bar - x1;
    if (x_delta < eps) {  // ill condition
      y1 = tarrabiaF0((x_bar + x1) * 0.5, a);  // func0
    } else {
      y1 = (2 / x_delta) * (tarrabiaF1(x_bar, a) + (f2_x1 - tarrabiaF2(x_bar, a)) / x_delta); // func1, func2
    }
  } else {
    s0s1 = s0 - s1;
    y1 = (s0s1 + s0s1) / d1;
  }

  s1 = s0;
  x2 = x1;
  x1 = x0;
  return y1;
}

