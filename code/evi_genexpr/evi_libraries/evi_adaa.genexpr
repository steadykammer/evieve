szilagyiF0(x)
{
	return 0.5 * x * (3 - (x*x));
}

szilagyiF1(x)
{
	xx3 = x*x - 3;
	return -xx3*xx3 * 0.125;
}

szilagyiF2(x)
{
	xx = x*x;
	return -(x * (xx*xx - 10 * xx + 45)) * 0.025;
}

szilagyiAdaa1(x0)
{
	History x1(0), s1(0);
	eps = 0.00001;

	y1 = 0;
