    s0 = altTanhPolyF1(0.5 * (x0 + x1)); // func1
  } else {
    s0 = (altTanhPolyF2(x0) - f2_x1) / d0; // func2
  }

  y1 = x0;//0;
  d1 = x0 - x2;
  if (x1 == 0 && x2 == 0) { // ill condition
    y1 = altTanhPolyF0(x0 + (x1 + x1) + x2) * 0.25; // func0
  } else if (abs(d1) < eps) { // ill condition
