
// evieve poly bleps etc

// these 4-point poly bleps are much better than the rest of this file
// (2-points) in terms of anti aliasing, and better than 3rd order PTR, too
require("evi_polyblep_four.genexpr");

// below are 2-point poly bleps, not as good ...
// require("evi_polyblep_two.genexpr");

// waveforms
require("evi_polyblep_shapes.genexpr");	// includes "evi_polyblep_two.genexpr" && "evi_polyblep_utility.genexpr"

// utilities
// require("evi_polyblep_utility.genexpr");


// the big chooser, totally stupid, for testing / demos only:

poly_osc(freqInHz, pwm, a, t, dt, morph, wav)	// Hz, pulsewidth, amplitude, phase, increment, morph, waveshape
{
	osc		= 0;
	if ( (wav == 0) || (wav > 36) ) {
		osc	= poly_sin(t);						// 
	} else if (wav == 1) {
		osc	= poly_cos(t);						// 
	} else {
		if (freqInHz >= (SAMPLERATE * 0.25)) {	// sine if above (samplerate / 4)
			osc	= sin73(TWOPI * t);
		} else {								// !! note the stupid ordering !!
			if				(wav == 9) {
				osc	= poly_half(t, dt);
			} else if		(wav == 10) {
				pw	= (pwm >= 0.5) ? pwm : pwm * 0.92 + 0.04;
				osc	= poly_half2(t, dt, pw);	// !! not poly_half22()
			} else if		(wav == 11) {
				osc	= poly_full(t, dt);
			} else if		(wav == 12) {
				osc	= poly_sawp(t, dt);
			} else if		(wav == 14) {
				osc	= poly_alt(t, dt);
			} else if		(wav == 15) {
				osc	= poly_camel(t, dt);
			} else if		(wav == 16) {
				osc	= poly_sin2(t, dt);
			} else if		(wav == 17) {
				osc	= poly_para(t, dt);
			} else if		(wav == 2) {
				osc	= poly_tri(t, dt);
			} else if		(wav == 7) {
//				pw	= pwm * 0.98 + 0.01;
//				osc	= poly_tri2(t, dt, pw);
				osc = morph_saw_tri_saw(t, dt, pwm);
			} else if		(wav == 13) {
				pw	= (pwm >= 0.5) ? pwm : pwm * 0.8 + 0.1;
				osc	= poly_trip(t, dt, pw);
			} else if		(wav == 18) {
				osc	= poly_trap(t, dt);
			} else if		(wav == 19) {
				pw	= (pwm > 0.5) ? pwm * 0.998 + 0.001 : pwm;
				osc	= poly_trap2(t, dt, pw);
			} else if		(wav == 3) {
				osc	= poly_sqr(t, dt);
			} else if		(wav == 20) {
				osc	= poly_lpsqr2(t, dt);
			} else if		(wav == 21) {
				osc	= poly_lpsqr3(t, dt);
			} else if		(wav == 8) {
				pw	= (pwm >= 0.5) ? pwm : pwm * 0.88 + 0.06;
				osc	= poly_sqr2(t, dt, pw);
			} else if		(wav == 4) {
				pw	= pwm * 0.9 + 0.05;
				osc	= poly_rect(t, dt, pw);
			} else if		(wav == 5) {
				osc	= poly_saw(t, dt);
			} else if		(wav == 6) {
				osc	= poly_ramp(t, dt);
			} else if		(wav == 22) {
				osc	= poly_intsaw(t, dt);
			} else if		(wav == 23) {
				osc	= poly_cubsaw(t, dt);
			} else if		(wav == 24) {
				osc	= poly_sawsin(t, dt);
			} else if		(wav == 25) {
				osc	= poly_sinsaw(t, dt);
			} else if		(wav == 26) {
				osc	= poly_hpsaw6(t, dt);
			} else if		(wav == 27) {
				osc	= poly_logit3(t, dt);
			} else if		(wav == 32) {
				mph	= (morph > 0.5) ? morph * 0.999 + 0.0005 : morph;
				osc	= poly_trap2(t, dt, mph);		// morph tri..rect
			} else if		(wav == 28) {
				mph	= 1 - ((morph >= 0.5) ? morph * 0.95 + 0.025 : morph);
				osc	= poly_half2(t, dt, mph);		// morph sine_pulse..sine_square
			} else if		(wav == 29) {
				osc	= morph_saw_tri_saw(t, dt, morph);
			} else if		(wav == 30) {
				osc	= morph_saw_tri_square(t, dt, morph);
			} else if		(wav == 31) {
				osc	= morph_pulse_tri_pulse(t, dt, morph);
			} else if		(wav == 33) {
				osc	= morph_sawpulse_trirect(t, dt, morph);
			} else if		(wav == 34) {
				osc	= morph_pulsepulse_trirect(t, dt, morph);
			} else if		(wav == 35) {
				osc	= morph_pulsebipulse_trirect(t, dt, morph);
			} else {	//	(wav == 36)
//				width	= sqrt1_2;					// for future
//				osc		= morph_sinetri_mix(t, dt, pwm, width, morph);
				osc = 0;
			}
		}
	}

	return	osc * a;
}

// these interpolation downsamps are quite pointless and should probably be avoided

// fixed 3x cheap (down only) oversampling mono, plus voodoo for GenExpr
poly_down3x(freqInHz, pw, a, t, dt, morph, wav)
{
	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// process 3x
	y1_0	= poly_osc(freqInHz, pw, a, t, dt, morph, wav);
	y2_0	= poly_osc(freqInHz, pw, a, t, dt, morph, wav);
	y3_0	= poly_osc(freqInHz, pw, a, t, dt, morph, wav);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");
	y3_0_a	= y3_0 + 0;
	y3_1	= interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2, mode="spline");

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return y0_0;
}

// fixed 6x cheap (down only) oversampling mono, plus voodoo for GenExpr
poly_down6x(freqInHz, pw, a, t, dt, morph, wav)
{
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// process 6x
	y1_0	= poly_down3x(freqInHz, pw, a, t, dt, morph, wav);
	y2_0	= poly_down3x(freqInHz, pw, a, t, dt, morph, wav);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}

// fixed 4x cheap (down only) oversampling mono, plus voodoo for GenExpr
poly_down4x(freqInHz, pw, a, t, dt, morph, wav)
{	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// process 4x
	y1_0	= poly_osc(freqInHz, pw, a, t, dt, morph, wav);
	y2_0	= poly_osc(freqInHz, pw, a, t, dt, morph, wav);
	y3_0	= poly_osc(freqInHz, pw, a, t, dt, morph, wav);
	y4_0	= poly_osc(freqInHz, pw, a, t, dt, morph, wav);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");

	y3_0_a	= y3_0 + 0;
	y3_1	= interp(0.5,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2, mode="spline");

	y4_0_a	= y4_0 + 0;
	y4_1	= interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3, mode="spline");

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return y0_0;
}

// really stupid
// fixed 16x cheap (down only) oversampling mono, plus voodoo for GenExpr
poly_down16x(freqInHz, pw, a, t, dt, morph, wav)
{	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// process 4x
	y1_0	= poly_down4x(freqInHz, pw, a, t, dt, morph, wav);
	y2_0	= poly_down4x(freqInHz, pw, a, t, dt, morph, wav);
	y3_0	= poly_down4x(freqInHz, pw, a, t, dt, morph, wav);
	y4_0	= poly_down4x(freqInHz, pw, a, t, dt, morph, wav);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");

	y3_0_a	= y3_0 + 0;
	y3_1	= interp(0.5,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2, mode="spline");

	y4_0_a	= y4_0 + 0;
	y4_1	= interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3, mode="spline");

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return y0_0;
}

//	//	//	TODO

xab(x, a, b)
{
	return (x * a) + b;
}

blep8(x0)
{
	x1	= xab(x0, -2.180115, 6.7519);
	x2	= xab(x0, x1, -5.7564);
	x3	= xab(x0, x2, -1.62547);
	x4	= xab(x0, x3, 3.917645);
	x5	= xab(x0, x4, -0.11965);
	x6	= xab(x0, x5, -1.48783);
	return	xab(x0, x6, 0.49993);	
}

blamp8(x0)
{
	x1	= xab(x0, -0.54502875, 1.9291142857142856);
	x2	= xab(x0, x1, -1.9188);
	x3	= xab(x0, x2, -0.650188);
	x4	= xab(x0, x3, 1.9588225);
	x5	= xab(x0, x4, -0.07976666666666667);
	x6	= xab(x0, x5, -1.48783);
	x7	= xab(x0, x6, 0.99986);
	return	xab(x0, x7, -0.206184);	
}

