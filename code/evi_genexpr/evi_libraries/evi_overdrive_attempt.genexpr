
// common libs for the [evi.overdrive.*] abstractions (& evi_*wrap.gendsp's)

require("evi_approx.genexpr");
//require("evi_smooth.genexpr");
require("evi_utilities.genexpr");
require("evi_interp.genexpr");
//require("evi_adaa.genexpr");
//require("evi_rcfilter.genexpr");


// common functions for the [evi.overdrive.*] abstractions (& evi_*wrap.gendsp's)

expso(x, z)									// z is pole
{
	History w(0);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expsmoothBank3(x1, x2, x3, t)
{
	History	expsdummy3(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	return	y1, y2, y3;
}

logsmooth(x, s)		// x = value			// s = time to drop 6dB (in seconds)
{
	History z(0);
	ad = LN2 / (s * samplerate);			// (0.69314718056 / samples), no maximum check
	y  = ((x - z) * ad) + z;
	z  = y;
	return y;
}


// prewarps
rcPreWarp(cutoff)
{
	g0		=  tanA(PI * cutoff / SAMPLERATE);
	return	g0 / (1 + g0);
}

// fixed mode=0 version, no branching, keep out of while loop in export
rcDampCoeffs0(cutoff, damp)			// cutoff in Hz, damp must clamp 0..1 (1 = highpass/lowpass)
{
	g0		=  tanA(PI * cutoff / SAMPLERATE);	// prewarp
	ks		= (damp * 0.5) + 0.5;	// damp 0..1 = sqrt..lin
	ks05	= (ks - 0.5);
	ksom	= ((1 - ks) + 0.5) - 0.5;
	g01		=  1 + g0;
	g1 		=  g0 / interp((ks05 + ks05), sqrt(g01), g01, mode="linear");
	d1		= interp((ksom + ksom), sqrt(damp), damp, mode="linear");
	return	g1, d1;					// rc filter warped cf (g)	// rc filter warped gain (k)
}

rcFilterDampHpLp(Vin, g, k)
{
	History	   s(0);
	Lp		= (g * Vin + s) / (g + 1);
	s		= (Lp + Lp) - s;
//	Hp		=  Lp - Vin;				// must be y-x

//	LpHs	=  Vin + (k * (Lp - Vin));
//	HpLs	= (k * Lp) - Vin;

	return	(k * Lp) - Vin, Vin + (k * (Lp - Vin));
}


// these are the antiderivatives of the approximation, not of a real tanh - that is crucial !
// sadly we still end up with a bloody Li2 in the 2nd order :-(

// note: this tanh approx becomes not-tanh-like above about +22dB input gain (wave folds)
// note: the entire approx is -6dB down, but we boost it on input before adaa to match tanh()

altTanhF0(x)
{
  // not one of the better tanh() approxes, but the antiderivatives are more manageable
  // than many of the others, swings and roundabouts
  ex = (-1 / (expApprox(x) + 1));
  return ex + ex + 1;
}

altTanhF1(x)
{
  lex = log(exp(x) + 1); // not exp- or log- Approx() !
  return lex + lex - x;
}

altTanhF11(x)
{
  lex = logApprox(expApprox(x) + 1); // ok for just Adaa1 ?
  return lex + lex - x;
}

altTanhF2(x)
{
  li2ex = Li2Approx(-exp(x)); // not expApprox() !
  return -(li2ex + li2ex + li2ex + li2ex + x*x) * 0.5;
}

altTanhAdaa1(x0, reset)
{
  History x1(0), s1(0);
  eps = 0.000001; // TODO, precision
  if (reset) {
    x1 = 0; s1 = 0;
  }

  y1 = x0;
  d0 = x0 - x1;
  s0 = altTanhF11(x0); // func1
  if ((x1 == 0 && s1 == 0) || (abs(d0) < eps)) {  // ill condition
    y1 = altTanhF0(0.5 * (x0 + x1));  // func0
  } else {
    y1 = (s0 - s1) / d0;
  }

  s1 = s0;
  x1 = x0;
  return y1;
}

altTanhAdaa2(x0, reset)
{
  History x1(0), x2(0), s1(0);
  eps = 0.000001; // TODO, precision
  if (reset) {
    x1 = 0; x2 = 0; s1 = 0;
  }

  s0 = x0;
  d0 = x0 - x1;
  f2_x1 = altTanhF2(x1);  // func2
  if (abs(d0) < eps) {  // ill condition
    s0 = altTanhF1(0.5 * (x0 + x1));  // func1
  } else {
    s0 = (altTanhF2(x0) - f2_x1) / d0;  // func2
  }

  y1 = x0;
  d1 = x0 - x2;
  if (x1 == 0 && x2 == 0) { // ill condition
    y1 = altTanhF0(x0 + (x1 + x1) + x2) * 0.25; // func0
  } else if (abs(d1) < eps) { // ill condition
    x_bar = 0.5 * (x0 + x2);
    x_delta = x_bar - x1;
    if (x_delta < eps) {  // ill condition
      y1 = altTanhF0((x_bar + x1) * 0.5); // func0
    } else {
      y1 = (2 / x_delta) * (altTanhF1(x_bar) + (f2_x1 - altTanhF2(x_bar)) / x_delta); // func1, func2
    }
  } else {
    s0s1 = s0 - s1;
    y1 = (s0s1 + s0s1) / d1;
  }

  s1 = s0;
  x2 = x1;
  x1 = x0;
  return y1;
}


// altTanhAdaa1 oversampling...

// fixed 2x quasi oversampling (hermite6)
altTanhAdaa1_2x_6POINT(XIN, reset)
{	// up 2
	History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History doX0(0);

	// up 2x
	x0_0_a  = XIN + 0;
	x1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0  = umT2_0 + 0;

	// process 2x
	y1_0  = altTanhAdaa1(x1_0, reset);
	y2_0  = altTanhAdaa1(x2_0, reset);

	// down 2x
	y2_0_a  = y2_0 + 0;
	y2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0  = (doX0 + y2_1) * 0.5;

	// update
	umTm2_0 = umTm1_0;
	umTm1_0 = umT0_0;
	umT0_0  = umT1_0;
	umT1_0  = umT2_0;
	umT2_0  = x0_0_a;

	doX0  = y1_0;

	dmT3_1  = dmT2_1;
	dmT2_1  = dmT1_1;
	dmT1_1  = dmT0_1;
	dmT0_1  = dmTm1_1;
	dmTm1_1 = y2_0;

	return dcblock(y0_0);
}

// fixed 4x quasi oversampling (hermite6)
altTanhAdaa1_4x_6POINT(XIN, reset)
{	// up 2
	History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
