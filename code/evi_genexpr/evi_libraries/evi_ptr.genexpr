// two W=3 (e)ptr oscillators (W any less is pointless)
// in evieve, better than polyblep 2-point, but not as good as polyblep 4-point

ptr3_saw(p, T0, P0)			// p = normalised phase 0..1
{
	T2  = T0+T0;
	T3  = T2+T0;
	cdc = T3;
	DC  = 1 + cdc;

	a31 = -0.333333333333;
	a11 =  T2;
	a01 =  2 - DC;
	a32 =  0.666666666666;
	a22 = -3;
	a12 =  T2 - a22;
	a02 =  1 - DC;
	a33 =  a31;
	a23 = -a22;
	a13 =  T2 - 9;
	a03 =  9 - DC;

	y = 0;
	if (p >= T3) {			// outside
		y = (p + p) - DC;
	} else if (p >= T2) {
		D = p * P0;
		y = ((a33*D + a23)*D + a13)*D + a03;
	} else if (p >= T0) {
		D = p * P0;
		y = ((a32*D + a22)*D + a12)*D + a02;
	} else {
		D = p * P0;
		y = (a31*D*D + a11)*D + a01;
	}

	return y;
}

ptr3_rect(p, T0, P0, w)		// p = normalised phase 0..1, w = pulse width 0..1
{
	T2	=  T0+T0;
	T3	=  T2+T0;
	P2	= (P0*P0)*0.5;
	P3	= (P0*P0*P0)*0.166666666666;
	s	=   0;
	if (p < w) {
		if (p < T0) {
			s =  -(p*p*p)*P3 + w;
		}
		else if (p < T2) {
			pp  = p*p;
			ppp = pp*p;
			s = (ppp+ppp)*P3 - (pp+pp+pp)*P2 + 1.5*p*P0 + w - 0.5;
		}
		else if (p < T3) {
			pp  = p*p;
			ppp = pp*p;
			s =  -ppp*P3 + (pp+pp+pp)*P2 - 4.5*p*P0 + w + 3.5;
		}
		else {
			s = w - 1;
		}
	} else {
		pw = p - w;
		if (pw < T0) {
			s = (pw*pw*pw)*P3 + w - 1;
		}
		else if (pw < T2) {
			ppw  = pw*pw;
			pppw = ppw*pw;
			s = -(pppw+pppw)*P3 + (ppw+ppw+ppw)*P2 - 1.5*pw*P0 + w - 0.5;
		}
		else if (pw < T3) {
			ppw  = pw*pw;
			pppw = ppw*pw;
			s = pppw*P3 - (ppw+ppw+ppw)*P2 + 4.5*pw*P0 + w - 4.5;
		}
		else {
			s = w;
		}
	}

	return s;
}

// T0 = Hz / samplerate;
// P0 = samplerate / Hz;

