
// evieve Linkwitz-Riley TPT SVF Butterworth crossover filters for multiband processing,
// these filters sum perfectly flat and are stable even if modulating

// @see: https://www.kvraudio.com/forum/viewtopic.php?t=500121&start=60


require("evi_approx.genexpr");


// 2-band 2-pole Linkwitz-Riley, sums to allpass

eviXover2pole2band(X, xover)                    // xover = frequency in Hz
{
    History	state1(0), state2(0);
    w2  = tanA2(xover * PI / samplerate);

    // sum
    s1  = state1;
    g2	= w2 * w2;
    s2	= state2 + (s1 * w2);

    // feedback
    gS	= -(g2 + w2 + w2);                      // invert
    sS	= -(s2 + s1 + s1);

    // solve
    alpha	= 1 / (1 - gS);
    x0	    = ((X * gS) + sS) * alpha;	        // audio input
    y0		= X + x0;						    // y0 = HP2

    // integrator 1, forward
    x1	= y0 * w2;
    y1	= x1 + state1;
    // integrator 2, forward
    x2	= y1 * w2;
    y2	= x2 + state2;			                // y2 = LP2

    // integrator 1, update
    state1	= x1 + y1;
    // integrator 2, update
    state2	= x2 + y2;

    return  y2, -(y0);                          // lowpass, invert highpass for 2nd order
}

// 2-band 4-pole Linkwitz-Riley, sums to allpass

eviXover4pole2band(X, xover)                    // xover = frequency in Hz
{
    History	state1(0), state2(0), state3(0), state4(0);
    w2  = tanA2(xover * PI / samplerate);
    SQRT8 = 2.8284271247461903;                 // = sqrt(8) because butterworth

    // summing
    s1  = state1;
    s2  = state2;
    s3  = state3;
    g2	= w2 * w2;
    g3  = g2 * w2;
    g4  = g3 * w2;
    s2	= state2 + (s1 * w2);
    s3  = state3 + (s2 * w2);
    s4  = state4 + (s3 * w2);

    // feedback
    gS  = -(((w2 + g3) * SQRT8) + (g4 + (g2 * 4)));
    sS  = -(((s1 + s3) * SQRT8) + (s4 + (s2 * 4)));

    // solve
    alpha	= 1 / (1 - gS);
    x0	    = ((X * gS) + sS) * alpha;	        // audio input
    y0		= X + x0;						    // y0 = HP4

    // integrator 1, forward
    x1	= y0 * w2;
    y1	= x1 + state1;
    // integrator 2, forward
    x2	= y1 * w2;
    y2	= x2 + state2;
    // integrator 3, forward
    x3	= y2 * w2;
    y3	= x3 + state3;
    // integrator 4, forward
    x4	= y3 * w2;
    y4	= x4 + state4;			                // y4 = LP4

    // integrator 1, update
    state1		= x1 + y1;
    // integrator 2, update
    state2		= x2 + y2;
    // integrator 3, update
    state3		= x3 + y3;
    // integrator 4, update
    state4		= x4 + y4;

    return  y4, y0;                             // lowpass, highpass
}

// 3-bands 2-pole, sums correctly with 1-pole allpass alignment

eviXover2pole3band(X, xoverLow, xoverHigh)
{
    History ex23dummy(0);

    LOW, SPLIT  = eviXover2pole2band(X, xoverLow);
    MID, HIGH   = eviXover2pole2band(SPLIT, xoverHigh);

    // when summing down stream you must sum LOW via 1-pole allpass alignment
    return  LOW, MID, HIGH;
}

// 3-bands 4-pole, sums correctly with 2-pole allpass alignment

eviXover4pole3band(X, xoverLow, xoverHigh)
{
    History ex43dummy(0);

    LOW, SPLIT  = eviXover4pole2band(X, xoverLow);
    MID, HIGH   = eviXover4pole2band(SPLIT, xoverHigh);

    // when summing down stream you must sum LOW via 2-pole allpass alignment
    return  LOW, MID, HIGH;
}

// allpass filters for summing 3-bands
// also use allpasses if mixing in other un-split content

eviXoverAllpass1(X, hz)                         // hz = xoverHigh
{
    History s(0);
    w2  = tanA2(hz * PI / samplerate);

    x0  = ((X * -w2) - s) * (1 / (1 + w2));
    y0  = X + x0;                               // y0 = HP1

    x1  = y0 * w2;
    y1  = x1 + s;                               // y1 = LP1

    s   = x1 + y1;

    return y1 - y0;                             // allpass
}

// i prefer a cascade of 'standard' to a 'normaised' 2-pole svf allpass
// ^^ please get in touch if i am wrong about that
eviXoverAllpass2(X, hz)
{
    History exa2dummy(0);

    Y   = eviXoverAllpass1(X, hz);
    Y   = eviXoverAllpass1(Y, hz);

    return Y;
}

// summing utilities to align unslpit band
// you could put the allpasses at the beginning of the split,
// but apparently you are supposed to do it after your processing, ymmv

// 2-pole 3-band

eviXover2pole3bandSum(LOW, MID, HIGH, xoverHigh)
{
    History ex23sdummy(0);
    lowSum  = eviXoverAllpass1(LOW, xoverHigh);
    return  lowSum + MID + HIGH;
}

// 4-pole 3-band

eviXover4pole3bandSum(LOW, MID, HIGH, xoverHigh)
{
    History ex43sdummy(0);
    lowSum  = eviXoverAllpass2(LOW, xoverHigh);
    return  lowSum + MID + HIGH;
}


// same as all of above but stereo:

eviXover2pole2bandStereo(xL, xR, xover)
{
    History ex22sdummy(0);
    yLL, yHL  = eviXover2pole2band(xL, xover);
    yLR, yHR  = eviXover2pole2band(xR, xover);
    return yLL, yLR, yHL, yHR;              // L, R, L, R
}

eviXover4pole2bandStereo(xL, xR, xover)
{
    History ex42sdummy(0);
    yLL, yHL  = eviXover4pole2band(xL, xover);
    yLR, yHR  = eviXover4pole2band(xR, xover);
    return yLL, yLR, yHL, yHR;              // L, R, L, R
}

eviXover2pole3bandStereo(xL, xR, hzLow, hzHigh)
{
    History ex23sdummy(0);
    yLL, yML, yHL  = eviXover2pole3band(xL, hzLow, hzHigh);
    yLR, yMR, yHR  = eviXover2pole3band(xR, hzLow, hzHigh);
    return yLL, yLR, yML, yMR, yHL, yHR;    // L, R, L, R, L, R
}

eviXover4pole3bandStereo(xL, xR, hzLow, hzHigh)
{
    History ex43sdummy(0);
    yLL, yML, yHL  = eviXover4pole3band(xL, hzLow, hzHigh);
    yLR, yMR, yHR  = eviXover4pole3band(xR, hzLow, hzHigh);
    return yLL, yLR, yML, yMR, yHL, yHR;    // L, R, L, R, L, R
}

eviXoverAllpass1Stereo(xL, xR, hz)
{
    History exa1sdummy();
    yL = eviXoverAllpass1(xL, hz);
    yR = eviXoverAllpass1(xR, hz);
    return yL, yR;
}

eviXoverAllpass2Stereo(xL, xR, hz)
{
    History exa2sdummy();
    yL = eviXoverAllpass2(xL, hz);
    yR = eviXoverAllpass2(xR, hz);
    return yL, yR;
}

eviXover2pole3bandSumStereo(lowL, lowR, midL, midR, highL, highR, xoverHigh)
{
    History ex23ssdummy(0);
    lowSumL, lowSumR    = eviXoverAllpass1Stereo(lowL, lowR, xoverHigh);
    sumLeft     = lowSumL + midL + highL;
    sumRight    = lowSumR + midR + highR;
    return      sumLeft, sumRight;
}

eviXover4pole3bandSumStereo(lowL, lowR, midL, midR, highL, highR, xoverHigh)
{
    History ex43ssdummy(0);
    lowSumL, lowSumR    = eviXoverAllpass2Stereo(lowL, lowR, xoverHigh);
    sumLeft     = lowSumL + midL + highL;
    sumRight    = lowSumR + midR + highR;
    return      sumLeft, sumRight;
}

//

// for reading / writing from / to Data() in cascade form

eviXoverAllpass1cascade(X, hz, s0)
{
    w2  = tanA2(hz * PI / samplerate);

    x0  = ((X * -w2) - s0) * (1 / (1 + w2));
    y0  = X + x0;
    x1  = y0 * w2;
    y1  = x1 + s0;
    s1  = x1 + y1;

    return y1 - y0, s1;
}

eviXoverAllpass2cascade(Xin, Hz, s0, s1)
{
    w2  = tanA2(Hz * PI / samplerate);
    g0  = 1 / (1 + w2);

    x0  = ((Xin * -w2) - s0) * g0;
    y0  = Xin + x0;
    x1  = y0 * w2;
    y1  = x1 + s0;
    s2  = x1 + y1;
    ap1 = y1 - y0;

    x2  = ((ap1 * -w2) - s1) * g0;
    y2  = ap1 + x2;
    x3  = y2 * w2;
    y3  = x3 + s1;
    s3  = x3 + y3;
    ap2 = y3 - y2;

    return ap2, s2, s3;
}

