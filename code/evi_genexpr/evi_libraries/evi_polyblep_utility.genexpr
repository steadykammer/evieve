cosQ73b(x)
{
	c1 =  0.999999953464;
	c2 = -0.499999053455;
	c3 =  0.0416635846769;
	c4 = -0.0013853704264;
	c5 =  0.00002315393167;  	

	x2 = x * x;
	return (c1 + x2 * (c2 + x2 * (c3 + x2 * (c4 + c5 * x2))));
}

// only about 1.2 x faster than library cos()
cos73b(x)
{
	TWOOVERPI = 0.63661977236758;	// 2 / PI
	x = x % TWOPI;								// phasewrap(x) cheaper ?
	x = (x < 0) ? -x : x;
	QUAD = int(x * TWOOVERPI);		// get quadrant # (0..3) we are in
	cosreturn = 0;
	if 				(QUAD == 0) {
		cosreturn =  cosQ73b(x);
	} else if 		(QUAD == 1) {
		cosreturn = -cosQ73b(PI - x);
	} else if 		(QUAD == 2) {
		cosreturn = -cosQ73b(x - PI);
	} else {	//	(QUAD == 3)
		cosreturn =  cosQ73b(TWOPI - x);
	}
	return cosreturn;
}

sin73b(x)
{
	return cos73b(HALFPI - x);
}

// variable dcblock() so that effect can be bypassed (a0 = 1)
// or active (a0 = 0.9997) or heavy (a0 = ...)
// for making oscillators that can morph from LFOs to Audio, for example
varDcblockReset(x0, a0, r0)	// r0 = reset
{
	History	x1(0), y1(0);
	if (r0) {
		x1	= 0;
		y1	= 0;
	}

	y0	= x0 - x1 + fixdenorm(y1 * a0);
	x1	= x0;
	y1	= y0;

	return	y0;
}

dynamicDc(osc, dtn, dcn)	// dcn: 0=off, 1=on, 2=auto for lfos, 3=auto for oscillators
{
	History	dddtn(1);
	// sadly rdcn must go external to if/else block :-(
	rdcn	= delta(change(dcn)) < 0; // which is cheaper, abs() or delta() ?

	if (dcn > 0) {

		if (dcn == 1) {

			osc	= varDcblockReset(osc, 0.9997, rdcn);

		} else {

			// !! gen~ bug (or precision issue?): this sqrt causes NaNs !!
			// sqrt1224	= sqrt(1 - ((clip(dtn, 0.0005, 0.001) - 0.0005) * 2000));
			sqrt1224	= pow(1 - ((clip(dtn, 0.0005, 0.001) - 0.0005) * 2000), 0.5);	// :-(
			dc1			= (sqrt1224 * 0.0003) + 0.9997;
			dc2			= 0;

			if (dcn > 2) {

				lin48	= (clip(dtn, 0.166667, 0.333333) - 0.166667) * 6.000022;
				dc2		= lin48 * -0.0097;

			}

			dyndc	= fixdenorm(dc1 + dc2); // this fixdenorm() is essential
			// dyndc	= evi_line(dyndc, mstosamps(15.111)); // this works, but not on initialisation, not sure what to do
			// dyndc	= evi_line_reset(dyndc, mstosamps(15.111), rdcn); // this breaks gen~, but gen~ won't tell me why
			osc		= varDcblockReset(osc, dyndc, rdcn);

		}

	}	// else dcn == 0 == no dcblock()

	return osc;
}

/*
 * Post-filter to decolorate oscillator waveshapers when antialiasing is used.
 *
 * Linear time-invariant filter can be added in series of
 * oscillator waveshapers that use PolyBLEP antialiasing,
 * to compensate for high-frequency attenuation.
 *
 * Copyright (C) 2022-2024 Orastron Srl unipersonale
 * Stefano D'Angelo, GPL v3
 */
decorelateOsc(x)
{
	History	z1(0);
	y = 1.371308261611209 * x + z1;
	z1 = 0.08785458027104826 * x - 0.45916284188226 * y;
	return y;
}

