require("evi_smooth.genexpr");  // incl. _utilities & _approx
require("evi_clipping.genexpr");// incl. _interp
require("evi_biquads_filters.genexpr");


// release is in ms
// knee is % 0..1
// choochoo is int 0, 1, 2 ("clip", "soft", "softer")
// almost the same as 'evi_limiterfast.gendsp'
// usage: a0, a1, a2, b1, b2 = smoothCoeff(smooth);	// in 'evi_smooth.genexpr'
limiterHardSoft(xL, xR, release, knee, choochoo, a0, a1, a2, b1, b2)
{
	History		lfdummy(0);
	soft		= choochoo != 0;
	compress	= choochoo == 2;
	reset		= delta(change(choochoo)) < 0;

	inPeak		= getMax(xL, xR);
	envAttack	= 0.000001;			// secs, looks like bullshit to me
	envRelease	= release * 0.001;	// ms to secs

	e1	= logattackdecay(inPeak, envAttack, envRelease);
	e2	= biquadDf2(e1, a0, a1, a2, b1, b2);					// e2 is bullshit
	k0	= maximum(((e2 - 1) + knee), 0) * (1 / knee);
	k1	= minimum((k0), 2) * 0.25;	// you think this is wrong, but it is right
	k2	= k1 - (k1 * k1);
	env	= 1 / (((k0 - (k2 + k2 + k2 + k2)) * knee) + 1);		// 1..0 (amplitude)

	yL		= dcblock(xL * env);
	yR		= dcblock(xR * env);

	if (soft) {
		// tanh option (2nd order antiderivative)
		headroom = compress ? 0.794328 : 1;
		expand = compress ? 1.258926 : 1;
		yL	= adSc2(yL * headroom, 1, reset) * expand;
		yR	= adSc2(yR * headroom, 1, reset) * expand;
	} else {
		// hard clip (@ -0.3dB, 2nd order antiderivative + oversampling)
		yL	= adHc2_2x_6POINT(yL, reset);
		yR	= adHc2_2x_6POINT(yR, reset);
	}

	return	yL, yR, env;
}

//	//	//

companderAverager(x0, companderCrect, T)
{
	History y1(0);
	b0 = T / (10000 * companderCrect * 0.000001 + T);	// compander smoothing
	a1 = -1 + b0;
	y0 = (x0 * b0) - (y1 * a1);
	y1 = y0;
	return y0;
}

companderCompress(x, smoothing, T)
{
	History compPrev(0);
	compIn = (0.5 * (x + compPrev));
	compDiv = 1 - (companderAverager(abs(compPrev), smoothing, T) + 0.00001);
	compProc = compIn * compDiv;
	compPrev = compProc;
	return compProc, compDiv;
}

companderExpand(x, smoothing, T)
{
	History cedummy(0);
	expMul = ((companderAverager(abs(x), smoothing, T)) * sqrt1_2) + 1;
	return x * expMul, expMul;
}

