
require("evi_interp.genexpr");

tanhLapprox(x)									// tanh lambert
{
	x2 = x * x;
	a  = (((x2 + 378) * x2 + 17325) * x2 + 135135) * x;
	b  = ((28 * x2 + 3150) * x2 + 62370) * x2 + 135135;
	return clamp((a / b), -1, 1);
}

cubicClip(x)									// cubic addition
{
	x05 = x * 0.5;
	x03 = x * 0.333333333333;
	w = x*x*x03;
	v = x*x05 - 0.166666666666;
	return	(x > 1) ? v : ((x < -1) ? -v : w);
}

nonlin(x, nl)									// choice
{
	y = 0;
	if (nl) {
		y = cubicClip(x);
	} else {
		y = tanhLapprox(x);
	}
	return y;
}

// filter based on "A Digital Model of the Buchla Lowpass-Gate" by Julian Parker and Stefano D’Angelo, 2013
buchlaLpg1(x, rf, res, resist, vcamode, lpgmode, nl)
{
	History	so(0), sx(0), sd(0);
	History	xo(0);
	thing = 1 - (nl * (1 - sqrt1_2));
	thong = resist * (1 - nl); 

	// constants
	c1 = 0.000000001;
	c2 = 0.00000000022;
	c3 = lpgmode*0.0000000047;
	c2c3 = c2+c3;

	r1 = 1000;
	r3 = (1 - vcamode)*5000000 + 10000;					// "ra"

	// resonance / feedback
	max_res = ((c1+c1)*r3 + c2c3*(r3+rf)) / (c3*r3);	// this surely should not work (div by 0) ?
	a = minimum(res, max_res) * thing;
	resi05 = resist*0.5;
	resiComp = (1 - resi05*1.333333333333);

	// frequency
	sr = samplerate;
	f = 0.5/sr;
	//f = twopi*(rf + 0.001)*0.5/samplerate;			// todo, Hz input version
	ff = f+f;
	rf1 = sr+sr;	// 1/f
	rf2 = rf1+rf1;	// 2/f
	rfc2 = rf*c2;
	rfc2c3 = rf*c2c3;
	r1rf = 1/(1 + r1/rf);
	ac3c1 = a*c3/c1;

	// coefficients
	a1 = 1/(c1*rf);
	a2 = -(1/rf + 1/r3)/c1;
	b1 = 1/rfc2;
	bm2 = resist*0.8101 + 0.1899;
	bm22 = bm2*bm2;
	rfbm22 = rfc2c3*bm22;
	b2a = -2/rfc2;
	b2b = (ac3c1 - 1 - r1rf)/rfbm22;
	b2 = interp(thong, b2a, b2b, mode="linear");		// morph feedback resistors...
	b3a = b1;
	b3b = (r1rf - (1 + rf/r3)*ac3c1)/rfbm22;
	b3 = interp(thong, b3a, b3b, mode="cosine");		// ...
	b4 = c3/c2;
	d1 = a;

	// intermediates
	Dx = 1/(1 - b2*f);
	Do = 1/(1 - a2*f);
	fb3d = f*b3*Do;
	fb4 = b4*f;
	rf1d1 = rf1*d1;

	// solve nonlinear
	xb1 = b1*x;
	tanh_xo  = nonlin(xo*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo2 = 1 - tanh_xo*tanh_xo;
	d1rthx = d1*rtanh_xo2;
	rtanh_mo2 = tanh_xo - xo*rtanh_xo2;
	d1rthm = d1*rtanh_mo2;
	Dmas = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx*Do*a1 - b4));
	rf1d1rth = rf1*d1rthm;

	// compute integrators
	yx = (sx + f*xb1 + fb3d*so + fb4*(sd + rf1d1rth) + b4*d1rthx*Do*so)*Dx*Dmas;
	a1yx = a1*yx;
	yo = (so + f*a1yx)*Do;
	d1rthyx = d1rthx*yo - yx;
	yd = (sd + rf1d1rth) + rf1*d1rthyx;

	// update state
	sx +=   ff*(xb1 + b2*yx + b3*yo + b4*yd);
	so +=   ff*(a1yx + a2*yo);
	sd  = -(sd + rf2*d1rthm) - rf2*d1rthyx;
	xo  =   yo;

	// "outputs can be mixed to produce other filter modes", pete: "good luck with that"
	return	yo*resiComp;//, yx*resiComp, yd*0.011111111111;
}

buchlaLpg2(x0, x1, rf, res, resist, vcamode, lpgmode, nl)
{
	History	so(0), sx(0), sd(0);
	History	xo0(0), xo1(0);
	thing = 1 - (nl * (1 - sqrt1_2));
	thong = resist * (1 - nl); 

	// constants
	c1 = 0.000000001;
	c2 = 0.00000000022;
	c3 = lpgmode*0.0000000047;
	c2c3 = c2+c3;

	r1 = 1000;
	r3 = (1 - vcamode)*5000000 + 10000;

	// resonance / feedback
	max_res = ((c1+c1)*r3 + c2c3*(r3+rf)) / (c3*r3);
	a = minimum(res, max_res) * thing;
	resi05 = resist*0.5;
	resiComp = (1 - resi05*1.333333333333);

	// frequency
	sr = samplerate;
	f = 0.5/sr * 0.5;                                   // 2x
	ff = f+f;
	rf1 = sr+sr;
	rf2 = rf1+rf1;
	rfc2 = rf*c2;
	rfc2c3 = rf*c2c3;
	r1rf = 1/(1 + r1/rf);
	ac3c1 = a*c3/c1;

	// coefficients
	a1 = 1/(c1*rf);
	a2 = -(1/rf + 1/r3)/c1;
	b1 = 1/rfc2;
	bm2 = resist*0.8101 + 0.1899;
	bm22 = bm2*bm2;
	rfbm22 = rfc2c3*bm22;
	b2a = -2/rfc2;
	b2b = (ac3c1 - 1 - r1rf)/rfbm22;
	b2 = interp(thong, b2a, b2b, mode="linear");
	b3a = b1;
	b3b = (r1rf - (1 + rf/r3)*ac3c1)/rfbm22;
	b3 = interp(thong, b3a, b3b, mode="cosine");
	b4 = c3/c2;
	d1 = a;

	// intermediates
	Dx = 1/(1 - b2*f);
	Do = 1/(1 - a2*f);
	fb3d = f*b3*Do;
	fb4 = b4*f;
	rf1d1 = rf1*d1;

    // pass 1

	// solve nonlinear
	xb10 = b1*x0;
	tanh_xo0  = nonlin(xo0*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo20 = 1 - tanh_xo0*tanh_xo0;
	d1rthx0 = d1*rtanh_xo20;
	rtanh_mo20 = tanh_xo0 - xo0*rtanh_xo20;
	d1rthm0 = d1*rtanh_mo20;
	Dmas0 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx0*Do*a1 - b4));
	rf1d1rth0 = rf1*d1rthm0;

	// compute integrators
	yx0 = (sx + f*xb10 + fb3d*so + fb4*(sd + rf1d1rth0) + b4*d1rthx0*Do*so)*Dx*Dmas0;
	a1yx0 = a1*yx0;
	yo0 = (so + f*a1yx0)*Do;
	d1rthyx0 = d1rthx0*yo0 - yx0;
	yd0 = (sd + rf1d1rth0) + rf1*d1rthyx0;

	// update state
	sx +=   ff*(xb10 + b2*yx0 + b3*yo0 + b4*yd0);
	so +=   ff*(a1yx0 + a2*yo0);
	sd  = -(sd + rf2*d1rthm0) - rf2*d1rthyx0;
	xo0 =   yo0;

    // pass 2

	// solve nonlinear
	xb11 = b1*x1;
	tanh_xo1  = nonlin(xo1*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo21 = 1 - tanh_xo1*tanh_xo1;
	d1rthx1 = d1*rtanh_xo21;
	rtanh_mo21 = tanh_xo1 - xo1*rtanh_xo21;
	d1rthm1 = d1*rtanh_mo21;
	Dmas1 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx1*Do*a1 - b4));
	rf1d1rth1 = rf1*d1rthm1;

	// compute integrators
	yx1 = (sx + f*xb11 + fb3d*so + fb4*(sd + rf1d1rth1) + b4*d1rthx1*Do*so)*Dx*Dmas1;
	a1yx1 = a1*yx1;
	yo1 = (so + f*a1yx1)*Do;
	d1rthyx1 = d1rthx1*yo1 - yx1;
	yd1 = (sd + rf1d1rth1) + rf1*d1rthyx1;

	// update state
	sx +=   ff*(xb11 + b2*yx1 + b3*yo1 + b4*yd1);
	so +=   ff*(a1yx1 + a2*yo1);
	sd  = -(sd + rf2*d1rthm1) - rf2*d1rthyx1;
	xo1 =   yo1;

	return	yo0*resiComp, yo1*resiComp;
}

buchlaLpg3(x0, x1, x2, rf, res, resist, vcamode, lpgmode, nl)
{
	History	so(0), sx(0), sd(0);
	History	xo0(0), xo1(0), xo2(0);
	thing = 1 - (nl * (1 - sqrt1_2));
	thong = resist * (1 - nl); 

	// constants
	c1 = 0.000000001;
	c2 = 0.00000000022;
	c3 = lpgmode*0.0000000047;
	c2c3 = c2+c3;

	r1 = 1000;
	r3 = (1 - vcamode)*5000000 + 10000;

	// resonance / feedback
	max_res = ((c1+c1)*r3 + c2c3*(r3+rf)) / (c3*r3);
	a = minimum(res, max_res) * thing;
	resi05 = resist*0.5;
	resiComp = (1 - resi05*1.333333333333);

	// frequency
	sr = samplerate;
	f = 0.5/sr * 0.333333333333333;                     // 3x
	ff = f+f;
	rf1 = sr+sr;
	rf2 = rf1+rf1;
	rfc2 = rf*c2;
	rfc2c3 = rf*c2c3;
	r1rf = 1/(1 + r1/rf);
	ac3c1 = a*c3/c1;

	// coefficients
	a1 = 1/(c1*rf);
	a2 = -(1/rf + 1/r3)/c1;
	b1 = 1/rfc2;
	bm2 = resist*0.8101 + 0.1899;
	bm22 = bm2*bm2;
	rfbm22 = rfc2c3*bm22;
	b2a = -2/rfc2;
	b2b = (ac3c1 - 1 - r1rf)/rfbm22;
	b2 = interp(thong, b2a, b2b, mode="linear");
	b3a = b1;
	b3b = (r1rf - (1 + rf/r3)*ac3c1)/rfbm22;
	b3 = interp(thong, b3a, b3b, mode="cosine");
	b4 = c3/c2;
	d1 = a;

	// intermediates
	Dx = 1/(1 - b2*f);
	Do = 1/(1 - a2*f);
	fb3d = f*b3*Do;
	fb4 = b4*f;
	rf1d1 = rf1*d1;

    // pass 1

	// solve nonlinear
	xb10 = b1*x0;
	tanh_xo0  = nonlin(xo0*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo20 = 1 - tanh_xo0*tanh_xo0;
	d1rthx0 = d1*rtanh_xo20;
	rtanh_mo20 = tanh_xo0 - xo0*rtanh_xo20;
	d1rthm0 = d1*rtanh_mo20;
	Dmas0 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx0*Do*a1 - b4));
	rf1d1rth0 = rf1*d1rthm0;

	// compute integrators
	yx0 = (sx + f*xb10 + fb3d*so + fb4*(sd + rf1d1rth0) + b4*d1rthx0*Do*so)*Dx*Dmas0;
	a1yx0 = a1*yx0;
	yo0 = (so + f*a1yx0)*Do;
	d1rthyx0 = d1rthx0*yo0 - yx0;
	yd0 = (sd + rf1d1rth0) + rf1*d1rthyx0;

	// update state
	sx +=   ff*(xb10 + b2*yx0 + b3*yo0 + b4*yd0);
	so +=   ff*(a1yx0 + a2*yo0);
	sd  = -(sd + rf2*d1rthm0) - rf2*d1rthyx0;
	xo0 =   yo0;

    // pass 2

	// solve nonlinear
	xb11 = b1*x1;
	tanh_xo1  = nonlin(xo1*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo21 = 1 - tanh_xo1*tanh_xo1;
	d1rthx1 = d1*rtanh_xo21;
	rtanh_mo21 = tanh_xo1 - xo1*rtanh_xo21;
	d1rthm1 = d1*rtanh_mo21;
	Dmas1 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx1*Do*a1 - b4));
	rf1d1rth1 = rf1*d1rthm1;

	// compute integrators
	yx1 = (sx + f*xb11 + fb3d*so + fb4*(sd + rf1d1rth1) + b4*d1rthx1*Do*so)*Dx*Dmas1;
	a1yx1 = a1*yx1;
	yo1 = (so + f*a1yx1)*Do;
	d1rthyx1 = d1rthx1*yo1 - yx1;
	yd1 = (sd + rf1d1rth1) + rf1*d1rthyx1;

	// update state
	sx +=   ff*(xb11 + b2*yx1 + b3*yo1 + b4*yd1);
	so +=   ff*(a1yx1 + a2*yo1);
	sd  = -(sd + rf2*d1rthm1) - rf2*d1rthyx1;
	xo1 =   yo1;

    // pass 3

	// solve nonlinear
	xb12 = b1*x2;
	tanh_xo2  = nonlin(xo2*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo22 = 1 - tanh_xo2*tanh_xo2;
	d1rthx2 = d1*rtanh_xo22;
	rtanh_mo22 = tanh_xo2 - xo2*rtanh_xo22;
	d1rthm2 = d1*rtanh_mo22;
	Dmas2 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx2*Do*a1 - b4));
	rf1d1rth2 = rf1*d1rthm2;

	// compute integrators
	yx2 = (sx + f*xb12 + fb3d*so + fb4*(sd + rf1d1rth2) + b4*d1rthx2*Do*so)*Dx*Dmas2;
	a1yx2 = a1*yx2;
	yo2 = (so + f*a1yx2)*Do;
	d1rthyx2 = d1rthx2*yo2 - yx2;
	yd2 = (sd + rf1d1rth2) + rf1*d1rthyx2;

	// update state
	sx +=   ff*(xb12 + b2*yx2 + b3*yo2 + b4*yd2);
	so +=   ff*(a1yx2 + a2*yo2);
	sd  = -(sd + rf2*d1rthm2) - rf2*d1rthyx2;
	xo2 =   yo2;

	return	yo0*resiComp, yo1*resiComp, yo2*resiComp;
}

buchlaLpg4(x0, x1, x2, x3, rf, res, resist, vcamode, lpgmode, nl)
{
	History	so(0), sx(0), sd(0);
	History	xo0(0), xo1(0), xo2(0), xo3(0);
	thing = 1 - (nl * (1 - sqrt1_2));
	thong = resist * (1 - nl); 

	// constants
	c1 = 0.000000001;
	c2 = 0.00000000022;
	c3 = lpgmode*0.0000000047;
	c2c3 = c2+c3;

	r1 = 1000;
	r3 = (1 - vcamode)*5000000 + 10000;

	// resonance / feedback
	max_res = ((c1+c1)*r3 + c2c3*(r3+rf)) / (c3*r3);
	a = minimum(res, max_res) * thing;
	resi05 = resist*0.5;
	resiComp = (1 - resi05*1.333333333333);

	// frequency
	sr = samplerate;
	f = 0.5/sr * 0.25;                                  // 4x
	ff = f+f;
	rf1 = sr+sr;
	rf2 = rf1+rf1;
	rfc2 = rf*c2;
	rfc2c3 = rf*c2c3;
	r1rf = 1/(1 + r1/rf);
	ac3c1 = a*c3/c1;

	// coefficients
	a1 = 1/(c1*rf);
	a2 = -(1/rf + 1/r3)/c1;
	b1 = 1/rfc2;
	bm2 = resist*0.8101 + 0.1899;
	bm22 = bm2*bm2;
	rfbm22 = rfc2c3*bm22;
	b2a = -2/rfc2;
	b2b = (ac3c1 - 1 - r1rf)/rfbm22;
	b2 = interp(thong, b2a, b2b, mode="linear");
	b3a = b1;
	b3b = (r1rf - (1 + rf/r3)*ac3c1)/rfbm22;
	b3 = interp(thong, b3a, b3b, mode="cosine");
	b4 = c3/c2;
	d1 = a;

	// intermediates
	Dx = 1/(1 - b2*f);
	Do = 1/(1 - a2*f);
	fb3d = f*b3*Do;
	fb4 = b4*f;
	rf1d1 = rf1*d1;

    // pass 1

	// solve nonlinear
	xb10 = b1*x0;
	tanh_xo0  = nonlin(xo0*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo20 = 1 - tanh_xo0*tanh_xo0;
	d1rthx0 = d1*rtanh_xo20;
	rtanh_mo20 = tanh_xo0 - xo0*rtanh_xo20;
	d1rthm0 = d1*rtanh_mo20;
	Dmas0 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx0*Do*a1 - b4));
	rf1d1rth0 = rf1*d1rthm0;

	// compute integrators
	yx0 = (sx + f*xb10 + fb3d*so + fb4*(sd + rf1d1rth0) + b4*d1rthx0*Do*so)*Dx*Dmas0;
	a1yx0 = a1*yx0;
	yo0 = (so + f*a1yx0)*Do;
	d1rthyx0 = d1rthx0*yo0 - yx0;
	yd0 = (sd + rf1d1rth0) + rf1*d1rthyx0;

	// update state
	sx +=   ff*(xb10 + b2*yx0 + b3*yo0 + b4*yd0);
	so +=   ff*(a1yx0 + a2*yo0);
	sd  = -(sd + rf2*d1rthm0) - rf2*d1rthyx0;
	xo0 =   yo0;

    // pass 2

	// solve nonlinear
	xb11 = b1*x1;
	tanh_xo1  = nonlin(xo1*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo21 = 1 - tanh_xo1*tanh_xo1;
	d1rthx1 = d1*rtanh_xo21;
	rtanh_mo21 = tanh_xo1 - xo1*rtanh_xo21;
	d1rthm1 = d1*rtanh_mo21;
	Dmas1 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx1*Do*a1 - b4));
	rf1d1rth1 = rf1*d1rthm1;

	// compute integrators
	yx1 = (sx + f*xb11 + fb3d*so + fb4*(sd + rf1d1rth1) + b4*d1rthx1*Do*so)*Dx*Dmas1;
	a1yx1 = a1*yx1;
	yo1 = (so + f*a1yx1)*Do;
	d1rthyx1 = d1rthx1*yo1 - yx1;
	yd1 = (sd + rf1d1rth1) + rf1*d1rthyx1;

	// update state
	sx +=   ff*(xb11 + b2*yx1 + b3*yo1 + b4*yd1);
	so +=   ff*(a1yx1 + a2*yo1);
	sd  = -(sd + rf2*d1rthm1) - rf2*d1rthyx1;
	xo1 =   yo1;

    // pass 3

	// solve nonlinear
	xb12 = b1*x2;
	tanh_xo2  = nonlin(xo2*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo22 = 1 - tanh_xo2*tanh_xo2;
	d1rthx2 = d1*rtanh_xo22;
	rtanh_mo22 = tanh_xo2 - xo2*rtanh_xo22;
	d1rthm2 = d1*rtanh_mo22;
	Dmas2 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx2*Do*a1 - b4));
	rf1d1rth2 = rf1*d1rthm2;

	// compute integrators
	yx2 = (sx + f*xb12 + fb3d*so + fb4*(sd + rf1d1rth2) + b4*d1rthx2*Do*so)*Dx*Dmas2;
	a1yx2 = a1*yx2;
	yo2 = (so + f*a1yx2)*Do;
	d1rthyx2 = d1rthx2*yo2 - yx2;
	yd2 = (sd + rf1d1rth2) + rf1*d1rthyx2;

	// update state
	sx +=   ff*(xb12 + b2*yx2 + b3*yo2 + b4*yd2);
	so +=   ff*(a1yx2 + a2*yo2);
	sd  = -(sd + rf2*d1rthm2) - rf2*d1rthyx2;
	xo2 =   yo2;

    // pass 4

	// solve nonlinear
	xb13 = b1*x3;
	tanh_xo3  = nonlin(xo3*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo23 = 1 - tanh_xo3*tanh_xo3;
	d1rthx3 = d1*rtanh_xo23;
	rtanh_mo23 = tanh_xo3 - xo3*rtanh_xo23;
	d1rthm3 = d1*rtanh_mo23;
	Dmas3 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx3*Do*a1 - b4));
	rf1d1rth3 = rf1*d1rthm3;

	// compute integrators
	yx3 = (sx + f*xb13 + fb3d*so + fb4*(sd + rf1d1rth3) + b4*d1rthx3*Do*so)*Dx*Dmas3;
	a1yx3 = a1*yx3;
	yo3 = (so + f*a1yx3)*Do;
	d1rthyx3 = d1rthx3*yo3 - yx3;
	yd3 = (sd + rf1d1rth3) + rf1*d1rthyx3;

	// update state
	sx +=   ff*(xb13 + b2*yx3 + b3*yo3 + b4*yd3);
	so +=   ff*(a1yx3 + a2*yo3);
	sd  = -(sd + rf2*d1rthm3) - rf2*d1rthyx3;
	xo3 =   yo3;

	return	yo0*resiComp, yo1*resiComp, yo2*resiComp, yo3*resiComp;
}

buchlaLpg6(x0, x1, x2, x3, x4, x5, rf, res, resist, vcamode, lpgmode, nl)
{
	History	so(0), sx(0), sd(0);
	History	xo0(0), xo1(0), xo2(0), xo3(0), xo4(0), xo5(0);
	thing = 1 - (nl * (1 - sqrt1_2));
	thong = resist * (1 - nl); 

	// constants
	c1 = 0.000000001;
	c2 = 0.00000000022;
	c3 = lpgmode*0.0000000047;
	c2c3 = c2+c3;

	r1 = 1000;
	r3 = (1 - vcamode)*5000000 + 10000;

	// resonance / feedback
	max_res = ((c1+c1)*r3 + c2c3*(r3+rf)) / (c3*r3);
	a = minimum(res, max_res) * thing;
	resi05 = resist*0.5;
	resiComp = (1 - resi05*1.333333333333);

	// frequency
	sr = samplerate;
	f = 0.5/sr * 0.166666666666667;                     // 6x
	ff = f+f;
	rf1 = sr+sr;
	rf2 = rf1+rf1;
	rfc2 = rf*c2;
	rfc2c3 = rf*c2c3;
	r1rf = 1/(1 + r1/rf);
	ac3c1 = a*c3/c1;

	// coefficients
	a1 = 1/(c1*rf);
	a2 = -(1/rf + 1/r3)/c1;
	b1 = 1/rfc2;
	bm2 = resist*0.8101 + 0.1899;
	bm22 = bm2*bm2;
	rfbm22 = rfc2c3*bm22;
	b2a = -2/rfc2;
	b2b = (ac3c1 - 1 - r1rf)/rfbm22;
	b2 = interp(thong, b2a, b2b, mode="linear");
	b3a = b1;
	b3b = (r1rf - (1 + rf/r3)*ac3c1)/rfbm22;
	b3 = interp(thong, b3a, b3b, mode="cosine");
	b4 = c3/c2;
	d1 = a;

	// intermediates
	Dx = 1/(1 - b2*f);
	Do = 1/(1 - a2*f);
	fb3d = f*b3*Do;
	fb4 = b4*f;
	rf1d1 = rf1*d1;

    // pass 1

	// solve nonlinear
	xb10 = b1*x0;
	tanh_xo0  = nonlin(xo0*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo20 = 1 - tanh_xo0*tanh_xo0;
	d1rthx0 = d1*rtanh_xo20;
	rtanh_mo20 = tanh_xo0 - xo0*rtanh_xo20;
	d1rthm0 = d1*rtanh_mo20;
	Dmas0 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx0*Do*a1 - b4));
	rf1d1rth0 = rf1*d1rthm0;

	// compute integrators
	yx0 = (sx + f*xb10 + fb3d*so + fb4*(sd + rf1d1rth0) + b4*d1rthx0*Do*so)*Dx*Dmas0;
	a1yx0 = a1*yx0;
	yo0 = (so + f*a1yx0)*Do;
	d1rthyx0 = d1rthx0*yo0 - yx0;
	yd0 = (sd + rf1d1rth0) + rf1*d1rthyx0;

	// update state
	sx +=   ff*(xb10 + b2*yx0 + b3*yo0 + b4*yd0);
	so +=   ff*(a1yx0 + a2*yo0);
	sd  = -(sd + rf2*d1rthm0) - rf2*d1rthyx0;
	xo0 =   yo0;

    // pass 2

	// solve nonlinear
	xb11 = b1*x1;
	tanh_xo1  = nonlin(xo1*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo21 = 1 - tanh_xo1*tanh_xo1;
	d1rthx1 = d1*rtanh_xo21;
	rtanh_mo21 = tanh_xo1 - xo1*rtanh_xo21;
	d1rthm1 = d1*rtanh_mo21;
	Dmas1 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx1*Do*a1 - b4));
	rf1d1rth1 = rf1*d1rthm1;

	// compute integrators
	yx1 = (sx + f*xb11 + fb3d*so + fb4*(sd + rf1d1rth1) + b4*d1rthx1*Do*so)*Dx*Dmas1;
	a1yx1 = a1*yx1;
	yo1 = (so + f*a1yx1)*Do;
	d1rthyx1 = d1rthx1*yo1 - yx1;
	yd1 = (sd + rf1d1rth1) + rf1*d1rthyx1;

	// update state
	sx +=   ff*(xb11 + b2*yx1 + b3*yo1 + b4*yd1);
	so +=   ff*(a1yx1 + a2*yo1);
	sd  = -(sd + rf2*d1rthm1) - rf2*d1rthyx1;
	xo1 =   yo1;

    // pass 3

	// solve nonlinear
	xb12 = b1*x2;
	tanh_xo2  = nonlin(xo2*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo22 = 1 - tanh_xo2*tanh_xo2;
	d1rthx2 = d1*rtanh_xo22;
	rtanh_mo22 = tanh_xo2 - xo2*rtanh_xo22;
	d1rthm2 = d1*rtanh_mo22;
	Dmas2 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx2*Do*a1 - b4));
	rf1d1rth2 = rf1*d1rthm2;

	// compute integrators
	yx2 = (sx + f*xb12 + fb3d*so + fb4*(sd + rf1d1rth2) + b4*d1rthx2*Do*so)*Dx*Dmas2;
	a1yx2 = a1*yx2;
	yo2 = (so + f*a1yx2)*Do;
	d1rthyx2 = d1rthx2*yo2 - yx2;
	yd2 = (sd + rf1d1rth2) + rf1*d1rthyx2;

	// update state
	sx +=   ff*(xb12 + b2*yx2 + b3*yo2 + b4*yd2);
	so +=   ff*(a1yx2 + a2*yo2);
	sd  = -(sd + rf2*d1rthm2) - rf2*d1rthyx2;
	xo2 =   yo2;

    // pass 4

	// solve nonlinear
	xb13 = b1*x3;
	tanh_xo3  = nonlin(xo3*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo23 = 1 - tanh_xo3*tanh_xo3;
	d1rthx3 = d1*rtanh_xo23;
	rtanh_mo23 = tanh_xo3 - xo3*rtanh_xo23;
	d1rthm3 = d1*rtanh_mo23;
	Dmas3 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx3*Do*a1 - b4));
	rf1d1rth3 = rf1*d1rthm3;

	// compute integrators
	yx3 = (sx + f*xb13 + fb3d*so + fb4*(sd + rf1d1rth3) + b4*d1rthx3*Do*so)*Dx*Dmas3;
	a1yx3 = a1*yx3;
	yo3 = (so + f*a1yx3)*Do;
	d1rthyx3 = d1rthx3*yo3 - yx3;
	yd3 = (sd + rf1d1rth3) + rf1*d1rthyx3;

	// update state
	sx +=   ff*(xb13 + b2*yx3 + b3*yo3 + b4*yd3);
	so +=   ff*(a1yx3 + a2*yo3);
	sd  = -(sd + rf2*d1rthm3) - rf2*d1rthyx3;
	xo3 =   yo3;

    // pass 5

	// solve nonlinear
	xb14 = b1*x4;
	tanh_xo4  = nonlin(xo4*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo24 = 1 - tanh_xo4*tanh_xo4;
	d1rthx4 = d1*rtanh_xo24;
	rtanh_mo24 = tanh_xo4 - xo4*rtanh_xo24;
	d1rthm4 = d1*rtanh_mo24;
	Dmas4 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx4*Do*a1 - b4));
	rf1d1rth4 = rf1*d1rthm4;

	// compute integrators
	yx4 = (sx + f*xb14 + fb3d*so + fb4*(sd + rf1d1rth4) + b4*d1rthx4*Do*so)*Dx*Dmas4;
	a1yx4 = a1*yx4;
	yo4 = (so + f*a1yx4)*Do;
	d1rthyx4 = d1rthx4*yo4 - yx4;
	yd4 = (sd + rf1d1rth4) + rf1*d1rthyx4;

	// update state
	sx +=   ff*(xb14 + b2*yx4 + b3*yo4 + b4*yd4);
	so +=   ff*(a1yx4 + a2*yo4);
	sd  = -(sd + rf2*d1rthm4) - rf2*d1rthyx4;
	xo4 =   yo4;

    // pass 6

	// solve nonlinear
	xb15 = b1*x5;
	tanh_xo5  = nonlin(xo5*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo25 = 1 - tanh_xo5*tanh_xo5;
	d1rthx5 = d1*rtanh_xo25;
	rtanh_mo25 = tanh_xo5 - xo5*rtanh_xo25;
	d1rthm5 = d1*rtanh_mo25;
	Dmas5 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx5*Do*a1 - b4));
	rf1d1rth5 = rf1*d1rthm5;

	// compute integrators
	yx5 = (sx + f*xb15 + fb3d*so + fb4*(sd + rf1d1rth5) + b4*d1rthx5*Do*so)*Dx*Dmas5;
	a1yx5 = a1*yx5;
	yo5 = (so + f*a1yx5)*Do;
	d1rthyx5 = d1rthx5*yo5 - yx5;
	yd5 = (sd + rf1d1rth5) + rf1*d1rthyx5;

	// update state
	sx +=   ff*(xb15 + b2*yx5 + b3*yo5 + b4*yd5);
	so +=   ff*(a1yx5 + a2*yo5);
	sd  = -(sd + rf2*d1rthm5) - rf2*d1rthyx5;
	xo5 =   yo5;

	return	yo0*resiComp, yo1*resiComp, yo2*resiComp, yo3*resiComp, yo4*resiComp, yo5*resiComp;
}

buchlaLpg8(x0, x1, x2, x3, x4, x5, x6, x7, rf, res, resist, vcamode, lpgmode, nl)
{
	History	so(0), sx(0), sd(0);
	History	xo0(0), xo1(0), xo2(0), xo3(0), xo4(0), xo5(0), xo6(0), xo7(0);
	thing = 1 - (nl * (1 - sqrt1_2));
	thong = resist * (1 - nl); 

	// constants
	c1 = 0.000000001;
	c2 = 0.00000000022;
	c3 = lpgmode*0.0000000047;
	c2c3 = c2+c3;

	r1 = 1000;
	r3 = (1 - vcamode)*5000000 + 10000;

	// resonance / feedback
	max_res = ((c1+c1)*r3 + c2c3*(r3+rf)) / (c3*r3);
	a = minimum(res, max_res) * thing;
	resi05 = resist*0.5;
	resiComp = (1 - resi05*1.333333333333);

	// frequency
	sr = samplerate;
	f = 0.5/sr * 0.125;                                 // 8x
	ff = f+f;
	rf1 = sr+sr;
	rf2 = rf1+rf1;
	rfc2 = rf*c2;
	rfc2c3 = rf*c2c3;
	r1rf = 1/(1 + r1/rf);
	ac3c1 = a*c3/c1;

	// coefficients
	a1 = 1/(c1*rf);
	a2 = -(1/rf + 1/r3)/c1;
	b1 = 1/rfc2;
	bm2 = resist*0.8101 + 0.1899;
	bm22 = bm2*bm2;
	rfbm22 = rfc2c3*bm22;
	b2a = -2/rfc2;
	b2b = (ac3c1 - 1 - r1rf)/rfbm22;
	b2 = interp(thong, b2a, b2b, mode="linear");
	b3a = b1;
	b3b = (r1rf - (1 + rf/r3)*ac3c1)/rfbm22;
	b3 = interp(thong, b3a, b3b, mode="cosine");
	b4 = c3/c2;
	d1 = a;

	// intermediates
	Dx = 1/(1 - b2*f);
	Do = 1/(1 - a2*f);
	fb3d = f*b3*Do;
	fb4 = b4*f;
	rf1d1 = rf1*d1;

    // pass 1

	// solve nonlinear
	xb10 = b1*x0;
	tanh_xo0  = nonlin(xo0*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo20 = 1 - tanh_xo0*tanh_xo0;
	d1rthx0 = d1*rtanh_xo20;
	rtanh_mo20 = tanh_xo0 - xo0*rtanh_xo20;
	d1rthm0 = d1*rtanh_mo20;
	Dmas0 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx0*Do*a1 - b4));
	rf1d1rth0 = rf1*d1rthm0;

	// compute integrators
	yx0 = (sx + f*xb10 + fb3d*so + fb4*(sd + rf1d1rth0) + b4*d1rthx0*Do*so)*Dx*Dmas0;
	a1yx0 = a1*yx0;
	yo0 = (so + f*a1yx0)*Do;
	d1rthyx0 = d1rthx0*yo0 - yx0;
	yd0 = (sd + rf1d1rth0) + rf1*d1rthyx0;

	// update state
	sx +=   ff*(xb10 + b2*yx0 + b3*yo0 + b4*yd0);
	so +=   ff*(a1yx0 + a2*yo0);
	sd  = -(sd + rf2*d1rthm0) - rf2*d1rthyx0;
	xo0 =   yo0;

    // pass 2

	// solve nonlinear
	xb11 = b1*x1;
	tanh_xo1  = nonlin(xo1*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo21 = 1 - tanh_xo1*tanh_xo1;
	d1rthx1 = d1*rtanh_xo21;
	rtanh_mo21 = tanh_xo1 - xo1*rtanh_xo21;
	d1rthm1 = d1*rtanh_mo21;
	Dmas1 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx1*Do*a1 - b4));
	rf1d1rth1 = rf1*d1rthm1;

	// compute integrators
	yx1 = (sx + f*xb11 + fb3d*so + fb4*(sd + rf1d1rth1) + b4*d1rthx1*Do*so)*Dx*Dmas1;
	a1yx1 = a1*yx1;
	yo1 = (so + f*a1yx1)*Do;
	d1rthyx1 = d1rthx1*yo1 - yx1;
	yd1 = (sd + rf1d1rth1) + rf1*d1rthyx1;

	// update state
	sx +=   ff*(xb11 + b2*yx1 + b3*yo1 + b4*yd1);
	so +=   ff*(a1yx1 + a2*yo1);
	sd  = -(sd + rf2*d1rthm1) - rf2*d1rthyx1;
	xo1 =   yo1;

    // pass 3

	// solve nonlinear
	xb12 = b1*x2;
	tanh_xo2  = nonlin(xo2*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo22 = 1 - tanh_xo2*tanh_xo2;
	d1rthx2 = d1*rtanh_xo22;
	rtanh_mo22 = tanh_xo2 - xo2*rtanh_xo22;
	d1rthm2 = d1*rtanh_mo22;
	Dmas2 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx2*Do*a1 - b4));
	rf1d1rth2 = rf1*d1rthm2;

	// compute integrators
	yx2 = (sx + f*xb12 + fb3d*so + fb4*(sd + rf1d1rth2) + b4*d1rthx2*Do*so)*Dx*Dmas2;
	a1yx2 = a1*yx2;
	yo2 = (so + f*a1yx2)*Do;
	d1rthyx2 = d1rthx2*yo2 - yx2;
	yd2 = (sd + rf1d1rth2) + rf1*d1rthyx2;

	// update state
	sx +=   ff*(xb12 + b2*yx2 + b3*yo2 + b4*yd2);
	so +=   ff*(a1yx2 + a2*yo2);
	sd  = -(sd + rf2*d1rthm2) - rf2*d1rthyx2;
	xo2 =   yo2;

    // pass 4

	// solve nonlinear
	xb13 = b1*x3;
	tanh_xo3  = nonlin(xo3*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo23 = 1 - tanh_xo3*tanh_xo3;
	d1rthx3 = d1*rtanh_xo23;
	rtanh_mo23 = tanh_xo3 - xo3*rtanh_xo23;
	d1rthm3 = d1*rtanh_mo23;
	Dmas3 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx3*Do*a1 - b4));
	rf1d1rth3 = rf1*d1rthm3;

	// compute integrators
	yx3 = (sx + f*xb13 + fb3d*so + fb4*(sd + rf1d1rth3) + b4*d1rthx3*Do*so)*Dx*Dmas3;
	a1yx3 = a1*yx3;
	yo3 = (so + f*a1yx3)*Do;
	d1rthyx3 = d1rthx3*yo3 - yx3;
	yd3 = (sd + rf1d1rth3) + rf1*d1rthyx3;

	// update state
	sx +=   ff*(xb13 + b2*yx3 + b3*yo3 + b4*yd3);
	so +=   ff*(a1yx3 + a2*yo3);
	sd  = -(sd + rf2*d1rthm3) - rf2*d1rthyx3;
	xo3 =   yo3;

    // pass 5

	// solve nonlinear
	xb14 = b1*x4;
	tanh_xo4  = nonlin(xo4*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo24 = 1 - tanh_xo4*tanh_xo4;
	d1rthx4 = d1*rtanh_xo24;
	rtanh_mo24 = tanh_xo4 - xo4*rtanh_xo24;
	d1rthm4 = d1*rtanh_mo24;
	Dmas4 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx4*Do*a1 - b4));
	rf1d1rth4 = rf1*d1rthm4;

	// compute integrators
	yx4 = (sx + f*xb14 + fb3d*so + fb4*(sd + rf1d1rth4) + b4*d1rthx4*Do*so)*Dx*Dmas4;
	a1yx4 = a1*yx4;
	yo4 = (so + f*a1yx4)*Do;
	d1rthyx4 = d1rthx4*yo4 - yx4;
	yd4 = (sd + rf1d1rth4) + rf1*d1rthyx4;

	// update state
	sx +=   ff*(xb14 + b2*yx4 + b3*yo4 + b4*yd4);
	so +=   ff*(a1yx4 + a2*yo4);
	sd  = -(sd + rf2*d1rthm4) - rf2*d1rthyx4;
	xo4 =   yo4;

    // pass 6

	// solve nonlinear
	xb15 = b1*x5;
	tanh_xo5  = nonlin(xo5*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo25 = 1 - tanh_xo5*tanh_xo5;
	d1rthx5 = d1*rtanh_xo25;
	rtanh_mo25 = tanh_xo5 - xo5*rtanh_xo25;
	d1rthm5 = d1*rtanh_mo25;
	Dmas5 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx5*Do*a1 - b4));
	rf1d1rth5 = rf1*d1rthm5;

	// compute integrators
	yx5 = (sx + f*xb15 + fb3d*so + fb4*(sd + rf1d1rth5) + b4*d1rthx5*Do*so)*Dx*Dmas5;
	a1yx5 = a1*yx5;
	yo5 = (so + f*a1yx5)*Do;
	d1rthyx5 = d1rthx5*yo5 - yx5;
	yd5 = (sd + rf1d1rth5) + rf1*d1rthyx5;

	// update state
	sx +=   ff*(xb15 + b2*yx5 + b3*yo5 + b4*yd5);
	so +=   ff*(a1yx5 + a2*yo5);
	sd  = -(sd + rf2*d1rthm5) - rf2*d1rthyx5;
	xo5 =   yo5;

    // pass 7

	// solve nonlinear
	xb16 = b1*x6;
	tanh_xo6  = nonlin(xo6*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo26 = 1 - tanh_xo6*tanh_xo6;
	d1rthx6 = d1*rtanh_xo26;
	rtanh_mo26 = tanh_xo6 - xo6*rtanh_xo26;
	d1rthm6 = d1*rtanh_mo26;
	Dmas6 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx6*Do*a1 - b4));
	rf1d1rth6 = rf1*d1rthm6;

	// compute integrators
	yx6 = (sx + f*xb16 + fb3d*so + fb4*(sd + rf1d1rth6) + b4*d1rthx6*Do*so)*Dx*Dmas6;
	a1yx6 = a1*yx6;
	yo6 = (so + f*a1yx6)*Do;
	d1rthyx6 = d1rthx6*yo6 - yx6;
	yd6 = (sd + rf1d1rth6) + rf1*d1rthyx6;

	// update state
	sx +=   ff*(xb16 + b2*yx6 + b3*yo6 + b4*yd6);
	so +=   ff*(a1yx6 + a2*yo6);
	sd  = -(sd + rf2*d1rthm6) - rf2*d1rthyx6;
	xo6 =   yo6;

    // pass 8

	// solve nonlinear
	xb17 = b1*x7;
	tanh_xo7  = nonlin(xo7*(1 - (resi05*0.333333333333)), nl);
	rtanh_xo27 = 1 - tanh_xo7*tanh_xo7;
	d1rthx7 = d1*rtanh_xo27;
	rtanh_mo27 = tanh_xo7 - xo7*rtanh_xo27;
	d1rthm7 = d1*rtanh_mo27;
	Dmas7 = 1/(1 - Dx*(f*fb3d*a1 + fb4*d1rthx7*Do*a1 - b4));
	rf1d1rth7 = rf1*d1rthm7;

	// compute integrators
	yx7 = (sx + f*xb17 + fb3d*so + fb4*(sd + rf1d1rth7) + b4*d1rthx7*Do*so)*Dx*Dmas7;
	a1yx7 = a1*yx7;
	yo7 = (so + f*a1yx7)*Do;
	d1rthyx7 = d1rthx7*yo7 - yx7;
	yd7 = (sd + rf1d1rth7) + rf1*d1rthyx7;

	// update state
	sx +=   ff*(xb17 + b2*yx7 + b3*yo7 + b4*yd7);
	so +=   ff*(a1yx7 + a2*yo7);
	sd  = -(sd + rf2*d1rthm7) - rf2*d1rthyx7;
	xo7 =   yo7;

	return	yo0*resiComp, yo1*resiComp, yo2*resiComp, yo3*resiComp, yo4*resiComp, yo5*resiComp, yo6*resiComp, yo7*resiComp;
}

// fixed 2x quasi oversampling (cubic4)
buchlaLpg2_2x(XIN, rf, res, resist, vcamode, lpgmode, nl)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 2x
	y1_0, y2_0	= buchlaLpg2(x1_0, x2_0, rf, res, resist, vcamode, lpgmode, nl);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}

// fixed 3x quasi oversampling (cubic4)
buchlaLpg3_3x(XIN, rf, res, resist, vcamode, lpgmode, nl)
{	// up 3
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// up 3x
	x0_0_a	= XIN + 0;
	x1_0	= umT0_0 + 0;	// my instinct says this should be umT1_0 ??
	x2_0	= cubic_hermite_interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0	= cubic_hermite_interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a);

	// process 3x
	y1_0, y2_0, y3_0	= buchlaLpg3(x1_0, x2_0, x3_0, rf, res, resist, vcamode, lpgmode, nl);

	// down 3x
	y2_0_a	= y2_0 + 0;		// WAIT !! TDT / ODT WRONG WAY ROUND ?!
	y2_1	= cubic_hermite_interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);
	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

    // this seems the wrong way to sum to me
	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return y0_0;
}

// fixed 4x quasi oversampling (cubic4)
buchlaLpg4_4x(XIN, rf, res, resist, vcamode, lpgmode, nl)
{	// up 4
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// up 4x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.25,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= cubic_hermite_interp(0.5,	    umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0	= cubic_hermite_interp(0.75,	umTm1_0, umT0_0, umT1_0, x0_0_a);

	// process 4x
	y1_0, y2_0, y3_0, y4_0	= buchlaLpg4(x1_0, x2_0, x3_0, (umT1_0 + 0), rf, res, resist, vcamode, lpgmode, nl);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(0.5,	    y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3);

    // this seems the wrong way to sum to me
	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return y0_0;
}

// fixed 6x quasi oversampling (cubic4)
buchlaLpg6_6x(XIN, rf, res, resist, vcamode, lpgmode, nl)
{	// up 6
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 6
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	History	dmT2_4(0), dmT1_4(0), dmT0_4(0);
	History	dmT2_5(0), dmT1_5(0), dmT0_5(0);
	// align
	History	doX0(0);

    ODS = 0.166666666666667;
    ODT = 0.333333333333333;
    TDT = 0.666666666666667;
    ODW = 0.833333333333333;

	// up 6x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(ODS,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= cubic_hermite_interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x4_0	= cubic_hermite_interp(TDT,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x5_0	= cubic_hermite_interp(ODW,	umTm1_0, umT0_0, umT1_0, x0_0_a);

	// process 6x
	y1_0, y2_0, y3_0, y4_0, y5_0, y6_0	
        = buchlaLpg6(x1_0, x2_0, x3_0, x4_0, x5_0, (umT1_0 + 0), rf, res, resist, vcamode, lpgmode, nl);

	// down 6x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(ODS,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(ODT, y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.5,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3);

	y5_0_a	= y5_0 + 0;
	y5_1	= cubic_hermite_interp(TDT,	y5_0_a,	dmT0_4, dmT1_4, dmT2_4);

	y6_0_a	= y6_0 + 0;
	y6_1	= cubic_hermite_interp(ODW,	y6_0_a,	dmT0_5, dmT1_5, dmT2_5);

    // this seems the wrong way to sum to me
	y0_0	= (((((doX0 + y2_1) + y3_1) + y4_1) + y5_1) + y6_1) * ODS;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	dmT2_4	= dmT1_4;
	dmT1_4	= dmT0_4;
	dmT0_4	= y5_0;

	dmT2_5	= dmT1_5;
	dmT1_5	= dmT0_5;
	dmT0_5	= y6_0;

	return y0_0;
}

// fixed 8x quasi oversampling (cubic4)
buchlaLpg8_8x(XIN, rf, res, resist, vcamode, lpgmode, nl)
{	// up 8
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 8
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	History	dmT2_4(0), dmT1_4(0), dmT0_4(0);
	History	dmT2_5(0), dmT1_5(0), dmT0_5(0);
	History	dmT2_6(0), dmT1_6(0), dmT0_6(0);
	History	dmT2_7(0), dmT1_7(0), dmT0_7(0);
	// align
	History	doX0(0);

	// up 8x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.125,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= cubic_hermite_interp(0.25,    umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0	= cubic_hermite_interp(0.375,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x4_0	= cubic_hermite_interp(0.5,	    umTm1_0, umT0_0, umT1_0, x0_0_a);
	x5_0	= cubic_hermite_interp(0.625,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x6_0	= cubic_hermite_interp(0.75,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x7_0	= cubic_hermite_interp(0.875,	umTm1_0, umT0_0, umT1_0, x0_0_a);

	// process 8x
	y1_0, y2_0, y3_0, y4_0, y5_0, y6_0, y7_0, y8_0	
        = buchlaLpg8(x1_0, x2_0, x3_0, x4_0, x5_0, x6_0, x7_0, (umT1_0 + 0), rf, res, resist, vcamode, lpgmode, nl);

	// down 8x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.125,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(0.25,    y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.375,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3);

	y5_0_a	= y5_0 + 0;
	y5_1	= cubic_hermite_interp(0.5,	    y5_0_a,	dmT0_4, dmT1_4, dmT2_4);

	y6_0_a	= y6_0 + 0;
	y6_1	= cubic_hermite_interp(0.625,	y6_0_a,	dmT0_5, dmT1_5, dmT2_5);

	y7_0_a	= y7_0 + 0;
	y7_1	= cubic_hermite_interp(0.75,	y7_0_a,	dmT0_6, dmT1_6, dmT2_6);

	y8_0_a	= y8_0 + 0;
	y8_1	= cubic_hermite_interp(0.875,	y8_0_a,	dmT0_7, dmT1_7, dmT2_7);

    // this seems the wrong way to sum to me
	y0_0	= (((((((doX0 + y2_1) + y3_1) + y4_1) + y5_1) + y6_1) + y7_1) + y8_1) * 0.125;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	dmT2_4	= dmT1_4;
	dmT1_4	= dmT0_4;
	dmT0_4	= y5_0;

	dmT2_5	= dmT1_5;
	dmT1_5	= dmT0_5;
	dmT0_5	= y6_0;

	dmT2_6	= dmT1_6;
	dmT1_6	= dmT0_6;
	dmT0_6	= y7_0;

	dmT2_7	= dmT1_7;
	dmT1_7	= dmT0_7;
	dmT0_7	= y8_0;

	return y0_0;
}

