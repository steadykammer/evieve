
// common functions for the [evi.overdrive.*] abstractions (& evi_*wrap.gendsp's)

tanA(x)                             // cheaper approx tan(0..1)
{
	x2      = (x * x);
	x3      = (x2 * x);
	x5      = (x2 * x3);
	return   ((x5 * 0.133333333333) + (x3 * 0.333333333333)) + x;
}

rcPreWarp(cutoff)
{
	g0		=  tanA(PI * cutoff / SAMPLERATE);
	return	g0 / (1 + g0);
}

// fixed mode=0 version, no branching, keep out of while loop in export
rcDampCoeffs0(cutoff, damp)			// cutoff in Hz, damp must clamp 0..1 (1 = highpass/lowpass)
{
	g0		=  tanA(PI * cutoff / SAMPLERATE);	// prewarp
	ks		= (damp * 0.5) + 0.5;	// damp 0..1 = sqrt..lin
	ks05	= (ks - 0.5);
	ksom	= ((1 - ks) + 0.5) - 0.5;
	g01		=  1 + g0;
	g1 		=  g0 / interp((ks05 + ks05), sqrt(g01), g01, mode="linear");
	d1		= interp((ksom + ksom), sqrt(damp), damp, mode="linear");
	return	g1, d1;					// rc filter warped cf (g)	// rc filter warped gain (k)
}

// High or Low Pass if k == 1, Bypass if k == 0, else Low or High Shelf attenuation
rcFilterDampHpLp(Vin, g, k)
{
	History	   s(0);
	Lp		= (g * Vin + s) / (g + 1);
	s		= (Lp + Lp) - s;
	return	(k * Lp) - Vin, Vin + (k * (Lp - Vin)); // HP , LP
}

eviLog1p(value)   // :-(
{
  if (value > -1.0e-8 && value < 1.0e-8)
	return value - (value * value) * 0.5;

  return log(1 + value);
}

hermite_sixpoint_interp(f0, ym2, ym1, y0, y1, y2, y3)
{
  f1    =  f0 - 0.5;
  even1 = ym2 + y3;
  odd1  = ym2 - y3;
  even2 = ym1 + y2;
  odd2  = ym1 - y2;
  even3 =  y0 + y1;
  odd3  =  y0 - y1;

  c0  = 0.01171875*even1    - 0.09765625*even2    + 0.5859375*even3;
  c1  = 0.2109375*odd2    - 1.463541666667*odd3 - 0.033854166667*odd1;
  c2  = 0.40625*even2     - 0.354166666667*even3  - 0.052083333333*even1;
  c3  = 0.1875*odd1     - 1.104166666667*odd2 + 2.375*odd3;
  c4  = 0.020833333333*even1  - 0.0625*even2      + 0.041666666667*even3;
  c5  = 1.041666666667*odd2 - 2.083333333333*odd3 - 0.208333333333*odd1;

  return ((((c5*f1 + c4)*f1 + c3)*f1 + c2)*f1 + c1)*f1 + c0;
}

expA(x0)							// more accurate than 'fastexp()'
{
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;
	x *= x; x *= x; x *= x; x *= x; x *= x;
	return x;
}

tauA(t)								// t is time in seconds
{
	y = expA(-1 / (t * samplerate));
	return y + 0.000128;
}

expso(x, z)							// z is pole
{
	History w(0);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expsmoothBank3(x1, x2, x3, t)
{
	History	expsdummy3(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	return	y1, y2, y3;
}

logsmooth(x, s)                     // s = time to drop 6dB (in seconds)
{
	History z(0);
//  ad = LN2 / maximum((s * samplerate), 1);
	ad = LN2 / (s * samplerate);
	y  = ((x - z) * ad) + z;
	z  = y;
	return y;
}

//

expApprox(x)
{
  x = 1 + (0.062500309 + (0.0019527233 + (0.0000408663 + (0.00000060184965 + 0.000000010856791*x)*x)*x)*x)*x;
  x *= x; x *= x; x *= x;
  return x*x;
}

pow2Approx(y) // approx pow(2, y)
{
  return expApprox(y * LN2);
}

coshApprox(x)
{
  return 0.5 * (expApprox(x) + expApprox(-x));
}

log2Approx(x) // sorry
{
  return (-0.2119568027628040757e-1 + (-0.38815224340108325886 + (-0.8900051141728954376 + (0.4001641794691007527
	  + (0.79615191430677253059 + 0.10303694407435362078*x)*x)*x)*x)*x) /
		(0.298115002929551095e-2 + (0.1066700361116609290 + (0.6070463053447878628 + (0.8584931203106122717
		  + (0.30170842595823793523 + 0.16863931436090069014e-1*x)*x)*x)*x)*x);
}

logApprox(x)
{
  return LN2 * log2Approx(x);
}

log10Approx(x)
{
  return 0.3010299956639811 * log2Approx(x); // log10(2)*log2(x)
}

log1pApprox(x)
{
  if (x > -1.0e-8 && x < 1.0e-8)
	return x - (x * x) * 0.5;

  return logApprox(1 + x);
}

// works for waveshapers too :-)
decorelate(x)
{
	History	z1(0);
	y = 1.371308261611209 * x + z1;
	z1 = 0.08785458027104826 * x - 0.45916284188226 * y;
	return y;
}

//

/**
 * Li2() ::
 * @brief Real dilogarithm mathrm{Li}_2(x)
 * @param x real argument
 * @return mathrm{Li}_2(x)
 * @author Alexander Voigt
 * @license GPL v3
 * 
 * Implemented as an economized Pade approximation with a
 * maximum error of 4.16e-18 <<-- definitely worse with pete's implementation :-)
 */
Li2Approx(x) // this is really stupid in gen~, & N.B. - cannot use Approxes in negative branches
{
	MPIPI6	= -1.6449340668482264;	// -PI*PI/6
	MPIPI12	= -0.8224670334241132;	// -PI*PI/12
	PIPI6	=  1.6449340668482264;	//  PI*PI/6
	PIPI3	=  3.289868133696453;	//  PI*PI/3

	li1 = 0;
	horner = 0;
	y = 0;
	r = 0;
	s = 1;

	// transform to [0, 1/2)
	if (x < -1) {
		omx = 1 - x;
		l = log(omx); // must be log()
		y = 1/omx;
		r = MPIPI6 + l*(0.5*l - log(-x)); // must be log()
		s = 1;
		horner = 1;
	} else if (x == -1) {
		li1 = MPIPI12;
		horner = 0;
	} else if (x < 0) {
		l = eviLog1p(-x); // must be log()
		y = x/(x - 1);
		r = -0.5*l*l;
		s = -1;
		horner = 1;
	} else if (x == 0) {
		li1 = 0;
		horner = 0;
	} else if (x < 0.5) {
		y = x;
		r = 0;
		s = 1;
		horner = 1;
	} else if (x < 1) {
		omx = 1 - x;
		y = omx;
		r = PIPI6 - logApprox(x)*logApprox(omx);
		s = -1;
		horner = 1;
	} else if (x == 1) {
		li1 = PIPI6;
		horner = 0;
	} else if (x < 2) {
		omodx = 1 - 1/x;
		l = logApprox(x);
		y = omodx;
		r = PIPI6 - l*(logApprox(omodx) + 0.5*l);
		s = 1;
		horner = 1;
	} else {
		l = logApprox(x);
		y = 1/x;
		r = PIPI3 - 0.5*l*l;
		s = -1;
		horner = 1;
	}

	z = y - 0.25;

	// unroll horner because gen~, sorry :-(

	p = -2.4630612614645039828e-4;
	p = p*z +  3.1608910440687221695e-2;
	p = p*z + -4.6937565143754629578e-1;
	p = p*z +  2.4733515209909815443;
	p = p*z + -6.0516124315132409155;
	p = p*z +  7.4819657596286408905;
	p = p*z + -4.5353562730201404017;
	p = p*z +  1.0706105563309304277;

	q = -3.2116618742475189569e-3;
	q = q*z +  9.8554565816757007266e-2;
	q = q*z + -8.9936784740041174897e-1;
	q = q*z +  3.6245392503925290187;
	q = q*z + -7.4634190853767468810;
	q = q*z +  8.1790029773247428573;
	q = q*z + -4.5355682121856044935;
	q = q*z +  1.0000000000000000000;

	li2 = r + s*y*p/q;

	return horner ? li2 : li1;
}

// these are the antiderivatives of the approximation, not of a real tanh - that is crucial !
// sadly we still end up with a bloody Li2 in the 2nd order :-(

// note: this tanh approx becomes not-tanh-like above about +22dB input gain (wave folds)
// note: the entire approx is -6dB down, but we boost it on input before adaa to match tanh()

altTanhF0(x)
{
	// not one of the better tanh() approxes, but the antiderivatives are more manageable
	// than many of the others, swings and roundabouts
	ex = (-1 / (expApprox(x) + 1));
	return ex + ex + 1;
}

altTanhF1(x)
{
	lex = log(exp(x) + 1); // not exp- or log- Approx() !
	return lex + lex - x;
}

altTanhF2(x)
{
	li2ex = Li2Approx(-exp(x)); // not expApprox() !
	return -(li2ex + li2ex + li2ex + li2ex + x*x) * 0.5;
}

altTanhAdaa1(x0, reset)
{
	History x1(0), s1(0);
	eps = 0.000001;	// TODO, precision
	if (reset) {
		x1 = 0; s1 = 0;
	}

	y1 = x0;
	d0 = x0 - x1;
	s0 = altTanhF1(x0);	// func1
	if ((x1 == 0 && s1 == 0) || (abs(d0) < eps)) {	// ill condition
		y1 = altTanhF0(0.5 * (x0 + x1));	// func0
	} else {
		y1 = (s0 - s1) / d0;
	}

	s1 = s0;
	x1 = x0;
	return y1;
}

altTanhAdaa2(x0, reset)
{
	History x1(0), x2(0), s1(0);
	eps = 0.000001;	// TODO, precision
	if (reset) {
		x1 = 0; x2 = 0; s1 = 0;
	}

	s0 = x0;
	d0 = x0 - x1;
	f2_x1 = altTanhF2(x1);	// func2
	if (abs(d0) < eps) {	// ill condition
		s0 = altTanhF1(0.5 * (x0 + x1));	// func1
	} else {
		s0 = (altTanhF2(x0) - f2_x1) / d0;	// func2
	}

	y1 = x0;
	d1 = x0 - x2;
	if (x1 == 0 && x2 == 0) {	// ill condition
		y1 = altTanhF0(x0 + (x1 + x1) + x2) * 0.25;	// func0
	} else if (abs(d1) < eps) {	// ill condition
		x_bar = 0.5 * (x0 + x2);
		x_delta = x_bar - x1;
		if (x_delta < eps) {	// ill condition
			y1 = altTanhF0((x_bar + x1) * 0.5);	// func0
		} else {
			y1 = (2 / x_delta) * (altTanhF1(x_bar) + (f2_x1 - altTanhF2(x_bar)) / x_delta);	// func1, func2
		}
	} else {
		s0s1 = s0 - s1;
		y1 = (s0s1 + s0s1) / d1;
	}

	s1 = s0;
	x2 = x1;
	x1 = x0;
	return y1;
}

// altTanhAdaa1 oversampling...

// fixed 2x quasi oversampling (hermite6)
altTanhAdaa1_2x_6POINT(XIN, reset)
{	// up 2
	History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History doX0(0);

	// up 2x
	x0_0_a  = XIN + 0;
	x1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0  = umT2_0 + 0;

	// process 2x
	y1_0  = altTanhAdaa1(x1_0, reset);
	y2_0  = altTanhAdaa1(x2_0, reset);

	// down 2x
	y2_0_a  = y2_0 + 0;
	y2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0  = (doX0 + y2_1) * 0.5;

	// update
	umTm2_0 = umTm1_0;
	umTm1_0 = umT0_0;
	umT0_0  = umT1_0;
	umT1_0  = umT2_0;
	umT2_0  = x0_0_a;

	doX0  = y1_0;

	dmT3_1  = dmT2_1;
	dmT2_1  = dmT1_1;
	dmT1_1  = dmT0_1;
	dmT0_1  = dmTm1_1;
	dmTm1_1 = y2_0;

	return dcblock(y0_0);
}

// fixed 4x quasi oversampling (hermite6)
altTanhAdaa1_4x_6POINT(XIN, reset)
{	// up 2
	History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History doX0(0);

	// up 2x
	x0_0_a  = XIN + 0;
	x1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0  = umT2_0 + 0;

	// process 2x
	y1_0  = altTanhAdaa1_2x_6POINT(x1_0, reset);
	y2_0  = altTanhAdaa1_2x_6POINT(x2_0, reset);

	// down 2x
	y2_0_a  = y2_0 + 0;
	y2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0  = (doX0 + y2_1) * 0.5;

	// update
	umTm2_0 = umTm1_0;
	umTm1_0 = umT0_0;
	umT0_0  = umT1_0;
	umT1_0  = umT2_0;
	umT2_0  = x0_0_a;

	doX0  = y1_0;

	dmT3_1  = dmT2_1;
	dmT2_1  = dmT1_1;
	dmT1_1  = dmT0_1;
	dmT0_1  = dmTm1_1;
	dmTm1_1 = y2_0;

	return dcblock(y0_0);
}

