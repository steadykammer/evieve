//	//	//	Self contained linear SVF filters with coefficients calculators
//	//	//	For use in place of biquads, including EQ-ing, when you actually need good quality :-)

//  //  //  Because Gen does not cache require files, the evieve SVFs are
//  //  //  separated out into smaller require files: those required below


//	//	//	TPT (Topology Preserving Transform, Zavalishin et al)
//	//	//	This linear core is also used as the basis for many of the nonlinear filters in evieve
//	//	//	This is also used in the linear [evi.svf~] replacement & [evi.multimode~]
require("evi_svfs_tpt.genexpr");

//	//	//	LTO (Linear Trapezoidal Optimised, Simper)
//	//	//	Alternative version, in practice we use these for EQ-ing, 'TPT' for individual filters
require("evi_svfs_lto.genexpr");

//	//	//	individual filter sections using TPT
require("evi_svfs_tpt_filters.genexpr");

//	//	//	different all-in-one sections (Simper)
require("evi_svfs_lto_extras.genexpr");

