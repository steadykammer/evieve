
// non-oscillator sources, etc

// @see: "sparseVelvetNoise()" for an alternative algorithm ("sparseNoise")
audioDust(freq)
{
	clockThresh	= 1 - (freq * (1 / (SAMPLERATE * 0.5)));
	Xoshiro	= noise();
	sync	= Xoshiro > clockThresh;
	white	= noise();

	dust	= sync * white;
	return	dust, white, sync;
}

// sort of based on: Matti Karjalainen and Hanna Jarvelainen, "Reverberation Modeling
// Using Velvet Noise", in Proc. 30th Int. Conf. Intelligent
// Audio Environments (AES07), March 2007.
// Pete: my porting of this algorithm is a bit stupid with the phasor(), I do not
// like it, @see: "audioDust()" for different algorithm (compared to "sparseNoise"),
// but if you need velvet noise in evieve, this is it
sparseVelvetNoise(freq, mix, amp=1)
{
	History		prevClock(0), prevXos(0);

	Xoshiro256	=  noise();
	clock		=  phasor(freq);
	latchRandom	= (latch(Xoshiro256, (clock - prevClock)) * 0.5) + 0.5;

	sparseNoise	= prevXos * ((clock >= latchRandom) * (prevClock < latchRandom));
	prevClock	= clock;
	prevXos		= Xoshiro256;

	velvetNoise	= (sign(sparseNoise) * amp);
	mixNoise	= interp(mix, sparseNoise, velvetNoise, mode="cosine");

	return		mixNoise, sparseNoise, velvetNoise;
}

// not-really box-muller gaussian noise distribution estimation, thanks to Andy Farnell
// default (gain 0.6403882032022076) gives very close to unity amplitude (-1..1) output
gaussianNoise(gain)
{
	Xoshiro256	= noise();
	cosXos		= cycle(noise(), index="phase");
	// can we get rid of this log() please ?
	gaussian 	= sqrt(log((abs(Xoshiro256) * gain) + (1 - gain)) * -2) * (cosXos * LN2);
	return		gaussian, Xoshiro256, cosXos;
}

// basically from the RNBO operator, with additions
likeZerox(x, windowSize=0, threshold=0.1)
{
	History	count(0), index(0);
	History	lastSign(0), lastCount(0);
	History	lastWindowSize(64);

	if ((windowSize > 1) && (windowSize != lastWindowSize)) {
		count = 0;
		index = 0;
		lastSign = 0;
		lastWindowSize = int(windowSize);
		lastCount = 0;
	}

	currentSign = x < 0;
	crossing = change(currentSign);
	if (currentSign != lastSign) {
		count += 1;
	}
	lastSign = int(currentSign);
	index += 1;

	if (index >= lastWindowSize) {
		lastCount = int(count);
		count = 0;
		index = 0;
	}
	voiced = (lastCount / lastWindowSize) > threshold;

	return lastCount, voiced, crossing;
}

// basically from the gen~ example, with additions
simpleZerox(x, threshold=0.1)
{
	History	period(0);

	currentSign = x < 0;			// detect zero crossing...
	crossing = change(currentSign);	// ...& report sign

	periodAccum = period + 1;		// increment period counter
	periodCount = latch(periodAccum, crossing);
	voiced = (periodCount / vectorsize) > threshold; // fixed
	// zero counter on zero crossing
	period = periodAccum * (crossing == 0);

	return periodCount, voiced, crossing;			 // -voiced ?
}

// like [rand~] (linear)
// very predictable and gives exact notches
eviRand(p) {										// phasor input, not frequency
	History prev(0);
	rr = (delta(p)) < 0;                            // assumes positive freq only
	a  = latch(prev, rr);
	n  = noise();
	b  = latch(n, rr);
	nv = mix(a, b, p);								// interp(p, a, b, mode="cosine") for more fun
	prev = b;
	return nv, n;
}

eviRandN(p, n) {									// phasor input not frequency, and external noise source
	History prev(0);
	rr = (delta(p)) < 0;                            // assumes positive freq only
	a  = latch(prev, rr);
	b  = latch(n, rr);
	nv = mix(a, b, p);								// interp(p, a, b, mode="cosine") for more fun
	prev = b;
	return nv;
}

// like [rand~] but ready for cubic interpolation
eviRands(d0, x2)									// delta input, not frequency; x2 is source
{
	History	xm1(0), x0(0), x1(0);
	vm1	= latch(xm1, d0);
	v0	= latch(x0,  d0);
	v1	= latch(x1,  d0);
	v2	= latch(x2,  d0);
	xm1	= v0;
	x0	= v1;
	x1	= v2;
	return	vm1, v0, v1, v2;						// 4 values for 4-point interpolator
}

// like [rand~] but cubic interpolated
// rolls off much faster than eviRand()
eviRandy(p)											// phasor input, not frequency
{
	History randy(0);
	d = (delta(p)) < 0;                            	// assumes positive freq only
	n = noise();
    ym1, y0, y1, y2 = eviRands(d, n * sqrt1_2);
    r = interp(p, ym1, y0, y1, y2, mode="fastcubic");// & "cubic" does not work for eviRandy() anyway
    return r, n;
}

eviRandyN(p, n)										// phasor input not frequency, and external noise source
{
	History randyn(0);
	d = (delta(p)) < 0;                            	// assumes positive freq only
    ym1, y0, y1, y2 = eviRands(d, n * sqrt1_2);
    r = interp(p, ym1, y0, y1, y2, mode="fastcubic");// & "cubic" does not work for eviRandy() anyway
    return r;
}

// Catmull-Rom Spline Bias Tension	// 13 muls, 22 ±
catmullRomSplineDynamic(f, y0, y1, y2, y3, bias, tension)
{
	f2		=  f * f;
	f3		=  f * f2;
	f6		=  f2 + f2 + f2;
	y2my1	=  y2 - y1;

	bp		= (1 + bias);
	bm		= (1 - bias);
	mt		= (1 - tension) * 0.5;
	m0		= ((y1 - y0) * bp +   y2my1   * bm) * mt;
	m1		= (y2my1   * bp + (y3 - y2) * bm) * mt;

	c0		=  (f3 + f3) -  f6 + 1;
   	c1		=		 f3  - (f2 + f2) + f;
   	c2		=		 f3  -  f2;
   	c3		= -(f3 + f3) +  f6;

   	return	(c0 * y1) + (c1 * m0) + (c2 * m1) + (c3 * y2);
}

// a very (and needlessly) expensive random LFO
eviRandLfo(hz, skew, reset)		// skew must be clamped -1..1
{
	p	= phasor(hz, reset);
	d	= delta(p) < 0;			// assumes positive freq only
	x	= noise();

	bias = skew * 4;
	tension = skew * -3;
	attenuate = fastpow(7, abs(skew));

	ym1, y0, y1, y2	= eviRands(d, x);
	dynamicAtten = catmullRomSplineDynamic(p, ym1, y0, y1, y2, bias, tension) * 0.834251;

	return 	(dynamicAtten / attenuate), x;
}

