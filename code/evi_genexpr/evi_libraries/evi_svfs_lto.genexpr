
//  //  //  For all evieve TPT SVF filters require "evi_svfs.genexpr".
//  //  //  Because Gen does not cache require files, the evieve SVFs are
//  //  //  separated out into smaller require files such as this one

require("evi_smooth.genexpr");	// includes 'evi_utilities.genexpr' & 'evi_approx.genexpr'
require("evi_svfs_filters.genexpr");    // all raw filters in here

//	//	//	LTO (Linear Trapezoidal Optimised, Simper)
//	//	//	Alternative version, in practice we use these for EQ-ing, 'TPT' for individual filters


/*
	Calculators ("filter" parameter is integer index - sorry, that is gen~)

	Index	Filter

	0 		Bypass
	1 		Lowpass
	2 		Highpass
	3 		Bandpass
	4 		Peak
	5 		Notch
	6 		Resonant
	7 		Allpass
	8 		Bell
	9 		BellAdaptiveQ
	10 		Lowshelf
	11 		Highshelf
*/
// make a1, a2, a3 & summing gains
// look how simple this is compared to Direct Form !
svfSectionCoeff(filter, cutoff, gain, fullQ)	// gain is Linear !
{
	a1, a2, a3		= 0;						// coefficients
	m0, m1, m2		= 0;						// mixing gains

	highQ 	= maximum(fullQ, 0.05);
	Q 		= minimum(highQ, 20);
	g		= tanA2(PI * cutoff / SAMPLERATE);
	k 		= sqrt2;

	if ((filter > 0) && (filter < 8)) {

//		A	= expA(0.11512925464970 * gain) + 0.000128;	// dBtoA, if gain was in dB
		A 	= maximum(gain, 0.001);

		if (filter == 6) {						// RESONANT (BANDPASS) (accepts much higher 'Q')
			k	=  1 / highQ;
			a1	=  1 / (1 + g * (g + k));
			a2	=  g * a1;
			a3	=  g * a2;

				m0	=  0;
				m1	=  k * A;
				m2	=  0;

		} else {

			k	= 1 / Q;						// generic 'adaptive Q' would go here ...
			a1	= 1 / (1 + g * (g + k));
			a2	= g * a1;
			a3	= g * a2;

			if				(filter == 1) {		// LOWPASS
				m0	=  0;
				m1	=  0;
				m2	=  A;
			} else if		(filter == 2) {		// HIGHPASS
				m0	=  A;
				m1	= -k * A;
				m2	= -A;
			} else if		(filter == 3) {		// BANDPASS (CLASSIC)
				m0	=  0;
				m1	=  A;
				m2	=  0;
			} else if		(filter == 4) {		// PEAK
				m0	=  A;
				m1	= -k * A;
				m2	= -2 * A;
			} else if		(filter == 5) {		// NOTCH
				m0	=  A;
				m1	= -k * A;
				m2	=  0;
			} else {	//	(filter == 7) {		// ALLPASS (normalised) (BROKEN)
				m0	=  1;
				m1	= -k;
				m2	=  1;
			}

		}

	} else if ((filter >= 8) && (filter <= 11)) {

//		A	= fastpow(10, (gain * 0.025)) + 0.028652;	// if gain was in dB, instead of below
		G 	= maximum(gain, 0.001);
		A 	= sqrt(G);
		AA	= A * A;

		if				(filter == 8) {			// BELL
			k	= 1 / (Q * A);
			a1	= 1 / (1 + g * (g + k));
			a2	= g * a1;
			a3	= g * a2;

			m0	= 1;
			m1	= k * (AA - 1);
			m2	= 0;

		} else if 		(filter == 9) {			// BELL_ADAPTIVE_Q
			vA	= (G >= 1) ? (G) : (1 / G);
			vQ	= Q * sqrt(vA);
			k	= 1 / (vQ * A);
			a1	= 1 / (1 + g * (g + k));
			a2	= g * a1;
			a3	= g * a2;

			m0	= 1;
			m1	= k * (AA - 1);
			m2	= 0;

		} else {	//	(filter == 10 || 11)

			sA	= sqrt(A);
			k	= 1 / Q;

			if			(filter == 10) {		// LOWSHELF
				g	= g / sA;
				a1	= 1 / (1 + g * (g + k));
				a2	= g * a1;
				a3	= g * a2;

				m0	= 1;
				m1	= k * (A - 1);
				m2	= AA - 1;

			} else { //	(filter == 11)			// HIGHSELF

				g	= g * sA;
				a1	= 1 / (1 + g * (g + k));
				a2	= g * a1;
				a3	= g * a2;

				m0	= AA;
				m1	= k * (1 - A) * A;
				m2	= 1 - AA;
			}

		}

	} else {	//		(filter <= 0 || >= 12)	// BYPASS
		a1, a2, a3	= 0;
		m1, m2		= 0;
		m0			= 1;
	}

	return	a1, a2, a3, m0, m1, m2;
}

// version for gen no tilde, because Max, must pass in samplerate
svfSectionCoeffNoTilde(filter, cutoff, gain, fullQ, AUDIO_SR=48000)	// gain is Linear !
{
	a1, a2, a3		= 0;						// coefficients
	m0, m1, m2		= 0;						// mixing gains

	highQ 	= maximum(fullQ, 0.05);
	Q 		= minimum(highQ, 20);
	g		= tanA2(PI * cutoff / AUDIO_SR);
	k 		= sqrt2;

	if ((filter > 0) && (filter < 8)) {

//		A	= expA(0.11512925464970 * gain) + 0.000128;	// dBtoA, if gain was in dB
		A 	= maximum(gain, 0.001);

		if (filter == 6) {						// RESONANT (BANDPASS) (accepts much higher 'Q')
			k	=  1 / highQ;
			a1	=  1 / (1 + g * (g + k));
			a2	=  g * a1;
			a3	=  g * a2;

				m0	=  0;
				m1	=  k * A;
				m2	=  0;

		} else {

			k	= 1 / Q;						// generic 'adaptive Q' would go here ...
			a1	= 1 / (1 + g * (g + k));
			a2	= g * a1;
			a3	= g * a2;

			if				(filter == 1) {		// LOWPASS
				m0	=  0;
				m1	=  0;
				m2	=  A;
			} else if		(filter == 2) {		// HIGHPASS
				m0	=  A;
				m1	= -k * A;
				m2	= -A;
			} else if		(filter == 3) {		// BANDPASS (CLASSIC)
				m0	=  0;
				m1	=  A;
				m2	=  0;
			} else if		(filter == 4) {		// PEAK
				m0	=  A;
				m1	= -k * A;
				m2	= -2 * A;
			} else if		(filter == 5) {		// NOTCH
				m0	=  A;
				m1	= -k * A;
				m2	=  0;
			} else {	//	(filter == 7) {		// ALLPASS (normalised) (BROKEN)
				m0	=  1;
				m1	= -k;
				m2	=  1;
			}

		}

	} else if ((filter >= 8) && (filter <= 11)) {

//		A	= fastpow(10, (gain * 0.025)) + 0.028652;	// if gain was in dB, instead of below
		G 	= maximum(gain, 0.001);
		A 	= sqrt(G);
		AA	= A * A;

		if				(filter == 8) {			// BELL
			k	= 1 / (Q * A);
			a1	= 1 / (1 + g * (g + k));
			a2	= g * a1;
			a3	= g * a2;

			m0	= 1;
			m1	= k * (AA - 1);
			m2	= 0;

		} else if 		(filter == 9) {			// BELL_ADAPTIVE_Q
			vA	= (G >= 1) ? (G) : (1 / G);
			vQ	= Q * sqrt(vA);
			k	= 1 / (vQ * A);
			a1	= 1 / (1 + g * (g + k));
			a2	= g * a1;
			a3	= g * a2;

			m0	= 1;
			m1	= k * (AA - 1);
			m2	= 0;

		} else {	//	(filter == 10 || 11)

			sA	= sqrt(A);
			k	= 1 / Q;

			if			(filter == 10) {		// LOWSHELF
				g	= g / sA;
				a1	= 1 / (1 + g * (g + k));
				a2	= g * a1;
				a3	= g * a2;

				m0	= 1;
				m1	= k * (A - 1);
				m2	= AA - 1;

			} else { //	(filter == 11)			// HIGHSELF

				g	= g * sA;
				a1	= 1 / (1 + g * (g + k));
				a2	= g * a1;
				a3	= g * a2;

				m0	= AA;
				m1	= k * (1 - A) * A;
				m2	= 1 - AA;
			}

		}

	} else {	//		(filter <= 0 || >= 12)	// BYPASS
		a1, a2, a3	= 0;
		m1, m2		= 0;
		m0			= 1;
	}

	return	a1, a2, a3, m0, m1, m2;
}

// all in one section for use in gen~/GenExpr
eviFilterLto(x, cutoff, db, Q, filter, smooth=0)	// gain in dB, smooth time in ms
{
	History efldummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	a1, a2, a3, m0, m1, m2	= svfSectionCoeff(filter, cutoff, gain, Q);
	if (smooth > 0) {
		m0, m1, m2 			= expsmoothBank3(m0, m1, m2, smoothsecs);
	}
	filtered 	= svfSection(x, a1, a2, a3, m0, m1, m2);
	return 		filtered;
}

eviFilterLtoReset(x, cutoff, db, Q, filter, reset, smooth=0)	// gain in dB, smooth time in ms
{
	History eflrdummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	a1, a2, a3, m0, m1, m2	= svfSectionCoeff(filter, cutoff, gain, Q);
	if (smooth > 0) {
		m0, m1, m2 			= expsmoothBank3(m0, m1, m2, smoothsecs);
	}
	filtered 	= svfSectionReset(x, a1, a2, a3, m0, m1, m2, reset);
	return 		filtered;
}

/*
	EQ Calculators ("filter" parameter is integer index - sorry, that is gen~)

	Index	Filter

	0 		Bypass
	1 		Highpass
	2 		Lowshelf
	3 		Bell
	4 		BellAdaptiveQ
	5 		Notch
	6 		Highshelf
	7 		Lowpass
*/
// coefficients just for EQ-ing, note different ordering as well
svfSectionCoeffEq(filter, cutoff, gain, Q)		// gain is Linear !
{
	a1, a2, a3		= 0;						// coefficients
	m0, m1, m2		= 0;						// mixing gains

	g	= tanA2(PI * cutoff / SAMPLERATE);

	if				(filter == 1) {				// HIGHPASS
		A 	= maximum(gain, 0.001);
		k	= 1 / Q;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;
		
		m0	=  A;
		m1	= -k * A;
		m2	= -A;
	} else if		(filter == 2) {				// LOWSHELF
		A 	= sqrt(maximum(gain, 0.001));
		AA	= A * A;
		sA	= sqrt(A);
		k	= 1 / Q;
		g	= g / sA;

		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	= 1;
		m1	= k * (A - 1);
		m2	= AA - 1;
	} else if		(filter == 3) {				// BELL
		A 	= sqrt(maximum(gain, 0.001));
		AA	= A * A;
		k	= 1 / (Q * A);

		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	= 1;
		m1	= k * (AA - 1);
		m2	= 0;
	} else if		(filter == 4) {				// BELL_ADAPTIVE_Q
		G 	= maximum(gain, 0.001);
		A 	= sqrt(G);
		AA	= A * A;
		vA	= (G >= 1) ? (G) : (1 / G);
		vQ	= Q * sqrt(vA);
		k	= 1 / (vQ * A);

		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	= 1;
		m1	= k * (AA - 1);
		m2	= 0;
	} else if		(filter == 5) {				// NOTCH
		A 	= maximum(gain, 0.001);
		k	= 1 / Q;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	=  A;
		m1	= -k * A;
		m2	=  0;
	} else if 		(filter == 6) {				// HIGHSELF
		A 	= sqrt(maximum(gain, 0.001));
		AA	= A * A;
		sA	= sqrt(A);
		k	= 1 / Q;
		g	= g * sA;

		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	= AA;
		m1	= k * (1 - A) * A;
		m2	= 1 - AA;
	} else if		(filter == 7) {				// LOWPASS
		A 	= maximum(gain, 0.001);
		k	= 1 / Q;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	=  0;
		m1	=  0;
		m2	=  A;
	} else {	//	(filter <= 0 || >= 8)		// BYPASS
		a1, a2, a3	= 0;
		m1, m2		= 0;
		m0			= 1;
	}

	return	a1, a2, a3, m0, m1, m2;
}

// version for gen no tilde, because Max, must pass in samplerate
svfSectionCoeffEqNoTilde(filter, cutoff, gain, Q, AUDIO_SR=48000)	// gain is Linear !
{
	a1, a2, a3		= 0;						// coefficients
	m0, m1, m2		= 0;						// mixing gains

	g	= tanA2(PI * cutoff / AUDIO_SR);

	if				(filter == 1) {				// HIGHPASS
		A 	= maximum(gain, 0.001);
		k	= 1 / Q;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;
		
		m0	=  A;
		m1	= -k * A;
		m2	= -A;
	} else if		(filter == 2) {				// LOWSHELF
		A 	= sqrt(maximum(gain, 0.001));
		AA	= A * A;
		sA	= sqrt(A);
		k	= 1 / Q;
		g	= g / sA;

		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	= 1;
		m1	= k * (A - 1);
		m2	= AA - 1;
	} else if		(filter == 3) {				// BELL
		A 	= sqrt(maximum(gain, 0.001));
		AA	= A * A;
		k	= 1 / (Q * A);

		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	= 1;
		m1	= k * (AA - 1);
		m2	= 0;
	} else if		(filter == 4) {				// BELL_ADAPTIVE_Q
		G 	= maximum(gain, 0.001);
		A 	= sqrt(G);
		AA	= A * A;
		vA	= (G >= 1) ? (G) : (1 / G);
		vQ	= Q * sqrt(vA);
		k	= 1 / (vQ * A);

		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	= 1;
		m1	= k * (AA - 1);
		m2	= 0;
	} else if		(filter == 5) {				// NOTCH
		A 	= maximum(gain, 0.001);
		k	= 1 / Q;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	=  A;
		m1	= -k * A;
		m2	=  0;
	} else if 		(filter == 6) {				// HIGHSELF
		A 	= sqrt(maximum(gain, 0.001));
		AA	= A * A;
		sA	= sqrt(A);
		k	= 1 / Q;
		g	= g * sA;

		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	= AA;
		m1	= k * (1 - A) * A;
		m2	= 1 - AA;
	} else if		(filter == 7) {				// LOWPASS
		A 	= maximum(gain, 0.001);
		k	= 1 / Q;
		a1	= 1 / (1 + g * (g + k));
		a2	= g * a1;
		a3	= g * a2;

		m0	=  0;
		m1	=  0;
		m2	=  A;
	} else {	//	(filter <= 0 || >= 8)		// BYPASS
		a1, a2, a3	= 0;
		m1, m2		= 0;
		m0			= 1;
	}

	return	a1, a2, a3, m0, m1, m2;
}

//	//	//	all in one sections for using in parametric EQ-ing etc

eviFilterEq(x, cutoff, db, Q, filter, smooth=0)	// gain in dB, smooth time in ms)
{
	History 	efedummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	a1, a2, a3, m0, m1, m2	= svfSectionCoeffEq(filter, cutoff, gain, Q);
	if (smooth > 0) {
		m0, m1, m2 			= expsmoothBank3(m0, m1, m2, smoothsecs);
	}
	eq 			= svfSection(x, a1, a2, a3, m0, m1, m2);
	return 		eq;
}

eviFilterEqReset(x, cutoff, db, Q, filter, reset, smooth=0)	// gain in dB, smooth time in ms)
{
	History 	eferdummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	a1, a2, a3, m0, m1, m2	= svfSectionCoeffEq(filter, cutoff, gain, Q);
	if (smooth > 0) {
		m0, m1, m2 			= expsmoothBank3(m0, m1, m2, smoothsecs);
	}
	eq 			= svfSectionReset(x, a1, a2, a3, m0, m1, m2, reset);
	return 		eq;
}

// for 'eviFilterEq4()' "filter" must only be lowpass or highpass !
eviFilterEq4(x, cutoff, db, Q, filter, smooth=0)	// gain in dB, smooth time in ms)
{
	History 	efe4dummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	a11, a21, a31, m01, m11, m21	= svfSectionCoeffEq(filter, cutoff, gain, Q * 0.5);//0.666666);//sqrt2);
	a12, a22, a32, m02, m12, m22	= svfSectionCoeffEq(filter, cutoff, gain, Q * 0.25);//0.333333);//sqrt1_2);
	if (smooth > 0) {
		m01, m11, m21	= expsmoothBank3(m01, m11, m21, smoothsecs);
		m02, m12, m22	= expsmoothBank3(m02, m12, m22, smoothsecs);
	}
	eq1 		= svfSection(x, a11, a21, a31, m01, m11, m21);
	eq2 		= svfSection(eq1, a12, a22, a32, m02, m12, m22);
	return 		eq2;
}

// @see: "evi_eq5.gendsp" for basic example of wrapping the
// two and four pole sections into a single eq filter

eviFilterEq4Reset(x, cutoff, db, Q, filter, reset, smooth=0)	// gain in dB, smooth time in ms)
{
	History 	efe4rdummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	a11, a21, a31, m01, m11, m21	= svfSectionCoeffEq(filter, cutoff, gain, Q * 0.5);//0.666666);//sqrt2);
	a12, a22, a32, m02, m12, m22	= svfSectionCoeffEq(filter, cutoff, gain, Q * 0.25);//0.333333);//sqrt1_2);
	if (smooth > 0) {
		m01, m11, m21	= expsmoothBank3(m01, m11, m21, smoothsecs);
		m02, m12, m22	= expsmoothBank3(m02, m12, m22, smoothsecs);
	}
	eq1 		= svfSectionReset(x, a11, a21, a31, m01, m11, m21, reset);
	eq2 		= svfSectionReset(eq1, a12, a22, a32, m02, m12, m22, reset);
	return 		eq2;
}

eviFilterEqStereo(xL, xR, cutoff, db, Q, filter, smooth=0)	// gain in dB, smooth time in ms)
{
	History 	efesdummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	a1, a2, a3, m0, m1, m2	= svfSectionCoeffEq(filter, cutoff, gain, Q);
	if (smooth > 0) {
		m0, m1, m2 			= expsmoothBank3(m0, m1, m2, smoothsecs);
	}
	eqL			= svfSection(xL, a1, a2, a3, m0, m1, m2);
	eqR			= svfSection(xR, a1, a2, a3, m0, m1, m2);
	return 		eqL, eqR;
}

// for 'eviFilterEqStereo4()' "filter" must only be lowpass or highpass !
eviFilterEq4Stereo(xL, xR, cutoff, db, Q, filter, smooth=0)	// gain in dB, smooth time in ms)
{
	History 	efes4dummy(0);
	smoothsecs	= smooth * 0.001;
	gain 		= dbtoaApprox(db);
	a11, a21, a31, m01, m11, m21	= svfSectionCoeffEq(filter, cutoff, gain, Q * 0.5);//0.666666);//sqrt2);
	a12, a22, a32, m02, m12, m22	= svfSectionCoeffEq(filter, cutoff, gain, Q * 0.25);//0.333333);//sqrt1_2);
	if (smooth > 0) {
		m01, m11, m21	= expsmoothBank3(m01, m11, m21, smoothsecs);
		m02, m12, m22	= expsmoothBank3(m02, m12, m22, smoothsecs);
	}
	eq1L 		= svfSection(xL, a11, a21, a31, m01, m11, m21);
	eq1R 		= svfSection(xR, a11, a21, a31, m01, m11, m21);
	eq2L 		= svfSection(eq1L, a12, a22, a32, m02, m12, m22);
	eq2R 		= svfSection(eq1R, a12, a22, a32, m02, m12, m22);
	return 		eq2L, eq2R;
}

// raw svfSections, used in reverbs etc
// 0 dB gain input zeros cpu of gain filters (shelfs, bell),
// (if gain coefficients are smoothed, must be by exact ramps, not logs)
eviSvfTwoSections(band0, a11, a21, a31, m01, m11, m21, a12, a22, a32, m02, m12, m22)
{
	History	twosecsdummy(0);
	band1	= band0;
	if ( (m11 + m21) != 0 ) {
		band1	= svfSection(band0,	a11, a21, a31, m01, m11, m21);
	}
	band2	= band1;
	if ( (m12 + m22) != 0 ) {
		band2	= svfSection(band1,	a12, a22, a32, m02, m12, m22);
	}
	return	band2;
}

eviSvfTwoSectionsStereo(band0L, band0R, a11, a21, a31, m01, m11, m21, a12, a22, a32, m02, m12, m22)
{
	History	twosecstdummy(0);
	band1L	= band0L+0;
	band1R	= band0R+0;
	if ( (m11 + m21) != 0 ) {
		band1L, band1R	= svfSectionStereo(band0L+0, band0R+0,	a11, a21, a31, m01, m11, m21);
	}
	band2L	= band1L+0;
	band2R	= band1R+0;
	if ( (m12 + m22) != 0 ) {
		band2L, band2R	= svfSectionStereo(band1L+0, band1R+0,	a12, a22, a32, m02, m12, m22);
	}
	return	band2L, band2R;
}

eviParametric2(x, filter1, cutoff1, db1, Q1, filter2, cutoff2, db2, Q2, smooth=0)
{
	History ep2dummy(0);
	band1	= eviFilterEq(x, cutoff1, db1, Q1, filter1, smooth=smooth);
	band2	= eviFilterEq(band1, cutoff2, db2, Q2, filter2, smooth=smooth);
	return 	band2;
}

eviParametric3(x, filter1, cutoff1, db1, Q1, filter2, cutoff2, db2, Q2, filter3, cutoff3, db3, Q3, smooth=0)
{
	History ep3dummy(0);
	band1	= eviFilterEq(x,		cutoff1, db1, Q1, filter1, smooth=smooth);
	band2	= eviFilterEq(band1,	cutoff2, db2, Q2, filter2, smooth=smooth);
	band3	= eviFilterEq(band2,	cutoff3, db3, Q3, filter3, smooth=smooth);
	return 	band3;
}

eviParametricStereo2(xL, xR, filter1, cutoff1, db1, Q1, filter2, cutoff2, db2, Q2, smooth=0)
{
	History eps2dummy(0);
	band1L, band1R	= eviFilterEqStereo(xL, xR, cutoff1, db1, Q1, filter1, smooth=smooth);
	band2L, band2R	= eviFilterEqStereo(band1L, band1R, cutoff2, db2, Q2, filter2, smooth=smooth);
	return 	band2L, band2R;
}

eviParametricStereo3(xL, xR, filter1, cutoff1, db1, Q1, filter2, cutoff2, db2, Q2, filter3, cutoff3, db3, Q3, smooth=0)
{
	History eps3dummy(0);
	band1L, band1R	= eviFilterEqStereo(xL,		xR,		cutoff1, db1, Q1, filter1, smooth=smooth);
	band2L, band2R	= eviFilterEqStereo(band1L, band1R,	cutoff2, db2, Q2, filter2, smooth=smooth);
	band3L, band3R	= eviFilterEqStereo(band2L, band2R,	cutoff3, db3, Q3, filter3, smooth=smooth);
	return 	band3L, band3R;
}

// ...note, we have reached the limit of args to a GenExpr function
// ...for higher order EQ-ing, build from 'eviFilterEq()' etc, inline.
// e.g. @see: "evi_eq5.gendsp" & "evi_eq8.gendsp" for basic examples

