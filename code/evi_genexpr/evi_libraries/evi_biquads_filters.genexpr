//  //  //  Because Gen does not cache require files, the evieve Biquads are
//  //  //  separated out into smaller require files, such as this one
//  //  //  @see: 'evi_biquads.genexpr' for all code required together

//	//	//	Part 3: Biquad Filters

// "Direct form 1", like MSP [biquad~]
// do not use this
biquadDf1(x, a0, a1, a2, b1, b2)
{
	History x1(0), x2(0), y1(0), y2(0);

	a0w = x * a0;
	a1w = x1 * a1;
	a2w = x2 * a2;
	w = a0w + a1w + a2w;

	b1y = y1 * b1;
	b2y = y2 * b2;
	y = w - b1y - b2y;

	x2 = x1;
	x1 = x;
	y2 = y1;
	y1 = y;

	return y;
}

biquadDf1reset(x, a0, a1, a2, b1, b2, reset)
{
	History x1(0), x2(0), y1(0), y2(0);
	if (reset) {
		x1 = 0;
		x2 = 0;
		y1 = 0;
		y2 = 0;
	}

	a0w = x * a0;
	a1w = x1 * a1;
	a2w = x2 * a2;
	w = a0w + a1w + a2w;

	b1y = y1 * b1;
	b2y = y2 * b2;
	y = w - b1y - b2y;

	x2 = x1;
	x1 = x;
	y2 = y1;
	y1 = y;

	return y;
}

// "Direct form 2"
// use this
biquadDf2(x, a0, a1, a2, b1, b2)
{
	History x1(0), x2(0);

	b1w = x1 * b1;
	b2w = x2 * b2;
	w = x - b1w - b2w;

	a0w = w * a0;
	a1w = x1 * a1;
	a2w = x2 * a2;
	y = a0w + a1w + a2w;

	x2 = x1;
	x1 = w;

	return y;
}

biquadDf2reset(x, a0, a1, a2, b1, b2, reset)
{
	History x1(0), x2(0);
	if (reset) {
		x1 = 0;
		x2 = 0;
	}

	b1w = x1 * b1;
	b2w = x2 * b2;
	w = x - b1w - b2w;

	a0w = w * a0;
	a1w = x1 * a1;
	a2w = x2 * a2;
	y = a0w + a1w + a2w;

	x2 = x1;
	x1 = w;

	return y;
}

// "Transposed direct form 2"
// sometimes use this
biquadTdf2(x, a0, a1, a2, b1, b2)
{
	History x1(0), x2(0);

	y = (x * a0) + x2;

	x2 = ((x * a1) - (y * b1)) + x1;
	x1 = (x * a2) - (y * b2);

	return y;
}

biquadTdf2reset(x, a0, a1, a2, b1, b2, reset)
{
	History x1(0), x2(0);
	if (reset) {
		x1 = 0;
		x2 = 0;
	}

	y = (x * a0) + x2;

	x2 = ((x * a1) - (y * b1)) + x1;
	x1 = (x * a2) - (y * b2);

	return y;
}

// one pole one zero section for odd ordered cascades
polezeroDf1(x, a0, _a1, _a2, b1, _b2)
{
	History y1(0);

	w = x * a0;
	z = y1 * b1;
	y = w - z;

	y1 = y;

	return y;
}

polezeroDf1reset(x, a0, _a1, _a2, b1, _b2, reset)
{
	History y1(0);
	if (reset) {
		y1 = 0;
	}

	w = x * a0;
	z = y1 * b1;
	y = w - z;

	y1 = y;

	return y;
}

//	//	//	cascades

// biquad direct form 2...
// ...in gen~ cascade form with History()s written out to / read from Data()
// (for building cascades for eq's etc)
biquadDf2cascade(x0, a0, a1, a2, b1, b2, x1, x2)
{
	b1w = x1 * b1;
	b2w = x2 * b2;
	w0 = x0 - b1w - b2w;

	a0w = w0 * a0;
	a1w = x1 * a1;
	a2w = x2 * a2;
	y0 = a0w + a1w + a2w;

	return y0, w0, x1;
}

// biquad transposed direct form 2...
// ...in gen~ cascade form with History()s written out to / read from Data()
// (for building cascades etc)
biquadTdf2cascade(x0, a0, a1, a2, b1, b2, x1, x2)
{
	y0 = (x0 * a0) + x2;

	w2 = ((x0 * a1) - (y0 * b1)) + x1;	// x2
	w1 = (x0 * a2) - (y0 * b2);			// x1

	return y0, w1, w2;
}

// parallel double, sum out, for bandreject etc using Df2
biquadDf2parallel(x, a0_1, a1_1, a2_1, b1_1, b2_1, a0_2, a1_2, a2_2, b1_2, b2_2)
{
	History df2pdummy(0);

	y0	= biquadDf2(x,	a0_1, a1_1, a2_1, b1_1, b2_1);
	y1	= biquadDf2(x,	a0_2, a1_2, a2_2, b1_2, b2_2);

	return (y0 + y1) * 0.5;//sqrt1_2;
}

// cascade double, for shelving etc using Df2
biquadDf2double(x, a0_1, a1_1, a2_1, b1_1, b2_1, a0_2, a1_2, a2_2, b1_2, b2_2)
{
	History df2ddummy(0);

	y0	= biquadDf2(x,	a0_1, a1_1, a2_1, b1_1, b2_1);
	y	= biquadDf2(y0,	a0_2, a1_2, a2_2, b1_2, b2_2);

	return y;
}

// cascade three, for simple eq-ing using Df2
biquadDf2triple(x0, a0_1, a1_1, a2_1, b1_1, b2_1, a0_2, a1_2, a2_2, b1_2, b2_2, a0_3, a1_3, a2_3, b1_3, b2_3)
{
	History df2tdummy(0);

	y0	= biquadDf2(x0, a0_1, a1_1, a2_1, b1_1, b2_1);
	y1	= biquadDf2(y0, a0_2, a1_2, a2_2, b1_2, b2_2);
	y2	= biquadDf2(y1, a0_3, a1_3, a2_3, b1_3, b2_3);

	return y2;
}

// cascade three, for simple eq-ing using mathworks I, II, TII cascade
// this is not required in gen~
biquadDf2tmw(x0, a0_1, a1_1, a2_1, b1_1, b2_1, a0_2, a1_2, a2_2, b1_2, b2_2, a0_3, a1_3, a2_3, b1_3, b2_3)
{
	History tmwdummy(0);

	y0	= biquadDf1(x0, a0_1, a1_1, a2_1, b1_1, b2_1);	// low
	y1	= biquadDf2(y0, a0_2, a1_2, a2_2, b1_2, b2_2);	// mid
	y2	= biquadTdf2(y1, a0_3, a1_3, a2_3, b1_3, b2_3);	// high

	return y2;
}

//	//	//	usage

