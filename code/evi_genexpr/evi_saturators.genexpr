  x2_0  = umT2_0 + 0;

  // process 2x
  y1_0  = powerAdaa1(x1_0);
  y2_0  = powerAdaa1(x2_0);

  // down 2x
  y2_0_a  = y2_0 + 0;
  y2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

  y0_0  = (doX0 + y2_1) * 0.5;

