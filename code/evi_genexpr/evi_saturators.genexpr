// halfrect

halfrectAdaa1(x0)
{
  History x1(0), s1(0);
  eps = 0.000001;  // TODO, work out precision

  y1 = 0;
  d0 = x0 - x1;
  s0 = halfrectJ1(x0);    // func1
  if ((x1 == 0 && s1 == 0) || (abs(d0) < eps)) {  // ill condition
    y1 = halfrectJ0(0.5 * (x0 + x1)); // func0
  } else {
    y1 = (s0 - s1) / d0;
  }

  s1 = s0;
  x1 = x0;
  return dcblock(y1); // debatable dc
}

halfrectAdaa2(x0)
{
  History x1(0), x2(0), s1(0);
  eps = 0.000001;  // TODO, work out precision

  s0 = x0;//0;
  d0 = x0 - x1;
  f2_x1 = halfrectJ2(x1); // func2
  if (abs(d0) < eps) {  // ill condition
    s0 = halfrectJ1(0.5 * (x0 + x1)); // func1
  } else {
    s0 = (halfrectJ2(x0) - f2_x1) / d0; // func2
  }

  y1 = x0;//0;
  d1 = x0 - x2;
  if (x1 == 0 && x2 == 0) { // ill condition
    y1 = halfrectJ0(x0 + (x1 + x1) + x2) * 0.25; // func0
  } else if (abs(d1) < eps) { // ill condition
    x_bar = 0.5 * (x0 + x2);
    x_delta = x_bar - x1;
    if (x_delta < eps) {  // ill condition
      y1 = halfrectJ0((x_bar + x1) * 0.5);  // func0
    } else {
      y1 = (2 / x_delta) * (halfrectJ1(x_bar) + (f2_x1 - halfrectJ2(x_bar)) / x_delta); // func1, func2
    }
  } else {
    s0s1 = s0 - s1;
    y1 = (s0s1 + s0s1) / d1;
  }

  s1 = s0;
  x2 = x1;
  x1 = x0;
  return dcblock(y1); // debatable dc
}

