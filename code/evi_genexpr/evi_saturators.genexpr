
// the antiderivative functions etc:

require("evi_adaa.genexpr"); // f(x), F1 & F2, and Adaa1 & Adaa2 in here


// the saturators ( all typed out because... ...gen~ :-( )


// hardclip

hardclipAdaa1(x0)
{
  History x1(0), s1(0);
  eps = 0.000001;  // TODO, work out precision

  y1 = 0;
  d0 = x0 - x1;
  s0 = hardclipJ1(x0);    // func1
  if ((x1 == 0 && s1 == 0) || (abs(d0) < eps)) {  // ill condition
    y1 = hardclipJ0(0.5 * (x0 + x1)); // func0
  } else {
    y1 = (s0 - s1) / d0;
  }

  s1 = s0;
  x1 = x0;
  return y1;
}

hardclipAdaa2(x0)
{
  History x1(0), x2(0), s1(0);
  eps = 0.000001;  // TODO, work out precision

  s0 = x0;//0;
  d0 = x0 - x1;
  f2_x1 = hardclipJ2(x1); // func2
  if (abs(d0) < eps) {  // ill condition
    s0 = hardclipJ1(0.5 * (x0 + x1)); // func1
  } else {
    s0 = (hardclipJ2(x0) - f2_x1) / d0; // func2
  }

  y1 = x0;//0;
  d1 = x0 - x2;
  if (x1 == 0 && x2 == 0) { // ill condition
    y1 = hardclipJ0(x0 + (x1 + x1) + x2) * 0.25; // func0
  } else if (abs(d1) < eps) { // ill condition
    x_bar = 0.5 * (x0 + x2);
    x_delta = x_bar - x1;
    if (x_delta < eps) {  // ill condition
      y1 = hardclipJ0((x_bar + x1) * 0.5);  // func0
    } else {
      y1 = (2 / x_delta) * (hardclipJ1(x_bar) + (f2_x1 - hardclipJ2(x_bar)) / x_delta); // func1, func2
    }
  } else {
    s0s1 = s0 - s1;
    y1 = (s0s1 + s0s1) / d1;
  }

  s1 = s0;
  x2 = x1;
  x1 = x0;
  return y1;
}

// hardclipAdaa1 oversampling...

// fixed 2x quasi oversampling (hermite6)
hardclipAdaa1_2x_6POINT(XIN)
{ // up 2
  History umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
  // down 2
  History dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
  // align
  History doX0(0);

  // up 2x
  x0_0_a  = XIN + 0;
  x1_0  = hermite_sixpoint_interp(0.5,  umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
  x2_0  = umT2_0 + 0;

  // process 2x
  y1_0  = hardclipAdaa1(x1_0);
  y2_0  = hardclipAdaa1(x2_0);

  // down 2x
  y2_0_a  = y2_0 + 0;
  y2_1  = hermite_sixpoint_interp(0.5,  y2_0_a, dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

  y0_0  = (doX0 + y2_1) * 0.5;

  // update
  umTm2_0 = umTm1_0;
  umTm1_0 = umT0_0;
  umT0_0  = umT1_0;
  umT1_0  = umT2_0;
  umT2_0  = x0_0_a;

  doX0  = y1_0;

  dmT3_1  = dmT2_1;
  dmT2_1  = dmT1_1;
  dmT1_1  = dmT0_1;
  dmT0_1  = dmTm1_1;
  dmTm1_1 = y2_0;

  return dcblock(y0_0);
}

