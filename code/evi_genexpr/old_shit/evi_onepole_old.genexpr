
//	//	//	"evi_onepole.genexpr"
//	//	//	a collection of 6dB onepole filters etc in GenExpr
//	//	//	by Pete Dowling for evieve


//	//	//	local utilities (from "evi_trig.genexpr" & "evi_approx.genexpr")

// cheap cos & sin approxes for warping (see "evi_trig.genexpr" for more)
cosQ73(x)
{
	c1 =  0.999999953464;
	c2 = -0.499999053455;
	c3 =  0.0416635846769;
	c4 = -0.0013853704264;
	c5 =  0.00002315393167;  	

	x2 = x * x;
	return (c1 + x2 * (c2 + x2 * (c3 + x2 * (c4 + c5 * x2))));
}

cos_73(x)
{
	two_over_pi = 0.63661977236758;	// 2 / pi
	x = x % twopi;					// get rid of values > 2 * pi
	if (x < 0) {
		x = -x;						// cos(-x) = cos(x)
	}
	quad = int(x * two_over_pi);	// get quadrant # (0 to 3) we're in
	cosreturn = 0;
	if 				(quad == 0) {
		cosreturn =  cosQ73(x);
	} else if 		(quad == 1) {
		cosreturn = -cosQ73(pi - x);
	} else if 		(quad == 2) {
		cosreturn = -cosQ73(x - pi);
	} else {	//	(quad == 3)
		cosreturn =  cosQ73(twopi - x);
	}
	return cosreturn;
}

sin_73(x)
{
	return cos_73(halfpi - x);
}

// cheap tan approx for BLT (see "sk_trig.genexpr" for more accurate tan approxes)
tnA(x)		// 0..1 input
{
	x2 = (x * x);
	x3 = (x2 * x);
	x5 = (x2 * x3);
	return ((x5 * 0.133333) + (x3 * 0.333333)) + x;
}


//	//	//	generalise frequency clipping here

fcClip(cutoff)
{
	fcmin	= samplerate / 24576;
	fcmax	= samplerate / 2.125;
	return clip(cutoff, fcmin, fcmax);
}


//	//	//	allpole, like MSP [onepole~]

// main, with low & high -pass outputs
AllPole(x, cutoff)
{
	History y0(0);
									// MSP is incorrect, this is not warped properly
	f  = clip(sin_73(cutoff * twopi / samplerate), 0.00001, 0.99999);

	lp = mix(y0, x, f);				// lowpass
//	lp = y0 + (f * (x - y0));		// same
	y0 = lp;
	hp = x - lp;					// highpass

	return lp, hp;
}

// hacked allpass version
AllPoleAllPass(x, cutoff)			// 6dB onepole allpass filter
{
	History y0(0);
									// MSP is incorrect, this is not warped properly
	f  = clip(sin_73(cutoff * twopi / samplerate), 0.00001, 0.99999);

	lp = mix(y0, x, f);				// lowpass
	y0 = lp;
	hp = x - lp;					// highpass

	return hp - lp;					// allpass	// (hp * -1) + lp
}

// in seperate sections for cascade, etc...
AllPoleWarp(cutoff)					// 'warp' (not !) (MSP is incorrect, this is not warped properly)
{
	return clip(sin_73(cutoff * twopi / samplerate), 0.00001, 0.99999);	// 'f'
}

// ... lowpass in gen~ cascade form with History() written out to / read from Data()
AllPoleLpSection(x, f, H)			// 'H' is 'y0' read-in
{
	lp = mix(H, x, f);
	y0 = lp;
	return lp, y0;					// lowpass
}

// ... highpass in gen~ cascade form with History() written out to / read from Data()
AllPoleHpSection(x, f, H)			// 'H' is 'y0' read-in
{
	lp = mix(H, x, f);
	y0 = lp;
	hp = x - lp;
	return hp, y0;					// highpass
}

// ... allpass in gen~ cascade form with History() written out to / read from Data()
AllPoleApSection(x, f, H)			// 'H' is 'y0' read-in
{
	lp = mix(H, x, f);
	y0 = lp;
	hp = x - lp;
	return (hp - lp), y0;			// allpass
}


//	//	//	pole zero (from Supercollider ?)

// main, with low & high -pass outputs
PoleZero(x, cutoff)
{
	History R(0);

//	fc  = (pi * cutoff) / samplerate;	// !! no check for min/max 'cutoff' here
	fc  = (pi * fcClip(cutoff)) / samplerate;
	sfc = sin_73(fc);
	a0  = minimum(((sfc + sfc) / (cos_73(fc) + sfc)), 0.999999);
	a1  = 1 - (a0 * 2);

	w  = x * a0;
	lp = R + w;						// lowpass
	R  = w + (lp * a1);
	hp = x - lp;					// highpass

	return lp, hp;
}

// hacked allpass version
PoleZeroAllPass(x, cutoff)			// 6dB pole/zero allpass filter
{
	History R(0);

//	fc  = (pi * cutoff) / samplerate;	// !! no check for min/max 'cutoff' here
	fc  = (pi * fcClip(cutoff)) / samplerate;
	sfc = sin_73(fc);
	a0  = minimum(((sfc + sfc) / (cos_73(fc) + sfc)), 0.999999);
	a1  = 1 - (a0 * 2);

	w  = x * a0;
	lp = R + w;						// lowpass
	R  = w + (lp * a1);
	hp = x - lp;					// highpass

	return hp - lp;					// allpass	// (hp * -1) + lp	// (2 * R) + (2 * w) - x !!!
}

// in seperate sections for cascade, etc...
PoleZeroWarp(cutoff)				// 6dB pole/zero Warp
{
//	fc  = (pi * cutoff) / samplerate;	// !! no check for min/max 'cutoff' here
	fc  = (pi * fcClip(cutoff)) / samplerate;
	sfc = sin_73(fc);
	a0  = minimum(((sfc + sfc) / (cos_73(fc) + sfc)), 0.999999);
	a1  = 1 - (a0 * 2);
	return a0, a1;					// !! 2 coefs
}

// ... lowpass in gen~ cascade form with History() written out to / read from Data()
PoleZeroLpSection(x, a0, a1, Q)		// 'Q' is 'R' read-in
{
	w  = x * a0;
	lp = Q + w;
	R  = w + (lp * a1);
	return lp, R;					// lowpass
}

// ... highpass in gen~ cascade form with History() written out to / read from Data()
PoleZeroHpSection(x, a0, a1, Q)		// 'Q' is 'R' read-in
{
	w  = x * a0;
	lp = Q + w;
	R  = w + (lp * a1);
	hp = x - lp;
	return hp, R;					// highpass
}

// ... allpass in gen~ cascade form with History() written out to / read from Data()
PoleZeroApSection(x, a0, a1, Q)		// 'Q' is 'R' read-in
{
	w  = x * a0;
	lp = Q + w;
	R  = w + (lp * a1);
	hp = x - lp;
	return (hp - lp), R;			// allpass
}


//	//	//	iir (from Reaktor ?)

// main, with low & high -pass outputs
iir6dB(x, cutoff)
{
	History y0(0);

//	tnA(cutoff * (pi / samplerate));	// !! no check for min/max 'cutoff' here
	tnA(fcClip(cutoff) * (pi / samplerate));

	z  = (x - ((w - 1) * y0)) * (1 / (w + 1));
	hp = z - y0;					// highpass
	lp = (z + y0) * w;				// lowpass
	y0 = z;

	return lp, hp;
}

// hacked allpass version
iir6dBAllpass(x, cutoff)
{
	History y0(0);

//	tnA(cutoff * (pi / samplerate));	// !! no check for min/max 'cutoff' here
	tnA(fcClip(cutoff) * (pi / samplerate));

	z  = (x - ((w - 1) * y0)) * (1 / (w + 1));
	hp = z - y0;					// highpass
	lp = (z + y0) * w;				// lowpass
	y0 = z;

	return hp - lp;					// allpass	// (hp * -1) + lp
}

// in seperate sections for cascade, etc...
iir6dBWarp(cutoff)					// 6dB iir BLT
{
//	return tnA(cutoff * (pi / samplerate));	// !! no check for min/max 'cutoff' here	// 'w'
	return tnA(fcClip(cutoff) * (pi / samplerate));		// 'w'
}

// ... lowpass in gen~ cascade form with History() written out to / read from Data()
iir6dBLpSection(x, w, H)			// 'H' is 'y0' read-in
{
	z  = (x - ((w - 1) * H)) * (1 / (w + 1));
	lp = (z + H) * w;
	y0 = z;
	return lp, y0;					// lowpass
}

// ... highpass in gen~ cascade form with History() written out to / read from Data()
iir6dBHpSection(x, w, H)			// 'H' is 'y0' read-in
{
	z  = (x - ((w - 1) * H)) * (1 / (w + 1));
	hp = z - H;
	lp = (z + H) * w;
	y0 = z;
	return hp, y0;					// highpass
}

// ... allpass in gen~ cascade form with History() written out to / read from Data()
iir6dBApSection(x, w, H)			// 'H' is 'y0' read-in
{
	z  = (x - ((w - 1) * H)) * (1 / (w + 1));
	hp = z - H;
	lp = (z + H) * w;
	y0 = z;
	return (hp - lp), y0;			// allpass
}


//	//	//	one pole one zero biquad

// for odd ordered cascades of biquads
polezeroDf1(x, a0, a1, a2, b1, b2)
{
	History y1(0);
//	a1, a2, b2 = 0;

	w = x * a0;
	z = y1 * b1;
	y = w - z;

	y1 = y;

	return y;
}

// 6dB iir, no coef wastage
polezeroDf1solo(x, a0, b1)
{
	History y1(0);

	w = x * a0;
	z = y1 * b1;
	y = w - z;

	y1 = y;

	return y;
}
