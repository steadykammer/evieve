/*
the following CPU test is approximately 52.79 % scientific:

math library tanh()
average audio CPU usage was 93.05%

tnhL()
average audio CPU usage was 64.07%

tnhO()
average audio CPU usage was 65.81%

tnhA()
average audio CPU usage was 69.10%

tnhD()
average audio CPU usage was 63.55%

tnhQ()
average audio CPU usage was 57.59%	<-- this has to be wrong, i would assume 'tnhD()' is the cheapest
*/


// 'high quality' Lambert approx, excellent mathematical and sonic closeness to 'real' tanh
// !! amplitude of 'x' must be clamped ± 120 dB otherwise numerical innacuracy !!
tnhL(x)
{
	x2 = x * x;
	a = (((x2 + 378) * x2 + 17325) * x2 + 135135) * x;
	b = ((28 * x2 + 3150) * x2 + 62370) * x2 + 135135;
	return clamp((a / b), -1, 1);				// is the output clamp really required ??
}

// by fire-sledge / antto
// @see: http://www.kvraudio.com/forum/viewtopic.php?f=33&t=262823&start=45
tnhO(x)
{
	xa		= abs(x);
	x2		= xa * xa;
	x3		= xa * x2;
	x4		= x2 * x2;
	x7		= x3 * x4;
	res		= 1 - (1 / (1 + xa + x2 + 0.58576695 * x3 + 0.55442112 * x4 + 0.057481508 * x7));
	return	(x > 0) ? res : -res;
}

// 'bright'
tnhA(x)
{
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x) * x) * x;
	x *= x; x *= x; x *= x; x *= x; x *= x;		// exp
	y = -1 / (x + 1);
	return (y + y) + 1;							// tanh
}

// 'dark'
tnhD(x)
{
	x		= clip(x, -3, 3);
	return	x * ((27 + (x * x)) / (27 + (9 * (x * x))));
}

// 'dull'
tnhQ(x)
{
	w = x * x;
	y = 0;
	if (w <= 6.25) {
		y = (0.913415 + (-0.18436 + (0.024184 - 0.00127468 * w) * w) * w) * x;
	} else {
		w = 1 + 0.125 * abs(x) + 0.0078125 * w;
		w *= w; w *= w; w *= w; w *= w;
		y = (x < 0) ? (1.86033 / w - 1) : (1 - 1.86033 / w);
	}
	return y;
}

// 'crap'
tnhR(x0)
{
	x1	= (x0 * 1.84726402473396);						// * (7.38905609893584 / 4);
	ex	= 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x1) * x1) * x1;
	ex *= ex; ex *= ex; ex *= ex; ex *= ex; ex *= ex;	// ex = pow(7.38905609893584, x);
	return ((ex - 1) / (ex + 1));
}

// 'bright' tanh(2x)
tnhA2(x)
{
	x = x + x;									// 2x
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x) * x) * x;
	x *= x; x *= x; x *= x; x *= x; x *= x;		// exp
	y = -1 / (x + 1);
	return (y + y) + 1;							// tanh
}


/*
the following CPU test is approximately 41.88 % scientific:

tanh(sqrt(x))/sqrt(x)
average audio CPU usage was 100.18%

tnhXdX(x)
average audio CPU usage was 64.00%
*/


// Padé approximation for tanh(sqrt(x))/sqrt(x)
tnhXdX(x)
{
	a = x * x;
	return ((a + 105) * a + 945) / ((15 * a + 420) * a + 945);
}

