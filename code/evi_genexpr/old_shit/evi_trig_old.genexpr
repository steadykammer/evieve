// *********************************************************
// ***
// ***   Routines to compute arctangent to 6.6 digits
// ***  of accuracy. 
// ***
// *********************************************************
//
//		atanT66 computes atan(x)
//
//  Accurate to about 6.6 decimal digits over the range [0, pi/12].
//
//  Algorithm:
//		atan(x)= x(c1 + c2*x**2)/(c3 + x**2)
//
atanT66(x) {
	c1 = 1.6867629106;
	c2 = 0.4378497304;
	c3 = 1.6867633134;

	x2 = x * x;
	return (x * (c1 + x2 * c2) / (c3 + x2));
}
//
// This is the main arctangent approximation "driver"
// It reduces the input argument's range to [0, pi/12],
// and then calls the approximator. 
//
//
atan_66(x) {
	sixthpi = 0.5235987755983;		// pi / 6
	tansixthpi = 0.577350269189627;	// tan(radians(pi / 6))
	tantwelfthpi = 0.267949192431123;// tan(radians(pi / 12)) [tan(radians(0.26179938779915))]

	complement	= int(0);			// true if arg was > 1 
	region		= int(0);			// true depending on region arg is in
	sign		= int(0);			// true if arg was < 0

	if (x < 0) {
		x = -x;
		sign = int(1);				// arctan(-x) = -arctan(x)
	}
	if (x > 1) {
		x = 1 / x;					// keep arg between 0 and 1
		complement = int(1);
	}
	if (x > tantwelfthpi) {
		x = (x - tansixthpi) / (1 + tansixthpi * x);// reduce arg to under tan(pi/12)
		region = int(1);
	}

	y = atanT66(x);				// run the approximation

	if (region) y += sixthpi;		// correct for region we're in
	if (complement) y = halfpi - y;	// correct for 1/x if we did that
	if (sign) y = -y;				// correct for negative arg

	return y;
}

// *********************************************************
// ***
// ***   Routines to compute arctangent to 13.7 digits
// ***  of accuracy. 
// ***
// *********************************************************
//
//		atanT137 computes atan(x)
//
//  Accurate to about 13.7 decimal digits over the range [0, pi/12].
//
//  Algorithm:
//		atan(x)= x(c1 + c2*x**2 + c3*x**4)/(c4 + c5*x**2 + c6*x**4 + x**6)
//
atanT137(x) {
	c1 = 48.70107004404898384;
	c2 = 49.5326263772254345;
	c3 = 9.40604244231624;
	c4 = 48.70107004404996166;
	c5 = 65.7663163908956299;
	c6 = 21.587934067020262;

	x2 = x * x;
	return (x * (c1 + x2 * (c2 + x2 * c3)) / (c4 + x2 * (c5 + x2 * (c6 + x2))));
}
//
// This is the main arctangent approximation "driver"
// It reduces the input argument's range to [0, pi/12],
// and then calls the approximator. 
//
//
atan_137(x) {
	sixthpi = 0.5235987755983;		// pi / 6
	tansixthpi = 0.577350269189627;	// tan(radians(pi / 6))
	tantwelfthpi = 0.267949192431123;// tan(radians(pi / 12)) [tan(radians(0.26179938779915))]

	complement	= int(0);			// true if arg was > 1 
	region		= int(0);			// true depending on region arg is in
	sign		= int(0);			// true if arg was < 0

	if (x < 0) {
		x = -x;
		sign = int(1);				// arctan(-x) = -arctan(x)
	}
	if (x > 1) {
		x = 1 / x;					// keep arg between 0 and 1
		complement = int(1);
	}
	if (x > tantwelfthpi) {
		x = (x - tansixthpi) / (1 + tansixthpi * x);// reduce arg to under tan(pi/12)
		region = int(1);
	}

	y = atanT137(x);				// run the approximation

	if (region) y += sixthpi;		// correct for region we're in
	if (complement) y = halfpi - y;	// correct for 1/x if we did that
	if (sign) y = -y;				// correct for negative arg

	return y;
}

