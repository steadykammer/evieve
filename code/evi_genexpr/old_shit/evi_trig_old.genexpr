}

// *********************************************************
// ***
// ***   Routines to compute tangent to 3.2 digits
// ***  of accuracy. 
// ***
// *********************************************************
//
//		tanO32 computes tan(pi*x/4)
//
//  Accurate to about 3.2 decimal digits over the range [0, pi/4].
//  The input argument is in radians. Note that the function
//  computes tan(pi*x/4), NOT tan(x); it's up to the range
//  reduction algorithm that calls this to scale things properly.
//
//  Algorithm:
//		tan(x)= x*c1/(c2 + x**2)
//
tanO32(x) {
	c1 = -3.6112171;
	c2 = -4.6133253;

	x2 = x * x;
	return (x * c1 / (c2 + x2));
}
//
// This is the main tangent approximation "driver"
// It reduces the input argument's range to [0, pi/4],
// and then calls the approximator. 
// See the notes for an explanation of the range reduction.
// Enter with positive angles only.
//
// WARNING: We do not test for the tangent approaching infinity,
// which it will at x=pi/2 and x=3*pi/2. If this is a problem
// in your application, take appropriate action.
//
tan_32(x) {
	four_over_pi = 1.27323954473516;	// 4 / pi
	threehalfpi = 4.7123889803847;		// 3 * halfpi
	x = x % twopi;						// get rid of values > 2 * pi
	octant = int(x * four_over_pi);		// get octant # (0 to 7)
	tanreturn = 0;
	if 				(octant == 0) {
		tanreturn = 	 tanO32(x					* four_over_pi);
	} else if 		(octant == 1) {
		tanreturn =  1 / tanO32((halfpi - x)		* four_over_pi);
	} else if 		(octant == 2) {
		tanreturn = -1 / tanO32((x - halfpi)		* four_over_pi);
	} else if 		(octant == 3) {
		tanreturn = 	-tanO32((pi - x)			* four_over_pi);
	} else if 		(octant == 4) {
		tanreturn = 	 tanO32((x - pi)			* four_over_pi);
	} else if 		(octant == 5) {
		tanreturn =  1 / tanO32((threehalfpi - x)	* four_over_pi);
	} else if 		(octant == 6) {
		tanreturn = -1 / tanO32((x - threehalfpi)	* four_over_pi);
	} else {	//	(octant == 7)
		tanreturn = 	-tanO32((twopi - x)		* four_over_pi);
	}
	return tanreturn;
}

// *********************************************************
// ***
// ***   Routines to compute tangent to 5.6 digits
// ***  of accuracy. 
// ***
// *********************************************************
//
//		tanO56 computes tan(pi*x/4)
//
//  Accurate to about 5.6 decimal digits over the range [0, pi/4].
//  The input argument is in radians. Note that the function
//  computes tan(pi*x/4), NOT tan(x); it's up to the range
//  reduction algorithm that calls this to scale things properly.
//
//  Algorithm:
//		tan(x)= x(c1 + c2*x**2)/(c3 + x**2)
//
tanO56(x) {
	c1 = -3.16783027;
	c2 =  0.134516124;
	c3 = -4.033321984;

	x2 = x * x;
	return (x * (c1 + c2 * x2) / (c3 + x2));
}
//
// This is the main tangent approximation "driver"
// It reduces the input argument's range to [0, pi/4],
// and then calls the approximator. 
// See the notes for an explanation of the range reduction.
// Enter with positive angles only.
//
// WARNING: We do not test for the tangent approaching infinity,
// which it will at x=pi/2 and x=3*pi/2. If this is a problem
// in your application, take appropriate action.
//
tan_56(x) {
	four_over_pi = 1.27323954473516;	// 4 / pi
	threehalfpi = 4.7123889803847;		// 3 * halfpi
	x = x % twopi;						// get rid of values > 2 * pi
	octant = int(x * four_over_pi);		// get octant # (0 to 7)
	tanreturn = 0;
	if 				(octant == 0) {
		tanreturn = 	 tanO56(x					* four_over_pi);
	} else if 		(octant == 1) {
		tanreturn =  1 / tanO56((halfpi - x)		* four_over_pi);
	} else if 		(octant == 2) {
		tanreturn = -1 / tanO56((x - halfpi)		* four_over_pi);
	} else if 		(octant == 3) {
		tanreturn = 	-tanO56((pi - x)			* four_over_pi);
	} else if 		(octant == 4) {
		tanreturn = 	 tanO56((x - pi)			* four_over_pi);
	} else if 		(octant == 5) {
		tanreturn =  1 / tanO56((threehalfpi - x)	* four_over_pi);
	} else if 		(octant == 6) {
		tanreturn = -1 / tanO56((x - threehalfpi)	* four_over_pi);
	} else {	//	(octant == 7)
		tanreturn = 	-tanO56((twopi - x)		* four_over_pi);
	}
	return tanreturn;
}

// *********************************************************
// ***
// ***   Routines to compute tangent to 8.2 digits
// ***  of accuracy. 
// ***
// *********************************************************
//
//		tanO82 computes tan(pi*x/4)
//
//  Accurate to about 8.2 decimal digits over the range [0, pi/4].
//  The input argument is in radians. Note that the function
//  computes tan(pi*x/4), NOT tan(x); it's up to the range
//  reduction algorithm that calls this to scale things properly.
//
//  Algorithm:
//		tan(x)= x(c1 + c2*x**2)/(c3 + c4*x**2 + x**4)
//
tanO82(x) {
	c1 =  211.849369664121;
	c2 = -12.5288887278448 ;
	c3 =  269.7350131214121;
	c4 = -71.4145309347748;

	x2 = x * x;
	return (x * (c1 + c2 * x2) / (c3 + x2 * (c4 + x2)));
}
//
// This is the main tangent approximation "driver"
// It reduces the input argument's range to [0, pi/4],
// and then calls the approximator. 
// See the notes for an explanation of the range reduction.
// Enter with positive angles only.
//
// WARNING: We do not test for the tangent approaching infinity,
// which it will at x=pi/2 and x=3*pi/2. If this is a problem
// in your application, take appropriate action.
//
tan_82(x) {
	four_over_pi = 1.27323954473516;	// 4 / pi
	threehalfpi = 4.7123889803847;		// 3 * halfpi
	x = x % twopi;						// get rid of values > 2 * pi
	octant = int(x * four_over_pi);		// get octant # (0 to 7)
	tanreturn = 0;
	if 				(octant == 0) {
		tanreturn = 	 tanO82(x					* four_over_pi);
	} else if 		(octant == 1) {
		tanreturn =  1 / tanO82((halfpi - x)		* four_over_pi);
	} else if 		(octant == 2) {
		tanreturn = -1 / tanO82((x - halfpi)		* four_over_pi);
	} else if 		(octant == 3) {
		tanreturn = 	-tanO82((pi - x)			* four_over_pi);
	} else if 		(octant == 4) {
		tanreturn = 	 tanO82((x - pi)			* four_over_pi);
	} else if 		(octant == 5) {
		tanreturn =  1 / tanO82((threehalfpi - x)	* four_over_pi);
	} else if 		(octant == 6) {
		tanreturn = -1 / tanO82((x - threehalfpi)	* four_over_pi);
	} else {	//	(octant == 7)
		tanreturn = 	-tanO82((twopi - x)		* four_over_pi);
	}
	return tanreturn;
}

// *********************************************************
// ***
// ***   Routines to compute tangent to 14 digits
// ***  of accuracy. 
// ***
// *********************************************************
//
//		tanO14 computes tan(pi*x/4)
//
//  Accurate to about 14 decimal digits over the range [0, pi/4].
//  The input argument is in radians. Note that the function
//  computes tan(pi*x/4), NOT tan(x); it's up to the range
//  reduction algorithm that calls this to scale things properly.
//
//  Algorithm:
//		tan(x)= x(c1 + c2*x**2 + c3*x**4)/(c4 + c5*x**2 + c6*x**4 + x**6)
//
tanO14(x) {
	c1 = -34287.4662577359568109624;
	c2 =  2566.7175462315050423295;
	c3 = -26.5366371951731325438;
	c4 = -43656.1579281292375769579;
	c5 =  12244.4839556747426927793;
	c6 = -336.611376245464339493;

	x2 = x * x;
	return (x * (c1 + x2 * (c2 + x2 * c3))) / (c4 + x2 * (c5 + x2 * (c6 + x2)));
}
//
// This is the main tangent approximation "driver"
// It reduces the input argument's range to [0, pi/4],
// and then calls the approximator. 
// See the notes for an explanation of the range reduction.
// Enter with positive angles only.
//
// WARNING: We do not test for the tangent approaching infinity,
// which it will at x=pi/2 and x=3*pi/2. If this is a problem
// in your application, take appropriate action.
//
tan_14(x) {
	four_over_pi = 1.27323954473516;	// 4 / pi
	threehalfpi = 4.7123889803847;		// 3 * halfpi
	x = x % twopi;						// get rid of values > 2 * pi
	octant = int(x * four_over_pi);		// get octant # (0 to 7)	[int(x * qtrpi) ??]
	tanreturn = 0;
	if 				(octant == 0) {
		tanreturn = 	 tanO14(x					* four_over_pi);
	} else if 		(octant == 1) {
		tanreturn =  1 / tanO14((halfpi - x)		* four_over_pi);
	} else if 		(octant == 2) {
		tanreturn = -1 / tanO14((x - halfpi)		* four_over_pi);
	} else if 		(octant == 3) {
		tanreturn = 	-tanO14((pi - x)			* four_over_pi);
	} else if 		(octant == 4) {
		tanreturn = 	 tanO14((x - pi)			* four_over_pi);
	} else if 		(octant == 5) {
		tanreturn =  1 / tanO14((threehalfpi - x)	* four_over_pi);
	} else if 		(octant == 6) {
		tanreturn = -1 / tanO14((x - threehalfpi)	* four_over_pi);
	} else {	//	(octant == 7)
		tanreturn = 	-tanO14((twopi - x)		* four_over_pi);
	}
	return tanreturn;
}

