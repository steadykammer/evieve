//	//	//	generalise frequency clipping here

fcClip(cutoff, units)		// 'units' is cutoff type (0 = Hz, 1 = MIDI Pitch)
{
	cf		= cutoff;
	if (units > 0) {
		cf	= mtofApprox(cutoff);
	}
	fcmin	= samplerate / 24576;
	fcmax	= samplerate / 2.125;
	return clip(cf, fcmin, fcmax);
}

fcClipFULL(cutoff, units)	// 'units' is cutoff type (0 = Hz, 1 = MIDI Pitch)
{
	cf		= cutoff;
	if (units > 0) {
		cf	= mtof(cutoff);
	}
	fcmin	= samplerate / 24576;
	fcmax	= samplerate / 2.125;
	return clip(cf, fcmin, fcmax);
}


//	//	//	coefficients

/*
- in both 'biquadcoeff()' & 'buttercoeff()' below, "funits" param is an integer to choose cutoff input style:
- 0 = Hz
- 1 = MIDI Pitch

- in both 'biquadcoeff()' & 'buttercoeff()' below, "gunits" param is an integer to choose gain input style:
- 0 = amplitude or dB depending on filter (like [filtercoeff~])
- 1 = always amplitude (like [filtergraph~])
- 2 = always dB (evieve)
- (using dB gain is the only significant area of inaccuracy in the approximations versions)
*/


//	//	//	coefficients - rbj cookbook ish

/*
'biquadcoeff()' "type" (available filter types):		// integer to choose filter type
// fixed unity gain:
0		= lowpass
1		= highpass
2		= bandpass
3		= notch (bandstop)
4		= allpass
5		= reson~
6		= bp~
// variable gain input:
7		= lowpass
8		= highpass
9		= bandpass
10		= notch (bandstop)
11		= allpass
12		= reson~
13		= bp~
// always variable gain:
14		= peak notch
15		= peak eq
16		= low shelf
17		= high shelf
*/

// biquad calculator, a bit like MSP [filtercoeff~], with differences
// f0, gain, Q, in MSP-like order, 'funits' is cutoff mode, 'gunits' is gain mode, 'type' switches filter
biquadcoeff(f0, gain, Q, funits, gunits, type)
{
	// init
	a0, b0			= 1;
	b1, b2, a1, a2	= 0;
	// common
	f0			= fcClip(f0, funits);
	Q			= maximum(Q, 0.001);
	w0 			= twopi * f0 / samplerate;				// omega0
	alpha 		= sin_73(w0) / (2 * Q);					// r0

	// switch filters
	if (type == 0) {				// LPF, fixed
		c0		 = cos_73(w0);
		b1 =	 1 - c0;
		b0 =	 b1 / 2;
		b2 =	 b0;
		a0 =	 1 + alpha;
		a1 =	-2 * c0;
		a2 =	 1 - alpha;
	} else if (type == 1) {			// HPF, fixed
		c0		 = cos_73(w0);
		b0 =	(1 + c0) / 2;
		b1 =	-1 - c0;
		b2 =	 b0;
		a0 =	 1 + alpha;
		a1 =	-2 * c0;
		a2 =	 1 - alpha;		
	} else if (type == 2) {			// BPF (constant 0 dB peak gain), fixed
		b0 =	 alpha;
		b1 =	 0;
		b2 =	-alpha;
		a0 =	 1 + alpha;
		a1 =	-2 * cos_73(w0);
		a2 =	 1 - alpha;
	} else if (type == 3) {			// Notch ('Band Stop'), fixed
		b0 =	 1;
		b1 =	-2 * cos_73(w0);
		b2 =	 1;
		a0 =	 1 + alpha;
		a1 =	 b1;
		a2 =	 1 - alpha;
	} else if (type == 4) {			// APF, fixed
		b0 =	 1 - alpha;
		b1 =	-2 * cos_73(w0);
		b2 =	 1 + alpha;
		a0 =	 b2;
		a1 =	 b1;
		a2 =	 b0;
	} else if (type == 5) {			 // resonant like MSP [reson~], fixed
		bw		 = f0 / maximum(Q, 0.009377);			// additional clip needed
		omega	 = twopi / samplerate;
		r1		 = expA(-bw * omega) + 0.000161;		// offset for accuracy
        b0 =	 1 - r1;
        b1 =	 0;
        b2 =	-(r1 - (r1 * r1));
        a0 =	 1;
        a1 =	-((2 * r1) * cos_73(f0 * omega));		// w0
        a2 =	-(-r1 * r1);
	} else if (type == 6) {			// bandpass like Pd [bp~], fixed
		qw		 = minimum((w0 / Q), 1);
		r2		 = 1 - qw;
        b0 =	 2 * qw * (qw + r2 * w0);
        b1 =	 0;
        b2 =	 0;
        a0 =	 1;
        a1 =	-2 * cos_73(w0) * r2;					// omega
        a2 =	 r2 * r2;
	} else if ((type >= 7) && (type <= 14)) {
		gainA		 = gain;
		if (gunits == 2) {
			gainA	 = dbtoaApprox(gain);
		}
		if (type == 7) {			// LPF, variable
			c0		 = cos_73(w0);
			b1 =	 1 - c0;
			b0 =	 b1 / 2;
			b0 =	 b0 * gainA;
			b1 =	 b1 * gainA;
			b2 =	 b0;
			a0 =	 1 + alpha;
			a1 =	-2 * c0;
			a2 =	 1 - alpha;
		} else if (type == 8) {		// HPF, variable
			c0		 = cos_73(w0);
			b0 =	(1 + c0) / 2;
			b0 =	 b0 * gainA;
			b1 =	-1 - c0;
			b1 =	 b1 * gainA;
			b2 =	 b0;
			a0 =	 1 + alpha;
			a1 =	-2 * c0;
			a2 =	 1 - alpha;		
		} else if (type == 9) {		// BPF, variable
			b0 =	 alpha;
			b0 =	 b0 * gainA;
			b1 =	 0;
			b2 =	-alpha;
			b2 =	 b2 * gainA;
			a0 =	 1 + alpha;
			a1 =	-2 * cos_73(w0);
			a2 =	 1 - alpha;
		} else if (type == 10) {	// Notch ('Band Stop'), variable
			b0 =	 1;
			b0 =	 b0 * gainA;
			b1 =	-2 * cos_73(w0);
			b2 =	 b0;
			a0 =	 1 + alpha;
			a1 =	 b1;
			b1 =	 b1 * gainA;
			a2 =	 1 - alpha;
		} else if (type == 11) {	// APF, variable
			b0 =	 1 - alpha;
			b1 =	-2 * cos_73(w0);
			b2 =	 1 + alpha;
			a0 =	 b2;
			a1 =	 b1;
			a2 =	 b0;
			b0 =	 b0 * gainA;
			b1 =	 b1 * gainA;
			b2 =	 b2 * gainA;
		} else if (type == 12) {	// resonant like MSP [reson~], variable
			bw		 = f0 / maximum(Q, 0.009377);		// additional clip needed
			omega	 = twopi / samplerate;
			r1		 = expA(-bw * omega) + 0.000161;	// offset for accuracy
        	b0 =	 1 - r1;
			b0 =	 b0 * gainA;
        	b1 =	 0;
        	b2 =	-(r1 - (r1 * r1));
			b2 =	 b2 * gainA;
        	a0 =	 1;
        	a1 =	-((2 * r1) * cos_73(f0 * omega));	// w0
			a2 =	-(-r1 * r1);
		} else if (type == 13) {	// bandpass like Pd [bp~], variable
			qw		 = minimum((w0 / Q), 1);
			r2		 = 1 - qw;
        	b0 =	 2 * qw * (qw + r2 * w0);
			b0 =	 b0 * gainA;
			b1 =	 0;
        	b2 =	 0;
        	a0 =	 1;
        	a1 =	-2 * cos_73(w0) * r2;				// omega
        	a2 =	 r2 * r2;
		} else {	// (type == 14)	// peakNotch, always variable
			G  		 = sqrt(maximum(gainA, 0.001));// gain is in linear amplitude directly (not in dB)
			amG		 = alpha * G;
			adG		 = alpha / G;
        	b0 =	 1 + amG;
        	b1 =	-2 * cos_73(w0);
        	b2 =	 1 - amG;
        	a0 =	 1 + adG;
        	a1 =	 b1;
        	a2 =	 1 - adG;
		}
	} else if ((type >= 15) && (type <= 17)) {			// peakEQ, lowShelf, highShelf, always in dB
		dBgain		 = gain;
		if (gunits == 1) {
			dBgain	 = atodb(gain);
		}
		A  		 	 = fastpow(10, (dBgain * 0.025)) + 0.028652;// gain is in dB directly, offset for accuracy
		if (type == 15) {			// peakEQ, always variable, (more useful than 'peakNotch')
			amA		 = alpha * A;
			adA		 = alpha / A;
        	b0 =	 1 + amA;
        	b1 =	-2 * cos_73(w0);
        	b2 =	 1 - amA;
        	a0 =	 1 + adA;
        	a1 =	 b1;
        	a2 =	 1 - adA;
		} else if (type == 16) {	// lowShelf, always variable
			c0		 = cos_73(w0);
			sA		 = sqrt(A) * alpha;
			Am1		 = A - 1;
			Ap1		 = A + 1;
			b0 =	 A * (Ap1 - Am1 * c0 + 2 * sA);
        	b1 =	 2 * A * (Am1 - Ap1 * c0);
        	b2 =	 A * (Ap1 - Am1 * c0 - 2 * sA);
        	a0 =	 Ap1 + Am1 * c0 + 2 * sA;
        	a1 =	-2 * (Am1 + Ap1 * c0);
        	a2 =	 Ap1 + Am1 * c0 - 2 * sA;
		} else {	// (type == 17)	// highShelf, always variable
			c0		 = cos_73(w0);
			sA		 = sqrt(A) * alpha;
			Am1		 = A - 1;
			Ap1		 = A + 1;
			b0 =	 A * (Ap1 + Am1 * c0 + 2 * sA);
			b1 =	-2 * A * (Am1 + Ap1 * c0);			// b1 has minor inaccuracy
			b2 =	 A * (Ap1 + Am1 * c0 - 2 * sA);
			a0 =	 Ap1 - Am1 * c0 + 2 * sA;
			a1 =	 2 * (Am1 - Ap1 * c0);
			a2 =	 Ap1 - Am1 * c0 - 2 * sA;
		}
	} else {		// (-1)			// zero				// initial state, zero biquad, (like [filtercoeff~])
		a0, b0				= 1;
		b1, b2, a1, a2		= 0;
	}

	// convert rbj coeffs (b0, b1, b2, a0, a1, a2) to FF0, FF1, FF2, FB1, FB2 (a0, a1, a2, b1, b2)
	a0m		=	1 / a0;
	return (b0 * a0m), (b1 * a0m), (b2 * a0m), (a1 * a0m), (a2 * a0m);	// a0, a1, a2, b1, b2
}


//	//	//	no approximations version of 'biquadcoeff()', if that is your thang, just add "FULL"

// biquad calculator, a bit like MSP [filtercoeff~], with differences
// f0, gain, Q, in MSP-like order, 'funits' is cutoff mode, 'gunits' is gain mode, 'type' switches filter
biquadcoeffFULL(f0, gain, Q, funits, gunits, type)
{
	// init
	a0, b0			= 1;
	b1, b2, a1, a2	= 0;
	// common
	f0			= fcClipFULL(f0, funits);
	Q			= maximum(Q, 0.001);
	w0 			= twopi * f0 / samplerate;				// omega0
	alpha 		= sin(w0) / (2 * Q);					// r0

	// switch filters
	if (type == 0) {				// LPF, fixed
		c0		 = cos(w0);
		b1 =	 1 - c0;
		b0 =	 b1 / 2;
		b2 =	 b0;
		a0 =	 1 + alpha;
		a1 =	-2 * c0;
		a2 =	 1 - alpha;
	} else if (type == 1) {			// HPF, fixed
		c0		 = cos(w0);
		b0 =	(1 + c0) / 2;
		b1 =	-1 - c0;
		b2 =	 b0;
		a0 =	 1 + alpha;
		a1 =	-2 * c0;
		a2 =	 1 - alpha;		
	} else if (type == 2) {			// BPF (constant 0 dB peak gain), fixed
		b0 =	 alpha;
		b1 =	 0;
		b2 =	-alpha;
		a0 =	 1 + alpha;
		a1 =	-2 * cos(w0);
		a2 =	 1 - alpha;
	} else if (type == 3) {			// Notch ('Band Stop'), fixed
		b0 =	 1;
		b1 =	-2 * cos(w0);
		b2 =	 1;
		a0 =	 1 + alpha;
		a1 =	 b1;
		a2 =	 1 - alpha;
	} else if (type == 4) {			// APF, fixed
		b0 =	 1 - alpha;
		b1 =	-2 * cos(w0);
		b2 =	 1 + alpha;
		a0 =	 b2;
		a1 =	 b1;
		a2 =	 b0;
	} else if (type == 5) {			 // resonant like MSP [reson~], fixed
		bw		 = f0 / Q;
		omega	 = twopi / samplerate;
		r1		 = exp(-bw * omega);
        b0 =	 1 - r1;
        b1 =	 0;
        b2 =	-(r1 - (r1 * r1));
        a0 =	 1;
        a1 =	-((2 * r1) * cos(f0 * omega));		// w0
        a2 =	-(-r1 * r1);
	} else if (type == 6) {			// bandpass like Pd [bp~], fixed
		qw		 = minimum((w0 / Q), 1);
		r2		 = 1 - qw;
        b0 =	 2 * qw * (qw + r2 * w0);
        b1 =	 0;
        b2 =	 0;
        a0 =	 1;
        a1 =	-2 * cos(w0) * r2;					// omega
        a2 =	 r2 * r2;
	} else if ((type >= 7) && (type <= 14)) {
		gainA		 = gain;
		if (gunits == 2) {
			gainA	 = dbtoa(gain);
		}
		if (type == 7) {			// LPF, variable
			c0		 = cos(w0);
			b1 =	 1 - c0;
			b0 =	 b1 / 2;
			b0 =	 b0 * gainA;
			b1 =	 b1 * gainA;
			b2 =	 b0;
			a0 =	 1 + alpha;
			a1 =	-2 * c0;
			a2 =	 1 - alpha;
		} else if (type == 8) {		// HPF, variable
			c0		 = cos(w0);
			b0 =	(1 + c0) / 2;
			b0 =	 b0 * gainA;
			b1 =	-1 - c0;
			b1 =	 b1 * gainA;
			b2 =	 b0;
			a0 =	 1 + alpha;
			a1 =	-2 * c0;
			a2 =	 1 - alpha;		
		} else if (type == 9) {		// BPF, variable
			b0 =	 alpha;
			b0 =	 b0 * gainA;
			b1 =	 0;
			b2 =	-alpha;
			b2 =	 b2 * gainA;
			a0 =	 1 + alpha;
			a1 =	-2 * cos(w0);
			a2 =	 1 - alpha;
		} else if (type == 10) {	// Notch ('Band Stop'), variable
			b0 =	 1;
			b0 =	 b0 * gainA;
			b1 =	-2 * cos(w0);
			b2 =	 b0;
			a0 =	 1 + alpha;
			a1 =	 b1;
			b1 =	 b1 * gainA;
			a2 =	 1 - alpha;
		} else if (type == 11) {	// APF, variable
			b0 =	 1 - alpha;
			b1 =	-2 * cos(w0);
			b2 =	 1 + alpha;
			a0 =	 b2;
			a1 =	 b1;
			a2 =	 b0;
			b0 =	 b0 * gainA;
			b1 =	 b1 * gainA;
			b2 =	 b2 * gainA;
		} else if (type == 12) {	// resonant like MSP [reson~], variable
			bw		 = f0 / Q;
			omega	 = twopi / samplerate;
			r1		 = exp(-bw * omega);
        	b0 =	 1 - r1;
			b0 =	 b0 * gainA;
        	b1 =	 0;
        	b2 =	-(r1 - (r1 * r1));
			b2 =	 b2 * gainA;
        	a0 =	 1;
        	a1 =	-((2 * r1) * cos(f0 * omega));		// w0
			a2 =	-(-r1 * r1);
		} else if (type == 13) {	// bandpass like Pd [bp~], variable
			qw		 = minimum((w0 / Q), 1);
			r2		 = 1 - qw;
        	b0 =	 2 * qw * (qw + r2 * w0);
			b0 =	 b0 * gainA;
			b1 =	 0;
        	b2 =	 0;
        	a0 =	 1;
        	a1 =	-2 * cos(w0) * r2;					// omega
        	a2 =	 r2 * r2;
		} else {	// (type == 14)	// peakNotch, always variable
			G  		 = sqrt(maximum(gainA, 0.001));		// gain is in linear amplitude (not in dB) directly
			amG		 = alpha * G;
			adG		 = alpha / G;
        	b0 =	 1 + amG;
        	b1 =	-2 * cos(w0);
        	b2 =	 1 - amG;
        	a0 =	 1 + adG;
        	a1 =	 b1;
        	a2 =	 1 - adG;
		}
	} else if ((type >= 15) && (type <= 17)) {			// peakEQ, lowShelf, highShelf, always in dB
		dBgain		 = gain;
		if (gunits == 1) {
			dBgain	 = atodb(gain);
		}
		if (type == 15) {			// peakEQ, always variable, (more useful than 'peakNotch')
			A  		 = pow(10, (dBgain / 40));			// gain is in dB directly
			amA		 = alpha * A;
			adA		 = alpha / A;
        	b0 =	 1 + amA;
        	b1 =	-2 * cos(w0);
        	b2 =	 1 - amA;
        	a0 =	 1 + adA;
        	a1 =	 b1;
        	a2 =	 1 - adA;
        	// !! COOKBOOK:
/*		} else if (type == 16) {	// lowShelf, always variable
			A  		 = pow(10, (dBgain / 40));			// gain is in dB directly
			c0		 = cos(w0);
			sA		 = sqrt(A) * alpha;
			Am1		 = A - 1;
			Ap1		 = A + 1;
			b0 =	 A * (Ap1 - Am1 * c0 + 2 * sA);
        	b1 =	 2 * A * (Am1 - Ap1 * c0);
        	b2 =	 A * (Ap1 - Am1 * c0 - 2 * sA);
        	a0 =	 Ap1 + Am1 * c0 + 2 * sA;
        	a1 =	-2 * (Am1 + Ap1 * c0);
        	a2 =	 Ap1 + Am1 * c0 - 2 * sA;
        	// !! COOKBOOK:
		} else {	// (type == 17)	// highShelf, always variable
			A  		 = pow(10, (dBgain / 40));			// gain is in dB directly
			c0		 = cos(w0);
			sA		 = sqrt(A) * alpha;
			Am1		 = A - 1;
			Ap1		 = A + 1;
			b0 =	 A * (Ap1 + Am1 * c0 + 2 * sA);
			b1 =	-2 * A * (Am1 + Ap1 * c0);
			b2 =	 A * (Ap1 + Am1 * c0 - 2 * sA);
			a0 =	 Ap1 - Am1 * c0 + 2 * sA;
			a1 =	 2 * (Am1 - Ap1 * c0);
			a2 =	 Ap1 - Am1 * c0 - 2 * sA;
			// !! MSP:
*/		} else if (type == 16) {	// lowShelf, always variable
			A  		 = pow(10, (dBgain / 40));			// gain is in dB directly
			Am1		 = A - 1;
			Ap1		 = A + 1;
			alphashelf = (A * A + 1) / Q - Am1 * Am1;
			sA		 = sin(w0) * ((alphashelf < 0) ? 0 : sqrt(alphashelf));
			c0		 = cos(w0);
			b0 =	 A * (Ap1 - Am1 * c0 + sA);
        	b1 =	 2 * A * (Am1 - Ap1 * c0);
        	b2 =	 A * (Ap1 - Am1 * c0 - sA);
        	a0 =	 Ap1 + Am1 * c0 + sA;
        	a1 =	-2 * (Am1 + Ap1 * c0);
        	a2 =	 Ap1 + Am1 * c0 - sA;
        	// !! MSP:
		} else {	// (type == 17)	// highShelf, always variable
			A  		 = pow(10, (dBgain / 40));			// gain is in dB directly
			Am1		 = A - 1;
			Ap1		 = A + 1;
			alphashelf = (A * A + 1) / Q - Am1 * Am1;
			sA		 = sin(w0) * ((alphashelf < 0) ? 0 : sqrt(alphashelf));
			c0		 = cos(w0);
			b0 =	 A * (Ap1 + Am1 * c0 + sA);
			b1 =	-2 * A * (Am1 + Ap1 * c0);
			b2 =	 A * (Ap1 + Am1 * c0 - sA);
			a0 =	 Ap1 - Am1 * c0 + sA;
			a1 =	 2 * (Am1 - Ap1 * c0);
			a2 =	 Ap1 - Am1 * c0 - sA;
		}
	} else {						// zero (-1)		// initial state, zero biquad, (like [filtercoeff~])
		a0, b0				= 1;
		b1, b2, a1, a2		= 0;
	}

	// convert rbj coeffs (b0, b1, b2, a0, a1, a2) to FF0, FF1, FF2, FB1, FB2 (a0, a1, a2, b1, b2)
	a0m		=	1 / a0;
	return (b0 * a0m), (b1 * a0m), (b2 * a0m), (a1 * a0m), (a2 * a0m);	// a0, a1, a2, b1, b2
}


//	//	//	coefficients - dodge/jerse butterworths ish

/*
'buttercoeff()' "type" (available filter types):		// integer to choose filter type
// fixed unity gain:
0		= butterworth lowpass
1		= butterworth highpass
2		= butterworth bandpass							// actually technically a 'multiple-feedback bandpass'	*
3		= butterworth bandreject						// actually technically a 'multiple-feedback notch'		*
// variable gain input:
4		= butterworth lowpass
5		= butterworth highpass
6		= butterworth bandpass							// actually technically a 'multiple-feedback bandpass'	*
7		= butterworth bandreject						// actually technically a 'multiple-feedback notch'		*
// * for 'flattop' band- pass & reject (like [filterdesign]), cascade highpass / lowpass & do some extra maths :-)
*/

// a bit like 'biquadcoeff()' (MSP [filtercoeff~]), but for butterworth filter types
// q for band- pass & reject width, 'funits' is cutoff mode, 'gunits' is gain mode, 'type' switches filter
buttercoeff(cf, gain, q, funits, gunits, type)
{
	// init
	b0				= 1;
	b1, b2, a1, a2	= 0;
	// common
	cf		= fcClip(cf, funits);
	cfdiv	= cf / samplerate;

	// switch filters
	if (type == 0) {									// lowpass, fixed
		cdiv	= 1 / tan_14(pi * cfdiv);
		cdiv2	= cdiv * cdiv;		
		sc		= sqrt2 * cdiv;		// separate (sc + cdiv2) !
		b0	= 1 / (1 + sc + cdiv2);	// 
		b1	= b0 * 2;
		b2	= b0;
		a1	= 2 * b0 * (1 - cdiv2);
		a2	= b0 * (1 - sc + cdiv2);// 
	} else if (type == 1) {								// highpass, fixed
		c		= tan_14(pi * cfdiv);
		c2		= c * c;
		sc		= sqrt2 * c;		// separate (sc + c2) !
		b0	= 1 / (1 + sc + c2);	// 
		b1	= b0 * -2;
		b2	= b0;
		a1	= 2 * b0 * (c2 - 1);
		a2	= b0 * (1 - sc + c2);	// 
	} else if (type == 2) {								// bandpass, fixed
		q		= maximum(q, 1);
		bw		= cf / q;
		bwdiv	= bw / samplerate;
		w		= 2 * cos_73(twopi * cfdiv);
		tdiv	= 1 / (tan_14(pi * bwdiv));
		b0	=  1 / (1 + tdiv);
		b1	=  0;
		b2	=  b0 * -1;
		a1	= -1 * w * b0 * tdiv;
		a2	=  b0 * (tdiv - 1);
	} else if (type == 3) {								// bandreject, fixed
		q		= maximum(q, 1);
		bw		= cf / q;
		bwdiv	= bw / samplerate;
		w		= 2 * cos_73(twopi * cfdiv);
		t		= tan_14(pi * bwdiv);
		b0	= 1 / (1 + t);
		b1	= w * (b0 * -1);
		b2	= b0;
		a1	= b1;
		a2	= b0 * (1 - t);
	} else if ((type >= 4) && (type <= 7)) {
		gainA		 = gain;
		if (gunits == 2) {
			gainA	 = dbtoaApprox(gain);
		}
		if (type == 4) {								// lowpass, variable
			cdiv	= 1 / tan_14(pi * cfdiv);
			cdiv2	= cdiv * cdiv;		
			sc		= sqrt2 * cdiv;
			b0	= 1 / (1 + sc + cdiv2);
			a1	= 2 * b0 * (1 - cdiv2);
			a2	= b0 * (1 - sc + cdiv2);
			b0  = b0 * gainA;
			b1	= b0 * 2;
			b2	= b0;
		} else if (type == 5) {							// highpass, variable
			c		= tan_14(pi * cfdiv);
			c2		= c * c;
			sc		= sqrt2 * c;
			b0	= 1 / (1 + sc + c2);
			a1	= 2 * b0 * (c2 - 1);
			a2	= b0 * (1 - sc + c2);
			b0  = b0 * gainA;
			b1	= b0 * -2;
			b2	= b0;
		} else if (type == 6) {							// bandpass, variable
			q		= maximum(q, 1);
			bw		= cf / q;
			bwdiv	= bw / samplerate;
			w		= 2 * cos_73(twopi * cfdiv);
			tdiv	= 1 / (tan_14(pi * bwdiv));
			b0	=  1 / (1 + tdiv);
			b1	=  0;
			a1	= -1 * w * b0 * tdiv;
			a2	=  b0 * (tdiv - 1);
			b0  =  b0 * gainA;
			b2	=  b0 * -1;
		} else {	// (type == 7)						// bandreject, variable
			q		= maximum(q, 1);
			bw		= cf / q;
			bwdiv	= bw / samplerate;
			w		= 2 * cos_73(twopi * cfdiv);
			t		= tan_14(pi * bwdiv);
			b0	= 1 / (1 + t);
			b1	= w * (b0 * -1);
			a1	= b1;
			a2	= b0 * (1 - t);
			b0  = b0 * gainA;
			b1  = b1 * gainA;
			b2	= b0;
		}
	} else {						// zero				// initial state, zero biquad, (like [filtercoeff~])
		b0				= 1;
		b1, b2, a1, a2	= 0;
	}

	// return dodge/jerse coeffs (b0, b1, b2, a1, a2) as FF0, FF1, FF2, FB1, FB2
	return b0, b1, b2, a1, a2;		// a0, a1, a2, b1, b2
}


//	//	//	no approximations version of 'buttercoeff()', if that is your thang, just add "FULL"

// a bit like 'biquadcoeff()' (MSP [filtercoeff~]), but for butterworth filter types
// q for band- pass & reject width, 'funits' is cutoff mode, 'gunits' is gain mode, 'type' switches filter
buttercoeffFULL(cf, gain, q, funits, gunits, type)
{
	// init
	b0				= 1;
	b1, b2, a1, a2	= 0;
	// common
	cf		= fcClipFULL(cf, funits);
	cfdiv	= cf / samplerate;

	// switch filters
	if (type == 0) {									// lowpass, fixed
		cdiv	= 1 / tan(pi * cfdiv);
		cdiv2	= cdiv * cdiv;		
		sc		= sqrt2 * cdiv;		// separate (sc + cdiv2) !
		b0	= 1 / (1 + sc + cdiv2);	// 
		b1	= b0 * 2;
		b2	= b0;
		a1	= 2 * b0 * (1 - cdiv2);
		a2	= b0 * (1 - sc + cdiv2);// 
	} else if (type == 1) {								// highpass, fixed
		c		= tan(pi * cfdiv);
		c2		= c * c;
		sc		= sqrt2 * c;		// separate (sc + c2) !
		b0	= 1 / (1 + sc + c2);	// 
		b1	= b0 * -2;
		b2	= b0;
		a1	= 2 * b0 * (c2 - 1);
		a2	= b0 * (1 - sc + c2);	// 
	} else if (type == 2) {								// bandpass, fixed
		q		= maximum(q, 1);
		bw		= cf / q;
		bwdiv	= bw / samplerate;
		w		= 2 * cos(twopi * cfdiv);
		tdiv	= 1 / (tan(pi * bwdiv));
		b0	=  1 / (1 + tdiv);
		b1	=  0;
		b2	=  b0 * -1;
		a1	= -1 * w * b0 * tdiv;
		a2	=  b0 * (tdiv - 1);
	} else if (type == 3) {								// bandreject, fixed
		q		= maximum(q, 1);
		bw		= cf / q;
		bwdiv	= bw / samplerate;
		w		= 2 * cos(twopi * cfdiv);
		t		= tan(pi * bwdiv);
		b0	= 1 / (1 + t);
		b1	= w * (b0 * -1);
		b2	= b0;
		a1	= b1;
		a2	= b0 * (1 - t);
	} else if ((type >= 4) && (type <= 7)) {
		gainA		 = gain;
		if (gunits == 2) {
			gainA	 = dbtoa(gain);
		}
		if (type == 4) {								// lowpass, variable
			cdiv	= 1 / tan(pi * cfdiv);
			cdiv2	= cdiv * cdiv;		
			sc		= sqrt2 * cdiv;
			b0	= 1 / (1 + sc + cdiv2);
			a1	= 2 * b0 * (1 - cdiv2);
			a2	= b0 * (1 - sc + cdiv2);
			b0  = b0 * gainA;
			b1	= b0 * 2;
			b2	= b0;
		} else if (type == 5) {							// highpass, variable
			c		= tan(pi * cfdiv);
			c2		= c * c;
			sc		= sqrt2 * c;
			b0	= 1 / (1 + sc + c2);
			a1	= 2 * b0 * (c2 - 1);
			a2	= b0 * (1 - sc + c2);
			b0  = b0 * gainA;
			b1	= b0 * -2;
			b2	= b0;
		} else if (type == 6) {							// bandpass, variable
			q		= maximum(q, 1);
			bw		= cf / q;
			bwdiv	= bw / samplerate;
			w		= 2 * cos(twopi * cfdiv);
			tdiv	= 1 / (tan(pi * bwdiv));
			b0	=  1 / (1 + tdiv);
			b1	=  0;
			a1	= -1 * w * b0 * tdiv;
			a2	=  b0 * (tdiv - 1);
			b0  =  b0 * gainA;
			b2	=  b0 * -1;
		} else {	// (type == 7)						// bandreject, variable
			q		= maximum(q, 1);
			bw		= cf / q;
			bwdiv	= bw / samplerate;
			w		= 2 * cos(twopi * cfdiv);
			t		= tan(pi * bwdiv);
			b0	= 1 / (1 + t);
			b1	= w * (b0 * -1);
			a1	= b1;
			a2	= b0 * (1 - t);
			b0  = b0 * gainA;
			b1  = b1 * gainA;
			b2	= b0;
		}
	} else {						// zero				// initial state, zero biquad, (like [filtercoeff~])
		b0				= 1;
		b1, b2, a1, a2	= 0;
	}

	// return dodge/jerse coeffs (b0, b1, b2, a1, a2) as FF0, FF1, FF2, FB1, FB2
	return b0, b1, b2, a1, a2;		// a0, a1, a2, b1, b2
}


//	//	//	special 'eq' / 'damping' coefficients only (for low/high shelving, or simple 2/3 bands eq's, etc)

// just passes, shelves and peak from 'biquadcoeff()'
eqcoeff(f0, gain, Q, funits, gunits, type)
{
	// init
	a0, b0			= 1;
	b1, b2, a1, a2	= 0;
	// common
	f0			= fcClip(f0, funits);
	Q			= maximum(Q, 0.001);
	w0 			= twopi * f0 / samplerate;				// omega0
	alpha 		= sin_73(w0) / (2 * Q);					// r0
	gainA		= gain;
	if (gunits == 2) {
		gainA	 = dbtoaApprox(gain);
	}

	// switch filters
	if (type == 0) {				// LPF, variable gain
		c0		 = cos_73(w0);
		b1 =	 1 - c0;
		b0 =	 b1 / 2;
		b0 =	 b0 * gainA;
		b1 =	 b1 * gainA;
		b2 =	 b0;
		a0 =	 1 + alpha;
		a1 =	-2 * c0;
		a2 =	 1 - alpha;
	} else if (type == 1) {			// HPF, variable gain
		c0		 = cos_73(w0);
		b0 =	(1 + c0) / 2;
		b0 =	 b0 * gainA;
		b1 =	-1 - c0;
		b1 =	 b1 * gainA;
		b2 =	 b0;
		a0 =	 1 + alpha;
		a1 =	-2 * c0;
		a2 =	 1 - alpha;	
	} else if ((type >= 2) && (type <= 4)) {			// peakEQ, lowShelf, highShelf, always in dB
		dBgain		 = gain;
		if (gunits == 1) {
			dBgain	 = atodb(gain);
		}												// gain is in dB directly, offset for accuracy
		A  		 	 = fastpow(10, (dBgain * 0.025)) + 0.028652;
		if (type == 2) {			// peakEQ, variable gain
			amA		 = alpha * A;
			adA		 = alpha / A;
        	b0 =	 1 + amA;
        	b1 =	-2 * cos_73(w0);
        	b2 =	 1 - amA;
        	a0 =	 1 + adA;
        	a1 =	 b1;
        	a2 =	 1 - adA;
		} else if (type == 3) {		// lowShelf, variable gain
			c0		 = cos_73(w0);
			sA		 = sqrt(A) * alpha;
			Am1		 = A - 1;
			Ap1		 = A + 1;
			b0 =	 A * (Ap1 - Am1 * c0 + 2 * sA);
        	b1 =	 2 * A * (Am1 - Ap1 * c0);
        	b2 =	 A * (Ap1 - Am1 * c0 - 2 * sA);
        	a0 =	 Ap1 + Am1 * c0 + 2 * sA;
        	a1 =	-2 * (Am1 + Ap1 * c0);
        	a2 =	 Ap1 + Am1 * c0 - 2 * sA;
		} else {	// (type == 4)	// highShelf, variable gain
			c0		 = cos_73(w0);
			sA		 = sqrt(A) * alpha;
			Am1		 = A - 1;
			Ap1		 = A + 1;
			b0 =	 A * (Ap1 + Am1 * c0 + 2 * sA);
			b1 =	-2 * A * (Am1 + Ap1 * c0);			// b1 has minor inaccuracy
			b2 =	 A * (Ap1 + Am1 * c0 - 2 * sA);
			a0 =	 Ap1 - Am1 * c0 + 2 * sA;
			a1 =	 2 * (Am1 - Ap1 * c0);
			a2 =	 Ap1 - Am1 * c0 - 2 * sA;
		}
	} else {		// (-1)			// zero				// initial state, zero biquad, (like [filtercoeff~])
		a0, b0				= 1;
		b1, b2, a1, a2		= 0;
	}

	// convert rbj coeffs (b0, b1, b2, a0, a1, a2) to FF0, FF1, FF2, FB1, FB2 (a0, a1, a2, b1, b2)
	a0m		=	1 / a0;
	return (b0 * a0m), (b1 * a0m), (b2 * a0m), (a1 * a0m), (a2 * a0m);	// a0, a1, a2, b1, b2
}


//	//	//	special allpass coefficients only (for building evieve digital phaser cascade)

// R == 1 = Reaktor-ish, R == 0 = MSP-ish
// (see 'allpassBiquadDf2cascade()' above)
allpasscoeff(F, Q, R=0)	// 'F' = Hz / 'Q' = special scale depending on 'R' / 'R' = resonance style flag 0/1 (param)
{
	// setup
	f0		= fcClip(F);
	omega 	= twopi * f0 / samplerate;
	alpha	= sin_73(omega);
	alpha	= R ? alpha * (1 - Q) : alpha / (2 * Q);	// must scale 'Q' externally in correct manner for each 'res style'

	// allpass
	b0		=	 1 - alpha;
	b1		=	-2 * cos_73(omega);
	b2		=	 1 + alpha;

	// convert to FF0, FF1, FF2
	a0m		=	 1 / b2;
	return (b0 * a0m), (b1 * a0m), (b2 * a0m);			// (a0, a1, a2)
}

