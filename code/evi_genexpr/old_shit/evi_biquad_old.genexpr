
//	//	//	"evi_biquad.genexpr"
//	//	//	a collection of biquads and coefficients calculators in GenExpr
//	//	//	by Pete Dowling for evieve, 2015
//	//	//	based on RBJ, Dodge/Jerse, Orfanidis, Massberg
//	//	//	thanks to Alex Harker and Richard Dudas
//	//	//	N.B. - see "evi_svf.genexpr" for modern way of building 12dB sections


//	//	//	local utilities (see "evi_trig.genexpr" & "evi_approx.genexpr" for more)

// cheap cos & sin approximations for coefficients calculations
cosQ73(x)
{
	c1 =  0.999999953464;
	c2 = -0.499999053455;
	c3 =  0.0416635846769;
	c4 = -0.0013853704264;
	c5 =  0.00002315393167;  	

	x2 = x * x;
	return (c1 + x2 * (c2 + x2 * (c3 + x2 * (c4 + c5 * x2))));
}

cos_73(x)
{
	two_over_pi = 0.63661977236758;	// 2 / pi
	x = x % twopi;					// get rid of values > 2 * pi
	if (x < 0) {
		x = -x;						// cos(-x) = cos(x)
	}
	quad = int(x * two_over_pi);	// get quadrant # (0 to 3) we're in
	cosreturn = 0;
	if 				(quad == 0) {
		cosreturn =  cosQ73(x);
	} else if 		(quad == 1) {
		cosreturn = -cosQ73(pi - x);
	} else if 		(quad == 2) {
		cosreturn = -cosQ73(x - pi);
	} else {	//	(quad == 3)
		cosreturn =  cosQ73(twopi - x);
	}
	return cosreturn;
}

sin_73(x)
{
	return cos_73(halfpi - x);
}

//	cheap but accurate tan approximation for buttercoeff()
tanO14(x)
{
	c1 = -34287.4662577359568109624;
	c2 =  2566.7175462315050423295;
	c3 = -26.5366371951731325438;
	c4 = -43656.1579281292375769579;
	c5 =  12244.4839556747426927793;
	c6 = -336.611376245464339493;

	x2 = x * x;
	return (x * (c1 + x2 * (c2 + x2 * c3))) / (c4 + x2 * (c5 + x2 * (c6 + x2)));
}

tan_14(x)
{
	four_over_pi = 1.27323954473516;	// 4 / pi
	threehalfpi = 4.7123889803847;		// 3 * halfpi
	x = x % twopi;						// get rid of values > 2 * pi
	octant = int(x * four_over_pi);		// get octant # (0 to 7)	[int(x * qtrpi) ??]
	tanreturn = 0;
	if 				(octant == 0) {
		tanreturn = 	 tanO14(x					* four_over_pi);
	} else if 		(octant == 1) {
		tanreturn =  1 / tanO14((halfpi - x)		* four_over_pi);
	} else if 		(octant == 2) {
		tanreturn = -1 / tanO14((x - halfpi)		* four_over_pi);
	} else if 		(octant == 3) {
		tanreturn = 	-tanO14((pi - x)			* four_over_pi);
	} else if 		(octant == 4) {
		tanreturn = 	 tanO14((x - pi)			* four_over_pi);
	} else if 		(octant == 5) {
		tanreturn =  1 / tanO14((threehalfpi - x)	* four_over_pi);
	} else if 		(octant == 6) {
		tanreturn = -1 / tanO14((x - threehalfpi)	* four_over_pi);
	} else {	//	(octant == 7)
		tanreturn = 	-tanO14((twopi - x)		* four_over_pi);
	}
	return tanreturn;
}

// cheap but accurate exp approximation for coefficients (more accurate than 'fastexp()')
expA(x0)
{
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;
	x *= x; x *= x; x *= x; x *= x; x *= x;
	return x;
}

// lazy quasi taylor series...
logApprox(x)	// for (x > 0)
{
	// coefs
	y = (x - 1) / (x + 1);
	w = y;
	y = y * y;
	z = 0;

	// follow pattern (could be a for-loop)...
	// (update w)...
	z = z + w;
	w = w * y;
	z = z + w / 3;
	w = w * y;
	z = z + w / 5;
	w = w * y;
	z = z + w / 7;
	// etc?...

	z = z * 2;
	return z;
}

mtofApprox(pitch)					// using 'expA()' for approximated accuracy
{
	mtofA = 440 * expA(0.057762265 * (pitch - 69));
	return mtofA + 0.120906;		// + offset = accurate for input 48..69
}

// excellent accuracy to about +36 dB, after which you are on your own
dbtoaApprox(db)						// using 'expA()' for approximated accuracy
{
	dbtoaA = expA(0.11512925464970 * db);
	return dbtoaA + 0.000128;		// + offset = 0 dB == 1 amplitude
}

// cheaper than above 'dbtoaApprox()', but far less accurate
dbtoaApproxF(db)					// i know this is shit
{
	return fastpow(10, (db * 0.05)) + 0.028652;	// + offset = 0 dB == 1 amplitude
}

// excellent accuracy around amplitude == 1 (-6 +6 dB),
// terrible accuracy very near input == 0 or input == very large
atodbApprox(amplitude)
{
	adbconst	= 8.685889638065036553;
	return 		adbconst * logApprox(abs(amplitude));
}


//	//	//	sections

// two-pole, two-zero Biquad filter,
// "Direct form 1", like MSP [biquad~]
// y(n) = a0 * x(n) + a1 * x(n - 1) + a2 * x(n - 2) – b1 * y(n - 1) – b2 * y(n - 2)
biquadDf1(x, a0, a1, a2, b1, b2)
{
	History x1(0), x2(0), y1(0), y2(0);

	a0w = x * a0;
	a1w = x1 * a1;
	a2w = x2 * a2;
	w = a0w + a1w + a2w;

	b1y = y1 * b1;
	b2y = y2 * b2;
	y = w - b1y - b2y;

	x2 = x1;
	x1 = x;
	y2 = y1;
	y1 = y;

	return y;
}

// two-pole, two-zero Biquad filter,
// "Direct form 2"
// y(n) = a0w(n) + a1w(n - 1) + a2w(n - 2), where w(n) = x(n) - b1w(n - 1) - b2w(n - 2)
biquadDf2(x, a0, a1, a2, b1, b2)
{
	History x1(0), x2(0);

	b1w = x1 * b1;
	b2w = x2 * b2;
	w = x - b1w - b2w;

	a0w = w * a0;
	a1w = x1 * a1;
	a2w = x2 * a2;
	y = a0w + a1w + a2w;

	x2 = x1;
	x1 = w;

	return y;
}

// two-pole, two-zero Biquad filter,
// "Transposed direct form 2"
biquadTdf2(x, a0, a1, a2, b1, b2)
{
	History x1(0), x2(0);

	y = (x * a0) + x2;

	x2 = ((x * a1) - (y * b1)) + x1;
	x1 = (x * a2) - (y * b2);

	return y;
}

// one pole one zero section for odd ordered cascades
polezeroDf1(x, a0, _a1, _a2, b1, _b2)
{
	History y1(0);
//	a1, a2, b2 = 0;

	w = x * a0;
	z = y1 * b1;
	y = w - z;

	y1 = y;

	return y;
}

// 6dB iir, no coef wastage
polezeroDf1s(x, a0, b1)
{
	History y1(0);

	w = x * a0;
	z = y1 * b1;
	y = w - z;

	y1 = y;

	return y;
}


//	//	//	cascades

// biquad direct form 2...
// ...in gen~ cascade form with History()s written out to / read from Data()
// (for building cascades for eq's etc)
biquadDf2cascade(x0, a0, a1, a2, b1, b2, x1, x2)
{
	b1w = x1 * b1;
	b2w = x2 * b2;
	w0 = x0 - b1w - b2w;

	a0w = w0 * a0;
	a1w = x1 * a1;
	a2w = x2 * a2;
	y0 = a0w + a1w + a2w;

	return y0, w0, x1;
}

// biquad direct form 2 but with coefficients reduced rather than repeated for ALLPASS
// in gen~ cascade form with History()s written out to / read from Data()
// for building cascades for phaser fx etc (see 'allpasscoeff()' below)
allpassBiquadDf2cascade(x0, a0, a1, a2, x1, x2)
{
	b1w = x1 * a1;
	b2w = x2 * a0;
	w0 = x0 - b1w - b2w;

	a0w = w0 * a0;
	a1w = x1 * a1;
	a2w = x2 * a2;
	y0 = a0w + a1w + a2w;

	return y0, w0, x1;
}

// biquad transposed direct form 2...
// ...in gen~ cascade form with History()s written out to / read from Data()
// (for building cheap cascades etc)
biquadTdf2cascade(x0, a0, a1, a2, b1, b2, x1, x2)
{
	y0 = (x0 * a0) + x2;

	w2 = ((x0 * a1) - (y0 * b1)) + x1;	// x2
	w1 = (x0 * a2) - (y0 * b2);			// x1

	return y0, w1, w2;
}

// incorrect four-pole using Df2
biquadDf2single(x, a0, a1, a2, b1, b2)
{
	History df2sdummy(0);

	y0	= biquadDf2(x,	a0, a1, a2, b1, b2);
	y	= biquadDf2(y0,	a0, a1, a2, b1, b2);

	return y;
}

// parallel double, for bandreject etc using Df2
biquadDf2parallel(x, a0_1, a1_1, a2_1, b1_1, b2_1, a0_2, a1_2, a2_2, b1_2, b2_2)
{
	History df2ddummy(0);

	y0	= biquadDf2(x,	a0_1, a1_1, a2_1, b1_1, b2_1);
	y1	= biquadDf2(x,	a0_2, a1_2, a2_2, b1_2, b2_2);

	return (y0 + y1) * sqrt1_2;
}

// cascade double, for shelving etc using Df2
biquadDf2double(x, a0_1, a1_1, a2_1, b1_1, b2_1, a0_2, a1_2, a2_2, b1_2, b2_2)
{
	History df2ddummy(0);

	y0	= biquadDf2(x,	a0_1, a1_1, a2_1, b1_1, b2_1);
	y	= biquadDf2(y0,	a0_2, a1_2, a2_2, b1_2, b2_2);

	return y;
}

// cascade three, for simple eq-ing using Df2
biquadDf2triple(x0, a0_1, a1_1, a2_1, b1_1, b2_1, a0_2, a1_2, a2_2, b1_2, b2_2, a0_3, a1_3, a2_3, b1_3, b2_3)
{
	History df2tdummy(0);

	y0	= biquadDf2(x0, a0_1, a1_1, a2_1, b1_1, b2_1);
	y1	= biquadDf2(y0, a0_2, a1_2, a2_2, b1_2, b2_2);
	y2	= biquadDf2(y1, a0_3, a1_3, a2_3, b1_3, b2_3);

	return y2;
}

// cascade three, for simple eq-ing using mathworks I, II, TII cascade
biquadDf2tmw(x0, a0_1, a1_1, a2_1, b1_1, b2_1, a0_2, a1_2, a2_2, b1_2, b2_2, a0_3, a1_3, a2_3, b1_3, b2_3)
{
	History tmwdummy(0);

	y0	= biquadDf1(x0, a0_1, a1_1, a2_1, b1_1, b2_1);
	y1	= biquadDf2(y0, a0_2, a1_2, a2_2, b1_2, b2_2);
	y2	= biquadTdf2(y1, a0_3, a1_3, a2_3, b1_3, b2_3);

	return y2;
}

