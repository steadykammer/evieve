
//	//	//	"evi_svf.genexpr"
//	//	//	topology preserving zero delay feedback svf sections & coefficients calculators for gen~
//	//	//	by Pete Dowling for evieve (in progress)
//	//	//	N.B. - see "evi_biquad.genexpr" for traditional way of building 12dB sections
//	//	//	in general, use 'svfSection()' instead of biquad (as in Ableton Live 'EQ8'), but...
//	//	//	...this file actually offers two different types of sections and different types of coefficients...
//	//	//	...calculators, including 'morphing' filters and all-in-one filter sections
//	//	//	see "evi_sallenkey.genexpr" for sallen & key topology alternatives
//	//	//	thanks to Oli Larkin

//	//	//	based on well known research by:
//	//	//	Andrew Simper (http://cytomic.com/technical-papers)
//	//	//	Vadim Zavalishin (http://www.native-instruments.com/fileadmin/ni_media/downloads/pdf/VAFilterDesign_1.1.1.pdf)
//	//	//	Aaron Wishnick (http://www.dafx14.fau.de/papers/dafx14_aaron_wishnick_time_varying_filters_for_.pdf)
//	//	//	Robin Schmidt (http://www.kvraudio.com/forum/viewtopic.php?f=33&t=350246&start=105)
//	//	//	Raph Levien (https://github.com/google/music-synthesizer-for-android/tree/master/lab)


//	//	//	require here


require("evi_approx");
require("evi_smoothing");


//	//	//	Linear Trap Optimised (Simper)


// sections

svfSection(v0, a0, a1, a2, b0, b1, b2)		// (like Ableton Live 'EQ8')
{
	History	ic1eq(0), ic2eq(0);

	v3		=  v0 - ic2eq;
	v1		= (a0 * ic1eq) + (a1 * v3);
	v2		=  ic2eq + (a1 * ic1eq) + (a2 * v3);
	ic1eq	= (2 * v1) - ic1eq;
	ic2eq	= (2 * v2) - ic2eq;

	return	(b0 * v0) + (b1 * v1) + (b2 * v2);
}

svfSectionS(v0, a0, a1, a2, b0, b1, b2)		// (like Ableton Live 'EQ8')
{
	History	ic1eq(0), ic2eq(0);

	v3		=  v0 - ic2eq;
	v1		= (a0 * ic1eq) + (a1 * v3);
	v2		=  ic2eq + (a1 * ic1eq) + (a2 * v3);
	ic1eq	= (2 * v1) - ic1eq;
	ic2eq	= (2 * v2) - ic2eq;

	// technically we should not need to smooth a0, a1, a2, but we should smooth b0, b1, b2 (cH, cB, cL)
	cH, cB, cL	= cfSmoothLinear3(b0, b1, b2, 1, 0.05);	// base (Hz) / sensitivity (pole - should really be compensated)

	return	(cH * v0) + (cB * v1) + (cL * v2);
}

svfSectionStereo(v0L, v0R, a0, a1, a2, b0, b1, b2)
{
	History	svfssdummy(0);

	yL	= svfSection(v0L, a0, a1, a2, b0, b1, b2);
	yR	= svfSection(v0R, a0, a1, a2, b0, b1, b2);

	return	yL, yR;
}

svfSectionStereoS(v0L, v0R, a0, a1, a2, b0, b1, b2)
{
	History	svfsssdummy(0);

	yL	= svfSectionS(v0L, a0, a1, a2, b0, b1, b2);
	yR	= svfSectionS(v0R, a0, a1, a2, b0, b1, b2);

	return	yL, yR;
}

// quirky case
svfSectionQuad(XLL, XRL, XLH, XRH, a0, a1, a2, b0, b1, b2)
{
	History	svfsmdummy(0);

	YLL	= svfSection(XLL, a0, a1, a2, b0, b1, b2);
	YRL	= svfSection(XRL, a0, a1, a2, b0, b1, b2);
	YLH	= svfSection(XLH, a0, a1, a2, b0, b1, b2);
	YRH	= svfSection(XRH, a0, a1, a2, b0, b1, b2);

	return	YLL, YRL, YLH, YRH;
}

svfSectionQuadS(XLL, XRL, XLH, XRH, a0, a1, a2, b0, b1, b2)
{
	History	svfsmsdummy(0);

	YLL	= svfSectionS(XLL, a0, a1, a2, b0, b1, b2);
	YRL	= svfSectionS(XRL, a0, a1, a2, b0, b1, b2);
	YLH	= svfSectionS(XLH, a0, a1, a2, b0, b1, b2);
	YRH	= svfSectionS(XRH, a0, a1, a2, b0, b1, b2);

	return	YLL, YRL, YLH, YRH;
}

// coefficients

// get all coefficients (use with 'svfSection()')

svfCoeff(hz, db, q, filter)
{
			a0, a1, a2		= 1, 1, 1;
			b0, b1, b2		= 0;

	if					   ((filter > 0) && (filter < 7)) {
			g	= mtnA(pi * hz / samplerate);
			A	= expA(0.11512925464970 * db) + 0.000128;// dBtoA
			k	= 1 / q;							// 'adaptive Q' goes here ...
			a0	= 1 / (1 + g * (g + k));
			a1	= g * a0;
			a2	= g * a1;

		if					(filter == 1) {			// LOWPASS
				b0	=  0;
				b1	=  0;
				b2	=  1;
		} else if			(filter == 2) {			// BANDPASS (CLASSIC)
				b0	=  0;
				b1	=  1;
				b2	=  0;
		} else if			(filter == 3) {			// HIGHPASS
				b0	=  1;
				b1	= -k;
				b2	= -1;
		} else if			(filter == 4) {			// PEAK
				b0	=  1;
				b1	= -k;
				b2	= -2;
		} else if			(filter == 5) {			// NOTCH
				b0	=  1;
				b1	= -k;
				b2	=  0;
		} else {	//		(filter == 6)			// RESONANT (BANDPASS) (requires much higher 'q')
				b0	=  0;
				b1	=  k;
				b2	=  0;
		}
//		} else {	//		(filter == 7) {			// ALLPASS (SHITE, need to fix)
//				b0	=  1;
//				b1	= -k;	// ?!
//				b2	=  1;
//		}
			// gain stage incorrect for PEAK & NOTCH ?
			b0	= b0 * A;
			b1	= b1 * A;
			b2	= b2 * A;

	} else if ((filter >= 7) && (filter <= 9)) {
			A	= fastpow(10, (db * 0.025)) + 0.028652;
			A2	= A * A;
			g	= mtnA(pi * hz / samplerate);

		if					(filter == 7) {			// BELL
			k	= 1 / (q * A);
			a0	= 1 / (1 + g * (g + k));
			a1	= g * a0;
			a2	= g * a1;

				b0	= 1;
				b1	= k * (A2 - 1);
				b2	= 0;
		} else {	//		(filter == 8 || 9)
			sA	= sqrt(A);

			if				(filter == 8) {			// LOWSHELF
			g	= g / sA;
			k	= 1 / q;
			a0	= 1 / (1 + g * (g + k));
			a1	= g * a0;
			a2	= g * a1;

				b0	= 1;
				b1	= k * (A - 1);
				b2	= A2 - 1;
			} else {	//	(filter == 9)			// HIGHSELF
			g	= g * sA;
			k	= 1 / q;
			a0	= 1 / (1 + g * (g + k));
			a1	= g * a0;
			a2	= g * a1;

				b0	= A2;
				b1	= k * (1 - A) * A;
				b2	= 1 - A2;
			}
		}
	} else {	//			(filter <= 0 || >= 10)	// BYPASS
				a0, a1, a2		= 0;
				b0, b1, b2		= 1, 1, 1;
	}

	return	a0, a1, a2, b0, b1, b2;
}

// get eq type coefficients only (use with 'svfSection()') (like Ableton Live 'EQ8')

svfCoeffEq(hz, db, q, filter)						// filter: 0=bypass, 1=highpass, 2=lowshelf, 3=notch, 4=bell, 5=highshelf, 6=lowpass
{
			a0, a1, a2		= 1, 1, 1;
			b0, b1, b2		= 0;

	if					   ((filter == 1) || (filter == 3) || (filter == 6)) {
			g	= mtnA(pi * hz / samplerate);
			A	= expA(0.11512925464970 * db) + 0.000128;// dBtoA
			k	= 1 / q;							// 'adaptive Q' goes here ...

			a0	= 1 / (1 + g * (g + k));
			a1	= g * a0;
			a2	= g * a1;

		if					(filter == 6) {			// LOWPASS
				b0	=  0;
				b1	=  0;
				b2	=  1;
		} else if			(filter == 1) {			// HIGHPASS
				b0	=  1;
				b1	= -k;
				b2	= -1;
		} else {	//		(filter == 3)			// NOTCH
				b0	=  1;
				b1	= -k;
				b2	=  0;
		}

			b0	= b0 * A;
			b1	= b1 * A;
			b2	= b2 * A;

	} else if ((filter == 2) || (filter == 4) || (filter == 5)) {
			A	= fastpow(10, (db * 0.025)) + 0.028652;
			A2	= A * A;
			g	= mtnA(pi * hz / samplerate);

		if					(filter == 4) {			// BELL
			k	= 1 / (q * A);
			a0	= 1 / (1 + g * (g + k));
			a1	= g * a0;
			a2	= g * a1;

				b0	= 1;
				b1	= k * (A2 - 1);
				b2	= 0;
		} else {	//		(filter == 2 || 5)
			sA	= sqrt(A);

			if				(filter == 2) {			// LOWSHELF
			g	= g / sA;
			k	= 1 / q;
			a0	= 1 / (1 + g * (g + k));
			a1	= g * a0;
			a2	= g * a1;

				b0	= 1;
				b1	= k * (A - 1);
				b2	= A2 - 1;
			} else {	//	(filter == 5)			// HIGHSELF
			g	= g * sA;
			k	= 1 / q;
			a0	= 1 / (1 + g * (g + k));
			a1	= g * a0;
			a2	= g * a1;

				b0	= A2;
				b1	= k * (1 - A) * A;
				b2	= 1 - A2;
			}
		}
	} else {	//			(filter <= 0 || >= 7)	// BYPASS
				a0, a1, a2		= 0;
				b0, b1, b2		= 1, 1, 1;
	}

	return	a0, a1, a2, b0, b1, b2;
}


// eq sections

// !! N.B. - in GenExpr the amount of inputs/outputs we have available to functions is limited, so rather than the more obvious...
// ...building of cascades and then applying coefficients, we build complete sections so we can cascade them inline

svfSectionCoeff(x, F, G, Q, filt)					// filt: 0=bypass, 1=highpass, 2=lowshelf, 3=notch, 4=bell, 5=highshelf, 6=lowpass
{
	History	svfscmdummy(0);

	y			= 0;
	gainfilt	= (filt == 2) || (filt == 4) || (filt == 5);
	if ((G != 0) && (gainfilt)) {					// cpu off if dB gain of a gain-filter == 0
		a0, a1, a2, b0, b1, b2	= svfCoeffEq(F, G, Q, filt);
		y		= svfSection(x, a0, a1, a2, b0, b1, b2);
	} else if ((filt != 0) && (gainfilt == 0)) {	// cpu on if using non-gain-filter (regardless of applied gain)
		a0, a1, a2, b0, b1, b2	= svfCoeffEq(F, G, Q, filt);	// if filt does == 0 we at least do not process coefficients
		y		= svfSection(x, a0, a1, a2, b0, b1, b2);
	} else {										// thru & cpu bypass
		y		= x;
	}

	return		y;
}

svfSectionCoeffS(x, F, G, Q, filt)					// filt: 0=bypass, 1=highpass, 2=lowshelf, 3=notch, 4=bell, 5=highshelf, 6=lowpass
{
	History	svfscmdummy(0);

	y			= 0;
	gainfilt	= (filt == 2) || (filt == 4) || (filt == 5);
	if ((G != 0) && (gainfilt)) {					// cpu off if dB gain of a gain-filter == 0
		a0, a1, a2, b0, b1, b2	= svfCoeffEq(F, G, Q, filt);
		y		= svfSectionS(x, a0, a1, a2, b0, b1, b2);
	} else if ((filt != 0) && (gainfilt == 0)) {	// cpu on if using non-gain-filter (regardless of applied gain)
		a0, a1, a2, b0, b1, b2	= svfCoeffEq(F, G, Q, filt);	// if filt does == 0 we at least do not process coefficients
		y		= svfSectionS(x, a0, a1, a2, b0, b1, b2);
	} else {										// thru & cpu bypass
		y		= x;
	}

	return		y;
}

svfSectionCoeffStereo(xL, xR, F, G, Q, filt)		// filt: 0=bypass, 1=highpass, 2=lowshelf, 3=notch, 4=bell, 5=highshelf, 6=lowpass
{
	History	svfscsdummy(0);

	yL, yR	 	= 0;
	gainfilt	= (filt == 2) || (filt == 4) || (filt == 5);
	if ((G != 0) && (gainfilt)) {					// cpu off if dB gain of a gain-filter == 0
		a0, a1, a2, b0, b1, b2	= svfCoeffEq(F, G, Q, filt);
		yL, yR	= svfSectionStereo(xL, xR, a0, a1, a2, b0, b1, b2);
	} else if ((filt != 0) && (gainfilt == 0)) {	// cpu on if using non-gain-filter (regardless of applied gain)
		a0, a1, a2, b0, b1, b2	= svfCoeffEq(F, G, Q, filt);	// if filt does == 0 we at least do not process coefficients
		yL, yR	= svfSectionStereo(xL, xR, a0, a1, a2, b0, b1, b2);
	} else {										// thru & cpu bypass
		yL, yR	= xL, xR;
	}

	return		yL, yR;
}

svfSectionCoeffStereoS(xL, xR, F, G, Q, filt)		// filt: 0=bypass, 1=highpass, 2=lowshelf, 3=notch, 4=bell, 5=highshelf, 6=lowpass
{
	History	svfscsdummy(0);

	yL, yR	 	= 0;
	gainfilt	= (filt == 2) || (filt == 4) || (filt == 5);
	if ((G != 0) && (gainfilt)) {					// cpu off if dB gain of a gain-filter == 0
		a0, a1, a2, b0, b1, b2	= svfCoeffEq(F, G, Q, filt);
		yL, yR	= svfSectionStereoS(xL, xR, a0, a1, a2, b0, b1, b2);
	} else if ((filt != 0) && (gainfilt == 0)) {	// cpu on if using non-gain-filter (regardless of applied gain)
		a0, a1, a2, b0, b1, b2	= svfCoeffEq(F, G, Q, filt);	// if filt does == 0 we at least do not process coefficients
		yL, yR	= svfSectionStereoS(xL, xR, a0, a1, a2, b0, b1, b2);
	} else {										// thru & cpu bypass
		yL, yR	= xL, xR;
	}

	return		yL, yR;
}

// quirky case
svfSectionCoeffQuad(XLL, XRL, XLH, XRH, F, G, Q, filt)	// filt: 0=bypass, 1=highpass, 2=lowshelf, 3=notch, 4=bell, 5=highshelf, 6=lowpass
{
	History	svfscqdummy(0);	

	YLL, YRL, YLH, YRH	 	= 0;
	gainfilt				= (filt == 2) || (filt == 4) || (filt == 5);
	if ((G != 0) && (gainfilt)) {						// cpu off if dB gain of a gain-filter == 0
		a0, a1, a2, b0, b1, b2	= svfCoeffEq(F, G, Q, filt);
		YLL, YRL, YLH, YRH		= svfSectionQuad(XLL, XRL, XLH, XRH, a0, a1, a2, b0, b1, b2);
	} else if ((filt != 0) && (gainfilt == 0)) {		// cpu on if using non-gain-filter (regardless of applied gain)
		a0, a1, a2, b0, b1, b2	= svfCoeffEq(F, G, Q, filt);	// if filt does == 0 we at least do not process coefficients
		YLL, YRL, YLH, YRH		= svfSectionQuad(XLL, XRL, XLH, XRH, a0, a1, a2, b0, b1, b2);
	} else {											// thru & cpu bypass
		YLL, YRL, YLH, YRH	= XLL, XRL, XLH, XRH;
	}

	return					YLL, YRL, YLH, YRH;
}

svfSectionCoeffQuadS(XLL, XRL, XLH, XRH, F, G, Q, filt)	// filt: 0=bypass, 1=highpass, 2=lowshelf, 3=notch, 4=bell, 5=highshelf, 6=lowpass
{
	History	svfscqdummy(0);	

	YLL, YRL, YLH, YRH	 	= 0;
	gainfilt				= (filt == 2) || (filt == 4) || (filt == 5);
	if ((G != 0) && (gainfilt)) {						// cpu off if dB gain of a gain-filter == 0
		a0, a1, a2, b0, b1, b2	= svfCoeffEq(F, G, Q, filt);
		YLL, YRL, YLH, YRH		= svfSectionQuadS(XLL, XRL, XLH, XRH, a0, a1, a2, b0, b1, b2);
	} else if ((filt != 0) && (gainfilt == 0)) {		// cpu on if using non-gain-filter (regardless of applied gain)
		a0, a1, a2, b0, b1, b2	= svfCoeffEq(F, G, Q, filt);	// if filt does == 0 we at least do not process coefficients
		YLL, YRL, YLH, YRH		= svfSectionQuadS(XLL, XRL, XLH, XRH, a0, a1, a2, b0, b1, b2);
	} else {											// thru & cpu bypass
		YLL, YRL, YLH, YRH	= XLL, XRL, XLH, XRH;
	}

	return					YLL, YRL, YLH, YRH;
}


//	//	//	TPT (Zavalishin)


// section

vzSvf(x, g, r, h, s)				// for 's' use range 1..10 (i tend to always use const of 10 (20dB), more is needless)
{
	History	s1(0), s2(0);

	// compute highpass output
	yH	= (x - r * s1 - g * s1 - s2) * h;	// (x - (r + g) * s1 - s2) * h	// ?

	// compute bandpass output by applying 1st integrator to highpass output
	yB	= g * yH + s1;
	s1	= g * yH + yB;				// state update in 1st integrator

	// compute lowpass output by applying 2nd integrator to bandpass output
	yL	= g * yB + s2;
	s2	= g * yB + yL;				// state update in 2nd integrator

	// comment out for linear behavior (warning - this non-linear behavior is CRAP but usable)
	ods	= 1 / s;
	s1	= tnhL(s1 * ods) * s;
	s2	= tnhL(s2 * ods) * s;

	return	yL, yB, yH;				// lowpass, bandpass, highpass
}


// coefficients

// get all coefficients (use with 'vzSvf()')	// !! N.B. - 'G' is amplitude not dB !!

calcVzSvfCoeff(F, G, Q, filter)		// 'F' is Hz (clipped), 'Q' is from bandwidth...
{									// ...'G' is amplitude from dB (must be '1.' for non-gain filters)
	// coefficients
	g, R2		= 0;				// g = embedded integrator gain / R2 = damp
	cL, cB, cH	= 0;				// LP, BP, HP gain staging for core SVF simultaneous outputs

	fc	= PI * F / samplerate;		// pre-warp cutoff for all filter types

	if			(filter == 1) {		// LOWPASS
		g	= tan_14(fc);
		R2	= (1 / Q) / G;			// 'G' adds gain element to standard filter ...
		cL	= 1;					// ... delete if not required
		cB	= 0;
		cH	= 0;
	} else if	(filter == 2) {		// BANDPASS_SKIRT
		g	= tan_14(fc);
		R2	= (1 / Q) / G;
		cL	= 0;
		cB	= 1;
		cH	= 0;
	} else if	(filter == 3) {		// BANDPASS_PEAK
		g	= tan_14(fc);
//		R2	= (1 / Q) / G;			// uncomment for reverse gain use
		R2	= 1 / Q;				// comment out for reverse gain use
		cL	= 0;
		cB	= R2;					// question is whether to include cB in G or not
		cH	= 0;
		R2	= R2 / G;				// comment out for reverse gain use
	} else if	(filter == 4) {		// BANDREJECT
		g	= tan_14(fc);
		R2	= (1 / Q) / G;
		cL	= 1;
		cB	= 0;
		cH	= 1;
	} else if	(filter == 5) {		// HIGHPASS
		g	= tan_14(fc);
		R2	= (1 / Q) / G;
		cL	= 0;
		cB	= 0;
		cH	= 1;
	} else if	(filter == 6) {		// BELL
		g	= tan_14(fc);
		r	= fc / (2 * g * Q);		// access fc for bell
		rr	= r * r;
		r	= g / tan_14(fc / (r + sqrt(rr + 1)));
		r	= r * r;
		rr	= r * r;
		R2	= 2 * sqrt(((rr + 1) / r - 2) / (4 * G));
		cL	= 1;
		cB	= R2 * G;
		cH	= 1;
	} else if	(filter == 7) {		// LOWSHELF
		g	= tan_14(fc);
		A	= sqrt(G);
		g  /= sqrt(A);				// scale SVF-cutoff frequency for shelfs
		R2	= 0.5 / Q;
		R2 += sqrt((R2 * R2) + 1);
		R2 -= 1 / R2;
		cL	= G;
		cB	= R2 * A;
		cH	= 1;
	} else if	(filter == 8) {		// HIGHSHELF
		g	= tan_14(fc);
		A	= sqrt(G);
		g  *= sqrt(A);				// scale SVF-cutoff frequency for shelfs
		R2	= 0.5 / Q;
		R2 += sqrt((R2 * R2) + 1);
		R2 -= 1 / R2;
		cL	= 1;
		cB	= R2 * A;
		cH	= G;
	} else if	(filter == 9) {		// ALLPASS
		g	=  tan_14(fc);
//		R2	= (1 / Q) / G;			// uncomment for reverse gain use
		R2	=  1 / Q;				// comment out for reverse gain use
		cL	=  1;
		cB	= -R2;					// question is whether to include cB in G or not
		cH	=  1;
		R2	=  R2 / G;				// comment out for reverse gain use
	} else {	//	(filter == 0)	// BYPASS
		g	= 0;					// tan_14(halfpi) [tan approx is safely 0]	// 31.820517
		R2	= 1;					// 1 / Q
		cL	= 1; 
		cB	= R2;
		cH	= 1;
	}

	// feedback factor
	h	= 1 / (1 + R2 * g + g * g);	// 1 / (1 + (R2 + g) * g)	// ?

	return	g, R2, h, cL, cB, cH;
}

// get eq coefficients only (use with 'vzSvf()')	// !! N.B. - 'G' is amplitude not dB !!
// filt: 0=bypass, 1=highpass, 2=lowshelf, 3=bell, 4=highshelf, 5=lowpass

calcVzSvfEq(F, G, Q, filter)		// 'F' is Hz (clipped), 'Q' is from bandwidth...
{									// ...'G' is amplitude from dB (must be '1.' for non-gain filters)
	// coefficients
	g, R2		= 0;				// g = embedded integrator gain / R2 = damp
	cL, cB, cH	= 0;				// LP, BP, HP gain staging for core SVF simultaneous outputs

	fc	= PI * F / samplerate;		// pre-warp cutoff for all filter types

	if			(filter == 1) {		// HIGHPASS
		g	= tan_14(fc);
		R2	= (1 / Q) / G;			// 'G' adds gain element to standard filter ...
		cL	= 0;					// ... same for LOWPASS
		cB	= 0;
		cH	= 1;
	} else if	(filter == 2) {		// LOWSHELF
		g	= tan_14(fc);
		A	= sqrt(G);
		g  /= sqrt(A);				// scale SVF-cutoff frequency for shelfs
		R2	= 0.5 / Q;
		R2 += sqrt((R2 * R2) + 1);
		R2 -= 1 / R2;
		cL	= G;
		cB	= R2 * A;
		cH	= 1;
	} else if	(filter == 3) {		// BELL
		g	= tan_14(fc);
		r	= fc / (2 * g * Q);		// access fc for bell
		rr	= r * r;
		r	= g / tan_14(fc / (r + sqrt(rr + 1)));
		r	= r * r;
		rr	= r * r;
		R2	= 2 * sqrt(((rr + 1) / r - 2) / (4 * G));
		cL	= 1;
		cB	= R2 * G;
		cH	= 1;
	} else if	(filter == 4) {		// HIGHSHELF
		g	= tan_14(fc);
		A	= sqrt(G);
		g  *= sqrt(A);				// scale SVF-cutoff frequency for shelfs
		R2	= 0.5 / Q;
		R2 += sqrt((R2 * R2) + 1);
		R2 -= 1 / R2;
		cL	= 1;
		cB	= R2 * A;
		cH	= G;
	} else if	(filter == 5) {		// LOWPASS
		g	= tan_14(fc);
		R2	= (1 / Q) / G;
		cL	= 1;
		cB	= 0;
		cH	= 0;
	} else {	//	(filter == 0)	// BYPASS
		g	= 0;					// tan_14(halfpi) [tan approx is safely 0]	// 31.820517
		R2	= 1;					// 1 / Q
		cL	= 1; 
		cB	= R2;
		cH	= 1;
	}

	// factor for feedback precomputation
	h	= 1 / (1 + R2 * g + g * g);	// 1 / (1 + (R2 + g) * g)	// ?

	return	g, R2, h, cL, cB, cH;
}


// eq sections ('vzSvf()')						

vzSvfSectionCoeff(x, hz, db, q, sat, filt)			// filt: 0=bypass, 1=highpass, 2=lowshelf, 3=bell, 4=highshelf, 5=lowpass
{
	History	vzsvfscmdummy(0);

	y			= 0;
	gainfilt	= (filt == 2) || (filt == 3) || (filt == 4);
	if ((db != 0) && (gainfilt)) {					// cpu off if dB gain of a gain-filter == 0
		g, r, h, cL, cB, cH	= calcVzSvfEq(hz, db, q, filt);
		yL, yB, yH			= vzSvf(x, g, r, h, sat);
		cL, cB, cH			= cfSmoothLinear3(cL, cB, cH, 1, 0.05);
		y					= (cL * yL) + (cB * yB) + (cH * yH);
	} else if ((filt != 0) && (gainfilt == 0)) {	// cpu on if using non-gain-filter (regardless of applied gain)
		g, r, h, cL, cB, cH	= calcVzSvfEq(hz, db, q, filt);
		yL, yB, yH			= vzSvf(x, g, r, h, sat);
		cL, cB, cH			= cfSmoothLinear3(cL, cB, cH, 1, 0.05);
		y					= (cL * yL) + (cB * yB) + (cH * yH);
	} else {										// thru & cpu bypass
		y		= x;
	}

	return		y;
}

vzSvfSectionCoeffStereo(xL, xR, hz, db, q, sat, filt)// filt: 0=bypass, 1=highpass, 2=lowshelf, 3=bell, 4=highshelf, 5=lowpass
{
	History	vzsvfscsdummy(0);

	yL, yR		= 0;
	gainfilt	= (filt == 2) || (filt == 3) || (filt == 4);
	if ((db != 0) && (gainfilt)) {					// cpu off if dB gain of a gain-filter == 0
		g, r, h, cL, cB, cH	= calcVzSvfEq(hz, db, q, filt);
		lyL, lyB, lyH		= vzSvf(xL, g, r, h, sat);
		ryL, ryB, ryH		= vzSvf(xR, g, r, h, sat);
		cL, cB, cH			= cfSmoothLinear3(cL, cB, cH, 1, 0.05);
		yL					= (cL * lyL) + (cB * lyB) + (cH * lyH);
		yR					= (cL * ryL) + (cB * ryB) + (cH * ryH);
	} else if ((filt != 0) && (gainfilt == 0)) {	// cpu on if using non-gain-filter (regardless of applied gain)
		g, r, h, cL, cB, cH	= calcVzSvfEq(hz, db, q, filt);
		lyL, lyB, lyH		= vzSvf(xL, g, r, h, sat);
		ryL, ryB, ryH		= vzSvf(xR, g, r, h, sat);
		cL, cB, cH			= cfSmoothLinear3(cL, cB, cH, 1, 0.05);
		yL					= (cL * lyL) + (cB * lyB) + (cH * lyH);
		yR					= (cL * ryL) + (cB * ryB) + (cH * ryH);
	} else {										// thru & cpu bypass
		yL		= xR;
		yR		= xR;
	}

	return		yL, yR;
}

// quirky case
vzSvfSectionCoeffQuad(XLL, XRL, XLH, XRH, hz, db, q, sat, filt)// filt: 0=bypass, 1=highpass, 2=lowshelf, 3=bell, 4=highshelf, 5=lowpass
{
	History	vzsvfscsdummy(0);

	YLL, YRL, YLH, YRH		= 0;
	gainfilt	= (filt == 2) || (filt == 3) || (filt == 4);
	if ((db != 0) && (gainfilt)) {					// cpu off if dB gain of a gain-filter == 0
		g, r, h, cL, cB, cH	= calcVzSvfEq(hz, db, q, filt);
		llyL, llyB, llyH	= vzSvf(XLL, g, r, h, sat);
		rlyL, rlyB, rlyH	= vzSvf(XRL, g, r, h, sat);
		lhyL, lhyB, lhyH	= vzSvf(XLH, g, r, h, sat);
		rhyL, rhyB, rhyH	= vzSvf(XRH, g, r, h, sat);
		cL, cB, cH			= cfSmoothLinear3(cL, cB, cH, 1, 0.05);
		YLL					= (cL * llyL) + (cB * llyB) + (cH * llyH);
		YRL					= (cL * rlyL) + (cB * rlyB) + (cH * rlyH);
		YLH					= (cL * lhyL) + (cB * lhyB) + (cH * lhyH);
		YRH					= (cL * rhyL) + (cB * rhyB) + (cH * rhyH);
	} else if ((filt != 0) && (gainfilt == 0)) {	// cpu on if using non-gain-filter (regardless of applied gain)
		g, r, h, cL, cB, cH	= calcVzSvfEq(hz, db, q, filt);
		llyL, llyB, llyH	= vzSvf(XLL, g, r, h, sat);
		rlyL, rlyB, rlyH	= vzSvf(XRL, g, r, h, sat);
		lhyL, lhyB, lhyH	= vzSvf(XLH, g, r, h, sat);
		rhyL, rhyB, rhyH	= vzSvf(XRH, g, r, h, sat);
		cL, cB, cH			= cfSmoothLinear3(cL, cB, cH, 1, 0.05);
		YLL					= (cL * llyL) + (cB * llyB) + (cH * llyH);
		YRL					= (cL * rlyL) + (cB * rlyB) + (cH * rlyH);
		YLH					= (cL * lhyL) + (cB * lhyB) + (cH * lhyH);
		YRH					= (cL * rhyL) + (cB * rhyB) + (cH * rhyH);
	} else {										// thru & cpu bypass
		YLL					= XLL;
		YRL					= XRL;
		YLH					= XLH;
		YRH					= XRH;
	}

	return					YLL, YRL, YLH, YRH;
}


// morph coefficients (based on Schmidt)	// (use with 'vzSvf()')	// !! N.B. - dB input !!

calcVzSvfMorph(hz, db, q, morph)							// ...'morph' 0..1 interpolates LP..BP..HP
{
	g	= mtnA(pi * hz / samplerate);
	a	= expA(0.11512925464970 * db) + 0.000128;// dBtoA
	r	= 1 / q;
	x	= 2 * morph - 1;

	cL	= maximum(-x, 0);
	cH	= maximum( x, 0);
	cB	= 1 - (cL + cH);
	cB	= fastpow( cB, 0.25) * 1.02196;// function should map the range 0..1 monotonically
	// 'sc' scaling ensures constant gain at cutoff point
	sc	= q * sqrt((r * r) / (cL * cL + cB * cB + cH * cH - 2 * cL * cH)) * a;
	cL *= sc;
	cB *= sc;
	cH *= sc;

	// feedback factor
	h	= 1 / (1 + r * g + g * g);	// 1 / (1 + (r + g) * g)	// ?

	return	g, r, h, cL, cB, cH;
}


// morph sections

vzSvfMorph(x, hz, db, q, sat, morph)						// ...'morph' 0..1 interpolates LP..BP..HP
{
	History	vzsvfmdummy(0);

	g, r, h, cL, cB, cH	= calcVzSvfMorph(hz, db, q, morph);			// can be all param rate
	yL, yB, yH			= vzSvf(x, g, r, h, sat);					// audio rate loop

	// technically we should not need to smooth g, r, h, but we should smooth cL, cB, cH
	cL, cB, cH			= cfSmoothLinear3(cL, cB, cH, 2, 0.01);

	return	(cL * yL) + (cB * yB) + (cH * yH);
}

vzSvfMorphStereo(xL, xR, hz, db, q, sat, morph)				// ...'morph' 0..1 interpolates LP..BP..HP
{
	History	vzsvfmsdummy(0);

	g, r, h, cL, cB, cH	= calcVzSvfMorph(hz, db, q, morph);			// can be all param rate
	lyL, lyB, lyH		= vzSvf(xL, g, r, h, sat);					// audio rate loop ...
	ryL, ryB, ryH		= vzSvf(xR, g, r, h, sat);					// ...

	// technically we should not need to smooth g, r, h, but we should smooth cL, cB, cH
	cL, cB, cH			= cfSmoothLinear3(cL, cB, cH, 2, 0.01);
	mL		= (cL * lyL) + (cB * lyB) + (cH * lyH);
	mR		= (cL * ryL) + (cB * ryB) + (cH * ryH);

	return	mL, mR;
}

// quirky case
vzSvfMorphQuad(xLL, xRL, xLH, xRH, hz, db, q, sat, morph)	// ...'morph' 0..1 interpolates LP..BP..HP
{
	History	vzsvfmqdummy(0);

	g, r, h, cL, cB, cH	= calcVzSvfMorph(hz, db, q, morph);			// can be all param rate
	llyL, llyB, llyH	= vzSvf(xLL, g, r, h, sat);					// audio rate loop ...
	rlyL, rlyB, rlyH	= vzSvf(xRL, g, r, h, sat);					// ...
	lhyL, lhyB, lhyH	= vzSvf(xLH, g, r, h, sat);					// ...
	rhyL, rhyB, rhyH	= vzSvf(xRH, g, r, h, sat);					// ...

	// technically we should not need to smooth g, r, h, but we should smooth cL, cB, cH
	cL, cB, cH			= cfSmoothLinear3(cL, cB, cH, 2, 0.01);
	mLL		= (cL * llyL) + (cB * llyB) + (cH * llyH);
	mRL		= (cL * rlyL) + (cB * rlyB) + (cH * rlyH);
	mLH		= (cL * lhyL) + (cB * lhyB) + (cH * lhyH);
	mRH		= (cL * rhyL) + (cB * rhyB) + (cH * rhyH);

	return mLL, mRL, mLH, mRH;
}


//	//	//	all-in-one sections (Simper)


// LTO

svfLtoMulti(v0, cutoff, Q)
{
	History v0z(0), v1(0), v2(0);

	g	= tnA(pi * cutoff / samplerate);
	k	= 1 / Q;

	ginv	= g / (1 + g * (g + k));
	g1		= ginv;
	g2		= 2 * (g + k) * ginv;
	g3		= g * ginv;
	g4		= 2 * ginv;

	vlz	= v1;
	v2z	= v2;
	v3	= v0 + v0z - 2 * v2z;
	v1 += g1 * v3 - g2 * vlz;
	v2 += g3 * v3 + g4 * vlz;
	v0z	= v0;

	low		= v2;					// low
	band	= v1;					// band
	high	= v0 - k * band - low;	// high
	notch	= v0 - k * band;		// notch
	return	low, band, high, notch;
}

svfLtoSingle(v0, cutoff, Q, filt)
{
	History v0z(0), v1(0), v2(0);

	g	= tnA(pi * cutoff / samplerate);
	k	= 1 / Q;

	ginv	= g / (1 + g * (g + k));
	g1		= ginv;
	g2		= 2 * (g + k) * ginv;
	g3		= g * ginv;
	g4		= 2 * ginv;

	vlz	= v1;
	v2z	= v2;
	v3	= v0 + v0z - 2 * v2z;
	v1 += g1 * v3 - g2 * vlz;
	v2 += g3 * v3 + g4 * vlz;
	v0z	= v0;

	y	= 0;
	if (filt == 1) {
		y	= v2;					// low
	} else if (filt == 2) {
		y	= v1;					// band
	} else if (filt == 3) {
		y	= v0 - k * v1 - v2;		// high
	} else if (filt == 4) {
		y	= v0 - k * v1;			// notch
	} else {	// type == 0 || 5
		y	= 0;					// zero
	}
	return	y;
}

svfLtoBell(v00, cutoff, Q, gain)
{
	History v0z(0), v1(0), v2(0);

	g	= tnA(pi * cutoff / samplerate);
	gb	= fastpow(10, (gain * 0.025)) + 0.028652;
	k	= (1 / Q) / gb;

	gi		= k * (gb * gb - 1);
	ginv	= g / (1 + g * (g + k));
	g1		= ginv;
	g2		= 2 * (g + k) * ginv;
	g3		= g * ginv;
	g4		= 2 * ginv;

	v0	= gi * v00;
	vlz	= v1;
	v2z	= v2;
	v3	= v0 + v0z - 2 * v2z;
	v1 += g1 * v3 - g2 * vlz;
	v2 += g3 * v3 + g4 * vlz;
	v0z	= v0;

	return	v00 + v1;				// bell
}


// solved for SIN (theoretically more stable low-end response when modulating...
// ...but in always-64-bit-doubles environment of Gen should not make much difference...
// ...but these filters are different and interesting and support easy non-linear...
// ...behaviour in a simple way)

svfSinMulti(X, cutoff, damp, sat)			// 'sat' is off/on flag 0/1
{
	History ic1eq(0), ic2eq(0);

	k	= 1 - (damp * 0.992);//1 - damp;	// shitty
	w	= pi * cutoff / samplerate;
	s1	= sin_73(w);
	s2	= sin_73(2 * w);
	nrm	= 1 / (2 + (k * s1));				// k == damp
	g0	= s2 * nrm;
	g1	= ((-2 * s1 * s1) - (k * s2)) * nrm;
	g2	= (2 * s1 * s1) * nrm;

	t0	= X  -  ic2eq;						// X == v0
	gt1	= g1 *  ic1eq;
	gt0	= g0 *  ic1eq;
	if (sat) {								// tnhL (tanh) = stkr addition...
		gt1 = tnhL(gt1 * 2) * 0.5;			// ...needs minor retuning but works well
		gt0	= tnhL(gt0 * 2) * 0.5;
	}
	t1	= (g0 * t0) + gt1;
	t2	= (g2 * t0) + gt0;

	band	=  t1   +  ic1eq;				// band == v1
	low		=  t2   +  ic2eq;				// low  == v2
	high	= (X    - (damp * band)) - low;
	peak	=  high -  low;
	notch	=  high +  low;

	ic1eq  += 2 * t1;
	ic2eq  += 2 * t2;

	return low, band, high, peak, notch;
}

svfSinSingle(X, cutoff, damp, sat, filt)	// 'sat' off/on flag 0/1, 'filt' int 0..4
{
	History ic1eq(0), ic2eq(0);

	k	= 1 - (damp * 0.992);//1 - damp;	// shitty
	w	= pi * cutoff / samplerate;
	s1	= sin_73(w);
	s2	= sin_73(2 * w);
	nrm	= 1 / (2 + (k * s1));				// k == damp
	g0	= s2 * nrm;
	g1	= ((-2 * s1 * s1) - (k * s2)) * nrm;
	g2	= (2 * s1 * s1) * nrm;

	t0	= X  -  ic2eq;						// X == v0
	gt1	= g1 *  ic1eq;
	gt0	= g0 *  ic1eq;
	if (sat) {								// tnhL (tanh) = stkr addition...
		gt1 = tnhL(gt1 * 2) * 0.5;			// ...needs minor retuning but works well
		gt0	= tnhL(gt0 * 2) * 0.5;
	}
	t1	= (g0 * t0) + gt1;
	t2	= (g2 * t0) + gt0;

	y	= 0;
	if 				(filt == 0) {			// default lowpass
		y		= t2 + ic2eq;				// low == v2
	} else if 		(filt == 1) {
		y		= t1 + ic1eq;				// band == v1
	} else {	//	(filt > 1) {
		band	= t1 + ic1eq;				// band
		low		= t2 + ic2eq;				// low
		high	= (X - (k * band)) - low;	// high
//		high	= (X - (k * k * band)) - low;//interesting
		if			(filt == 2) {
			y	= high;						// high
		} else if	(filt == 3) {
			y	= high - low;				// peak
		} else if	(filt == 4) {
			y	= high + low;				// notch
		} else {
			y	= X;						// bypass
		}
	}

	ic1eq	+= 2 * t1;
	ic2eq	+= 2 * t2;

	return	y;
}

