
require("evi_approx.genexpr");

// 2-band 2-pole Linkwitz-Riley, -6dB crossover points, sums perfectly

eviXover2pole2band(X, xover)                    // xover = frequency in Hz
{
    History	state1(0), state2(0);
    w2  = tanA2(xover * PI / samplerate);

    // sum
    s1  = state1;
    g2	= w2 * w2;
    s2	= state2 + (s1 * w2);

    // feedback
    gS	= -(g2 + w2 + w2);                      // invert
    sS	= -(s2 + s1 + s1);

    // solve
    alpha	= 1 / (1 - gS);
    x0	    = ((X * gS) + sS) * alpha;	        // audio input
    y0		= X + x0;						    // y0 = HP2

    // integrator 1, forward
    x1	= y0 * w2;
    y1	= x1 + state1;
    // integrator 2, forward
    x2	= y1 * w2;
    y2	= x2 + state2;			                // y2 = LP2

    // integrator 1, update
    state1	= x1 + y1;
    // integrator 2, update
    state2	= x2 + y2;

    return  y2, -(y0);                          // lowpass, invert highpass
}

// 2-band 4-pole Linkwitz-Riley, -6dB crossover points, sums perfectly

eviXover4pole2band(X, xover)                    // xover = frequency in Hz
{
    History	state1(0), state2(0), state3(0), state4(0);
    w2  = tanA2(xover * PI / samplerate);
    SQRT8 = 2.8284271247461903;                 // = sqrt(8) because butterworth

    // summing
    s1  = state1;
    s2  = state2;
    s3  = state3;
    g2	= w2 * w2;
    g3  = g2 * w2;
    g4  = g3 * w2;
    s2	= state2 + (s1 * w2);
    s3  = state3 + (s2 * w2);
    s4  = state4 + (s3 * w2);

    // feedback
    gS  = -(((w2 + g3) * SQRT8) + (g4 + (g2 * 4)));
    sS  = -(((s1 + s3) * SQRT8) + (s4 + (s2 * 4)));

    // solve
    alpha	= 1 / (1 - gS);
    x0	    = ((X * gS) + sS) * alpha;	        // audio input
    y0		= X + x0;						    // y0 = HP4

    // integrator 1, forward
    x1	= y0 * w2;
    y1	= x1 + state1;
    // integrator 2, forward
    x2	= y1 * w2;
    y2	= x2 + state2;
    // integrator 3, forward
    x3	= y2 * w2;
    y3	= x3 + state3;
    // integrator 4, forward
    x4	= y3 * w2;
    y4	= x4 + state4;			                // y4 = LP4

    // integrator 1, update
    state1		= x1 + y1;
    // integrator 2, update
    state2		= x2 + y2;
    // integrator 3, update
    state3		= x3 + y3;
    // integrator 4, update
    state4		= x4 + y4;

    return  y4, y0;                             // lowpass, highpass
}

// 3-bands, sums perfectly with allpass alignment

eviXover2pole3band(X, xoverLow, xoverHigh)
{
    History ex23dummy(0);

    LOW, SPLIT  = eviXover2pole2band(X, xoverLow);
    MID, HIGH   = eviXover2pole2band(SPLIT, xoverHigh);

    // when summing down stream you must sum LOW via 1-pole allpass alignment
    return  LOW, MID, HIGH;
}

eviXover4pole3band(X, xoverLow, xoverHigh)
{
    History ex43dummy(0);

    LOW, SPLIT  = eviXover4pole2band(X, xoverLow);
    MID, HIGH   = eviXover4pole2band(SPLIT, xoverHigh);

    // when summing down stream you must sum LOW via 2-pole allpass alignment
    return  LOW, MID, HIGH;
}

// allpass filters for summing 3-bands

eviXoverAllpass1(X, xoverHigh)
{
    History s(0);
    w2  = tanA2(xoverHigh * PI / samplerate);

    x0  = ((X * -w2) - s) * (1 / (1 + w2));
    y0  = X + x0;                               // y0 = HP1

    x1  = y0 * w2;
    y1  = x1 + s;                               // y1 = LP1

    s   = x1 + y1;

    return y1 - y0;                             // allpass
}

