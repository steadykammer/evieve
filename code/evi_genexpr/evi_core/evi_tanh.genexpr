
//	//	//	tanh approximations
//	//	//	by Pete for evieve

// for other approximations in evieve @see:
// evi_approx.genexpr
// evi_trig.genexpr
// evi_cossin.genexpr
// evi_pade.genexpr
// evi_fastskew.genexpr

require("evi_approx.genexpr");


// 'high quality' Lambert approx, excellent mathematical and sonic closeness to 'real' tanh
// !! amplitude of 'x' must be clamped ± 120 dB otherwise numerical innacuracy !!
tanhL(x)
{
	x2 = x * x;
	a = (((x2 + 378) * x2 + 17325) * x2 + 135135) * x;
	b = ((28 * x2 + 3150) * x2 + 62370) * x2 + 135135;
	return clamp((a / b), -1, 1);				// is the output clamp really required ??
}

tanhLxA(x, a)
{
	return	tanhL(x / a) * a;
}

// by fire-sledge / antto
// @see: http://www.kvraudio.com/forum/viewtopic.php?f=33&t=262823&start=45
// we use this for some of the Adaa methods
tanhO(x)
{
	xa		= abs(x);
	x2		= xa * xa;
	x3		= xa * x2;
	x4		= x2 * x2;
	x7		= x3 * x4;
	res		= 1 - (1 / (1 + xa + x2 + 0.58576695 * x3 + 0.55442112 * x4 + 0.057481508 * x7));
	return	(x > 0) ? res : -res;
}

// 'bright'
tanhA(x)
{
  x = x + x;
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x) * x) * x;
	x *= x; x *= x; x *= x; x *= x; x *= x;		// exp
	y = -1 / (x + 1);
	return (y + y) + 1;												// tanh
}

// 'dark', cheapest
tanhD(x)
{
	x		= clip(x, -3, 3);
	return	x * ((27 + (x * x)) / (27 + (9 * (x * x))));
}

// 'dull'
tanhQ(x)
{
	w = x * x;
	y = 0;
	if (w <= 6.25) {
		y = (0.913415 + (-0.18436 + (0.024184 - 0.00127468 * w) * w) * w) * x;
	} else {
		w = 1 + 0.125 * abs(x) + 0.0078125 * w;
		w *= w; w *= w; w *= w; w *= w;
		y = (x < 0) ? (1.86033 / w - 1) : (1 - 1.86033 / w);
	}
	return y;
}

// 'crap'
tanhR(x0)
{
	x1	= (x0 * 1.84726402473396);										// * (7.38905609893584 / 4);
	ex	= 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x1) * x1) * x1;
	ex *= ex; ex *= ex; ex *= ex; ex *= ex; ex *= ex;	// ex = pow(7.38905609893584, x);
	return ((ex - 1) / (ex + 1));
}


// adaa

// these are the antiderivatives of the approximation, not of a real tanh - that is crucial !
// sadly we still end up with a bloody Li2 in the 2nd order :-(

// note: this tanh approx becomes not-tanh-like above about +22dB input gain (wave folds)
// note: the entire approx is -6dB down, but we boost it on input before adaa to match tanh()

altTanhF0(x)
{
	// not one of the better tanh() approxes, but the antiderivatives are more
	// manageable than many of the others, swings and roundabouts
    xx = x + x;
	ex = (-1 / (exp(xx) + 1));
	return ex + ex + 1;
}

altTanhF00(x)
{
    xx = x + x;
	ex = (-1 / (expApprox(xx) + 1));
	return ex + ex + 1;
}

altTanhF1(x)
{
//  xx = x + x;
	lex = log(exp(x) + 1); // not exp- or log- Approx() !
	return lex + lex - x;
}

// broken
altTanhF11(x)
{
	lex = logApprox(expApprox(x) + 1); // ok for just Adaa1 ? no
	return lex + lex - x;
}
/*
altTanhF20(x)
{
	li2ex = Li2(-exp(x)); // not approxes !
	return -(li2ex + li2ex + li2ex + li2ex + x*x) * 0.5;
}
*/
altTanhF2(x)
{
	li2ex = Li2Approx(-exp(x)); // not expApprox() !
	return -(li2ex + li2ex + li2ex + li2ex + x*x) * 0.5;
}

altTanhF22(x)
{
	li2ex = Li2Approx(-expApprox(x));
	return -(li2ex + li2ex + li2ex + li2ex + x*x) * 0.5;
}

// first order antiderivative method

// this is broken - gain staging is wrong (requires more gain to reach same as adaa2)
// but apart from that it works!
altTanhAdaa1(x0, reset)
{
	History x1(0), s1(0);
	eps = 0.00000001;	// precision
	if (reset) {
		x1 = 0; s1 = 0;
	}

	y1 = x0;
	d0 = x0 - x1;
	s0 = altTanhF1(x0);	// func1    // does not work with F11
	if ((x1 == 0 && s1 == 0) || (abs(d0) < eps)) {	// ill condition
		y1 = altTanhF00(0.5 * (x0 + x1));	// func0
	} else {
		y1 = (s0 - s1) / d0;
	}

	s1 = s0;
	x1 = x0;
	return y1;
}

// second order antiderivative method

// this just about works, but does not
// requires different eps for different gain staging
altTanhAdaa2(x0, reset)
{
	History x1(0), x2(0), s1(0);
//eps = 0.001;	// precision    // only works to +11 dB if using F00 etc
	eps = 0.0000001;	// precision    // does not work low gain
//eps = 0.0000000001;
	if (reset) {
		x1 = 0; x2 = 0; s1 = 0;
	}

	s0 = x0;
	d0 = x0 - x1;
	f2_x1 = altTanhF2(x1);	// func2
	if (abs(d0) < eps) {	// ill condition
		s0 = altTanhF1(0.5 * (x0 + x1));	// func1
	} else {
		s0 = (altTanhF2(x0) - f2_x1) / d0;	// func2
	}

	y1 = x0;
	d1 = x0 - x2;
	if (x1 == 0 && x2 == 0) {	// ill condition
		y1 = altTanhF0(x0 + (x1 + x1) + x2) * 0.25;	// func0
	} else if (abs(d1) < eps) {	// ill condition
		x_bar = 0.5 * (x0 + x2);
		x_delta = x_bar - x1;
		if (x_delta < eps) {	// ill condition
			y1 = altTanhF0((x_bar + x1) * 0.5);	// func0
		} else {
			y1 = (2 / x_delta) * (altTanhF1(x_bar) + (f2_x1 - altTanhF2(x_bar)) / x_delta);	// func1, func2
		}
	} else {
		s0s1 = s0 - s1;
		y1 = (s0s1 + s0s1) / d1;
	}

	s1 = s0;
	x2 = x1;
	x1 = x0;
	return y1;
}

