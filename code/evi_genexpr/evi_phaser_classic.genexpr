
require("evi_svfs_tpt_filters.genexpr");

History prevNum(4);
Data	allpassCascade(32, 4);
Param	stages(4, min=2, max=32);
maxSections = dim(allpassCascade);
numSections = clamp(int(stages), 2, maxSections);

// Q should be static
gL, rL, hL, _cLL, cBL, _cHL = tptSvfCoeffAllpassNorm(cfL, Q);	// 3.068 ?
gR, rR, hR, _cLR, cBR, _cHR = tptSvfCoeffAllpassNorm(cfR, Q);

// allpass cascade
for (j = 0; j < numSections; j += 1) {
	ap1iL = peek(allpassCascade, j, 0);
	ap2iL = peek(allpassCascade, j, 1);
	ap1iR = peek(allpassCascade, j, 2);
	ap2iR = peek(allpassCascade, j, 3);

	allpassL, ap1oL, ap2oL = tptAllpassCascade(allpassL, gL, rL, hL, cBL, ap1iL, ap2iL);
	allpassR, ap1oR, ap2oR = tptAllpassCascade(allpassR, gR, rR, hR, cBR, ap1iR, ap2iR);

	poke(allpassCascade, ap1oL, j, 0);
	poke(allpassCascade, ap2oL, j, 1);
	poke(allpassCascade, ap1oR, j, 2);
	poke(allpassCascade, ap2oR, j, 3);
}
if (prevNum != numSections) {
	// zero remainder
	for (k = numSections; k < maxSections; k += 1) {
		poke(allpassCascade, 0, k, 0);
		poke(allpassCascade, 0, k, 1);
		poke(allpassCascade, 0, k, 2);
		poke(allpassCascade, 0, k, 3);
	}
	prevNum = numSections;
}

postFilterL = evi_korgms20_select(allpassL, postfiltfreq, postfiltres, filtersmooth=0, oversample=0);
postFilterR = evi_korgms20_select(allpassL, postfiltfreq, postfiltres, filtersmooth=0, oversample=0);

out1 = postFilterL;
out2 = postFilterR;

// feedback

// nonlin / pre filter

