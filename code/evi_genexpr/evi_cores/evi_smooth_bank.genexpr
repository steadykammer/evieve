// ---

logsmooth(x, s)		// x = value			// s = time to drop 6dB (in seconds)
{
	History z(0);
	ad = LN2 / (s * samplerate);			// (0.69314718056 / samples), no maximum check
	y  = ((x - z) * ad) + z;
	z  = y;
	return y;
}

// for log banks
logsad(s)									// s = time to drop 6dB (in seconds)
{
	return	LN2 / (s * samplerate);
//	return	LN2 / maximum((s * samplerate), 1);// (0.69314718056 / samples), incl. maximum check
}

// for log banks
logso(x, ad)
{
	History z(0);
	y = ((x - z) * ad) + z;
	z = y;
	return y;
}

logsmoothBank2(x1, x2, s)
{
	History	logsdummy2(0);
	ad		= logsad(s);
	y1		= logso(x1, ad);
	y2		= logso(x2, ad);
	return	y1, y2;
}

