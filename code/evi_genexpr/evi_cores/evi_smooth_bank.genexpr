// a cheeky and bad file that enables less require dependencies in many .gendsp abstractions
// it is all repeated from "evi_smooth.genexpr" but without any dependencies

expApp(x0)
{
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;
	x *= x; x *= x; x *= x; x *= x; x *= x;
	return x;
}

tauApp(t)									// t = seconds, NOTE: minimum should be 1ms (0.001 seconds)
{
	y = expApp(-1 / (t * samplerate));
	return y + 0.000128;
}

expsmooth(x, t)		// x = value			// t is smooth time in seconds, NOTE: minimum should be 1ms (0.001 seconds)
{
	History w(0), init1(1);
	z = tauApp(t);
	z = z * (1 - init1);
	y = (z * w) + (x * (1 - z));
	w = y;
	init1 = 0;
	return y;
}

// for exp banks
expso(x, z)									// z is pole
{
	History w(0);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expsmoothBank2(x1, x2, t)					// t is smooth time in seconds, NOTE: minimum should be 1ms (0.001 seconds)
{
	History	init2(1);
	z		= tauApp(t);
	z		= z * (1 - init2);				// this means we do not need to do initialisation in expso()
	y1		= expso(x1, z);					// 1st sample pass of y1 & y2 == x1 & x2 respectively
	y2		= expso(x2, z);
	init2	= 0;
	return	y1, y2;
}

expsmoothBank3(x1, x2, x3, t)
{
	History	init3(1);
	z		= tauApp(t);
	z		= z * (1 - init3);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	init3	= 0;
	return	y1, y2, y3;
}

expsmoothBank4(x1, x2, x3, x4, t)
{
	History	init4(1);
	z		= tauApp(t);
	z		= z * (1 - init4);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	y4		= expso(x4, z);
	init4	= 0;
	return	y1, y2, y3, y4;
}

expsmoothBank5(x1, x2, x3, x4, x5, t)
{
	History	init5(1);
	z		= tauApp(t);
	z		= z * (1 - init5);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	y4		= expso(x4, z);
	y5		= expso(x5, z);
	init5	= 0;
	return	y1, y2, y3, y4, y5;
}

expsmoothBank6(x1, x2, x3, x4, x5, x6, t)
{
	History	init6(1);
	z		= tauApp(t);
	z		= z * (1 - init6);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	y4		= expso(x4, z);
	y5		= expso(x5, z);
	y6		= expso(x6, z);
	init6	= 0;
	return	y1, y2, y3, y4, y5, y6;
}

expsmoothBank7(x1, x2, x3, x4, x5, x6, x7, t)
{
	History	init7(1);
	z		= tauApp(t);
	z		= z * (1 - init7);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	y4		= expso(x4, z);
	y5		= expso(x5, z);
	y6		= expso(x6, z);
	y7		= expso(x7, z);
	init7	= 0;
	return	y1, y2, y3, y4, y5, y6, y7;
}

expsmoothBank8(x1, x2, x3, x4, x5, x6, x7, x8, t)
{
	History	init8(1);
	z		= tauApp(t);
	z		= z * (1 - init8);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	y4		= expso(x4, z);
	y5		= expso(x5, z);
	y6		= expso(x6, z);
	y7		= expso(x7, z);
	y8		= expso(x8, z);
	init8	= 0;
	return	y1, y2, y3, y4, y5, y6, y7, y8;
}

// ---

logsmooth(x, s)		// x = value			// s = time to drop 6dB (in seconds)
{
	History z(0), ad1(1);
	y  = ((x - z) * ad1) + z;
	z  = y;									// 1st sample pass z == y == x
	ad1 = LN2 / (s * samplerate);			// (0.69314718056 / samples), no minimum check is actually very dangerous ?
	return y;
}

// for log banks
logsad(s)									// s = time to drop 6dB (in seconds)
{
	return	LN2 / (s * samplerate);
//	return	LN2 / maximum((s * samplerate), 1);// (0.69314718056 / samples), incl. minimum check
}

// for log banks
logso(x, ad)
{
	History z(0);
	y = ((x - z) * ad) + z;
	z = y;
	return y;
}

logsmoothBank2(x1, x2, s)
{
	History	ad2(1);
	y1		= logso(x1, ad2);
	y2		= logso(x2, ad2);
	ad2		= logsad(s);
	return	y1, y2;
}

logsmoothBank3(x1, x2, x3, s)
{
	History	ad3(1);
	y1		= logso(x1, ad3);
	y2		= logso(x2, ad3);
	y3		= logso(x3, ad3);
	ad3		= logsad(s);
	return	y1, y2, y3;
}

logsmoothBank4(x1, x2, x3, x4, s)
{
	History	ad4(1);
	y1		= logso(x1, ad4);
	y2		= logso(x2, ad4);
	y3		= logso(x3, ad4);
	y4		= logso(x4, ad4);
	ad4		= logsad(s);
	return	y1, y2, y3, y4;
}

logsmoothBank5(x1, x2, x3, x4, x5, s)
{
	History	ad5(1);
	y1		= logso(x1, ad5);
	y2		= logso(x2, ad5);
	y3		= logso(x3, ad5);
	y4		= logso(x4, ad5);
	y5		= logso(x5, ad5);
	ad5		= logsad(s);
	return	y1, y2, y3, y4, y5;
}

logsmoothBank6(x1, x2, x3, x4, x5, x6, s)
{
	History	ad6(1);
	y1		= logso(x1, ad6);
	y2		= logso(x2, ad6);
	y3		= logso(x3, ad6);
	y4		= logso(x4, ad6);
	y5		= logso(x5, ad6);
	y6		= logso(x6, ad6);
	ad6		= logsad(s);
	return	y1, y2, y3, y4, y5, y6;
}

logsmoothBank7(x1, x2, x3, x4, x5, x6, x7, s)
{
	History	ad7(1);
	y1		= logso(x1, ad7);
	y2		= logso(x2, ad7);
	y3		= logso(x3, ad7);
	y4		= logso(x4, ad7);
	y5		= logso(x5, ad7);
	y6		= logso(x6, ad7);
	y7		= logso(x7, ad7);
	ad7		= logsad(s);
	return	y1, y2, y3, y4, y5, y6, y7;
}

logsmoothBank8(x1, x2, x3, x4, x5, x6, x7, x8, s)
{
	History	ad8(1);
	y1		= logso(x1, ad8);
	y2		= logso(x2, ad8);
	y3		= logso(x3, ad8);
	y4		= logso(x4, ad8);
	y5		= logso(x5, ad8);
	y6		= logso(x6, ad8);
	y7		= logso(x7, ad8);
	y8		= logso(x8, ad8);
	ad8		= logsad(s);
	return	y1, y2, y3, y4, y5, y6, y7, y8;
}

// ---

tanApp(x)
{
	x2 = (x * x);
	x3 = (x2 * x);
	x5 = (x2 * x3);
	return ((x5 * 0.133333333333) + (x3 * 0.333333333333)) + x;
}

// for cfSmoothLinear()
cfSmoothLinearCoeff(hz, s)		// freq, seconds (NOTE: minimum should be 1ms)
{
	w0		= tanApp(pi * hz / samplerate);
	g0		= (w0 + w0) / (1 + w0);
	s0		= (1 - tauApp(s)) * 4;// this is a bit stupid
	return	  g0, s0;
}

// for cfSmoothLinear()
cfSmoothLinearFilter(x0, g0, s0)
{
	History	low1(0), low2(0);

	low1z	= low1;
	low2z	= low2;

	bandz	= low1z - low2z;
	g		= minimum(g0 + s0 * abs(bandz), 1);

	low1	= low1z + g * (x0 - low1z);
	low2	= low2z + g * (low1 - low2z);

	return	  low2;
}

// inits in the callers

cfSmoothLinear(x1, hz, s)
{
	History	  g0(1), s0(0);
	y1		= cfSmoothLinearFilter(x1, g0, s0);
	g0, s0	= cfSmoothLinearCoeff(hz, s);
	return	  y1;
}

cfSmoothLinear2(x1, x2, hz, s)
{
	History	  g0(1), s0(0);
	y1		= cfSmoothLinearFilter(x1, g0, s0);
	y2		= cfSmoothLinearFilter(x2, g0, s0);
	g0, s0	= cfSmoothLinearCoeff(hz, s);
	return	  y1, y2;
}

