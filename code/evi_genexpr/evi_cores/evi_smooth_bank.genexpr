// a cheeky and bad file that enables less require dependencies in many .gendsp abstractions
// it is all repeated from "evi_smooth.genexpr" but without any dependencies

expApp(x0)
{
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x0) * x0) * x0;
	x *= x; x *= x; x *= x; x *= x; x *= x;
	return x;
}

tauApp(t)									// t = seconds
{
	y = expApp(-1 / (t * samplerate));
	return y + 0.000128;
}

expsmooth(x, t)		// x = value			// t is smooth time in seconds, NOTE: minimum should be 1ms
{
	History w(0);
	z = tauApp(t);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

// for exp banks
expso(x, z)									// z is pole
{
	History w(0);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expsmoothBank2(x1, x2, t)					// t is smooth time in seconds, NOTE: minimum should be 1ms
{
	History	expsdummy2(0);
	z		= tauApp(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	return	y1, y2;
}

