// log smooth (decay) envelope follower
logdecay(x,	d)									// d = decay time (to drop 6dB) in seconds
{
	History	z(0);
	ad		= logsad(d);
	ff		= x - z;
	y		= (ff > 0) ? x : ((ff * ad) + z);
	z		= y;
	return	y;
}

// log smooth (attack/decay) envelope follower
logattackdecay(x, a, d)							// a/d = attack/decay times (to 6dB) in seconds
{
	History	z(0);
	ff		= x - z;
	tt		= (ff > 0) ? a : d;
	ad		= logsad(tt);
	y		= (ff * ad) + z;
	z		= y;
	return	y;
}

// log smooth (AHR) envelope follower
logattackholdrelease(x, a, h, r)				// a/h/r = attack/hold/release times (to 6dB) in seconds
{
	History	z(0), g(0);
	ff		= x - z;
	hh, env	= 0;
	if (ff > 0)	{
		hh	= maximum((h * samplerate), 1) - 1; // no max ??
		env	= logsad(a);
	} else {
		hh	= g - 1;
		env	= (hh > 0.000001) ? 0 : logsad(r);
	}
	y		= (ff * env) + z;
	g		= hh;
	z		= y;
	return	y;
}

// for 'lagsmooth()' & 'lagsmoothThresh()'
lagpole(x, c, l)							// value / coefficient / previous
{
	return ((1 - c) * x) + (c * l);			// no need for abs here ?
}

lagpoleAbs(x, c, l)
{
	return ((1 - abs(c)) * x) + (c * l);
}

// a bit like Supercollider [lag3]
// original by James MacCartney, mod by me, fixed threshold
lagsmooth(v, lp0)							// destination value / time (in seconds)
{
	History coef(  0.9928302477768374);		// default: @20ms @48kHz
	History lp1(0), lp2(0), lp3(0);
	LOGTH	= -6.907755278982137;			// ln(0.001), fixed threshold of 0.001 (-60 dB)
	lp0		= maximum(lp0, 0.008);			// <<-- careful! (this is an empirical number)
	if (change(lp0))
		coef	= maximum(expA(LOGTH / (lp0 * samplerate)), 0);
	lp1		= lagpole(v,	coef,	lp1);
	lp2		= lagpole(lp1,	coef,	lp2);
	lp3		= lagpole(lp2,	coef,	lp3);
	return	lp3;
}

// like Supercollider [lag3]
// original by James MacCartney
// more expensive version with variable threshold
lagsmoothThresh(v, lp0, th)			// destination value / time (in seconds) / threshold (e.g. 0.001)
{
	History coef(0);
	History lp1(0), lp2(0), lp3(0);
	lp0		= maximum(lp0, 0.008);	// <<-- careful!
	if (change(lp0)) {
		coef 	= expApprox(logApprox(th) / (lp0 * samplerate));	// not identical to above, sorry! (slower)
	}
	lp1		= lagpole(v,	coef,	lp1);
	lp2		= lagpole(lp1,	coef,	lp2);
	lp3		= lagpole(lp2,	coef,	lp3);
	return	lp3;
}

// like the poor bastard child of a 'eviSlide()' & 'logsmooth()' & 'eviRampsmooth()' threesome
rampone(x, r, p)
{	// x = value, r = ramp time in samples, p = lin/log
	History current(0);
	s  = x - current;
	xs = p ? s : sign(s);
	rs = minimum(abs(s), (1 / maximum(r, 1)));
	y  = current + (xs * rs);
	current = y;
	return y;
}

// like the bastard twins of a 'rampone()' & 'logdecay()' tryst
ramptwo(x, u, d, p)
{	// x = value, u = ramp up time (samples), d = ramp down time (samples), p = lin/log
	History current(0);
	s   = x - current;
	xs  = p ? s : sign(s);
	ud  = (s > 0) ? (1 / maximum(u, 1)) : (1 / maximum(d, 1));
	uds = minimum(abs(s), ud);
	y   = current + (xs * uds);
	current = y;
	return y;
}

// exact destinations (unlike all above smoothers)

// like MSP [line~], exact destination
eviLine(target, duration)				// target, duration in samples
{
	History val(0);
    trigger	= change(target);
    ramp	= clamp(accum((1 / latch(duration, trigger)), trigger), 0, 1);
    lin 	= eviMap(ramp, 0, 1, latch(val, trigger), latch(target, trigger));
    val 	= lin;
    return  lin, (ramp == 1);
}

// exact destination, with S-curve
eviSline(target, duration)				// target, duration in samples
{
	History	value(0);
	trigger	= change(target);
	ramp	= clip(accum((1 / latch(duration, trigger)), trigger), 0, 1);
	cramp	= eviScurve(ramp);
	curve	= eviMap(cramp, 0, 1, latch(value, trigger), latch(target, trigger));
	value	= curve;
	return	curve, (ramp == 1);
}

