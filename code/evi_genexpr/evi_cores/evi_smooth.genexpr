//	//	//	functions for signal smoothing, etc
//	//	//	collated by Pete for evieve

//	//	//	N.B. the functions here take different units of input and produce varying outputs...
//	//	//	...always check comments local to the function for guidance

require("evi_utilities.genexpr");	// includes "evi_approx.genexpr"


// like Pd / Gen / RNBO smoothstep
stepsmooth(x, y, a)	// in x, in y, interp 0..1
{
	step = clamp((a - x) / (y - a), 0, 1);
	return step * step * (3 - (2 * step));
}

// like Faust [smooth], like 'expsmooth()' without 'tauA()' time compensation
polesmooth(x, s)	// x = value			// s = smoothing amount, pole range, e.g. 0.999
{
	History y0(0);
	y1 = (s * y0) + (x * (1 - s));
	y0 = y1;
	return y1;
}

// excellent cheap generic smoother, fast(er) response
expsmooth(x, t)		// x = value			// t is smooth time in seconds, NOTE: minimum should be 1ms
{
	History w(0);
	z = tauA(t);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

// excellent & cheapest generic smoother, slow(er) response
logsmooth(x, s)		// x = value			// s = time to drop 6dB (in seconds)
{
	History z(0);
	ad = LN2 / (s * samplerate);			// (0.69314718056 / samples), no maximum check
	y  = ((x - z) * ad) + z;
	z  = y;
	return y;
}

// use bipolar for (audio) signals, etc
logsmoothClip(x, s)							// s = time to drop 6dB (in seconds)
{
	History z(0);
	ad = LN2 / maximum((s * samplerate), 1);// (0.69314718056 / samples), incl. maximum check
	y  = ((x - z) * ad) + z;
	z  = y;
	return y;
}

// for exp banks
expso(x, z)									// z is pole
{
	History w(0);
	y = (z * w) + (x * (1 - z));
	w = y;
	return y;
}

expsmoothBank2(x1, x2, t)					// t is smooth time in seconds, NOTE: minimum should be 1ms
{
	History	expsdummy2(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	return	y1, y2;
}

expsmoothBank3(x1, x2, x3, t)
{
	History	expsdummy3(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	return	y1, y2, y3;
}

expsmoothBank4(x1, x2, x3, x4, t)
{
	History	expsdummy4(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	y4		= expso(x4, z);
	return	y1, y2, y3, y4;
}

expsmoothBank5(x1, x2, x3, x4, x5, t)
{
	History	expsdummy5(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	y4		= expso(x4, z);
	y5		= expso(x5, z);
	return	y1, y2, y3, y4, y5;
}

expsmoothBank6(x1, x2, x3, x4, x5, x6, t)
{
	History	expsdummy6(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	y4		= expso(x4, z);
	y5		= expso(x5, z);
	y6		= expso(x6, z);
	return	y1, y2, y3, y4, y5, y6;
}

expsmoothBank7(x1, x2, x3, x4, x5, x6, x7, t)
{
	History	expsdummy7(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	y4		= expso(x4, z);
	y5		= expso(x5, z);
	y6		= expso(x6, z);
	y7		= expso(x7, z);
	return	y1, y2, y3, y4, y5, y6, y7;
}

expsmoothBank8(x1, x2, x3, x4, x5, x6, x7, x8, t)
{
	History	expsdummy8(0);
	z		= tauA(t);
	y1		= expso(x1, z);
	y2		= expso(x2, z);
	y3		= expso(x3, z);
	y4		= expso(x4, z);
	y5		= expso(x5, z);
	y6		= expso(x6, z);
	y7		= expso(x7, z);
	y8		= expso(x8, z);
	return	y1, y2, y3, y4, y5, y6, y7, y8;
}

// for cfSmoothLinear()
cfSmoothLinearCoeff(hz, s)		// freq, seconds (NOTE: minimum should be 1ms)
{
	w0		= tanA(pi * hz / samplerate);
	g0		= (w0 + w0) / (1 + w0);
	s0		= (1 - tauA(s)) * 4;// this is a bit stupid
	return	  g0, s0;
}

// for cfSmoothLinear()
cfSmoothLinearFilter(x0, g0, s0)
{
	History	low1(0), low2(0);

	low1z	= low1;
	low2z	= low2;

	bandz	= low1z - low2z;
	g		= minimum(g0 + s0 * abs(bandz), 1);

	low1	= low1z + g * (x0 - low1z);
	low2	= low2z + g * (low1 - low2z);

	return	  low2;
}

cfSmoothLinear(x1, hz, s)
{
	History	  cfsl1dummy(0);
	g0, s0	= cfSmoothLinearCoeff(hz, s);
	y1		= cfSmoothLinearFilter(x1, g0, s0);
	return	  y1;
}

cfSmoothLinear2(x1, x2, hz, s)
{
	History	  cfsl2dummy(0);
	g0, s0	= cfSmoothLinearCoeff(hz, s);
	y1		= cfSmoothLinearFilter(x1, g0, s0);
	y2		= cfSmoothLinearFilter(x2, g0, s0);
	return	  y1, y2;
}

// the cubic version is much more expensive and very rarely worth it

// for cfSmoothCubic()
cfSmoothCubicCoeff(hz, s)		// freq, seconds (NOTE: minimum should be 1ms)
{
	wc		= hz / samplerate;
	s0		= (1 - tauA(s));	// this is a bit stupid
	return	  wc, s0;
}

// for cfSmoothCubic()
cfSmoothCubicFilter(x0, wc, s0)
{
	History	low1(0), low2(0), inz(0);

	low1z	= low1;
	low2z	= low2;

	bandz	= low1z - low2z;
	wd		= wc + s0 * abs(bandz);
	g		= minimum(wd * (5.9948827 + wd * (-11.969296 + wd * 15.959062)), 1);

	low1	= low1z + g * (0.5 * (x0 + inz) - low1z);
	low2	= low2z + g * (0.5 * (low1 + low1z) - low2z);
	inz		= x0;

	return	  low2;
}

cfSmoothCubic(x1, hz, s)
{
	History	  cfsc1dummy(0);
	wc, s0	= cfSmoothCubicCoeff(hz, s);
	y1		= cfSmoothCubicFilter(x1, wc, s0);
	return	  y1;
}

cfSmoothCubic2(x1, x2, hz, s)
{
	History	  cfsc2dummy(0);
	wc, s0	= cfSmoothCubicCoeff(hz, s);
	y1		= cfSmoothCubicFilter(x1, wc, s0);
	y2		= cfSmoothCubicFilter(x2, wc, s0);
	return	  y1, y2;
}

// coefficients for using a biquad as a smoother, perhaps stupid.
// if we fixed "smooth" we'd only have to update if samplerate changes.
// can be entirely param rate. TODO: use 'cosQ73a()' directly.
smoothCoeff(smooth, q=0.54945)				// (q=0.54945 = 0.09 on normalised scale)
{
	w0		= TWOPI * smooth / SAMPLERATE;	// omega0
	alpha	= sin73aparam(w0) / (q + q);	// r0
	omega 	= cos73aparam(w0);
	a0m		= 1 / (1 + alpha);				// convert to FF0, FF1, FF2, FB1, FB2
	b1a0m	= (1 - omega) * a0m;
	b0a0m	= b1a0m * 0.5;
	return b0a0m, b1a0m, b0a0m, (-(omega + omega) * a0m), ((1 - alpha) * a0m);	// a0, a1, a2, b1, b2
}	// ^^ stupid because we don't need coeffs b0a0m & b1a0m (a0, a1, a2) below 10Hz input.

// for log banks
logsad(s)									// s = time to drop 6dB (in seconds)
{
	return	LN2 / (s * samplerate);
//	return	LN2 / maximum((s * samplerate), 1);// (0.69314718056 / samples), incl. maximum check
}

// for log banks
logso(x, ad)
{
	History z(0);
	y = ((x - z) * ad) + z;
	z = y;
	return y;
}

logsmoothBank2(x1, x2, s)
{
	History	logsdummy2(0);
	ad		= logsad(s);
	y1		= logso(x1, ad);
	y2		= logso(x2, ad);
	return	y1, y2;
}

logsmoothBank3(x1, x2, x3, s)
{
	History	logsdummy3(0);
	ad		= logsad(s);
	y1		= logso(x1, ad);
	y2		= logso(x2, ad);
	y3		= logso(x3, ad);
	return	y1, y2, y3;
}

