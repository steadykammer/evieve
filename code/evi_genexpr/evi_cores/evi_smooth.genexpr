// like MSP [rampsmooth~] if fed by signals at ramp inlets, exact destination
eviRampsmooth(input, frampup, frampdown)		// input, up in samples, down in samples
{
	History value(0), prev(0), stepcounter(0), increment(1);
	rampup = trunc(frampup);	// pete: fixes bug in gen~ examples folder version
	rampdown = trunc(frampdown);
	notify = 1;

	// reset ramp if input has changed, NOT if ramp parameters change
	if (input != prev) {
		direction = (input - value);
		if (direction > 0) {
			stepcounter = rampup;
			increment = direction / rampup;
		} else {
			stepcounter = rampdown;
			increment = direction / rampdown;
		}
		prev = input;	
	}

	// keep incrementing until stepcounter counts down to zero
	if (stepcounter) {
		value += increment;
		stepcounter -= 1;		// pete: i feel like this is actually the correct ordering
		notify = 0;
	} else {
		value = input;
		notify = 1;				// pete: this is lazy, should separate up/down
	}

	return value, notify;
}

// like MSP [rampsmooth~] if fed by ints at ramp inlets, exact destination
// original port by Maurizio Giri, Graham Wakefield
eviRampsmoothUpdate(input, frampup, frampdown)		// input, up in samples, down in samples
{
	History value(0), prev(0), stepcounter(0), increment(1);
	rampup = trunc(frampup);	// pete: fixes bug in gen~ examples folder version
	rampdown = trunc(frampdown);
	notify = 1;

	// reset ramp if input has changed, OR if ramp parameters change
	if (input != prev || delta(rampup) || delta(rampdown)) {
		direction = (input - value);
		if (direction > 0) {
			stepcounter = rampup;
			increment = direction / rampup;
		} else {
			stepcounter = rampdown;
			increment = direction / rampdown;
		}
		prev = input;	
	}

	// keep incrementing until stepcounter counts down to zero
	if (stepcounter) {
		stepcounter -= 1;
		value += increment;
		notify = 0;
	} else {
		value = input;
		notify = 1;				// pete: this is lazy, should separate up/down
	}

	return value, notify;
}

// like MSP [curve~], exact destination
// based on Miller Puckette, David Zicarelli, Graham Wakefield
// the only side effect of using 'expA()' approximation (with no compensation offsets)...
// ...is that 'curvature' values < -0.95 && > 0.95 produce curves not quite as steep as the original...
// ...this is totally fine by me, and probably worth it
// N.B. - this is expensive in gen~ and you should probably avoid using it
eviCurve(target, duration, curvature)		// target, duration in samples, curvature -1..1
{
	History v(0), v0(0), v1(0), vrange(0);			// value: current, from, to, range
	History samplecount(0), samplesremain(0);		// samples elapsed, samples remaining
	History divFactorDuration(0), divExpCurve(0);	// cached values to speed up per-sample loop
	// magic numbers
	RFACTOR		= 4.34782608695652;			// float(1 / 0.23)
	PFACTOR		= 5;
	DIV_RFACTOR	= 0.01310440558293;			// float(1 / (exp(RFACTOR) - 1))
	SFACTOR		= 0.005;

	// calculated only when a new target is set
	if (change(target)) {
		// starting a new ramp
		samplecount = 0;
		// duration in samples
		samplesremain = duration;
		// ramp start & end values
		v0, v1 = v, target;
		// ramp range
		vrange = v1 - v0;
		// nonlinear mapping of -1 to 1 curve factor
		f = 1 - abs(curvature);
		f = PFACTOR * (expA(f * RFACTOR) - 1) * DIV_RFACTOR;
		s = sign(curvature);
		p = (s != 0) ? (s * f) : f;			// must do this to avoid 'curvature == 0' issue
		// bypass really sharp curves
		// 'p = fixdenorm(p);' does not work, values too small, +/- SFACTOR fixed by Puckette / Zicarelli ?
		p = (p >= 0 && p < SFACTOR) ? SFACTOR : ((p < 0 && p > -SFACTOR) ? -SFACTOR : p);
		// cached factors for the per-sample curve calculation
		divExpCurve = 1 / (expA(1 / p) - 1);
		divFactorDuration = 1 / (samplesremain * p);
	}

	value, notify = 0;
	// per sample calculation
	if (samplesremain > 0.5) {				// still ramping
		value	= v;
		notify	= 0;	
		// compute next ramp sample
		samplecount += 1;
		samplesremain -= 1;
		// compute curvature
		curv = (expA(samplecount * divFactorDuration) - 1) * divExpCurve;
		// scale to the output range & integrate
		v += (v0 - v) + (curv * vrange);
	} else {								// no longer ramping
		v		= v1;
		value	= v;
		notify	= 1;
	}

	return value, notify;
}

// like MSP [slide~], i.e. NOT exact destination
// !! not required anymore, Graham Wakefield put this into gen~ native as 'slide()'
eviSlide(x, u, d)							// input, samples up, samples down
{
	History current(0);
	s  = x - current;
	us = s * (1 / (maximum(abs(u), 1)));
	ds = s * (1 / (maximum(abs(d), 1)));
	y  = current + ((x > current) ? us : ds);
	current = fixdenorm(y);
	return y;
}

// vactrols

// A digital model of a vactrol filter, quasi 'analog' in behaviour.
// This needs quite a lot of massaging to work well as 'V' is voltage,
// not impulse as in the other vactrols, @see also:
// evi_vactrol.gendsp & evi_vactrol_fix.gendsp & evi_vactrol_shape.gendsp
likeAvactrol(V, up, down)
{
	History	s0(0);
    aV = abs(V);                        // in case bipolar plugged in

	F  = clip(((s0 > aV) * down) + up, 0.01, HALFPI); // evieve fix
	w2 = tanA2(F * PI / SAMPLERATE);
	g0 = w2 / (w2 + 1);

	G  = (aV - s0) * g0;
	Y  =  G + s0;

	s0 = fixdenorm(G + Y);
	return Y;
}

// Vactrol time-domain behaviour filter.
// @see also: evi_vactrol.gendsp & evi_vactrol_fix.gendsp & evi_vactrol_shape.gendsp

// A basic not-really-a-model of the Perkin Elmer VTL5C3, the resistive
// part of a photoresistive opto-isolator.
// As it turns out, the shape (not the behaviour) can be similar to [slide~]
// in MSP/RNBO or [slide] in gen~, achievable via the @base (Hz) parameter here.

// Based on "A Digital Model of the Buchla Lowpass-Gate"
// by Julian Parker and Stefano D’Angelo, 2013
// "...an ad-hoc nonlinear filter structure that will behave similarly
// to the [Buchla] vactrol with correct setting of parameter values"

// but here in evieve quite different, with setable rise, fall & base

vactrolSection(x, a)					// trigger, time
{
	return x * a / (1 + a);
}

vactrolBuchla(i, r, f, base=1000.)		// impulse, rise (samps), fall (samps), base (Hz)
{
	History s1(0);

	a_base	= base*PI/SAMPLERATE;		// Hz*PI/samplerate
	t_down	= 10 + f*(1 - 0.9*s1);		// fall time
	a_down	= a_base/t_down;
	t_up	= 1 + r*(1 - 0.999*s1);		// rise time
	a_up	= a_base/t_up;

	x		= i - s1;
	x 		= (x < 0) ? vactrolSection(x, a_down) : vactrolSection(x, a_up);
	y		= x + s1;
	s1		= fixdenorm(y + x);
	return	  y;						// & scale externally
}

