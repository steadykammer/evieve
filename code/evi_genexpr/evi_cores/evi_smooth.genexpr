}

logsmoothBank6(x1, x2, x3, x4, x5, x6, s)
{
	History	logsdummy6(0);
	ad		= logsad(s);
	y1		= logso(x1, ad);
	y2		= logso(x2, ad);
	y3		= logso(x3, ad);
	y4		= logso(x4, ad);
	y5		= logso(x5, ad);
	y6		= logso(x6, ad);
	return	y1, y2, y3, y4, y5, y6;
}

logsmoothBank7(x1, x2, x3, x4, x5, x6, x7, s)
{
	History	logsdummy7(0);
	ad		= logsad(s);
	y1		= logso(x1, ad);
	y2		= logso(x2, ad);
	y3		= logso(x3, ad);
	y4		= logso(x4, ad);
	y5		= logso(x5, ad);
	y6		= logso(x6, ad);
	y7		= logso(x7, ad);
	return	y1, y2, y3, y4, y5, y6, y7;
