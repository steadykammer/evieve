//	//	//	tanh approximations
//	//	//	by Pete for evieve

// for other approximations in evieve @see:
// evi_approx.genexpr
// evi_trig.genexpr
// evi_cossin.genexpr
// evi_pade.genexpr
// evi_fastskew.genexpr

// Note: you should be very careful using approximations - they can break your code.
// In evieve all approximations are tested to work on the code in which they are used.


require("evi_approx.genexpr");


// 'high quality' Lambert approx, excellent mathematical and sonic closeness to 'real' tanh
// !! amplitude of 'x' must be clamped ± 120 dB (?!) otherwise numerical innacuracy !!
// in general we always use this one
// 2 x faster than library tanh()
tanhL(x)
{
	x2 = x * x;
	a = (((x2 + 378) * x2 + 17325) * x2 + 135135) * x;
	b = ((28 * x2 + 3150) * x2 + 62370) * x2 + 135135;
	return clamp((a / b), -1, 1);				// is the output clamp really required ??
}

tanhLxA(x, a)
{
	return	tanhL(x / a) * a;
}

// by fire-sledge (LdS)
// @see: http://www.kvraudio.com/forum/viewtopic.php?f=33&t=262823&start=45
// we use this for some of the Adaa methods in evieve
tanhO(x)
{
	xa		= abs(x);
	x2		= xa * xa;
	x3		= xa * x2;
	x4		= x2 * x2;
	x7		= x3 * x4;
	res		= 1 - (1 / (1 + xa + x2 + 0.58576695 * x3 + 0.55442112 * x4 + 0.057481508 * x7));
	return	(x > 0) ? res : -res;
}

// 'bright'
tanhA(x)
{
  x = x + x;
	x = 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x) * x) * x;
	x *= x; x *= x; x *= x; x *= x; x *= x;		// exp
	y = -1 / (x + 1);
	return (y + y) + 1;							// tanh
}

// 'dark', cheapest
tanhD(x)
{
	x		= clip(x, -3, 3);
	return	x * ((27 + (x * x)) / (27 + (9 * (x * x))));
}

// 'dull'
tanhQ(x)
{
	w = x * x;
	y = 0;
	if (w <= 6.25) {
		y = (0.913415 + (-0.18436 + (0.024184 - 0.00127468 * w) * w) * w) * x;
	} else {
		w = 1 + 0.125 * abs(x) + 0.0078125 * w;
		w *= w; w *= w; w *= w; w *= w;
		y = (x < 0) ? (1.86033 / w - 1) : (1 - 1.86033 / w);
	}
	return y;
}

// 'crap'
tanhR(x0)
{
	x1	= (x0 * 1.84726402473396);						// * (7.38905609893584 / 4);
	ex	= 0.999996 + (0.031261316 + (0.00048274797 + 0.000006 * x1) * x1) * x1;
	ex *= ex; ex *= ex; ex *= ex; ex *= ex; ex *= ex;	// ex = pow(7.38905609893584, x);
	return ((ex - 1) / (ex + 1));
}

// mystran's tanh(x)/x approximation, flatlines at very high inputs
// so might not be safe for very large feedback gains
// (limit is 1/15 so very large means ~15 or +23dB)
tanhXdX(x)
{
    a = x * x;
    return ((a + 105) * a + 945) / ((15 * a + 420) * a + 945);
}


// adaa, @see: 'evi_adaa.genexpr' for many more functions

// these are the antiderivatives of the approximation, not of a real tanh - that is crucial !
// sadly we still end up with a bloody Li2 in the 2nd order :-(

// note: the entire approx is -6dB down, but we boost it on input before adaa to match tanh()

tanhF0(x)
{
	// not one of the better tanh() approxes, but the antiderivatives are more
	// manageable than many of the others, swings and roundabouts

	// about 'x + x': would be a real tanh approx, but no good for Adaas; this
	// causes the '-6dB' down issue, but we account for this on inputs to Adaas
	// and then magically the precisions and stability work

	// xx = x + x;
	// ex = (-1 / (exp(xx) + 1)); // this actually gives us less +dB range anyway (no good above +24 dB)
	ex = (-1 / (exp(x) + 1));
	return ex + ex + 1;
}

// also works
tanhF00(x)
{
	ex = (-1 / (expApprox(x) + 1));
	return ex + ex + 1;
}

tanhF1(x)
{
	lex = log(exp(x) + 1); // not exp- or log- Approx() !
	return lex + lex - x;
}

tanhF11(x)
{
	lex = logApprox(expApprox(x) + 1);
	return lex + lex - x;
}

tanhF2(x)
{
	li2ex = Li2Approx(-exp(x)); // not expApprox() !
	return -(li2ex + li2ex + li2ex + li2ex + x*x) * 0.5;
}

tanhF22(x)
{
	li2ex = Li2Approx(-expApprox(x));
	return -(li2ex + li2ex + li2ex + li2ex + x*x) * 0.5;
}

// first order antiderivative method

// this works perfectly, blows up above +50dB input
tanhAdaa1(x, reset)
{
	History x1(0), s1(0);
	eps = 0.00000001;	// precision checked √
	if (reset) {
		x1 = 0; s1 = 0;
	}

	x0 = x * 1.995262;	// (approx is -6dB down)
	y1 = x0;
	d0 = x0 - x1;
	s0 = tanhF1(x0);	// func1    // does not work with F11
	if ((x1 == 0 && s1 == 0) || (abs(d0) < eps)) {	// ill condition
		y1 = tanhF00(0.5 * (x0 + x1));	// func0
	} else {
		y1 = (s0 - s1) / d0;
	}

	s1 = s0;
	x1 = x0;
	return y1;
}

// second order antiderivative method

// this works near perfectly for input audio above -90dB & less than +40dB
// but the lower the input below -90dB the noise floor rises.
// this is acceptable to about -100dB input where the noise floor is at about -900dB
// but is affected by frequency content of the input material anyway
// like the Adaa1, blows up above +50dB input
// the short version: it works fine
tanhAdaa2(x, reset)
{
	History x1(0), x2(0), s1(0);
	// 0.00000000001
	eps = 0.00000001; // precision exact, best across largest frequency ranges
	if (reset) {
		x1 = 0; x2 = 0; s1 = 0;
	}

	x0 = x * 1.995262;	// (approx is -6dB down)
	s0 = x0;
	d0 = x0 - x1;
	f2_x1 = tanhF2(x1);	// func2
	if (abs(d0) < eps) {	// ill condition
		s0 = tanhF1(0.5 * (x0 + x1));	// func1, bizarrely works with F11, but not with very very low gain input
	} else {
		s0 = (tanhF2(x0) - f2_x1) / d0;	// func2
	}

	y1 = x0;
	d1 = x0 - x2;
	if (x1 == 0 && x2 == 0) {	// ill condition
		y1 = tanhF00(x0 + (x1 + x1) + x2) * 0.25;	// func0
	} else if (abs(d1) < eps) {	// ill condition
		x_bar = 0.5 * (x0 + x2);
		x_delta = x_bar - x1;
		if (x_delta < eps) {	// ill condition
			y1 = tanhF00((x_bar + x1) * 0.5);	// func0
		} else { // this non ill condition works with F11 & F22, but only up to about +24dB input gain
			y1 = (2 / x_delta) * (tanhF1(x_bar) + (f2_x1 - tanhF2(x_bar)) / x_delta);	// func1, func2
		}
	} else {
		s0s1 = s0 - s1;
		y1 = (s0s1 + s0s1) / d1;
	}

	s1 = s0;
	x2 = x1;
	x1 = x0;
	return y1;
}

