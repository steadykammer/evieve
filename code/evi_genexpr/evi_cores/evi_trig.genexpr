
// some trigonomic approximations: cos, sin, tan, arctan
// ref: http://www.ganssle.com/approx/sincos.cpp
// also see: http://www.ganssle.com/approx/approx.pdf
// © 2001 The Ganssle Group
// based on "Computer Approximations" by John Hart (ISBN 0-88275-642-7)

// GenExpr code by Pete for evieve
// N.B. - everything in Gen is 64-bit doubles, so no separate casting here - 
// efficiency of less accurate approximations nothing like it would be in C / C++ / etc;
// we also have to use if/else blocks rather than 'switch';
// in evieve we mainly just use some of the cos/sin approxes

// NOTE: in terms of cos/sin CPU savings, only '73' or lower are
// worthwhile, for 121 or higher there is no point over library cos/sin

// for other approximations in evieve @see:
// evi_approx.genexpr
// evi_cossin.genexpr
// evi_pade.genexpr
// evi_tanh.genexpr
// evi_fastskew.genexpr

// Note: you should be very careful using approximations - they can break your code.
// In evieve all approximations are tested to work on the code in which they are used.


// *********************************************************

makeCosPhase(x)
{
	TWOOVERPI = 0.63661977236758;	// 2 / PI
	x = x % TWOPI;					// phasewrap(x) cheaper ?
	x = (x < 0) ? -x : x;
	QUAD = int(x * TWOOVERPI);		// get quadrant # (0..3) we are in
	return x, QUAD;
}

//
//		cosQ32 computes cosine(x)
//
//  Accurate to about 3.2 decimal digits over the range [0, PI/2].
//  The input argument is in radians.
//
//  Algorithm:
//		cos(x)= c1 + c2*x**2 + c3*x**4
//   which is the same as:
//		cos(x)= c1 + x**2(c2 + c3*x**2)
//
cosQ32(x)
{
	c1 =  0.99940307;
	c2 = -0.49558072;
	c3 =  0.03679168;

	x2 =  x * x;
	return (c1 + x2 * (c2 + c3 * x2));
}
//
// This is the main cosine approximation "driver"
// It reduces the input argument's range to [0, PI/2],
// and then calls the approximator. 
//
cos32(x)
{
	x, QUAD = makeCosPhase(x);
	cosreturn = 0;
	if 				(QUAD == 0) {
		cosreturn =  cosQ32(x);
	} else if 		(QUAD == 1) {
		cosreturn = -cosQ32(PI - x);
	} else if 		(QUAD == 2) {
		cosreturn = -cosQ32(x - PI);
	} else {	//	(QUAD == 3)
		cosreturn =  cosQ32(TWOPI - x);
	}
	return cosreturn;
}
//
// The sine is just cosine shifted by HALFPI, so
// we'll adjust the argument and call the cosine approximation.
//
sin32(x)
{
	return cos32(HALFPI - x);
}

// no branching, stay out the while loop in export, for param rate etc

cos32param(x)
{
	x, QUAD = makeCosPhase(x);
	return (QUAD == 0) ? cosQ32(x) : ((QUAD == 1) ? -cosQ32(PI - x) : ((QUAD == 2) ? -cosQ32(x - PI) : cosQ32(TWOPI - x)));
}

sin32param(x)
{
	return cos32param(HALFPI - x);
}

// special, for 0..HALFPI only, cheap cheat not exactly correct

cos32quad12(x)
{
	return (x < 0.636619772368) ? cosQ32(x) : -cosQ32(PI - x);
}

//
//		cosQ52 computes cosine(x)
//
//  Accurate to about 5.2 decimal digits over the range [0, PI/2].
//  The input argument is in radians.
//
//  Algorithm:
//		cos(x)= c1 + c2*x**2 + c3*x**4 + c4*x**6
//   which is the same as:
//		cos(x)= c1 + x**2(c2 + c3*x**2 + c4*x**4)
//		cos(x)= c1 + x**2(c2 + x**2(c3 + c4*x**2))
//
cosQ52(x)
{
	c1 =  0.9999932946;
	c2 = -0.4999124376;
	c3 =  0.0414877472;
	c4 = -0.0012712095;

	x2 = x * x;
	return (c1 + x2 * (c2 + x2 * (c3 + c4 * x2)));
}
//
// This is the main cosine approximation "driver"
// It reduces the input argument's range to [0, PI/2],
// and then calls the approximator. 
//
cos52(x)
{
	x, QUAD = makeCosPhase(x);
	cosreturn = 0;
	if 				(QUAD == 0) {
		cosreturn =  cosQ52(x);
	} else if 		(QUAD == 1) {
		cosreturn = -cosQ52(PI - x);
	} else if 		(QUAD == 2) {
		cosreturn = -cosQ52(x - PI);
	} else {	//	(QUAD == 3)
		cosreturn =  cosQ52(TWOPI - x);
	}
	return cosreturn;
}
//
// The sine is just cosine shifted a HALFPI, so
// we'll adjust the argument and call the cosine approximation.
//
sin52(x)
{
	return cos52(HALFPI - x);
}

// no branching, stay out the while loop in export, for param rate etc

cos52param(x)
{
	x, QUAD = makeCosPhase(x);
	return (QUAD == 0) ? cos52(x) : ((QUAD == 1) ? -cos52(PI - x) : ((QUAD == 2) ? -cos52(x - PI) : cos52(TWOPI - x)));
}

sin52param(x)
{
	return cos52param(HALFPI - x);
}

// sin mixer
/*
	// usage e.g. 3-way mixer:

	m0    = mixSin(in1, 0.5);
	m1    = mixSin(in1, 0);
	m2    = mixSin(in1, -0.5);
*/
mixSin(x, a)
{    // with fudges, 1 extra mul but still cheaper
    return    sin52param(clip((x + a), 0, 1) * PI + 0.000007) * 1.000007;
}

//
//		cosQ73 computes cosine(x)
//
//  Accurate to about 7.3 decimal digits over the range [0, PI/2].
//  The input argument is in radians.
//
//  Algorithm:
//		cos(x)= c1 + c2*x**2 + c3*x**4 + c4*x**6 + c5*x**8
//   which is the same as:
//		cos(x)= c1 + x**2(c2 + c3*x**2 + c4*x**4 + c5*x**6)
//		cos(x)= c1 + x**2(c2 + x**2(c3 + c4*x**2 + c5*x**4))
//		cos(x)= c1 + x**2(c2 + x**2(c3 + x**2(c4 + c5*x**2)))
//
cosQ73(x)
{
	c1 =  0.999999953464;
	c2 = -0.499999053455;
	c3 =  0.0416635846769;
	c4 = -0.0013853704264;
	c5 =  0.00002315393167;  	

	x2 = x * x;
	return (c1 + x2 * (c2 + x2 * (c3 + x2 * (c4 + c5 * x2))));
}
//
// This is the main cosine approximation "driver"
// It reduces the input argument's range to [0, PI/2],
// and then calls the approximator. 
//
// about 1.2 x faster than library cos()
cos73(x)
{
	x, QUAD = makeCosPhase(x);
	cosreturn = 0;
	if 				(QUAD == 0) {
		cosreturn =  cosQ73(x);
	} else if 		(QUAD == 1) {
		cosreturn = -cosQ73(PI - x);
	} else if 		(QUAD == 2) {
		cosreturn = -cosQ73(x - PI);
	} else {	//	(QUAD == 3)
		cosreturn =  cosQ73(TWOPI - x);
	}
	return cosreturn;
}
//
// The sine is just cosine shifted a HALFPI, so
// we'll adjust the argument and call the cosine approximation.
//
sin73(x)
{
	return cos73(HALFPI - x);
}

// no branching, stay out the while loop in export, for param rate etc

cos73param(x)
{
	x, QUAD = makeCosPhase(x);
	return (QUAD == 0) ? cosQ73(x) : ((QUAD == 1) ? -cosQ73(PI - x) : ((QUAD == 2) ? -cosQ73(x - PI) : cosQ73(TWOPI - x)));
}

sin73param(x)
{
	return cos73param(HALFPI - x);
}

/*

//
//		cosQ121 computes cosine(x)
//
//  Accurate to about 12.1 decimal digits over the range [0, PI/2].
//  The input argument is in radians.
//
//  Algorithm:
//		cos(x)= c1 + c2*x**2 + c3*x**4 + c4*x**6 + c5*x**8 + c6*x**10 + c7*x**12
//   which is the same as:
//		cos(x)= c1 + x**2(c2 + c3*x**2 + c4*x**4 + c5*x**6 + c6*x**8 + c7*x**10)
//		cos(x)= c1 + x**2(c2 + x**2(c3 + c4*x**2 + c5*x**4 + c6*x**6 + c7*x**8 ))
//		cos(x)= c1 + x**2(c2 + x**2(c3 + x**2(c4 + c5*x**2 + c6*x**4 + c7*x**6 )))
//		cos(x)= c1 + x**2(c2 + x**2(c3 + x**2(c4 + x**2(c5 + c6*x**2 + c7*x**4 ))))
//		cos(x)= c1 + x**2(c2 + x**2(c3 + x**2(c4 + x**2(c5 + x**2(c6 + c7*x**2 )))))
//
cosQ121(x)
{
	c1 =  0.99999999999925182;
	c2 = -0.49999999997024012;
	c3 =  0.041666666473384543;
	c4 = -0.001388888418000423;
	c5 =  0.0000248010406484558;
	c6 = -0.0000002752469638432;
	c7 =  0.0000000019907856854;

	x2 = x * x;
	return (c1 + x2 * (c2 + x2 * (c3 + x2 * (c4 + x2 * (c5 + x2 * (c6 + c7 * x2))))));
}
//
// This is the main cosine approximation "driver"
// It reduces the input argument's range to [0, PI/2],
// and then calls the approximator. 
//
// about 1.2 x SLOWER than library cos() :-(
cos121(x)
{
	x, QUAD = makeCosPhase(x);
	cosreturn = 0;
	if 				(QUAD == 0) {
		cosreturn =  cosQ121(x);
	} else if 		(QUAD == 1) {
		cosreturn = -cosQ121(PI - x);
	} else if 		(QUAD == 2) {
		cosreturn = -cosQ121(x - PI);
	} else {	//	(QUAD == 3)
		cosreturn =  cosQ121(TWOPI - x);
	}
	return cosreturn;
}
//
// The sine is just cosine shifted a HALFPI, so
// we'll adjust the argument and call the cosine approximation.
//
sin121(x)
{
	return cos121(HALFPI - x);
}

// no branching, stay out the while loop in export, for param rate etc

cos121param(x)
{
	x, QUAD = makeCosPhase(x);
	return (QUAD == 0) ? cosQ121(x) : ((QUAD == 1) ? -cosQ121(PI - x) : ((QUAD == 2) ? -cosQ121(x - PI) : cosQ121(TWOPI - x)));
}

sin121param(x)
{
	return cos121param(HALFPI - x);
}

//
//		cosQ147 computes cosine(x)
//
//  Accurate to about 14.7 decimal digits over the range [0, PI/2].
//  The input argument is in radians.
//
cosQ147(x)
{
	c1 =  0.99999999999999806767;
	c2 = -0.4999999999998996568;
	c3 =  0.04166666666581174292;
	c4 = -0.001388888886113613522;
	c5 =  0.000024801582876042427;
	c6 = -0.0000002755693576863181;
	c7 =  0.0000000020858327958707;
	c8 = -0.000000000011080716368;

	x2 = x * x;
	return c1 + x2 * (c2 + x2 * (c3 + x2 * (c4 + x2 * (c5 + x2 * (c6 + x2 * (c7 + x2 * c8))))));
}
//
// This is the main cosine approximation "driver"
// It reduces the input argument's range to [0, PI/2],
// and then calls the approximator. 
//
cos147(x)
{
	x, QUAD = makeCosPhase(x);
	cosreturn = 0;
	if 				(QUAD == 0) {
		cosreturn =  cosQ147(x);
	} else if 		(QUAD == 1) {
		cosreturn = -cosQ147(PI - x);
	} else if 		(QUAD == 2) {
		cosreturn = -cosQ147(x - PI);
	} else {	//	(QUAD == 3)
		cosreturn =  cosQ147(TWOPI - x);
	}
	return cosreturn;
}
//
// The sine is just cosine shifted a HALFPI, so
// we'll adjust the argument and call the cosine approximation.
//
sin147(x)
{
	return cos147(HALFPI - x);
}

//
//		cosQ202 computes cosine(x)
//
//  Accurate to about 20.2 decimal digits over the range [0, PI/2].
//  The input argument is in radians.
//
cosQ202(x)
{
	c1  =  0.9999999999999999999936329;
	c2  = -0.49999999999999999948362843;
	c3  =  0.04166666666666665975670054;
	c4  = -0.00138888888888885302082298;
	c5  =  0.000024801587301492746422297;
	c6  = -0.00000027557319209666748555;
	c7  =  0.0000000020876755667423458605;
	c8  = -0.0000000000114706701991777771;
	c9  =  0.0000000000000477687298095717;
	c10 = -0.00000000000000015119893746887;

	x2 = x * x;
	return	c1 + x2 * (c2 + x2 * (c3 + x2 * (c4 + x2 * (c5 + x2 * (c6 + x2 * 
				(c7 + x2 * (c8 + x2 * (c9 + x2 * c10))))))));
}
//
// This is the main cosine approximation "driver"
// It reduces the input argument's range to [0, PI/2],
// and then calls the approximator. 
//
cos202(x)
{
	x, QUAD = makeCosPhase(x);
	cosreturn = 0;
	if 				(QUAD == 0) {
		cosreturn =  cosQ202(x);
	} else if 		(QUAD == 1) {
		cosreturn = -cosQ202(PI - x);
	} else if 		(QUAD == 2) {
		cosreturn = -cosQ202(x - PI);
	} else {	//	(QUAD == 3)
		cosreturn =  cosQ202(TWOPI - x);
	}
	return cosreturn;
}
//
// The sine is just cosine shifted a HALFPI, so
// we'll adjust the argument and call the cosine approximation.
//
sin202(x)
{
	return cos202(HALFPI - x);
}

//
//		cosQ231 computes cosine(x)
//
//  Accurate to about 23.1 decimal digits over the range [0, PI/2].
//  The input argument is in radians.
//
cosQ231(x)
{
	c1  =  0.9999999999999999999999914771;
	c2  = -0.4999999999999999999991637437;
	c3  =  0.04166666666666666665319411988;
	c4  = -0.00138888888888888880310186415;
	c5  =  0.00002480158730158702330045157;
	c6  = -0.000000275573192239332256421489;
	c7  =  0.000000002087675698165412591559;
	c8  = -0.0000000000114707451267755432394;
	c9  =  0.0000000000000477945439406649917;
	c10 = -0.00000000000000015612263428827781;
	c11 =  0.00000000000000000039912654507924;

	x2 = x * x;
	return	c1 + x2 * (c2 + x2 * (c3 + x2 * (c4 + x2 * (c5 + x2 * (c6 + x2 * 
				(c7 + x2 * (c8 + x2 * (c9 + x2 * (c10 + x2 * c11)))))))));
}
//
// This is the main cosine approximation "driver"
// It reduces the input argument's range to [0, PI/2],
// and then calls the approximator. 
//
cos231(x)
{
	x, QUAD = makeCosPhase(x);
	cosreturn = 0;
	if 				(QUAD == 0) {
		cosreturn =  cosQ231(x);
	} else if 		(QUAD == 1) {
		cosreturn = -cosQ231(PI - x);
	} else if 		(QUAD == 2) {
		cosreturn = -cosQ231(x - PI);
	} else {	//	(QUAD == 3)
		cosreturn =  cosQ231(TWOPI - x);
	}
	return cosreturn;
}
//
// The sine is just cosine shifted a HALFPI, so
// we'll adjust the argument and call the cosine approximation.
//
sin231(x)
{
	return cos231(HALFPI - x);
}


// *********************************************************

makeTanPhase(x)
{
	FOUROVERPI = 1.27323954473516;		// 4 / PI
	THREEHALFPI = 4.7123889803847;		// 3 * HALFPI
	x = x % TWOPI;						// 
	OCTANT = int(x * FOUROVERPI);		// get OCTANT # (0 to 7)
	return x, OCTANT, FOUROVERPI, THREEHALFPI;
}

//
//		tanO32 computes tan(PI*x/4)
//
//  Accurate to about 3.2 decimal digits over the range [0, PI/4].
//  The input argument is in radians. Note that the function
//  computes tan(PI*x/4), NOT tan(x); it's up to the range
//  reduction algorithm that calls this to scale things properly.
//
//  Algorithm:
//		tan(x)= x*c1/(c2 + x**2)
//
tanO32(x)
{
	c1 = -3.6112171;
	c2 = -4.6133253;

	x2 = x * x;
	return (x * c1 / (c2 + x2));
}
//
// This is the main tangent approximation "driver"
// It reduces the input argument's range to [0, PI/4],
// and then calls the approximator. 
// Enter with positive angles only.
//
// WARNING: We do not test for the tangent approaching infinity,
// which it will at x=PI/2 and x=3*PI/2. If this is a problem
// in your application, take appropriate action.
//
tan32(x)
{
	x, OCTANT, FOUROVERPI, THREEHALFPI = makeTanPhase(x);
	tanreturn = 0;
	if 				(OCTANT == 0) {
		tanreturn = 	 tanO32(x					* FOUROVERPI);
	} else if 		(OCTANT == 1) {
		tanreturn =  1 / tanO32((HALFPI - x)		* FOUROVERPI);
	} else if 		(OCTANT == 2) {
		tanreturn = -1 / tanO32((x - HALFPI)		* FOUROVERPI);
	} else if 		(OCTANT == 3) {
		tanreturn = 	-tanO32((PI - x)			* FOUROVERPI);
	} else if 		(OCTANT == 4) {
		tanreturn = 	 tanO32((x - PI)			* FOUROVERPI);
	} else if 		(OCTANT == 5) {
		tanreturn =  1 / tanO32((THREEHALFPI - x)	* FOUROVERPI);
	} else if 		(OCTANT == 6) {
		tanreturn = -1 / tanO32((x - THREEHALFPI)	* FOUROVERPI);
	} else {	//	(OCTANT == 7)
		tanreturn = 	-tanO32((TWOPI - x)			* FOUROVERPI);
	}
	return tanreturn;
}

//
//		tanO56 computes tan(PI*x/4)
//
//  Accurate to about 5.6 decimal digits over the range [0, PI/4].
//  The input argument is in radians. Note that the function
//  computes tan(PI*x/4), NOT tan(x); it's up to the range
//  reduction algorithm that calls this to scale things properly.
//
//  Algorithm:
//		tan(x)= x(c1 + c2*x**2)/(c3 + x**2)
//
tanO56(x)
{
	c1 = -3.16783027;
	c2 =  0.134516124;
	c3 = -4.033321984;

	x2 = x * x;
	return (x * (c1 + c2 * x2) / (c3 + x2));
}
//
// This is the main tangent approximation "driver"
// It reduces the input argument's range to [0, PI/4],
// and then calls the approximator. 
// Enter with positive angles only.
//
// WARNING: We do not test for the tangent approaching infinity,
// which it will at x=PI/2 and x=3*PI/2. If this is a problem
// in your application, take appropriate action.
//
tan56(x)
{
	x, OCTANT, FOUROVERPI, THREEHALFPI = makeTanPhase(x);
	tanreturn = 0;
	if 				(OCTANT == 0) {
		tanreturn = 	 tanO56(x					* FOUROVERPI);
	} else if 		(OCTANT == 1) {
		tanreturn =  1 / tanO56((HALFPI - x)		* FOUROVERPI);
	} else if 		(OCTANT == 2) {
		tanreturn = -1 / tanO56((x - HALFPI)		* FOUROVERPI);
	} else if 		(OCTANT == 3) {
		tanreturn = 	-tanO56((PI - x)			* FOUROVERPI);
	} else if 		(OCTANT == 4) {
		tanreturn = 	 tanO56((x - PI)			* FOUROVERPI);
	} else if 		(OCTANT == 5) {
		tanreturn =  1 / tanO56((THREEHALFPI - x)	* FOUROVERPI);
	} else if 		(OCTANT == 6) {
		tanreturn = -1 / tanO56((x - THREEHALFPI)	* FOUROVERPI);
	} else {	//	(OCTANT == 7)
		tanreturn = 	-tanO56((TWOPI - x)			* FOUROVERPI);
	}
	return tanreturn;
}

//
//		tanO82 computes tan(PI*x/4)
//
//  Accurate to about 8.2 decimal digits over the range [0, PI/4].
//  The input argument is in radians. Note that the function
//  computes tan(PI*x/4), NOT tan(x); it's up to the range
//  reduction algorithm that calls this to scale things properly.
//
//  Algorithm:
//		tan(x)= x(c1 + c2*x**2)/(c3 + c4*x**2 + x**4)
//
tanO82(x)
{
	c1 =  211.849369664121;
	c2 = -12.5288887278448 ;
	c3 =  269.7350131214121;
	c4 = -71.4145309347748;

	x2 = x * x;
	return (x * (c1 + c2 * x2) / (c3 + x2 * (c4 + x2)));
}
//
// This is the main tangent approximation "driver"
// It reduces the input argument's range to [0, PI/4],
// and then calls the approximator. 
// Enter with positive angles only.
//
// WARNING: We do not test for the tangent approaching infinity,
// which it will at x=PI/2 and x=3*PI/2. If this is a problem
// in your application, take appropriate action.
//
tan82(x)
{
	x, OCTANT, FOUROVERPI, THREEHALFPI = makeTanPhase(x);
	tanreturn = 0;
	if 				(OCTANT == 0) {
		tanreturn = 	 tanO82(x					* FOUROVERPI);
	} else if 		(OCTANT == 1) {
		tanreturn =  1 / tanO82((HALFPI - x)		* FOUROVERPI);
	} else if 		(OCTANT == 2) {
		tanreturn = -1 / tanO82((x - HALFPI)		* FOUROVERPI);
	} else if 		(OCTANT == 3) {
		tanreturn = 	-tanO82((PI - x)			* FOUROVERPI);
	} else if 		(OCTANT == 4) {
		tanreturn = 	 tanO82((x - PI)			* FOUROVERPI);
	} else if 		(OCTANT == 5) {
		tanreturn =  1 / tanO82((THREEHALFPI - x)	* FOUROVERPI);
	} else if 		(OCTANT == 6) {
		tanreturn = -1 / tanO82((x - THREEHALFPI)	* FOUROVERPI);
	} else {	//	(OCTANT == 7)
		tanreturn = 	-tanO82((TWOPI - x)			* FOUROVERPI);
	}
	return tanreturn;
}

//
//		tanO14 computes tan(PI*x/4)
//
//  Accurate to about 14 decimal digits over the range [0, PI/4].
//  The input argument is in radians. Note that the function
//  computes tan(PI*x/4), NOT tan(x); it's up to the range
//  reduction algorithm that calls this to scale things properly.
//
//  Algorithm:
//		tan(x)= x(c1 + c2*x**2 + c3*x**4)/(c4 + c5*x**2 + c6*x**4 + x**6)
//
tanO14(x)
{
	c1 = -34287.4662577359568109624;
	c2 =  2566.7175462315050423295;
	c3 = -26.5366371951731325438;
	c4 = -43656.1579281292375769579;
	c5 =  12244.4839556747426927793;
	c6 = -336.611376245464339493;

	x2 = x * x;
	return (x * (c1 + x2 * (c2 + x2 * c3))) / (c4 + x2 * (c5 + x2 * (c6 + x2)));
}
//
// This is the main tangent approximation "driver"
// It reduces the input argument's range to [0, PI/4],
// and then calls the approximator. 
// Enter with positive angles only.
//
// WARNING: We do not test for the tangent approaching infinity,
// which it will at x=PI/2 and x=3*PI/2. If this is a problem
// in your application, take appropriate action.
//
tan14(x)
{
	x, OCTANT, FOUROVERPI, THREEHALFPI = makeTanPhase(x);
	tanreturn = 0;
	if 				(OCTANT == 0) {
		tanreturn = 	 tanO14(x					* FOUROVERPI);
	} else if 		(OCTANT == 1) {
		tanreturn =  1 / tanO14((HALFPI - x)		* FOUROVERPI);
	} else if 		(OCTANT == 2) {
		tanreturn = -1 / tanO14((x - HALFPI)		* FOUROVERPI);
	} else if 		(OCTANT == 3) {
		tanreturn = 	-tanO14((PI - x)			* FOUROVERPI);
	} else if 		(OCTANT == 4) {
		tanreturn = 	 tanO14((x - PI)			* FOUROVERPI);
	} else if 		(OCTANT == 5) {
		tanreturn =  1 / tanO14((THREEHALFPI - x)	* FOUROVERPI);
	} else if 		(OCTANT == 6) {
		tanreturn = -1 / tanO14((x - THREEHALFPI)	* FOUROVERPI);
	} else {	//	(OCTANT == 7)
		tanreturn = 	-tanO14((TWOPI - x)			* FOUROVERPI);
	}
	return tanreturn;
}

//
//		tanO203 computes tan(PI*x/4)
//
//  Accurate to about 20.3 decimal digits over the range [0, PI/4].
//  The input argument is in radians. Note that the function
//  computes tan(PI*x/4), NOT tan(x); it's up to the range
//  reduction algorithm that calls this to scale things properly.
//
tanO203(x)
{
	c1 =  10881241.46289544215469695742;
	c2 = -895306.0870564145957447087575;
	c3 =  14181.99563014366386894487566;
	c4 = -45.63638305432707847378129653;
	c5 =  13854426.92637036839270054048;
	c6 = -3988641.468163077300701338784;
	c7 =  135299.4744550023680867559195;
	c8 = -1014.19757617656429288596025;

	x2 = x * x;
	return x * (c1 + x2 * (c2 + x2 * (c3 + x2 * c4))) / (c5 + x2 * (c6 + x2 * (c7 + x2 * (c8 + x2))));
}
