//
//		tanO236 computes tan(PI*x/4)
//
//  Accurate to about 23.6 decimal digits over the range [0, PI/4].
//  The input argument is in radians. Note that the function
//  computes tan(PI*x/4), NOT tan(x); it's up to the range
//  reduction algorithm that calls this to scale things properly.
//
tanO236(x)
{
	c1 =  4130240.588996024013440146267;
	c2 = -349781.8562517381616631012487;
	c3 =  6170.317758142494245331944348;
	c4 = -27.94920941380194872760036319;
	c5 =  0.0175143807040383602666563058;
	c6 =  5258785.647179987798541780825;
	c7 = -1526650.549072940686776259893;
	c8 =  54962.51616062905361152230566;
	c9 = -497.495460280917265024506937;

	x2 = x * x;
	return x * (c1 + x2 * (c2 + x2 * (c3 + x2 * (c4 + x2 * c5)))) / (c6 + x2 * (c7 + x2 * (c8 + x2 * (c9 + x2))));
}
