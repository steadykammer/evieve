// cos and sin (approx) routines, assembled by pete for evieve

// for other approximations in evieve @see:
// evi_approx.genexpr
// evi_trig.genexpr
// evi_pade.genexpr
// evi_tanh.genexpr
// evi_fastskew.genexpr

// Note: you should be very careful using approximations - they can break your code.
// In evieve all approximations are tested to work on the code in which they are used.


// @see "about 'quartParApproxFull()'" below this function
// based on the famous "simultaneous parabolic approximation of sin and cos" by Olli Niemitalo
// @see: http://dspguru.com/book/export/html/62
// the below function is silly and for pedagogy only, you should extract a fixed precision from it
quartParApproxFull(modphase, precision)	// 'modphase' must be wrapped 0..1
{
	mphse	= modphase * 4;				// parse in quart branch
	quart	= int(mphse);				// get quarter # (0 to 3) we are in

	C		= 0;
	if				(precision == 1) {	// optimized for minimum maximum absolute difference...
		C	= 0.71256755058;			// ...of sqrt(sinapprox(x)^2+cosapprox(x)^2) to 1
	} else if		(precision == 2) {	// optimized similarly to '1' but never lets...
		C	= sqrt1_2;					// ...sqrt(sinapprox(x)^2+cosapprox(x)^2) exceed 1
	} else if		(precision == 3) {	// optimized for continuous differential, which...
		C	= 0.75;						// ...reduces high harmonics
	} else {	//	(precision == 0)	// optimized for minimum maximum absolute
		C	= 0.7035;					// ...difference to sin()
	}

	cosout		= 0;
	sinout		= 0;

	if 					(quart == 1) {
        // second quarter, angle	= halfpi .. pi
		x1		= 1.5 - mphse;							// 1 sub
		temp	= (2 - (4 * C)) * x1 * x1 + C;			// 2 mul, 1 sub
		sinout	= x1 + temp;							// 1 add
		cosout	= x1 - temp;							// 1 sub
	} else {	//		(quart == 0 || 2 || 3)
		x0		= mphse - 0.5;							// 1 sub
		if 				(quart == 0) {
        // first quarter, angle		= 0 .. halfpi
			temp	= (2 - (4 * C)) * x0 * x0 + C;		// 2 mul, 1 add
			sinout	= temp + x0;						// 1 add
			cosout	= temp - x0;						// 1 sub
		} else if 		(quart == 2) {
        // third quarter, angle		= pi .. 1.5 pi
			x2		= x0 - 2;							// (1 sub)
			temp	= ((4 * C) - 2) * x2 * x2 - C;		// 2 mul, 1 sub
			sinout	= temp - x2;						// 1 sub
			cosout	= temp + x2;						// 1 add
		} else {	//	(quart == 3)
        // fourth quarter, angle	= 1.5 pi .. twopi
			x3		= x0 - 3;							// (1 sub)
			temp	= (2 - (4 * C)) * x3 * x3 + C;		// 2 mul, 1 add
			sinout	= x3 - temp;						// 1 sub
			cosout	= x3 + temp;						// 1 add
		}
	}

	return		cosout, sinout, quart;
}

//	about 'quartParApproxFull()'
/*
	ABOUT 'C' (precision):

	C is a constant that can be fine-tuned for different applications. With C yet undefined,
	the polynomials hit 0 and 1 in the right places.

	Here are some differently optimized (and approximated) values for C:

	(1) C ~= 0.7035

	(2) C ~= 0.71256755058 

	(3) C = sqrt(2)/2 ~= 0.70710678118654752440

	(4) C = 3/4 = 0.75 (one mul choice!)

	To compare the errors produced by different choices of C, we look at the maximums and minimums
	of the following error measures, for different C:

	error = sinapprox(x) - sin(angle)

	Min:	(1) -0.0213	(2) -0.0150	(3) -0.0187	(4) 0
	Max:	(1) +0.0212	(2) +0.0271	(3) +0.0235	(4) +0.0560

	error = sqrt(sinapprox(x)^2 - cosapprox(x)^2) - 1

	Min:	(1) -0.0261	(2) -0.0155	(3) -0.0214	(4) 0
	Max:	(1)  0		(2) +0.0155	(3) 0		(4) +0.1250

	The different C were optimized as follows:

	(1) was optimized for minimum maximum absolute difference to sin().

	(2) was optimized for minimum maximum absolute difference of sqrt(sinapprox(x)^2+cosapprox(x)^2)
	to (1). This is important for example in a rotation transformation, where you want the
	dimensions to stretch as little as possible from the original. Note, though, that (3)
	gives the lowest total magnitude "wobbling" range.

	(3) was optimized similarly to (2) but never lets sqrt(sinapprox(x)^2+cosapprox(x)^2) exceed 1.
	This is useful if you calculate filter coefficients and don't want unstable poles.
	Also, sinapprox(0) and cosapprox(0) give sqrt(2)/2, which is the correct value.

	(4) was optimized for continuous differential, which reduces high harmonics. This is good
	if you are creating sine and cosine signals rather than doing "random access" to the function.
	Also, it eliminates the other multiplication, making the algo one-mul and low bit-depth:

	x = -1/2 .. +1/2

	sinapprox(x) = 3/4 - x^2 + x
	cosapprox(x) = 3/4 - x^2 - x
*/

// for crossfading style applications etc
// for first quarter only, optimized so that never lets sqrt(sinapprox(x)^2+cosapprox(x)^2)...
// ...exceed 1, always gives exact results at modphase 0, 0.5, 1 (0/1, sqrt1_2, 1/0)
quartParOneApprox(modphase)								// 'modphase' must be clamped 0..1
{
	x0		=  modphase - 0.5;							// 1 sub
	// first quarter									// angle = 0 .. HALFPI
	quart	= -0.8284271247461903 * x0 * x0 + sqrt1_2;	// 2 mul, 1 add, (-0.8284271247461903 = 2 - 4*sqrt1_2)
	sinq1	=  quart + x0;								// 1 add
	cosq1	=  quart - x0;								// 1 sub

	return	cosq1, sinq1;
}

// in this setup the quad osc is high quality and precise, not approx
quadratureOsc(thisphase, thisspread)// thisspread is of course nuts for quadrature (must == 0.75), but here for mod osc use
{
	History qodummy(0);
	re		= cycle(thisphase, index="phase");
	im		= cycle(wrap(thisphase + thisspread, 0, 1), index="phase");

	return	re, im;
}

// tan approx valid for -HALFPI..HALFPI input
// bad copy paste to get around multiple requires etc
tanApprox3(x)
{
	x2		= x * x;
	return	x * (0.999999492001 + x2 * -0.096524608111) / (1 + x2 * (-0.429867256894 + x2 * 0.009981877999));
}

// better complex oscs, thanks to Martin Vicanek
eviQuadOsc(frequency, reset)
{
	History	u(1), v(0);				// init cos, init sin

	w1		= TWOPI * frequency / samplerate;
	k1		= tanApprox3(0.5*w1);
	k2		= (k1 + k1) / (1 + k1*k1);

	omega	= u - k1*v;
	v		= reset ? 0 : v + k2*omega;
	u		= reset ? 1 : omega - k1*v;

	return	u, v;					// cos, sin
}

// better complex oscs with sync outs
eviQuadOscSync(frequency, reset)
{
	History	u(1), v(0);				// init cos, init sin

	w1		= TWOPI * frequency / samplerate;
	k1		= tanApprox3(0.5*w1);
	k2		= (k1 + k1) / (1 + k1*k1);

	omega	= u - k1*v;
	v		= reset ? 0 : v + k2*omega;
	u		= reset ? 1 : omega - k1*v;
									// normalised phase:
	vsync	= change(v > 0) > 0;	// + 0.00 for sin zero-crossing
	usync	= change(u > 0) > 0;	// + 0.75 for cos zero-crossing

	return	u, v, usync, vsync;		// cos, sin, cossync, sinsync
}

// quad osc from a tpt filter, reset resets states
tptSvfQuadOsc(cutoff, sync, reset, soft=0.1)
{
	History	s1(0), s2(-1);		// init at sin and cos phases
    History prev_cf(0);
    softSync = 0;

    // do not use
    if (reset) {
        s1 = 0;
        s2 = -1;
    }

    mSoft = 0;
    if (sync) {
        softSync = 1;
        mSoft = (1 - soft);
    }

    // not very effective
    while (softSync > 0) {
        s1 *= mSoft;
        s2  = s2*mSoft - soft;
        softSync -= 0.125; 		// 0.125 = 8 samples?
    }

    // g corrected for audio rate FM
    lin_cf  = cutoff - prev_cf;
    corr_cf = cutoff + 0.5 * lin_cf;
    prev_cf = cutoff;
    g       = tanApprox3(PI * corr_cf / SAMPLERATE);
    // and A corrected for scaling
    A       = 1 / (1 + g*g);	// R = 0;
    d       = 0.000001;

	// no input
	yH	= (-g * s1 - s2) * A;

	gyH	= g * yH;
	yB	= gyH + s1;
	s1	= gyH + yB;

	gyB	= g * yB;
	yL	= gyB + s2;
	s2	= gyB + yL;

    // drift correction
    drift = 1 - d * yB*yB;
    s1   *= drift;
    s2   *= drift;

	return	(-yL), (yB);		// cosine, sine
}

// cheap parabolic approx for LFOs etc, sin phase, 0..1 input, -1..1 output
parabolApprox(phase)
{
	x	= wrap(phase, -0.5, 0.5);
	y	= (8 - (abs(x) * 16)) * x;
	return	y;
}

// 0..1 output version
parabolApprox01(phase)
{
	x	= wrap(phase, -0.5, 0.5);
	y	= x * (4 - (abs(x) * 8)) + 0.5;
	return	y;
}

cosApprox01(a)		// cosine approximation (0..1 input)
{
	p = wrap(a, 0, 1) - 0.75;
	pa = abs(p);
	cl = ((pa - 0.5) * (pa - 0.924933)) * (pa + 0.424933);
	cr = (((pa + 1.05802) * pa) + 0.436501) * ((pa * (pa - 2.05802)) + 1.21551);
	return p * ((cl * cr) * 60.252201);
}

sinApprox01(a)		// sine approximation (0..1 input)
{
//	return cosApprox01(a - 0.25);	// one line declaration causes compile error on Max 6.1.8
	b = a - 0.25;
	s = cosApprox01(b);
	return s;
}

cosApproxPi(x)		// cosine approximation (-pi..pi input)
{
	x1 = phasewrap(x);
	x2 = x1 * x1;
	return (((((((((x2 * -0.0000002605) + 0.0000247609) * x2) + -0.001389) * x2) + 0.041667) * x2) + -0.499923) * x2) + 1;
}

sinApproxPi(x)		// sine approximation (-pi..pi input)
{
	x1 = phasewrap(x);
	x2 = x1 * x1;
	return ((((((((((x2 * -0.0000000239) + 0.0000027526) * x2) + -0.000198) * x2) + 0.008333) * x2) + -0.166667) * x2) + 1) * x1;
}

// @see evi_utilities.genexpr for a sin approximation (sin7()) driven by -1..1 input

