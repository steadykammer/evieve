
//	//	//	gen~ / GenExpr resamplers by Pete for evieve, thanks to Martijn Zwartjes
//	//	//	(for the idea) and Alex Harker (for finding my mistakes).
//	//	//	Basic cubic interpolation hacks in lieu of real resampling being not
//	//	//	available in gen~. High frequency response is poor using these methods.
//	//	//	These are relatively expensive, and literally process functions x times.

//	//	//	These methods are not very good for oscillators or ringing resonance (filters),
//	//	//	as those require really fine interpolation (e.g. use [poly~] for that).
//	//	//	In evieve, these methods are mainly used on all the non-linearities and seem reasonable for that task.

//	//	//	!! These are templates for copy/pasting and testing/making your own resamplers;
//	//	//	it is not advised to "require" this file directly !!


require("evi_interp.genexpr"); // 4-point cubic and 6-point hermite


YOUR_FUNCTION_GOES_HERE(x)
{	// EXAMPLE
	// 'high quality' Lambert tanh approx, excellent numeric and sonic closeness to 'real' tanh
	x2 = x * x;
	a = (((x2 + 378) * x2 + 17325) * x2 + 135135) * x;
	b = ((28 * x2 + 3150) * x2 + 62370) * x2 + 135135;
	return clamp((a / b), -1, 1);
	// EXAMPLE
}


// not useful on its own, we use it for 6x & 8x
// fixed 2x quasi oversampling, plus voodoo for GenExpr
EVI_RESAMPLE_TEMPLATE_2x(XIN)					// XIN presumed to be audio signal inlet
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;							// could  be cheaper "cubic", but worse high frequency response
	x1_0	= interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");
	x2_0	= umT1_0 + 0;

	// process 2x
	y1_0	= YOUR_FUNCTION_GOES_HERE(x1_0);	// you could also have other parameter inlets here but
	y2_0	= YOUR_FUNCTION_GOES_HERE(x2_0);	// the first (XIN) inlet is the audio targeted for resampling

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;								// you should almost always dcblock() the output(s) in use
}


// I am not convinced 3x, 6x, 9x are correct
// fixed 3x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_3x(XIN)
{	// up 3
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// up 3x
	x0_0_a	= XIN + 0;
	x1_0	= umT0_0 + 0;	// my instinct says this should be umT1_0 ??
	x2_0	= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");
	x3_0	= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");

	// process 3x
	y1_0	= YOUR_FUNCTION_GOES_HERE(x1_0);
	y2_0	= YOUR_FUNCTION_GOES_HERE(x2_0);
	y3_0	= YOUR_FUNCTION_GOES_HERE(x3_0);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");
	y3_0_a	= y3_0 + 0;
	y3_1	= interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2, mode="spline");

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return y0_0;
}


// fixed 4x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_4x(XIN)
{	// up 4
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// up 4x
	x0_0_a	= XIN + 0;
	x1_0	= interp(0.25,	umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");
	x2_0	= interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");
	x3_0	= interp(0.75,	umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");

	// process 4x
	y1_0	= YOUR_FUNCTION_GOES_HERE(x1_0);
	y2_0	= YOUR_FUNCTION_GOES_HERE(x2_0);
	y3_0	= YOUR_FUNCTION_GOES_HERE(x3_0);
	y4_0	= YOUR_FUNCTION_GOES_HERE(umT1_0 + 0);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");

	y3_0_a	= y3_0 + 0;
	y3_1	= interp(0.5,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2, mode="spline");

	y4_0_a	= y4_0 + 0;
	y4_1	= interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3, mode="spline");

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return y0_0;
}


// the following higher order resamplers are made from combining the previous 
// basic 2x, 3x & 4x resamplers, so you will also have to replace the processing 
// functions with wrapped lower order resampling functions
// N.B. it is debatable whether we should bother going to "cubic" here,
// maybe they should all stay "spline"


// I am not convinced 3x, 6x, 9x are correct
// a bit stupid
// fixed 6x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_6x(XIN)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 6x
	y1_0	= EVI_RESAMPLE_TEMPLATE_3x(x1_0);
	y2_0	= EVI_RESAMPLE_TEMPLATE_3x(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}


// this is probably the best / most useful of the 4-pointers
// quite stupid
// fixed 8x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_8x(XIN)
{	// up 2
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= umT1_0 + 0;

	// process 8x
	y1_0	= EVI_RESAMPLE_TEMPLATE_4x(x1_0);
	y2_0	= EVI_RESAMPLE_TEMPLATE_4x(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}


// I am not convinced 3x, 6x, 9x are correct
// less stupid than you think
// fixed 9x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_9x(XIN)
{	// up 3
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// up 3x
	x0_0_a	= XIN + 0;
	x1_0	= umT0_0 + 0;
	x2_0	= cubic_hermite_interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0	= cubic_hermite_interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a);

	// process 9x
	y1_0	= EVI_RESAMPLE_TEMPLATE_3x(x1_0);
	y2_0	= EVI_RESAMPLE_TEMPLATE_3x(x2_0);
	y3_0	= EVI_RESAMPLE_TEMPLATE_3x(x3_0);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);
	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return y0_0;
}


// stupid
// fixed 12x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_12x(XIN)
{	// up 4
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// up 4x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.25,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= cubic_hermite_interp(0.5,		umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0	= cubic_hermite_interp(0.75,	umTm1_0, umT0_0, umT1_0, x0_0_a);

	// process 12x
	y1_0	= EVI_RESAMPLE_TEMPLATE_3x(x1_0);
	y2_0	= EVI_RESAMPLE_TEMPLATE_3x(x2_0);
	y3_0	= EVI_RESAMPLE_TEMPLATE_3x(x3_0);
	y4_0	= EVI_RESAMPLE_TEMPLATE_3x(umT1_0 + 0);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(0.5,		y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3);

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return y0_0;
}


// this is strangely pointless - almost no difference to the 8x version
// really stupid
// fixed 16x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_16x(XIN)
{	// up 4
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// up 4x
	x0_0_a	= XIN + 0;
	x1_0	= cubic_hermite_interp(0.25,	umTm1_0, umT0_0, umT1_0, x0_0_a);
	x2_0	= cubic_hermite_interp(0.5,		umTm1_0, umT0_0, umT1_0, x0_0_a);
	x3_0	= cubic_hermite_interp(0.75,	umTm1_0, umT0_0, umT1_0, x0_0_a);

	// process 16x
	y1_0	= EVI_RESAMPLE_TEMPLATE_4x(x1_0);
	y2_0	= EVI_RESAMPLE_TEMPLATE_4x(x2_0);
	y3_0	= EVI_RESAMPLE_TEMPLATE_4x(x3_0);
	y4_0	= EVI_RESAMPLE_TEMPLATE_4x(umT1_0 + 0);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(0.5,		y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3);

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return y0_0;
}


// !! for testing ONLY !!
TEST_RESAMPLER(x, order)
{
	y 		= 0;
	if 			(order == 1) {
		y 	= EVI_RESAMPLE_TEMPLATE_2x(x);
	} else if	(order == 2) {
		y 	= EVI_RESAMPLE_TEMPLATE_3x(x);
	} else  if	(order == 3) {
		y 	= EVI_RESAMPLE_TEMPLATE_4x(x);
	} else  if	(order == 4) {
		y 	= EVI_RESAMPLE_TEMPLATE_6x(x);
	} else  if	(order == 5) {
		y 	= EVI_RESAMPLE_TEMPLATE_8x(x);
	} else  if	(order == 6) {
		y 	= EVI_RESAMPLE_TEMPLATE_9x(x);
	} else  if	(order == 7) {
		y 	= EVI_RESAMPLE_TEMPLATE_12x(x);
	} else  if	(order == 8) {
		y 	= EVI_RESAMPLE_TEMPLATE_16x(x);
	} else {//	(order == 0) {
		y 	= YOUR_FUNCTION_GOES_HERE(x);
	}

	return 	y;
}


//	//	//	//	//	//


// the next part of this file repeats the above but for downsampling stages only.
// this is useful for generators such as oscillators that only require
// the multiple processing then interpolation on output.
// these are therefore a bit cheaper as no upsampling stage is neeeded,
// but the trade off is that they are not very effective :-(


// EXAMPLE, required for "YOUR_GENERATOR_FUNCTION_GOES_HERE()"
// simple 4 point polyBLEP
poly_blep(t, dt)
{
	yblep	= 0;
	if (t < dt) {
		alpha	=  (t / dt) - 1;
		yblep	= -(alpha * alpha);
	} else if (t > 1 - dt) {
		alpha	=  (t - 1) / dt + 1;
		yblep	=  (alpha * alpha);
	} else {
		yblep	=  0;
	}
	return	yblep;
}
// EXAMPLE


YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt)
{	// EXAMPLE
	// interesting polyblep sawtooth-pulse oscilaltor that aliases in high range
	t2	= wrap(t + 0.5, 0, 1);
	w	= 0;
	if (t2 >= 0.5) {
		w	= (cos(t2 * twopi) + 1) - 0.5;	// (should approx cos() here)
	} else {
		w	= 0 - 0.5;
	}
	wp	= (-poly_blep(t2, dt) + w);
	return	wp * 0.5;
	// EXAMPLE
}


// fixed 2x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_2x(t, dt)
{	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// process 2x
	y1_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);
	y2_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}


// fixed 3x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_3x(t, dt)
{	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// process 3x
	y1_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);
	y2_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);
	y3_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");
	y3_0_a	= y3_0 + 0;
	y3_1	= interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2, mode="spline");

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return y0_0;
}


// fixed 4x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_4x(t, dt)
{	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// process 4x
	y1_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);
	y2_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);
	y3_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);
	y4_0	= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");

	y3_0_a	= y3_0 + 0;
	y3_1	= interp(0.5,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2, mode="spline");

	y4_0_a	= y4_0 + 0;
	y4_1	= interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3, mode="spline");

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return y0_0;
}


// the following higher order downsamplers are made from combining the previous 
// basic 2x, 3x & 4x downsamplers, so you will also have to replace the processing 
// functions with wrapped lower order resampling functions


// fixed 6x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_6x(t, dt)
{	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// process 6x
	y1_0	= EVI_DOWNSAMPLE_TEMPLATE_3x(t, dt);
	y2_0	= EVI_DOWNSAMPLE_TEMPLATE_3x(t, dt);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}


// fixed 8x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_8x(t, dt)
{	// down 2
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	// align
	History	doX0(0);

	// process 8x
	y1_0	= EVI_DOWNSAMPLE_TEMPLATE_4x(t, dt);
	y2_0	= EVI_DOWNSAMPLE_TEMPLATE_4x(t, dt);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.5,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	return y0_0;
}


// fixed 9x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_9x(t, dt)
{	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// process 9x
	y1_0	= EVI_DOWNSAMPLE_TEMPLATE_3x(t, dt);
	y2_0	= EVI_DOWNSAMPLE_TEMPLATE_3x(t, dt);
	y3_0	= EVI_DOWNSAMPLE_TEMPLATE_3x(t, dt);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);
	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return y0_0;
}


// fixed 12x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_12x(t, dt)
{	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// process 12x
	y1_0	= EVI_DOWNSAMPLE_TEMPLATE_3x(t, dt);
	y2_0	= EVI_DOWNSAMPLE_TEMPLATE_3x(t, dt);
	y3_0	= EVI_DOWNSAMPLE_TEMPLATE_3x(t, dt);
	y4_0	= EVI_DOWNSAMPLE_TEMPLATE_3x(t, dt);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(0.5,		y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3);

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return y0_0;
}


// fixed 16x quasi downsampling 
EVI_DOWNSAMPLE_TEMPLATE_16x(t, dt)
{	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// process 16x
	y1_0	= EVI_DOWNSAMPLE_TEMPLATE_4x(t, dt);
	y2_0	= EVI_DOWNSAMPLE_TEMPLATE_4x(t, dt);
	y3_0	= EVI_DOWNSAMPLE_TEMPLATE_4x(t, dt);
	y4_0	= EVI_DOWNSAMPLE_TEMPLATE_4x(t, dt);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= cubic_hermite_interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= cubic_hermite_interp(0.5,		y3_0_a,	dmT0_2, dmT1_2, dmT2_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= cubic_hermite_interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3);

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return y0_0;
}


// !! for testing ONLY !!
TEST_DOWNSAMPLER(t, dt, order)
{
	y 		= 0;
	z		= YOUR_GENERATOR_FUNCTION_GOES_HERE(t, dt);

	if 			(order == 1) {
		y 	= EVI_DOWNSAMPLE_TEMPLATE_2x(t, dt);
	} else if	(order == 2) {
		y 	= EVI_DOWNSAMPLE_TEMPLATE_3x(t, dt);
	} else  if	(order == 3) {
		y 	= EVI_DOWNSAMPLE_TEMPLATE_4x(t, dt);
	} else  if	(order == 4) {
		y 	= EVI_DOWNSAMPLE_TEMPLATE_6x(t, dt);
	} else  if	(order == 5) {
		y 	= EVI_DOWNSAMPLE_TEMPLATE_8x(t, dt);
	} else  if	(order == 6) {
		y 	= EVI_DOWNSAMPLE_TEMPLATE_9x(t, dt);
	} else  if	(order == 7) {
		y 	= EVI_DOWNSAMPLE_TEMPLATE_12x(t, dt);
	} else  if	(order == 8) {
		y 	= EVI_DOWNSAMPLE_TEMPLATE_16x(t, dt);
	} else {//	(order == 0) {
		y 	= z;
	}

	return 	y, z;
}


//	//	//	//	//	//


// examples of other configurations...


// EXAMPLE, ringmod with two inputs
// (based on "enhanced ring mod" after Beat Frei, ICST)
EXAMPLE_TWO_INLETS_ONE_OUTLET(xin1, xin2)
{
	History x1(0), x2(0), y1(0);
	stage1	= xin1 + x1;
	stage2	= xin2 + x2;
	smix	= (stage1 * stage2) * 0.416666666667;
	rmod	= smix - (y1 * 0.666666666666);
	x1 = xin1;
	x2 = xin2;
	y1 = rmod;
	return dcblock(rmod);
}


// fixed 3x quasi oversampling, with two audio inlets
EVI_RESAMPLE_TEMPLATE_3x_TWO_INPUTS(XIN1, XIN2)
{	// up 3 in1
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// up 3 in2
	History	vmTm1_0(0), vmT0_0(0), vmT1_0(0);
	// down 3
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// up 3x in1
	x0_0_a	= XIN1 + 0;
	x1_0_a	= umT0_0 + 0;
	x2_0_a	= interp(ODT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");
	x3_0_a	= interp(TDT, umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");

	// up 3x in2
	x0_0_b	= XIN2 + 0;
	x1_0_b	= vmT0_0 + 0;
	x2_0_b	= interp(ODT, vmTm1_0, vmT0_0, vmT1_0, x0_0_b, mode="spline");
	x3_0_b	= interp(TDT, vmTm1_0, vmT0_0, vmT1_0, x0_0_b, mode="spline");

	// process 3x
	y1_0	= EXAMPLE_TWO_INLETS_ONE_OUTLET(x1_0_a, x1_0_b);
	y2_0	= EXAMPLE_TWO_INLETS_ONE_OUTLET(x2_0_a, x2_0_b);
	y3_0	= EXAMPLE_TWO_INLETS_ONE_OUTLET(x3_0_a, x3_0_b);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(TDT,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");
	y3_0_a	= y3_0 + 0;
	y3_1	= interp(ODT,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2, mode="spline");

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update in1
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	// update in2
	vmTm1_0	= vmT0_0;
	vmT0_0	= vmT1_0;
	vmT1_0	= x0_0_b;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	return	dcblock(y0_0);
}

// fixed 4x quasi oversampling, with two audio inlets
EVI_RESAMPLE_TEMPLATE_4x_TWO_INPUTS(XIN1, XIN2)
{	// up 4 in1
	History	umTm1_0(0), umT0_0(0), umT1_0(0);
	// up 4 in2
	History	vmTm1_0(0), vmT0_0(0), vmT1_0(0);
	// down 4
	History	dmT2_1(0), dmT1_1(0), dmT0_1(0);
	History	dmT2_2(0), dmT1_2(0), dmT0_2(0);
	History	dmT2_3(0), dmT1_3(0), dmT0_3(0);
	// align
	History	doX0(0);

	// up 4x in1
	x0_0_a	= XIN1 + 0;
	x1_0_a	= interp(0.25,	umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");
	x2_0_a	= interp(0.5,	umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");
	x3_0_a	= interp(0.75,	umTm1_0, umT0_0, umT1_0, x0_0_a, mode="spline");

	// up 4x in2
	x0_0_b	= XIN2 + 0;
	x1_0_b	= interp(0.25,	vmTm1_0, vmT0_0, vmT1_0, x0_0_b, mode="spline");
	x2_0_b	= interp(0.5,	vmTm1_0, vmT0_0, vmT1_0, x0_0_b, mode="spline");
	x3_0_b	= interp(0.75,	vmTm1_0, vmT0_0, vmT1_0, x0_0_b, mode="spline");

	// process 4x
	y1_0	= EXAMPLE_TWO_INLETS_ONE_OUTLET(x1_0_a,		x1_0_b);
	y2_0	= EXAMPLE_TWO_INLETS_ONE_OUTLET(x2_0_a,		x2_0_b);
	y3_0	= EXAMPLE_TWO_INLETS_ONE_OUTLET(x3_0_a,		x3_0_b);
	y4_0	= EXAMPLE_TWO_INLETS_ONE_OUTLET(umT1_0 + 0,	vmT1_0 + 0);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= interp(0.25,	y2_0_a,	dmT0_1, dmT1_1, dmT2_1, mode="spline");

	y3_0_a	= y3_0 + 0;
	y3_1	= interp(0.5,	y3_0_a,	dmT0_2, dmT1_2, dmT2_2, mode="spline");

	y4_0_a	= y4_0 + 0;
	y4_1	= interp(0.75,	y4_0_a,	dmT0_3, dmT1_3, dmT2_3, mode="spline");

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update in1
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0	= x0_0_a;

	// update in2
	vmTm1_0	= vmT0_0;
	vmT0_0	= vmT1_0;
	vmT1_0	= x0_0_b;

	doX0	= y1_0;

	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= y2_0;

	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= y3_0;

	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= y4_0;

	return dcblock(y0_0);
}


// 6-point hermite instead of 4-point like all the above
// !! most of these are broken... ...i am still working on them... !!


// fixed 2x quasi oversampling, this one works and is really useful
EVI_RESAMPLE_TEMPLATE_2x_6POINT(XIN)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);//, mode="spline6");
	x2_0	= umT2_0 + 0;

	// process 2x
	y1_0	= YOUR_FUNCTION_GOES_HERE(x1_0);
	y2_0	= YOUR_FUNCTION_GOES_HERE(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);//, mode="spline6");

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return y0_0;
}


// fixed 3x quasi oversampling
EVI_RESAMPLE_TEMPLATE_3x_6POINT(XIN)
{	// up 3
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 3
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	History	dmT3_2(0), dmT2_2(0), dmT1_2(0), dmT0_2(0), dmTm1_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// up 3x
	x0_0_a	= XIN + 0;
	x1_0	= umTm1_0 + 0;	// !! surely this is wrong ??
	x2_0	= hermite_sixpoint_interp(ODT,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x3_0	= hermite_sixpoint_interp(TDT,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);

	// process 3x
	y1_0	= YOUR_FUNCTION_GOES_HERE(x1_0);
	y2_0	= YOUR_FUNCTION_GOES_HERE(x2_0);
	y3_0	= YOUR_FUNCTION_GOES_HERE(x3_0);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(TDT,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);
	y3_0_a	= y3_0 + 0;
	y3_1	= hermite_sixpoint_interp(ODT,	y3_0_a,	dmTm1_2, dmT0_2, dmT1_2, dmT2_2, dmT3_2);

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	dmT3_2	= dmT2_2;
	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= dmTm1_2;
	dmTm1_2	= y3_0;

	return y0_0;
}


// fixed 4x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_4x_6POINT(XIN)
{	// up 4
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 4
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	History	dmT3_2(0), dmT2_2(0), dmT1_2(0), dmT0_2(0), dmTm1_2(0);
	History	dmT3_3(0), dmT2_3(0), dmT1_3(0), dmT0_3(0), dmTm1_3(0);
	// align
	History	doX0(0);

	// up 4x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.25,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x3_0	= hermite_sixpoint_interp(0.75,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);

	// process 4x
	y1_0	= YOUR_FUNCTION_GOES_HERE(x1_0);
	y2_0	= YOUR_FUNCTION_GOES_HERE(x2_0);
	y3_0	= YOUR_FUNCTION_GOES_HERE(x3_0);
	y4_0	= YOUR_FUNCTION_GOES_HERE(umT2_0 + 0);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.25,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= hermite_sixpoint_interp(0.5,	y3_0_a,	dmTm1_2, dmT0_2, dmT1_2, dmT2_2, dmT3_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= hermite_sixpoint_interp(0.75,	y4_0_a,	dmTm1_3, dmT0_3, dmT1_3, dmT2_3, dmT3_3);

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	dmT3_2	= dmT2_2;
	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= dmTm1_2;
	dmTm1_2	= y3_0;

	dmT3_3	= dmT2_3;
	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= dmTm1_3;
	dmTm1_3	= y4_0;

	return y0_0;
}


// the following higher order resamplers are made from combining the previous 
// basic 2x, 3x & 4x resamplers, so you will also have to replace the processing 
// functions with wrapped lower order resampling functions


// a bit stupid
// fixed 6x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_6x_6POINT(XIN)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= umT2_0 + 0;

	// process 6x
	y1_0	= EVI_RESAMPLE_TEMPLATE_3x_6POINT(x1_0);
	y2_0	= EVI_RESAMPLE_TEMPLATE_3x_6POINT(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return y0_0;
}


// quite stupid
// fixed 8x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_8x_6POINT(XIN)
{	// up 2
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 2
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	// align
	History	doX0(0);

	// up 2x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);//, mode="spline6");
	x2_0	= umT2_0 + 0;

	// process 8x
	y1_0	= EVI_RESAMPLE_TEMPLATE_4x_6POINT(x1_0);
	y2_0	= EVI_RESAMPLE_TEMPLATE_4x_6POINT(x2_0);

	// down 2x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.5,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);//, mode="spline6");

	y0_0	= (doX0 + y2_1) * 0.5;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	return y0_0;
}


// less stupid than you think
// fixed 9x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_9x_6POINT(XIN)
{	// up 3
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 3
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	History	dmT3_2(0), dmT2_2(0), dmT1_2(0), dmT0_2(0), dmTm1_2(0);
	// align
	History	doX0(0);

	ODT		= 0.3333333333333333;
	TDT		= 0.6666666666666667;

	// up 3x
	x0_0_a	= XIN + 0;
	x1_0	= umTm1_0 + 0;	// !!
	x2_0	= hermite_sixpoint_interp(ODT,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x3_0	= hermite_sixpoint_interp(TDT,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);

	// process 9x
	y1_0	= EVI_RESAMPLE_TEMPLATE_3x_6POINT(x1_0);
	y2_0	= EVI_RESAMPLE_TEMPLATE_3x_6POINT(x2_0);
	y3_0	= EVI_RESAMPLE_TEMPLATE_3x_6POINT(x3_0);

	// down 3x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(TDT,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);
	y3_0_a	= y3_0 + 0;
	y3_1	= hermite_sixpoint_interp(ODT,	y3_0_a,	dmTm1_2, dmT0_2, dmT1_2, dmT2_2, dmT3_2);

	y0_0	= (doX0 + y2_1 + y3_1) * ODT;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	dmT3_2	= dmT2_2;
	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= dmTm1_2;
	dmTm1_2	= y3_0;

	return y0_0;
}


// stupid
// fixed 12x quasi oversampling 
EVI_RESAMPLE_TEMPLATE_12x_6POINT(XIN)
{	// up 4
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 4
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	History	dmT3_2(0), dmT2_2(0), dmT1_2(0), dmT0_2(0), dmTm1_2(0);
	History	dmT3_3(0), dmT2_3(0), dmT1_3(0), dmT0_3(0), dmTm1_3(0);
	// align
	History	doX0(0);

	// up 4x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.25,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x3_0	= hermite_sixpoint_interp(0.75,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);

	// process 12x
	y1_0	= EVI_RESAMPLE_TEMPLATE_3x_6POINT(x1_0);
	y2_0	= EVI_RESAMPLE_TEMPLATE_3x_6POINT(x2_0);
	y3_0	= EVI_RESAMPLE_TEMPLATE_3x_6POINT(x3_0);
	y4_0	= EVI_RESAMPLE_TEMPLATE_3x_6POINT(umT2_0 + 0);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.25,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= hermite_sixpoint_interp(0.5,	y3_0_a,	dmTm1_2, dmT0_2, dmT1_2, dmT2_2, dmT3_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= hermite_sixpoint_interp(0.75,	y4_0_a,	dmTm1_3, dmT0_3, dmT1_3, dmT2_3, dmT3_3);

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	dmT3_2	= dmT2_2;
	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= dmTm1_2;
	dmTm1_2	= y3_0;

	dmT3_3	= dmT2_3;
	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= dmTm1_3;
	dmTm1_3	= y4_0;

	return y0_0;
}


// really stupid
// fixed 16x quasi oversampling
EVI_RESAMPLE_TEMPLATE_16x_6POINT(XIN)
{	// up 4
	History	umTm2_0(0), umTm1_0(0), umT0_0(0), umT1_0(0), umT2_0(0);
	// down 4
	History	dmT3_1(0), dmT2_1(0), dmT1_1(0), dmT0_1(0), dmTm1_1(0);
	History	dmT3_2(0), dmT2_2(0), dmT1_2(0), dmT0_2(0), dmTm1_2(0);
	History	dmT3_3(0), dmT2_3(0), dmT1_3(0), dmT0_3(0), dmTm1_3(0);
	// align
	History	doX0(0);

	// up 4x
	x0_0_a	= XIN + 0;
	x1_0	= hermite_sixpoint_interp(0.25,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x2_0	= hermite_sixpoint_interp(0.5,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);
	x3_0	= hermite_sixpoint_interp(0.75,	umTm2_0, umTm1_0, umT0_0, umT1_0, umT2_0, x0_0_a);

	// process 16x
	y1_0	= EVI_RESAMPLE_TEMPLATE_4x_6POINT(x1_0);
	y2_0	= EVI_RESAMPLE_TEMPLATE_4x_6POINT(x2_0);
	y3_0	= EVI_RESAMPLE_TEMPLATE_4x_6POINT(x3_0);
	y4_0	= EVI_RESAMPLE_TEMPLATE_4x_6POINT(umT2_0 + 0);

	// down 4x
	y2_0_a	= y2_0 + 0;
	y2_1	= hermite_sixpoint_interp(0.25,	y2_0_a,	dmTm1_1, dmT0_1, dmT1_1, dmT2_1, dmT3_1);

	y3_0_a	= y3_0 + 0;
	y3_1	= hermite_sixpoint_interp(0.5,	y3_0_a,	dmTm1_2, dmT0_2, dmT1_2, dmT2_2, dmT3_2);

	y4_0_a	= y4_0 + 0;
	y4_1	= hermite_sixpoint_interp(0.75,	y4_0_a,	dmTm1_3, dmT0_3, dmT1_3, dmT2_3, dmT3_3);

	y0_0	= (((doX0 + y2_1) + y3_1) + y4_1) * 0.25;

	// update
	umTm2_0	= umTm1_0;
	umTm1_0	= umT0_0;
	umT0_0	= umT1_0;
	umT1_0 	= umT2_0;
	umT2_0	= x0_0_a;

	doX0	= y1_0;

	dmT3_1	= dmT2_1;
	dmT2_1	= dmT1_1;
	dmT1_1	= dmT0_1;
	dmT0_1	= dmTm1_1;
	dmTm1_1	= y2_0;

	dmT3_2	= dmT2_2;
	dmT2_2	= dmT1_2;
	dmT1_2	= dmT0_2;
	dmT0_2	= dmTm1_2;
	dmTm1_2	= y3_0;

	dmT3_3	= dmT2_3;
	dmT2_3	= dmT1_3;
	dmT1_3	= dmT0_3;
	dmT0_3	= dmTm1_3;
	dmTm1_3	= y4_0;

	return y0_0;
}


// !! for testing ONLY !!
TEST_RESAMPLER_6POINT(x, order)
{
	y 		= 0;
	if 			(order == 1) {
		y 	= EVI_RESAMPLE_TEMPLATE_2x_6POINT(x);
	} else if	(order == 2) {
		y 	= EVI_RESAMPLE_TEMPLATE_3x_6POINT(x);
	} else  if	(order == 3) {
		y 	= EVI_RESAMPLE_TEMPLATE_4x_6POINT(x);
	} else  if	(order == 4) {
		y 	= EVI_RESAMPLE_TEMPLATE_6x_6POINT(x);
	} else  if	(order == 5) {
		y 	= EVI_RESAMPLE_TEMPLATE_8x_6POINT(x);
	} else  if	(order == 6) {
		y 	= EVI_RESAMPLE_TEMPLATE_9x_6POINT(x);
	} else  if	(order == 7) {
		y 	= EVI_RESAMPLE_TEMPLATE_12x_6POINT(x);
	} else  if	(order == 8) {
		y 	= EVI_RESAMPLE_TEMPLATE_16x_6POINT(x);
	} else {//	(order == 0) {
		y 	= YOUR_FUNCTION_GOES_HERE(x);
	}

	return 	y;
}

