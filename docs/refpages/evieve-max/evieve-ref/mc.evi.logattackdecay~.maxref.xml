<c74object name="mc.evi.logattackdecay~" module="evieve-ref" category="evieve">
  <digest>Attack/decay envelope follower</digest>
  <description>Logarithmic attack/decay envelope follower / smoother.</description>
  <metadatalist>
    <metadata name="author">Pete Dowling</metadata>
    <metadata name="tag">evieve</metadata>
    <metadata name="tag">evieve Externals</metadata>
    <metadata name="tag">evieve Smooth</metadata>
    <metadata name="tag">evieve Dynamics</metadata>
  </metadatalist>
  <inletlist>
    <inlet id="0" type="signal/float">
      <digest>Value to Follow</digest>
      <description>evi.logattackdecay~ will follow this input value with the given attack and decay times.</description>
    </inlet>
    <inlet id="1" type="signal/float">
      <digest>Attack Time in milliseconds</digest>
      <description>Amount of time the envelope takes to attack. evi.logattackdecay~ is logarithmic and does not attack in this time exactly.</description>
    </inlet>
    <inlet id="2" type="signal/float">
      <digest>Decay Time in milliseconds</digest>
      <description>Amount of time the envelope takes to decay. evi.logattackdecay~ is logarithmic and does not decay in this time exactly.</description>
    </inlet>
  </inletlist>
  <outletlist>
    <outlet id="0" type="signal">
      <digest>Output Envelope</digest>
      <description>Output Envelope</description>
    </outlet>
  </outletlist>
  <objarglist>
    <objarg id="0" name="attack" type="float" optional="1">
      <digest>Initial Attack Time in milliseconds</digest>
      <description>Amount of time the value takes to attack. evi.logattackdecay~ is logarithmic and does not attack in this time exactly.</description>
    </objarg>
    <objarg id="1" name="decay" type="float" optional="1">
      <digest>Initial Decay Time in milliseconds</digest>
      <description>Amount of time the value takes to decay. evi.logattackdecay~ is logarithmic and does not decay in this time exactly.</description>
    </objarg>
  </objarglist>
  <methodlist>
    <method name="int">
      <arglist>
        <arg name="int" type="int" optional="1"></arg>
      </arglist>
      <digest>Behaviour depends on inlet</digest>
      <description>In the left inlet, the destination value.
				In the middle inlet, attack time in ms.
				In the right inlet, decay time in ms.</description>
    </method>
    <method name="float">
      <arglist>
        <arg name="float" type="float" optional="1"></arg>
      </arglist>
      <digest>Behaviour depends on inlet</digest>
      <description>In the left inlet, the destination value.
				In the middle inlet, attack time in ms.
				In the right inlet, decay time in ms.</description>
    </method>
    <method name="clear">
      <arglist></arglist>
      <digest>Clears the internal filter state</digest>
      <description>This clears the state of the filter. This should never be needed :-)</description>
    </method>
    <method name="signal">
      <arglist></arglist>
      <digest>Behaviour depends on inlet</digest>
      <description>In the left inlet, the destination value.
				In the middle inlet, attack time in ms.
				In the right inlet, decay time in ms.</description>
    </method>
  </methodlist>
  <attributelist>
    <attribute name="attack" get="1" set="1" type="float" size="1">
      <digest>Attack Time in ms</digest>
      <description>Amount of time the value takes to attack. evi.logattackdecay~ is logarithmic and does not attack in this time exactly.</description>
      <attributelist>
        <attribute name="basic" get="1" set="1" type="int" size="1" value="1"></attribute>
        <attribute name="label" get="1" set="1" type="symbol" size="1" value="Attack Time in ms"></attribute>
      </attributelist>
    </attribute>
    <attribute name="decay" get="1" set="1" type="float" size="1">
      <digest>Decay Time in ms</digest>
      <description>Amount of time the value takes to decay. evi.logattackdecay~ is logarithmic and does not decay in this time exactly.</description>
      <attributelist>
        <attribute name="basic" get="1" set="1" type="int" size="1" value="1"></attribute>
        <attribute name="label" get="1" set="1" type="symbol" size="1" value="Decay Time in ms"></attribute>
      </attributelist>
    </attribute>
  </attributelist>
