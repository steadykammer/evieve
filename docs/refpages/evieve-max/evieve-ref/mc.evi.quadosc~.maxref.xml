<c74object name="mc.evi.quadosc~" module="evieve-ref" category="evieve">
  <digest>Phase locked quadrature oscillator</digest>
  <description>A quadrature oscillator which outputs phase synchronous cosine and sine waves.</description>
  <metadatalist>
    <metadata name="author">Pete Dowling</metadata>
    <metadata name="tag">evieve</metadata>
    <metadata name="tag">evieve Externals</metadata>
    <metadata name="tag">evieve Oscillator</metadata>
    <metadata name="tag">evieve Modulation</metadata>
    <metadata name="tag">evieve Source</metadata>
  </metadatalist>
  <inletlist>
    <inlet id="0" type="signal/float">
      <digest>Oscillator Frequency in Hz</digest>
      <description>The frequency of the oscillators in Hz</description>
    </inlet>
    <inlet id="1" type="signal">
      <digest>Sample Accurate Reset</digest>
      <description>Reset the phase of the oscillators. This is a naive reset and will click.</description>
    </inlet>
  </inletlist>
  <outletlist>
    <outlet id="0" type="signal">
      <digest>Cosine Output</digest>
      <description>Cosine Output</description>
    </outlet>
    <outlet id="1" type="signal">
      <digest>Sine Output</digest>
      <description>Sine Output</description>
    </outlet>
    <outlet id="2" type="signal">
      <digest>Cosine Sync Output</digest>
      <description>If 'syncout' == 1, a sync signal corresponding the the cosine phase is output here on every cycle</description>
    </outlet>
    <outlet id="3" type="signal">
      <digest>Sine Sync Output</digest>
      <description>If 'syncout' == 1, a sync signal corresponding the the sine phase is output here on every cycle</description>
    </outlet>
  </outletlist>
  <objarglist>
    <objarg id="0" name="frequency" type="float" optional="1">
      <digest>Initial frequency</digest>
      <description>The initial frequency of the oscillators in Hz</description>
    </objarg>
    <objarg id="1" name="syncout" type="int" optional="1">
      <digest>Add Sync Outlets 0/1 (default 0)</digest>
      <description>Syncout can only be a typed in argument and is not dynamic. Syncout creates two additional outlets to the object for sync signals.</description>
    </objarg>
  </objarglist>
  <methodlist>
    <method name="int">
      <arglist>
        <arg name="int" type="int" optional="0"></arg>
      </arglist>
      <digest>Left inlet</digest>
      <description>The frequency of the oscillators in Hz</description>
    </method>
    <method name="float">
      <arglist>
        <arg name="float" type="float" optional="0"></arg>
      </arglist>
      <digest>Left inlet</digest>
      <description>The frequency of the oscillators in Hz</description>
    </method>
    <method name="clear">
      <arglist></arglist>
      <digest>Clears the internal state (like a reset)</digest>
      <description>Message rate version of the right reset inlet</description>
    </method>
    <method name="signal">
      <arglist></arglist>
      <digest>Behaviour depends on inlet</digest>
      <description>In left inlet, the frequency of the oscillators in Hz.
				In right inlet, sample accurate reset of the ocillators phase.</description>
    </method>
  </methodlist>
  <attributelist>
    <attribute name="frequency" get="1" set="1" type="float" size="1" alias="freq">
      <digest>Oscillator Frequency in Hz</digest>
      <description>The frequency of the oscillators in Hz</description>
      <attributelist>
        <attribute name="basic" get="1" set="1" type="int" size="1" value="1"></attribute>
        <attribute name="label" get="1" set="1" type="symbol" size="1" value="Oscillator Frequency in Hz"></attribute>
      </attributelist>
    </attribute>
    <attribute name="syncout" get="0" set="1" type="int" size="1">
      <digest>Syncout mode 0/1 (0 = no sync outlets, the default, 1 = add sync outlets)</digest>
      <description>
        <m>syncout</m>
can only be a typed in attribute and is not dynamic. Syncout creates two additional outlets to the object for sync signals.      </description>
      <attributelist>
        <attribute name="basic" get="0" set="1" type="int" size="1" value="0"></attribute>
        <attribute name="label" get="0" set="0" type="symbol" size="1" value="Sync Outputs Mode 0/1"></attribute>
      </attributelist>
    </attribute>
  </attributelist>
