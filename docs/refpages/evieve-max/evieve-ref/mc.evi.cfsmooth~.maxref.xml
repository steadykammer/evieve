<c74object name="mc.evi.cfsmooth~" module="evieve-ref" category="evieve">
  <digest>Signal smoother particularly well suited to smoothing filter cutoff frequencies</digest>
  <description>Based on Andy Simper's smoother, evi.cfsmooth~ tracks the input value via the bandpass output of an SVF filter and logarithmically updates. Smoothing is specified in both ramp time (ms) and filter cutoff (Hz).</description>
  <metadatalist>
    <metadata name="author">Pete Dowling</metadata>
    <metadata name="tag">evieve</metadata>
    <metadata name="tag">evieve Externals</metadata>
    <metadata name="tag">evieve Smooth</metadata>
  </metadatalist>
  <inletlist>
    <inlet id="0" type="signal/float/int">
      <digest>Destination Value</digest>
      <description>Can take signal or float or int values to pass through the smoother.</description>
    </inlet>
    <inlet id="1" type="signal/float/int">
      <digest>Ramp Time in milliseconds</digest>
      <description>Amount of time the value takes to reach it's destination. evi.cfsmooth~ is logarithmic and does not reach it's destination exactly. Note that the minimum time the object can use is 1 millisecond due to internal approximations employed.</description>
    </inlet>
  </inletlist>
  <outletlist>
    <outlet id="0" type="signal">
      <digest>Output Ramp</digest>
      <description>Smoothed output ramp, or target value if ramp is complete.</description>
    </outlet>
  </outletlist>
  <objarglist>
    <objarg id="0" name="initial" type="float/int" optional="1">
      <digest>Initial value</digest>
      <description>Set the initial value of the output</description>
    </objarg>
    <objarg id="1" name="ms" type="float/int" optional="1">
      <digest>Ramp time</digest>
      <description>Initial ramp time in ms</description>
    </objarg>
    <objarg id="2" name="hz" type="float/int" optional="1">
      <digest>Hz</digest>
      <description>Initial Hz value for filter smoothing, typical values would be between 1..10 Hz</description>
    </objarg>
  </objarglist>
  <methodlist>
    <method name="int">
      <arglist>
        <arg name="int" type="int" optional="1"></arg>
      </arglist>
      <digest>Behaviour depends on inlet</digest>
      <description>In the left inlet, the destination value.
				In the right inlet, smoothing time in ms.</description>
    </method>
    <method name="float">
      <arglist>
        <arg name="float" type="float" optional="1"></arg>
      </arglist>
      <digest>Behaviour depends on inlet</digest>
      <description>In the left inlet, the destination value.
				In the right inlet, smoothing time in ms.</description>
    </method>
    <method name="clear">
      <arglist></arglist>
      <digest>Clears the internal filter state</digest>
      <description>This clears the state of the filter. This should never be needed :-)</description>
    </method>
    <method name="signal">
      <arglist></arglist>
      <digest>Behaviour depends on inlet</digest>
      <description>In the left inlet, the destination value.
				In the right inlet, smoothing time in ms.</description>
    </method>
  </methodlist>
  <attributelist>
    <attribute name="hz" get="1" set="1" type="float" size="1">
      <digest>Filter Cutoff in Hz</digest>
      <description>evi.cfsmooth~ is a two-pole filter. The Hz value sets the filter cutoff. This is typically between 1..10 Hz. The lower this value, the more agressively the curve shape is flattened out.</description>
      <attributelist>
        <attribute name="basic" get="1" set="1" type="int" size="1" value="1"></attribute>
        <attribute name="label" get="1" set="1" type="symbol" size="1" value="Smoothing Filter in Hz"></attribute>
      </attributelist>
    </attribute>
    <attribute name="time" get="1" set="1" type="float" size="1" alias="ms, smooth">
      <digest>Smoothing Time in ms</digest>
      <description>The ramp time in ms. Because evi.cfsmooth~ is an inexact smoother, the destination cannot be guaranteed to reach it's value exactly in the allotted time. Note that the minimum time the object can use is 1 millisecond due to internal approximations employed.</description>
      <attributelist>
        <attribute name="basic" get="1" set="1" type="int" size="1" value="1"></attribute>
        <attribute name="label" get="1" set="1" type="symbol" size="1" value="Smoothing Time in ms"></attribute>
      </attributelist>
    </attribute>
  </attributelist>
