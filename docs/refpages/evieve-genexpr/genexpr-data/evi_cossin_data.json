            "returns": [
                {
                    "id": 1,
                    "name": "Cos",
                    "digest": "Cosine quadrature output"
                },
                {
                    "id": 2,
                    "name": "Sin",
                    "digest": "Sine quadrature output"
                }
            ]
        },
