                {
                    "id": 2,
                    "kind": "input",
                    "name": "reset",
                    "digest": "Sample accurate phase reset"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Cos",
                    "digest": "Cosine quadrature output"
                },
                {
                    "id": 2,
