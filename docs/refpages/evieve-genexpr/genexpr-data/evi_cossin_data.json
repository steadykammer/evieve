        },
        {
            "document": true,
            "digest": "Quad osc from a tpt filter primed for audio rate FM, reset resets filter states",
            "name": "tptSvfQuadOsc",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "in Hz"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "sync",
                    "digest": "Soft sync reset, use this not 'reset'"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "reset",
                    "digest": "Hard reset, use 'sync' instead for audio applications"
                },
                {
                    "id": 4,
                    "kind": "param",
                    "name": "soft",
                    "default": 0.1,
                    "type": "float",
                    "digest": "Softness of 'sync' reset 0..1"
                }
