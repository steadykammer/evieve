{
    "description": "A collection of cosine/sine functions and supporting code for oft used approximiations.",
    "requires": [],
    "functions": [
        {
            "document": true,
            "digest": "This function offers different precisions of a famous cos/sin osc approximation. It is not intended for production but to extract the precision you need from the code.",
            "name": "quartParApproxFull",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "modphase",
                    "digest": "Osc phase, must be wrapped 0..1"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "precision",
                    "digest": "Int 0..3. Type of precision. See source code for details."
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Cos",
                    "digest": "Cosine quadrature output"
                },
                {
                    "id": 2,
                    "name": "Sin",
                    "digest": "Sine quadrature output"
                },
                {
                    "id": 3,
                    "name": "Quart",
                    "digest": "Which quarter the approximation is currently in, int 0..3"
                }
            ]
        },
        {
            "document": true,
            "digest": "Highly optimised cosine quarter extracted from 'quartParApproxFull()', excellent for crossfading or panning applications",
            "name": "quartParOneApprox",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "modphase",
                    "digest": "Osc phase, must be wrapped 0..1"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Cos",
                    "digest": "Cosine quadrature output"
                },
                {
                    "id": 2,
                    "name": "Sin",
                    "digest": "Sine quadrature output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Not an approximation, just two full precision matched cycle() lookups in quadrature form",
            "name": "quadratureOsc",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "thisphase",
                    "digest": "Phase 0..1"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "thisspread",
                    "digest": "Should always be 0.75 for quadrature behaviour, but can be changed for other uses"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Real",
                    "digest": "Cosine (quadrature) output"
                },
                {
                    "id": 2,
                    "name": "Imag",
                    "digest": "Sine (quadrature) output"
                }
            ]
        },
        {
