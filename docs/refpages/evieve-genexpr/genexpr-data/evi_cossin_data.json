                {
                    "id": 1,
                    "kind": "input",
                    "name": "frequency",
                    "digest": "in Hz"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "reset",
                    "digest": "Sample accurate phase reset"
