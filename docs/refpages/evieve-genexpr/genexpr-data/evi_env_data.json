{
    "description": "Envelope (following) routines.",
    "requires": [],
    "functions": [
        {
            "document": true,
            "digest": "Like MSP [average~ absolute]",
            "name": "averageAbsolute",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "inputSample",
                    "digest": "Audio input to follow"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "windowSizeInSamples",
                    "digest": "Averaging window size in samples"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Average",
                    "digest": "Envelope output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Generalised for options, used by 'averageWrap()'",
            "name": "averageCore",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "X",
                    "digest": "Value to follow"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "reset",
                    "digest": "Sample accurate reset of internal state"
                },
                {
                    "id": 3,
                    "kind": "param",
                    "name": "windowSize",
                    "default": 0,
                    "type": "integer",
                    "digest": "Optional window size in samples, default 1000 samples (like MSP)"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Average",
                    "digest": "Mean average envelope output"
                },
                {
                    "id": 2,
                    "name": "Count",
                    "digest": "Index count of window buffer in samples"
                }
            ]
        },
        {
            "document": true,
            "digest": "This is expensive because it branches internally, but is useful if you need to switch averaging type",
            "name": "averageWrap",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "X",
                    "digest": "Value to follow"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "reset",
                    "digest": "Sample accurate reset of internal state"
                },
                {
                    "id": 3,
                    "kind": "param",
                    "name": "interval",
                    "default": 500,
                    "type": "integer",
                    "digest": "Interval (window size) in samples"
                },
                {
                    "id": 4,
                    "kind": "param",
                    "name": "mode",
                    "default": 0,
                    "type": "integer",
                    "digest": "0=bipolar, 1=absolute, 2=rms"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Average",
                    "digest": "Mean average envelope output"
                },
                {
                    "id": 2,
                    "name": "Count",
                    "digest": "Index count of window buffer in samples"
                }
            ]
        },
        {
            "document": true,
            "digest": "",
            "name": "averageDataV",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "xin",
                    "digest": ""
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "reset",
                    "digest": ""
                },
                {
                    "id": 3,
                    "kind": "param",
                    "name": "interval",
                    "default": 200,
                    "type": "integer",
                    "digest": ""
                },
                {
                    "id": 4,
                    "kind": "param",
                    "name": "mode",
                    "default": 1,
                    "type": "integer",
                    "digest": ""
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "",
                    "digest": ""
                },
                {
                    "id": 2,
                    "name": "",
                    "digest": ""
                },
                {
                    "id": 3,
                    "name": "",
                    "digest": ""
                }
            ]
        },
        {
            "document": true,
            "digest": "Averaging audio detection wrapper for envelope following",
            "name": "averageData",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "xin",
                    "digest": "Audio input to be analysed"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "reset",
                    "digest": "Sample accurate reset of the averaging filter (buffer)"
                },
                {
                    "id": 3,
                    "kind": "param",
                    "name": "interval",
                    "default": 200,
                    "type": "integer",
                    "digest": "Interval (window size) in samples of internal averager algorithm"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Fast",
                    "digest": "Fast response data (exp)"
                }
            ]
        },
        {
            "document": true,
            "digest": "Simple, cheap and raw envelope following, intended to be used with post envelope smoothers such as in 'envFollSimple()'",
            "name": "envRawDetect",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Value to follow"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "attack",
                    "digest": "Attack amount normalised 0..1"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "release",
                    "digest": "Release amount normalised 0..1"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Raw",
                    "digest": "Raw envelope values output"
                }
            ]
        },
        {
            "document": false,
            "digest": "",
            "name": "envSad",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "s",
                    "digest": ""
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "",
                    "digest": ""
                }
            ]
        },
        {
            "document": true,
            "digest": "Logarithmic decay envelope follower",
            "name": "envDecay",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Value to follow"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "d",
                    "digest": "Decay time in SECONDS (to drop 6dB)"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Env",
                    "digest": "Output Envelope"
                }
            ]
        },
        {
            "document": true,
            "digest": "Logarithmic attack/decay envelope follower",
            "name": "envAttackDecay",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Value to follow"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "a",
                    "digest": "Attack time in SECONDS (to drop 6dB)"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "d",
                    "digest": "Decay time in SECONDS (to drop 6dB)"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "r",
                    "digest": ""
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Env",
                    "digest": "Output Envelope"
                }
            ]
        },
        {
            "document": true,
            "digest": "Logarithmic attack/hold/release envelope follower",
            "name": "envAttackHoldRelease",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Value to follow"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "a",
                    "digest": "Attack time in SECONDS (to drop 6dB)"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "h",
                    "digest": "Hold time in SECONDS"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "r",
                    "digest": "Release time in SECONDS (to drop 6dB)"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Env",
                    "digest": "Output Envelope"
                }
            ]
        },
        {
            "document": true,
            "digest": "Absolute audio envelope peak followed by logarithmic envelope follower",
            "name": "immediateEnv",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "iX",
                    "digest": "Audio input to be followed"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "iAttack",
                    "digest": "Envelope follower attack time in seconds"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "iDecay",
                    "digest": "Envelope follower release time in seconds"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "iR",
                    "digest": "Sample accurate reset of internal envelope following filter"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Immediate Env",
                    "digest": "Envelope output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Fast data, slow envelopes (output envelope averages lower if melodic / sustained input, spikes to higher floor if transient / constantly changing input)",
            "name": "zeroxEnvs",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "X",
                    "digest": "Audio input to be analysed"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "smooth",
                    "digest": "Smoothing time of the logarithmic smoothers in milliseconds"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "reset",
                    "digest": "Sample accurate reset of internal zero crossing detector"
                },
                {
                    "id": 4,
                    "kind": "param",
                    "name": "countDiv",
                    "default": 10,
                    "type": "integer",
                    "digest": "Divisor for number of zero crossings per period, higher values will result in less busy envelopes (effects 'Env 2' middle outlet)"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Env 1",
                    "digest": "Based on zero crossing threshold"
                },
                {
                    "id": 2,
                    "name": "Env 2",
                    "digest": "Based on number of zero crossings per period"
                },
                {
                    "id": 3,
                    "name": "Xings",
                    "digest": "Continuously updated number of zero crossings"
                }
            ]
        },
        {
            "document": false,
            "digest": "",
            "name": "vactrolSad",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": ""
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "a",
                    "digest": ""
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "",
                    "digest": ""
                }
            ]
        },
        {
            "document": true,
            "digest": "Vactrol time-domain behaviour filter, the resistive part of a photoresistive opto-isolator",
            "name": "vactrol",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "impulse",
                    "digest": "Impulse"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "rise",
                    "digest": "Rise time in SAMPLES"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "fall",
                    "digest": "Fall time in SAMPLES"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "base",
                    "digest": "Base frequency in Hz, should be in range 100..10000; very powerful in changing shape of envelope curve and peak/trough of envelope."
                },
                {
                    "id": 5,
                    "kind": "input",
                    "name": "reset",
                    "digest": "Sample accurate reset of internal envelope following filter"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Vactrol Envelope",
                    "digest": "Output will behave similarly to a Buchla vactrol"
                }
            ]
        },
        {
            "document": true,
            "digest": "Quick, simple, cheap",
            "name": "envFollSimple",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "X",
                    "digest": "Value to follow"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "attack",
                    "digest": "Attack 0..1 represents 0..10 ms"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "release",
                    "digest": "Release 0..1 represents 0..100 ms"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Env",
                    "digest": "Output Envelope"
                }
            ]
        }
    ],
    "seealso": [
        "evi_smooth",
        "evi_dynamics"
    ]
}