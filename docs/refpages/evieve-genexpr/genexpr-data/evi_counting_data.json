            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "trig",
                    "digest": "Audio rate ramp trigger"
                },
                {
                    "id": 2,
                    "kind": "Param",
                    "name": "duration",
                    "default": 1000,
                    "min": 0,
                    "max": 60000,
                    "type": "float",
                    "digest": "Ramp duration in ms"
                },
                {
                    "id": 3,
                    "kind": "Param",
                    "name": "zeroreset",
