{
    "description": "Phasors, rates, ramps, all with zero reset functionality and various other features such as spread, reverse, pause, phase, jump, etc. For replicating some MSP functionality inside gen~.",
    "requires": [],
    "functions": [
        {
            "document": true,
            "digest": "Optionally zero reset phasor with pause, reverse and phase, @see [evi.phasor0~] for a patched version",
            "name": "eviPhasor0",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "frequency",
                    "digest": "Phasor frequency in Hz"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "reset",
                    "digest": "Trigger, naive phase reset"
                },
                {
                    "id": 3,
                    "kind": "Param",
                    "name": "minimumhz",
                    "default": 0.125,
                    "min": 0,
                    "max": 1,
                    "type": "float",
                    "digest": "Set minimum Hz for zero reset behaviour"
                },
                {
                    "id": 4,
                    "kind": "Param",
                    "name": "mode",
                    "default": 1,
                    "min": 0,
                    "max": 1,
                    "type": "integer",
                    "digest": "Zero reset behaviour off/on"
                },
                {
                    "id": 5,
                    "kind": "Param",
                    "name": "reverse",
                    "default": 1,
                    "min": 0,
                    "max": 1,
                    "type": "integer",
                    "digest": "Reverse allowed?"
                },
                {
                    "id": 6,
                    "kind": "Param",
                    "name": "pause",
                    "default": 0,
                    "min": 0,
                    "max": 1,
                    "type": "integer",
                    "digest": "Pause current ramp off/on"
                },
                {
                    "id": 7,
                    "kind": "Param",
                    "name": "phase",
                    "default": 0,
                    "min": 0,
                    "max": 1,
                    "type": "float",
                    "digest": "Set to this phase on next reset"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "thisphasor",
                    "digest": "Phase 0..1"
                },
                {
                    "id": 2,
                    "name": "zero reset Hz",
                    "digest": "Current frequency in Hz"
                },
                {
                    "id": 3,
                    "name": "thisdelta",
                    "digest": "Phasor sync signal"
                }
            ]
        },
