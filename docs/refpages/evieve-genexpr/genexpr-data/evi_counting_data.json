                },
                {
                    "id": 5,
                    "kind": "Param",
                    "name": "loop",
                    "default": 0,
                    "min": 0,
                    "max": 1,
                    "type": "integer",
                    "digest": "Loop ramp off/on 0/1 (@loop 1 = a phasor)"
                },
                {
                    "id": 6,
                    "kind": "Param",
                    "name": "restingstate",
                    "default": 1,
                    "min": 0,
                    "max": 1,
                    "type": "integer",
                    "digest": "Oneshot mode (@loop=0) 'rests' at zero or one 0/1"
                },
                {
                    "id": 7,
                    "kind": "Param",
                    "name": "curve",
                    "default": 0,
                    "min": 0,
                    "max": 1,
                    "type": "integer",
                    "digest": "Make ramp s-curve off/on 0/1"
