            "name": "varDcblockReset",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x0",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "a0",
                    "digest": "Dc coefficient, typically 0.9997 for basic dcblock()"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "r0",
                    "digest": "Sample accurate filter state reset inlet"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Audio output",
                    "digest": "Variable dc blocked audio output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Dynamically vary dcblocking and gain so that oscillators can frequency dependent morph between LFOs and audio rate osciallators. Note, this is extremely suspicious code.",
            "name": "dynamicDc",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "osc",
                    "digest": "Oscillator input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "dtn",
                    "digest": "clip((phase_increment*2), 0, 1)"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "dcn",
                    "digest": "(int) switch state, 0=dcblock off, 1=dcblock on, 2=var dc good for low oscs, 3=var dc good for high oscs"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Osc",
                    "digest": "Oscillator output"
                }
            ]
        },
        {
            "document": true,
