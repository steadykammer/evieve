{
    "description": "This file just wraps the 'sinFold()' adaa functions from the 'evi_saturators.genexpr' file for ease of use in the gen~ [evi_sinfold] abstraction and the MSP [evi.sinfold~] define. Not very useful for anything else, but useful if you want to use the same sine saturating waveshaper in your own code.",
    "requires": [
        "evi_smooth.genexpr",
        "evi_trig.genexpr",
        "evi_saturators.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "Parameter rate gain wrapping for the core 'sinFold()' functions",
            "name": "sinParam",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "drive",
                    "digest": "Drive amount % 0..1.. up to 2 is pretty safe, up to 4 be careful"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "pidrive",
                    "digest": "Pre gain shaped"
                },
                {
                    "id": 2,
                    "name": "sindrive",
                    "digest": "Post gain shaped"
                }
            ]
        },
        {
            "document": true,
            "digest": "Naive waveshaping, do not use, we use the oversampled versions only",
            "name": "sinFoldNaive",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "pidrive",
                    "digest": "Pre gain shaped"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "sindrive",
                    "digest": "Post gain shaped"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Sine",
                    "digest": "Sine shaped saturated output"
                }
            ]
        },
