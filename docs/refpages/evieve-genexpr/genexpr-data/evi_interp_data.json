        {
            "document": true,
            "digest": "Four point B-spline interpolator",
            "name": "cubic_bspline_interp",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "f",
                    "digest": "Interpolator 0..1"
                },
                {
