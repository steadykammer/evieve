{
    "description": "This file is mainly here as a catch all for the require files it inherits for building the evieve SSB (Single SideBand) modulators. It also contains the 'complexRing()' required for those abstractions.",
    "requires": [
        "evi_sinfold_lib.genexpr",
        "evi_cossin.genexpr",
        "evi_biquads_extras.genexpr",
        "evi_rcfilters.genexpr",
        "evi_butterworth.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "Real/Imag complex ring modulator component",
            "name": "complexRing",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "real",
                    "digest": "Real signal input"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "imag",
                    "digest": "Imag signal input"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "rmod",
                    "digest": "Real modulator"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "imod",
                    "digest": "Imag modulator"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "USB",
                    "digest": "Upper sideband output"
                },
                {
                    "id": 2,
                    "name": "LSB",
                    "digest": "Lower sideband output"
                },
                {
                    "id": 3,
                    "name": "cosp",
                    "digest": "Cosine audio component"
                },
                {
                    "id": 4,
                    "name": "sinp",
                    "digest": "Sine audio component"
                }
            ]
        }
    ],
    "seealso": [
        "evi_sinfold_lib",
        "evi_cossin",
        "evi_butterworth"
    ]
}