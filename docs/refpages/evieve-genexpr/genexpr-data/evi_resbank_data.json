                    "digest": "Filter coefficient 2"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "a2",
                    "digest": "Filter coefficient 3"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Bandpass",
                    "digest": "LTO Bandpass filter"
                }
            ]
