{
    "description": "Only require this file if you need access to all of the PolyBLEP Oscillators in evieve. It is much more likely that you will require the individual PolyBLEP files ('See Also'). Using the 'poly_osc()' function here you can test all of the two-point Blep Oscillators. The PolyBLEP method antialiases oscillator shapes based on smoothing the discontinuities in a naive signal shape. The best quality in evieve are the four-point Bleps ('evi_polyblep_four.genexpr'). However the two-point Bleps are also very useful ('evi_polyblep_two.genexpr') including interesting morphing Oscillators. The two-point Bleps also offer a wide range of interesting Oscillator shapes ('evi_polyblep_shapes.genexpr').",
    "requires": [
        "evi_polyblep_four.genexpr",
        "evi_polyblep_shapes.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "A totally ridiculous 35 waveform switcher intended only for testing / demonstration, not to be used in general",
            "name": "poly_osc",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "freqInHz",
                    "digest": "Oscillator Frequency in Hz"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "pwm",
                    "digest": "Pulse Width 0..1 for Oscillators that use it"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "a",
                    "digest": "Amplitude (linear)"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "t",
                    "digest": "Phase 0..1"
                },
                {
                    "id": 5,
                    "kind": "input",
                    "name": "dt",
                    "digest": "Phase Increment"
                },
                {
                    "id": 6,
                    "kind": "input",
                    "name": "morph",
                    "digest": "Shape Morph 0..1 for Oscillators that use it"
                },
                {
                    "id": 7,
                    "kind": "input",
                    "name": "wav",
                    "digest": "(int) Oscillator Type 0..36 for selection"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Osc",
                    "digest": "Oscillator Output"
                }
            ]
        },
