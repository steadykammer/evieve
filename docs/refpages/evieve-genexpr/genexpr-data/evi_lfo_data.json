            "document": true,
            "digest": "Collection of computed switchable LFOs, all wave selections in output range 0..1",
            "name": "lfoShapes01",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "phase",
                    "digest": "Phase 0..1"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "sync",
                    "digest": "The sync of the phase input required for random LFOs"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "mod",
                    "digest": "Pulse width input 0..1 for LFOs that require it (3=tri, 5=tanh, 6=square)"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "shape",
                    "digest": "0=off, 1=up, 2=down, 3=tri, 4=sine (default), 5=tanh, 6=square, 7=rand bin, 8=rand step, 9=rand linear, 10=rand cosine, 11=rand cubic, 12=rand walk, 13=noise"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "LFO",
                    "digest": "Selected LFO wave in range 0..1"
                }
            ]
