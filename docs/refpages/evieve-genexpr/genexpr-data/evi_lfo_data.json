        {
            "document": true,
            "digest": "A computed but cheap LFO that can morph between triangle and sine shapes, requires phase 0..1 input, produces wave shape output in range 0..1",
            "name": "lfoMix",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "phase",
                    "digest": "Phase 0..1"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "duty",
                    "digest": "Duty of triangle wave, 0..1, 0.5==tri"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "shape",
                    "digest": "Morph between tri..sine 0..1"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "skew",
                    "digest": "Skew exponent of LFO output, 0.5..2, 1==no skew"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "LFO",
                    "digest": "Wave output in range 0..1"
                }
            ]
        },
