{
    "description": "Higher level filter type selectors for all 40 filter coefficient calculators included in 'evi_biquads_coeffs.genexpr'. Use this file to easily test all the different Biquad types in evieve.",
    "requires": [
        "evi_biquads_coeffs.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "Global selector for all 40 filter types, @see: [evi.biquad.filter~], [evi.biquadcoeff~] and [evi.biquadcoeff] for example wrappers and index listing",
            "name": "eviBiquadCoeff",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "filter",
                    "digest": "(int) filter index (type), see abstractions or source code for listing"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "Cutoff frequency in Hz"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "gain",
                    "digest": "Gain (linear)"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "fullQ",
                    "digest": "Q"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "a0",
                    "digest": "a0 coefficient"
                },
                {
                    "id": 2,
                    "name": "a1",
                    "digest": "a1 coefficient"
                },
                {
                    "id": 3,
                    "name": "a2",
                    "digest": "a2 coefficient"
                },
                {
                    "id": 4,
                    "name": "b1",
                    "digest": "b1 coefficient"
                },
                {
                    "id": 5,
                    "name": "b2",
                    "digest": "b2 coefficient"
                }
            ]
        },
        {
