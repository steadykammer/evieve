{
    "description": "A collection of non-oscillator sources and related code. Different types of noise as well as novel random LFOs.",
    "requires": [],
    "functions": [
        {
            "document": true,
            "digest": "A variable gain spikey dusty noise source with variable frequency",
            "name": "audioDust",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "freq",
                    "digest": "Frequency in Hz"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "dust",
                    "digest": "The audio dust output"
                },
                {
                    "id": 2,
                    "name": "white",
                    "digest": "Synchronised white noise output"
                },
                {
                    "id": 3,
                    "name": "sync",
                    "digest": "Full gain sync signal with every piece of dust"
                }
            ]
        },
        {
            "document": true,
            "digest": "A 'sparse noise' algorithm (similar to 'audioDust()') mixable with a full 'velvet noise' algorithm",
            "name": "sparseVelvetNoise",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "freq",
                    "digest": "Frequency in Hz"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "mixN",
                    "digest": ""
                },
                {
                    "id": 3,
                    "kind": "param",
                    "name": "amp",
                    "default": 1,
                    "type": "float",
                    "digest": "The amplitude of the noise, typically left at '1'"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "mixNoise",
                    "digest": "The mix of sparse and velvet noise"
                },
                {
                    "id": 2,
                    "name": "sparseNoise",
                    "digest": "Just the sparse noise algorithm"
                },
                {
                    "id": 3,
                    "name": "velvetNoise",
                    "digest": "Just the velvet noise algorithm"
                }
            ]
        },
        {
            "document": true,
            "digest": "Not-really Box-Muller gaussian noise distribution implementation. Note that this does not have good distribution and has been retired in evieve. See 'gaussianNoiseNormal()' in 'evi_approx.genexpr' for a replacement function.",
            "name": "gaussianNoise",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "gain",
                    "digest": "0.6403882032022076 gives very close to unity amplitude (-1..1) output"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "gaussian",
                    "digest": "The gaussian noise output"
                },
                {
                    "id": 2,
                    "name": "Xoshiro256",
                    "digest": "Synchronised white noise output"
                },
                {
                    "id": 3,
                    "name": "cosXos",
                    "digest": "Synchronised cosine noise output"
                }
            ]
        },
        {
            "document": true,
            "digest": "Pink noise distribution in gen~, very similar to MSP [pink~]",
            "name": "eviPink",
            "inputs": [],
            "returns": [
                {
                    "id": 1,
                    "name": "Pink",
                    "digest": "Pink noise"
                }
            ]
        },
        {
            "document": true,
            "digest": "Zero crossing detector, like [zerox~] from RNBO or MSP",
            "name": "likeZerox",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input to be analysed"
                },
                {
                    "id": 2,
                    "kind": "param",
                    "name": "windowSize",
                    "default": 0,
                    "type": "integer",
                    "digest": "Window size in samples, default 64, typically vectorsize"
                },
                {
                    "id": 3,
                    "kind": "param",
                    "name": "threshold",
                    "default": 0.1,
                    "type": "float",
                    "digest": "Threshold above which the number of zero crossings reports a count"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "lastCount",
                    "digest": "Number of crossings in most recent window"
                },
                {
                    "id": 2,
                    "name": "voiced",
                    "digest": "Gate triggered by threshold"
                },
                {
                    "id": 3,
                    "name": "crossing",
                    "digest": "Current crossings"
                }
            ]
        },
        {
            "document": true,
            "digest": "Simple zero crossing detector with a fixed window sie of vectorsize, a bit like the gen~ example",
            "name": "simpleZerox",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Audio input to be analysed"
                },
                {
                    "id": 2,
                    "kind": "param",
                    "name": "threshold",
                    "default": 0.1,
                    "type": "float",
                    "digest": "Threshold above which the number of zero crossings reports a count"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "periodCount",
                    "digest": "Number of crossings in most recent window"
                },
                {
                    "id": 2,
                    "name": "voiced",
                    "digest": "Gate triggered by threshold"
                },
                {
                    "id": 3,
                    "name": "crossing",
                    "digest": "Current crossings"
                }
            ]
        },
        {
            "document": true,
            "digest": "Like [rand~] from MSP (linear), very predictable and gives exact notches",
            "name": "eviRand",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "p",
                    "digest": "Phasor driver 0..1 (not frequency)"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "nv",
                    "digest": "Rand oscillator output"
                },
                {
                    "id": 2,
                    "name": "n",
                    "digest": "Internal white noise source sync"
                }
            ]
        },
        {
            "document": true,
            "digest": "Like 'eviRand()' but with external noise source",
            "name": "eviRandN",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "p",
                    "digest": "Phasor driver 0..1 (not frequency)"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "n",
                    "digest": "External noise source from which rand is derived"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "nv",
                    "digest": "Rand oscillator output"
                }
            ]
        },
