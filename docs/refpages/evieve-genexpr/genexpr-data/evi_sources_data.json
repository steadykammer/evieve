                    "digest": "Cosine rand oscillator output"
                },
                {
                    "id": 3,
                    "name": "a",
                    "digest": "Step sync output (previous step)"
                },
                {
                    "id": 4,
                    "name": "rr",
                    "digest": "Sync output (of phasor input)"
                }
            ]
        },
        {
            "document": true,
            "digest": "Like 'eviRand()' but ready for cubic interpolation, called by 'eviRandy()'",
            "name": "eviRands",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "d0",
                    "digest": "Delta sync of phasor source"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "x2",
                    "digest": "External noise source from which rand is derived"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "vm1",
                    "digest": "Cubic interpolator output 1"
                },
                {
                    "id": 2,
                    "name": "v0",
                    "digest": "Cubic interpolator output 2"
                },
                {
                    "id": 3,
                    "name": "v1",
                    "digest": "Cubic interpolator output 3"
                },
                {
                    "id": 4,
                    "name": "v2",
                    "digest": "Cubic interpolator output 4"
                }
            ]
        },
        {
            "document": true,
            "digest": "Like 'eviRand()' but cubic interpolated, rolls off much faster",
            "name": "eviRandy",
            "inputs": [
                {
                    "id": 1,
