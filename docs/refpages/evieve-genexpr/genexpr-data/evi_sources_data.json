        {
            "document": true,
            "digest": "4-point catmull rom cubic spline interpolator with bias and tension parameters, similar to the native gen~ example",
            "name": "catmullRomSplineDynamic",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "f",
                    "digest": "Interpolator 0..1"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "y0",
                    "digest": "Cubic interpolator input 1"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "y1",
                    "digest": "Cubic interpolator input 2"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "y2",
                    "digest": "Cubic interpolator input 3"
                },
                {
                    "id": 5,
                    "kind": "input",
                    "name": "y3",
                    "digest": "Cubic interpolator input 4"
                },
                {
                    "id": 6,
                    "kind": "input",
                    "name": "bias",
                    "digest": "Bias control, signed"
                },
                {
                    "id": 7,
                    "kind": "input",
                    "name": "tension",
                    "digest": "Tension control, signed"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "spline",
                    "digest": "Spline interpolated output"
                }
            ]
        },
        {
            "document": true,
            "digest": "A very (and needlessly) expensive spline interpolated random LFO",
            "name": "eviRandLfo",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "hz",
                    "digest": "Frequency in Hz"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "skew",
                    "digest": "Skew the wave, must be clamped -1..1"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "reset",
                    "digest": "Hard reset of internal phase"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "r",
                    "digest": "Random LFO -1..1"
                },
                {
                    "id": 2,
                    "name": "x",
                    "digest": "Internal white noise source sync"
                }
            ]
        },
        {
            "document": true,
            "digest": "A beautiful random LFO based on Iftah / Ableton LFO, using an external windowing function to produce a sine-like random walk algorithm.",
            "name": "eviWindowLfo",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "window",
                    "digest": "A gen buffer reference containing a window function 0..1, only really works with a blackman-like window or a kaiser window with alpha > 8"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "phase",
                    "digest": "Phase driver 0..1"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "distribution",
                    "digest": "Default should be 0.5, towards extremes (0 or 1) becomes less random and more regular in output"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "density",
                    "digest": "Default should be 0, 0..1 increasingly folds over the wave shape by increasing the internal radians, making the LFO dense and busy"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "LFO",
                    "digest": "Quasi random walk output"
                },
                {
                    "id": 2,
                    "name": "Noise",
                    "digest": "The internal noise source output for driving downstream processes"
                }
            ]
        },
        {
            "document": true,
            "digest": "The same as 'eviWindowLfo()' but with external noise source input",
            "name": "eviWindowLfoN",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "window",
                    "digest": "A gen buffer reference containing a window function 0..1, only really works with a blackman-like window or a kaiser window with alpha > 8"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "rng",
                    "digest": "External (white) noise source to drive the random algorithm"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "phase",
                    "digest": "Phase driver 0..1"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "distribution",
                    "digest": "Default should be 0.5, towards extremes (0 or 1) becomes less random and more regular in output"
                },
                {
                    "id": 5,
                    "kind": "input",
                    "name": "density",
                    "digest": "Default should be 0, 0..1 increasingly folds over the wave shape by increasing the internal radians, making the LFO dense and busy"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "LFO",
                    "digest": "Quasi random walk output"
                }
            ]
        },
