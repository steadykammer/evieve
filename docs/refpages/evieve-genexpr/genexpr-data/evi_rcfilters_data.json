{
    "description": "Classic analog onepole RC filters in trapezoidal form. These are high quality and extremely efficient onepole filter primitives used all over evieve and very useful in day to day patching situations. One of the reasons we use trapezoidal rule is so that the filter can be correctly nonlinearised in TPT form.",
    "requires": [
        "evi_approx.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "Frequency warping for all onepole filters with a cheap approximation suited to lower range frequency values",
            "name": "rcPreWarp1",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "Cutoff frequency in Hz"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "G",
                    "digest": "Warped frequency g coefficient 0..1"
                }
            ]
        },
        {
            "document": true,
            "digest": "Frequency warping for all onepole filters with an approximation suited to full range frequency values",
            "name": "rcPreWarp2",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "Cutoff frequency in Hz"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "G",
                    "digest": "Warped frequency g coefficient 0..HALFPI"
                }
            ]
        },
