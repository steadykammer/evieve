{
    "description": "Using this require file you can access coefficients selectors for all LTO SVF filters in evieve with corresponding all-in-one filter sections. This file also includes all-in-one parametric EQ filter blocks.",
    "requires": [
        "evi_smooth.genexpr",
        "evi_svfs_filters.genexpr"
    ],
    "functions": [
        {
            "document": true,
            "digest": "General coefficients calculator for the 11 available filter types using the LTO SVF",
            "name": "svfSectionCoeff",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "filter",
                    "digest": "(int) filter index (type), see source code for listing"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "Cutoff frequency in Hz"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "gain",
                    "digest": "Gain (linear)"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "fullQ",
                    "digest": "Q"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "a1",
                    "digest": "a1 coefficient"
                },
                {
                    "id": 2,
                    "name": "a2",
                    "digest": "a2 coefficient"
                },
                {
                    "id": 3,
                    "name": "a3",
                    "digest": "a3 coefficient"
                },
                {
                    "id": 4,
                    "name": "m0",
                    "digest": "low mixing gain"
                },
                {
                    "id": 5,
                    "name": "m1",
                    "digest": "band mixing gain"
                },
                {
                    "id": 6,
                    "name": "m2",
                    "digest": "high mixing gain"
                }
            ]
        },
        {
            "document": true,
            "digest": "A gen (no tilde) version of 'svfSectionCoeff()' for using at schedular rate",
            "name": "svfSectionCoeffNoTilde",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "filter",
                    "digest": "(int) filter index (type), see source code for listing"
                },
                {
                    "id": 2,
                    "kind": "input",
                    "name": "cutoff",
                    "digest": "Cutoff frequency in Hz"
                },
                {
                    "id": 3,
                    "kind": "input",
                    "name": "gain",
                    "digest": "Gain (linear)"
                },
                {
                    "id": 4,
                    "kind": "input",
                    "name": "fullQ",
                    "digest": "Q"
                },
                {
                    "id": 5,
                    "kind": "param",
                    "name": "AUDIO_SR",
                    "default": 48000,
                    "type": "integer",
                    "digest": "You must pass in the audio samplerate for usage in gen (no tilde)"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "a1",
                    "digest": "a1 coefficient"
                },
                {
                    "id": 2,
                    "name": "a2",
                    "digest": "a2 coefficient"
                },
                {
                    "id": 3,
                    "name": "a3",
