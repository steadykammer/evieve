            "name": "makeCosPhase",
            "inputs": [
                {
                    "id": 1,
                    "kind": "input",
                    "name": "x",
                    "digest": "Phase 0..TWOPI"
                }
            ],
            "returns": [
                {
                    "id": 1,
                    "name": "Phase",
                    "digest": "Phase for cos/sin approximations"
                },
                {
                    "id": 2,
                    "name": "Quadrant",
                    "digest": "The quadrant to switch to for the cos/sin approximations"
                }
            ]
        },
